// system_pages.templ provides Templ components for the system reference
// index and category browser. A category's list and an entry's page are in
// rules_list.templ and rules_page.templ.

package systems

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// categoryInfo is used by the handler to pass category data to templates.
// Defined here so Templ can reference it (must be in same package).
type categoryInfo struct {
	Slug  string
	Name  string
	Icon  string
	Count int
}

// rulebookFrontpageWidgetSlug is the widget slug a system's manifest
// registers to supply the Rulebook page's signed front page. Checked via
// SystemManifest.HasWidget so this stays system-agnostic — any package
// that ships a widget with this slug gets it mounted here, not just Draw
// Steel.
const rulebookFrontpageWidgetSlug = "rulebook-frontpage"

// SystemIndexPage renders the full module category index page.
templ SystemIndexPage(cc *campaigns.CampaignContext, manifest *SystemManifest, cats []categoryInfo, hasBook bool) {
	@layouts.App(manifest.Name + " - " + cc.Campaign.Name) {
		@SystemIndexContent(cc, manifest, cats, hasBook)
	}
}

// SystemIndexContent renders the module category index (for HTMX swap).
// What the Rules page shows, in order of preference: the system's book
// (docs/system-rulebook-book.md), its own rulebook front page widget, or the
// generic category browser. Only one: stacking them read as competing
// rulebooks. The category routes stay up for links either way.
templ SystemIndexContent(cc *campaigns.CampaignContext, manifest *SystemManifest, cats []categoryInfo, hasBook bool) {
	<div id="module-content">
		if hasBook || manifest.HasWidget(rulebookFrontpageWidgetSlug) {
			// The rulebook fills the content area edge to edge, with no breadcrumb:
			// the negative margins cancel <main>'s padding at each breakpoint, so
			// it reads as the page rather than a box inside it.
			<div class="-mx-3 -my-3 md:-mx-5 md:-my-4 min-h-full" data-rulebook-fullbleed>
				if hasBook {
					<link rel="stylesheet" href={ layouts.AssetURL("/static/css/rulebook.css") }/>
					<div
						data-widget="rulebook"
						data-campaign-id={ cc.Campaign.ID }
						data-book-url={ "/campaigns/" + cc.Campaign.ID + "/systems/" + manifest.ID + "/book" }
					></div>
				} else {
					<div data-widget={ rulebookFrontpageWidgetSlug } data-campaign-id={ cc.Campaign.ID }></div>
				}
			</div>
		} else {
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: "/campaigns/" + cc.Campaign.ID, Icon: "fa-book-open"},
				{Label: manifest.Name},
			})
			@systemCategoryBrowser(cc, manifest, cats)
		}
	</div>
}

// systemCategoryBrowser is the generic reference index: the system header and
// one card per data category. Used when the system has no front page of its own.
templ systemCategoryBrowser(cc *campaigns.CampaignContext, manifest *SystemManifest, cats []categoryInfo) {
	<!-- System header -->
	<div class="mb-6">
		<div class="flex flex-wrap items-center gap-3 mb-2">
			if manifest.Icon != "" {
				<i class={ "fa-solid " + manifest.Icon + " text-2xl text-primary" }></i>
			}
			<h1 class="text-2xl font-bold text-fg">{ manifest.Name }</h1>
			if bookEditorAllowed(cc) {
				<span class="ml-auto">
					@ownEntriesLink(cc)
				</span>
			}
		</div>
		if manifest.Description != "" {
			<p class="text-fg-secondary">{ manifest.Description }</p>
		}
	</div>
	<!-- Category cards grid -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
		for _, cat := range cats {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/systems/%s/%s", cc.Campaign.ID, manifest.ID, cat.Slug)) }
				class="block bg-surface border border-edge rounded-lg p-5 hover:border-primary/50 hover:shadow-md transition-all group"
				hx-get={ fmt.Sprintf("/campaigns/%s/systems/%s/%s", cc.Campaign.ID, manifest.ID, cat.Slug) }
				hx-target="#module-content"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				<div class="flex items-center gap-3 mb-2">
					if cat.Icon != "" {
						<i class={ "fa-solid " + cat.Icon + " text-lg text-primary group-hover:scale-110 transition-transform" }></i>
					}
					<h2 class="text-lg font-semibold text-fg">{ cat.Name }</h2>
				</div>
				<p class="text-sm text-fg-secondary">
					{ fmt.Sprintf("%d items", cat.Count) }
				</p>
			</a>
		}
	</div>
}

// SystemBrowsePage renders the category browser at its own address.
templ SystemBrowsePage(cc *campaigns.CampaignContext, manifest *SystemManifest, cats []categoryInfo, hasBook bool) {
	@layouts.App("Reference lists - " + manifest.Name) {
		@SystemBrowseContent(cc, manifest, cats, hasBook)
	}
}

// SystemBrowseContent is the category browser whether or not the system has a
// book; with one, its crumb leads up to the book.
templ SystemBrowseContent(cc *campaigns.CampaignContext, manifest *SystemManifest, cats []categoryInfo, hasBook bool) {
	<div id="module-content">
		if hasBook {
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: "/campaigns/" + cc.Campaign.ID, Icon: "fa-book-open"},
				{Label: manifest.Name, Href: systemIndexURL(cc, manifest)},
				{Label: "Reference lists"},
			})
		} else {
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: "/campaigns/" + cc.Campaign.ID, Icon: "fa-book-open"},
				{Label: manifest.Name},
			})
		}
		@systemCategoryBrowser(cc, manifest, cats)
	</div>
}

// ownEntriesLink takes the Directors to their own ancestries, kits and other
// picks for the hero creator: house rules, so they are reached from the rules.
// The rulebook widget draws the same link in its own top bar.
templ ownEntriesLink(cc *campaigns.CampaignContext) {
	<a href={ templ.SafeURL("/campaigns/" + cc.Campaign.ID + "/characters/entries") } class="btn-secondary gap-2 shrink-0" data-own-entries-link="true">
		<i class="fa-solid fa-book-open" aria-hidden="true"></i>
		Your own entries
	</a>
}
