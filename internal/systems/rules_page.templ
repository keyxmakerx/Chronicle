// rules_page.templ draws one rules entry as a page and as a peek, from the
// view RulesPages builds for the reader (rules_pages.go). It decides nothing
// about who sees what: every word here was already chosen for this reader.

package systems

import (
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	"github.com/keyxmakerx/chronicle/internal/timeutil"
)

// rulesStyles links the rules pages' own stylesheet, so it travels with an
// HTMX swap like the rulebook's does.
templ rulesStyles() {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/rules_pages.css") }/>
}

// EntryPage is an entry's full page.
templ EntryPage(cc *campaigns.CampaignContext, v *EntryView) {
	@layouts.App(v.Name + " - " + cc.Campaign.Name) {
		@EntryPageContent(v)
	}
}

// EntryPageContent is an entry's page for an HTMX swap: the trail without
// the publisher, then the entry, world first.
templ EntryPageContent(v *EntryView) {
	<div id="module-content">
		@rulesStyles()
		<article class="rp" data-widget="rules-page">
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: v.CampaignName, Href: "/campaigns/" + v.CampaignID},
				{Label: v.Category.Name, Href: v.CategoryURL},
				{Label: v.Name},
			})
			<div class={ "rp-grid", templ.KV("rp-grid--rail", len(v.Contents) > 0) }>
				<div class="rp-main">
					@entryHead(v, "h1", "rp-title")
					if v.LeftOut {
						<p class="rp-line rp-line--out">{ v.LeftOutLine }</p>
						if len(v.Table) > 0 {
							<section class="rp-section" id="at-the-table" aria-labelledby="rp-table-h">
								<h2 class="rp-h2" id="rp-table-h">At the table</h2>
								@entryTable(v.Table, nil, false)
							</section>
						}
					} else {
						if v.Summary != "" {
							<p class="rp-line">{ v.Summary }</p>
						}
						if jumps := v.jumps(); len(jumps) > 0 {
							<nav class="rp-jumps" aria-label="Jump to">
								for i, c := range jumps {
									if i > 0 {
										<span class="rp-jumps__sep" aria-hidden="true">·</span>
									}
									<a href={ templ.SafeURL("#" + c.ID) }>{ c.Label }</a>
								}
							</nav>
						}
						if len(v.Story) > 0 || v.StoryHTML != "" {
							<section class="rp-story" id="story" aria-label="Story">
								if v.StoryHTML != "" {
									<div class="rp-prose">
										@templ.Raw(v.StoryHTML)
									</div>
								} else {
									<div class="rp-prose">
										@paras(v.Story)
									</div>
								}
							</section>
						}
						if !v.InCampaign.empty() {
							@inCampaign(v)
						}
						if len(v.Table) > 0 {
							<section class="rp-section" id="at-the-table" aria-labelledby="rp-table-h">
								<h2 class="rp-h2" id="rp-table-h">At the table</h2>
								@entryTable(v.Table, nil, false)
							</section>
						}
						@entryNotes(v.Notes)
					}
				</div>
				if len(v.Contents) > 0 {
					<aside class="rp-aside">
						<nav class="rp-toc" aria-label="On this page" data-rp-toc>
							<p class="rp-cap">On this page</p>
							for _, c := range v.Contents {
								<a class="rp-toc__link" href={ templ.SafeURL("#" + c.ID) } data-rp-toc-link={ c.ID }>{ c.Label }</a>
							}
						</nav>
					</aside>
				}
			</div>
		</article>
	</div>
}

// entryHead is the kind in small words, the name, the whose-words line and
// the Director's amber marks, shared by the page and the peek.
templ entryHead(v *EntryView, tag string, titleClass string) {
	<header class="rp-head">
		<p class="rp-kind">{ v.Kind }</p>
		if tag == "h1" {
			<h1 class={ titleClass }>{ v.Name }</h1>
		} else {
			<h2 class={ titleClass } id="peek-title">{ v.Name }</h2>
		}
		if v.Hero != nil && len(v.Hero.Traits) > 0 {
			<p class="rp-has">
				{ v.Hero.Short } has:
				for i, t := range v.Hero.Traits {
					if i > 0 {
						{ ", " }
					}
					<a href={ templ.SafeURL("#" + t.Anchor) }>{ t.Name }</a>
				}
			</p>
		}
		if v.Whose != nil {
			<p class={ "rp-whose", "rp-whose--" + v.Whose.Tone }>{ v.Whose.Text }</p>
		}
		for _, m := range v.Marks {
			<p class="rp-dm" data-dm-only>
				<span class="cb-dm rp-dm__tag">Directors only</span>
				if m.Text != "" {
					<span>{ m.Text }</span>
				}
				if m.Href != "" {
					<a class="rp-dm__link" href={ templ.SafeURL(m.Href) }>{ m.LinkText }</a>
				}
			</p>
		}
		@entryDirectorSlot(v)
	</header>
}

// entryDirectorSlot is where the Director's own amber words on an entry
// will go (rewriting it for the campaign, leaving it out). It draws
// nothing yet.
templ entryDirectorSlot(v *EntryView) {
}

templ paras(ps []para) {
	for _, p := range ps {
		<p>
			for _, r := range p {
				if r.Bold {
					<strong>{ r.Text }</strong>
				} else {
					{ r.Text }
				}
			}
		</p>
	}
}

// inCampaign is "In <campaign>": heroes first, then the others, each run
// only where it has someone the reader may see.
templ inCampaign(v *EntryView) {
	<section class="rp-section" id="in-campaign" aria-labelledby="rp-in-h">
		<h2 class="rp-h2" id="rp-in-h">In { v.CampaignName }</h2>
		if len(v.InCampaign.Heroes) > 0 {
			@peopleRun("Heroes", v.InCampaign.Heroes, v.InCampaign.MoreHeroes)
		}
		if len(v.InCampaign.Others) > 0 {
			if v.IsDirector {
				@peopleRun("Others", v.InCampaign.Others, v.InCampaign.MoreOthers)
			} else {
				@peopleRun("Others you have met", v.InCampaign.Others, v.InCampaign.MoreOthers)
			}
		}
	</section>
}

templ peopleRun(label string, people []personLink, more int) {
	<div class="rp-run">
		<p class="rp-cap">{ label }</p>
		<p class="rp-names">
			for _, c := range people {
				<a href={ templ.SafeURL(c.URL) } data-entity-preview={ c.Preview }>{ c.Name }</a>
			}
			if more > 0 {
				<span class="rp-more">and { itoa(more) } more</span>
			}
		</p>
	</div>
}

// entryTable is "At the table". hero names who holds a trait in a peek;
// short draws a cost as its number alone.
templ entryTable(details []tableDetail, hero *heroView, short bool) {
	for _, d := range details {
		switch d.Kind {
			case detailFigures:
				<dl class="rp-figs">
					for _, f := range d.Figures {
						<div class="rp-fig"><dt>{ f.Label }</dt><dd>{ f.Value }</dd></div>
					}
				</dl>
			case detailText:
				<div class="rp-detail">
					<h3 class="rp-h3">{ d.Label }</h3>
					<div class="rp-prose rp-prose--small">
						@paras(d.Text)
					</div>
				</div>
			case detailWords:
				<div class="rp-detail">
					<h3 class="rp-h3">{ d.Label }</h3>
					<p class="rp-words">{ d.Words }</p>
				</div>
			case detailParts:
				<div class="rp-detail">
					<h3 class="rp-h3">{ d.Label }</h3>
					@partList(d.Parts)
				</div>
			case detailItems:
				<div class="rp-detail">
					<h3 class="rp-h3">
						<span>{ d.Label }</span>
						if d.Aside != "" {
							<span class="rp-h3__aside">{ d.Aside }</span>
						}
					</h3>
					<ul class="rp-items">
						for _, it := range d.Items {
							<li class={ "rp-item", templ.KV("rp-item--held", it.Held) } id={ it.Anchor }>
								<div class="rp-item__head">
									<span class="rp-item__name">{ it.Name }</span>
									if short && it.CostShort != "" {
										<span class="rp-item__cost">{ it.CostShort }</span>
									} else if it.Cost != "" {
										<span class="rp-item__cost">{ it.Cost }</span>
									}
								</div>
								if it.Held && hero != nil {
									<p class="rp-item__mark">{ hero.Short } has this</p>
								}
								if it.NoLongerOffered {
									<p class="rp-item__mark rp-item__mark--out">No longer offered</p>
								}
								if len(it.Text) > 0 {
									<div class="rp-prose rp-prose--small">
										@paras(it.Text)
									</div>
								}
								if len(it.Parts) > 0 {
									@partList(it.Parts)
								}
							</li>
						}
					</ul>
				</div>
		}
	}
}

templ partList(parts []part) {
	<dl class="rp-parts">
		for _, p := range parts {
			<div class="rp-part">
				<dt>{ p.Label }</dt>
				<dd>
					@paras(p.Text)
				</dd>
			</div>
		}
	</dl>
}

// entryNotes are the dated lines the players were told, newest first.
templ entryNotes(notes []noteLine) {
	if len(notes) > 0 {
		<section class="rp-notes" id="changes" aria-label="Changes">
			for _, n := range notes {
				<p class="rp-note">
					<span>Changed on </span>
					@components.Date(n.At, timeutil.DateWeekday)
					<span>{ ": " + n.Line }</span>
				</p>
			}
		</section>
	}
}

// EntryPeekPanel is an entry's body for the page peek
// (static/js/peek_panel.js): its traits first, the hero's marked, and a
// quiet way to the page. No script; links only.
templ EntryPeekPanel(v *EntryView) {
	<article class="peek-body rp rp-peek" data-peek-root="1">
		@rulesStyles()
		@entryHead(v, "h2", "rp-peek-title")
		if v.LeftOut {
			<p class="rp-line rp-line--out">{ v.LeftOutLine }</p>
		} else if v.Hero == nil && v.Summary != "" {
			<p class="rp-line">{ v.Summary }</p>
		}
		if len(v.Table) > 0 {
			@entryTable(v.Table, v.Hero, true)
		}
		@entryNotes(v.Notes)
		<p class="rp-peek-foot"><a class="rp-quiet" href={ templ.SafeURL(v.URL) }>Open the page</a></p>
	</article>
}
