// sidebar_list.templ renders a compact entity list for the sidebar drill panel.
// Used by SearchAPI with ?sidebar=1 to display category pages inline.
// Includes data attributes for client-side tree building and drag-and-drop.
// Also renders sidebar folder nodes (pure organizational containers).

package entities

import (
	"fmt"
	"strconv"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
)

// SidebarEntityList renders entity results and folder nodes as compact items
// for the sidebar panel. Each item includes data attributes for tree structure
// and reordering. sidebar_tree.js transforms this flat list into a
// collapsible tree with drag-and-drop support — no folder/page icons: a
// folder is its chevron, a semibold name and a count (added client-side);
// a page is its plain name. hiddenIDs marks entities that should appear
// dimmed for owners.
//
// typeID is the drilled category's own entity type (the sidebar URL's ?type=),
// NOT a per-row type. It drives data-entity-type-id, which sidebar_tree.js
// reads when creating an empty folder (a sidebar_nodes row). The category
// listing rolls up sub-type entities (expandTypeIDsForListing), so
// results[0].EntityTypeID may be a SUB-type; a new folder node must anchor on
// the category typeID, not a row's sub-type, or SearchAPI's exact-match
// reload (ListByType(categoryTypeID)) can't find it on refresh.
templ SidebarEntityList(results []Entity, nodes []SidebarNode, total int, typeID int, cc *campaigns.CampaignContext, hiddenIDs map[string]bool) {
	if len(results) == 0 && len(nodes) == 0 {
		<div class="px-4 py-6 text-center">
			<i class="fa-solid fa-file-circle-plus text-lg text-gray-600 mb-2 block"></i>
			<span class="text-xs text-gray-500">No pages yet</span>
		</div>
	} else {
		<div
			id="sidebar-entity-tree"
			class="sidebar-entity-list py-1"
			data-campaign-id={ cc.Campaign.ID }
			data-entity-type-id={ strconv.Itoa(sidebarTreeType(typeID, results, nodes)) }
		>
			// Render sidebar folder nodes (pure organizational containers).
			for _, node := range nodes {
				<div
					class="sidebar-tree-item sidebar-tree-folder tree-row is-folder"
					data-node-id={ node.ID }
					data-is-folder="true"
					if node.ParentID != nil {
						data-parent-id={ *node.ParentID }
					}
					data-sort-order={ strconv.Itoa(node.SortOrder) }
					data-entity-name={ node.Name }
					draggable="true"
				>
					<span class="tree-lb">{ node.Name }</span>
				</div>
			}
			// Render entity items (navigable pages).
			for _, entity := range results {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, entity.ID)) }
					class={
						"sidebar-tree-item tree-row is-page",
						templ.KV("opacity-40", hiddenIDs[entity.ID]),
					}
					data-entity-id={ entity.ID }
					if entity.ParentID != nil {
						data-parent-id={ *entity.ParentID }
					}
					if entity.ParentNodeID != nil {
						data-parent-node-id={ *entity.ParentNodeID }
					}
					data-sort-order={ strconv.Itoa(entity.SortOrder) }
					data-entity-name={ entity.Name }
					if hiddenIDs[entity.ID] {
						data-sidebar-hidden="true"
					}
					draggable="true"
				>
					<span class="tree-lb">{ entity.Name }</span>
					if hiddenIDs[entity.ID] {
						<i class="fa-solid fa-eye-slash tree-hid" title="Hidden from players"></i>
					}
				</a>
			}
			// Extra listings: the same page shown under a second parent. They
			// carry no data-entity-id, so a drag, a reorder or a count never
			// mistakes them for the page's real row (sidebar_tree.js keys them
			// by data-place-key and never makes them draggable).
			for _, pl := range treePlacesOf(ctx) {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, pl.EntityID)) }
					class={
						"sidebar-tree-item tree-row is-page is-place",
						templ.KV("opacity-40", hiddenIDs[pl.EntityID]),
					}
					data-place-key={ placeSidebarKey(pl) }
					data-place-entity={ pl.EntityID }
					data-parent-id={ pl.ParentID }
					data-sort-order={ strconv.Itoa(pl.SortOrder) }
					data-entity-name={ pl.EntityName }
					title="Also listed here. It is the same page, edited once."
				>
					<span class="tree-lb">{ pl.EntityName }</span>
					<span class="tree-also"><i class="fa-solid fa-link" aria-hidden="true"></i> also here</span>
				</a>
			}
		</div>
		if total > len(results) {
			<!-- Load more sentinel for infinite scroll -->
			<div
				id="sidebar-load-more"
				data-page="2"
				data-total={ strconv.Itoa(total) }
				data-loaded={ strconv.Itoa(len(results)) }
			>
				<button
					type="button"
					class="nav-tree-more"
					onclick="this.parentElement.dispatchEvent(new CustomEvent('sidebar:load-more', {bubbles: true}))"
				>
					{ fmt.Sprintf("Load more (%d of %d)", len(results), total) }
				</button>
			</div>
		}
	}
}
