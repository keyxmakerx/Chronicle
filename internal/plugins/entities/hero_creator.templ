// hero_creator.templ — the hero creator page: one page per step, and each
// entry's leaf slides out from under it. The page is a mount point; the
// creator script (static/js/hero_creator.js, loaded on sight, ADR-063)
// fetches the steps and draws the paper.

package entities

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/plugins/entities/cardborders"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// HeroCreatorView is what the creator page needs besides the campaign.
type HeroCreatorView struct {
	// TypeName is the page type the hero becomes, for the closing step.
	TypeName string
	// ForSelf is true when the hero becomes the viewer's own.
	ForSelf   bool
	CSRFToken string
	// TermsURL is where the builder reads the system's rules words; empty
	// when the system has no glossary, which leaves the attribute off.
	TermsURL string
	// Look is "stage" when the page asks for the hero-on-stage look; any other
	// value is the classic look and leaves the attribute and stylesheet off.
	Look string
}

// HeroLookStage is the one value of ?look= that switches the hero creator to
// the hero-on-stage look.
const HeroLookStage = "stage"

// HeroCreatorPage renders the creator inside the App shell.
templ HeroCreatorPage(cc *campaigns.CampaignContext, view HeroCreatorView) {
	@layouts.App("Create hero - " + cc.Campaign.Name) {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/entities/css/hero_creator.css") }/>
		if view.Look == HeroLookStage {
			<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/entities/css/hero_stage.css") }/>
			<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/entities/css/hero_borders.css") }/>
		}
		<div class="max-w-7xl mx-auto sm:px-4">
			<div
				class="hc"
				data-widget="hero-creator"
				data-hero-creator="true"
				data-campaign-id={ cc.Campaign.ID }
				data-plan-url={ fmt.Sprintf("/campaigns/%s/characters/new/plan", cc.Campaign.ID) }
				data-create-url={ fmt.Sprintf("/campaigns/%s/characters/new", cc.Campaign.ID) }
				data-csrf={ view.CSRFToken }
				data-type-name={ view.TypeName }
				data-for-self={ fmt.Sprint(view.ForSelf) }
				data-skin={ layouts.BuilderSkin(ctx) }
				if view.TermsURL != "" {
					data-terms-url={ view.TermsURL }
				}
				if view.Look == HeroLookStage {
					data-look={ HeroLookStage }
					data-borders={ cardborders.LibraryJSON(layouts.AssetURL) }
				}
			>
				<div class="hc-loading" role="status">
					<p class="hc-loading__text">Opening the creator…</p>
				</div>
				<noscript>
					<p class="text-sm text-fg-muted">The hero creator needs JavaScript. You can still add a character page from the Characters page.</p>
				</noscript>
			</div>
		</div>
	}
}

// HeroAlreadyPage is what a player who already has a hero sees at the
// creator's address: players have one hero at a time, so it points them at
// theirs instead of calling the creator unavailable.
templ HeroAlreadyPage(cc *campaigns.CampaignContext, hero *Entity) {
	@layouts.App("You already have a hero - " + cc.Campaign.Name) {
		<div class="max-w-2xl mx-auto px-4 py-10">
			<h1 class="text-xl font-semibold text-fg mb-2">You already have a hero</h1>
			<p class="text-fg-muted mb-4">Players have one hero at a time in this campaign, so there is nothing new to create. Open { hero.Name } to keep building it.</p>
			<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, hero.ID)) } class="btn-primary">Go to { hero.Name }</a>
		</div>
	}
}
