// characters.templ — per-campaign Characters ("Cast") page. Bands: Yours (the
// viewer's own characters), the Party (claimed player characters of the page
// types the owner listed) and the NPCs (the npcs plugin's section, for the
// types the owner listed; entities the GM tagged `cast` are featured). Each card is a
// real link to the entity page and carries the data attributes characters.js
// uses to launch a mini→full preview via the dynamic-surface frame.

package entities

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CharactersPage renders the full Characters page for a campaign, wrapping the
// content fragment in the App shell.
//
// THE ENHANCEMENT SCRIPT IS DELIBERATELY NOT HERE. A `<script src>` here
// would sit inside `<main id="main-content">`, which every boosted sidebar
// link swaps with `htmx.config.allowScriptTags = false` — htmx REMOVES any
// script tag in the swapped fragment rather than just skipping it. The
// driver ships from the plugin body-script registry instead
// (internal/app/routes.go -> layouts.SetPluginBodyScripts -> base.templ),
// which emits outside the swapped region. Pinned by
// characters_boosted_nav_test.go; do not put it back.
templ CharactersPage(cc *campaigns.CampaignContext, view CastView) {
	@layouts.App("Characters - " + cc.Campaign.Name) {
		<div class="max-w-7xl mx-auto px-4 py-6" id="characters-root">
			@CharactersContent(cc, view)
		</div>
	}
}

// CharactersContent is the HTMX-swappable body: the viewer's own characters,
// then the Party and NPC bands. Returned alone for boosted/fragment requests;
// wrapped by CharactersPage for full loads. The owner's list controls swap this
// whole region (#cast-content) after each change.
templ CharactersContent(cc *campaigns.CampaignContext, view CastView) {
	<div id="cast-content">
		<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
			<div>
				<h1 class="text-2xl font-bold text-fg">Characters</h1>
				<p class="mt-1 text-sm text-fg-secondary">The cast of { cc.Campaign.Name }.</p>
			</div>
			if view.CanCreateHero {
				<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/characters/new", cc.Campaign.ID)) } class="btn-primary" data-create-hero="true">
					<i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>
					Create hero
				</a>
			}
		</div>
		if len(view.Yours) > 0 {
			<section class="mb-8" data-yours="true">
				<h2 class="section-header mb-3">Yours</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
					for _, m := range view.Yours {
						@castCard(cc.Campaign.ID, m)
					}
				</div>
			</section>
		}
		if view.ShowPlayers && (view.PartyListed || view.PartyEditor != nil || len(view.Party) > 0) {
			<section class="mb-8" data-band="characters">
				@castBandHead("The Party", view.PartyEditor, view.Landed)
				if view.PartyEditor != nil {
					@castBandFold(cc.Campaign.ID, view.CSRFToken, view.PartyEditor)
				}
				if !view.PartyListed && view.PartyEditor != nil {
					@castBandEmpty()
				} else if len(view.Party) == 0 {
					if view.ClaimTypeID != 0 {
						@castEmptyLink("fa-users", "No player characters yet", "Claimed characters appear here.", "Find a character to claim →", fmt.Sprintf("/campaigns/%s/entities?type=%d", cc.Campaign.ID, view.ClaimTypeID))
					} else {
						@castEmpty("fa-users", "No player characters yet", "Claimed characters appear here. Players can claim a character from its page.")
					}
				} else {
					<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
						for _, m := range view.Party {
							@castCard(cc.Campaign.ID, m)
						}
					</div>
				}
			</section>
		}
		if view.NPCSection != nil || view.NPCEditor != nil {
			<section data-band="npcs">
				@castBandHead("NPCs", view.NPCEditor, view.Landed)
				if view.NPCEditor != nil {
					@castBandFold(cc.Campaign.ID, view.CSRFToken, view.NPCEditor)
				}
				if view.NPCSection != nil {
					@view.NPCSection
				} else if view.NPCEditor != nil {
					@castBandEmpty()
				}
			</section>
		}
		if view.Notice != "" {
			<div class="ag-toast ag-toast-timed" role="status">
				<i class="fa-solid fa-circle-check" aria-hidden="true"></i>
				<span>{ view.Notice }</span>
			</div>
		}
	</div>
}

// castBandHead is a band's heading. The owner's page adds the chosen types as
// chips (each with an x that opens its in-place "stop showing" box) and the Add
// button; everyone else sees the heading alone.
templ castBandHead(label string, ed *CastBandEditor, landed int) {
	<div class="ag-bandhead">
		<h2 class="section-header">{ label }</h2>
		if ed != nil {
			<span class="ag-chips">
				for _, ch := range ed.Chips {
					<span class={ "ag-chip", templ.KV("ag-landed", ch.ID == landed) } data-chip={ strconv.Itoa(ch.ID) }>
						{ ch.Name }
						<button type="button" aria-label={ "Stop showing " + ch.Name + " pages here" } onclick={ castFoldRemoveCall(ch.ID) }>
							<i class="fa-solid fa-xmark" aria-hidden="true"></i>
						</button>
					</span>
				}
			</span>
			<button type="button" class="ag-add" aria-expanded="false" onclick={ castFoldCall("add") }>
				<i class="fa-solid fa-plus" aria-hidden="true"></i> Add
			</button>
		}
	</div>
}

// castBandEmpty is what the owner sees on a band with no page types yet.
templ castBandEmpty() {
	<div class="ag-empty">
		No page types yet.
		<button type="button" class="ag-link" style="font-size:13px" onclick={ castFoldCall("add") }>+ Add</button>
		the types that belong here.
	</div>
}

// castBandFold holds the owner's boxes, closed until a control opens one: the
// Add box and one "stop showing" box per chip. Each is a form posting to the
// list endpoint, which answers with the refreshed page body.
templ castBandFold(campaignID, csrf string, ed *CastBandEditor) {
	<div class="ag-fold" data-open="">
		<form
			class="ag-box"
			data-box="add"
			hidden
			method="post"
			action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/characters/lists", campaignID)) }
			hx-post={ fmt.Sprintf("/campaigns/%s/characters/lists", campaignID) }
			hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrf) }
			hx-target="#cast-content"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<input type="hidden" name="list" value={ string(ed.Kind) }/>
			<input type="hidden" name="op" value="add"/>
			<div class="ag-head">
				<h4>Add to { ed.Label }</h4>
				<button type="button" class="ag-x" aria-label="Close" onclick={ castFoldCall("") }>
					<i class="fa-solid fa-xmark" aria-hidden="true"></i>
				</button>
			</div>
			<div class="ag-body">
				<div class="ag-search">
					<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
					<input type="search" class="input w-full text-sm" placeholder="Search page types" aria-label="Search page types" autocomplete="off" oninput={ castSearchCall }/>
				</div>
				<div class="ag-list" role="radiogroup" aria-label="Page types">
					for _, o := range ed.Options {
						<label class={ "ag-row", templ.KV("is-sub", o.IsSub) }>
							<input type="radio" name="type_id" value={ strconv.Itoa(o.ID) } data-say={ castPickSay(ed.Kind, o) } onchange={ castPickCall }/>
							<span class="ag-name"><b>{ o.Name }</b></span>
							if len(o.With) > 0 {
								<span class="ag-tag">with { strings.Join(o.With, ", ") }</span>
							}
							<span class="ag-count" title={ strconv.Itoa(o.Count) + " pages" }>{ strconv.Itoa(o.Count) }</span>
						</label>
					}
					if len(ed.Options) == 0 {
						<div class="ag-more">Every page type is already on this list.</div>
					}
					<div class="ag-more" data-nomatch hidden>No page type matches.</div>
				</div>
				<div class="ag-hint" data-hint></div>
				<div class="ag-foot">
					<span class="ag-sp"></span>
					<button type="button" class="btn-secondary btn-sm" onclick={ castFoldCall("") }>Cancel</button>
					<button type="submit" class="btn-primary btn-sm" data-save disabled>Save</button>
				</div>
			</div>
		</form>
		for _, ch := range ed.Chips {
			<form
				class="ag-box ag-confirm"
				data-box={ "rm-" + strconv.Itoa(ch.ID) }
				hidden
				method="post"
				action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/characters/lists", campaignID)) }
				hx-post={ fmt.Sprintf("/campaigns/%s/characters/lists", campaignID) }
				hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrf) }
				hx-target="#cast-content"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="list" value={ string(ed.Kind) }/>
				<input type="hidden" name="op" value="remove"/>
				<input type="hidden" name="type_id" value={ strconv.Itoa(ch.ID) }/>
				<div class="ag-body">
					<p>Stop showing { ch.Name } pages under { ed.Label }?</p>
					<small>The pages stay where they are; they only leave this list. You can add the type back at any time.</small>
					<div class="ag-foot">
						<span class="ag-sp"></span>
						<button type="button" class="btn-secondary btn-sm" onclick={ castFoldCall("") }>Keep</button>
						<button type="submit" class="btn-danger btn-sm">Remove</button>
					</div>
				</div>
			</form>
		}
	</div>
}

// castCard is one mini profile card. The whole card links to the entity page
// (works with no JS); the corner "quick look" button is upgraded by
// characters.js into a mini→full launch. The viewer's own characters get a
// "You" ribbon and an accent ring.
templ castCard(campaignID string, m CastMember) {
	<div
		class={ "group relative rounded-lg bg-surface overflow-hidden transition-all hover:shadow-md hover:-translate-y-0.5",
			templ.KV("border border-accent ring-1 ring-accent/40", m.IsViewer),
			templ.KV("border border-edge hover:border-accent", !m.IsViewer) }
		data-cast-card="true"
		data-entity-name={ m.Entity.Name }
		data-preview-url={ fmt.Sprintf("/campaigns/%s/entities/%s/preview", campaignID, m.Entity.ID) }
	>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", campaignID, m.Entity.ID)) }
			data-cast-link="true"
			class="block"
		>
			<div class="aspect-[3/2] bg-surface-alt relative overflow-hidden">
				if m.Entity.CoverImagePath != nil && *m.Entity.CoverImagePath != "" {
					<img src={ layouts.MediaURL(ctx, *m.Entity.CoverImagePath) } alt="" class="w-full h-full object-cover transition-transform group-hover:scale-105" loading="lazy"/>
				} else if m.Entity.ImagePath != nil && *m.Entity.ImagePath != "" {
					<img src={ layouts.MediaURL(ctx, *m.Entity.ImagePath) } alt="" class="w-full h-full object-cover transition-transform group-hover:scale-105" loading="lazy"/>
				} else {
					<div class="w-full h-full flex items-center justify-center text-fg-muted">
						if m.Entity.TypeIcon != "" {
							<i class={ "fa-solid " + m.Entity.TypeIcon, "text-3xl" } style={ fmt.Sprintf("color: %s", m.Entity.TypeColor) }></i>
						} else {
							<i class="fa-solid fa-user text-3xl"></i>
						}
					</div>
				}
				if m.IsViewer {
					<span class="absolute top-2 left-2 text-[10px] font-semibold uppercase tracking-wide px-1.5 py-0.5 rounded bg-accent-fill text-on-accent shadow-sm">You</span>
				}
			</div>
			<div class="p-3">
				<h3 class="font-semibold text-fg truncate group-hover:text-accent transition-colors" title={ m.Entity.Name }>{ m.Entity.Name }</h3>
				<p class="text-xs text-fg-muted mt-0.5 truncate">
					if m.Entity.TypeName != "" {
						{ m.Entity.TypeName }
					}
					if m.Entity.TypeLabel != nil && *m.Entity.TypeLabel != "" {
						<span class="mx-1">·</span>
						{ *m.Entity.TypeLabel }
					}
				</p>
				if m.OwnerName != "" {
					<p class="text-[11px] text-fg-secondary mt-1 truncate">
						<i class="fa-solid fa-user-tag mr-1 opacity-60"></i>{ m.OwnerName }
					</p>
				}
			</div>
		</a>
		<button
			type="button"
			data-cast-peek="true"
			title="Quick look"
			aria-label={ "Quick look at " + m.Entity.Name }
			class="absolute top-2 right-2 z-10 inline-flex items-center justify-center w-7 h-7 rounded-md bg-surface/90 border border-edge text-fg-muted opacity-0 group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent hover:text-accent hover:border-accent transition-all"
		>
			<i class="fa-solid fa-expand text-xs"></i>
		</button>
	</div>
}

// castEmptyLink is castEmpty plus a link to where the action happens.
templ castEmptyLink(icon, title, desc, linkText, href string) {
	<div class="rounded-lg border border-edge bg-surface p-6 text-center">
		<div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-accent/10 text-accent mb-3">
			<i class={ "fa-solid " + icon }></i>
		</div>
		<h3 class="text-sm font-semibold text-fg mb-1">{ title }</h3>
		<p class="text-xs text-fg-secondary max-w-sm mx-auto">{ desc }</p>
		<a href={ templ.SafeURL(href) } class="inline-block mt-3 text-xs font-medium text-accent hover:underline">{ linkText }</a>
	</div>
}

// castEmpty is the friendly empty-state panel for a band with no members.
templ castEmpty(icon, title, desc string) {
	<div class="rounded-lg border border-edge bg-surface p-6 text-center">
		<div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-accent/10 text-accent mb-3">
			<i class={ "fa-solid " + icon }></i>
		</div>
		<h3 class="text-sm font-semibold text-fg mb-1">{ title }</h3>
		<p class="text-xs text-fg-secondary max-w-sm mx-auto">{ desc }</p>
	</div>
}
