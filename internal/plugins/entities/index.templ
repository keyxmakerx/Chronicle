// index.templ renders All pages: every page of the campaign as one plain list
// on hairline rules, with a Gallery as its second view. HTMX swaps the whole
// list for paging, order and the find field.

package entities

import (
	"encoding/json"
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	"strconv"
)

// entityTypesJSONForBulk serializes entity types for the bulk actions widget.
func entityTypesJSONForBulk(types []EntityType) string {
	type etMin struct {
		ID   int    `json:"id"`
		Name string `json:"name"`
	}
	out := make([]etMin, len(types))
	for i, t := range types {
		out[i] = etMin{ID: t.ID, Name: t.Name}
	}
	b, _ := json.Marshal(out)
	return string(b)
}

// tagsJSONForBulk returns an empty array placeholder. Tags are loaded
// dynamically by the bulk actions widget if needed.
func tagsJSONForBulk(cc *campaigns.CampaignContext) string {
	return "[]"
}

// listHeading names the list: the category the address asks for when the
// viewer can see it, and All pages otherwise. An address that names no such
// category is All pages too, so one that is hidden reads like one never made.
func listHeading(entityTypes []EntityType, activeTypeSlug string) string {
	if activeTypeSlug != "" {
		for _, et := range entityTypes {
			if et.Slug == activeTypeSlug {
				return et.NamePlural
			}
		}
	}
	return "All pages"
}

// EntityIndexPage renders the list as a full page, its tab named as the
// heading is.
templ EntityIndexPage(cc *campaigns.CampaignContext, entities []Entity, entityTypes []EntityType, counts map[int]int, total int, opts ListOptions, activeTypeID int, activeTypeSlug string, csrfToken string) {
	@layouts.App(listHeading(entityTypes, activeTypeSlug) + " - " + cc.Campaign.Name) {
		@EntityListContent(cc, entities, entityTypes, counts, total, opts, activeTypeID, activeTypeSlug, csrfToken)
	}
}

// EntityListContent renders the list (also the HTMX partial). The widget on
// the root remembers the view per browser and, for people who may change
// pages, puts a tick box in the margin of each row and runs the bar of
// changes. Everything a player is sent is already filtered by the server:
// a hidden page is not in this list, so there is no mark and no gap.
templ EntityListContent(cc *campaigns.CampaignContext, entities []Entity, entityTypes []EntityType, counts map[int]int, total int, opts ListOptions, activeTypeID int, activeTypeSlug string, csrfToken string) {
	<div
		id="entity-list"
		class="el"
		data-view="list"
		data-view-key={ allPagesViewKey }
		data-widget="bulk-actions"
		data-campaign-id={ cc.Campaign.ID }
		data-csrf-token={ csrfToken }
		data-role={ strconv.Itoa(int(cc.MemberRole)) }
		if cc.CanAuthorDmOnly() {
			data-can-hide="true"
		}
		data-entity-types={ entityTypesJSONForBulk(entityTypes) }
		data-tags={ tagsJSONForBulk(cc) }
	>
		@layouts.AppFrame() {
			@layouts.AppOpening(allPagesOpening(ctx, cc, listHeading(entityTypes, activeTypeSlug), total, opts)) {
				<span>{ allPagesCount(total, opts.Query) }</span>
				if cc.MemberRole >= campaigns.RoleScribe && len(entities) > 0 {
					<button
						type="button"
						class="quiet-word el-select-word"
						aria-pressed="false"
						onclick={ allPagesSelectJS() }
					>Select</button>
				}
			}
			if !allPagesBare(total, opts) {
				@entityListTools(cc, entityTypes, counts, total, opts, activeTypeID, activeTypeSlug)
				if len(entities) == 0 {
					<p class="el-none">Nothing matches that search. Try fewer or different words.</p>
				} else {
					<div data-view-pane="list">
						<ul class="el-list">
							for _, entity := range entities {
								@EntityRow(&entity, cc)
							}
						</ul>
					</div>
					<div data-view-pane="gallery">
						<ul class="el-gallery">
							for _, entity := range entities {
								@EntityCard(&entity, cc)
							}
						</ul>
					</div>
					@entityPager(components.PaginationData{
						CurrentPage: opts.Page,
						PerPage:     opts.PerPage,
						Total:       total,
						BaseURL:     fmt.Sprintf("/campaigns/%s/entities", cc.Campaign.ID),
						ExtraParams: entityListParams(activeTypeID, opts.Query, opts.Sort),
						HTMXTarget:  "#entity-list",
					})
				}
			}
		}
	</div>
}
