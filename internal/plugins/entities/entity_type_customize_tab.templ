package entities

import (
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
)

// EntityTypeCustomizeTabTmpl is one tab of a category's Customize workspace.
// The page layout is Customize's page editor, which saves with the rest of
// the draft; the category home and the fields still use today's editors,
// each saving with its own button.
templ EntityTypeCustomizeTabTmpl(cc *campaigns.CampaignContext, et *EntityType, tab, csrfToken string) {
	switch tab {
		case "layout":
			<div
				data-widget="customize-page-editor"
				data-state={ pageEditorState(cc, et) }
			></div>
		case "home":
			<div class="max-w-4xl">
				@categoryDashboardTab(cc, et, csrfToken)
			</div>
		case "fields":
			<div class="max-w-3xl">
				@attributesTab(cc, et, csrfToken)
			</div>
	}
}
