package entities

import (
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
)

// EntityTypeCustomizeTabTmpl is one tab of a category's Customize workspace.
// The page layout and the category home are the Customizer's page editor,
// which saves with the rest of the draft; the fields still use today's
// editor, saving with its own button.
templ EntityTypeCustomizeTabTmpl(cc *campaigns.CampaignContext, et *EntityType, tab, csrfToken string) {
	switch tab {
		case "layout":
			<div
				data-widget="customize-page-editor"
				data-state={ pageEditorState(ctx, cc, et) }
			></div>
		case "home":
			<div
				data-widget="customize-page-editor"
				data-state={ categoryHomeEditorState(cc, et) }
			></div>
		case "fields":
			<div class="max-w-3xl">
				@attributesTab(cc, et, csrfToken)
			</div>
	}
}
