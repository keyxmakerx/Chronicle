// entity_card.templ draws one page as a tile of the Gallery view: its own
// picture with the name under it. A page with no picture shows its opening
// words in the picture's place, never a stand-in.

package entities

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// EntityCard renders a page as a gallery tile. Tags and the edited time are
// one step away, on the hover card. Opening is the words the handler already
// served this reader (secrets and hidden mentions removed), never the stored
// text, so a tile cannot leak what a row would not.
templ EntityCard(entity *Entity, cc *campaigns.CampaignContext) {
	<li class="el-tile" data-entity-row data-entity-id={ entity.ID }>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, entity.ID)) }
			class="cb-link el-tile-link"
			data-entity-preview={ fmt.Sprintf("/campaigns/%s/entities/%s/preview", cc.Campaign.ID, entity.ID) }
			if sidebarDMOnly(cc, entity) {
				data-dm-only
			}
		>
			if entity.ImagePath != nil && *entity.ImagePath != "" {
				<span class="el-tile-pic" aria-hidden="true">
					<img src={ layouts.MediaURL(ctx, *entity.ImagePath) } alt="" loading="lazy"/>
				</span>
			} else {
				<span class="el-tile-pic el-tile-words" aria-hidden="true">{ entity.Opening }</span>
			}
			<span class="el-tile-name">
				<span class="el-name">{ entity.Name }</span>
				@listLock(cc, entity)
				@customShield(cc, entity)
			</span>
			<span class="el-kind">{ entityKindWords(entity) }</span>
		</a>
	</li>
}
