// tryout_creator.templ — the hero creator page in try-out mode. The same
// creator script mounts; data-tryout switches it to a build that is kept in
// the browser and never sent. There is no CSRF token and no save address
// because nothing is posted.

package entities

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// TryoutCreatorPage renders the creator in try-out mode inside the App shell.
templ TryoutCreatorPage(cc *campaigns.CampaignContext, view TryoutCreatorView) {
	@layouts.App("Try the hero builder - " + cc.Campaign.Name) {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/entities/css/hero_creator.css") }/>
		@heroLookLinks(view.Look)
		<div class="max-w-7xl mx-auto sm:px-4">
			<div
				class="hc"
				data-widget="hero-creator"
				data-hero-creator="true"
				data-tryout="true"
				data-campaign-id={ view.CampaignID }
				data-user-id={ view.UserID }
				data-plan-url={ fmt.Sprintf("/campaigns/%s/characters/try/plan", view.CampaignID) }
				data-back-url={ fmt.Sprintf("/campaigns/%s/characters", view.CampaignID) }
				data-type-name="practice hero"
				data-for-self="false"
				data-skin={ layouts.BuilderSkin(ctx) }
				{ heroLookAttrs(view.Look)... }
				if view.TermsURL != "" {
					data-terms-url={ view.TermsURL }
				}
			>
				<div class="hc-loading" role="status">
					<p class="hc-loading__text">Opening the creator…</p>
				</div>
				<noscript>
					<p class="text-sm text-fg-muted">The hero builder needs JavaScript.</p>
				</noscript>
			</div>
		</div>
	}
}
