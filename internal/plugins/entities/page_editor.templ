// page_editor.templ draws the page editor's own pieces: Edit page with the keys
// that work while editing, the pen beside a part, and the header's sheet. The
// behaviour lives in static/js/widgets/page_editor.js, which mounts on the bar
// and listens on the page; nothing here carries a handler of its own.

package entities

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
)

// pageEditorBar is Edit page, which becomes Done in the same spot, with the
// Saving/Saved note beside it and, while editing, the keys that work. Its
// children (the page's visibility badge) stand next to Edit page.
templ pageEditorBar(cc *campaigns.CampaignContext, entity *Entity) {
	<div
		class="pe-bar"
		data-widget="page-editor"
		data-entity-id={ entity.ID }
		data-campaign-id={ cc.Campaign.ID }
		data-metadata-endpoint={ pageEditorEndpoint(cc, entity, "metadata") }
		data-aliases-endpoint={ pageEditorEndpoint(cc, entity, "aliases") }
		data-search-endpoint={ fmt.Sprintf("/campaigns/%s/entities/search", cc.Campaign.ID) }
		data-name={ entity.Name }
	>
		<span class="pe-hint" data-pe-hint>
			Click a part or its pen
			<span aria-hidden="true">·</span>
			<button type="button" class="pe-key" data-pe-mark aria-pressed="false" title="Outline every part you can edit">E</button>
			outlines them all
			<span aria-hidden="true">·</span>
			<kbd class="pe-key">Esc</kbd>
			steps back
		</span>
		<span class="pe-saved" data-pe-saved role="status" aria-live="polite"></span>
		{ children... }
		<button type="button" class="btn-secondary btn-sm pe-edit" data-pe-edit aria-pressed="false">Edit page</button>
	</div>
}

// pageEditorPen opens its part and, while the part is open, is the tick that
// closes it, in the same spot.
templ pageEditorPen(part, label string) {
	<button type="button" class="pe-pen" data-pe-pen={ part } aria-expanded="false" aria-label={ label } title={ label }>
		<svg class="pe-i pe-i-pen" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
		<svg class="pe-i pe-i-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
	</button>
}

// pageHeaderDrape is the header's sheet: what the header has no room to edit
// in place, unrolled below it over the page. Scribes and up only, matching
// what the server takes from a claimed owner, who edits the name alone.
templ pageHeaderDrape(cc *campaigns.CampaignContext, entity *Entity, csrfToken string) {
	{{ parent := pageParentOf(ctx) }}
	<div class="pe-drape" data-pe-drape inert>
		<div class="pe-drape-in">
			<div class="pe-sheet">
				<label class="pe-row">
					<span>Also known as</span>
					<input type="text" class="pe-fld" data-pe-f="aka" placeholder="Other names, split with commas" autocomplete="off" disabled/>
				</label>
				<label class="pe-row">
					<span>Descriptor</span>
					<input type="text" class="pe-fld" data-pe-f="label" maxlength="100" placeholder="e.g., City, NPC, Artifact" value={ derefStr(entity.TypeLabel) } autocomplete="off"/>
				</label>
				<div class="pe-row">
					<label for="pe-parent">Parent page</label>
					<div class="pe-combo">
						<input
							id="pe-parent"
							type="text"
							class="pe-fld"
							role="combobox"
							aria-autocomplete="list"
							aria-expanded="false"
							aria-controls="pe-parent-list"
							placeholder="No parent page"
							autocomplete="off"
							data-pe-f="parent"
							data-id={ parent.ID }
							if parent.ID != "" {
								value={ parentLabel(parent) }
							}
						/>
						<ul id="pe-parent-list" class="pe-list" role="listbox" aria-label="Pages" hidden></ul>
					</div>
				</div>
				<div class="pe-qws">
					@pageCloneForm(cc, entity, csrfToken, "pe-qw")
					@entityHistoryButton(cc, entity, "pe-qw")
					@eraButton(cc, entity, "pe-qw")
					if cc.MemberRole >= campaigns.RoleOwner {
						<span class="pe-sp"></span>
						@pageDeleteForm(cc, entity, csrfToken, "pe-qw is-bad", "Delete page…")
					}
				</div>
			</div>
		</div>
	</div>
}

// pageCloneForm copies the page. The page's actions row and the header's
// sheet share it.
templ pageCloneForm(cc *campaigns.CampaignContext, entity *Entity, csrfToken, class string) {
	<form
		method="POST"
		action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s/clone", cc.Campaign.ID, entity.ID)) }
		hx-post={ fmt.Sprintf("/campaigns/%s/entities/%s/clone", cc.Campaign.ID, entity.ID) }
		class="inline"
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<button type="submit" class={ class } title="Create a copy of this page">
			<i class="fa-regular fa-clone mr-1"></i> Clone
		</button>
	</form>
}

// pageDeleteForm moves the page and its sub-pages to the Trash, after asking.
// Owners only; the route checks the same.
templ pageDeleteForm(cc *campaigns.CampaignContext, entity *Entity, csrfToken, class, label string) {
	<form
		method="POST"
		action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, entity.ID)) }
		hx-delete={ fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, entity.ID) }
		hx-confirm="Move this page and its sub-pages to the Trash? You can restore them from Manage > Trash."
		class="inline"
	>
		<input type="hidden" name="_method" value="DELETE"/>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<button type="submit" class={ class }>
			<i class="fa-solid fa-trash mr-1"></i> { label }
		</button>
	</form>
}
