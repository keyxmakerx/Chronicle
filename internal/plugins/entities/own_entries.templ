// own_entries.templ — the entry editor's page: one paper page with a tab per
// pick list, and the creator's pull-out leaf for writing an entry. For a
// Director it is "Entries and players' drafts", reached from "Before you play
// in <campaign>": every entry, the drafts players hand in, and the permission
// to make their own. A player's "Your own entries" holds only the entries a
// Director let them write. The page is a
// mount point; static/js/own_entries.js (loaded on sight, ADR-063) reads the pick lists from the creator's plan and the entries and
// permissions from the systems plugin's entry API.

package entities

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// OwnEntriesView is what the page needs beyond the campaign.
type OwnEntriesView struct {
	Director  bool
	UserID    string
	CSRFToken string
	// Field opens that pick list's tab.
	Field string
	// ForID and ForName are the player's character a new entry is for; the
	// page links back to it. BackToCreator links back to the hero creator.
	ForID, ForName string
	BackToCreator  bool
	// Entry opens the editor on that entry, New on a new one; Made says a
	// rewrite just made it. Return is the rules page to go back to after.
	Entry  string
	New    bool
	Made   bool
	Return string
}

// ownEntriesTitle is the page's honest name for who reads it.
func ownEntriesTitle(v OwnEntriesView) string {
	if v.Director {
		return "Entries and players’ drafts"
	}
	return "Your own entries"
}

// OwnEntriesPage renders the page inside the App shell.
templ OwnEntriesPage(cc *campaigns.CampaignContext, v OwnEntriesView) {
	@layouts.App(ownEntriesTitle(v) + " - " + cc.Campaign.Name) {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/entities/css/own_entries.css") }/>
		<div class="max-w-7xl mx-auto px-4 py-6">
			<nav class="mb-4 text-sm text-fg-muted" aria-label="Breadcrumb">
				if sys, ok := layouts.GetEnabledSystem(ctx); ok && v.Director {
					<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/systems/%s/before-you-play", cc.Campaign.ID, sys.Slug)) } class="hover:text-fg">{ "Before you play in " + cc.Campaign.Name }</a>
				} else if ok {
					<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/systems/%s", cc.Campaign.ID, sys.Slug)) } class="hover:text-fg">{ rulesCrumb(sys) }</a>
				} else {
					<a href={ templ.SafeURL("/campaigns/" + cc.Campaign.ID) } class="hover:text-fg">{ cc.Campaign.Name }</a>
				}
				<span aria-hidden="true">/</span>
				<span class="text-fg">{ ownEntriesTitle(v) }</span>
			</nav>
			<div
				class="hc hc--tool"
				data-widget="own-entries"
				data-own-entries="true"
				data-campaign-id={ cc.Campaign.ID }
				data-plan-url={ fmt.Sprintf("/campaigns/%s/characters/new/plan", cc.Campaign.ID) }
				data-entries-url={ fmt.Sprintf("/campaigns/%s/system-entries", cc.Campaign.ID) }
				data-members-url={ fmt.Sprintf("/campaigns/%s/members", cc.Campaign.ID) }
				data-director={ fmt.Sprint(v.Director) }
				data-user={ v.UserID }
				data-field={ v.Field }
				data-for-id={ v.ForID }
				data-for-name={ v.ForName }
				if v.ForID != "" {
					data-back-url={ fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, v.ForID) }
				} else if v.BackToCreator {
					data-back-url={ fmt.Sprintf("/campaigns/%s/characters/new", cc.Campaign.ID) }
				}
				data-csrf={ v.CSRFToken }
				data-entry={ v.Entry }
				data-new={ fmt.Sprint(v.New) }
				data-made={ fmt.Sprint(v.Made) }
				data-return-url={ v.Return }
			>
				<div class="hc-wrap paper-stack">
					<div class="hc-page paper hc-loading" role="status">
						<p class="paper-kind">{ ownEntriesTitle(v) }</p>
						<p class="hc-loading__text">Opening your entries…</p>
					</div>
				</div>
				<noscript>
					<p class="text-sm text-fg-muted">This page needs JavaScript.</p>
				</noscript>
			</div>
		</div>
	}
}

// rulesCrumb names the rulebook the way the sidebar does, by its system. The
// page is reached from the rulebook, so the crumb leads back there; when the
// sidebar has no rulebook link to copy, the crumb is the campaign.
func rulesCrumb(sys layouts.EnabledSystem) string {
	if sys.Name != "" {
		return sys.Name
	}
	return "Rulebook"
}
