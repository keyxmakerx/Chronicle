// own_entries.templ — the "Your own entries" page: one paper page with a tab
// per pick list, and the creator's pull-out leaf for writing an entry. A
// Director manages every entry there and lets players make their own; a
// player sees only the entries a Director let them write. The page is a
// mount point; static/js/own_entries.js (from the plugin body-script
// registry) reads the pick lists from the creator's plan and the entries and
// permissions from the systems plugin's entry API.

package entities

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// OwnEntriesView is what the page needs beyond the campaign.
type OwnEntriesView struct {
	Director  bool
	UserID    string
	CSRFToken string
	// Field opens that pick list's tab.
	Field string
	// ForID and ForName are the player's character a new entry is for; the
	// page links back to it. BackToCreator links back to the hero creator.
	ForID, ForName string
	BackToCreator  bool
}

// OwnEntriesPage renders the page inside the App shell.
templ OwnEntriesPage(cc *campaigns.CampaignContext, v OwnEntriesView) {
	@layouts.App("Your own entries - " + cc.Campaign.Name) {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/entities/css/hero_creator.css") }/>
		<div class="max-w-7xl mx-auto px-4 py-6">
			<nav class="mb-4 text-sm text-fg-muted" aria-label="Breadcrumb">
				if sys, ok := layouts.GetEnabledSystem(ctx); ok {
					<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/systems/%s", cc.Campaign.ID, sys.Slug)) } class="hover:text-fg">{ rulesCrumb(sys) }</a>
				} else {
					<a href={ templ.SafeURL("/campaigns/" + cc.Campaign.ID) } class="hover:text-fg">{ cc.Campaign.Name }</a>
				}
				<span aria-hidden="true">/</span>
				<span class="text-fg">Your own entries</span>
			</nav>
			<div
				class="hc hc--tool"
				data-own-entries="true"
				data-campaign-id={ cc.Campaign.ID }
				data-plan-url={ fmt.Sprintf("/campaigns/%s/characters/new/plan", cc.Campaign.ID) }
				data-entries-url={ fmt.Sprintf("/campaigns/%s/system-entries", cc.Campaign.ID) }
				data-members-url={ fmt.Sprintf("/campaigns/%s/members", cc.Campaign.ID) }
				data-director={ fmt.Sprint(v.Director) }
				data-user={ v.UserID }
				data-field={ v.Field }
				data-for-id={ v.ForID }
				data-for-name={ v.ForName }
				if v.ForID != "" {
					data-back-url={ fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, v.ForID) }
				} else if v.BackToCreator {
					data-back-url={ fmt.Sprintf("/campaigns/%s/characters/new", cc.Campaign.ID) }
				}
				data-csrf={ v.CSRFToken }
			>
				<div class="hc-page paper paper-stack hc-loading" role="status">
					<p class="paper-kind">Your own entries</p>
					<p class="hc-loading__text">Opening your entries…</p>
				</div>
				<noscript>
					<p class="text-sm text-fg-muted">This page needs JavaScript.</p>
				</noscript>
			</div>
		</div>
	}
}

// rulesCrumb names the rulebook the way the sidebar does, by its system. The
// page is reached from the rulebook, so the crumb leads back there; when the
// sidebar has no rulebook link to copy, the crumb is the campaign.
func rulesCrumb(sys layouts.EnabledSystem) string {
	if sys.Name != "" {
		return sys.Name
	}
	return "Rulebook"
}
