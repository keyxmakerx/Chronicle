package smtp

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// SMTPSettingsPage renders the full SMTP settings page (admin only).
templ SMTPSettingsPage(settings *SMTPSettings, csrfToken, errMsg string) {
	@layouts.App("Email - Admin") {
		<div class="max-w-2xl mx-auto">
			<div class="mb-6">
				<h1 class="text-2xl font-bold text-fg">Email</h1>
				<p class="text-sm text-fg-secondary mt-1">
					Configure outbound email for password resets and campaign transfer notifications.
				</p>
			</div>
			<div id="smtp-form-container">
				@SMTPFormComponent(settings, csrfToken, errMsg, "")
			</div>
		</div>
	}
}

// emailStatus summarises the saved settings in plain words. It reflects what
// is saved, not a delivery check: nothing records when mail last went out, so
// no "last sent" time is claimed.
func emailStatus(s *SMTPSettings) (text string, ok bool) {
	switch {
	case s.Enabled && s.Host != "":
		return "Email is working.", true
	case s.Host != "":
		return "Email is set up.", false
	default:
		return "Email isn't set up yet.", false
	}
}

// SMTPFormComponent renders the whole swappable region: status line, the Mail
// server form and the separate test card. The test controls sit outside the
// settings form so pressing Enter there never saves. Used for the full page
// and HTMX partial swaps.
templ SMTPFormComponent(settings *SMTPSettings, csrfToken, errMsg, successMsg string) {
	{{ statusText, statusOK := emailStatus(settings) }}
	<div class="space-y-4">
		<div class="card flex flex-wrap items-baseline gap-x-2 gap-y-1" role="status">
			<span class={ "font-semibold", templ.KV("text-emerald-700 dark:text-emerald-300", statusOK), templ.KV("text-fg", !statusOK) }>
				if statusOK {
					<i class="fa-solid fa-check mr-1"></i>
				}
				{ statusText }
			</span>
			<span class="text-xs text-fg-muted">Based on the saved settings. Use "Send a test" to check delivery.</span>
		</div>
		if errMsg != "" {
			<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md text-sm" role="alert">
				{ errMsg }
			</div>
		}
		if successMsg != "" {
			<div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-md text-sm" role="status">
				{ successMsg }
			</div>
		}
		@smtpSettingsForm(settings, csrfToken)
		@smtpTestCard(csrfToken)
	</div>
}

// smtpSettingsForm is the Mail server form; Save is its only action.
templ smtpSettingsForm(settings *SMTPSettings, csrfToken string) {
	<form
		hx-put="/admin/smtp"
		hx-target="#smtp-form-container"
		hx-swap="innerHTML"
		hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
		class="card space-y-6"
	>
		<h2 class="text-lg font-semibold text-fg">Mail server</h2>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<!-- Host -->
		<div>
			<label for="host" class="block text-sm font-medium text-fg-body mb-1">SMTP Host</label>
			<input
				type="text"
				id="host"
				name="host"
				value={ settings.Host }
				placeholder="smtp.example.com"
				class="input"
			/>
		</div>
		<!-- Port -->
		<div>
			<label for="port" class="block text-sm font-medium text-fg-body mb-1">Port</label>
			<input
				type="number"
				id="port"
				name="port"
				value={ fmt.Sprintf("%d", settings.Port) }
				class="input"
			/>
		</div>
		<!-- Encryption -->
		<div>
			<label for="encryption" class="block text-sm font-medium text-fg-body mb-1">Encryption</label>
			<select
				id="encryption"
				name="encryption"
				class="input"
			>
				<option value="starttls" selected?={ settings.Encryption == "starttls" }>STARTTLS (port 587)</option>
				<option value="ssl" selected?={ settings.Encryption == "ssl" }>SSL/TLS (port 465)</option>
				<option value="none" selected?={ settings.Encryption == "none" }>None</option>
			</select>
		</div>
		<!-- Username -->
		<div>
			<label for="username" class="block text-sm font-medium text-fg-body mb-1">Username</label>
			<input
				type="text"
				id="username"
				name="username"
				value={ settings.Username }
				placeholder="user@example.com"
				class="input"
			/>
		</div>
		<!-- Password (never shows existing value) -->
		<div>
			<label for="password" class="block text-sm font-medium text-fg-body mb-1">Password</label>
			<input
				type="password"
				id="password"
				name="password"
				if settings.HasPassword {
					placeholder="••••••••  (leave blank to keep current)"
				} else {
					placeholder="Enter SMTP password"
				}
				class="input"
			/>
			<p class="text-xs text-fg-muted mt-1">
				Password is encrypted and cannot be recovered. Leave blank to keep the current password.
			</p>
		</div>
		<!-- From Address -->
		<div>
			<label for="from_address" class="block text-sm font-medium text-fg-body mb-1">From Address</label>
			<input
				type="email"
				id="from_address"
				name="from_address"
				value={ settings.FromAddress }
				placeholder="chronicle@example.com"
				class="input"
			/>
		</div>
		<!-- From Name -->
		<div>
			<label for="from_name" class="block text-sm font-medium text-fg-body mb-1">From Name</label>
			<input
				type="text"
				id="from_name"
				name="from_name"
				value={ settings.FromName }
				placeholder="Chronicle"
				class="input"
			/>
		</div>
		<!-- Enabled -->
		<div class="flex items-center gap-3">
			<input
				type="checkbox"
				id="enabled"
				name="enabled"
				value="true"
				checked?={ settings.Enabled }
				class="rounded border-edge text-accent focus:ring-accent"
			/>
			<label for="enabled" class="text-sm font-medium text-fg-body">Enable SMTP</label>
		</div>
		<div class="flex items-center gap-3 pt-4 border-t border-edge">
			<button
				type="submit"
				class="btn-primary"
			>
				Save
			</button>
		</div>
	</form>
}

// smtpTestCard holds the checks that use the saved settings. It is its own
// form so Enter in the address box sends a test, and never saves the settings.
templ smtpTestCard(csrfToken string) {
	<form
		hx-post="/admin/smtp/send-test"
		hx-target="#smtp-form-container"
		hx-swap="innerHTML"
		hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
		class="card space-y-3"
	>
		<div>
			<h2 class="text-lg font-semibold text-fg">Send a test</h2>
			<p class="text-xs text-fg-muted mt-1">Uses the saved settings, so save any changes first.</p>
		</div>
		<div class="flex flex-wrap items-center gap-3">
			<label for="test_email" class="sr-only">Send test to</label>
			<input
				type="email"
				id="test_email"
				name="test_email"
				placeholder="you@example.com"
				class="input flex-1 min-w-0"
			/>
			<button type="submit" class="btn-secondary whitespace-nowrap">Send test email</button>
			<button
				type="button"
				hx-post="/admin/smtp/test"
				hx-target="#smtp-form-container"
				hx-swap="innerHTML"
				hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
				class="btn-secondary whitespace-nowrap"
			>
				Test connection
			</button>
		</div>
	</form>
}
