package campaigns

import (
	"encoding/json"
	"regexp"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CustomizeShell is Customize's frame: on the wall only Find and the one save
// bar; inside a part, a bar that names where you are, with the part's own tabs. The draft
// rides on data-draft; customize_shell.js keeps it, saves it as the owner
// edits, and draws the save bar.
templ CustomizeShell(d customizeShellData, body templ.Component) {
	@layouts.App(d.Title) {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/customize_shell.css") }/>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/customize_wall.css") }/>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/find_palette.css") }/>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/customize_page_editor.css") }/>
		<div
			class={ "czs", templ.KV("czs-is-wall", d.Wall), templ.KV("czs-is-workshop", !d.Wall) }
			data-widget="customize-shell"
			data-campaign-id={ d.CampaignID }
			data-csrf={ d.CSRF }
			data-area={ d.Area }
			data-version={ strconv.Itoa(d.Version) }
			data-draft={ d.Draft }
			data-find={ d.Find }
			data-areas={ customizeAreasJSON(d.Areas) }
			data-wall-key={ d.PartKey }
		>
			<div class="czs-stage">
				if !d.Wall {
					<div class="czs-top" data-czs-top>
						if d.Cat != nil {
							@customizeCatBarNav(d.Cat)
						} else if d.Bar != nil {
							@customizePartBarNav(d.Bar)
						}
						<div class="czs-bar-slot" data-czs-bar-slot></div>
						<button type="button" class="czs-find" data-czs-find aria-haspopup="dialog" aria-keyshortcuts="/">
							<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
							<span>Find a setting</span>
							<kbd>/</kbd>
						</button>
						for _, a := range d.Areas {
							if len(a.Parts) > 0 {
								@customizeDrawer(a)
							}
						}
					</div>
				}
				<div class="czs-body" data-czs-stage>
					@body
				</div>
				<div class="czs-savebar" role="region" aria-label="Unsaved changes" data-czs-savebar hidden>
					<span class="czs-sdot" aria-hidden="true"></span>
					<button type="button" class="czs-what" data-czs-what aria-haspopup="dialog"></button>
					<button type="button" class="czs-icon-btn" data-czs-undo aria-label="Undo" title="Undo (Ctrl+Z)">
						<i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
					</button>
					<button type="button" class="czs-icon-btn" data-czs-redo aria-label="Redo" title="Redo (Ctrl+Shift+Z)">
						<i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
					</button>
					<button type="button" class="czs-ghost" data-czs-discard>Discard</button>
					<button type="button" class="btn-primary btn-sm" data-czs-save>Save changes</button>
				</div>
			</div>
			<div class="czs-toasts" data-czs-toasts role="status" aria-live="polite"></div>
		</div>
	}
}

// customizePartBarNav is the bar inside any other part: back to the wall,
// the part's name, and the part's own tabs (Look's rooms, the homes). The open
// tab wears the index mark. Look's rooms are the address's # on the same page,
// which customize_shell.js follows.
templ customizePartBarNav(b *customizeBar) {
	<nav class="czs-tabs-top czs-catbar" aria-label={ b.Name } data-czs-catbar hx-boost="true" hx-target="#main-content" hx-select="#main-content > *" hx-swap="innerHTML show:window:top">
		<a class="czs-back czs-back-all" href={ templ.SafeURL(b.Base) } data-czs-back hx-swap="innerHTML transition:true show:window:top">
			<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
			<span>Everything</span>
			<span class="czs-dot" title="Unsaved changes" data-czs-area-dot={ b.Dot } hidden></span>
		</a>
		<span class="czs-tabw czs-catname-w" style={ templ.SafeCSS("--czs-i:1") }><span class="czs-catname is-static">{ b.Name }</span></span>
		for i, t := range b.Tabs {
			<span class="czs-tabw" style={ templ.SafeCSS("--czs-i:" + strconv.Itoa(i+2)) }>
				<a
					class="czs-tab"
					href={ templ.SafeURL(t.Href) }
					if t.Key != "" {
						data-czs-room={ t.Key }
					}
					if t.Current {
						aria-current="page"
					}
				>
					<span class="czs-lbl">{ t.Label }</span>
					if t.Key != "" {
						<span class="czs-dot" title="Unsaved changes" hidden></span>
					}
				</a>
			</span>
		}
	</nav>
}

// customizeCatBarNav is the one bar inside a category: back to the wall
// ("Everything"), the category's name (it opens the Categories drawer, to
// switch to another or reach All categories), and the category's tabs. The open tab wears
// the index mark the area tabs wear. The page layout puts its layout picker in
// the slot after it (data-czs-bar-slot).
templ customizeCatBarNav(c *customizeCatBar) {
	<nav class="czs-tabs-top czs-catbar" aria-label={ c.Name } data-czs-catbar hx-boost="true" hx-target="#main-content" hx-select="#main-content > *" hx-swap="innerHTML show:window:top">
		<a class="czs-back czs-back-all" href={ templ.SafeURL(c.Base) } data-czs-back hx-swap="innerHTML transition:true show:window:top">
			<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
			<span>Everything</span>
			<span class="czs-dot" title="Unsaved changes" data-czs-area-dot="categories" hidden></span>
		</a>
		<span class="czs-tabw czs-catname-w" style={ templ.SafeCSS("--czs-i:1") }>
			<button
				type="button"
				class="czs-catname"
				data-czs-drawer="categories"
				aria-expanded="false"
				aria-controls="czs-dr-categories"
				title="Switch to another category"
			>
				<span data-czs-catname>{ c.Name }</span>
				<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
			</button>
		</span>
		for i, t := range catBarTabs() {
			<span class="czs-tabw" style={ templ.SafeCSS("--czs-i:" + strconv.Itoa(i+2)) }>
				if c.New && t.ID != "settings" {
					<span class="czs-tab is-off" data-czs-cattab={ t.ID } title="Available once you save this category">{ t.Label }</span>
				} else {
					<a
						class="czs-tab"
						href={ templ.SafeURL(c.Base + "/categories/" + c.Key + "/" + t.ID) }
						data-czs-cattab={ t.ID }
						if t.ID == c.Tab {
							aria-current="page"
						}
					>
						<span class="czs-lbl">{ t.Label }</span>
						<span class="czs-dot" title="Unsaved changes" hidden></span>
					</a>
				}
			</span>
		}
	</nav>
}

// customizeDrawer lists an area's parts. It hangs from its tab's side line;
// customize_shell.js opens it under the tab and closes it.
templ customizeDrawer(a CustomizeArea) {
	<div class="czs-drawer" id={ "czs-dr-" + a.ID } data-czs-drawer-for={ a.ID } role="dialog" aria-label={ a.Label + " parts" } hidden>
		<div class="czs-drawer-h">
			<span>{ a.Label }</span>
			<button type="button" class="czs-drawer-x" data-czs-drawer-close aria-label="Close">
				<i class="fa-solid fa-xmark" aria-hidden="true"></i>
			</button>
		</div>
		<ul hx-boost="true" hx-target="#main-content" hx-select="#main-content > *" hx-swap="innerHTML show:window:top">
			for _, p := range a.Parts {
				<li>
					<a
						href={ templ.SafeURL(p.Href) }
						class={ "czs-pt", templ.KV("is-kind", p.Kind), templ.KV("is-quiet", p.Quiet) }
						if p.Key != "" {
							data-czs-room={ p.Key }
						}
						if p.Current {
							aria-current="page"
						}
					>
						if sw := partSwatch(p.Color); sw != "" {
							<span class="czs-sw" style={ "background:" + sw } aria-hidden="true"></span>
						}
						<span class="czs-pl">{ p.Label }</span>
						if p.Key != "" {
							<span class="czs-dot" title="Unsaved changes" hidden></span>
						}
						if p.Color != "" {
							<span class="czs-cnt">{ strconv.Itoa(p.Pages) }</span>
						}
					</a>
				</li>
			}
		</ul>
	</div>
}

// partSwatch is a category's colour when it is a plain hex colour, the only
// kind a category stores; anything else draws no swatch.
func partSwatch(c string) string {
	if !hexColour.MatchString(c) {
		return ""
	}
	return c
}

var hexColour = regexp.MustCompile(`^#[0-9a-fA-F]{3,8}$`)

func customizeAreasJSON(areas []CustomizeArea) string {
	b, err := json.Marshal(areas)
	if err != nil {
		return "[]"
	}
	return string(b)
}
