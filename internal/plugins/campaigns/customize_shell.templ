package campaigns

import (
	"encoding/json"
	"regexp"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CustomizeShell is Customize's frame: the index tabs of areas, each with
// a drawer of its parts, Find, the area itself, and the one save bar. The draft
// rides on data-draft; customize_shell.js keeps it, saves it as the owner
// edits, and draws the save bar.
templ CustomizeShell(d customizeShellData, body templ.Component) {
	@layouts.App(d.Title) {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/customize_shell.css") }/>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/customize_page_editor.css") }/>
		<div
			class="czs"
			data-widget="customize-shell"
			data-campaign-id={ d.CampaignID }
			data-csrf={ d.CSRF }
			data-area={ d.Area }
			data-version={ strconv.Itoa(d.Version) }
			data-draft={ d.Draft }
			data-find={ d.Find }
			data-areas={ customizeAreasJSON(d.Areas) }
		>
			<div class="czs-stage">
				<div class="czs-top" data-czs-top>
					<nav class="czs-tabs-top" aria-label="Customize" hx-boost="true" hx-target="#main-content" hx-select="#main-content > *" hx-swap="innerHTML show:window:top">
						for i, a := range d.Areas {
							if i == 4 {
								<span class="czs-tsep" role="presentation"></span>
							}
							<span class={ "czs-tabw", templ.KV("has-parts", len(a.Parts) > 0) }>
								<a
									class="czs-tab"
									href={ templ.SafeURL(a.Href) }
									data-czs-area={ a.ID }
									if a.ID == d.Area {
										aria-current="page"
									}
								>
									<span class="czs-lbl">{ a.Label }</span>
									if a.ID == d.Area && len(a.Parts) > 0 {
										<span class="czs-part" data-czs-part>{ a.Part }</span>
									}
									<span class="czs-dot" title="Unsaved changes" hidden></span>
								</a>
								if len(a.Parts) > 0 {
									<button
										type="button"
										class="czs-chev"
										data-czs-drawer={ a.ID }
										aria-expanded="false"
										aria-controls={ "czs-dr-" + a.ID }
										aria-label={ "Parts of " + a.Label }
									>
										<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
									</button>
								}
							</span>
						}
					</nav>
					<button type="button" class="czs-find" data-czs-find aria-haspopup="dialog" aria-keyshortcuts="/">
						<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
						<span>Find a setting</span>
						<kbd>/</kbd>
					</button>
					for _, a := range d.Areas {
						if len(a.Parts) > 0 {
							@customizeDrawer(a)
						}
					}
				</div>
				<div class="czs-body">
					@body
				</div>
				<div class="czs-savebar" role="region" aria-label="Unsaved changes" data-czs-savebar hidden>
					<span class="czs-sdot" aria-hidden="true"></span>
					<button type="button" class="czs-what" data-czs-what aria-haspopup="dialog"></button>
					<button type="button" class="czs-icon-btn" data-czs-undo aria-label="Undo" title="Undo (Ctrl+Z)">
						<i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
					</button>
					<button type="button" class="czs-icon-btn" data-czs-redo aria-label="Redo" title="Redo (Ctrl+Shift+Z)">
						<i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
					</button>
					<button type="button" class="czs-ghost" data-czs-discard>Discard</button>
					<button type="button" class="btn-primary btn-sm" data-czs-save>Save changes</button>
				</div>
			</div>
			<div class="czs-toasts" data-czs-toasts role="status" aria-live="polite"></div>
		</div>
	}
}

// customizeDrawer lists an area's parts. It hangs from its tab's side line;
// customize_shell.js opens it under the tab and closes it.
templ customizeDrawer(a CustomizeArea) {
	<div class="czs-drawer" id={ "czs-dr-" + a.ID } data-czs-drawer-for={ a.ID } role="dialog" aria-label={ a.Label + " parts" } hidden>
		<div class="czs-drawer-h">
			<span>{ a.Label }</span>
			<button type="button" class="czs-drawer-x" data-czs-drawer-close aria-label="Close">
				<i class="fa-solid fa-xmark" aria-hidden="true"></i>
			</button>
		</div>
		<ul hx-boost="true" hx-target="#main-content" hx-select="#main-content > *" hx-swap="innerHTML show:window:top">
			for _, p := range a.Parts {
				<li>
					<a
						href={ templ.SafeURL(p.Href) }
						class={ "czs-pt", templ.KV("is-kind", p.Kind), templ.KV("is-quiet", p.Quiet) }
						if p.Key != "" {
							data-czs-room={ p.Key }
						}
						if p.Current {
							aria-current="page"
						}
					>
						if sw := partSwatch(p.Color); sw != "" {
							<span class="czs-sw" style={ "background:" + sw } aria-hidden="true"></span>
						}
						<span class="czs-pl">{ p.Label }</span>
						if p.Key != "" {
							<span class="czs-dot" title="Unsaved changes" hidden></span>
						}
						if p.Color != "" {
							<span class="czs-cnt">{ strconv.Itoa(p.Pages) }</span>
						}
					</a>
				</li>
			}
		</ul>
	</div>
}

// partSwatch is a category's colour when it is a plain hex colour, the only
// kind a category stores; anything else draws no swatch.
func partSwatch(c string) string {
	if !hexColour.MatchString(c) {
		return ""
	}
	return c
}

var hexColour = regexp.MustCompile(`^#[0-9a-fA-F]{3,8}$`)

func customizeAreasJSON(areas []CustomizeArea) string {
	b, err := json.Marshal(areas)
	if err != nil {
		return "[]"
	}
	return string(b)
}
