// desk_board.templ draws the Overview board: a grid of tiles, each saying
// where one setting stands. The two flips and the feature chips change their
// setting where they stand and save at once; every other tile, or its arrow,
// leads to the tab or page that holds the rest.

package campaigns

import "github.com/keyxmakerx/chronicle/internal/templates/layouts"

// deskBoard lays the tiles out in reading order; the grid packs them densely,
// so a narrow page folds them into two columns, then one, without gaps.
templ deskBoard(cc *CampaignContext, b DeskBoard) {
	<div class="sb-board">
		if len(b.Needs) > 0 {
			@boardNeeds(b.Needs)
		}
		@boardFlip(b.Access, "access")
		@boardFlip(b.Pages, "pages")
		@boardPeople(b.People)
		@boardGo(b.System, "system", false)
		@boardGo(b.Edits, "edits", false)
		@boardFeatures(cc, b.Features)
		@boardLook(b.Look)
		if b.Foundry != nil {
			@boardGo(*b.Foundry, "foundry", true)
		}
		@boardGo(b.AI, "ai", false)
		@boardGo(b.Storage, "storage", true)
		@boardGo(b.Trash, "trash", true)
	</div>
}

// boardNeeds is what waits on the owner, most urgent first, each line leading
// to where it is answered.
templ boardNeeds(items []NeedsYouItem) {
	<section class="sb-t sb-w2 sb-needs" aria-labelledby="sb-needs-l" data-desk-needs>
		<h2 class="sb-tl" id="sb-needs-l">Needs you <span class="sb-cnt">{ itoa(len(items)) }</span></h2>
		<ul class="sb-needs-list">
			for _, n := range items {
				<li>
					<i class={ "desk-dot", templ.KV("warn", n.State == "warn") } aria-hidden="true"></i>
					<span class="sb-grow"><b>{ n.Lead }</b> { n.Rest }</span>
					<a class="sb-word" href={ templ.SafeURL(n.URL) } aria-label={ "Open " + n.Lead }>Open</a>
				</li>
			}
		</ul>
	</section>
}

// boardFlip is a two-way setting as a tile: press it to flip, and it saves at
// once through the blank's route. The knob and the words change inside a
// tenth of a second; a failed save puts them back. Off on an archived
// campaign, with the reason on hover and for the screen reader.
templ boardFlip(f DeskFlip, id string) {
	{{ now := f.Now() }}
	<button
		type="button"
		class={ "sb-t", "sb-flip", "sb-flip-" + id }
		id={ "line-" + id }
		data-line={ id }
		data-sb-flip={ f.Blank.ID }
		data-url={ f.Blank.URL }
		data-method={ f.Blank.Method }
		data-field={ f.Blank.Field }
		data-bool?={ f.Blank.Bool }
		data-options={ deskOptionsJSON(f.Blank.Options) }
		data-value={ f.Blank.Value }
		aria-pressed={ boolStr(f.On()) }
		aria-label={ f.Label + ": " + now.Label }
		aria-disabled={ deskDisabled(f.Blank) }
		title={ f.Blank.Off }
		onclick={ boardCall("boardFlip", "flip") }
	>
		<span class="sb-tl">{ f.Label }</span>
		<span class="sb-tv">
			@boardFlipGlyph(id)
			<span data-sb-word>{ now.Label }</span>
		</span>
		<span class="sb-th" data-sb-hint>
			if f.Blank.Off != "" {
				{ f.Blank.Off }
			} else {
				{ now.Hint }
			}
		</span>
		<span class="sb-knob" aria-hidden="true"></span>
	</button>
}

// boardFlipGlyph is the state's picture beside its word: a lock or a globe for
// who can see the campaign, a closed or an open eye for new pages. Both are
// drawn; the pressed state shows the second.
templ boardFlipGlyph(id string) {
	if id == "access" {
		<svg class="sb-g sb-g-a" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 015 0v2"></path></svg>
		<svg class="sb-g sb-g-b" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.5"></circle><path d="M2.5 8h11M8 2.5c2 2 2 9 0 11M8 2.5c-2 2-2 9 0 11"></path></svg>
	} else {
		<svg class="sb-g sb-g-a" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 2.5l11 11M6.3 4.3C6.9 4.1 7.4 4 8 4c2.3 0 4.5 1.3 6.5 4-.6.9-1.3 1.7-2 2.3M10 11.5c-.6.3-1.3.5-2 .5-2.3 0-4.5-1.3-6.5-4 .7-1 1.4-1.8 2.2-2.5"></path></svg>
		<svg class="sb-g sb-g-b" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 8c2-3.3 4.2-5 6.5-5s4.5 1.7 6.5 5c-2 3.3-4.2 5-6.5 5S3.5 11.3 1.5 8z"></path><circle cx="8" cy="8" r="2"></circle></svg>
	}
}

// boardPeople is the campaign's people as faces, the owner first, with a face
// that invites someone at the end and an arrow to People.
templ boardPeople(p DeskPeopleTile) {
	<section class="sb-t sb-w2 sb-people" id="line-people" data-line="people" aria-labelledby="sb-people-l">
		<h2 class="sb-tl" id="sb-people-l">
			People
			if p.Count != "" {
				<span class="sb-cnt">{ p.Count }</span>
			}
		</h2>
		<ul class="sb-faces">
			for _, f := range p.Faces {
				<li class="sb-face" title={ f.Name }>
					if f.Avatar != "" {
						<img class="sb-av" src={ layouts.MediaThumbURL(ctx, f.Avatar, "300") } alt="" loading="lazy"/>
					} else {
						<span class={ "sb-av", "sb-h" + itoa(f.Hue) } aria-hidden="true">{ f.Initial() }</span>
					}
					<b aria-hidden="true">{ f.Short() }</b>
					<span class="sr-only">{ f.Name }</span>
					<small>{ f.Role }</small>
				</li>
			}
			if p.More > 0 {
				<li class="sb-face">
					<span class="sb-av sb-more" aria-hidden="true">{ "+" + itoa(p.More) }</span>
					<b>{ itoa(p.More) } more</b>
				</li>
			}
			<li class="sb-face sb-add">
				<a class="sb-av sb-plus" href={ templ.SafeURL(p.InviteHref) } aria-label="Invite someone">
					<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.5v9M3.5 8h9"></path></svg>
				</a>
				<b aria-hidden="true">Invite</b>
			</li>
		</ul>
		@boardOpen(p.Href, "Open People")
	</section>
}

// boardGo is a tile that shows a figure and leads on: the whole tile is the
// link, with a chevron in its corner.
templ boardGo(t DeskGoTile, id string, wide bool) {
	<a class={ "sb-t", "sb-go", templ.KV("sb-w2", wide) } id={ "line-" + id } data-line={ id } href={ templ.SafeURL(t.Href) } aria-label={ boardGoLabel(t) }>
		<span class="sb-tl">{ t.Label }</span>
		<span class="sb-tv">
			if t.Mono != "" {
				<span class="sb-mono" aria-hidden="true">{ t.Mono }</span>
			}
			if t.Value.State != "" {
				<i class={ "desk-dot", templ.KV("ok", t.Value.State == "ok"), templ.KV("warn", t.Value.State == "warn") } aria-hidden="true"></i>
			}
			<span class="sb-tvt">{ t.Value.Text }</span>
		</span>
		if t.Hint != "" {
			<span class="sb-th">{ t.Hint }</span>
		}
		@boardChevron()
	</a>
}

// boardFeatures is every installed feature as a chip that switches it where it
// stands, with the count of how many are on and an arrow to Game.
templ boardFeatures(cc *CampaignContext, f DeskFeaturesTile) {
	<section class="sb-t sb-w4 sb-feat" id="line-features" data-line="features" aria-labelledby="sb-feat-l" data-sb-features data-campaign={ cc.Campaign.ID }>
		<h2 class="sb-tl" id="sb-feat-l">
			Features
			if f.Count != "" {
				<span class="sb-cnt" data-sb-count>{ f.Count }</span>
			}
		</h2>
		if len(f.Chips) == 0 {
			<p class="sb-th">The list of features could not be read. Game has every feature.</p>
		} else {
			<div class="sb-chips">
				for _, ch := range f.Chips {
					<button
						type="button"
						class="sb-chip"
						data-sb-chip={ itoa(ch.AddonID) }
						aria-pressed={ boolStr(ch.On) }
						aria-disabled={ boolStr(f.Off != "") }
						title={ boardChipTitle(ch, f.Off) }
						onclick={ boardCall("boardChip", "chip") }
					>{ ch.Name }</button>
				}
			</div>
		}
		if f.Off != "" {
			<p class="sb-th">{ f.Off }</p>
		}
		@boardOpen(f.Href, "Open Game")
	</section>
}

// boardLook is the saved look as a small picture of itself, drawn in the
// campaign's own colour and heading face, opening the Customizer.
templ boardLook(l DeskLookTile) {
	<a class="sb-t sb-go sb-look" id="line-look" data-line="look" href={ templ.SafeURL(l.Href) } aria-label={ "Look: " + l.Look.Look + ". Open the Customizer" }>
		<span class="sb-tl">Look</span>
		<span class="sb-lookprev" aria-hidden="true"><b class="stg-face">Aa</b><span><i></i><i></i><i></i></span><em></em><em></em></span>
		<span class="sb-th"><b>{ l.Look.Look }</b>
			if s := joinParts(l.Look.Colour, l.Look.Pages); s != "" {
				{ " · " + s }
			}
		</span>
		@boardChevron()
	</a>
}

// boardOpen is the arrow in a tile's corner that leads to its tab, for a tile
// whose body holds controls of its own.
templ boardOpen(href, label string) {
	<a class="sb-open" href={ templ.SafeURL(href) } aria-label={ label }>
		<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3 8h9.5M8.5 4l4 4-4 4"></path></svg>
	</a>
}

templ boardChevron() {
	<svg class="sb-chev" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5"></path></svg>
}
