// customize.templ: the bodies of Customize's areas. The frame around them
// (bar, save bar) is customize_shell.templ; the pages that pick an
// area are customize_pages.go.

package campaigns

import (
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	"fmt"
	"strconv"
)

// customizeSavesAlone marks a part that saves each change as it is made,
// outside the one draft and its save bar.
templ customizeSavesAlone() {
	<p class="czs-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>This part saves each change as you make it, not with the Save bar.</span></p>
}

// customizePluginArea draws a plugin's area. A tab that keeps its changes in
// the draft (it names a Section) is a workshop: its body fills the page and
// the save bar says what is waiting, so there is no heading and no note that
// it saves by itself.
templ customizePluginArea(t CustomizeTab) {
	if t.Section != "" {
		@t.Content
	} else {
		<div class="czs-pad">
			<h1 class="czs-h1">{ t.Label }</h1>
			<div class="mt-6">
				@customizeSavesAlone()
				@t.Content
			</div>
		</div>
	}
}

// customizeCategoriesArea is the grid of categories; customize_categories.js
// draws it from data-state with the draft laid over it.
templ customizeCategoriesArea(cc *CampaignContext, state, key, tab string) {
	<div class="czs-pad">
		<div data-widget="customize-categories" data-state={ state } data-campaign-id={ cc.Campaign.ID }>
			<div class="czs-head-row">
				<div>
					<h1 class="czs-h1">Categories</h1>
					<p class="czs-lede">Each category is a kind of page. Open one to set up its page, its home, its fields and the text new pages start with.</p>
				</div>
			</div>
		</div>
	</div>
}

// customizeCategoryWorkspace is one category's open tab. Its name and tabs
// are the frame's one bar (customizeCatBarNav), kept in step with the draft by
// customize_categories.js; the head here only says when the category is gone
// from the draft. Settings is drawn by the same script; the other tabs are
// editors that write into the same draft.
templ customizeCategoryWorkspace(cc *CampaignContext, state, key, tab string, etID int) {
	<div data-widget="customize-categories" data-state={ state } data-campaign-id={ cc.Campaign.ID }>
		<div class="czs-ws-head" data-czs-ws-head hidden></div>
		if tab == "settings" {
			<div class="czs-pad" data-czs-ws-settings></div>
		}
	</div>
	if tab == "text" {
		<div class="czs-legacy">
			<div
				class="max-w-3xl"
				data-widget="customize-templates"
				data-campaign-id={ cc.Campaign.ID }
				data-href={ fmt.Sprintf("/campaigns/%s/customize/categories/%s/text", cc.Campaign.ID, key) }
			></div>
		</div>
	} else if (tab == "layout" || tab == "home" || tab == "fields") && etID > 0 {
		// The page layout, the category home and the fields save through the draft like the rest of Customize.
		<div
			class="czs-ped-host"
			hx-get={ fmt.Sprintf("/campaigns/%s/entity-types/%s/customize-tab/%s", cc.Campaign.ID, strconv.Itoa(etID), tab) }
			hx-trigger="load"
			hx-swap="innerHTML"
		>
			<div class="czs-legacy space-y-3" aria-busy="true">
				<div class="skeleton h-4 w-1/3"></div>
				<div class="skeleton h-40"></div>
			</div>
		</div>
	}
}

// customizeHomePages is the Home pages area: one tab per home, each drawn
// on the real home in the Customizer's page editor and saved with the rest
// of the draft.
templ customizeHomePages(cc *CampaignContext, key, hint, state string) {
	<div class="czs-ws-head">
		<div>
			<h1 class="czs-h1">Home pages</h1>
			<p class="czs-lede">The campaign home everyone lands on, a version of it for each kind of member and for guests, and the one you and your co-{ layouts.GMTerm(ctx) }s land on.</p>
		</div>
	</div>
	<p class="czs-home-hint">{ hint }</p>
	<div class="czs-ped-host">
		<div data-widget="customize-page-editor" data-state={ state }></div>
	</div>
}
