// members.templ renders the People page and the member list it is built
// around: add member form, role change and remove controls.

package campaigns

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CampaignMembersPage renders the People page: the one place the owner
// manages members, invites and ownership.
templ CampaignMembersPage(cc *CampaignContext, members []CampaignMember, transfer *OwnershipTransfer, csrfToken, errMsg string, smtpConfigured bool) {
	@layouts.App(cc.Campaign.Name + " - People") {
		<div class="max-w-4xl mx-auto">
			@layouts.ManageHeader("People")
			@peopleSections(cc, members, transfer, csrfToken, errMsg, smtpConfigured)
		</div>
	}
}

// MemberListComponent renders the member list and add form (HTMX partial swap target).
templ MemberListComponent(cc *CampaignContext, members []CampaignMember, csrfToken, errMsg string) {
	<div id="member-list">
		if errMsg != "" {
			<div class="alert-error mb-4" role="alert">
				{ errMsg }
			</div>
		}

		// Add member form (owner only).
		if cc.MemberRole >= RoleOwner {
			<div class="card p-6 mb-6">
				<h2 class="text-sm font-semibold text-fg mb-3">Add Member</h2>
				<form
					method="POST"
					action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/members", cc.Campaign.ID)) }
					hx-post={ fmt.Sprintf("/campaigns/%s/members", cc.Campaign.ID) }
					hx-target="#member-list"
					hx-swap="outerHTML"
					class="flex items-end space-x-4"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="flex-1">
						<label for="member-email" class="block text-xs font-medium text-fg-body mb-1">Email</label>
						<input type="email" id="member-email" name="email" required class="input w-full" placeholder="player@example.com"/>
					</div>
					<div>
						<label for="member-role" class="block text-xs font-medium text-fg-body mb-1">Role</label>
						<select id="member-role" name="role" class="input">
							<option value="player">Player</option>
							<option value="scribe">Scribe</option>
						</select>
					</div>
					<button type="submit" class="btn-primary text-sm">Add</button>
				</form>
			</div>
		}

		// Member table.
		<div class="card overflow-x-auto">
			<table class="w-full">
				<thead>
					<tr class="bg-surface-alt border-b border-edge">
						<th class="px-6 py-3 text-left text-xs font-medium text-fg-secondary uppercase">Name</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-fg-secondary uppercase">Character</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-fg-secondary uppercase">Role</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-fg-secondary uppercase">Joined</th>
						if showFoundryColumn(ctx, cc) {
							<th class="px-6 py-3 text-left text-xs font-medium text-fg-secondary uppercase">In Foundry</th>
						}
						if cc.MemberRole >= RoleOwner {
							<th class="px-6 py-3 text-right text-xs font-medium text-fg-secondary uppercase">Actions</th>
						}
					</tr>
				</thead>
				<tbody class="divide-y divide-edge">
					if len(members) > 0 {
						for _, member := range members {
							@MemberRow(cc, &member, csrfToken)
						}
					} else {
						<tr>
							<td colspan="6" class="px-6 py-12 text-center">
								<div class="text-fg-muted text-sm">No members yet. Add someone above to get started.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if showFoundryColumn(ctx, cc) {
			// One request fills every "In Foundry" cell (out-of-band swaps by
			// cell id); the sync plugin owns what Foundry reported.
			<div hx-get={ fmt.Sprintf("/campaigns/%s/foundry/member-status", cc.Campaign.ID) } hx-trigger="load" hx-swap="none"></div>
			<p class="text-xs text-fg-muted mt-2">
				"In Foundry" shows whether each person is linked to a Foundry user. The
				<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/foundry#foundry-players", cc.Campaign.ID)) } class="text-accent hover:underline">Foundry page</a>
				says why and what to do.
			</p>
		}
		if cc.MemberRole >= RoleOwner {
			@roleGuide()
		}
	</div>
}

// roleGuide is "What each role can do", under the member table.
templ roleGuide() {
	<section class="card mt-6" aria-labelledby="role-guide-heading">
		<h2 id="role-guide-heading" class="px-4 py-3 border-b border-edge text-sm font-semibold text-fg">What each role can do</h2>
		<div class="grid gap-3 p-4 sm:grid-cols-3">
			<div class="rounded-md border border-edge bg-surface-alt/50 p-3">
				<p class="text-sm font-semibold text-fg">Player</p>
				<p class="text-xs text-fg-secondary mt-0.5">Reads what they are shown and plays their own characters.</p>
			</div>
			<div class="rounded-md border border-edge bg-surface-alt/50 p-3">
				<p class="text-sm font-semibold text-fg">Scribe</p>
				<p class="text-xs text-fg-secondary mt-0.5">Also writes and edits pages.</p>
			</div>
			<div class="rounded-md border border-edge bg-surface-alt/50 p-3">
				<p class="text-sm font-semibold text-fg">Co-DM</p>
				<p class="text-xs text-fg-secondary mt-0.5">A Scribe who also sees and writes DM-only content. Cannot delete the campaign, remove people or take it over.</p>
			</div>
		</div>
	</section>
}

// memberAvatar shows a member's picture, or their initials when they have
// none. Only the signed-in person's own avatar carries data-pk-av, so a new
// upload repaints it here without touching anyone else's.
templ memberAvatar(member *CampaignMember) {
	<span
		class="ag-av s32"
		if layouts.GetUserID(ctx) == member.UserID {
			data-pk-av
			data-initials={ layouts.Initials(member.DisplayName) }
		}
	>
		if member.AvatarPath != nil && *member.AvatarPath != "" {
			<img src={ layouts.MediaThumbURL(ctx, *member.AvatarPath, "300") } alt="" loading="lazy"/>
		} else {
			{ layouts.Initials(member.DisplayName) }
		}
	</span>
}

// removeMemberConfirm is the question before Remove. A guest has nowhere
// else to go, so removing one ends their account.
func removeMemberConfirm(member *CampaignMember) string {
	if member.IsGuest {
		return "Remove this guest? Their guest account ends; anything they shared stays, signed Former member."
	}
	return "Remove this member from the campaign?"
}

// MemberRow renders a single member row in the table.
templ MemberRow(cc *CampaignContext, member *CampaignMember, csrfToken string) {
	<tr>
		<td class="px-6 py-4">
			<div class="flex items-center gap-3">
				@memberAvatar(member)
				<div class="min-w-0">
					<div class="text-sm font-medium text-fg">
						{ member.DisplayName }
						if member.IsGuest {
							<span class="ml-1 inline-block px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide rounded bg-surface-alt text-fg-secondary align-middle">Guest</span>
						}
					</div>
					// Email addresses are private: only the owner, who manages people, and
					// the member themselves see one. Fellow players see the name alone.
					if member.IsGuest {
						if cc.MemberRole >= RoleOwner {
							<div class="text-xs text-fg-muted">Joined with a guest code, no email yet</div>
						}
					} else if cc.MemberRole >= RoleOwner || layouts.GetUserID(ctx) == member.UserID {
						<div class="text-xs text-fg-secondary">{ member.Email }</div>
					}
					if layouts.GetUserID(ctx) == member.UserID {
						// A signed-in person finds the picture control on their own row.
						<button
							type="button"
							class="ag-link mt-0.5"
							onclick="if(window.Chronicle&&Chronicle.PictureBox)Chronicle.PictureBox.open()"
						>Change picture</button>
					}
				</div>
			</div>
		</td>
		<td class="px-6 py-4 text-sm text-fg-body">
			if member.CharacterName != nil && *member.CharacterName != "" {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, *member.CharacterEntityID)) }
					class="text-accent hover:underline"
				>
					<i class="fa-solid fa-user-shield text-xs mr-0.5"></i>{ *member.CharacterName }
				</a>
			} else {
				<span class="text-fg-muted text-xs italic">None</span>
			}
		</td>
		<td class="px-6 py-4">
			<span class={
				"inline-block px-2 py-1 text-xs font-medium rounded-full",
				templ.KV("bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-300", member.Role == RoleOwner),
				templ.KV("bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300", member.Role == RoleScribe),
				templ.KV("bg-surface-alt text-fg-body", member.Role == RolePlayer),
			}>
				{ MemberAccessLabel(cc.Campaign, *member) }
			</span>
			if cc.MemberRole >= RoleOwner {
				if note := MemberAccessNote(cc.Campaign, *member); note != "" {
					<p class="text-[11px] text-fg-muted mt-1 max-w-[16rem]">{ note }</p>
				}
			}
		</td>
		<td class="px-6 py-4 text-sm text-fg-secondary">
			{ member.JoinedAt.Format("Jan 2, 2006") }
		</td>
		if showFoundryColumn(ctx, cc) {
			<td class="px-6 py-4 text-sm">
				<span id={ "foundry-status-" + member.UserID } class="text-xs text-fg-muted">&hellip;</span>
			</td>
		}
		if cc.MemberRole >= RoleOwner {
			<td class="px-6 py-4 text-right">
				if member.Role != RoleOwner {
					<div class="flex items-center justify-end space-x-2">
						// Role change dropdown.
						<form
							method="POST"
							action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/members/%s/role", cc.Campaign.ID, member.UserID)) }
							hx-put={ fmt.Sprintf("/campaigns/%s/members/%s/role", cc.Campaign.ID, member.UserID) }
							hx-target="#member-list"
							hx-swap="outerHTML"
							class="inline-flex items-center space-x-1"
						>
							<input type="hidden" name="_method" value="PUT"/>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<select name="role" class="input text-xs py-1" aria-label={ "Role for " + member.DisplayName }>
								<option value={ AccessPlayer } selected?={ MemberAccess(cc.Campaign, *member) == AccessPlayer }>Player</option>
								<option value={ AccessScribe } selected?={ MemberAccess(cc.Campaign, *member) == AccessScribe }>Scribe</option>
								<option value={ AccessCoDM } selected?={ MemberAccess(cc.Campaign, *member) == AccessCoDM }>Co-DM</option>
							</select>
							<button type="submit" class="text-xs text-accent hover:text-accent-hover">Save</button>
						</form>

						// Remove button.
						<form
							method="POST"
							action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/members/%s", cc.Campaign.ID, member.UserID)) }
							hx-delete={ fmt.Sprintf("/campaigns/%s/members/%s", cc.Campaign.ID, member.UserID) }
							hx-target="#member-list"
							hx-swap="outerHTML"
							hx-confirm={ removeMemberConfirm(member) }
						>
							<input type="hidden" name="_method" value="DELETE"/>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button type="submit" class="text-xs text-red-600 hover:text-red-500 dark:text-red-400 dark:hover:text-red-300">Remove</button>
						</form>
					</div>
				}
			</td>
		}
	</tr>
}
