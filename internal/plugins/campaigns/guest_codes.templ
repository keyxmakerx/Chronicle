// guest_codes.templ renders the owner's Guest codes card on the People page.

package campaigns

import (
	"fmt"
	"math"
	"net/url"
	"time"
)

// GuestCodesCard lists the campaign's recent guest codes and makes new
// ones. fresh is a code just made: the only time it is ever shown.
templ GuestCodesCard(campaignID string, codes []GuestCode, fresh *NewGuestCode, now time.Time, joinURL, csrfToken, errMsg string) {
	<section id="guest-codes" class="card p-6" aria-labelledby="guest-codes-heading">
		<h2 id="guest-codes-heading" class="text-lg font-semibold text-fg mb-1">Guest codes</h2>
		<p class="text-sm text-fg-secondary mb-4">
			For someone with no account. They type the code at
			<span class="font-mono text-fg-body">{ joinURL }</span>
			with just a name. A code either makes them a player, or lets them look around for a few days
			first: they read what a visitor to a public campaign would, and can't write or roll. Each code works once, for 7 days.
		</p>
		if errMsg != "" {
			<div class="alert-error mb-4" role="alert">{ errMsg }</div>
		}
		if fresh != nil {
			<div
				class="step-settle rounded-lg border border-accent/40 bg-accent/5 p-4 mb-4"
				x-data={ guestCodeCopyData(fresh.Code, guestInviteLink(joinURL, fresh.Code)) }
			>
				<div class="flex flex-wrap items-center gap-3">
					<span class="font-mono text-2xl font-semibold tracking-widest text-fg" aria-label={ "Code " + fresh.Code }>{ fresh.Code }</span>
					<button type="button" class="btn-secondary text-sm" @click="copy(code, 'Code copied')">
						<i class="fa-solid fa-copy" aria-hidden="true"></i>Copy
					</button>
					<button type="button" class="btn-secondary text-sm" @click="copy(link, 'Invite link copied')">
						<i class="fa-solid fa-link" aria-hidden="true"></i>Copy invite link
					</button>
				</div>
				<p class="text-xs text-fg-secondary mt-2">
					if fresh.Note != "" {
						For { fresh.Note }.
					}
					if fresh.IsVisit() {
						This code lets them look around for { visitDaysLabel(fresh.VisitDays) }.
					}
					The invite link fills the code in, so they only type a name.
					Write it down or copy it now: Chronicle keeps only a fingerprint, so it can't show this code again.
				</p>
			</div>
		}
		<form
			class="flex flex-col gap-3"
			hx-post={ fmt.Sprintf("/campaigns/%s/guest-codes", campaignID) }
			hx-target="#guest-codes"
			hx-swap="outerHTML"
			x-data="{ kind: 'player' }"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<fieldset class="flex flex-wrap items-end gap-x-6 gap-y-3">
				<legend class="sr-only">What the code does</legend>
				<div>
					<span class="block text-xs font-medium text-fg-body mb-1" aria-hidden="true">This code lets them</span>
					<div class="gc-seg">
						<label><input type="radio" name="kind" value="player" x-model="kind" checked/>Join as a player</label>
						<label><input type="radio" name="kind" value="visit" x-model="kind"/>Look around</label>
					</div>
				</div>
				<div x-show="kind === 'visit'" x-cloak>
					<span class="block text-xs font-medium text-fg-body mb-1" aria-hidden="true">For</span>
					<div class="gc-seg" role="radiogroup" aria-label="How long they can look around">
						for _, d := range guestVisitDays {
							<label><input type="radio" name="visit_days" value={ fmt.Sprint(d) } checked?={ d == 3 } :disabled="kind !== 'visit'"/>{ visitDaysLabel(d) }</label>
						}
					</div>
				</div>
			</fieldset>
			<div class="flex flex-wrap items-end gap-3">
				<div class="flex-1 min-w-[12rem]">
					<label for="guest-code-note" class="block text-xs font-medium text-fg-body mb-1">Who it's for <span class="text-fg-muted font-normal">(optional)</span></label>
					<input type="text" id="guest-code-note" name="note" maxlength="100" class="input w-full" placeholder="Sam, Friday's one-shot"/>
				</div>
				<button type="submit" class="btn-primary text-sm">Make a code</button>
			</div>
		</form>
		if len(codes) > 0 {
			<ul class="mt-5 divide-y divide-edge border-t border-edge">
				for _, gc := range codes {
					@guestCodeRow(campaignID, gc, now, csrfToken)
				}
			</ul>
		}
	</section>
}

// guestCodeRow is one code in the owner's list, with the buttons its state
// allows: Remove while open, Make player and End now for a visitor.
templ guestCodeRow(campaignID string, gc GuestCode, now time.Time, csrfToken string) {
	<li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5 py-2.5">
		<div class="min-w-0">
			<div class="text-sm text-fg truncate">
				if gc.UsedByName != "" && gc.UsedAt != nil {
					{ gc.UsedByName }
				} else if gc.Note != "" {
					{ gc.Note }
				} else {
					<span class="text-fg-muted italic">No note</span>
				}
			</div>
			<div class="text-xs text-fg-muted">
				if gc.IsVisit() {
					Look around, { visitDaysLabel(gc.VisitDays) } ·
				}
				Made { gc.CreatedAt.Format("Jan 2") }
			</div>
		</div>
		<div class="flex flex-wrap items-center gap-3 shrink-0">
			switch gc.Status(now) {
				case "visiting":
					<span class="gc-pill gc-pill-live">Looking around · { visitRemaining(*gc.VisitUntil, now) }</span>
					@guestCodeAction(campaignID, gc.ID, "player", "Make player", csrfToken)
					@guestCodeAction(campaignID, gc.ID, "end", "End now", csrfToken)
				case "visit_ended":
					<span class="gc-pill">Looked around until { gc.VisitUntil.Format("Jan 2") }</span>
					@guestCodeAction(campaignID, gc.ID, "player", "Make player", csrfToken)
				case "used":
					<span class="gc-pill gc-pill-ok">
						if gc.UsedByName != "" {
							Joined as a player
						} else {
							Used
						}
					</span>
				case "expired":
					<span class="gc-pill">Expired</span>
				default:
					<span class="gc-pill gc-pill-live">Open until { gc.ExpiresAt.Format("Jan 2") }</span>
					<form
						hx-delete={ fmt.Sprintf("/campaigns/%s/guest-codes/%s", campaignID, gc.ID) }
						hx-target="#guest-codes"
						hx-swap="outerHTML"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button type="submit" class="gc-remove">Remove</button>
					</form>
			}
		</div>
	</li>
}

// guestCodeAction is a quiet-word button on a visitor's row.
templ guestCodeAction(campaignID, codeID, action, label, csrfToken string) {
	<form
		hx-post={ fmt.Sprintf("/campaigns/%s/guest-codes/%s/%s", campaignID, codeID, action) }
		hx-target="#guest-codes"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<button type="submit" class="text-xs font-medium text-accent hover:underline">{ label }</button>
	</form>
}

// visitDaysLabel is "1 day" or "3 days".
func visitDaysLabel(days int) string {
	if days == 1 {
		return "1 day"
	}
	return fmt.Sprintf("%d days", days)
}

// visitRemaining is the owner's view of a running pass: days left, or hours
// on its last day, rounded up.
func visitRemaining(until, now time.Time) string {
	left := until.Sub(now)
	if left < 24*time.Hour {
		h := int(math.Ceil(left.Hours()))
		if h <= 1 {
			return "under an hour left"
		}
		return fmt.Sprintf("%d hours left", h)
	}
	return visitDaysLabel(int(math.Ceil(left.Hours()/24))) + " left"
}

// guestInviteLink is the join page with the code filled in, so the person
// it is sent to taps one link and types only a name.
func guestInviteLink(joinURL, code string) string {
	return joinURL + "?code=" + url.QueryEscape(code)
}

// guestCodeCopyData is the Alpine state for the fresh code's copy buttons.
// The values go through %q so they are JavaScript string literals.
func guestCodeCopyData(code, link string) string {
	return fmt.Sprintf(`{ code: %q, link: %q, copy(text, done) { navigator.clipboard.writeText(text).then(() => Chronicle.notify(done, 'success')); } }`, code, link)
}
