// settings_campaign.templ draws Campaign settings' Campaign tab: who the
// campaign is, who can see it, where new pages start and how it looks, beside
// the card people see on My campaigns, which follows the name and the
// description as they are typed.

package campaigns

import "github.com/keyxmakerx/chronicle/internal/templates/layouts"

// CampaignTabPage is the Campaign tab inside the settings frame.
templ CampaignTabPage(cc *CampaignContext, t CampaignTab) {
	@layouts.App(cc.Campaign.Name + " — Campaign") {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/manage_desk.css") }/>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/settings_board.css") }/>
		@layouts.ManageFrame(layouts.ManageFrameData{Title: "Campaign", Line: "settings", Landing: true, NoFigure: true}) {
			<div class="desk sb" data-desk data-campaign={ cc.Campaign.ID }>
				<p class="sr-only" role="status" data-sb-status></p>
				<div class="sb-split">
					<div class="sb-main">
						<h2 class="sb-h">Name and description</h2>
						<div class="sb-list">
							@campaignField(t.Name, "name", false)
							@campaignField(t.Description, "description", true)
							<div class="sb-row" id="line-pictures">
								<span class="sb-rl">Pictures</span>
								<span class="sb-rv sb-words">
									<span class="sb-dim">The emblem and the cover are part of the look.</span>
									<a class="sb-word" href={ templ.SafeURL(t.PicturesHref) }>Change them in the Customizer</a>
								</span>
							</div>
						</div>
						<h2 class="sb-h">Who can see it</h2>
						@campaignChoice(t.Access, "access", "public")
						<h2 class="sb-h">New pages start</h2>
						@campaignChoice(t.Pages, "pages", "pages")
						<h2 class="sb-h">Look</h2>
						<div class="sb-list">
							<div class="sb-lookrow" id="line-look" data-line="look">
								<span class="sb-lookprev" aria-hidden="true"><b class="stg-face">Aa</b><span><i></i><i></i><i></i></span><em></em><em></em></span>
								<span class="sb-grow">
									<span class="sb-strong">{ t.Look.Look }</span>
									if s := joinParts(t.Look.Colour, t.Look.Pages); s != "" {
										<span class="sb-dim" style="display:block">{ s }</span>
									}
								</span>
								<a class="sb-word" href={ templ.SafeURL(t.CustomizerHref) }>Open the Customizer</a>
							</div>
						</div>
						if len(t.Customize) > 0 {
							<ul class="set-list sb-custom" aria-label="Customize areas">
								for _, l := range t.Customize {
									@deskRow(l)
								}
							</ul>
						}
					</div>
					<aside class="sb-aside" aria-labelledby="sb-card-l">
						<h2 class="sb-h" id="sb-card-l">On My campaigns</h2>
						@campaignCardPreview(t.Card)
						<p class="sb-dim">This is the card people see. It changes as you type.</p>
						<ul class="set-list sb-preview">
							@deskRow(t.Preview)
						</ul>
					</aside>
				</div>
			</div>
		}
	}
}

// campaignField is the name or the description as a field that saves when it
// is left (or on Enter for the name, Ctrl or Cmd + Enter for the description);
// Escape puts the stored words back. Off on an archived campaign.
templ campaignField(b *DeskBlank, id string, multi bool) {
	<div class={ "sb-row", templ.KV("sb-row-top", multi) } id={ "line-" + id } data-line={ id }>
		<label class="sb-rl" for={ "sb-f-" + id }>{ b.Label }</label>
		<span class="sb-rv">
			if multi {
				<textarea
					id={ "sb-f-" + id }
					class="sb-field"
					rows="4"
					maxlength={ deskMax(b) }
					data-sb-src={ id }
					data-stored={ b.Value }
					data-url={ b.URL }
					data-method={ b.Method }
					data-field={ b.Field }
					aria-label={ b.Label }
					disabled?={ b.Off != "" }
					title={ b.Off }
					placeholder="What the campaign is about, in a sentence or two"
					oninput={ boardCall("boardInput", "input") }
					onchange={ boardCall("boardSave", "save") }
					onkeydown={ boardKey() }
				>{ b.Value }</textarea>
				<span class="sb-count-left" data-sb-left aria-hidden="true">{ itoa(b.Max - len([]rune(b.Value))) } left</span>
			} else {
				<input
					id={ "sb-f-" + id }
					class="sb-field"
					type="text"
					maxlength={ deskMax(b) }
					value={ b.Value }
					data-sb-src={ id }
					data-stored={ b.Value }
					data-url={ b.URL }
					data-method={ b.Method }
					data-field={ b.Field }
					aria-label={ b.Label }
					disabled?={ b.Off != "" }
					title={ b.Off }
					autocomplete="off"
					oninput={ boardCall("boardInput", "input") }
					onchange={ boardCall("boardSave", "save") }
					onkeydown={ boardKey() }
				/>
			}
			if b.Off != "" {
				<span class="sb-dim">{ b.Off }</span>
			}
		</span>
		<span class="desk-acts"></span>
	</div>
}

// campaignChoice is a two-way setting as two cards, each saying what it means;
// a press saves at once. The group carries the route, the cards their values.
templ campaignChoice(b *DeskBlank, kind, id string) {
	<div class="sb-choicerow" id={ "line-" + id } data-line={ id }>
		<div
			class="sb-choice"
			role="group"
			aria-label={ b.Label }
			data-sb-choice
			data-label={ b.Label }
			data-url={ b.URL }
			data-method={ b.Method }
			data-field={ b.Field }
			data-bool?={ b.Bool }
		>
			for i, o := range b.Options {
				<button
					type="button"
					data-v={ o.Value }
					aria-pressed={ boolStr(choiceOn(b, o)) }
					aria-disabled={ deskDisabled(b) }
					title={ b.Off }
					onclick={ boardCall("boardChoice", "choice") }
				>
					@choiceGlyph(kind, i)
					<span><b>{ o.Label }</b><small>{ o.Hint }</small></span>
				</button>
			}
		</div>
		if b.Off != "" {
			<p class="sb-dim">{ b.Off }</p>
		}
		<span class="desk-acts"></span>
	</div>
}

// choiceGlyph is an option's picture: a lock or a globe for who can see the
// campaign, a closed or an open eye for where new pages start.
templ choiceGlyph(kind string, i int) {
	switch {
		case kind == "access" && i == 0:
			<svg class="sb-g" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 015 0v2"></path></svg>
		case kind == "access":
			<svg class="sb-g" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.5"></circle><path d="M2.5 8h11M8 2.5c2 2 2 9 0 11M8 2.5c-2 2-2 9 0 11"></path></svg>
		case i == 0:
			<svg class="sb-g" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 2.5l11 11M6.3 4.3C6.9 4.1 7.4 4 8 4c2.3 0 4.5 1.3 6.5 4-.6.9-1.3 1.7-2 2.3M10 11.5c-.6.3-1.3.5-2 .5-2.3 0-4.5-1.3-6.5-4 .7-1 1.4-1.8 2.2-2.5"></path></svg>
		default:
			<svg class="sb-g" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 8c2-3.3 4.2-5 6.5-5s4.5 1.7 6.5 5c-2 3.3-4.2 5-6.5 5S3.5 11.3 1.5 8z"></path><circle cx="8" cy="8" r="2"></circle></svg>
	}
}

// campaignCardPreview is the campaign's card as people see it on My
// campaigns: its cover, emblem, name, description, a few faces and whether it
// is private. The name and description follow the fields as they are typed.
templ campaignCardPreview(c CampaignTabCard) {
	<div class="sb-pcard" aria-label="Your campaign's card">
		if c.Cover != "" {
			<img class="sb-pcard-cover" src={ layouts.MediaURL(ctx, c.Cover) } alt="" loading="lazy"/>
		} else {
			@layouts.ManageDrawnCover("sb-pcard-cover")
		}
		<div class="sb-pcard-in">
			if c.Emblem != "" {
				<img class="stg-emblem" src={ layouts.MediaURL(ctx, c.Emblem) } alt=""/>
			} else {
				<span class="stg-emblem stg-face" aria-hidden="true">{ cardInitial(c.Name) }</span>
			}
			<p class="sb-pname stg-face" data-sb-bind="name">{ c.Name }</p>
			<p class="sb-pdesc" data-sb-bind="description">{ c.Description }</p>
			<div class="sb-prow">
				<span class="sb-avrow">
					for _, f := range c.Faces {
						if f.Avatar != "" {
							<img class="sb-av sb-av-sm" src={ layouts.MediaThumbURL(ctx, f.Avatar, "300") } alt="" loading="lazy"/>
						} else {
							<span class={ "sb-av", "sb-av-sm", "sb-h" + itoa(f.Hue) } aria-hidden="true">{ f.Initial() }</span>
						}
					}
				</span>
				<span class="stg-pill" data-settings-access>
					if c.Public {
						Public
					} else {
						Private
					}
				</span>
			</div>
		</div>
	</div>
}
