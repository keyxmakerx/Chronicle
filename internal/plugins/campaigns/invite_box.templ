// invite_box.templ renders the People page's one "Invite someone" box:
// three ways in side by side, and one list of whatever is still waiting.

package campaigns

import (
	"fmt"
	"time"

	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/timeutil"
)

// InviteBox is the box. It is its own swap target: every action in it
// answers with the whole box, so the list below is never out of date.
templ InviteBox(d InviteBoxData) {
	<section id="invite-box" class="card p-6" aria-labelledby="invite-box-heading" hx-get={ fmt.Sprintf("/campaigns/%s/invite-box", d.CampaignID) } hx-trigger="join-link-replaced from:body, invites-changed from:body" hx-swap="outerHTML" x-data={ fmt.Sprintf("{ mode: %q }", d.Mode) }>
		<h2 id="invite-box-heading" class="text-lg font-semibold text-fg mb-3">Invite someone</h2>
		if d.Err != "" {
			<div class="alert-error mb-4" role="alert">{ d.Err }</div>
		}
		if d.Done != "" {
			<div class="alert-success mb-4" role="status">
				{ d.Done }
				if d.DoneLink != "" {
					<input type="text" readonly value={ d.DoneLink } aria-label="Invite to send" class="input w-full font-mono text-sm mt-2" onclick="this.select()"/>
				}
			</div>
		}
		<div class="ib-choices" role="tablist" aria-label="How to invite">
			@inviteChoice("email", "By email", "They get a message with a button.")
			@inviteChoice("link", "With a link", "For the group chat. Anyone with it can join.")
			@inviteChoice("code", "With a code", "No account needed. Play, or just look around.")
		</div>
		<div class="ib-panel" role="tabpanel" x-show="mode === 'email'" x-cloak>
			<form
				class="flex flex-wrap items-end gap-3"
				hx-post={ fmt.Sprintf("/campaigns/%s/invite-box/email", d.CampaignID) }
				hx-target="#invite-box"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ d.CSRF }/>
				<div class="flex-1 min-w-[12rem]">
					<label for="ib-email" class="block text-xs font-medium text-fg-body mb-1">Email</label>
					<input type="email" id="ib-email" name="email" required class="input w-full" placeholder="player@example.com"/>
				</div>
				<div>
					<label for="ib-role" class="block text-xs font-medium text-fg-body mb-1">Role</label>
					<select id="ib-role" name="role" class="input">
						<option value="player">Player</option>
						<option value="scribe">Scribe</option>
					</select>
				</div>
				<button type="submit" class="btn-primary text-sm">Send invite</button>
			</form>
			<p class="text-xs text-fg-muted mt-2">
				They join when they accept, whether or not they have an account yet.
				if !d.EmailReady {
					This site can't send email yet, so you'll get a link to send them yourself.
				}
			</p>
		</div>
		<div class="ib-panel" role="tabpanel" x-show="mode === 'link'" x-cloak>
			if d.LinkURL != "" {
				<div class="flex items-center gap-2" x-data={ fmt.Sprintf("{ link: %q, copy() { navigator.clipboard.writeText(this.link).then(() => Chronicle.notify('Link copied', 'success')); } }", d.LinkURL) }>
					<input type="text" readonly value={ d.LinkURL } class="input flex-1 font-mono text-sm bg-surface-alt" aria-label="Invite link"/>
					<button type="button" class="btn-secondary text-sm" @click="copy()">Copy</button>
				</div>
				<p class="text-xs text-fg-muted mt-2">Anyone with this link joins as a player. Revoke it below when you're done.</p>
			} else {
				<form hx-post={ fmt.Sprintf("/campaigns/%s/invite-box/link", d.CampaignID) } hx-target="#invite-box" hx-swap="outerHTML">
					<input type="hidden" name="csrf_token" value={ d.CSRF }/>
					<button type="submit" class="btn-primary text-sm">Make a link</button>
					<p class="text-xs text-fg-muted mt-2">One link for the campaign. Anyone who opens it can sign in or make an account and join as a player.</p>
				</form>
			}
		</div>
		<div class="ib-panel" role="tabpanel" x-show="mode === 'code'" x-cloak>
			if d.Fresh != nil {
				@freshCode(d.Fresh, d.JoinURL)
			}
			<form
				class="flex flex-col gap-3"
				hx-post={ fmt.Sprintf("/campaigns/%s/invite-box/code", d.CampaignID) }
				hx-target="#invite-box"
				hx-swap="outerHTML"
				x-data="{ kind: 'player' }"
			>
				<input type="hidden" name="csrf_token" value={ d.CSRF }/>
				<fieldset class="flex flex-wrap items-end gap-x-6 gap-y-3">
					<legend class="sr-only">What the code does</legend>
					<div>
						<span class="block text-xs font-medium text-fg-body mb-1" aria-hidden="true">This code lets them</span>
						<div class="gc-seg">
							<label><input type="radio" name="kind" value="player" x-model="kind" checked/>Join as a player</label>
							<label><input type="radio" name="kind" value="visit" x-model="kind"/>Look around</label>
						</div>
					</div>
					<div x-show="kind === 'visit'" x-cloak>
						<span class="block text-xs font-medium text-fg-body mb-1" aria-hidden="true">For</span>
						<div class="gc-seg" role="radiogroup" aria-label="How long they can look around">
							for _, n := range guestVisitDays {
								<label><input type="radio" name="visit_days" value={ fmt.Sprint(n) } checked?={ n == 3 } :disabled="kind !== 'visit'"/>{ visitDaysLabel(n) }</label>
							}
						</div>
					</div>
				</fieldset>
				<div class="flex flex-wrap items-end gap-3">
					<div class="flex-1 min-w-[12rem]">
						<label for="ib-note" class="block text-xs font-medium text-fg-body mb-1">Who it's for <span class="text-fg-muted font-normal">(optional)</span></label>
						<input type="text" id="ib-note" name="note" maxlength="100" class="input w-full" placeholder="Sam, Friday's one-shot"/>
					</div>
					<button type="submit" class="btn-primary text-sm">Make a code</button>
				</div>
				<p class="text-xs text-fg-muted">
					They type it at <span class="font-mono text-fg-body">{ d.JoinURL }</span> with just a name. Each code works once, for 7 days.
					A visitor reads what a visitor to a public campaign would, and can't write or roll.
				</p>
			</form>
		</div>
		@inviteWaiting(d)
	</section>
}

// inviteChoice is one of the three side-by-side choices.
templ inviteChoice(mode, title, line string) {
	<button
		type="button"
		role="tab"
		class="ib-choice"
		:class={ fmt.Sprintf("mode === '%s' && 'is-open'", mode) }
		:aria-selected={ fmt.Sprintf("mode === '%s'", mode) }
		@click={ fmt.Sprintf("mode = '%s'", mode) }
	>
		<span class="ib-choice-title">{ title }</span>
		<span class="ib-choice-line">{ line }</span>
	</button>
}

// freshCode is a code just made, shown once with its copy buttons.
templ freshCode(fresh *NewGuestCode, joinURL string) {
	<div
		class="step-settle rounded-lg border border-accent/40 bg-accent/5 p-4 mb-4"
		x-data={ guestCodeCopyData(fresh.Code, guestInviteLink(joinURL, fresh.Code)) }
	>
		<div class="flex flex-wrap items-center gap-3">
			<span class="font-mono text-2xl font-semibold tracking-widest text-fg" aria-label={ "Code " + fresh.Code }>{ fresh.Code }</span>
			<button type="button" class="btn-secondary text-sm" @click="copy(code, 'Code copied')">Copy</button>
			<button type="button" class="btn-secondary text-sm" @click="copy(link, 'Invite link copied')">Copy invite link</button>
		</div>
		<p class="text-xs text-fg-secondary mt-2">
			if fresh.Note != "" {
				For { fresh.Note }.
			}
			if fresh.IsVisit() {
				This code lets them look around for { visitDaysLabel(fresh.VisitDays) }.
			}
			The invite link fills the code in, so they only type a name.
			Write it down or copy it now: Chronicle keeps only a fingerprint, so it can't show this code again.
		</p>
	</div>
}

// inviteWaiting is the one list: every emailed invite not yet accepted, the
// live link, and every unused code, plus visitors who are looking around.
templ inviteWaiting(d InviteBoxData) {
	<div class="mt-6 border-t border-edge pt-4">
		<h3 class="text-xs font-semibold uppercase tracking-wide text-fg-secondary mb-1">Waiting to be used</h3>
		if len(d.Invites) == 0 && d.LinkURL == "" && len(d.Codes) == 0 {
			<p class="text-sm text-fg-muted py-2">Nothing waiting. Invites, links and codes you make show up here until they are used.</p>
		} else {
			<ul class="divide-y divide-edge">
				for _, inv := range d.Invites {
					<li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5 py-2.5">
						<div class="min-w-0">
							<div class="text-sm text-fg truncate">{ inv.Email }</div>
							<div class="text-xs text-fg-muted">Emailed invite · { inviteRoleLabel(inv.Role) } · { inviteEnds(inv.ExpiresAt, d.Now) }</div>
						</div>
						@boxAction("hx-delete", fmt.Sprintf("/campaigns/%s/invite-box/invites/%s", d.CampaignID, inv.ID), d.CSRF, "Revoke", "gc-remove")
					</li>
				}
				if d.LinkURL != "" {
					<li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5 py-2.5">
						<div class="min-w-0">
							<div class="text-sm text-fg truncate">Invite link</div>
							<div class="text-xs text-fg-muted">Joins as a player · no end date</div>
						</div>
						@boxAction("hx-delete", fmt.Sprintf("/campaigns/%s/invite-box/link", d.CampaignID), d.CSRF, "Revoke", "gc-remove")
					</li>
				}
				for _, gc := range d.Codes {
					@inviteCodeRow(d, gc)
				}
			</ul>
		}
	</div>
}

// inviteCodeRow is one code: Remove while unused, Make player and End now
// for someone who is looking around.
templ inviteCodeRow(d InviteBoxData, gc GuestCode) {
	<li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5 py-2.5">
		<div class="min-w-0">
			<div class="text-sm text-fg truncate">
				if gc.UsedByName != "" && gc.UsedAt != nil {
					{ gc.UsedByName }
				} else if gc.Note != "" {
					Code for { gc.Note }
				} else {
					Code
				}
			</div>
			<div class="text-xs text-fg-muted">
				if gc.IsVisit() {
					Look around, { visitDaysLabel(gc.VisitDays) }
				} else {
					Join as a player
				}
				·
				switch gc.Status(d.Now) {
					case "visiting":
						looking around, { visitRemaining(*gc.VisitUntil, d.Now) }
					case "visit_ended":
						looked around until
						{ " " }
						@components.Date(*gc.VisitUntil, timeutil.DateDay)
					default:
						{ inviteEnds(gc.ExpiresAt, d.Now) }
				}
			</div>
		</div>
		<div class="flex flex-wrap items-center gap-3 shrink-0">
			switch gc.Status(d.Now) {
				case "visiting":
					@boxAction("hx-post", fmt.Sprintf("/campaigns/%s/invite-box/codes/%s/player", d.CampaignID, gc.ID), d.CSRF, "Make player", "text-xs font-medium text-accent hover:underline")
					@boxAction("hx-post", fmt.Sprintf("/campaigns/%s/invite-box/codes/%s/end", d.CampaignID, gc.ID), d.CSRF, "End now", "text-xs font-medium text-accent hover:underline")
				case "visit_ended":
					@boxAction("hx-post", fmt.Sprintf("/campaigns/%s/invite-box/codes/%s/player", d.CampaignID, gc.ID), d.CSRF, "Make player", "text-xs font-medium text-accent hover:underline")
				default:
					@boxAction("hx-delete", fmt.Sprintf("/campaigns/%s/invite-box/codes/%s", d.CampaignID, gc.ID), d.CSRF, "Remove", "gc-remove")
			}
		</div>
	</li>
}

// boxAction is a quiet-word button that posts or deletes and redraws the box.
templ boxAction(verb, url, csrf, label, class string) {
	<form { boxActionAttrs(verb, url)... }>
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<button type="submit" class={ class }>{ label }</button>
	</form>
}

func inviteRoleLabel(role string) string {
	if role == "scribe" {
		return "Scribe"
	}
	return "Player"
}

// inviteEnds says when an invite or code stops working.
func inviteEnds(at, now time.Time) string {
	left := at.Sub(now)
	if left < 24*time.Hour {
		return "ends today"
	}
	return fmt.Sprintf("%s left", visitDaysLabel(int(left.Hours()/24)))
}

// boxActionAttrs is the HTMX wiring of a box action: the verb on its url,
// answered by the whole box.
func boxActionAttrs(verb, url string) templ.Attributes {
	return templ.Attributes{verb: url, "hx-target": "#invite-box", "hx-swap": "outerHTML"}
}
