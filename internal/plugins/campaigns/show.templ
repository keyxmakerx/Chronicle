// show.templ renders the campaign dashboard page showing campaign details,
// quick links, category quick-nav with counts, recent pages, and a pending
// transfer banner if applicable.

package campaigns

import (
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"encoding/json"
	"fmt"
	"time"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	"github.com/keyxmakerx/chronicle/internal/timeutil"
)

// CampaignShowPage renders the campaign dashboard. If the campaign has a custom
// dashboard_layout JSON set, renders from that layout. Otherwise falls back to
// the hardcoded default dashboard.
//
// cc is the request's context: the real one, or a visitor's during a guest
// preview. guestPrivate is the DM team asking for the guests' dashboard of a
// private campaign, where there is no visitor's dashboard to draw.
templ CampaignShowPage(cc *CampaignContext, transfer *OwnershipTransfer, recentEntities []RecentEntity, csrfToken string, guestPrivate bool) {
	// shown is the context the page is drawn from: the players' view of an
	// owner previewing as a player, so every owner-only control reads as it
	// does for a player. cc itself still says who the viewer really is.
	{{ shown := cc }}
	{{ previewing := layouts.IsViewingAsPlayer(ctx) && cc.CanAuthorDmOnly() }}
	if previewing {
		{{ shown = cc.PlayerPreview() }}
	}
	@layouts.App(cc.Campaign.Name) {
		@layouts.AppFrame() {
			// VTT update-available banner is owner-only markup: its endpoint
			// sits behind RequireAuth+requireOwner, so emitting it to a
			// viewer who can't pass that gate 401s/403s the on-load hx-get
			// (redirecting public viewers to /login, error-toasting players).
			if shown.MemberRole >= RoleOwner {
				<span
					hx-get={ fmt.Sprintf("/campaigns/%s/foundry-vtt/show-banner-fragment", cc.Campaign.ID) }
					hx-trigger="load"
					hx-swap="outerHTML"
				></span>
			}
			// Pending transfer banner for the target user.
			if transfer != nil {
				<div class="alert-warning mb-6">
					<strong>Ownership transfer pending.</strong>
					if shown.MemberRole == RoleOwner {
						You have initiated a transfer. The new owner must accept it.
						<form
							method="POST"
							action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/cancel-transfer", cc.Campaign.ID)) }
							class="inline"
							hx-post={ fmt.Sprintf("/campaigns/%s/cancel-transfer", cc.Campaign.ID) }
						>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button type="submit" class="underline hover:opacity-80 ml-2">Cancel transfer</button>
						</form>
					}
				</div>
			}

			// Welcome message banner (MOTD).
			if msg := cc.Campaign.ParseSettings().WelcomeMessage; msg != "" {
				@welcomeMessageBanner(cc.Campaign.ID, msg)
			}

			// "Last night: write it up", for those who write recaps. It joins
			// game nights, which this plugin may not import, so internal/app
			// serves it; an empty answer removes the slot.
			if shown.IsMember && shown.MemberRole >= RoleScribe && !previewing {
				<div
					data-block="last-night"
					hx-get={ fmt.Sprintf("/campaigns/%s/last-night", cc.Campaign.ID) }
					hx-trigger="load"
					hx-swap="outerHTML"
				></div>
			}

			// The viewer's own home (Director, guest or their role), with the
			// same fallbacks the Customizer shows, so both draw one layout.
			// The DM team's "Dashboard for" line turns Home into the players'
			// or the guests' dashboard where it stands, with a note saying
			// whose it is. The player preview swaps the audience here; the
			// guest preview arrives as a visitor's context, so HomeAudience
			// already answers guest.
			{{ audience := shown.HomeAudience() }}
			if previewing {
				{{ audience = HomePlayer }}
			}
			{{ layout, _ := cc.Campaign.HomeLayout(audience) }}
			if audience == HomeDirector {
				{{ layout = cc.Campaign.DirectorHome() }}
			}
			if guestPrivate {
				// No dashboard: guests cannot open a private campaign.
				@dashWelcomeBanner(cc.GuestPreviewContext())
				@homePreviewChrome(cc, PreviewGuest, true, csrfToken)
			} else {
				@dashboardRows(shown, layout, recentEntities, previewSlotFor(cc, previewing, csrfToken))
			}

			<!-- Footer meta -->
			<div class="flex items-center gap-3 text-xs text-fg-muted mt-8">
				if label := ViewerAccessLabel(shown); label != "" {
					<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-alt text-fg-secondary font-medium">
						<i class="fa-solid fa-user-shield text-[10px]"></i>
						{ label }
					</span>
				}
				<span>Created
				{ " " }
				@components.Date(cc.Campaign.CreatedAt, timeutil.DateShort)
				</span>
			</div>
		}
	}
}

// previewSlotFor is the "Dashboard for" line and its note, drawn under the
// Home title for the real DM team in all three states, or nil for anyone
// else. cc is the request's context; a guest preview carries the real
// viewer in its Previewer fields.
func previewSlotFor(cc *CampaignContext, playerPreview bool, csrfToken string) templ.Component {
	if !cc.DMTeamChrome() {
		return nil
	}
	state := ""
	switch {
	case cc.InGuestPreview():
		state = cc.Preview
	case playerPreview:
		state = PreviewPlayer
	}
	return homePreviewChrome(cc, state, false, csrfToken)
}

// homePreviewChrome is the line `DASHBOARD FOR  YOU  PLAYERS  GUESTS` at tab
// weight (small capitals, the chosen one in the accent with a hairline under
// it) and, while a preview is on, the amber note saying whose dashboard this
// is. Each choice posts to view-as, so it is a button a keyboard reaches.
// state is "", "player" or "guest". guestPrivate says the guest preview is
// asked for on a private campaign, which gets a plain note instead of a
// dashboard.
templ homePreviewChrome(cc *CampaignContext, state string, guestPrivate bool, csrfToken string) {
	<div class="cb-home-preview mt-3 mb-4" data-home-preview={ state }>
		<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1" role="group" aria-label="Dashboard for">
			<span class="text-xs font-semibold uppercase tracking-wider text-fg-secondary">Dashboard for</span>
			@homePreviewChoice(cc, "self", "You", state == "", csrfToken)
			@homePreviewChoice(cc, "player", "Players", state == PreviewPlayer, csrfToken)
			@homePreviewChoice(cc, "guest", "Guests", state == PreviewGuest || state == PreviewGuestCode, csrfToken)
		</div>
		if guestPrivate {
			// A div, not a paragraph: the arrange form inside would end a paragraph.
			<div class="mt-3 text-sm text-fg-secondary" role="status">
				<p>This campaign is private, so only guests with a guest code can open it.</p>
				<div class="cb-pv-acts">
					@homeGuestCodeLink(cc, csrfToken)
					<a href={ templ.SafeURL("/campaigns/" + cc.Campaign.ID + "/dashboard#line-public") } class="text-accent hover:underline">Who can read it</a>
					if cc.OwnerChrome() {
						@homeArrangeLink(cc, PreviewGuest, csrfToken)
					}
				</div>
			</div>
		} else if state != "" {
			<div class="cb-pv-strip mt-3 rounded-lg border-l-[3px] border-amber-500 bg-amber-500/10 px-4 py-2 text-sm text-fg" role="status">
				if state == PreviewGuestCode {
					You are seeing the guests' dashboard, as a visitor with a guest code sees it.
				} else if state == PreviewGuest {
					You are seeing the guests' dashboard, as a visitor sees it.
				} else {
					You are seeing the players' dashboard, as a player sees it.
				}
				if cc.OwnerChrome() {
					<div class="cb-pv-acts">
						@homeArrangeLink(cc, state, csrfToken)
					</div>
				}
			</div>
		}
	</div>
}

// homePreviewChoice is one word of the line. The chosen one is the accent
// with a hairline under it; the others are quiet capitals.
templ homePreviewChoice(cc *CampaignContext, as, label string, selected bool, csrfToken string) {
	<form method="POST" action={ templ.SafeURL("/campaigns/" + cc.Campaign.ID + "/view-as") } hx-post={ "/campaigns/" + cc.Campaign.ID + "/view-as" } hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` } class="inline">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="as" value={ as }/>
		<input type="hidden" name="next" value="home"/>
		<button
			type="submit"
			aria-pressed={ boolWord(selected) }
			class={
				"text-xs font-semibold uppercase tracking-wider border-b pb-0.5",
				templ.KV("text-accent border-accent", selected),
				templ.KV("text-fg border-transparent hover:text-accent", !selected),
			}
		>{ label }</button>
	</form>
}

// homeGuestCodeLink starts the guest-code preview, the one view of a private
// campaign a guest can have.
templ homeGuestCodeLink(cc *CampaignContext, csrfToken string) {
	<form method="POST" action={ templ.SafeURL("/campaigns/" + cc.Campaign.ID + "/view-as") } hx-post={ "/campaigns/" + cc.Campaign.ID + "/view-as" } hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` } class="inline">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="as" value={ PreviewGuestCode }/>
		<input type="hidden" name="next" value="home"/>
		<button type="submit" class="text-accent hover:underline">See it as a guest with a code</button>
	</form>
}

// homeArrangeLink is the quiet "Arrange this page". The Customizer is a
// members' page, so the post leaves the preview first and then opens the
// owner's editor for that audience's dashboard.
templ homeArrangeLink(cc *CampaignContext, home, csrfToken string) {
	<form method="POST" action={ templ.SafeURL("/campaigns/" + cc.Campaign.ID + "/view-as") } hx-post={ "/campaigns/" + cc.Campaign.ID + "/view-as" } hx-headers={ `{"X-CSRF-Token":"` + csrfToken + `"}` } class="inline">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="as" value="self"/>
		<input type="hidden" name="next" value="arrange"/>
		<input type="hidden" name="home" value={ home }/>
		<button type="submit" class="text-accent hover:underline">Arrange this page</button>
	</form>
}

// welcomeMessageBanner renders a dismissible MOTD banner. Uses localStorage
// to track dismissals; re-shows when the message content changes.
templ welcomeMessageBanner(campaignID, message string) {
	<div
		x-data={ fmt.Sprintf(`{
			dismissed: false,
			key: 'welcome-dismissed-' + '%s',
			hash: '',
			init() {
				this.hash = this.simpleHash(%s);
				var stored = localStorage.getItem(this.key);
				if (stored === this.hash) this.dismissed = true;
			},
			dismiss() {
				this.dismissed = true;
				localStorage.setItem(this.key, this.hash);
			},
			simpleHash(s) {
				var h = 0;
				for (var i = 0; i < s.length; i++) {
					h = ((h << 5) - h) + s.charCodeAt(i);
					h = h & h;
				}
				return String(h);
			}
		}`, campaignID, welcomeMessageQuoted(message)) }
		x-show="!dismissed"
		x-transition
		class="mb-6 p-4 rounded-lg bg-accent/10 border border-accent/20 flex items-start gap-3"
	>
		<i class="fa-solid fa-bullhorn text-accent text-sm mt-0.5 shrink-0"></i>
		<p class="text-sm text-fg flex-1 whitespace-pre-line">{ message }</p>
		<button
			type="button"
			@click="dismiss()"
			class="text-fg-muted hover:text-fg transition-colors shrink-0"
			title="Dismiss"
		>
			<i class="fa-solid fa-xmark text-xs"></i>
		</button>
	</div>
}

// welcomeMessageQuoted returns a JSON-encoded string safe for embedding in JS.
func welcomeMessageQuoted(msg string) string {
	b, _ := json.Marshal(msg)
	return string(b)
}

// The owner-only "new Foundry module version is ready" line lives in
// internal/plugins/foundry_vtt/show_banner.templ (CampaignUpdateBanner);
// campaigns/show.templ lazy-loads it via hx-get to stay VTT-agnostic. See the
// lazy-load slot at the top of CampaignShowPage above.

// customDashboard renders the campaign dashboard from a custom DashboardLayout
// JSON. Iterates rows → columns → blocks, using a 12-column CSS grid.
templ customDashboard(cc *CampaignContext, layout *DashboardLayout, recentEntities []RecentEntity) {
	@dashboardRows(cc, layout, recentEntities, nil)
}

// dashboardRows is customDashboard with an optional slot drawn straight under
// the first title block (the preview line), or above the rows when the layout
// has no title block.
templ dashboardRows(cc *CampaignContext, layout *DashboardLayout, recentEntities []RecentEntity, slot templ.Component) {
	{{ repeats := layout.ComingUpRepeats() }}
	{{ titleAt, hasTitle := layout.firstTitle() }}
	if slot != nil && !hasTitle {
		@slot
	}
	<div class="space-y-6">
		for ri, row := range layout.Rows {
			if row.Kind == "tiles" {
				@dashTileSection(cc, row, ri, repeats, recentEntities)
			} else {
				<div class="block-row grid grid-cols-1 md:grid-cols-12 gap-4">
					for ci, col := range row.Columns {
						// Blocks stacked in one column keep the rows' own gap.
						<div class={ dashColSpan(col.Width), "min-w-0 space-y-6" }>
							for bi, block := range col.Blocks {
								if !repeats[[3]int{ri, ci, bi}] {
									@DashboardBlockSwitch(cc, block, recentEntities)
									if slot != nil && hasTitle && titleAt == [3]int{ri, ci, bi} {
										@slot
									}
								}
							}
						</div>
					}
				</div>
			}
		}
	</div>
}

// RecentEntityCard renders a compact card for a recently updated entity.
templ RecentEntityCard(cc *CampaignContext, re *RecentEntity) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, re.ID)) }
		class="cb-link cb-row card p-0 overflow-hidden hover:shadow-md transition-shadow block group"
		if re.IsPrivate {
			data-dm-only
		}
	>
		if re.ImagePath != nil && *re.ImagePath != "" {
			<div class="cb-band h-20 bg-surface-alt overflow-hidden">
				<img
					src={ layouts.MediaURL(ctx, *re.ImagePath) }
					alt={ re.Name }
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
				/>
			</div>
		} else {
			<div class="cb-band h-10 flex items-center justify-center" style={ fmt.Sprintf("background-color: %s10", re.TypeColor) }>
				if re.TypeIcon != "" {
					<i class={ "fa-solid " + re.TypeIcon, "text-sm opacity-30" } style={ fmt.Sprintf("color: %s", re.TypeColor) }></i>
				}
			</div>
		}
		<div class="cb-row-body px-3 py-2">
			<div class="cb-row-main flex items-center justify-between gap-1.5 mb-0.5">
				<h3 class="cb-row-name text-sm font-semibold text-fg truncate group-hover:text-accent transition-colors">
					{ re.Name }
				</h3>
				if re.IsPrivate && cc.MemberRole >= RoleScribe {
					<span class="cb-dm text-fg-muted shrink-0" title={ "Private (" + layouts.GMTerm(ctx) + " only)" }>
						<i class="fa-solid fa-lock text-[9px]"></i>
					</span>
				}
			</div>
			<div class="cb-row-meta flex items-center justify-between gap-2">
				<span
					class="cb-kind inline-flex items-center gap-1 px-1.5 py-px rounded-full text-[10px] font-medium"
					style={ fmt.Sprintf("background-color: %s20; color: %s", re.TypeColor, re.TypeColor) }
				>
					if re.TypeIcon != "" {
						<i class={ "fa-solid " + re.TypeIcon, "text-[8px]" }></i>
					}
					{ re.TypeName }
				</span>
				<time class="text-[10px] text-fg-secondary" datetime={ re.UpdatedAt.UTC().Format(time.RFC3339) } title={ timeutil.FixedDate(re.UpdatedAt, timeutil.DateWithTime) } data-date-title>
					{ timeutil.EditedAgo(re.UpdatedAt, time.Now()) }
				</time>
			</div>
		</div>
	</a>
}

// dashColSpan returns the Tailwind CSS class for a 12-column grid span.
// Used by customDashboard to set column widths from the layout JSON.
func dashColSpan(width int) string {
	if width < 1 {
		width = 1
	}
	if width > 12 {
		width = 12
	}
	// On mobile (< md) all columns are full-width; on desktop they use the
	// 12-column grid. Tailwind requires full class names (no interpolation).
	classes := [13]string{
		"",                                 // 0 (unused)
		"col-span-1 md:col-span-1",        // 1
		"col-span-1 md:col-span-2",        // 2
		"col-span-1 md:col-span-3",        // 3
		"col-span-1 md:col-span-4",        // 4
		"col-span-1 md:col-span-5",        // 5
		"col-span-1 md:col-span-6",        // 6
		"col-span-1 md:col-span-7",        // 7
		"col-span-1 md:col-span-8",        // 8
		"col-span-1 md:col-span-9",        // 9
		"col-span-1 md:col-span-10",       // 10
		"col-span-1 md:col-span-11",       // 11
		"col-span-1 md:col-span-12",       // 12
	}
	return classes[width]
}
