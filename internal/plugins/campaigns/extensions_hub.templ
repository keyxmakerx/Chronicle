// extensions_hub.templ — the owner's "Game & features" page.
//
// Served at /campaigns/:id/extensions (the URL predates the rename and
// stays so bookmarks and the redirects that point here keep working). It
// holds the game system picker, the feature toggles and content packs;
// everything about Foundry is on the Foundry page (foundry_page.templ).
//
// Catalog source: PluginHubAddon list from the addons store. Each
// card is one operator-facing extension; owners get a per-card
// enable/disable toggle that fires the existing
// `PUT /campaigns/:id/addons/:addonID/toggle` endpoint. Disable
// preserves the extension's data (inert, not deleted).
//
// Cards with HasDashboard=true gain an expand affordance that issues
// `hx-get` to /extensions/:slug/dashboard, swapped into the panel
// below the catalog.

package campaigns

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// ExtensionsHubPage is the full-page render for owners landing on the
// Extensions hub. Wraps the layouts.App chrome + page header + the
// HTMX-refreshable hub fragment + the inline dashboard-panel slot +
// the Content Packs card (if a renderer is wired).
//
// `contentPacksCard` is nil if the extensions plugin is not wired in
// this build; the hub renders cleanly without it (graceful
// degradation, matches AddonLister/MediaUploader/SMTPChecker shape).
templ ExtensionsHubPage(cc *CampaignContext, addons []PluginHubAddon, csrfToken, systemOptionsJSON string, contentPacksCard templ.Component) {
	@layouts.App(cc.Campaign.Name + " - Game & features") {
		<div class="max-w-5xl mx-auto px-4 py-6" data-extensions-hub>
			@layouts.ManageHeader("Game & features")
			<div class="mb-6">
				@gameSystemCard(cc, systemOptionsJSON)
			</div>
			<div class="mb-3">
				<h2 class="text-base font-semibold text-fg">Features</h2>
				<p class="text-sm text-fg-muted">
					Turn parts of Chronicle on or off for this campaign. Turning one off hides it; nothing is deleted.
				</p>
			</div>
			// Hub catalog — HTMX-refreshed in place after a toggle so
			// the card list re-renders without a full nav.
			<div
				id="extensions-hub-list"
				hx-get={ fmt.Sprintf("/campaigns/%s/extensions/fragment", cc.Campaign.ID) }
				hx-trigger="extensions-hub-refresh from:body"
				hx-swap="innerHTML"
			>
				@ExtensionsHubFragment(cc, addons, csrfToken)
			</div>
			// Inline-dashboard panel: an "Open dashboard" affordance on a
			// card with HasDashboard=true swaps its registered dashboard
			// fragment in here. Empty until expanded.
			<div
				id="extensions-hub-dashboard-panel"
				class="mt-6"
				aria-live="polite"
			></div>
			// Extension settings overlay target. An "Open setup" button on a
			// card hx-gets the extension's settings page here; the GET returns a
			// self-opening modal (ExtensionSettingsOverlay). Empty until opened.
			<div id="extension-setup-modal"></div>
			// Content Packs card — installable content from the admin
			// install surface. Lifts the existing extensions plugin
			// fragment so the per-pack enable/disable POSTs at
			// /campaigns/:id/extensions/:extID/{enable,disable} keep
			// working unchanged. Skipped when no renderer is wired.
			if contentPacksCard != nil {
				<div class="mt-6">
					<div class="card-elev p-5 lift-hover">
						<div class="flex items-center gap-3 mb-4">
							<span class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center shrink-0">
								<i class="fa-solid fa-box-archive text-accent text-lg"></i>
							</span>
							<div class="flex-1 min-w-0">
								<h2 class="text-base font-semibold text-fg">Content Packs</h2>
								<p class="text-xs text-fg-muted mt-0.5">
									Installable content from your administrator. Disabling a pack does not delete data.
								</p>
							</div>
						</div>
						@contentPacksCard
					</div>
				</div>
			}
			if addonEnabled(addons, "sync-api") {
				<section class="card p-4 mt-6 flex flex-wrap items-center gap-3" data-foundry-moved>
					<span class="w-8 h-8 rounded-lg bg-accent/10 text-accent text-sm font-bold flex items-center justify-center shrink-0" aria-hidden="true">F</span>
					<p class="text-sm text-fg-secondary flex-1 min-w-0">Foundry setup, sync and its module version are on their own page.</p>
					<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/foundry", cc.Campaign.ID)) } class="btn-secondary text-xs">Open Foundry</a>
				</section>
			}
		</div>
	}
}

// foundryConnectRow is the Foundry row: status, module version, the connect
// line and the button that mints a new one. It is also the HTMX response to
// that button, swapped over itself (outerHTML), so the id must stay stable.
// When NewLine is set the response carries the raw key: the full line is shown
// once in a highlighted box; otherwise only the key's stored prefix appears.
templ foundryConnectRow(cc *CampaignContext, foundry FoundryRowData, csrfToken string) {
	<li id="foundry-connect-row" class="py-3" data-foundry-row>
		<div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
			<div class="flex items-start gap-3 min-w-0 flex-1">
				<span class="w-8 h-8 rounded-lg bg-accent/10 text-accent text-sm font-bold flex items-center justify-center shrink-0" aria-hidden="true">F</span>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-medium text-fg">Foundry VTT</p>
					<p class="text-xs text-fg-muted flex flex-wrap items-center gap-x-1.5" data-foundry-status>
						<span class={ "inline-block w-2 h-2 rounded-full shrink-0", foundryDotClass(foundry.Status.Level) } aria-hidden="true"></span>
						<span>{ foundry.Status.Text }</span>
						<span aria-hidden="true">&middot;</span>
						<span>{ foundry.moduleVersionText() }</span>
					</p>
					if foundry.Preview != "" {
						<code class="mt-2 block p-2 bg-surface-alt border border-edge-light rounded text-xs font-mono text-fg break-all select-all" data-foundry-preview>{ foundry.Preview }</code>
						<p class="mt-1 text-xs text-fg-muted">The key is hidden after it is made, so this shows only its start.</p>
					}
				</div>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<form
					hx-post={ fmt.Sprintf("/campaigns/%s/extensions/foundry/connect-line", cc.Campaign.ID) }
					hx-target="#foundry-connect-row"
					hx-swap="outerHTML"
					hx-disabled-elt="find button"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn-primary text-xs focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{ foundry.connectButtonLabel() }</button>
				</form>
				<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/settings?tab=api-keys", cc.Campaign.ID)) } class="btn-secondary text-xs focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">All keys</a>
			</div>
		</div>
		if foundry.NewLine != "" {
			<div class="mt-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-3" role="status" data-foundry-new-line>
				<p class="text-sm text-amber-700 dark:text-amber-400 mb-2">
					<strong>Paste this one line into Chronicle Sync's settings in Foundry.</strong>
					It won't be shown again.
				</p>
				<div class="flex items-start gap-2">
					<code id="foundry-connect-line" class="flex-1 min-w-0 p-2 bg-white dark:bg-gray-900 rounded text-xs font-mono text-fg break-all select-all">{ foundry.NewLine }</code>
					<button
						type="button"
						class="btn-secondary text-xs shrink-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
						onclick={ foundryCopyOnClick() }
					>Copy</button>
				</div>
			</div>
		}
	</li>
}

// ExtensionsHubFragment renders the catalog card grid only — used as
// the HTMX swap target after toggles + as the body of the full page.
// Enabled and disabled cards both render in the same grid (no
// Enabled/Available split) so expansion targets stay stable across
// toggles.
templ ExtensionsHubFragment(cc *CampaignContext, addons []PluginHubAddon, csrfToken string) {
	if len(addons) == 0 {
		<div class="card p-8 text-center">
			<p class="text-fg-muted">No extensions available yet.</p>
		</div>
	} else {
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			for _, addon := range addons {
				@extensionsHubCard(cc, addon, csrfToken)
			}
		</div>
	}
}

// extensionsHubCard renders a single extension card. Owner-only by
// route gating — every render-time viewer is an owner; no role branch
// here.
//
// HasDashboard cards render an "Open dashboard" affordance: either a
// link to a dedicated dashboard page, or an hx-get that expands the
// inline dashboard panel below the catalog.
templ extensionsHubCard(cc *CampaignContext, addon PluginHubAddon, csrfToken string) {
	<div
		class={ "card-elev p-4 lift-hover transition-shadow",
			templ.KV("ring-1 ring-accent/30", addon.Enabled),
			// Dim only extensions that genuinely can't be enabled yet
			// (Installed == false, "Soon"). An installed-but-off card
			// stays full brightness — it's a real control, not a
			// disabled indicator.
			templ.KV("opacity-70", !addon.Installed) }
		data-extension-card
		data-extension-slug={ addon.Slug }
		data-extension-enabled={ extensionEnabledAttr(addon.Enabled) }
	>
		<div class="flex items-start gap-3">
			<div class={ "w-10 h-10 rounded-lg flex items-center justify-center shrink-0 tier-transition",
				templ.KV("bg-accent/10", addon.Enabled),
				templ.KV("bg-surface-alt", !addon.Enabled) }>
				if addon.Icon != "" {
					<i class={ "fa-solid " + addon.Icon, "text-lg",
						templ.KV("text-accent", addon.Enabled),
						templ.KV("text-fg-muted", !addon.Enabled) }></i>
				} else {
					<i class={ "fa-solid fa-puzzle-piece text-lg",
						templ.KV("text-accent", addon.Enabled),
						templ.KV("text-fg-muted", !addon.Enabled) }></i>
				}
			</div>
			<div class="flex-1 min-w-0">
				<div class="font-semibold text-fg text-sm flex items-center gap-2">
					<span class="truncate">{ addon.Name }</span>
					if addon.NeedsSetup {
						<span class="shrink-0 px-1.5 py-0.5 text-[10px] font-medium rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400" title="This extension needs setup">
							<i class="fa-solid fa-wrench text-[9px] mr-0.5"></i>Setup
						</span>
					}
				</div>
				<p class="text-xs text-fg-muted mt-0.5">{ addon.Description }</p>
			</div>
			@extensionsHubToggle(cc, addon, csrfToken)
		</div>
		// Dashboard expand affordance: hx-get loads the extension's
		// inline dashboard into the panel below the catalog;
		// one-card-expanded-at-a-time UX via hx-target (later expand
		// replaces panel content). Disabled extensions still render
		// the affordance — the fragment route resolves to the
		// disabled placeholder so the operator sees explicit feedback
		// rather than an unclickable button.
		// Footer affordances: an "Open setup" button for enabled extensions
		// that expose a settings/onboarding page (SetupProvider registered),
		// and the dashboard expand for HasDashboard cards. Rendered together so
		// there's a single bordered footer row.
		if (addon.Enabled && addon.HasSetup) || addon.HasDashboard {
			<div class="mt-3 pt-3 border-t border-edge-light flex items-center justify-end gap-3">
				if addon.Enabled && addon.HasSetup {
					// Open the extension's settings overlay into the page-level
					// modal container. The GET returns a self-opening modal
					// (ExtensionSettingsOverlay, x-data="{open:true}").
					<button
						type="button"
						class={ "text-xs hover:underline px-2 py-1 rounded transition-colors duration-micro",
							templ.KV("text-amber-600 dark:text-amber-400 font-medium", addon.NeedsSetup),
							templ.KV("text-accent", !addon.NeedsSetup) }
						hx-get={ fmt.Sprintf("/campaigns/%s/extensions/%s/settings", cc.Campaign.ID, addon.Slug) }
						hx-target="#extension-setup-modal"
						hx-swap="innerHTML"
						data-extension-setup-open
						data-extension-slug={ addon.Slug }
					>
						<i class="fa-solid fa-wrench text-[10px] mr-1"></i>
						if addon.NeedsSetup {
							Finish setup
						} else {
							Settings
						}
					</button>
				}
				if addon.HasDashboard {
					if pageURL, ok := ExtensionDashboardPageURL(addon.Slug, cc.Campaign.ID); ok {
						// Dedicated dashboard page (E1: Calendars). Navigate to it
						// rather than HTMX-swapping the inline panel.
						<a
							href={ templ.SafeURL(pageURL) }
							class="text-xs text-accent hover:underline px-2 py-1 rounded transition-colors duration-micro"
							data-extension-dashboard-page
							data-extension-dashboard-slug={ addon.Slug }
						>
							<i class="fa-solid fa-table-columns text-[10px] mr-1"></i>
							Open dashboard
						</a>
					} else {
						// Inline-panel fragment (apps without a dedicated page yet).
						<button
							type="button"
							class="text-xs text-accent hover:underline px-2 py-1 rounded transition-colors duration-micro"
							hx-get={ fmt.Sprintf("/campaigns/%s/extensions/%s/dashboard", cc.Campaign.ID, addon.Slug) }
							hx-target="#extensions-hub-dashboard-panel"
							hx-swap="innerHTML"
							data-extension-dashboard-expand
							data-extension-dashboard-slug={ addon.Slug }
						>
							<i class="fa-solid fa-table-columns text-[10px] mr-1"></i>
							Open dashboard
						</button>
					}
				}
			</div>
		}
	</div>
}

// extensionsHubToggle renders the per-card enable/disable button.
// Reuses the existing addons-store toggle endpoint
// (`PUT /campaigns/:id/addons/:addonID/toggle`) so the addons store
// remains the single source of truth for per-campaign feature state.
// `redirect_to=extensions-hub` triggers an HX-Trigger response header
// that fires the `extensions-hub-refresh` event the hub container
// listens for.
//
// Uninstalled addons (`!Installed`) render an inert "Coming Soon"
// badge — toggling would 400 server-side because backing code is
// missing.
templ extensionsHubToggle(cc *CampaignContext, addon PluginHubAddon, csrfToken string) {
	if !addon.Installed {
		<span class="shrink-0 px-3 py-1 text-xs font-medium rounded-full bg-surface-alt text-fg-muted border border-edge cursor-default">
			<i class="fa-solid fa-clock text-[10px] mr-1"></i>
			Soon
		</span>
	} else {
		<form
			method="POST"
			hx-put={ fmt.Sprintf("/campaigns/%s/addons/%d/toggle", cc.Campaign.ID, addon.AddonID) }
			class="shrink-0"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="redirect_to" value="extensions-hub"/>
			if addon.Enabled {
				<input type="hidden" name="action" value="disable"/>
				<button
					type="submit"
					class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 hover:bg-emerald-200 dark:hover:bg-emerald-900/50 transition-colors duration-micro"
					title="Click to disable"
				>
					<i class="fa-solid fa-check text-[10px]"></i>
					On
				</button>
			} else {
				<input type="hidden" name="action" value="enable"/>
				<button
					type="submit"
					class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full bg-accent/10 text-accent border border-accent hover:bg-accent/20 transition-colors duration-micro"
					title="Click to enable"
				>
					<i class="fa-solid fa-plus text-[10px]"></i>
					Enable
				</button>
			}
		</form>
	}
}

// extensionEnabledAttr maps the bool to a string suitable for a
// data-* attribute (templ's KV doesn't fit data-* values cleanly).
// Used for selector-targeting enabled/disabled cards in tests.
func extensionEnabledAttr(enabled bool) string {
	if enabled {
		return "true"
	}
	return "false"
}

// addonEnabled reports whether the catalog lists slug as switched on.
func addonEnabled(addons []PluginHubAddon, slug string) bool {
	for _, a := range addons {
		if a.Slug == slug {
			return a.Enabled
		}
	}
	return false
}
