// settings.templ holds parts several Campaign settings pages draw: the
// activity log's lazy fragment (Data), the People page's sections, the
// feature cards' list and the "If you're away" choice.

package campaigns

import (
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/timeutil"
	"encoding/json"
	"fmt"
	"strconv"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// entityTypesJSON serializes entity types to JSON for the entity type config widget.
func entityTypesJSON(types []SettingsEntityType) string {
	b, err := json.Marshal(types)
	if err != nil {
		return "[]"
	}
	return string(b)
}

// SystemOption is a minimal system manifest for the game system selector dropdown.
type SystemOption struct {
	ID       string `json:"id"`
	Name     string `json:"name"`
	HasError bool   `json:"has_error,omitempty"`
}

// systemOptionsJSON serializes system options to JSON for Alpine.js.
func systemOptionsJSON(opts []SystemOption) string {
	b, err := json.Marshal(opts)
	if err != nil {
		return "[]"
	}
	return string(b)
}

// settingsActivityTab is the activity log on Data: a lazy HTMX fragment that
// fetches the feed when it scrolls into view.
templ settingsActivityTab(cc *CampaignContext) {
	<div id="activity-content" hx-get={ fmt.Sprintf("/campaigns/%s/activity/fragment", cc.Campaign.ID) } hx-trigger="intersect once" hx-swap="innerHTML">
		<div class="text-center py-12 text-fg-muted text-sm"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Loading activity...</div>
	</div>
}

// peopleSections renders everything the owner manages about members: the
// member list (add, role change including Co-DM, remove), the Invite someone box
// (email, link and code) and ownership transfer. The People page is its
// only home; Settings links to it instead of repeating it.
//
// On a big monitor the people themselves (members, roles, pending
// invitations) take the wide column and the ways in and out of the
// campaign (guest codes, invite link, transfer) sit beside them, so the two
// columns carry similar weight.
templ peopleSections(cc *CampaignContext, v MemberListView, transfer *OwnershipTransfer, smtpConfigured bool) {
	if !smtpConfigured {
		<div class="alert-warning mb-6">
			<i class="fa-solid fa-triangle-exclamation mr-2"></i>
			Email is not configured. Invitations and transfer notifications will not be sent by email.
		</div>
	}
	<div class="manage-split">
		<div class="manage-split-main space-y-6">
			@MemberListComponent(cc, v)
		</div>

		if cc.MemberRole >= RoleOwner {
			<div id="invite-box" hx-get={ fmt.Sprintf("/campaigns/%s/invite-box", cc.Campaign.ID) } hx-trigger="load" hx-swap="outerHTML"></div>
		}

		// Transfer ownership. The desk's Transfer… word leads here.
		<div id="transfer" class="card p-6">
			<h2 class="text-lg font-semibold text-fg mb-4">Transfer Ownership</h2>
			if transfer != nil {
				<div class="alert-warning mb-4">
					<strong>Transfer pending.</strong> Waiting for the new owner to accept. Expires
					{ " " }
					@components.Date(transfer.ExpiresAt, timeutil.DateWithTime)
					.
				</div>
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/cancel-transfer", cc.Campaign.ID)) } hx-post={ fmt.Sprintf("/campaigns/%s/cancel-transfer", cc.Campaign.ID) }>
					<input type="hidden" name="csrf_token" value={ v.CSRFToken }/>
					<button type="submit" class="btn-secondary text-sm">Cancel Transfer</button>
				</form>
			} else {
				<p class="text-sm text-fg-secondary mb-4">Transfer ownership to another user. They will receive a confirmation email (if SMTP is configured).</p>
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/transfer", cc.Campaign.ID)) } hx-post={ fmt.Sprintf("/campaigns/%s/transfer", cc.Campaign.ID) } class="flex items-end space-x-4">
					<input type="hidden" name="csrf_token" value={ v.CSRFToken }/>
					<div class="flex-1">
						<label for="transfer-email" class="block text-sm font-medium text-fg-body mb-1">New owner's email</label>
						<input type="email" id="transfer-email" name="email" required class="input w-full" placeholder="user@example.com"/>
					</div>
					<button type="submit" class="btn-primary text-sm">Initiate Transfer</button>
				</form>
			}
		</div>

		if cc.MemberRole == RoleOwner {
			@handoverCard(cc)
		}
	</div>
}

// pluginURL returns the main page URL for a given addon slug within a campaign.
func pluginURL(campaignID, slug string) string {
	switch slug {
	case "calendar":
		return fmt.Sprintf("/campaigns/%s/apps/calendar", campaignID)
	case "maps":
		return fmt.Sprintf("/campaigns/%s/maps", campaignID)
	case "timeline":
		return fmt.Sprintf("/campaigns/%s/timelines", campaignID)
	case "sessions":
		return fmt.Sprintf("/campaigns/%s/game-nights", campaignID)
	case "notes":
		return fmt.Sprintf("/campaigns/%s/journal", campaignID)
	case "armory":
		return fmt.Sprintf("/campaigns/%s/armory", campaignID)
	case "sync-api":
		return fmt.Sprintf("/campaigns/%s/connections", campaignID) // Foundry and the API keys are on Connections.
	default:
		return fmt.Sprintf("/campaigns/%s", campaignID)
	}
}

// PluginHub (handler.go) redirects to /extensions; the per-addon
// description pluginHubCard renders below reads PluginHubAddon.Description,
// sourced from the addons service's single builtinAddons copy (ADR-056).
// PluginHubListContent/pluginHubCard are still live: PluginHubFragment
// (handler.go) calls PluginHubListContent via GET
// /campaigns/:id/plugins/fragment.

// PluginHubListContent renders the addon list (for HTMX partial swaps after toggling).
templ PluginHubListContent(cc *CampaignContext, addons []PluginHubAddon, isOwner bool, csrfToken string) {
	// Enabled features with quick access links.
	if hasEnabled(addons) {
		<div class="mb-8">
			<h2 class="section-header mb-3">
				<i class="fa-solid fa-check-circle mr-2 text-emerald-500"></i>Enabled
			</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				for _, addon := range addons {
					if addon.Enabled {
						@pluginHubCard(cc, addon, isOwner, csrfToken)
					}
				}
			</div>
		</div>
	}

	// Disabled/available features.
	if hasDisabled(addons) {
		<div class="mb-6">
			<h2 class="section-header mb-3">
				<i class="fa-solid fa-circle-plus mr-2 text-fg-muted"></i>Available
			</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				for _, addon := range addons {
					if !addon.Enabled {
						@pluginHubCard(cc, addon, isOwner, csrfToken)
					}
				}
			</div>
		</div>
	}

	if len(addons) == 0 {
		<div class="card p-8 text-center">
			<p class="text-fg-muted">No features available yet.</p>
		</div>
	}
}

// pluginHubCard renders a single feature card with optional toggle for owners.
templ pluginHubCard(cc *CampaignContext, addon PluginHubAddon, isOwner bool, csrfToken string) {
	<div class={ "card p-4 flex items-start gap-3 transition-shadow",
		templ.KV("hover:ring-2 hover:ring-accent/50", addon.Enabled),
		templ.KV("opacity-60", !addon.Enabled && !isOwner) }>
		<div class={ "w-10 h-10 rounded-lg flex items-center justify-center shrink-0",
			templ.KV("bg-accent/10", addon.Enabled),
			templ.KV("bg-surface-alt", !addon.Enabled) }>
			if addon.Icon != "" {
				<i class={ "fa-solid " + addon.Icon, "text-lg",
					templ.KV("text-accent", addon.Enabled),
					templ.KV("text-fg-muted", !addon.Enabled) }></i>
			} else {
				<i class={ "fa-solid fa-puzzle-piece text-lg",
					templ.KV("text-accent", addon.Enabled),
					templ.KV("text-fg-muted", !addon.Enabled) }></i>
			}
		</div>
		<div class="flex-1 min-w-0">
			if addon.Enabled {
				<a
					href={ templ.SafeURL(pluginURL(cc.Campaign.ID, addon.Slug)) }
					class="font-semibold text-fg hover:text-accent transition-colors"
				>
					{ addon.Name }
					<i class="fa-solid fa-arrow-right text-fg-muted text-xs ml-1"></i>
				</a>
			} else {
				<div class="font-semibold text-fg">{ addon.Name }</div>
			}
			<p class="text-xs text-fg-muted mt-0.5">{ addon.Description }</p>
		</div>
		// Toggle button for owners; "Coming Soon" badge for uninstalled addons.
		if isOwner {
			if addon.Installed {
				<form
					method="POST"
					hx-put={ fmt.Sprintf("/campaigns/%s/addons/%s/toggle", cc.Campaign.ID, strconv.Itoa(addon.AddonID)) }
					class="shrink-0"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="redirect_to" value="plugins"/>
					if addon.Enabled {
						<input type="hidden" name="action" value="disable"/>
						<button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 hover:bg-emerald-200 dark:hover:bg-emerald-900/50 transition-colors" title="Click to disable">
							<i class="fa-solid fa-check text-[10px]"></i>
							Enabled
						</button>
					} else {
						<input type="hidden" name="action" value="enable"/>
						<button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-surface-alt text-fg-muted border border-edge hover:bg-accent/10 hover:text-accent transition-colors" title="Click to enable">
							<i class="fa-solid fa-plus text-[10px] word-ic"></i>
							Enable
						</button>
					}
				</form>
			} else {
				<span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-surface-alt text-fg-muted border border-edge cursor-default shrink-0">
					<i class="fa-solid fa-clock text-[10px]"></i>
					Coming Soon
				</span>
			}
		}
	</div>
}

// hasEnabled checks if any addon in the list is enabled.
func hasEnabled(addons []PluginHubAddon) bool {
	for _, a := range addons {
		if a.Enabled {
			return true
		}
	}
	return false
}

// hasDisabled checks if any addon in the list is disabled.
func hasDisabled(addons []PluginHubAddon) bool {
	for _, a := range addons {
		if !a.Enabled {
			return true
		}
	}
	return false
}

// handoverCard is the owner's "If you're away" choice: how long they can go
// unseen before a site admin may give the campaign to another member.
templ handoverCard(cc *CampaignContext) {
	<div
		class="card p-6"
		x-data={ fmt.Sprintf(`{
			months: %d,
			saving: false,
			saved: false,
			error: '',
			async save(m) {
				var prev = this.months;
				this.months = m; this.saving = true; this.saved = false; this.error = '';
				const res = await Chronicle.apiFetch('/campaigns/%s/handover-setting', { method: 'PUT', body: { months: m } });
				this.saving = false;
				if (res.ok) { this.saved = true; setTimeout(() => { this.saved = false; }, 3000); }
				else { this.months = prev; this.error = 'That choice could not be saved. Try again.'; }
			}
		}`, cc.Campaign.ParseSettings().HandoverAfterMonths, cc.Campaign.ID) }
	>
		<h2 class="text-lg font-semibold text-fg mb-1">If you're away</h2>
		<p class="text-sm text-fg-secondary mb-4">
			If you stop using Chronicle for this long (the site or Foundry sync), a site admin may make another member the owner, so the table can keep playing. You'd stay in the campaign as Co-{ layouts.GMTerm(ctx) } and get an email.
		</p>
		<div class="inline-flex flex-wrap border border-edge rounded-lg overflow-hidden bg-surface" role="group" aria-label="If you're away">
			for _, m := range HandoverChoices {
				<button
					type="button"
					class="px-3 py-1.5 text-sm font-medium text-fg-body"
					x-bind:class={ fmt.Sprintf("months === %d ? 'bg-accent text-white' : 'hover:bg-surface-alt'", m) }
					x-bind:aria-pressed={ fmt.Sprintf("(months === %d).toString()", m) }
					@click={ fmt.Sprintf("save(%d)", m) }
				>{ handoverChoiceLabel(m) }</button>
			}
		</div>
		<p class="text-xs mt-3 min-h-4" aria-live="polite">
			<span x-show="saving" class="text-fg-muted">Saving...</span>
			<span x-show="saved" x-transition class="text-green-600">Saved</span>
			<span x-show="error" class="text-red-500" x-text="error"></span>
		</p>
	</div>
}

// handoverChoiceLabel names one "If you're away" choice.
func handoverChoiceLabel(months int) string {
	switch months {
	case 0:
		return "Never"
	case 12:
		return "1 year"
	default:
		return fmt.Sprintf("%d months", months)
	}
}
