// campaign_card.templ renders a single campaign card for the campaign list.

package campaigns

import (
	"fmt"
	"time"

	"github.com/keyxmakerx/chronicle/internal/timeutil"
)

// CampaignCard renders a single campaign card for the grid. The three dots
// sit beside the card's link, not inside it, because a button cannot live in
// a link. owned is true for a campaign the viewer owns, whose menu offers
// Hand over instead of Leave.
templ CampaignCard(campaign *Campaign, owned bool) {
	<div class="relative" data-campaign-card={ campaign.ID }>
	<a
		href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s", campaign.ID)) }
		class="card p-0 overflow-hidden hover:shadow-md hover:-translate-y-0.5 block group"
	>
		<!-- Accent bar -->
		<div class="h-1.5 bg-gradient-to-r from-accent to-indigo-400"></div>

		<div class="p-5">
			<div class="flex items-start gap-3">
				<div class="w-10 h-10 rounded-lg bg-accent/10 dark:bg-accent/20 flex items-center justify-center shrink-0">
					<i class="fa-solid fa-book-open text-accent"></i>
				</div>
				<div class="min-w-0 flex-1 pr-12">
					<h3 class="text-base font-semibold text-fg truncate group-hover:text-accent transition-colors">{ campaign.Name }</h3>
					if campaign.Description != nil && *campaign.Description != "" {
						<p class="text-sm text-fg-secondary line-clamp-2 mt-1">{ *campaign.Description }</p>
					}
				</div>
			</div>

			<div class="mt-4 flex items-center text-xs text-fg-secondary">
				<time datetime={ campaign.UpdatedAt.UTC().Format(time.RFC3339) } title={ timeutil.FixedDate(campaign.UpdatedAt, timeutil.DateWithTime) } data-date-title>{ timeutil.EditedAgo(campaign.UpdatedAt, time.Now()) }</time>
				if campaign.IsPublic {
					<span class="ml-auto inline-flex items-center gap-1 text-green-600 dark:text-green-400">
						<i class="fa-solid fa-globe text-[10px]"></i>
						Public
					</span>
				}
			</div>
		</div>
	</a>
	<div class="absolute top-3 right-2">
		<button
			type="button"
			class="cl-dots btn-ghost"
			aria-haspopup="menu"
			aria-expanded="false"
			aria-label={ "Actions for " + campaign.Name }
			title="More"
			onclick={ leaveCall("toggle") }
		><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></button>
		<div class="ph-more-menu cl-menu" role="menu" data-leave-menu data-kit-open hidden>
			<a role="menuitem" class="ph-item" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s", campaign.ID)) }>Open</a>
			if owned {
				<a role="menuitem" class="ph-item" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/transfer", campaign.ID)) }>Hand over…</a>
			} else {
				<button type="button" role="menuitem" class="ph-item" data-box={ leaveBoxID(campaign.ID) } onclick={ leaveCall("ask") }>Leave campaign…</button>
			}
		</div>
	</div>
	</div>
}
