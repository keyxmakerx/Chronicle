package campaigns

import "github.com/keyxmakerx/chronicle/internal/templates/layouts"

// lookTab is the Customize page's look editor: a live example site in the
// middle, the settings of the open part in a panel that slides out on the
// right, floating tools at the foot, and one Save for everything. The
// controls and the example site are built by customize_look.js from
// data-state; this markup is the frame they fill. Inside Customize's frame
// its Save is the frame's save bar (customize_shell.js).
templ lookTab(cc *CampaignContext, csrfToken, state string) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/customize.css") }/>
	@templ.Raw("<style>" + layouts.CustomizeFontsCSS() + "</style>")
	<div
		class="czp"
		data-widget="customize-look"
		data-campaign-id={ cc.Campaign.ID }
		data-csrf={ csrfToken }
		data-state={ state }
		data-sky-calendar={ layouts.GetSkyCalendarID(ctx) }
	>
		<div class="cz lk-cz" id="cz">
			<div class="cpe cpe-editor lk-ws" id="lk-ws">
				<div class="lk-work" id="pv-col">
					<div class="pvw">
						<div class="pv-frame pv" id="preview" data-zoom="site"></div>
						<div class="pv-cap" id="pv-cap"></div>
					</div>
					<span class="lk-held-tag" id="lk-held" hidden>Saved look</span>
				</div>
				<aside class="cpe-insp lk-panel" id="lk-panel" aria-label="Settings for the part you pressed" inert>
					<div class="cpe-insp-tabs lk-ph">
						<button type="button" class="cpe-handle" id="lk-handle" tabindex="-1" aria-hidden="true"></button>
						<div class="cpe-insp-head">
							<p class="lk-ptitle" id="lk-ptitle"></p>
							<div class="lk-rooms" id="tl" role="tablist" aria-orientation="horizontal" aria-label="Customize rooms"></div>
							<button type="button" class="cpe-insp-x lk-x" id="lk-x" aria-label="Done, put the settings away" title="Done (Esc)">
								<i class="fa-solid fa-xmark" aria-hidden="true"></i>
								<span class="lk-x-t">Done</span>
							</button>
						</div>
					</div>
					<div class="cpe-insp-body lk-pb" id="lk-pb">
						<div class="cz-panels" id="panels"></div>
						<div class="lk-zoomw" id="lk-zoom" hidden>
							<p class="grp-l" id="lk-zoom-l">Show in the example</p>
							<div class="zseg lk-zoom" role="radiogroup" aria-labelledby="lk-zoom-l">
								<label><input type="radio" name="zoom" value="site" id="z-site" checked/><span>Whole site</span></label>
								<label><input type="radio" name="zoom" value="pieces" id="z-pieces"/><span>Pieces</span></label>
								<label><input type="radio" name="zoom" value="type" id="z-type"/><span>Type</span></label>
							</div>
						</div>
						<section class="lk-looks" id="lk-looks" aria-labelledby="looks-h" hidden>
							<div class="looks-h">
								<h2 id="looks-h">Start from a look</h2>
								<p>One click sets colours, type, buttons, depth, motion, the header and the menu highlight together. Your name, logo, words and pictures stay as they are. Nothing changes for your players until you save.</p>
							</div>
							<div class="lk-row" id="lk-row" role="radiogroup" aria-labelledby="looks-h"></div>
						</section>
						<p class="tabs-foot"><span class="chg-k"></span>Changed since your last save.</p>
					</div>
				</aside>
				<div class="cpe-dock-wrap">
					<div class="cpe-dock" id="lk-dock" role="toolbar" aria-label="Look tools">
						<button type="button" class="cpe-dk cpe-dk-main" id="lk-open" aria-expanded="false" aria-controls="lk-panel">Settings</button>
						<button type="button" class="cpe-dk" id="lk-looks-btn" aria-pressed="false" aria-controls="lk-panel">Looks</button>
						<span class="cpe-dk-sep" aria-hidden="true"></span>
						<div class="lk-dg" role="radiogroup" aria-label="Preview in light or dark mode">
							<label class="cpe-dk"><input class="sr" type="radio" name="ptheme" value="light" id="pt-light" checked/><span>Light</span></label>
							<label class="cpe-dk"><input class="sr" type="radio" name="ptheme" value="dark" id="pt-dark"/><span>Dark</span></label>
						</div>
						<span class="cpe-dk-sep" aria-hidden="true"></span>
						<div class="lk-dg" role="radiogroup" aria-label="Page shown in the example">
							<label class="cpe-dk"><input class="sr" type="radio" name="dpage" value="dash" id="dp-dash" checked/><span>Home</span></label>
							<label class="cpe-dk"><input class="sr" type="radio" name="dpage" value="city" id="dp-city"/><span>City page</span></label>
							<label class="cpe-dk"><input class="sr" type="radio" name="dpage" value="sheet" id="dp-sheet"/><span>Character sheet</span></label>
						</div>
						<span class="cpe-dk-sep" aria-hidden="true"></span>
						<button type="button" class="cpe-dk" id="lk-hold" aria-pressed="false" title="Hold to see the look as it is saved. Release to come back to your draft.">Hold to see saved</button>
					</div>
				</div>
			</div>
			<div class="cz-save" id="save" role="region" aria-label="Save">
				<div class="sv-st"><span class="sv-dot" aria-hidden="true"></span><b id="sv-t" role="status" aria-live="polite">No unsaved changes</b><span id="sv-d"></span></div>
				<button type="button" class="czb czb-s" id="discard" disabled>Discard</button>
				<button type="button" class="czb czb-p" id="savebtn" disabled>Save changes</button>
			</div>
		</div>
		<div class="pop" id="pop" role="dialog" aria-labelledby="pop-t" hidden>
			<div class="pop-h"><span class="pop-sw" id="pop-sw"></span><div><b id="pop-t">Custom colour</b><span id="pop-hexl">#6366F1</span></div></div>
			<label class="pop-f" for="pop-hue">Hue<input class="rng" type="range" id="pop-hue" min="0" max="359" step="1" value="270"/></label>
			<label class="pop-f" for="pop-tone">Tone<input class="rng" type="range" id="pop-tone" min="0" max="100" step="1" value="50"/><span class="ends"><span>Soft</span><span>Deep</span></span></label>
			<div class="pop-f">
				<label for="pop-hex">Exact colour</label>
				<div class="pop-hex"><input class="inp" id="pop-hex" type="text" maxlength="7" spellcheck="false" autocomplete="off" placeholder="#5B6BE0"/><button type="button" class="czb czb-s czb-sm" id="pop-use">Use</button></div>
			</div>
			<p class="note" id="pop-note" hidden><svg class="i" aria-hidden="true"><use href="#cz-i-info"></use></svg><span></span></p>
			<div class="row-h"><span class="hint">Every colour here stays easy on the eyes.</span><button type="button" class="czb czb-p czb-sm" id="pop-done">Done</button></div>
		</div>
		<div class="hc" id="hc" role="tooltip" hidden></div>
		<div class="toast" id="toast"><span id="toast-t" role="status" aria-live="polite"></span><button type="button" id="toast-undo" hidden>Undo</button></div>
		<input type="file" id="file" accept="image/*" hidden/>
	</div>
}
