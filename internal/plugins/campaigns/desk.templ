// desk.templ draws the owner's desk: Manage's home page, one page of plain
// sentences in groups. Every control inside it carries its own inline handler
// (deskBlankCall), built Go-side, because the page arrives by a boosted swap
// where a script tag or a delegated listener may never run. The behaviour
// itself is static/js/desk_blank.js, which the handler loads on first use so
// the page stays inside the layout's script budget.

package campaigns

import "fmt"
import "github.com/keyxmakerx/chronicle/internal/templates/layouts"

// DeskPage renders the desk inside the shared Manage frame.
templ DeskPage(cc *CampaignContext, d *Desk) {
	@layouts.App(d.CampaignName + " — Manage") {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/manage_desk.css") }/>
		@layouts.ManageFrame(layouts.ManageFrameData{Title: "Manage", Home: true, Intro: "How this campaign is set up, in one place."}) {
			<div class="desk" data-desk data-campaign={ cc.Campaign.ID }>
				if len(d.Needs) > 0 {
					<section class="desk-need" aria-labelledby="desk-g-needs" data-desk-needs>
						<h2 class="desk-lab" id="desk-g-needs">Needs you</h2>
						<ul class="desk-lines">
							for _, n := range d.Needs {
								<li class="desk-ln">
									<div class="desk-row">
										<p class="desk-s">
											<i class={ "desk-dot", templ.KV("warn", n.State == "warn") } aria-hidden="true"></i>
											if n.State == "warn" {
												<span class="sr-only">Warning: </span>
											}
											<b>{ n.Lead }</b>{ n.Rest }
										</p>
										<span class="desk-acts">
											<a class="desk-q" href={ templ.SafeURL(n.URL) }>{ n.Action }</a>
										</span>
									</div>
								</li>
							}
						</ul>
					</section>
				}
				for i, g := range d.Groups {
					<section class="desk-grp" aria-labelledby={ fmt.Sprintf("desk-g-%d", i) }>
						<h2 class="desk-lab" id={ fmt.Sprintf("desk-g-%d", i) }>{ g.Name }</h2>
						<div class="desk-lines">
							for _, l := range g.Lines {
								@deskLine(l)
							}
						</div>
					</section>
				}
			</div>
		}
	}
}

// deskLine is one sentence and the quiet words that open its tool. The acts
// span is always drawn, even empty, because it is where a blank's "Saved"
// tick appears. A line that unfolds carries one chevron button, the only
// control that toggles it from the keyboard; pressing the row itself does the
// same for a pointer.
templ deskLine(l DeskLine) {
	<div class="desk-ln" id={ "line-" + l.ID } data-line={ l.ID } data-fold?={ l.Fold }>
		if l.Fold {
			<div class="desk-row" onclick={ deskFoldRowCall() }>
				@deskRowBody(l)
			</div>
		} else {
			<div class="desk-row">
				@deskRowBody(l)
			</div>
		}
		if l.Fold {
			<div class="desk-fold" id={ "desk-fold-" + l.ID } role="region" aria-label={ deskFoldTitle(l.ID) } hidden data-url={ deskFoldURL(ctx, l.ID) } onkeydown={ deskFoldKey() }></div>
		}
	</div>
}

// deskRowBody is what sits in a line's row: the sentence, the quiet words, on
// a line that unfolds its chevron and, on a line that opens a tool, the pin
// that puts that tool in the owner's sidebar.
templ deskRowBody(l DeskLine) {
	@deskSentence(l)
	<span class="desk-acts">
		for _, a := range l.Acts {
			if a.Carry {
				<a class="desk-q" href={ templ.SafeURL(a.Href) } data-carry onclick={ deskCarryCall() }>{ a.Label }</a>
			} else {
				<a class={ "desk-q", templ.KV("bad", a.Danger) } href={ templ.SafeURL(a.Href) }>{ a.Label }</a>
			}
		}
	</span>
	if l.Fold {
		<button
			type="button"
			class="desk-chev"
			aria-expanded="false"
			aria-controls={ "desk-fold-" + l.ID }
			aria-label={ "Unfold " + deskFoldTitle(l.ID) }
			data-title={ deskFoldTitle(l.ID) }
			onclick={ deskFoldToggleCall() }
			onkeydown={ deskFoldKey() }
		>
			<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		</button>
	}
	{{ pinKey, pinName := layouts.ManageToolOfLine(l.ID) }}
	@layouts.ManagePin(pinKey, pinName)
}

// deskSentence is a line's sentence alone, also served by itself so a change
// made inside the line's fold can word it again where it stands.
templ deskSentence(l DeskLine) {
	<p class="desk-s">
		if l.State != "" {
			<i class={ "desk-dot", templ.KV("ok", l.State == "ok"), templ.KV("warn", l.State == "warn") } aria-hidden="true"></i>
			if l.State == "warn" {
				<span class="sr-only">Warning: </span>
			}
		}
		for _, n := range deskNodes(l.Parts) {
			@deskNode(n)
		}
	</p>
}

// manageSentence is a desk line's sentence as the first line of the Manage page
// it opens, under the title. The desk's own sentence and this one are the same
// words from the same service; the move from the desk carries one onto the
// other, and the page opened by address starts the same way.
templ manageSentence(id string, l DeskLine) {
	<div class="manage-sentence" data-manage-sentence data-line={ id }>
		@deskSentence(l)
	</div>
}

// DeskFoldBody is what a line unfolds into, served as a fragment when the line
// is first opened. Every control has its own inline handler, built Go-side,
// because the fragment arrives by innerHTML, where a script tag never runs.
templ DeskFoldBody(cc *CampaignContext, id string, f *DeskFold) {
	<div class="desk-fold-in" data-fold-line={ id } data-campaign={ cc.Campaign.ID }>
		if f.Note != "" {
			<p class="desk-note">{ f.Note }</p>
		}
		if f.Fallback {
			if f.FullHref != "" {
				<a class="desk-q" href={ templ.SafeURL(f.FullHref) }>{ f.FullLabel }</a>
			}
		} else {
			for _, r := range f.Rows {
				<div class="desk-fr">
					if r.Initial != "" {
						<span class="desk-av" aria-hidden="true">{ r.Initial }</span>
					}
					<span class="desk-ft">
						if r.Lead != "" {
							<b>{ r.Lead }</b>
						}
						if r.Text != "" {
							{ r.Text }
						}
					</span>
					if r.Meta != "" {
						<span class="desk-m">{ r.Meta }</span>
					}
					<span class="desk-fill"></span>
					if r.Blank != nil {
						@deskBlank(r.Blank, "")
					}
					if r.Act != nil {
						<button
							type="button"
							class="desk-q desk-act"
							data-url={ r.Act.URL }
							data-method={ r.Act.Method }
							data-busy={ r.Act.Busy }
							onclick={ deskFoldActCall() }
						>{ r.Act.Label }</button>
					}
				</div>
			}
			if f.More > 0 {
				<a class="desk-q desk-more" href={ templ.SafeURL(f.MoreHref) }>{ deskMore(f.More) }</a>
			}
			if f.Invite != nil {
				<div class="desk-fr desk-inv">
					<input
						type="email"
						class="desk-in"
						data-desk-invite-email
						placeholder="Email to invite"
						aria-label="Email to invite"
						autocomplete="off"
						onkeydown={ deskFoldInviteKey() }
					/>
					<span>as a</span>
					@deskBlank(deskInviteRole(f.Invite), "")
					<button
						type="button"
						class="btn btn-primary desk-send"
						data-url={ f.Invite.URL }
						data-busy="Sending"
						onclick={ deskFoldInviteCall() }
					>Send invite</button>
				</div>
			}
		}
		<p class="desk-st" role="status" aria-live="polite" data-desk-status></p>
	</div>
}

// deskNode draws one piece of a sentence. A blank and the punctuation that
// follows it sit in one no-wrap span so a full stop is never left alone at
// the start of a line.
templ deskNode(n deskNodeView) {
	switch n.Kind {
		case deskNodeBold:
			<b>{ n.Text }</b>
		case deskNodeGM:
			{ layouts.GMTerm(ctx) }
		case deskNodeSwatch:
			<i class="desk-sw" aria-hidden="true"></i>
		case deskNodeAfter:
			<span data-desk-after>{ n.Text }</span>
		case deskNodeBlank:
			@deskBlank(n.Blank, n.Glue)
		default:
			{ n.Text }
	}
}

// deskBlank is the dashed word. A choice opens a small menu and saves at
// once; the name turns into a field where it stands. Off while the campaign
// is archived, with the reason on hover.
templ deskBlank(b *DeskBlank, glue string) {
	<span
		role="button"
		tabindex={ deskTabindex(b) }
		class="desk-b"
		data-desk-blank={ string(b.Kind) }
		data-id={ b.ID }
		data-label={ b.Label }
		data-url={ b.URL }
		data-method={ b.Method }
		data-field={ b.Field }
		data-bool?={ b.Bool }
		data-value={ b.Value }
		data-options={ deskOptionsJSON(b.Options) }
		aria-haspopup={ deskHasPopup(b) }
		aria-expanded="false"
		aria-disabled={ deskDisabled(b) }
		aria-label={ b.Label + ": " + b.Shown }
		title={ b.Off }
		onclick={ deskBlankCall() }
		onkeydown={ deskBlankKey() }
	>{ b.Shown }</span>{ deskJoin(glue) }
}
