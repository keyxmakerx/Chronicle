// desk.templ draws Campaign settings' Overview (the board), the rows the
// Campaign tab lists, and the figures a Manage tool page shows beside its
// title. A row is a short name with its value right beside it, and a value is
// a control that changes where it stands, a figure that opens its page, or a
// quiet word.

package campaigns


import "github.com/keyxmakerx/chronicle/internal/templates/layouts"

// deskPageBody draws the Overview inside the shared settings frame (the
// banner and the tabs are the frame's): the board of tiles. A tile that flips
// or a chip that switches carries its own inline handler (boardCall), built
// Go-side, because the page arrives by a boosted swap where a script tag or a
// delegated listener may never run; the behaviour is
// static/js/settings_board.js, loaded on first use.
templ deskPageBody(cc *CampaignContext, d *Desk) {
	@layouts.App(d.CampaignName + " — Campaign settings") {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/manage_desk.css") }/>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/settings_board.css") }/>
		@layouts.ManageFrame(layouts.ManageFrameData{Title: "Campaign settings", Home: true}) {
			<div class="desk sb" data-desk data-settings-board data-campaign={ cc.Campaign.ID }>
				<p class="sr-only" role="status" data-sb-status></p>
				@deskBoard(cc, d.Board)
			</div>
		}
	}
}

// deskRow is one setting. Its id keeps links to "#line-<id>" landing on it.
// The reason a value is off sits under the row: read aloud by the values that
// point at it, and drawn on a phone, where there is no hover to show it.
templ deskRow(l DeskLine) {
	{{ why := deskWhy(l) }}
	<li class="set-ln" id={ "line-" + l.ID } data-line={ l.ID }>
		<span class="set-name" aria-hidden="true">{ l.Name }</span>
		<span class="set-vals">
			for _, v := range l.Values {
				@deskValue(l, v)
			}
			// The Saved tick lands here (desk_blank.js).
			<span class="desk-acts"></span>
		</span>
		if why != "" {
			<p class="set-why" id={ "why-" + l.ID } hidden?={ !deskAnyOff(l) }>{ why }</p>
		}
	</li>
}

// deskValue is what stands beside a row's name: a blank, a quiet word that
// posts the view-as form, or a link.
templ deskValue(l DeskLine, v DeskValue) {
	switch {
		case v.Blank != nil:
			@deskBlank(l, v.Blank)
		case v.View != nil:
			// A form, not a link: opening the view changes what the session sees.
			<form class="set-form" method="POST" action={ templ.SafeURL("/campaigns/" + layouts.GetCampaignID(ctx) + "/view-as") }>
				<input type="hidden" name="csrf_token" value={ layouts.GetCSRFToken(ctx) }/>
				<input type="hidden" name="as" value={ v.View.As }/>
				<input type="hidden" name="next" value={ v.View.Next }/>
				<button
					type="submit"
					class="set-v set-word"
					aria-label={ deskValueLabel(l.Name, v) }
					aria-disabled={ deskOffAttr(v) }
					title={ v.Off }
					if v.Off != "" {
						aria-describedby={ "why-" + l.ID }
					}
					data-needs-public?={ v.NeedsPublic }
					data-off={ deskGuestOff }
					onclick={ deskOffGuard() }
				>
					@deskValueFace(v)
				</button>
			</form>
		case v.Href != "":
			<a class={ "set-v", templ.KV("set-word", v.Word), templ.KV("set-danger", v.Danger) } href={ templ.SafeURL(v.Href) } aria-label={ deskValueLabel(l.Name, v) }>
				@deskValueFace(v)
			</a>
	}
}

// deskValueFace is what sits in a value: the state dot or the colour swatch,
// the figure or word, its muted second part and, for a figure that opens a
// page, the small chevron.
templ deskValueFace(v DeskValue) {
	if v.State != "" {
		<i class={ "desk-dot", templ.KV("ok", v.State == "ok"), templ.KV("warn", v.State == "warn") } aria-hidden="true"></i>
	}
	if v.Swatch {
		<i class="desk-sw" aria-hidden="true"></i>
	}
	if v.Text != "" {
		<span class="set-t">{ v.Text }</span>
	}
	if v.Sub != "" || v.SubSwatch {
		<span class={ "set-sub", templ.KV("set-joined", v.Joined) }>
			if v.SubSwatch {
				<i class="desk-sw" aria-hidden="true"></i>
			}
			{ v.Sub }
		</span>
	}
	if v.Href != "" && !v.Word {
		<svg class="set-chev" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
	}
}

// deskBlank is a value changed where it stands. A choice opens a small menu and
// saves at once; a name turns into a one-line field and a description into a
// field of a few lines, in place. Off while the campaign is archived, with the
// reason on hover and for the screen reader. A span with a button role, not a
// button: a real button is always an atomic box and cannot wrap across lines
// like the words around it.
templ deskBlank(l DeskLine, b *DeskBlank) {
	<span
		role="button"
		tabindex={ deskTabindex(b) }
		class={ "desk-b", "set-v", templ.KV("is-empty", b.Empty), templ.KV("set-wide", b.Kind == DeskBlankText) }
		data-desk-blank={ string(b.Kind) }
		data-id={ b.ID }
		data-label={ b.Label }
		data-url={ b.URL }
		data-method={ b.Method }
		data-field={ b.Field }
		data-bool?={ b.Bool }
		data-maxlen={ deskMax(b) }
		data-value={ b.Value }
		data-options={ deskOptionsJSON(b.Options) }
		aria-haspopup={ deskHasPopup(b) }
		aria-expanded="false"
		aria-disabled={ deskDisabled(b) }
		aria-label={ deskBlankLabel(b) }
		title={ b.Off }
		if b.Off != "" {
			aria-describedby={ "why-" + l.ID }
		}
		onclick={ deskBlankCall() }
		onkeydown={ deskBlankKey() }
	>
		<span class="desk-t">{ b.Shown }</span>
		if b.Kind == DeskBlankChoice {
			<svg class="set-chev set-chev-down" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
		}
	</span>
}

// manageFigure is a tool page's figures beside its title: muted, joined by a
// middle dot, built from the same service the desk's rows use. The id stays
// put so a response that changes what it counts can swap it in place.
templ manageFigure(id string, f DeskFigure) {
	<span id="manage-figure" class="manage-fig" data-manage-figure data-line={ id }>
		@deskFigureBody(f)
	</span>
}

// manageFigureSwap redraws the figures in place from another response, so they
// never lag behind a change made on the page. A figure that can no longer be
// read swaps in an empty one rather than leaving a stale count.
templ manageFigureSwap(id string, f DeskFigure) {
	<span id="manage-figure" class="manage-fig" data-manage-figure data-line={ id } hx-swap-oob="true">
		@deskFigureBody(f)
	</span>
}

templ deskFigureBody(f DeskFigure) {
	if !f.Empty() {
		if f.State != "" {
			<i class={ "desk-dot", templ.KV("ok", f.State == "ok"), templ.KV("warn", f.State == "warn") } aria-hidden="true"></i>
			if f.State == "warn" {
				<span class="sr-only">Warning: </span>
			}
		}
		{ f.Text() }
	}
}
