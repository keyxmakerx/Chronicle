// give_dialog.templ renders the dialog that gives a character an item or a
// map. It is an HTMX fragment swapped into #armory-move-modal, the container
// the Move dialog uses; the form posts to the give route and closes the dialog
// itself (hx-on, inline like the onclick handlers), since the Armory gallery has no panel that reloads on armory-moved.
// Every handler is an inline expression built in Go so it still runs after the
// fragment is swapped in.
package armory

import (
	"fmt"
	"strings"
)

// GiveDialog opens from a character page (the character is fixed; pick an item
// or a map) or from an item card (the item is fixed; pick a character).
templ GiveDialog(v *GiveDialogView, csrfToken string) {
	<div
		class="fixed inset-0 z-50 flex items-start justify-center p-4 pt-16 bg-black/50 overflow-y-auto"
		role="dialog"
		aria-modal="true"
		aria-labelledby="armory-give-title"
		data-give-root
		onkeydown={ closeMoveDialogOnKey() }
	>
		<div class="card w-full max-w-md p-5">
			if v.Character != nil {
				<h2 id="armory-give-title" class="text-lg font-semibold text-fg mb-3">Give to { v.Character.Name }</h2>
				<div class="flex gap-1 mb-4 border-b border-border" role="tablist">
					<button
						type="button"
						role="tab"
						aria-selected="true"
						data-give-tab="items"
						class="px-3 py-1.5 text-sm font-medium border-b-2 border-accent text-fg"
						onclick={ giveTabOnClick("items") }
					>From the Armory</button>
					<button
						type="button"
						role="tab"
						aria-selected="false"
						data-give-tab="map"
						class="px-3 py-1.5 text-sm font-medium border-b-2 border-transparent text-fg-muted"
						onclick={ giveTabOnClick("map") }
					>A map</button>
				</div>
				<div data-give-panel="items">
					if len(v.Items) == 0 {
						<p class="text-sm text-fg-muted mb-4">There are no items in the Armory yet.</p>
						@giveCancelRow()
					} else {
						<form
							hx-post={ giveURL(v.CampaignID) }
							hx-swap="none"
							hx-disabled-elt="find button[type='submit']"
							hx-on::after-request="if(event.detail.successful){var m=document.getElementById('armory-move-modal');if(m){m.innerHTML='';}}"
							class="space-y-4"
						>
							<input type="hidden" name="_csrf" value={ csrfToken }/>
							<input type="hidden" name="character_id" value={ v.Character.ID }/>
							@giveSearch("Search items")
							@giveRadioList("item_id", v.Items, "")
							<div>
								<label for="armory-give-qty" class="block text-xs font-medium text-fg-body mb-1">How many</label>
								<input id="armory-give-qty" type="number" name="quantity" min="1" value="1" required class="input w-full text-sm"/>
							</div>
							@giveSubmitRow()
						</form>
					}
				</div>
				<div data-give-panel="map" hidden>
					if len(v.Maps) == 0 {
						<p class="text-sm text-fg-muted mb-4">This campaign has no maps yet.</p>
						@giveCancelRow()
					} else {
						<form
							hx-post={ giveURL(v.CampaignID) }
							hx-swap="none"
							hx-disabled-elt="find button[type='submit']"
							hx-on::after-request="if(event.detail.successful){var m=document.getElementById('armory-move-modal');if(m){m.innerHTML='';}}"
							class="space-y-4"
						>
							<input type="hidden" name="_csrf" value={ csrfToken }/>
							<input type="hidden" name="character_id" value={ v.Character.ID }/>
							@giveRadioList("map_id", v.Maps, v.Character.Name)
							<p data-give-hint class="text-xs text-fg-muted">Pick a map to give.</p>
							@giveSubmitRow()
						</form>
					}
				</div>
			} else if v.Item != nil {
				<h2 id="armory-give-title" class="text-lg font-semibold text-fg mb-3">Give { v.Item.Name }</h2>
				if len(v.Characters) == 0 {
					<p class="text-sm text-fg-muted mb-4">There are no characters to give this to yet.</p>
					@giveCancelRow()
				} else {
					<form
						hx-post={ giveURL(v.CampaignID) }
						hx-swap="none"
						hx-disabled-elt="find button[type='submit']"
						hx-on::after-request="if(event.detail.successful){var m=document.getElementById('armory-move-modal');if(m){m.innerHTML='';}}"
						class="space-y-4"
					>
						<input type="hidden" name="_csrf" value={ csrfToken }/>
						<input type="hidden" name="item_id" value={ v.Item.ID }/>
						@giveSearch("Search characters")
						@giveRadioList("character_id", v.Characters, "")
						<div>
							<label for="armory-give-qty" class="block text-xs font-medium text-fg-body mb-1">How many</label>
							<input id="armory-give-qty" type="number" name="quantity" min="1" value="1" required class="input w-full text-sm"/>
						</div>
						@giveSubmitRow()
					</form>
				}
			}
		</div>
	</div>
}

// giveSearch filters the radio list under it as the GM types.
templ giveSearch(label string) {
	<input
		type="search"
		autocomplete="off"
		autofocus
		placeholder={ label }
		aria-label={ label }
		class="input w-full text-sm"
		oninput={ giveFilterOnInput() }
	/>
}

// giveRadioList lists the choices as radios. For a map, each radio carries the
// sentence that says what the character will get, shown under the list. A
// nonempty recipient marks the list as maps.
templ giveRadioList(name string, list []NamedRef, recipient string) {
	<div class="max-h-60 overflow-y-auto border border-border rounded divide-y divide-border" role="radiogroup">
		for _, it := range list {
			<label
				data-give-row
				data-name={ strings.ToLower(it.Name) }
				class="flex items-center gap-2 px-3 py-1.5 text-sm text-fg cursor-pointer hover:bg-surface-alt"
			>
				if recipient != "" {
					<input
						type="radio"
						name={ name }
						value={ it.ID }
						required
						data-hint={ fmt.Sprintf("%s gets an item called \"%s\". Opening it shows the map.", recipient, handoutName(it.Name)) }
						onchange={ giveHintOnChange() }
					/>
				} else {
					<input type="radio" name={ name } value={ it.ID } required/>
				}
				<span class="truncate">{ it.Name }</span>
			</label>
		}
	</div>
}

templ giveSubmitRow() {
	<div class="flex justify-end gap-2">
		<button type="button" class="btn-secondary text-sm" onclick={ closeMoveDialogOnClick() }>Cancel</button>
		<button type="submit" class="btn-primary text-sm">Give</button>
	</div>
}

templ giveCancelRow() {
	<div class="flex justify-end">
		<button type="button" class="btn-secondary text-sm" onclick={ closeMoveDialogOnClick() }>Close</button>
	</div>
}
