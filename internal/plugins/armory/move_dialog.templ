// move_dialog.templ renders the box that moves one item or some money. It
// opens in place, folded out under the line it belongs to, like the Give and
// Share boxes: Chronicle.GiveBox (static/js/widgets/give_box.js) folds it,
// keeps an unsent choice from being lost, posts it to the moves route and
// shows the result. Every control calls in through an inline handler built in
// Go so it still works after the fragment is swapped in.
package armory

import "fmt"

// MoveDialog asks where a holding should go and how much of it. The line under
// the choices says plainly whether the move happens now or waits for the GM,
// and the button reads "Ask the GM" when it waits.
templ MoveDialog(v *MoveDialogView, csrfToken string) {
	<div
		class="ag-box"
		data-box
		data-move-box
		data-post={ movesURL(v.CampaignID) }
		data-kind={ v.Kind }
		data-item-id={ v.ItemID }
		data-from-kind={ v.From.Kind }
		data-from-id={ v.From.ID }
		tabindex="-1"
		style="margin-top:8px"
	>
		<div class="ag-head">
			<h4>
				if v.Kind == "item" {
					Move { v.ItemName }
				} else {
					Move money
				}
				<span class="ag-lbl" style="font-weight:400"> from { v.FromName }</span>
			</h4>
			@giveX()
		</div>
		<div class="ag-body">
			if (v.Kind == "item" && v.Max < 1) || (v.Kind == "money" && v.MaxMoney < 1) {
				<div class="ag-hint">
					<i class="fa-solid fa-circle-info"></i>
					<span>
						if v.Kind == "item" {
							There is none of this left to move.
						} else {
							There is no money to move.
						}
					</span>
				</div>
				<div class="ag-foot">
					<span class="ag-sp"></span>
					<button type="button" class="btn-secondary btn-sm" data-close onclick={ giveBoxCall("cancel") }>Close</button>
				</div>
			} else if len(v.Destinations) == 0 {
				<div class="ag-hint"><i class="fa-solid fa-circle-info"></i><span>There is nowhere to move this to yet.</span></div>
				<div class="ag-foot">
					<span class="ag-sp"></span>
					<button type="button" class="btn-secondary btn-sm" data-close onclick={ giveBoxCall("cancel") }>Close</button>
				</div>
			} else {
				<div class="ag-lbl" style="margin-bottom:4px">Where to</div>
				<div class="ag-list" role="radiogroup" aria-label="Where to" style="margin-top:0" data-list="to">
					@moveDestinationGroup(v, "Stashes")
					@moveDestinationGroup(v, "Characters")
				</div>
				if v.Kind == "item" {
					if v.Max > 1 {
						<div class="ag-foot">
							<span class="ag-qty">
								<span class="ag-lbl" id="ag-q-l">How many</span>
								<span class="ag-step">
									<button type="button" data-q="-1" aria-label="One fewer" onclick={ giveBoxCall("step") }><i class="fa-solid fa-minus"></i></button>
									<input id="ag-q" type="number" min="1" max={ fmt.Sprintf("%d", v.Max) } value="1" aria-labelledby="ag-q-l" oninput={ giveBoxCall("pick") } onkeydown={ moveEnter() }/>
									<button type="button" data-q="1" aria-label="One more" onclick={ giveBoxCall("step") }><i class="fa-solid fa-plus"></i></button>
								</span>
								<span class="ag-lbl">of { fmt.Sprintf("%d", v.Max) }</span>
							</span>
						</div>
					}
				} else {
					<div class="ag-foot">
						<span class="ag-qty">
							<label class="ag-lbl" for="ag-amount">How much</label>
							<input
								id="ag-amount"
								type="text"
								inputmode="decimal"
								autocomplete="off"
								class="input text-sm"
								style="width:120px"
								oninput={ giveBoxCall("pick") }
								onkeydown={ moveEnter() }
							/>
							<span class="ag-lbl">{ v.MaxMoney.String() } available</span>
						</span>
					</div>
				}
				<div class="ag-hint">
					<i class="fa-solid fa-circle-info"></i>
					if v.Immediate {
						<span>Downtime is open, so this happens now.</span>
					} else {
						<span>Not in downtime. Your GM has to approve this; the item stays with you until then.</span>
					}
				</div>
				<div class="ag-foot">
					<span class="ag-sp"></span>
					<button type="button" class="btn-secondary btn-sm" data-close onclick={ giveBoxCall("cancel") }>Cancel</button>
					<button
						type="button"
						class="btn-primary btn-sm"
						data-move-go
						data-label={ moveGoLabel(v.Immediate) }
						data-busy-label={ moveBusyLabel(v.Immediate) }
						disabled
						onclick={ giveBoxCall("move") }
					>{ moveGoLabel(v.Immediate) }</button>
				</div>
			}
		</div>
		<div class="ag-warn" role="alert">
			<i class="fa-solid fa-triangle-exclamation"></i>
			<span>Not moved yet. Move it, or throw the choice away.</span>
			<button type="button" data-discard onclick={ giveBoxCall("discard") }>Discard</button>
		</div>
		<div class="ag-warn" role="alert" data-err>
			<i class="fa-solid fa-triangle-exclamation"></i>
			<span></span>
		</div>
	</div>
}

// moveDestinationGroup renders one group of choices under its heading,
// skipping an empty group so the list has no bare heading.
templ moveDestinationGroup(v *MoveDialogView, group string) {
	if destinationsIn(v, group) > 0 {
		<div class="fx-dest-h">{ group }</div>
		for _, d := range v.Destinations {
			if d.Group == group {
				<label class="ag-row">
					<input type="radio" name="ag-pick" value={ destValue(d.Endpoint) } data-field="to" onchange={ giveBoxCall("pick") }/>
					<span class="ag-name">{ d.Label }</span>
				</label>
			}
		}
	}
}

func destinationsIn(v *MoveDialogView, group string) int {
	n := 0
	for _, d := range v.Destinations {
		if d.Group == group {
			n++
		}
	}
	return n
}
