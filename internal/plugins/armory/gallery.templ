// gallery.templ renders the Armory gallery page — a grid of item entities
// with search, sort, type filter, and tag filtering. Supports full page and
// HTMX fragment rendering.
package armory

import (
	"fmt"
	"net/url"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// ArmoryGalleryPage renders the full Armory gallery page with layout wrapper.
templ ArmoryGalleryPage(cc *campaigns.CampaignContext, cards []ItemCard, total int, opts ItemListOptions, itemTypes []ItemTypeInfo, instances []InventoryInstance, selected *InventoryInstance, tagOptions []ItemTagInfo, csrfToken string) {
	@layouts.App(cc.Campaign.Name + " - Armory") {
		@ArmoryGalleryContent(cc, cards, total, opts, itemTypes, instances, selected, tagOptions, csrfToken)
	}
}

// ArmoryGalleryContent renders the gallery content (HTMX partial target).
templ ArmoryGalleryContent(cc *campaigns.CampaignContext, cards []ItemCard, total int, opts ItemListOptions, itemTypes []ItemTypeInfo, instances []InventoryInstance, selected *InventoryInstance, tagOptions []ItemTagInfo, csrfToken string) {
	<div id="armory-gallery">
		@layouts.AppFrame() {
			@layouts.AppOpening(armoryOpening(ctx, total, opts, selected)) {
				<span>{ armoryCount(total) }</span>
				if selected != nil && selected.Description != nil && *selected.Description != "" {
					<span>{ *selected.Description }</span>
				}
			}
		<div class="flex flex-col sm:flex-row items-start sm:items-center justify-end gap-4 mb-6">
			<div class="flex items-center gap-3 flex-wrap">
				<!-- Instance selector -->
				if len(instances) > 0 {
					<select
						name="instance"
						class="input py-2 text-sm"
						hx-get={ fmt.Sprintf("/campaigns/%s/armory", cc.Campaign.ID) }
						hx-target="#armory-gallery"
						hx-swap="innerHTML"
						hx-include="[name='q'],[name='sort'],[name='tag'],[name='type']"
					>
						<option value="">All Items</option>
						for _, inst := range instances {
							<option value={ fmt.Sprintf("%d", inst.ID) } selected?={ opts.InstanceID == inst.ID }>
								{ inst.Name } ({ fmt.Sprintf("%d", inst.ItemCount) })
							</option>
						}
					</select>
				}

				// Stashes page (any signed-in member; the page decides what each sees).
				if cc.MemberRole >= campaigns.RolePlayer {
					<a
						href={ templ.SafeURL(stashesURL(cc.Campaign.ID)) }
						class="btn-secondary text-sm"
					>
						<i class="fa-solid fa-box-archive text-xs"></i>Stashes
					</a>
				}

				// Manage instances button (Scribe and Owner).
				if cc.MemberRole >= campaigns.RoleScribe {
					<button
						type="button"
						class="btn-secondary text-sm"
						hx-get={ fmt.Sprintf("/campaigns/%s/armory/instances/manage", cc.Campaign.ID) }
						hx-target="#instance-manage-panel"
						hx-swap="innerHTML"
						title="Manage inventory collections"
					>
						<i class="fa-solid fa-gear text-xs"></i>
					</button>
				}

				<!-- Search -->
				<div class="relative">
					<input
						type="text"
						name="q"
						placeholder="Search items..."
						value={ opts.Search }
						class="input pl-9 pr-3 py-2 w-56"
						hx-get={ fmt.Sprintf("/campaigns/%s/armory", cc.Campaign.ID) }
						hx-target="#armory-gallery"
						hx-swap="innerHTML"
						hx-trigger="input changed delay:300ms"
						hx-include="[name='sort'],[name='tag'],[name='type'],[name='instance']"
					/>
					<i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-fg-muted text-xs"></i>
				</div>

				<!-- Tag filter. Options come from the viewer's visible items only. -->
				if len(tagOptions) > 0 {
					<select
						name="tag"
						aria-label="Filter by tag"
						class="input py-2 text-sm"
						hx-get={ fmt.Sprintf("/campaigns/%s/armory", cc.Campaign.ID) }
						hx-target="#armory-gallery"
						hx-swap="innerHTML"
						hx-include="[name='q'],[name='type'],[name='sort'],[name='instance']"
					>
						<option value="">Tag: any</option>
						for _, t := range tagOptions {
							<option value={ t.Slug } selected?={ opts.Tag == t.Slug }>{ t.Name }</option>
						}
					</select>
				}

				<!-- Type filter -->
				if len(itemTypes) > 1 {
					<select
						name="type"
						class="input py-2 text-sm"
						hx-get={ fmt.Sprintf("/campaigns/%s/armory", cc.Campaign.ID) }
						hx-target="#armory-gallery"
						hx-swap="innerHTML"
						hx-include="[name='q'],[name='sort'],[name='tag'],[name='instance']"
					>
						<option value="">All types</option>
						for _, it := range itemTypes {
							<option value={ fmt.Sprintf("%d", it.ID) } selected?={ opts.TypeID == it.ID }>
								{ it.Name }
							</option>
						}
					</select>
				}

				<!-- Sort dropdown -->
				<select
					name="sort"
					aria-label="Sort by"
					class="input py-2 text-sm"
					hx-get={ fmt.Sprintf("/campaigns/%s/armory", cc.Campaign.ID) }
					hx-target="#armory-gallery"
					hx-swap="innerHTML"
					hx-include="[name='q'],[name='tag'],[name='type'],[name='instance']"
				>
					<option value="name" selected?={ opts.Sort == "name" }>Name</option>
					<option value="updated" selected?={ opts.Sort == "updated" }>Recently Updated</option>
					<option value="created" selected?={ opts.Sort == "created" }>Newest</option>
				</select>
			</div>
		</div>

		<!-- Instance management panel (loaded via HTMX) -->
		<div id="instance-manage-panel"></div>

		<!-- Item Grid. A bare armory is covered by the opening itself. -->
		if len(cards) == 0 {
			if armoryFiltered(opts) {
				<div class="text-center py-16">
					<h3 class="text-lg font-semibold text-fg-secondary mb-1">No items found</h3>
					<p class="text-sm text-fg-muted">Try adjusting your search or filters.</p>
				</div>
			}
		} else {
			<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
				for _, card := range cards {
					@ItemCardComponent(cc, &card)
				}
			</div>

			// Pagination.
			if total > opts.PerPage {
				@armoryPagination(cc, total, opts)
			}
		}
		}
	</div>
}

// armoryPageURL builds a gallery URL with all current filter params.
func armoryPageURL(campaignID string, page int, opts ItemListOptions) string {
	u := fmt.Sprintf("/campaigns/%s/armory?page=%d&sort=%s", campaignID, page, url.QueryEscape(opts.Sort))
	if opts.Search != "" {
		u += "&q=" + url.QueryEscape(opts.Search)
	}
	if opts.Tag != "" {
		u += "&tag=" + url.QueryEscape(opts.Tag)
	}
	if opts.TypeID > 0 {
		u += fmt.Sprintf("&type=%d", opts.TypeID)
	}
	if opts.InstanceID > 0 {
		u += fmt.Sprintf("&instance=%d", opts.InstanceID)
	}
	return u
}

// armoryPagination renders pagination controls for the Armory gallery.
templ armoryPagination(cc *campaigns.CampaignContext, total int, opts ItemListOptions) {
	<div class="flex items-center justify-center gap-2 mt-8">
		if opts.Page > 1 {
			<a
				href={ templ.SafeURL(armoryPageURL(cc.Campaign.ID, opts.Page-1, opts)) }
				class="px-3 py-1.5 text-sm rounded-md bg-surface-alt text-fg-secondary hover:text-fg transition-colors"
				hx-get={ armoryPageURL(cc.Campaign.ID, opts.Page-1, opts) }
				hx-target="#armory-gallery"
				hx-swap="innerHTML"
			>
				<i class="fa-solid fa-chevron-left text-xs mr-1"></i>Previous
			</a>
		}
		<span class="text-sm text-fg-muted px-3">
			{ fmt.Sprintf("Page %d of %d", opts.Page, (total+opts.PerPage-1)/opts.PerPage) }
		</span>
		if opts.Page*opts.PerPage < total {
			<a
				href={ templ.SafeURL(armoryPageURL(cc.Campaign.ID, opts.Page+1, opts)) }
				class="px-3 py-1.5 text-sm rounded-md bg-surface-alt text-fg-secondary hover:text-fg transition-colors"
				hx-get={ armoryPageURL(cc.Campaign.ID, opts.Page+1, opts) }
				hx-target="#armory-gallery"
				hx-swap="innerHTML"
			>
				Next<i class="fa-solid fa-chevron-right text-xs ml-1"></i>
			</a>
		}
	</div>
}
