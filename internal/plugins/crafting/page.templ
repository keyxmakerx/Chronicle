// page.templ renders the Crafting app's page. The Director's editors and a
// player's recipe book are both drawn by the crafting widget (static/js/
// crafting.js) from the API, so this is the frame and the mount point.
package crafting

import (
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CraftingPage renders the full page inside the app layout.
templ CraftingPage(cc *campaigns.CampaignContext, director bool, calendarID string) {
	@layouts.App(cc.Campaign.Name + " - Crafting") {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/crafting/css/crafting.css") }/>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/plugins/crafting/css/spoils.css") }/>
		@layouts.AppFrame() {
			@layouts.AppOpening(craftingOpening()) {
				<span>{ craftingIntros.For(layouts.AppAudienceOf(ctx)) }</span>
			}
			<div
				data-widget="crafting"
				data-campaign-id={ cc.Campaign.ID }
				data-director={ boolAttr(director) }
				data-calendar-id={ calendarID }
			>
				<p class="text-sm text-fg-muted" role="status">Loading crafting…</p>
			</div>
		}
	}
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
