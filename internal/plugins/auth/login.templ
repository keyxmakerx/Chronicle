// login.templ renders the login page and form for Chronicle.
// The form supports both traditional submission and HTMX-powered
// partial updates when validation fails.

package auth

import (
	"fmt"
	"net/url"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// providerLoginHref starts a provider sign-in, carrying the page to return to.
func providerLoginHref(redirect string) string {
	if redirect == "" {
		return "/login/oidc"
	}
	return "/login/oidc?redirect=" + url.QueryEscape(redirect)
}

// LoginPage renders the full login page wrapped in the base layout.
// successMsg is shown as a green banner (e.g., after password reset).
// redirect is the already-sanitized post-login destination (see
// sanitizeRedirect in handler.go); "" means the dashboard. opts adds the
// provider button, and folds the password form away when the admin hid it.
templ LoginPage(csrfToken, email, errMsg, successMsg, redirect string, opts LoginOptions) {
	@layouts.Base("Login") {
		@layouts.SiteAuthStage("") {
			<div class="w-full max-w-md">
				<div class="text-center mb-8">
					@layouts.SiteAuthMark()
					<h1 class="text-3xl font-bold text-fg">Welcome back</h1>
					<p class="text-fg-secondary mt-2">Sign in to your { layouts.SiteName(ctx) } account</p>
					@layouts.SiteWelcomeLine()
				</div>
				if successMsg != "" {
					<div class="alert-success mb-4" role="status">
						<i class="fa-solid fa-check-circle mr-1.5"></i>
						{ successMsg }
					</div>
				}
				if opts.ProviderName != "" {
					<a href={ templ.SafeURL(providerLoginHref(redirect)) } class="btn-primary w-full py-2.5 flex items-center justify-center gap-2" data-testid="provider-sign-in">
						<i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
						Sign in with { opts.ProviderName }
					</a>
					if opts.HidePassword {
						<div x-data={ fmt.Sprintf("{ show: %t }", errMsg != "") } class="mt-4">
							<p class="text-center text-sm" x-show="!show">
								<button type="button" class="text-fg-muted hover:text-fg" @click="show = true">Site admin? Use your password</button>
							</p>
							<div x-show="show" x-cloak class="step-settle">
								@LoginForm_(csrfToken, email, errMsg, redirect)
							</div>
						</div>
					} else {
						<div class="flex items-center gap-3 my-4 text-xs text-fg-muted" aria-hidden="true">
							<span class="flex-1 border-t border-edge"></span>or use your password<span class="flex-1 border-t border-edge"></span>
						</div>
						@LoginForm_(csrfToken, email, errMsg, redirect)
					}
				} else {
					@LoginForm_(csrfToken, email, errMsg, redirect)
				}
			</div>
		}
	}
}

// LoginForm_ renders just the login form. Used for HTMX partial replacement
// on validation errors (the trailing underscore avoids collision with the
// Echo handler method name).
templ LoginForm_(csrfToken, email, errMsg, redirect string) {
	<div id="login-form">
		<form
			class="card p-8 space-y-5"
			method="POST"
			action="/login"
			hx-post="/login"
			hx-target="#login-form"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<!-- Carries the post-login destination (e.g. the availability grid a
			     solicitation email deep-linked to) through the POST, because the
			     query param is not present on the HTMX form POST — the same
			     mechanism register.templ already uses. -->
			<input type="hidden" name="redirect" value={ redirect }/>

			if errMsg != "" {
				<div class="alert-error" role="alert">
					{ errMsg }
				</div>
			}

			<div>
				<label for="email" class="block text-sm font-medium text-fg-body mb-1.5">
					Email
				</label>
				<input
					type="email"
					id="email"
					name="email"
					value={ email }
					required
					autofocus
					class="input w-full"
					placeholder="you@example.com"
					autocomplete="email"
				/>
			</div>

			<div>
				<div class="flex items-center justify-between mb-1.5">
					<label for="password" class="block text-sm font-medium text-fg-body">
						Password
					</label>
					<a href="/forgot-password" class="text-xs text-accent hover:text-accent-hover">
						Forgot password?
					</a>
				</div>
				<input
					type="password"
					id="password"
					name="password"
					required
					class="input w-full"
					placeholder="••••••••"
					autocomplete="current-password"
				/>
			</div>

			<button type="submit" class="btn-primary w-full py-2.5">
				Sign In
			</button>

			<p class="text-center text-sm text-fg-secondary">
				Don&apos;t have an account?
				<a href="/register" class="text-accent hover:text-accent-hover font-medium">
					Create one
				</a>
			</p>
		</form>
	</div>
}
