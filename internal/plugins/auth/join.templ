// join.templ renders the page where someone types a guest code from their
// game master and joins that campaign with only a name.

package auth

import (
	"net/url"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// joinReturn is where the other doors send someone back to after signing in
// from the code tab: the join page only while a code is being used, so an
// account holder can join with it; otherwise nowhere special.
func joinReturn(code string) string {
	if code == "" {
		return ""
	}
	return joinHref + "?code=" + url.QueryEscape(code)
}

// JoinPage is the full /join page. signedInAs is the name of someone
// already signed in, who joins with their own account and needs no name.
templ JoinPage(csrfToken, code, name, errMsg, signedInAs string, inv *Invitation) {
	@layouts.Base("Join a campaign") {
		@AuthDoors(layouts.DoorCode, joinReturn(code)) {
			@JoinForm_(csrfToken, code, name, errMsg, signedInAs, inv)
		}
	}
}

// JoinForm_ is the join step, swapped in place when the code is refused or
// checked. A code is asked for first; once it opens a live campaign the
// invitation shows and only then is a name asked for.
templ JoinForm_(csrfToken, code, name, errMsg, signedInAs string, inv *Invitation) {
	<div id="join-form" class="step-settle">
		if inv != nil {
			@InvitationCard(inv)
		}
		<div class="doors-head">
			if inv != nil {
				<h1>Join { inv.CampaignName }</h1>
				<p>Add your name and you&apos;re in</p>
			} else {
				<h1>Join a campaign</h1>
				<p>Type the code your game master gave you</p>
			}
		</div>
		<form
			class="space-y-4"
			method="POST"
			action="/join"
			hx-post="/join"
			hx-target="#join-form"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			if errMsg != "" {
				<div class="alert-error" role="alert">{ errMsg }</div>
			}
			<div>
				<label for="join-code" class="block text-sm font-medium text-fg-body mb-1.5">Guest code</label>
				<input
					type="text"
					id="join-code"
					name="code"
					value={ code }
					required
					autofocus?={ code == "" }
					class="input w-full font-mono tracking-widest uppercase text-center text-lg"
					placeholder="ABCD-2345"
					autocomplete="off"
					autocapitalize="characters"
					spellcheck="false"
					maxlength="20"
				/>
			</div>
			if signedInAs == "" && inv != nil {
				<div>
					<label for="join-name" class="block text-sm font-medium text-fg-body mb-1.5">Your name</label>
					<input
						type="text"
						id="join-name"
						name="name"
						value={ name }
						required
						autofocus?={ inv != nil }
						minlength="2"
						maxlength="100"
						class="input w-full"
						placeholder="What the table calls you"
						autocomplete="nickname"
					/>
					<p class="text-xs text-fg-muted mt-1.5">No email or password needed. You can keep your account later.</p>
				</div>
			} else if signedInAs != "" {
				<p class="text-sm text-fg-secondary">
					You're signed in as <strong class="text-fg">{ signedInAs }</strong>, so you'll join with your own account.
				</p>
			}
			<button type="submit" class="btn-primary w-full py-2.5">
				if signedInAs == "" && inv == nil {
					Continue
				} else {
					Join
				}
			</button>
		</form>
	</div>
}
