// account.templ renders the user account settings page where users can
// configure personal preferences like display name, password, and timezone.

package auth

import (
	"context"
	"encoding/json"
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/notifyprefs"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	"github.com/keyxmakerx/chronicle/internal/timeutil"
)

// AccountPage renders the full account settings page.
templ AccountPage(user *User, csrfToken string, timezones []timeutil.Zone, prefs ViewPrefs, notify notifyprefs.Prefs) {
	@layouts.App("Account Settings") {
		<div class="max-w-2xl mx-auto">
			<div class="mb-6">
				<h1 class="text-2xl font-bold text-fg">Account Settings</h1>
				<p class="text-sm text-fg-secondary mt-1">Manage your personal preferences.</p>
			</div>
			<!-- Avatar -->
			<div class="card p-6 mb-6" x-data={ avatarData(ctx, user, csrfToken) }>
				<h2 class="text-lg font-semibold text-fg mb-4">Avatar</h2>
				<div class="flex items-center gap-4">
					<div class="w-16 h-16 rounded-full bg-surface-alt flex items-center justify-center overflow-hidden border-2 border-edge">
						<i x-show="!avatarUrl" class="fa-solid fa-user text-2xl text-fg-muted"></i>
						<img x-show="avatarUrl" x-bind:src="avatarUrl" class="w-full h-full object-cover" alt="Avatar"/>
					</div>
					<div>
						<label class="btn-secondary text-sm cursor-pointer">
							<i class="fa-solid fa-camera mr-1"></i> Upload Photo
							<input
								type="file"
								accept="image/*"
								class="hidden"
								@change="uploadAvatar($event)"
							/>
						</label>
						<button
							type="button"
							x-show="avatarUrl"
							class="text-sm text-fg-muted hover:text-red-500 ml-3"
							@click="removeAvatar()"
						>
							Remove
						</button>
						<p x-show="avatarMsg" x-transition class="text-xs mt-1" x-bind:class="avatarError ? 'text-red-500' : 'text-green-500'" x-text="avatarMsg"></p>
						<p class="text-xs text-fg-muted mt-1">Max 2MB. JPG, PNG, GIF, or WebP.</p>
					</div>
				</div>
			</div>
			<!-- Profile Info -->
			<div class="card p-6 mb-6" x-data={ profileData(user, csrfToken) }>
				<h2 class="text-lg font-semibold text-fg mb-4">Profile</h2>
				<div class="space-y-3">
					<div>
						<label class="block text-sm font-medium text-fg-secondary mb-0.5">Display Name</label>
						<div class="flex items-center gap-2">
							<input
								type="text"
								x-model="displayName"
								class="input flex-1"
								maxlength="100"
								minlength="2"
							/>
							<button
								type="button"
								class="btn-primary text-sm"
								x-bind:disabled="savingName || displayName === originalName"
								@click="saveDisplayName()"
							>
								<span x-show="!savingName">Save</span>
								<span x-show="savingName">...</span>
							</button>
						</div>
						<p x-show="nameMsg" x-transition class="text-xs mt-1" x-bind:class="nameError ? 'text-red-500' : 'text-green-500'" x-text="nameMsg"></p>
					</div>
					<div>
						<label class="block text-sm font-medium text-fg-secondary mb-0.5">Email</label>
						<p class="text-sm text-fg">{ user.Email }</p>
					</div>
				</div>
			</div>
			<!-- Change Email -->
			<div class="card p-6 mb-6" x-data={ emailChangeData(csrfToken) }>
				<h2 class="text-lg font-semibold text-fg mb-4">Change Email</h2>
				<p class="text-sm text-fg-secondary mb-4">
					A verification link will be sent to your new email address. Your email won't change until you click that link.
				</p>
				<div class="space-y-3">
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1" for="new-email">New Email Address</label>
						<input type="email" id="new-email" x-model="newEmail" class="input w-full" autocomplete="email" placeholder="new@example.com"/>
					</div>
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1" for="email-password">Current Password</label>
						<input type="password" id="email-password" x-model="emailPassword" class="input w-full" autocomplete="current-password"/>
						<p class="text-xs text-fg-muted mt-0.5">Required to confirm your identity.</p>
					</div>
					<div class="flex items-center justify-end gap-2 pt-2 border-t border-edge">
						<span x-show="emailMsg" x-transition class="text-xs" x-bind:class="emailError ? 'text-red-500' : 'text-green-500'" x-text="emailMsg"></span>
						<button
							type="button"
							class="btn-primary text-sm"
							x-bind:disabled="savingEmail || !newEmail || !emailPassword"
							@click="requestEmailChange()"
						>
							<span x-show="!savingEmail">Send Verification</span>
							<span x-show="savingEmail">Sending...</span>
						</button>
					</div>
				</div>
			</div>
			<!-- Change Password -->
			<div class="card p-6 mb-6" x-data={ passwordData(csrfToken) }>
				<h2 class="text-lg font-semibold text-fg mb-4">Change Password</h2>
				<div class="space-y-3">
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1" for="current-password">Current Password</label>
						<input type="password" id="current-password" x-model="currentPassword" class="input w-full" autocomplete="current-password"/>
					</div>
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1" for="new-password">New Password</label>
						<input type="password" id="new-password" x-model="newPassword" class="input w-full" minlength="8" autocomplete="new-password"/>
						<p class="text-xs text-fg-muted mt-0.5">Minimum 8 characters.</p>
					</div>
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1" for="confirm-password">Confirm New Password</label>
						<input type="password" id="confirm-password" x-model="confirmPassword" class="input w-full" autocomplete="new-password"/>
					</div>
					<div class="flex items-center justify-end gap-2 pt-2 border-t border-edge">
						<span x-show="pwMsg" x-transition class="text-xs" x-bind:class="pwError ? 'text-red-500' : 'text-green-500'" x-text="pwMsg"></span>
						<button
							type="button"
							class="btn-primary text-sm"
							x-bind:disabled="savingPw || !currentPassword || !newPassword || !confirmPassword"
							@click="changePassword()"
						>
							<span x-show="!savingPw">Change Password</span>
							<span x-show="savingPw">Saving...</span>
						</button>
					</div>
				</div>
			</div>
			<!-- My view: personal look, saved to the account, per viewer only -->
			<div class="card p-6 mb-6" x-data={ viewPrefsData(prefs) } id="my-view">
				<h2 class="text-lg font-semibold text-fg mb-1">My view</h2>
				<p class="text-sm text-fg-secondary mb-4">Only changes what you see. Owners and other players never see your choices.</p>
				<div class="space-y-4">
					for _, g := range viewPrefGroups {
						<div>
							<p class="text-sm font-medium text-fg-body mb-1" id={ "vp-label-" + g.Key }>{ g.Label }</p>
							<div class="inline-flex flex-wrap border border-edge rounded-lg overflow-hidden bg-surface" role="group" aria-labelledby={ "vp-label-" + g.Key }>
								for _, o := range g.Options {
									<button
										type="button"
										class="px-3 py-1.5 text-sm font-medium text-fg-body"
										x-bind:class={ fmt.Sprintf("v.%s === %q ? 'bg-accent text-white' : 'hover:bg-surface-alt'", g.Key, o.Value) }
										x-bind:aria-pressed={ fmt.Sprintf("(v.%s === %q).toString()", g.Key, o.Value) }
										@click={ fmt.Sprintf("save(%q, %q)", g.Key, o.Value) }
									>{ o.Label }</button>
								}
							</div>
						</div>
					}
				</div>
				<p class="text-xs mt-4 min-h-4" aria-live="polite">
					<span x-show="status === 'saved'" class="text-fg-muted">Saved to your account</span>
					<span x-show="status === 'saving'" class="text-fg-muted">Saving...</span>
					<span x-show="status === 'error'" class="text-red-500" x-text="error"></span>
				</p>
			</div>
			<!-- Timezone Setting -->
			<div class="card p-6 mb-6" x-data={ timezoneData(user) }>
				<h2 class="text-lg font-semibold text-fg mb-1">Timezone</h2>
				<p class="text-sm text-fg-secondary mb-4">
					Used by real-life calendars to display dates and times in your local timezone.
				</p>
				<div class="mb-4">
					<label class="block text-sm font-medium text-fg-body mb-1" for="timezone-select">Your Timezone</label>
					<select id="timezone-select" x-model="timezone" class="input w-full">
						<option value="">UTC (default)</option>
						for _, tz := range timezones {
							<option value={ tz.Value }>{ tz.Label }</option>
						}
					</select>
					<p class="text-xs text-fg-muted mt-1">Select your IANA timezone (e.g. America/New_York, Europe/London).</p>
				</div>
				<div class="flex items-center justify-end gap-2 pt-2 border-t border-edge">
					<span x-show="saved" x-transition class="text-xs text-green-500">Saved</span>
					<span x-show="error" x-transition class="text-xs text-red-500" x-text="error"></span>
					<button
						type="button"
						class="btn-primary text-sm"
						x-bind:disabled="saving"
						@click="
							saving = true; saved = false; error = '';
							Chronicle.apiFetch('/account/timezone', {
								method: 'PUT',
								body: { timezone: timezone }
							}).then(r => { if (!r.ok) throw new Error('Save failed'); saved = true; setTimeout(() => saved = false, 3000); })
							.catch(e => { error = e.message; })
							.finally(() => { saving = false; })
						"
					>
						<span x-show="!saving">Save Timezone</span>
						<span x-show="saving">Saving...</span>
					</button>
				</div>
			</div>
			@notifyPrefsCard(notify)
		</div>
	}
}

// notifyPrefsCard is the Notifications section: one row per kind of message,
// a switch per way it can arrive, and a dash where Chronicle never sends it
// that way. Each switch saves on its own.
templ notifyPrefsCard(notify notifyprefs.Prefs) {
	<div class="card p-6" x-data={ notifyPrefsData(notify) } id="notifications">
		<h2 class="text-lg font-semibold text-fg mb-1">Notifications</h2>
		<p class="text-sm text-fg-secondary mb-4">Choose what reaches you and how. The bell is the list at the top of every page. A dash means Chronicle doesn't send that one that way.</p>
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead>
					<tr class="text-xs uppercase tracking-wide text-fg-muted">
						<th class="text-left font-semibold py-1.5">When</th>
						<th class="font-semibold py-1.5 w-16">Bell</th>
						<th class="font-semibold py-1.5 w-16">Email</th>
					</tr>
				</thead>
				<tbody>
					for i, c := range notifyprefs.Catalog {
						if i == 0 || notifyprefs.Catalog[i-1].Group != c.Group {
							<tr><td colspan="3" class="pt-4 pb-1 font-semibold text-fg">{ c.Group }</td></tr>
						}
						<tr class="border-t border-edge">
							<td class="py-2 pr-2 align-top">
								<span class="text-fg-body">{ c.Label }</span>
								if c.Detail != "" {
									<span class="block text-xs text-fg-muted">{ c.Detail }</span>
								}
							</td>
							@notifySwitchCell(c, notifyprefs.Bell)
							@notifySwitchCell(c, notifyprefs.Email)
						</tr>
					}
					<tr><td colspan="3" class="pt-4 pb-1 font-semibold text-fg">Always sent</td></tr>
					<tr class="border-t border-edge">
						<td class="py-2 pr-2 align-top">
							<span class="text-fg-body">Password resets, email changes, campaign invitations and hand-overs</span>
							<span class="block text-xs text-fg-muted">These keep your account safe, so they can't be switched off</span>
						</td>
						<td class="py-2 text-center"><i class="fa-solid fa-lock text-fg-muted" aria-label="Always on"></i></td>
						<td class="py-2 text-center"><i class="fa-solid fa-lock text-fg-muted" aria-label="Always on"></i></td>
					</tr>
				</tbody>
			</table>
		</div>
		<div class="flex items-start gap-3 mt-4 pt-4 border-t border-edge">
			<button
				type="button"
				class="toggle shrink-0 mt-0.5"
				role="switch"
				aria-labelledby="notify-pause-label"
				x-bind:aria-checked="p.pauseEmail.toString()"
				@click="pause(!p.pauseEmail)"
			><span class="toggle-knob"></span></button>
			<div>
				<p class="text-sm font-medium text-fg" id="notify-pause-label">Pause all email</p>
				<p class="text-xs text-fg-muted">Bell entries still arrive, and your choices above come back when you switch this off.</p>
			</div>
		</div>
		<p class="text-xs mt-4 min-h-4" aria-live="polite">
			<span x-show="status === 'saved'" class="text-fg-muted">Saved to your account</span>
			<span x-show="status === 'saving'" class="text-fg-muted">Saving...</span>
			<span x-show="status === 'error'" class="text-red-500" x-text="error"></span>
		</p>
	</div>
}

// notifySwitchCell draws one switch, or a dash when the category never
// sends on that channel. Email switches dim while email is paused.
templ notifySwitchCell(c notifyprefs.Category, ch notifyprefs.Channel) {
	<td class="py-2 text-center align-top">
		if c.Has(ch) {
			<button
				type="button"
				class="toggle"
				role="switch"
				aria-label={ fmt.Sprintf("%s: %s", notifyChannelName(ch), c.Label) }
				x-bind:aria-checked={ fmt.Sprintf("p.choices[%q][%q].toString()", c.Key, ch) }
				if ch == notifyprefs.Email {
					x-bind:class="p.pauseEmail ? 'opacity-50' : ''"
				}
				@click={ fmt.Sprintf("set(%q, %q)", c.Key, ch) }
			><span class="toggle-knob"></span></button>
		} else {
			<span class="text-fg-muted" title={ fmt.Sprintf("Chronicle doesn't send this one by %s", notifyChannelName(ch)) }>—</span>
		}
	</td>
}

func notifyChannelName(ch notifyprefs.Channel) string {
	if ch == notifyprefs.Email {
		return "email"
	}
	return "bell"
}

// notifyPrefsData returns the Alpine state for the Notifications section.
// A failed save puts the switch back, so the page never shows a choice the
// account doesn't hold.
func notifyPrefsData(p notifyprefs.Prefs) string {
	cur, _ := json.Marshal(p)
	return fmt.Sprintf(`{
		p: %s,
		status: '',
		error: '',
		send(body, undo) {
			this.status = 'saving'; this.error = '';
			Chronicle.apiFetch('/account/notifications', { method: 'PUT', body: body })
			.then(r => { if (!r.ok) throw new Error('Could not save that choice'); this.status = 'saved'; })
			.catch(e => { undo(); this.status = 'error'; this.error = e.message; });
		},
		set(key, ch) {
			var next = !this.p.choices[key][ch];
			this.p.choices[key][ch] = next;
			var body = { choices: {} }; body.choices[key] = {}; body.choices[key][ch] = next;
			this.send(body, () => { this.p.choices[key][ch] = !next; });
		},
		pause(v) {
			this.p.pauseEmail = v;
			this.send({ pauseEmail: v }, () => { this.p.pauseEmail = !v; });
		}
	}`, cur)
}

// avatarData returns the Alpine.js x-data JSON for the avatar uploader.
// avatarUrl starts as the signed/unsigned URL for a 300px thumbnail of the
// user's current avatar (resolved via layouts.MediaThumbURL from the stored
// media id, falling back to the original if no thumbnail exists), then is
// replaced client-side with whatever the upload/clear response returns.
func avatarData(ctx context.Context, user *User, csrfToken string) string {
	avatarURL := ""
	if user.AvatarPath != nil && *user.AvatarPath != "" {
		avatarURL = layouts.MediaThumbURL(ctx, *user.AvatarPath, "300")
	}
	return fmt.Sprintf(`{
		avatarUrl: %q,
		avatarMsg: '',
		avatarError: false,
		csrf: %q,
		uploadAvatar(e) {
			var file = e.target.files[0];
			if (!file) return;
			if (file.size > 2*1024*1024) { this.avatarMsg = 'File must be under 2MB'; this.avatarError = true; return; }
			var fd = new FormData();
			fd.append('avatar', file);
			this.avatarMsg = 'Uploading...'; this.avatarError = false;
			Chronicle.apiFetch('/account/avatar', {
				method: 'POST',
				body: fd
			}).then(r => r.json().then(d => {
				if (!r.ok) throw new Error(d.message || 'Upload failed');
				this.avatarUrl = d.avatar_path;
				this.avatarMsg = 'Avatar updated';
				this.avatarError = false;
				setTimeout(() => this.avatarMsg = '', 3000);
			}))
			.catch(e => { this.avatarMsg = e.message; this.avatarError = true; });
		},
		removeAvatar() {
			this.avatarMsg = 'Removing...'; this.avatarError = false;
			Chronicle.apiFetch('/account/avatar', {
				method: 'DELETE'
			}).then(r => r.json().then(d => {
				if (!r.ok) throw new Error(d.message || 'Remove failed');
				this.avatarUrl = '';
				this.avatarMsg = 'Avatar removed';
				this.avatarError = false;
				setTimeout(() => this.avatarMsg = '', 3000);
			}))
			.catch(e => { this.avatarMsg = e.message; this.avatarError = true; });
		}
	}`, avatarURL, csrfToken)
}

// profileData returns the Alpine.js x-data JSON for the profile editor.
func profileData(user *User, csrfToken string) string {
	return fmt.Sprintf(`{
		displayName: %q,
		originalName: %q,
		savingName: false,
		nameMsg: '',
		nameError: false,
		csrf: %q,
		saveDisplayName() {
			this.savingName = true; this.nameMsg = ''; this.nameError = false;
			Chronicle.apiFetch('/account/display-name', {
				method: 'PUT',
				body: { displayName: this.displayName }
			}).then(r => r.json().then(d => { if (!r.ok) throw new Error(d.error || 'Failed'); this.originalName = this.displayName; this.nameMsg = 'Saved'; this.nameError = false; setTimeout(() => this.nameMsg = '', 3000); }))
			.catch(e => { this.nameMsg = e.message; this.nameError = true; })
			.finally(() => { this.savingName = false; });
		}
	}`, user.DisplayName, user.DisplayName, csrfToken)
}

// passwordData returns the Alpine.js x-data JSON for the password change form.
func passwordData(csrfToken string) string {
	return fmt.Sprintf(`{
		currentPassword: '',
		newPassword: '',
		confirmPassword: '',
		savingPw: false,
		pwMsg: '',
		pwError: false,
		csrf: %q,
		changePassword() {
			if (this.newPassword !== this.confirmPassword) { this.pwMsg = 'Passwords do not match'; this.pwError = true; return; }
			this.savingPw = true; this.pwMsg = ''; this.pwError = false;
			Chronicle.apiFetch('/account/password', {
				method: 'PUT',
				body: { currentPassword: this.currentPassword, newPassword: this.newPassword, confirmPassword: this.confirmPassword }
			}).then(r => r.json().then(d => { if (!r.ok) throw new Error(d.error || 'Failed'); this.pwMsg = 'Password changed'; this.pwError = false; this.currentPassword = ''; this.newPassword = ''; this.confirmPassword = ''; setTimeout(() => this.pwMsg = '', 3000); }))
			.catch(e => { this.pwMsg = e.message; this.pwError = true; })
			.finally(() => { this.savingPw = false; });
		}
	}`, csrfToken)
}

// emailChangeData returns the Alpine.js x-data JSON for the email change form.
func emailChangeData(csrfToken string) string {
	return fmt.Sprintf(`{
		newEmail: '',
		emailPassword: '',
		savingEmail: false,
		emailMsg: '',
		emailError: false,
		csrf: %q,
		requestEmailChange() {
			this.savingEmail = true; this.emailMsg = ''; this.emailError = false;
			Chronicle.apiFetch('/account/email', {
				method: 'PUT',
				body: { newEmail: this.newEmail, currentPassword: this.emailPassword }
			}).then(r => r.json().then(d => {
				if (!r.ok) throw new Error(d.error || 'Failed');
				this.emailMsg = d.message || 'Verification email sent';
				this.emailError = false;
				this.newEmail = '';
				this.emailPassword = '';
			}))
			.catch(e => { this.emailMsg = e.message; this.emailError = true; })
			.finally(() => { this.savingEmail = false; });
		}
	}`, csrfToken)
}

// timezoneData returns the Alpine.js x-data JSON for the timezone selector.
func timezoneData(user *User) string {
	tz := ""
	if user.Timezone != nil {
		tz = *user.Timezone
	}
	return fmt.Sprintf(`{ timezone: %q, saving: false, saved: false, error: '' }`, tz)
}

// EmailVerifyResultPage renders the result of clicking an email verification link.
// Shows success (with login redirect) or an error message.
templ EmailVerifyResultPage(success bool, errMsg, csrfToken string) {
	@layouts.App("Email Verification") {
		<div class="max-w-md mx-auto mt-12">
			<div class="card p-8 text-center">
				if success {
					<div class="mb-4">
						<i class="fa-solid fa-circle-check text-4xl text-green-500"></i>
					</div>
					<h1 class="text-xl font-bold text-fg mb-2">Email Updated</h1>
					<p class="text-sm text-fg-secondary mb-6">
						Your email address has been changed successfully. Please sign in with your new email.
					</p>
					<a href="/login" class="btn-primary">Sign In</a>
				} else {
					<div class="mb-4">
						<i class="fa-solid fa-circle-xmark text-4xl text-red-500"></i>
					</div>
					<h1 class="text-xl font-bold text-fg mb-2">Verification Failed</h1>
					<p class="text-sm text-fg-secondary mb-6">
						{ errMsg }
					</p>
					<a href="/account" class="btn-secondary">Back to Account</a>
				}
			</div>
		</div>
	}
}

// viewPrefOption is one button of a segmented choice on the My view card.
type viewPrefOption struct{ Value, Label string }

// viewPrefGroup is one segmented choice. Key is the JSON key the PUT sends,
// Options[0] is the default, matching the allowed lists in view_prefs.go.
type viewPrefGroup struct {
	Key, Label string
	Options    []viewPrefOption
}

// viewPrefGroups lists the four choices in the order the signed design shows them.
var viewPrefGroups = []viewPrefGroup{
	{"theme", "Light or dark", []viewPrefOption{{"light", "Light"}, {"dark", "Dark"}, {"device", "Match my device"}}},
	{"motion", "Motion", []viewPrefOption{{"owner", "As the owner set it"}, {"calm", "Calm"}, {"off", "Off"}}},
	{"textSize", "Text size", []viewPrefOption{{"standard", "Standard"}, {"larger", "Larger"}, {"largest", "Largest"}}},
	{"contrast", "Contrast", []viewPrefOption{{"standard", "Standard"}, {"high", "High"}}},
}

// viewPrefsData returns the Alpine.js x-data for the My view card. A tap
// applies the choice to this page at once (the same attributes the layout
// writes server-side, so what the person sees now is what every page shows
// next) and saves only that one key, so the other three are never echoed back.
func viewPrefsData(prefs ViewPrefs) string {
	cur, _ := json.Marshal(prefs)
	return fmt.Sprintf(`{
		v: %s,
		status: '',
		error: '',
		save(key, value) {
			var prev = this.v[key];
			this.v[key] = value;
			this.status = 'saving'; this.error = '';
			Chronicle.applyViewPref && Chronicle.applyViewPref(key, value);
			var body = {}; body[key] = value;
			Chronicle.apiFetch('/account/view-prefs', { method: 'PUT', body: body })
			.then(r => { if (!r.ok) throw new Error('Could not save that choice'); this.status = 'saved'; })
			.catch(e => {
				this.v[key] = prev;
				Chronicle.applyViewPref && Chronicle.applyViewPref(key, prev);
				this.status = 'error'; this.error = e.message;
			});
		}
	}`, cur)
}
