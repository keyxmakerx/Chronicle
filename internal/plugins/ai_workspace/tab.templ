// tab.templ renders the copy-and-paste half of the Your AI page: one
// remembered "When you copy, what may your AI see?" choice, then three
// folding rows in the order an owner uses them (ask, paste back, give it
// the whole campaign).

package ai_workspace

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"

	"github.com/keyxmakerx/chronicle/internal/plugins/ai_workspace/prompt"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
)

// aiCopyPasteSection wraps the AI tool with its one privacy choice. The
// choice is remembered per campaign in this browser and every form below
// sends it, so the owner answers it once. A paste anywhere on the page,
// outside a field, goes into the paste box and is read at once (never while
// a review is open, whose answers it would throw away).
templ aiCopyPasteSection(cc *campaigns.CampaignContext) {
	<section
		class="space-y-4"
		aria-labelledby="ai-copy-heading"
		x-data={ fmt.Sprintf(`{
			open: 'paste',
			sees: 'safe',
			storeKey: 'ai-sees-%s',
			init() {
				try {
					const v = localStorage.getItem(this.storeKey);
					if (v === 'safe' || v === 'permitted' || v === 'everything') this.sees = v;
				} catch (e) {}
				this.$watch('sees', (v) => { try { localStorage.setItem(this.storeKey, v); } catch (e) {} });
			},
			pasteAnywhere(e) {
				const t = e.target;
				if (t && (t.closest('input, textarea, select') || t.isContentEditable)) return;
				// A review already open, here or of a request, keeps the paste.
				if (document.querySelector('#ai-import-review-host form, .aic-req-review form')) return;
				const text = e.clipboardData && e.clipboardData.getData('text/plain');
				const area = document.getElementById('ai-import-paste-area');
				if (!text || !text.trim() || !area) return;
				e.preventDefault();
				this.open = 'paste';
				if (location.hash !== '#copy-and-paste') location.hash = 'copy-and-paste';
				area.value = text;
				area.dispatchEvent(new Event('input', { bubbles: true }));
				area.form.requestSubmit();
			},
		}`, cc.Campaign.ID) }
		@paste.window="pasteAnywhere($event)"
	>
		<div>
			<h2 id="ai-copy-heading" class="text-base font-semibold text-fg pr-10">Copy and paste</h2>
			<p class="text-sm text-fg-secondary mt-0.5 max-w-prose">
				For any AI, and for asking it to make or change things: copy a request here, paste it into your AI, then paste its answer back. Nothing changes until you say yes to each change. You can paste anywhere on this page with Ctrl+V.
			</p>
		</div>
		<fieldset class="aic-panel">
			<legend class="sr-only">When you copy, what may your AI see?</legend>
			<p class="aic-h mb-1" aria-hidden="true">When you copy, what may your AI see?</p>
			<p class="aic-hint mb-2">Used for everything below, and remembered for this campaign.</p>
			<div class="grid gap-x-6 sm:grid-cols-3">
				@seesChoice("safe", "What players see", "Safest. No secrets, and nothing you keep from players.")
				@seesChoice("permitted", "What you see", fmt.Sprintf("Adds your %s-only pages and secrets.", layouts.GMTerm(ctx)))
				@seesChoice("everything", "Everything", "Nothing held back. Only for an AI you fully trust.")
			</div>
		</fieldset>
		@aiToolSection(cc)
	</section>
}

templ seesChoice(value, title, sub string) {
	<label class="aic-choice">
		<input type="radio" name="ai_sees" value={ value } x-model="sees"/>
		<span>
			<b>{ title }</b>
			<span class="block aic-hint">{ sub }</span>
		</span>
	</label>
}

// aiToolSection is the AI tool: three folding rows in the order an owner
// uses them (ask, paste back what the AI gives, or give it the whole
// campaign). Pasting is open by default, since it is the step people come
// back for; each row grows open inside the box. Its open row and the
// privacy choice live on aiCopyPasteSection.
templ aiToolSection(cc *campaigns.CampaignContext) {
	<div class="card p-0 overflow-hidden" data-ai-tool>
		<div class="divide-y divide-edge">
			@aiToolRow("prompt", "1", "", "Ask your AI for something", "Copy a request that tells it about your campaign and what you want made") {
				@promptBuilderBody(cc)
			}
			@aiToolRow("paste", "2", "", "Paste what your AI gives you", "Changes for you to review, or questions Chronicle answers for it") {
				@importBody(cc)
			}
			@aiToolRow("export", "", "fa-solid fa-file-export", "Give your AI the whole campaign", "One file to upload to NotebookLM and similar tools") {
				@aiExportBody(cc)
			}
		</div>
	</div>
}

// aiToolRow is one folding row of the AI tool: a numbered (or icon) badge,
// a title and a line under it. Only one row is open at a time.
templ aiToolRow(key, num, icon, title, sub string) {
	<div>
		<button
			type="button"
			class="w-full flex items-center gap-3 px-4 py-3 text-left"
			@click={ fmt.Sprintf("open = open === '%s' ? '' : '%s'", key, key) }
			:aria-expanded={ fmt.Sprintf("open === '%s'", key) }
			aria-controls={ "ai-tool-" + key }
		>
			<span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-bold shrink-0">
				if icon != "" {
					<i class={ icon } aria-hidden="true"></i>
				} else {
					{ num }
				}
			</span>
			<span class="flex-1 min-w-0">
				<span class="block text-sm font-medium text-fg">{ title }</span>
				<span class="block text-xs text-fg-muted">{ sub }</span>
			</span>
			<i
				class="fa-solid fa-chevron-down text-xs text-fg-muted transition-transform"
				:class={ fmt.Sprintf("open === '%s' && 'rotate-180'", key) }
				aria-hidden="true"
			></i>
		</button>
		<div
			id={ "ai-tool-" + key }
			x-show={ fmt.Sprintf("open === '%s'", key) }
			x-collapse.duration.200ms
			if key != "paste" {
				x-cloak
			}
		>
			<div class="px-4 pb-4">
				{ children... }
			</div>
		</div>
	</div>
}

// gmNotesChoice is the tick for the Director's notes on game nights, shown
// only when the AI may see more than players do.
templ gmNotesChoice(show string) {
	<label x-show={ show } x-cloak class="flex items-start gap-2 cursor-pointer text-sm">
		<input type="checkbox" name="gm_notes" value="on" class="mt-0.5 rounded border-edge text-accent"/>
		<span>
			Include your { layouts.GMTerm(ctx) } notes on game nights
			<span class="block text-xs text-fg-muted">The recaps every player reads are always included.</span>
		</span>
	</label>
}

// promptBuilderBody builds a request for the AI: what to tell it about the
// campaign, what to include, and what to make; the request then opens in a
// modal with a Copy button. The size line is a rough guess made here; the
// modal shows the real request.
templ promptBuilderBody(cc *campaigns.CampaignContext) {
	<div
		x-data="{
			schemaTypes: true,
			schemaCategories: true,
			schemaFrontMatter: true,
			contentMode: 'none',
			instruction: '',
			saved: false,
			copyState: '',
			async copyInstructions(url) {
				this.copyState = 'busy';
				try {
					const text = fetch(url, { credentials: 'same-origin' }).then((r) => {
						if (!r.ok) throw new Error(r.status);
						return r.text();
					});
					// Handing the clipboard a pending item keeps the click's
					// permission while the text loads (Safari needs this).
					if (window.ClipboardItem && navigator.clipboard.write) {
						await navigator.clipboard.write([new ClipboardItem({ 'text/plain': text.then((t) => new Blob([t], { type: 'text/plain' })) })]);
					} else {
						await navigator.clipboard.writeText(await text);
					}
					this.copyState = 'copied';
				} catch (e) {
					this.copyState = 'failed';
				}
				setTimeout(() => { if (this.copyState !== 'busy') this.copyState = ''; }, 4000);
			},
			get estimate() {
				let chars = 600; // base preamble + boilerplate
				if (this.saved) chars = 200;
				if (this.schemaTypes && !this.saved) chars += 400;
				if (this.schemaCategories) chars += 600;
				if (this.schemaFrontMatter && !this.saved) chars += 500;
				if (this.contentMode === 'house-rules') chars += 4000;
				else if (this.contentMode === 'calendar') chars += 6000;
				else if (this.contentMode !== 'none') chars += 30000; // content dominates
				chars += this.instruction.length;
				return Math.ceil(chars / 4);
			},
			get sizeLine() {
				if (this.estimate < 8000) return 'Short, fits any AI';
				if (this.estimate < 32000) return 'Medium, fits most AIs';
				return 'Long, needs an AI that takes long messages';
			}
		}"
	>
		<form
			hx-get={ fmt.Sprintf("/campaigns/%s/ai-workspace/prompt/generate", cc.Campaign.ID) }
			hx-target="#ai-prompt-modal-host"
			hx-swap="innerHTML"
			hx-indicator="#ai-prompt-generating"
			class="space-y-5"
		>
			<input type="hidden" name="privacy" :value="sees" value="safe"/>
			<div class="flex flex-wrap items-start gap-3 rounded-lg border border-edge p-3">
				<div class="flex-1 min-w-[14rem] text-sm">
					<strong class="font-medium text-fg">Save the instructions in your AI once</strong>
					<span class="block text-xs text-fg-muted">Copies how Chronicle wants answers written and what your AI can ask it, without your campaign's content. Paste it into your AI's saved or project instructions, then tick "My AI already has the instructions" below, so each request is only what you want.</span>
				</div>
				<button
					type="button"
					class="btn-secondary text-sm shrink-0"
					data-url={ fmt.Sprintf("/campaigns/%s/ai-workspace/prompt/instructions", cc.Campaign.ID) }
					@click="copyInstructions($el.dataset.url)"
					:disabled="copyState === 'busy'"
				>
					<i class="fa-regular fa-copy" aria-hidden="true"></i>
					<span x-text="copyState === 'copied' ? 'Copied' : (copyState === 'busy' ? 'Copying…' : 'Copy the instructions')">Copy the instructions</span>
				</button>
				<p x-show="copyState === 'failed'" x-cloak role="alert" class="basis-full text-xs text-bad">
					Couldn't copy. Your browser may have blocked the clipboard; try again, or use Make the request below.
				</p>
				<span class="sr-only" aria-live="polite" x-text="copyState === 'copied' ? 'Instructions copied' : ''"></span>
			</div>

			<div>
				<h3 class="text-sm font-medium text-fg mb-2">What to tell your AI about your campaign</h3>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="schema_types" value="on" x-model="schemaTypes" class="rounded border-edge text-accent"/>
						<span>Your kinds of pages (Character, Place...)</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="schema_categories" value="on" x-model="schemaCategories" class="rounded border-edge text-accent"/>
						<span>How many pages of each kind you have</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="schema_front_matter" value="on" x-model="schemaFrontMatter" class="rounded border-edge text-accent"/>
						<span>An example of how to write a page</span>
					</label>
				</div>
			</div>

			<div>
				<h3 class="text-sm font-medium text-fg mb-2">What to include</h3>
				<div class="space-y-2 text-sm">
					<label class="flex items-start gap-2 cursor-pointer">
						<input type="radio" name="content_mode" value="none" x-model="contentMode" class="mt-0.5 border-edge text-accent"/>
						<span>
							<strong>Nothing else</strong>
							<span class="block text-xs text-fg-muted">The shortest request. Your AI makes things that fit your campaign, but doesn't know your pages.</span>
						</span>
					</label>
					<label class="flex items-start gap-2 cursor-pointer">
						<input type="radio" name="content_mode" value="all" x-model="contentMode" class="mt-0.5 border-edge text-accent"/>
						<span>
							<strong>Your pages</strong>
							<span class="block text-xs text-fg-muted">Everything your AI may see, so it can refer to your pages by name.</span>
						</span>
					</label>
					<label class="flex items-start gap-2 cursor-pointer">
						<input type="radio" name="content_mode" value="house-rules" x-model="contentMode" class="mt-0.5 border-edge text-accent"/>
						<span>
							<strong>House rules</strong>
							<span class="block text-xs text-fg-muted">Your Handbook's house rules as they are now, and how to write pages with highlighted boxes, dice rolls, flaps and the rest. The AI can add, change or remove them.</span>
						</span>
					</label>
					<label class="flex items-start gap-2 cursor-pointer">
						<input type="radio" name="content_mode" value={ prompt.ContentCalendar } x-model="contentMode" class="mt-0.5 border-edge text-accent"/>
						<span>
							<strong>Calendar</strong>
							<span class="block text-xs text-fg-muted">Your main calendar as it is now (or how to set one up), its climate and kinds of weather, and how to write calendars, events, weather and generators. The AI can create the calendar, choose the main one, and fill it in.</span>
						</span>
					</label>
				</div>
			</div>

			@gmNotesChoice("sees !== 'safe' && contentMode !== 'none' && contentMode !== 'house-rules' && contentMode !== 'calendar'")

			<div>
				<h3 class="text-sm font-medium text-fg mb-2">What would you like your AI to make?</h3>
				<textarea
					name="instruction"
					x-model="instruction"
					rows="4"
					placeholder="Five new NPCs for the Drowned Reach. Mix of allies and rivals. Each should have a one-paragraph backstory tying them to the Coral Court fall."
					class="input w-full text-sm"
				></textarea>
			</div>

			<label class="flex items-start gap-2 cursor-pointer text-sm">
				<input type="checkbox" name="instructions_saved" value="on" x-model="saved" class="mt-0.5 rounded border-edge text-accent"/>
				<span>
					My AI already has the instructions
					<span class="block text-xs text-fg-muted">Leaves them out, so the request is only what you want and what you chose to include.</span>
				</span>
			</label>

			<div class="flex flex-wrap items-center gap-3 pt-2">
				<button type="submit" class="btn-primary">
					<i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Make the request
				</button>
				<span id="ai-prompt-generating" class="htmx-indicator text-xs text-fg-muted">
					<i class="fa-solid fa-spinner fa-spin mr-1" aria-hidden="true"></i> Making it…
				</span>
				<span class="text-xs text-fg-muted ml-auto" x-text="sizeLine">Short, fits any AI</span>
			</div>
		</form>

		// Host element for the prompt modal — handler swaps into here.
		<div id="ai-prompt-modal-host"></div>
	</div>
}

// aiExportBody is the form + Make the file button. Sends an HTMX hx-get
// to /ai-export/generate; the response replaces #ai-export-modal-host
// with the rendered modal (modal.templ). The export is lossy on purpose;
// the campaign backup in Settings › Data stays the backup.
templ aiExportBody(cc *campaigns.CampaignContext) {
	<div>
		<form
			hx-get={ fmt.Sprintf("/campaigns/%s/ai-export/generate", cc.Campaign.ID) }
			hx-target="#ai-export-modal-host"
			hx-swap="innerHTML"
			hx-indicator="#ai-export-generating"
			class="space-y-5"
		>
			<input type="hidden" name="privacy" :value="sees" value="safe"/>
			<div>
				<h3 class="text-sm font-medium text-fg mb-2">What goes in</h3>
				<p class="text-xs text-fg-muted mb-3">
					All of it to start with; untick what you'd rather leave out. Maps' pictures and other files are never included. For a backup of the campaign, use Settings › Data.
				</p>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="categories" value="entities" checked class="rounded border-edge text-accent"/>
						<span>Pages</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="categories" value="notes" checked class="rounded border-edge text-accent"/>
						<span>Your own notes</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="categories" value="calendar_events" checked class="rounded border-edge text-accent"/>
						<span>Calendar events</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="categories" value="sessions" checked class="rounded border-edge text-accent"/>
						<span>Game nights</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="categories" value="timelines" checked class="rounded border-edge text-accent"/>
						<span>Timelines</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer sm:col-span-2">
						<input type="checkbox" name="categories" value="more" checked class="rounded border-edge text-accent"/>
						<span>Rolling tables, map pins, house rules</span>
					</label>
				</div>
			</div>

			@gmNotesChoice("sees !== 'safe'")

			<div class="flex items-center gap-3 pt-2">
				<button type="submit" class="btn-primary">
					<i class="fa-solid fa-file-export" aria-hidden="true"></i> Make the file
				</button>
				<span id="ai-export-generating" class="htmx-indicator text-xs text-fg-muted">
					<i class="fa-solid fa-spinner fa-spin mr-1" aria-hidden="true"></i> Making it…
				</span>
			</div>
		</form>

		// Host element for the modal fragment — handler swaps content
		// here, then the modal Alpine state takes over for show/hide.
		<div id="ai-export-modal-host"></div>
	</div>
}
