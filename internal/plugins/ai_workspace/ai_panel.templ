package ai_workspace

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// aiPanelBody is the AI panel's content, loaded each time it opens. It is the
// one place requests and copy and paste live, so their ids are never on a
// page twice. aiPageReviews keeps one review open at a time.
templ aiPanelBody(cc *campaigns.CampaignContext, v ConnectView) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/ai_page.css") }/>
	<div class="aip-body" x-data @htmx:before-request={ aiPageReviews }>
		<header class="aip-head">
			<h2 id="ai-panel-heading" class="aip-title">Your AI</h2>
			<a class="quiet-word" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/ai", cc.Campaign.ID)) }>Setup and history</a>
			<button type="button" class="aic-icon" data-ai-close aria-label="Close the AI panel">
				<i class="fa-solid fa-xmark" aria-hidden="true"></i>
			</button>
		</header>
		if v.CutOff != nil {
			<a class="aic-alert" data-tone="stopped" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/ai", cc.Campaign.ID)) }>
				<i class="fa-solid fa-circle-stop" aria-hidden="true"></i>
				<p><b>AI is stopped in this campaign.</b> Turn it back on from Your AI.</p>
			</a>
		} else if len(v.Alerts) > 0 {
			<a class="aic-alert" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/ai", cc.Campaign.ID)) }>
				<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
				<p><b>{ countOf(len(v.Alerts), "warning", "warnings") } about your key.</b> See them on Your AI.</p>
			</a>
		}
		if v.Available {
			<section class="space-y-3" aria-label="Waiting for you">
				<div id={ requestResultHost }></div>
				@aiRequests(v, false)
				<p class="aip-empty">Nothing waiting. When your AI asks for changes, they show up here on any page.</p>
			</section>
		}
		@aiCopyPasteSection(cc)
	</div>
}
