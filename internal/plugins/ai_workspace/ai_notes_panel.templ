// ai_notes_panel.templ is the Your AI page's notes rows: the owner's
// switches for letting the AI change notes co-DMs and Scribes shared. What
// each level reads is under its "What it covers".

package ai_workspace

import "fmt"

// aiNotesPanel is swapped whole when a switch changes, which saves it.
// "co‑DMs" keeps a non-breaking hyphen so a narrow row never splits it.
templ aiNotesPanel(n NotesView) {
	<form
		id="ai-notes"
		class={ "aic-rowgroup", templ.KV("aic-notes-shut", n.Shut) }
		hx-post={ fmt.Sprintf("/campaigns/%s/ai/notes", n.CampaignID) }
		hx-trigger="change"
		hx-target="#ai-notes"
		hx-swap="outerHTML"
		aria-label="Notes your AI can use"
		x-data={ fmt.Sprintf("{ coDMs: %t, scribes: %t }", n.Access.CoDMs, n.Access.Scribes) }
	>
		<label class="aic-row">
			<span class="aic-row-k">
				<b>Co‑DMs' shared notes</b>
				<span class="aic-hint">Let it ask to change the title and text of Journal entries and jots your co‑DMs shared with you, as well as your own. It can't delete, move or reshare them.</span>
			</span>
			<input type="checkbox" role="switch" class="aic-switch" name="co_dms" x-model="coDMs" checked?={ n.Access.CoDMs }/>
		</label>
		<label class="aic-row">
			<span class="aic-row-k">
				<b>Scribes' shared notes</b>
				<span class="aic-hint">The same, for notes your Scribes shared with you.</span>
			</span>
			<input type="checkbox" role="switch" class="aic-switch" name="scribes" x-model="scribes" checked?={ n.Access.Scribes }/>
		</label>
		if n.Shut || n.Saved || n.PlayerNotes {
			<p class="aic-row-foot">
				if n.PlayerNotes {
					<span class="aic-hint">Only the writer can change a Player Note, so other people's stay read-only.</span>
				}
				if n.Shut {
					<span class="aic-hint">Notes are left out while your AI sees what players see. These apply once it sees everything.</span>
				}
				if n.Saved {
					<span class="aic-saved" role="status">Saved. Works from your AI's next call or paste.</span>
				}
			</p>
		}
	</form>
}
