// import_review.templ renders the review screen returned by POST
// /ai-workspace/import/parse: every change the AI asks for, answered Yes or
// No, before Apply posts to CommitImport.

package ai_workspace

import (
	"fmt"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/plugins/ai_workspace/importer"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/plugins/entities"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// ImportReviewData bundles everything the templ needs. Built by
// the handler from the parser + classifier outputs.
type ImportReviewData struct {
	CampaignID string
	Pages      []importer.ParsedPage
	Classes    []importer.Classification // same order/length as Pages
	// SummaryCounts is a small struct for the header counters.
	SummaryCounts ReviewSummary
	// MarkdownSource is the original input markdown the operator
	// pasted/uploaded. The review form embeds it as a hidden field
	// so the commit handler can re-parse the body content per row
	// at Submit time (avoids round-tripping the full per-page body
	// + the original FM through the form as separate fields).
	MarkdownSource string
	// Records are the non-page blocks, reviewed after the pages.
	Records []RecordRow
	// EngineSrc is the generator engine's URL, for generator rows.
	EngineSrc string
}

// ReviewSummary is the per-status tally rendered above the table.
type ReviewSummary struct {
	Total      int
	Selectable int
	Conflicts  int
	NewCategories int
	ParseErrors int
	// Blocked counts blocks the review refused (a missing calendar, a bad
	// key, sheet fields that don't fit), kept apart from blocks whose
	// markdown would not parse.
	Blocked int
}

// ImportReview renders the review: the AI's requests as one list, each
// answered Yes or No, with the blocks that can't be used on top and one save
// bar. HTMX swaps it into #ai-import-review-host.
//
// hx-push-url registers a history entry on commit so browser Back
// after the result render lands on a fresh settings page rather than
// re-POSTing; review state is deliberately not restored.
templ ImportReview(d ImportReviewData) {
	{{ listed := listedCount(d) }}
	{{ startYes := startingYesCount(d) }}
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/ai_review.css") }/>
	<form
		id="ai-import-review"
		hx-post={ fmt.Sprintf("/campaigns/%s/ai-workspace/import/commit", d.CampaignID) }
		hx-target="#ai-import-review-host"
		hx-swap="innerHTML"
		hx-indicator="#ai-import-committing"
		hx-push-url={ fmt.Sprintf("/campaigns/%s/settings?tab=ai-workspace", d.CampaignID) }
		x-data={ fmt.Sprintf("aiImportReview(%d)", startYes) }
		@change="onChange($event)"
		@keydown.window="onKey($event)"
		data-engine-src={ d.EngineSrc }
		role="region"
		aria-labelledby="ai-import-review-heading"
		class="air card mt-4"
	>
		// Re-pass the original markdown source so the commit handler
		// can re-parse + match form fields by index, instead of
		// round-tripping every per-page body as a hidden field.
		<input type="hidden" name="markdown_source" value={ d.MarkdownSource }/>

		// `sr-only focus:not-sr-only` lets keyboard-only operators
		// jump straight to Apply; invisible to sighted operators.
		<a
			href="#ai-import-submit"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:bg-accent-fill focus:text-on-accent focus:px-3 focus:py-1.5 focus:rounded focus:text-xs"
		>
			Skip to Apply
		</a>

		<div class="air-body">
			<div class="air-head">
				<h3 id="ai-import-review-heading">
					From your AI · { strconv.Itoa(d.SummaryCounts.Total) } { pluralize("request", "requests", d.SummaryCounts.Total) }
				</h3>
				<span class="air-tally">
					{ fmt.Sprintf("%d %s", d.SummaryCounts.Conflicts, pluralize("conflict", "conflicts", d.SummaryCounts.Conflicts)) } ·
					{ fmt.Sprintf("%d new %s", d.SummaryCounts.NewCategories, pluralize("category", "categories", d.SummaryCounts.NewCategories)) } ·
					{ fmt.Sprintf("%d parse %s", d.SummaryCounts.ParseErrors, pluralize("error", "errors", d.SummaryCounts.ParseErrors)) }
					if d.SummaryCounts.Blocked > 0 {
						· { fmt.Sprintf("%d can't be imported", d.SummaryCounts.Blocked) }
					}
				</span>
			</div>

			@reviewProblemsBox(d)

			if listed > 0 {
				<div class="air-tools">
					<span class="air-small">Keys: <kbd>J</kbd> <kbd>K</kbd> move, <kbd>Y</kbd> <kbd>N</kbd> answer</span>
					<span class="air-fill"></span>
					<button type="button" class="air-quiet" @click="answerAll(true)" aria-label="Answer Yes to every request except removals">Yes to all but removals</button>
					<button type="button" class="air-quiet" @click="answerAll(false)" aria-label="Answer No to every request">No to all</button>
				</div>
			}
			if len(usablePages(d)) > 0 {
				@bulkDefaultsBar(d)
			}

			if listed > 0 {
				<div role="list" aria-label="Changes the AI asks for">
					if pages := usablePages(d); len(pages) > 0 {
						<div class="air-group" aria-hidden="true">
							<h4>Pages</h4>
							<span class="air-small">{ strconv.Itoa(len(pages)) }</span>
						</div>
						for _, i := range pages {
							@reviewRow(d.CampaignID, i, d.Pages[i], d.Classes[i], d)
						}
					}
					for _, g := range recordGroups(d) {
						<div class="air-group" aria-hidden="true">
							<h4>{ g.Label }</h4>
							<span class="air-small">{ strconv.Itoa(len(g.Rows)) }</span>
						</div>
						for _, r := range g.Rows {
							@reviewRecordRow(d.CampaignID, r)
						}
					}
				</div>
			} else {
				<p class="air-small">Nothing in this paste can be used yet. Fix the blocks above in your AI's answer and paste it again.</p>
			}
		</div>

		<div class="air-savebar">
			<span id="ai-import-count" class="air-count" role="status" aria-live="polite">
				<b x-text="yes">{ strconv.Itoa(startYes) }</b>
				<b>{ " of " + strconv.Itoa(listed) }</b>
				{ pluralize(" change", " changes", listed) } will be made<span x-show="removals > 0" x-cloak>, including <b class="air-bad" x-text="removals === 1 ? '1 removal' : removals + ' removals'"></b></span>.
			</span>
			<span id="ai-import-committing" class="htmx-indicator air-small" role="status" aria-live="polite">
				<i class="fa-solid fa-spinner fa-spin mr-1" aria-hidden="true"></i> Applying...
			</span>
			// Navigates (boosted full-page move) rather than hx-targeting
			// the settings route into the review host: that route
			// renders a full page (no fragment branch), so
			// fragment-targeting it would nest the app inside itself.
			<a
				href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/settings?tab=ai-workspace", d.CampaignID)) }
				class="btn-secondary"
				aria-label="Discard the paste and return to the import form"
			>
				Discard the paste
			</a>
			// Apply POSTs to /ai-workspace/import/commit, which makes every
			// change answered Yes, then swaps in the import_result fragment.
			<button
				id="ai-import-submit"
				type="submit"
				class="btn-primary"
				disabled?={ listed == 0 }
				:disabled="yes === 0"
			>
				Apply
			</button>
		</div>
	</form>
}

// reviewProblemsBox lists the blocks that can't be used, above the list.
// They are never saved; each says where it is in the paste and what is
// wrong, so the operator can fix it in the AI's answer.
templ reviewProblemsBox(d ImportReviewData) {
	if probs := reviewProblems(d); len(probs) > 0 {
		<div class="air-problems" role="region" aria-labelledby="ai-import-problems-heading">
			<h4 id="ai-import-problems-heading">
				{ strconv.Itoa(len(probs)) } { pluralize("block", "blocks", len(probs)) } from the AI can't be used, and will be left out
			</h4>
			for _, p := range probs {
				<div class="air-problem" role="alert">
					<span class="air-where">{ fmt.Sprintf("Block %d", p.Block) }</span>
					<span class="air-say">
						<i class="fa-solid fa-circle-xmark mr-1" aria-hidden="true"></i>
						{ p.Say }
					</span>
				</div>
			}
		</div>
	}
}

// pluralize returns singular when n==1, plural otherwise.
func pluralize(singular, plural string, n int) string {
	if n == 1 {
		return singular
	}
	return plural
}

// countRowsForProposedSlug counts how many included rows reference
// the same new-category slug, for the "applies to N rows" hint so
// an operator picking Create-vs-Map sees the downstream impact.
func countRowsForProposedSlug(d ImportReviewData, slug string) int {
	n := 0
	for _, c := range d.Classes {
		if c.IsNewCategory && c.ProposedTypeSlug == slug {
			n++
		}
	}
	return n
}

// bulkDefaultsBar folds the defaults for every page under a quiet word:
// most pastes need none of it, and the list stays the first thing seen.
templ bulkDefaultsBar(d ImportReviewData) {
	<details class="air-defaults" role="region" aria-labelledby="ai-import-bulk-heading">
		<summary id="ai-import-bulk-heading" class="air-quiet">Defaults for every page</summary>
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
			<label class="space-y-1">
				<span class="block text-fg-muted">Default category (for rows without front-matter)</span>
				<select name="bulk_default_category" class="input text-xs w-full" aria-label="Default category to apply to rows without front-matter">
					<option value="">— pick one —</option>
					if len(d.Classes) > 0 {
						for _, et := range d.Classes[0].AvailableTypes {
							<option value={ et.Slug }>{ et.Name }</option>
						}
					}
				</select>
			</label>
			<label class="space-y-1">
				<span class="block text-fg-muted">Default visibility</span>
				<select name="bulk_default_visibility" class="input text-xs w-full" aria-label="Default visibility for new entities">
					<option value="" selected>Campaign default</option>
					<option value="private">Private</option>
					<option value="dm_only">{ layouts.GMTerm(ctx) }-only</option>
					<option value="public">Public</option>
				</select>
			</label>
			<label class="space-y-1">
				<span class="block text-fg-muted">Default conflict mode</span>
				<select name="bulk_default_conflict" class="input text-xs w-full" aria-label="Default action when a row's name conflicts with an existing entity">
					<option value="rename" selected>Rename (suffix)</option>
					<option value="skip">Skip</option>
					<option value="overwrite">Overwrite existing</option>
				</select>
			</label>
		</div>
		// Pure client-side ops via the form's Alpine factory; no
		// server round-trip until Apply.
		<div class="flex flex-wrap items-center gap-3 pt-2">
			<button
				type="button"
				class="air-quiet"
				@click="applyDefaultsToAll()"
				aria-label="Apply the bulk defaults above to every row"
			>
				Use these on every page
			</button>
			if d.SummaryCounts.Conflicts > 0 {
				<button
					type="button"
					class="air-quiet"
					@click="skipAllConflicts()"
					aria-label="Set every name-conflict row to Skip"
				>
					Skip every name conflict
				</button>
			}
		</div>
	</details>
}

// reviewRow is one page the AI asks to add, change or remove: the verb, the
// change in one line, the detail and the AI's reason, and a Yes / No at the
// end. The controls that tune the row fold under "Change the details".
//
// The data parameter is the full ImportReviewData so the row can
// compute its "applies to N rows" hint without per-row pre-
// aggregation in the handler.
templ reviewRow(campaignID string, idx int, page importer.ParsedPage, cls importer.Classification, data ImportReviewData) {
	{{ verb := pageVerb(page.FrontMatter.Action) }}
	{{ problem := cls.Status == importer.StatusActionMismatch || cls.Status == importer.StatusParentProblem }}
	<div
		role="listitem"
		tabindex="-1"
		data-air-row
		data-air-verb={ verb }
		if problem {
			data-air-hold
		}
		if cls.GMOnly.Any() && page.FrontMatter.Action != importer.ActionDelete {
			data-air-gm
		}
		if page.FrontMatter.Visibility == "dm_only" {
			data-dm-only
		}
		aria-label={ fmt.Sprintf("Page %d: %s", idx+1, statusLabel(cls.Status)) }
		class="air-row"
	>
		<span class={ verbClass(verb) }>{ verb }</span>
		<div class="air-main">
			<span class="air-what">{ pageWhatLead(page) } <b>{ page.Name }</b></span>
			if line := pageDetail(page, cls); line != "" {
				<span class="air-line">{ line }</span>
			}
			if page.FrontMatter.KnownAs != "" {
				<span class="air-line">{ "Known as " + page.FrontMatter.KnownAs + " in that era" }</span>
			}
			@reviewRowMeta(page)
			if cls.FieldsSummary != "" {
				<span class="air-line">{ cls.FieldsSummary }</span>
			}
			if cls.ConflictEntity != nil {
				<span class="air-line">
					<i class="fa-solid fa-triangle-exclamation mr-1" aria-hidden="true"></i>
					A page called { cls.ConflictEntity.Name } already exists. This one gets a new name unless you pick otherwise in the details.
				</span>
			}
			if problem {
				<span class="air-line air-bad" role="alert">
					<i class="fa-solid fa-circle-xmark mr-1" aria-hidden="true"></i>
					{ cls.Reason }
				</span>
			}
			if page.FrontMatter.Reason != "" {
				<span class="air-line">AI's reason: <i>{ page.FrontMatter.Reason }</i></span>
			}
			// A page with GM-only parts: any row that ends up replacing its
			// text needs the tick (the details can turn a row into an
			// update after this renders, so every non-delete row shows it).
			if cls.GMOnly.Any() && page.FrontMatter.Action != importer.ActionDelete {
				@reviewRowGMOnlyConfirm(idx, page.Name, cls.GMOnly)
			}
			if page.FrontMatter.Action == importer.ActionDelete {
				@reviewRowDeleteConfirm(idx, page.Name, page.FrontMatter.EraName())
			}
			if len(page.Warnings) > 0 {
				<details class="air-more">
					<summary>{ fmt.Sprintf("%d %s", len(page.Warnings), pluralize("warning", "warnings", len(page.Warnings))) }</summary>
					<ul class="list-disc ml-4 space-y-0.5 air-line">
						for _, w := range page.Warnings {
							<li>{ w }</li>
						}
					</ul>
				</details>
			}
			<details class="air-more" open?={ problem }>
				<summary>Change the details</summary>
				@reviewRowHeader(idx, page)
				// An era version has no category, visibility or conflict of
				// its own: those belong to the usual page.
				if !page.FrontMatter.IsEra() {
					@reviewRowFields(idx, page, cls, data)
				}
			</details>
		</div>
		@yesNo(fmt.Sprintf("page_%d_include", idx), pageStartsYes(page, cls), fmt.Sprintf("%s %s", pageWhatLead(page), page.Name))
	</div>
}

// yesNo is a row's answer, a two-part segmented control over one radio
// pair. "on" is what the committer reads as Yes, so No posts "off".
templ yesNo(name string, startYes bool, what string) {
	<div class="air-yn" role="radiogroup" aria-label={ "Make this change: " + what }>
		<label class="air-y">
			<input type="radio" name={ name } value="on" checked?={ startYes }/>
			Yes
		</label>
		<label class="air-n">
			<input type="radio" name={ name } value="off" checked?={ !startYes }/>
			No
		</label>
	</div>
}

// reviewRowDeleteConfirm is the "removed for good" tick on a removal. It
// shows once the row is answered Yes, and the page script makes it required
// then, so Apply can't send a removal without it; the committer re-checks
// DeleteConfirmed independently against any client-side bypass.
templ reviewRowDeleteConfirm(idx int, name, era string) {
	<label class="air-confirm">
		<input
			type="checkbox"
			name={ fmt.Sprintf("page_%d_delete_confirmed", idx) }
			data-air-confirm
			class="mt-0.5 rounded"
			aria-label={ fmt.Sprintf("I confirm permanent deletion of %s", name) }
		/>
		if era != "" {
			<span>
				I understand the <strong>{ era }</strong> version of <strong>{ name }</strong> will be permanently deleted.
				The usual page stays. This cannot be undone.
			</span>
		} else {
			<span>
				I understand <strong>{ name }</strong> will be permanently deleted.
				This cannot be undone.
			</span>
		}
	</label>
}

// reviewRowGMOnlyConfirm is the "Replace the text anyway" tick for a page
// whose current text has GM-only parts. Unticked by default and not
// `required`: leaving it unticked is a valid choice (the row is skipped), and
// the committer re-checks the tick against the live page either way.
templ reviewRowGMOnlyConfirm(idx int, name string, gm importer.GMOnlyParts) {
	<div class="air-line" role="group" aria-label={ fmt.Sprintf("%s-only parts of %s", layouts.GMTerm(ctx), name) }>
		<p>
			<i class="fa-solid fa-eye-slash mr-1" aria-hidden="true"></i>
			{ gm.Warning() }
		</p>
		<label class="flex items-start gap-2 cursor-pointer mt-1 text-fg">
			<input
				type="checkbox"
				name={ fmt.Sprintf("page_%d_replace_gm_confirmed", idx) }
				data-air-gm-tick
				class="mt-0.5 rounded"
			/>
			<span>Replace the text anyway</span>
		</label>
		<p class="mt-1">
			Any { layouts.GMTerm(ctx) }-only words the AI copied into its text will be visible to players.
		</p>
	</div>
}

// reviewRowMeta renders the read-only tags + subcategory line for
// successfully-parsed rows. Emits nothing when both are empty, to
// avoid stale-empty whitespace.
templ reviewRowMeta(page importer.ParsedPage) {
	if len(page.FrontMatter.Tags) > 0 || page.FrontMatter.Subcategory != "" {
		<div class="flex flex-wrap items-center gap-1.5">
			if page.FrontMatter.Subcategory != "" {
				<span class="text-[11px] text-fg-muted">
					<i class="fa-solid fa-folder-tree text-[9px] mr-1" aria-hidden="true"></i>
					{ page.FrontMatter.Subcategory }
				</span>
			}
			for _, t := range page.FrontMatter.Tags {
				<span class="text-[11px] text-fg-muted">
					<i class="fa-solid fa-tag text-[9px] mr-1" aria-hidden="true"></i>
					{ t }
				</span>
			}
		</div>
	}
}

// statusLabel returns a one-word a11y label for the row's status.
// Used by the row's aria-label so screen-reader output is
// "Page 3: Name conflict" not just "Page 3".
func statusLabel(s importer.ParseStatus) string {
	switch s {
	case importer.StatusNew:
		return "New page"
	case importer.StatusConflict:
		return "Name conflict"
	case importer.StatusNewCategory:
		return "New category"
	case importer.StatusParseError:
		return "Parse error"
	case importer.StatusActionMismatch:
		return "Action target missing"
	case importer.StatusParentProblem:
		return "Parent or folder problem"
	case importer.StatusFieldProblem:
		return "Sheet fields problem"
	default:
		return "Page"
	}
}

// reviewRowHeader is the name field and the action the row takes, so the
// operator can rename or change what the AI asked without re-pasting.
templ reviewRowHeader(idx int, page importer.ParsedPage) {
	<div class="flex items-center gap-2">
		<input
			type="text"
			name={ fmt.Sprintf("page_%d_name", idx) }
			value={ page.Name }
			placeholder="Page name"
			class="input text-sm flex-1 min-w-0"
			aria-label={ fmt.Sprintf("Page %d name (editable)", idx+1) }
		/>
		@reviewRowActionChip(idx, page.FrontMatter.Action)
	</div>
}

// reviewRowActionChip is the row's action as a picker.
templ reviewRowActionChip(idx int, action string) {
	<select
		name={ fmt.Sprintf("page_%d_action", idx) }
		class="input text-xs"
		aria-label={ fmt.Sprintf("Action verb for page %d", idx+1) }
	>
		@actionOption(importer.ActionCreate, "Add", action)
		@actionOption(importer.ActionUpdate, "Change", action)
		@actionOption(importer.ActionDelete, "Remove", action)
	</select>
}

// actionOption renders one option in the Action chip select, pre-
// selected when the value matches the row's current action.
templ actionOption(value, label, currentAction string) {
	if currentAction == value || (currentAction == "" && value == importer.ActionCreate) {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// reviewRowFields renders the per-row Category / Visibility /
// Conflict-mode controls. New-category rows get the explicit
// radio-pair surface (Create new / Map to existing); other rows
// keep the plain dropdown.
templ reviewRowFields(idx int, page importer.ParsedPage, cls importer.Classification, data ImportReviewData) {
	<div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mt-2 text-xs">
		// Category control. For new-category rows we hand off to the
		// radio surface so the operator can explicitly choose
		// Create-new vs Map-to-existing; for everything else a plain
		// dropdown is fine.
		if cls.IsNewCategory {
			@newCategoryControl(idx, page, cls, data)
		} else {
			<label class="space-y-0.5">
				<span class="block text-fg-muted">Category</span>
				<select
					name={ fmt.Sprintf("page_%d_category", idx) }
					class="input text-xs w-full"
					aria-label={ fmt.Sprintf("Category for page %d", idx+1) }
				>
					for _, et := range cls.AvailableTypes {
						if cls.ExistingType != nil && et.ID == cls.ExistingType.ID {
							<option value={ et.Slug } selected>{ et.Name }</option>
						} else {
							<option value={ et.Slug }>{ et.Name }</option>
						}
					}
				</select>
			</label>
		}

		// Visibility dropdown.
		<label class="space-y-0.5">
			<span class="block text-fg-muted">Visibility</span>
			<select
				name={ fmt.Sprintf("page_%d_visibility", idx) }
				class="input text-xs w-full"
				aria-label={ fmt.Sprintf("Visibility for page %d", idx+1) }
			>
				@visibilityOption(idx, "", "Campaign default", page.FrontMatter.Visibility)
				@visibilityOption(idx, "private", "Private", page.FrontMatter.Visibility)
				@visibilityOption(idx, "dm_only", layouts.GMTerm(ctx) + "-only", page.FrontMatter.Visibility)
				@visibilityOption(idx, "public", "Public", page.FrontMatter.Visibility)
			</select>
		</label>

		// Conflict mode (only when there's a conflict).
		if cls.ConflictEntity != nil {
			<label class="space-y-0.5">
				<span class="block text-fg-muted">Conflict mode</span>
				<select
					name={ fmt.Sprintf("page_%d_conflict", idx) }
					class="input text-xs w-full"
					aria-label={ fmt.Sprintf("How to handle the name conflict for page %d", idx+1) }
				>
					<option value="rename" selected>Rename (suffix)</option>
					<option value="skip">Skip</option>
					<option value="overwrite">Overwrite</option>
				</select>
				<span class="block text-[10px] text-fg-muted mt-0.5">
					Exists as: { cls.ConflictEntity.Name }
				</span>
			</label>
		} else {
			<div></div>
		}
	</div>
}

// newCategoryControl renders the Create-new / Map-to-existing radio
// surface for rows whose front-matter proposes an unknown entity-
// type slug. The hidden input keeps the form-encoded value
// compatible with the commit handler's importer.parseNewCategorySpec,
// which reads `page_N_category` as either an existing slug or the
// "new:<slug>" sentinel.
templ newCategoryControl(idx int, page importer.ParsedPage, cls importer.Classification, data ImportReviewData) {
	{{ shared := countRowsForProposedSlug(data, cls.ProposedTypeSlug) }}
	<div
		class="space-y-1"
		x-data={ fmt.Sprintf(`{ catMode: 'new', mapTarget: '%s' }`, firstExistingSlug(cls)) }
		role="radiogroup"
		aria-label={ fmt.Sprintf("Category resolution for page %d", idx+1) }
	>
		<span class="block text-fg-muted">Category</span>
		<label class="flex items-start gap-1.5 cursor-pointer">
			<input
				type="radio"
				value="new"
				x-model="catMode"
				class="mt-0.5 border-edge text-accent"
				aria-label={ fmt.Sprintf("Create a new %q category", cls.ProposedTypeSlug) }
			/>
			<span class="text-[11px]">
				<i class="fa-solid fa-folder-plus mr-0.5 text-accent" aria-hidden="true"></i>
				Create new:&nbsp;<code class="text-accent">{ cls.ProposedTypeSlug }</code>
			</span>
		</label>
		<label class="flex items-start gap-1.5 cursor-pointer">
			<input
				type="radio"
				value="existing"
				x-model="catMode"
				class="mt-0.5 border-edge text-accent"
				aria-label="Map this page to an existing category instead of creating a new one"
			/>
			<span class="text-[11px] flex-1">
				Map to existing:
				<select
					x-model="mapTarget"
					:disabled="catMode !== 'existing'"
					class="input text-[11px] inline-block ml-1 max-w-[12rem]"
					aria-label="Existing category to map this page to"
				>
					for _, et := range cls.AvailableTypes {
						<option value={ et.Slug }>{ et.Name }</option>
					}
				</select>
			</span>
		</label>
		// Hidden input the form encodes. Value matches the commit
		// handler's expectations: "new:<slug>" → category creation;
		// bare existing slug → map.
		<input
			type="hidden"
			name={ fmt.Sprintf("page_%d_category", idx) }
			:value={ fmt.Sprintf(`catMode === 'new' ? 'new:%s' : mapTarget`, cls.ProposedTypeSlug) }
		/>
		if shared > 1 {
			<div class="text-[10px] text-accent mt-0.5">
				<i class="fa-solid fa-circle-info mr-0.5" aria-hidden="true"></i>
				Creating &quot;{ cls.ProposedTypeSlug }&quot; will apply to { strconv.Itoa(shared) } { pluralize("row", "rows", shared) }.
			</div>
		}
	</div>
}

// firstExistingSlug returns a sensible default for the "map to
// existing" dropdown — preferring the parser's pre-selected type
// when one exists, otherwise the first available type's slug.
func firstExistingSlug(cls importer.Classification) string {
	if cls.ExistingType != nil {
		return cls.ExistingType.Slug
	}
	if len(cls.AvailableTypes) > 0 {
		return cls.AvailableTypes[0].Slug
	}
	return ""
}

// visibilityOption renders one <option> with the front-matter
// value pre-selected when matching.
templ visibilityOption(idx int, value, label, fmValue string) {
	if fmValue == value {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// importBody renders the paste textarea + optional file upload
// (via the markdown_importer.js widget) + Parse button. POST →
// review fragment swap. Per-textarea Alpine state computes a live
// character counter (5 MB cap mirrored client-side; the server
// enforces it too, in handler.go's importBodyCap).
templ importBody(cc *campaigns.CampaignContext) {
	<div>
		<form
			hx-post={ fmt.Sprintf("/campaigns/%s/ai-workspace/import/parse", cc.Campaign.ID) }
			hx-target="#ai-import-review-host"
			hx-swap="innerHTML"
			hx-indicator="#ai-import-parsing"
			hx-encoding="multipart/form-data"
			class="space-y-3"
			x-data="{ pasted: '', maxChars: 5242880 /* 5 MB in bytes; matches handler.go importBodyCap */ }"
		>
			<div
				data-widget="markdown-importer"
				data-textarea-name="markdown_paste"
				data-file-input-name="markdown_files"
				class="space-y-3"
			>
				<label for="ai-import-paste-area" class="sr-only">Paste AI-generated markdown here</label>
				<textarea
					id="ai-import-paste-area"
					name="markdown_paste"
					rows="10"
					placeholder="Paste what your AI gave you: pages and changes, or a lookup..."
					class="input w-full text-sm font-mono"
					x-model="pasted"
					maxlength="5242880"
					aria-describedby="ai-import-char-counter"
				></textarea>

				// 5 MB cap mirrors handler.go's importBodyCap; counter
				// turns rose within 10% of the limit so the operator
				// notices before the server rejects.
				<div
					id="ai-import-char-counter"
					class="text-[11px] text-right"
					:class="pasted.length > maxChars * 0.9 ? 'text-rose-600 dark:text-rose-400' : 'text-fg-muted'"
					role="status"
					aria-live="polite"
				>
					<span x-text="pasted.length.toLocaleString()"></span>
					<span class="text-fg-muted">/ 5,242,880 characters</span>
					<span x-show="pasted.length > maxChars * 0.9" x-cloak class="ml-1">
						<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
						Approaching limit
					</span>
				</div>

				<div
					data-importer-dropzone
					class="border-2 border-dashed border-edge rounded-lg p-4 text-center text-xs text-fg-muted hover:border-accent transition-colors"
					role="region"
					aria-label="Drop .md files here, or use the file picker below"
				>
					<i class="fa-solid fa-cloud-arrow-up mr-1" aria-hidden="true"></i>
					Drag and drop .md files here.
				</div>
				// Visible (not hidden under the drop zone) so
				// keyboard-only operators can reach the picker.
				<label class="flex items-center gap-2 text-xs">
					<span class="text-fg-muted">Or pick files:</span>
					<input
						type="file"
						name="markdown_files"
						accept=".md,.markdown,text/markdown"
						multiple
						class="text-xs file:btn-secondary file:mr-2 file:text-xs"
						data-importer-file-input
						aria-label="Choose one or more markdown files to import"
					/>
				</label>
				// sr-only live region announces file-list updates to
				// assistive tech without duplicating the visible list.
				<div data-importer-file-list class="text-xs text-fg-muted space-y-1"></div>
				<div data-importer-file-announce class="sr-only" role="status" aria-live="polite"></div>
			</div>

			<div class="flex items-center gap-3">
				<button type="submit" class="btn-primary">
					<i class="fa-solid fa-file-import mr-1.5" aria-hidden="true"></i> Parse + review
				</button>
				<span id="ai-import-parsing" class="htmx-indicator text-xs text-fg-muted" role="status" aria-live="polite">
					<i class="fa-solid fa-spinner fa-spin mr-1" aria-hidden="true"></i> Parsing...
				</span>
			</div>
		</form>

		<div id="ai-import-review-host"></div>
	</div>
	@importReviewScript()
}

// importReviewScript defines the review screen's Alpine x-data factory
// with the page, not inside the swapped-in review: Alpine reads x-data the
// moment htmx inserts the form, before htmx runs scripts that came with it,
// so a factory shipped in the fragment is always too late. The answers live
// in the form's own radios; the factory only counts them, keeps a removal's
// tick required while it is answered Yes, and adds J/K/Y/N.
templ importReviewScript() {
	<script>
		(function () {
			if (window.aiImportReview) { return; }
			function typing(ev) {
				var t = ev.target;
				return t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
			}
			function answer(row, yes) {
				var radio = row.querySelector('.air-yn input[value="' + (yes ? 'on' : 'off') + '"]');
				if (radio) { radio.checked = true; }
			}
			window.aiImportReview = function (startYes) {
				return {
					yes: startYes || 0,
					removals: 0,
					at: -1,
					init: function () { this.sync(); },
					rows: function () { return Array.prototype.slice.call(this.$root.querySelectorAll('[data-air-row]')); },
					// sync recounts the answers and makes each removal's tick
					// required exactly while that removal is answered Yes.
					sync: function () {
						var yes = 0, removals = 0;
						this.rows().forEach(function (row) {
							var on = !!row.querySelector('.air-y input:checked');
							var confirm = row.querySelector('[data-air-confirm]');
							if (confirm) { confirm.required = on; }
							var gm = row.hasAttribute('data-air-gm') ? row.querySelector('[data-air-gm-tick]') : null;
							if (on && !(gm && !gm.checked)) { yes++; }
							if (on && row.dataset.airVerb === 'Remove') { removals++; }
						});
						this.yes = yes;
						this.removals = removals;
					},
					onChange: function () { this.sync(); },
					answerAll: function (yes) {
						// Yes skips removals (set back to No) and rows held on No
						// because the AI's request can't go through as written.
						this.rows().forEach(function (row) {
							if (yes && row.hasAttribute('data-air-hold')) { return; }
							answer(row, yes && row.dataset.airVerb !== 'Remove');
						});
						this.sync();
					},
					onKey: function (ev) {
						if (typing(ev) || ev.ctrlKey || ev.metaKey || ev.altKey || !this.$root.isConnected) { return; }
						var k = (ev.key || '').toLowerCase();
						if ('jkyn'.indexOf(k) < 0 || k.length !== 1) { return; }
						var rows = this.rows();
						if (!rows.length) { return; }
						var cur = rows.indexOf(document.activeElement && document.activeElement.closest('[data-air-row]'));
						if (cur >= 0) { this.at = cur; }
						// Y and N answer only a row the operator has moved to, so
						// a stray key never answers the first row unseen.
						var picked = this.at >= 0;
						if (k === 'j') { this.at = Math.min(rows.length - 1, this.at + 1); }
						if (k === 'k') { this.at = Math.max(0, this.at - 1); }
						if (this.at < 0) { this.at = 0; }
						var row = rows[this.at];
						row.focus();
						row.scrollIntoView({ block: 'nearest' });
						if ((k === 'y' || k === 'n') && picked) { answer(row, k === 'y'); this.sync(); }
						ev.preventDefault();
					},
					applyDefaultsToAll: function () {
						var form = this.$root;
						var bulkCategory = form.querySelector('[name=bulk_default_category]')?.value || '';
						var bulkVisibility = form.querySelector('[name=bulk_default_visibility]')?.value || '';
						var bulkConflict = form.querySelector('[name=bulk_default_conflict]')?.value || '';
						form.querySelectorAll('select[name$="_category"]').forEach(function (sel) {
							if (sel.name === 'bulk_default_category') return;
							if (bulkCategory && Array.from(sel.options).some(function (o) { return o.value === bulkCategory; })) {
								sel.value = bulkCategory;
								sel.dispatchEvent(new Event('change'));
							}
						});
						form.querySelectorAll('select[name$="_visibility"]').forEach(function (sel) {
							if (sel.name === 'bulk_default_visibility') return;
							if (bulkVisibility) { sel.value = bulkVisibility; }
						});
						form.querySelectorAll('select[name$="_conflict"]').forEach(function (sel) {
							if (sel.name === 'bulk_default_conflict') return;
							if (bulkConflict) { sel.value = bulkConflict; }
						});
					},
					skipAllConflicts: function () {
						this.$root.querySelectorAll('select[name$="_conflict"]').forEach(function (sel) {
							if (sel.name === 'bulk_default_conflict') return;
							sel.value = 'skip';
						});
					},
				};
			};
		})();
	</script>
}

// ensure entities import is referenced (silences unused-import).
var _ = entities.Slugify
