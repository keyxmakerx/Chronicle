// ai_bubble.templ is the small bubble the AI button drops: copy and paste
// in one thin row at the top, then each waiting request with Review, which
// opens the side sheet. ai_chip.js wires the data-ai-* buttons.

package ai_workspace

import (
	"fmt"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// aiBubbleBody is the owner's bubble. The privacy line reads and writes the
// same remembered choice as the copy-and-paste tool (ai-sees-<campaign>).
templ aiBubbleBody(cc *campaigns.CampaignContext, v ConnectView) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/ai_page.css") }/>
	<div
		class="aib"
		x-data={ fmt.Sprintf(`{
			sees: 'safe', picking: false, storeKey: 'ai-sees-%s',
			init() {
				try { const s = localStorage.getItem(this.storeKey); if (s === 'safe' || s === 'permitted' || s === 'everything') this.sees = s; } catch (e) {}
				this.$watch('sees', (s) => { try { localStorage.setItem(this.storeKey, s); } catch (e) {} });
			},
			get seesWords() { return this.sees === 'everything' ? 'everything' : (this.sees === 'permitted' ? 'what you see' : 'what players see'); },
		}`, cc.Campaign.ID) }
		data-ai-sees-host
	>
		<header class="aib-head">
			if v.Available && hasKey(v) {
				<span class="aic-dot" data-state={ connStatus(v) } aria-hidden="true"></span>
				<h2 id="ai-bubble-heading" class="aib-title">{ statusTitle(v) }</h2>
			} else {
				<h2 id="ai-bubble-heading" class="aib-title">Your AI</h2>
			}
			<a class="aic-icon" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/ai", cc.Campaign.ID)) } data-ai-full title="Open Your AI" aria-label="Open the Your AI page">
				<i class="fa-solid fa-up-right-and-down-left-from-center text-xs" aria-hidden="true"></i>
			</a>
			<button type="button" class="aic-icon" data-ai-bubble-close aria-label="Close">
				<i class="fa-solid fa-xmark" aria-hidden="true"></i>
			</button>
		</header>
		@bubbleCopyRow(fmt.Sprintf("/campaigns/%s/ai/copy", cc.Campaign.ID), "Copy for my AI", true)
		if v.CutOff != nil {
			<p class="aib-alert" data-tone="stopped"><b>AI is stopped in this campaign.</b> Turn it back on from Your AI.</p>
		} else if len(v.Alerts) > 0 {
			<p class="aib-alert"><b>{ countOf(len(v.Alerts), "warning", "warnings") } about your key.</b> See them on Your AI.</p>
		}
		<section class="aib-list" aria-labelledby="ai-bubble-waiting">
			if len(v.Requests) > 0 {
				<p id="ai-bubble-waiting" class="aic-label">Waiting for you · { strconv.Itoa(len(v.Requests)) }</p>
				for i, q := range v.Requests {
					@bubbleRequest(q.ID, requestHeading(q), requestLine(v, q), i == 0)
				}
			} else {
				<p id="ai-bubble-waiting" class="aib-empty">Nothing waiting. When your AI asks for changes, they show up here.</p>
			}
		</section>
		<footer class="aib-foot">
			<p class="aib-sees" x-show="!picking">
				Copies <span x-text="seesWords">what players see</span> ·
				<button type="button" class="quiet-word" @click="picking = true">change</button>
			</p>
			<div class="aib-seg" x-show="picking" x-cloak role="radiogroup" aria-label="When you copy, what may your AI see?">
				<button type="button" role="radio" :aria-checked="sees === 'safe'" @click="sees = 'safe'; picking = false">What players see</button>
				<button type="button" role="radio" :aria-checked="sees === 'permitted'" @click="sees = 'permitted'; picking = false">What you see</button>
				<button type="button" role="radio" :aria-checked="sees === 'everything'" @click="sees = 'everything'; picking = false">Everything</button>
			</div>
			<a class="quiet-word aib-full" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/ai", cc.Campaign.ID)) } data-ai-full>Your AI page</a>
		</footer>
		<div data-ai-bubble-warn></div>
	</div>
}

// playerBubbleBody is a player's bubble: no privacy choice, since a player's
// copy only ever holds what they can see, and no full page to go to.
templ playerBubbleBody(v PlayerAIView) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/ai_page.css") }/>
	<div class="aib">
		<header class="aib-head">
			if v.Why == "" && playerConnected(v) {
				<span class="aic-dot" data-state={ playerConnState(v) } aria-hidden="true"></span>
				<h2 id="ai-bubble-heading" class="aib-title">{ playerConnLine(v) }</h2>
			} else {
				<h2 id="ai-bubble-heading" class="aib-title">Your AI</h2>
			}
			<button type="button" class="aic-icon" data-ai-bubble-close aria-label="Close">
				<i class="fa-solid fa-xmark" aria-hidden="true"></i>
			</button>
		</header>
		if v.Why != "" {
			<p class="aib-empty aib-pad">{ v.Why } When it's turned on, your AI can help with your character here.</p>
		} else {
			@bubbleCopyRow(fmt.Sprintf("/campaigns/%s/ai/me/copy", v.CampaignID), "Copy for my AI", false)
			<section class="aib-list" aria-labelledby="ai-bubble-waiting">
				if len(v.Requests) > 0 {
					<p id="ai-bubble-waiting" class="aic-label">Waiting for you · { strconv.Itoa(len(v.Requests)) }</p>
					for i, q := range v.Requests {
						@bubbleRequest(q.ID, requestHeading(q), playerRequestLine(v, q), i == 0)
					}
				} else {
					<p id="ai-bubble-waiting" class="aib-empty">Nothing waiting. When your AI asks to change your character, it shows up here.</p>
				}
			</section>
			if !playerConnected(v) {
				<footer class="aib-foot">
					<button type="button" class="quiet-word" data-ai-connect>Connect your AI app</button>
				</footer>
			}
		}
		<div data-ai-bubble-warn></div>
	</div>
}

// bubbleCopyRow is the thin row on top: Copy, Paste answer and, for the
// owner, "Write a request…". The Copy label says "Copy this page" on a page
// (ai_chip.js), whose id it sends. The status line under it says what
// happened, and carries the fallback when the browser won't share the
// clipboard.
templ bubbleCopyRow(copyURL, copyLabel string, owner bool) {
	<div class="aib-row">
		<button type="button" class="aib-tool" data-ai-copy={ copyURL } data-ai-copy-owner?={ owner }>
			<i class="fa-regular fa-copy" aria-hidden="true"></i>
			<span data-ai-copy-label>{ copyLabel }</span>
		</button>
		<button type="button" class="aib-tool" data-ai-paste>
			<i class="fa-regular fa-paste" aria-hidden="true"></i>
			<span>Paste answer</span>
		</button>
		if owner {
			<button type="button" class="quiet-word aib-write" data-ai-tool>Write a request…</button>
		}
	</div>
	<p class="aib-said" data-ai-said role="status" aria-live="polite" hidden></p>
	<form class="aib-paste" data-ai-paste-box hidden>
		<label for="ai-bubble-paste" class="aic-hint">Your browser kept the clipboard to itself. Paste the answer here instead:</label>
		<textarea id="ai-bubble-paste" rows="3" class="input w-full font-mono text-xs"></textarea>
		<button type="submit" class="btn-secondary btn-sm">Review</button>
	</form>
}

// bubbleRequest is one waiting request: its heading, one line, and Review,
// which opens the side sheet on it. The newest one's Review is the primary.
templ bubbleRequest(id int64, heading, line string, first bool) {
	<div class="aib-req">
		<div class="aib-req-text">
			<b>{ heading }</b>
			<span class="aic-hint">{ line }</span>
		</div>
		<button
			type="button"
			if first {
				class="btn-primary btn-sm"
			} else {
				class="btn-secondary btn-sm"
			}
			data-ai-review={ strconv.FormatInt(id, 10) }
		>Review</button>
	</div>
}
