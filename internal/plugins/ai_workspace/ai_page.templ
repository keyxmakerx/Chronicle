// ai_page.templ is the campaign's Your AI page: connect an AI app, answer
// what it asks for, see what it did, or use copy and paste.

package ai_workspace

import (
	"fmt"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/plugins/ai_workspace/aiexport"
	"github.com/keyxmakerx/chronicle/internal/plugins/ai_workspace/connector"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// AIPageView is the whole page: what the AI asked for and did on the left,
// its connection and copy and paste on the right, and copy and paste itself
// in an overlay, so neither crowds the other.
templ AIPageView(cc *campaigns.CampaignContext, v ConnectView) {
	@layouts.App(cc.Campaign.Name + " - Your AI") {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/ai_page.css") }/>
		<div class="max-w-6xl mx-auto px-4 py-6" data-ai-page x-data @htmx:before-request={ aiPageReviews }>
			@layouts.ManageHeader("Your AI")
			<p class="-mt-4 mb-6 text-sm text-fg-secondary max-w-prose">
				Connect your AI app once. It reads what you allow and asks for changes here, and you say yes or no to each one. No copying back and forth.
			</p>
			@aiConnectSection(v)
			@aiCopyPasteOverlay(cc)
		</div>
	}
}

// aiPageReviews empties every other request's review when a review starts
// loading, here or in copy and paste.
const aiPageReviews = `const t = $event.detail.target; if (t && (t.id === 'ai-import-review-host' || t.classList.contains('aic-req-review'))) document.querySelectorAll('.aic-req-review').forEach((h) => { if (h !== t) h.innerHTML = '' })`

// aiConnectSection is the part the connect, pause, change, new-key and
// disconnect requests swap. With a working key, setup sits in the side
// column; without one, making a key takes the main column. The requests and
// the history stay after a disconnect, since they are the owner's.
templ aiConnectSection(v ConnectView) {
	<div id="ai-connect" x-data="{ renew: false }">
		if hasKey(v) {
			<div class="aic-grid">
				<div class="aic-area-req space-y-4">
					<div id={ requestResultHost }></div>
					@aiRequests(v, false)
					<div x-show="renew" x-cloak x-collapse.duration.200ms>
						@aiConnectForm(v, true)
					</div>
				</div>
				<div class="aic-area-side space-y-4">
					@aiStatus(v)
					if v.Notes != nil {
						@aiNotesPanel(*v.Notes)
					}
					@aiCopyCard()
				</div>
				<div class="aic-area-hist">
					@aiActivityList(v)
				</div>
			</div>
		} else {
			<div class="space-y-8">
				<div class="space-y-4">
					<div id={ requestResultHost }></div>
					@aiRequests(v, false)
				</div>
				if !v.Available {
					<section class="aic-panel">
						<p class="text-sm text-fg-secondary">Connecting an AI app isn't available on this Chronicle site. Copy and paste works with every AI.</p>
					</section>
				} else if v.NewKey != "" {
					@aiNewKey(v)
				} else {
					@aiConnectForm(v, false)
				}
				if v.Notes != nil {
					@aiNotesPanel(*v.Notes)
				}
				@aiCopyCard()
				if v.Available && len(v.Sittings) > 0 {
					@aiActivityList(v)
				}
			</div>
		}
	</div>
}

// aiCopyCard opens copy and paste over the page.
templ aiCopyCard() {
	<section class="aic-panel space-y-1" aria-labelledby="ai-copy-card-heading">
		<h2 id="ai-copy-card-heading" class="aic-h">Copy and paste</h2>
		<p class="aic-hint">For any AI that can't connect. Copy what it needs, paste its answer back, and review it here.</p>
		<a href="#copy-and-paste" class="inline-block pt-1 text-sm font-semibold text-accent hover:underline">Open copy and paste ›</a>
	</section>
}

// aiCopyPasteOverlay holds the copy-and-paste tool over the page. The
// address's #copy-and-paste opens it, so a reload or the back button keeps
// or closes it as expected. Its own pop-ups sit above it, and Escape closes
// those first.
templ aiCopyPasteOverlay(cc *campaigns.CampaignContext) {
	<div
		x-data="{
			cp: false,
			back: null,
			sync() {
				const open = location.hash === '#copy-and-paste';
				if (open && !this.cp) { this.back = document.activeElement; setTimeout(() => this.$refs.close.focus(), 30); }
				if (!open && this.cp && this.back) { this.$nextTick(() => this.back.focus && this.back.focus()); }
				this.cp = open;
			},
			close() {
				if (location.hash === '#copy-and-paste') history.replaceState(null, '', location.pathname + location.search);
				this.sync();
			},
			popupOpen() {
				return [...this.$el.querySelectorAll('[role=dialog]')].some((d) => d !== this.$refs.sheet && d.offsetParent !== null);
			},
		}"
		x-init="sync()"
		@hashchange.window="sync()"
		x-effect="document.documentElement.classList.toggle('overflow-hidden', cp)"
	>
		<div
			x-show="cp"
			x-cloak
			x-transition:enter="aic-ov-enter"
			x-transition:enter-start="aic-ov-from"
			x-transition:leave="aic-ov-leave"
			x-transition:leave-end="aic-ov-from"
			class="aic-overlay"
			@click.self="close()"
			@keydown.escape.window.capture="if (cp && !popupOpen()) close()"
		>
			<div x-ref="sheet" class="aic-sheet" role="dialog" aria-modal="true" aria-labelledby="ai-copy-heading">
				<button type="button" x-ref="close" class="aic-icon aic-sheet-close" @click="close()" aria-label="Close copy and paste">
					<i class="fa-solid fa-xmark" aria-hidden="true"></i>
				</button>
				@aiCopyPasteSection(cc)
			</div>
		</div>
	</div>
}

// aiConnectForm is the choice of what the AI may see and how connecting
// works, ending in Make a key. replacing says a key exists and will stop.
templ aiConnectForm(v ConnectView, replacing bool) {
	<form
		hx-post={ fmt.Sprintf("/campaigns/%s/ai/connection", v.CampaignID) }
		hx-target="#ai-connect"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type=submit]"
		class="grid gap-5 md:grid-cols-2 items-start"
		aria-label="Connect your AI app"
	>
		<section class="aic-panel space-y-3" aria-labelledby="ai-sees-heading">
			<h2 id="ai-sees-heading" class="aic-h">What may your AI see?</h2>
			<label class="aic-choice">
				<input type="radio" name="sees" value="players" checked/>
				<span>
					<b>What players see</b>
					<span class="block aic-hint">Safest. No secrets, and nothing you keep from players.</span>
				</span>
			</label>
			<label class="aic-choice">
				<input type="radio" name="sees" value="owner"/>
				<span>
					<b>What you see</b>
					<span class="block aic-hint">Adds your { layouts.GMTerm(ctx) }-only pages and secrets. Only for an AI you trust, since text your players wrote could try to talk it into sharing them.</span>
				</span>
			</label>
			<div class="space-y-1 border-t border-edge pt-3" role="radiogroup" aria-labelledby="ai-change-heading">
				<h3 id="ai-change-heading" class="aic-label">Change</h3>
				<label class="aic-choice">
					<input type="radio" name="change" value="ask" checked/>
					<span>
						<b>Ask for changes</b>
						<span class="block aic-hint">Each one waits here for your yes.</span>
					</span>
				</label>
				<label class="aic-choice">
					<input type="radio" name="change" value="look"/>
					<span>
						<b>Only look</b>
						<span class="block aic-hint">It can read and answer, never ask to change.</span>
					</span>
				</label>
			</div>
			<p class="aic-hint flex gap-2 items-start">
				<i class="fa-solid fa-lock mt-0.5" aria-hidden="true"></i>
				<span>It can only ask. Every change and removal waits here for your yes, even if your AI app is set to allow everything. ChatGPT Plus and Pro only let connectors read, so there your AI gives you its changes to paste instead.</span>
			</p>
		</section>
		<section aria-labelledby="ai-how-heading">
			<h2 id="ai-how-heading" class="aic-h pb-2">Connect it</h2>
			<div class="aic-step">
				<span class="aic-num">1</span>
				<span><b class="text-fg">Make a key</b><span class="block aic-hint">Chronicle gives you an address and a key for your AI app.</span></span>
			</div>
			<div class="aic-step">
				<span class="aic-num">2</span>
				<span><b class="text-fg">In your AI app, add a connector</b><span class="block aic-hint">Claude calls it a custom connector. Other apps may call it an MCP server.</span></span>
			</div>
			<div class="aic-step">
				<span class="aic-num">3</span>
				<span><b class="text-fg">Paste the address and the key</b><span class="block aic-hint">You see the key once. It runs out after 90 days, and you can disconnect it here any time.</span></span>
			</div>
			<div class="flex flex-wrap items-center gap-3 pt-4">
				<button type="submit" class="btn-primary">
					<span class="aic-idle"><i class="fa-solid fa-key mr-1.5" aria-hidden="true"></i>Make a key</span>
					<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Making…</span>
				</button>
				if replacing {
					<span class="aic-hint">Your AI's current key stops working.</span>
				} else if connStatus(v) == "ended" {
					<span class="aic-hint">Your AI's last key ran out. Make a new one to connect again.</span>
				}
			</div>
		</section>
	</form>
}

// aiNewKey shows the address and the new key, once, with how to add them in
// each kind of app.
templ aiNewKey(v ConnectView) {
	<section
		class="aic-panel aic-key space-y-4"
		aria-labelledby="ai-key-heading"
		x-data="{ app: 'claude', copied: '' }"
	>
		<div>
			<h2 id="ai-key-heading" class="aic-h">Your key is ready</h2>
			<p class="aic-hint">Copy it now: Chronicle shows it only this once. If you lose it, make a new one. Your AI { seesLabel(v.Conn.Privacy) } and { changeLabel(v.Conn.CanAsk) }.</p>
		</div>
		<div class="grid gap-3 md:grid-cols-2">
			@aiCopyField("addr", "Address", v.Endpoint)
			@aiCopyField("key", "Key", v.NewKey)
		</div>
		<div>
			<div class="aic-tabs" role="tablist" aria-label="How to add it">
				@aiAppTab("claude", "In Claude")
				@aiAppTab("code", "In Claude Code")
				@aiAppTab("other", "Other apps")
			</div>
			<div class="aic-drawer" role="tabpanel" x-show="app === 'claude'">
				<ol>
					<li>Open Customize, then Connectors, then Add custom connector.</li>
					<li>Name it Chronicle and paste the address above as the server URL.</li>
					<li>For sign-in, pick No sign-in, even if Claude marks Sign in now as Detected: Chronicle uses this key instead. Under Request headers, pick <code>authorization</code> and paste this as its value:
						@aiCopyField("bearer", "", claudeHeaderValue(v.NewKey))
					</li>
					<li>Press Add, then turn Chronicle on in a chat from the + menu.</li>
				</ol>
				<p class="aic-hint mt-3">Request headers are new in Claude and not on every account yet. If you don't see them, use Claude Code or another app, or copy and paste below.</p>
			</div>
			<div class="aic-drawer" role="tabpanel" x-show="app === 'code'" x-cloak>
				<p class="text-sm text-fg">Run this once in a terminal:</p>
				@aiCopyField("cmd", "", claudeCodeCommand(v))
			</div>
			<div class="aic-drawer" role="tabpanel" x-show="app === 'other'" x-cloak>
				<p class="text-sm text-fg">Open WebUI, LM Studio, Claude Desktop and most other AI apps can add an MCP server. Give it the address above, pick Streamable HTTP if it asks, and add the header <code>Authorization</code> with the value <code>Bearer</code> followed by a space and the key.</p>
			</div>
		</div>
		<div class="flex items-center gap-3 pt-1">
			<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/ai", v.CampaignID)) } class="btn-secondary">Done</a>
			<span class="aic-hint">The key disappears from this page when you leave it.</span>
		</div>
		<span class="sr-only" aria-live="polite" x-text="copied ? 'Copied' : ''"></span>
	</section>
}

templ aiAppTab(key, label string) {
	<button
		type="button"
		role="tab"
		class="aic-tab"
		@click={ fmt.Sprintf("app = '%s'", key) }
		:aria-selected={ fmt.Sprintf("app === '%s'", key) }
		if key == "claude" {
			aria-selected="true"
		} else {
			aria-selected="false"
		}
	>{ label }</button>
}

// aiCopyField is a value in a well with a copy icon. It reads its value
// from its own data attribute, so nothing is built into a script.
templ aiCopyField(id, label, value string) {
	<div>
		if label != "" {
			<span class="aic-label">{ label }</span>
		}
		<div class="aic-copy">
			<code>{ value }</code>
			<button
				type="button"
				class="aic-icon"
				data-copy={ value }
				@click={ fmt.Sprintf("navigator.clipboard.writeText($el.dataset.copy).then(() => { copied = '%s'; setTimeout(() => { if (copied === '%s') copied = '' }, 2000) })", id, id) }
				if label != "" {
					aria-label={ "Copy the " + label }
				} else {
					aria-label="Copy"
				}
			>
				<i class="fa-regular fa-copy" aria-hidden="true" x-show={ fmt.Sprintf("copied !== '%s'", id) }></i>
				<i class="fa-solid fa-check" aria-hidden="true" x-show={ fmt.Sprintf("copied === '%s'", id) } x-cloak></i>
			</button>
		</div>
	</div>
}

// aiStatus is the connection in the side column: its state and settings,
// and the ways to change what it may do, pause it, make a new key or
// disconnect (which asks first).
templ aiStatus(v ConnectView) {
	<section
		class="aic-panel space-y-3"
		aria-labelledby="ai-status-heading"
		x-data={ fmt.Sprintf("{ asking: false, editing: false, sees: '%s', change: '%s', wasOwner: %t, sure: false, get widening() { return this.sees === 'owner' && !this.wasOwner } }",
			seesValue(v.Conn), changeValue(v.Conn), v.Conn.Privacy != aiexport.PrivacyModeSafe) }
	>
		<div class="flex items-center gap-2.5">
			<span class="aic-dot" data-state={ connStatus(v) } aria-hidden="true"></span>
			<h2 id="ai-status-heading" class="aic-h">{ statusTitle(v) }</h2>
		</div>
		if connStatus(v) == "paused" {
			<p class="text-sm text-fg">Paused by you { agoText(v.Now, *v.Conn.PausedAt) }. Its calls are refused until you resume, and nothing it asked for is lost.</p>
		}
		<p class="aic-hint">{ statusLine(v) }</p>
		<form
			x-show="editing"
			x-cloak
			x-collapse.duration.200ms
			hx-post={ fmt.Sprintf("/campaigns/%s/ai/connection/access", v.CampaignID) }
			hx-target="#ai-connect"
			hx-swap="outerHTML"
			hx-disabled-elt="find button"
			class="aic-edit"
			aria-label="Change what your AI may do"
		>
			<input type="hidden" name="connection" value={ strconv.FormatInt(v.Conn.ID, 10) }/>
			<input type="hidden" name="widen" :value="sure ? 'yes' : ''"/>
			<fieldset>
				<legend class="aic-label aic-label-muted">See</legend>
				<label class="aic-choice"><input type="radio" name="sees" value="players" x-model="sees" @change="sure = false"/><span><b>What players see</b> <span class="aic-hint">No secrets or hidden pages.</span></span></label>
				<label class="aic-choice"><input type="radio" name="sees" value="owner" x-model="sees"/><span><b>What you see</b> <span class="aic-hint">Adds your { layouts.GMTerm(ctx) }-only pages and secrets.</span></span></label>
			</fieldset>
			<fieldset>
				<legend class="aic-label aic-label-muted">Change</legend>
				<label class="aic-choice"><input type="radio" name="change" value="ask" x-model="change"/><span><b>Ask for changes</b> <span class="aic-hint">Each waits here for your yes.</span></span></label>
				<label class="aic-choice"><input type="radio" name="change" value="look" x-model="change"/><span><b>Only look</b> <span class="aic-hint">Reads and answers only.</span></span></label>
			</fieldset>
			<p class="aic-hint">Works from its next call, on the same key. Your AI app may need a new chat to notice.</p>
			<p class="aic-confirm" x-show="widening && sure" x-cloak role="alert">
				From its next call, your AI sees your { layouts.GMTerm(ctx) }-only pages and secrets. Text your players wrote could try to talk it into sharing them.
			</p>
			<div class="flex flex-wrap items-center gap-2">
				<button type="submit" class="btn-primary" x-show="!widening || sure">
					<span class="aic-idle" x-text="widening ? 'Let it see what you see' : 'Save'">Save</span>
					<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Saving…</span>
				</button>
				<button type="button" class="btn-primary" x-show="widening && !sure" x-cloak @click="sure = true">Save</button>
				<button type="button" class="quiet-word" @click="editing = false; sure = false">Cancel</button>
			</div>
		</form>
		<div class="aic-actions" x-show="!editing">
			<button type="button" class="btn-secondary" @click="editing = true; asking = false" :aria-expanded="editing">Change what it may do</button>
			<button
				type="button"
				class="btn-secondary"
				if connStatus(v) == "paused" {
					hx-post={ fmt.Sprintf("/campaigns/%s/ai/connection/resume", v.CampaignID) }
				} else {
					hx-post={ fmt.Sprintf("/campaigns/%s/ai/connection/pause", v.CampaignID) }
				}
				hx-vals={ fmt.Sprintf(`{"connection":"%d"}`, v.Conn.ID) }
				hx-target="#ai-connect"
				hx-swap="outerHTML"
				hx-disabled-elt="this"
			>
				if connStatus(v) == "paused" {
					<span class="aic-idle">Resume</span>
					<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Resuming…</span>
				} else {
					<span class="aic-idle">Pause</span>
					<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Pausing…</span>
				}
			</button>
			<button type="button" class="quiet-word" @click="renew = !renew; asking = false" :aria-expanded="renew">Make a new key</button>
			<button type="button" class="quiet-word text-bad" @click="asking = !asking; renew = false" :aria-expanded="asking">Disconnect</button>
		</div>
		<div class="aic-ask" x-show="asking" x-cloak x-collapse.duration.200ms>
			<p>
				Disconnect { appName(v.Conn) }? Its key stops working at once. You can connect again with a new key.
				if len(v.Requests) > 0 {
					What it already asked for stays here for you to answer.
				}
			</p>
			<button type="button" class="btn-secondary" @click="asking = false">Keep it</button>
			<button
				type="button"
				class="btn-danger"
				hx-post={ fmt.Sprintf("/campaigns/%s/ai/connection/disconnect", v.CampaignID) }
				hx-target="#ai-connect"
				hx-swap="outerHTML"
				hx-disabled-elt="this"
			>
				<span class="aic-idle">Disconnect</span>
				<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Disconnecting…</span>
			</button>
		</div>
	</section>
}

// aiActivityList is "What it did", one line per sitting with its calls
// folded under it. While the page is open it asks every 30 seconds whether
// anything new came in; the answer is empty (204) until something did, so
// the sittings the owner opened stay open.
templ aiActivityList(v ConnectView) {
	<section
		id="ai-activity"
		aria-labelledby="ai-activity-heading"
		hx-get={ fmt.Sprintf("/campaigns/%s/ai/activity?shown=%d&seen=%s", v.CampaignID, v.Shown, activitySeen(v)) }
		hx-trigger="every 30s"
		hx-swap="outerHTML"
	>
		<div class="flex flex-wrap items-baseline gap-x-4 pb-2 border-b border-edge">
			<h2 id="ai-activity-heading" class="aic-h flex-1">What it did</h2>
			if len(v.Sittings) > 0 {
				<span class="aic-hint">A sitting ends after 30 quiet minutes</span>
			}
		</div>
		if len(v.Sittings) == 0 {
			<p class="aic-hint py-3">Nothing yet. Each time your AI looks something up, it shows here.</p>
		} else {
			<div class="aic-sits">
				for i, s := range shownSittings(v) {
					<details class="aic-sit" open?={ i == 0 }>
						<summary>
							<time class="aic-sit-when" datetime={ s.Start.UTC().Format("2006-01-02T15:04:05Z") }>{ sittingWhen(v, s.Start) }</time>
							<span class="aic-sit-what">{ sittingSummary(s) }</span>
							<span class="aic-sit-tag" data-waiting?={ sittingWaiting(v, s) > 0 }>{ sittingTag(v, s) }</span>
						</summary>
						<div class="aic-log">
							for _, call := range s.Calls {
								@aiLogRow(v, call)
							}
						</div>
					</details>
				}
			</div>
			if len(v.Sittings) > v.Shown {
				<button
					type="button"
					class="btn-secondary mt-3"
					hx-get={ fmt.Sprintf("/campaigns/%s/ai/activity?shown=%d", v.CampaignID, v.Shown+sittingsStep) }
					hx-target="#ai-activity"
					hx-swap="outerHTML"
					hx-disabled-elt="this"
				>Show older sittings</button>
			} else if len(v.Calls) >= connector.CallsKept {
				<p class="aic-hint pt-2">{ fmt.Sprintf("Chronicle keeps your AI's newest %d calls.", connector.CallsKept) }</p>
			}
		}
	</section>
}

templ aiLogRow(v ConnectView, call connector.Call) {
	<div class="aic-log-row">
		<time class="aic-log-when" datetime={ call.At.UTC().Format("2006-01-02T15:04:05Z") }>{ clockText(v, call.At) }</time>
		<span class="aic-log-what">{ call.Summary }</span>
		<span class="aic-log-note">
			if !call.OK {
				<i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>not answered:
			}
			{ call.Note }
		</span>
	</div>
}

// aiRequests is what the connected AI asked for and the owner hasn't
// answered yet, newest first. While the page is open it asks every 30
// seconds whether anything new came in; the answer is empty (204, nothing
// swapped) until something did, so an open "Turn down?" is never reset. The
// poll skips while a review is open in a card, since redrawing would close it.
// oob marks it to replace the list from another response.
templ aiRequests(v ConnectView, oob bool) {
	<div
		id="ai-requests"
		class="space-y-3"
		if oob {
			hx-swap-oob="true"
		}
		if v.Available {
			hx-get={ fmt.Sprintf("/campaigns/%s/ai/requests?seen=%s", v.CampaignID, requestsSeen(v.Requests)) }
			hx-trigger="every 30s"
			x-data
			@htmx:before-request="if ($event.detail.elt === $el && document.querySelector('.aic-req-review form')) $event.preventDefault()"
			hx-swap="outerHTML"
		}
	>
		for _, q := range v.Requests {
			@aiRequestCard(v, q)
		}
	</div>
}

// aiRequestCard is one waiting request: who asked, for how many changes,
// the AI's own line in quotes, and Review or Turn down (which asks first).
// Review unfolds the changes inside the card itself.
templ aiRequestCard(v ConnectView, q connector.Request) {
	<section
		class="aic-panel aic-request"
		aria-labelledby={ fmt.Sprintf("ai-request-%d", q.ID) }
		x-data="{ asking: false }"
	>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
			<div class="flex-1 min-w-[14rem]">
				<span class="aic-label">Waiting for you</span>
				<h2 id={ fmt.Sprintf("ai-request-%d", q.ID) } class="aic-h">{ requestHeading(q) }</h2>
				<p class="aic-hint">{ requestLine(v, q) }</p>
			</div>
			<button type="button" class="quiet-word aic-req-actions" @click="asking = !asking" :aria-expanded="asking">Turn down</button>
			<form
				class="aic-req-actions"
				hx-post={ fmt.Sprintf("/campaigns/%s/ai-workspace/import/parse", v.CampaignID) }
				hx-target={ "#" + requestHost(q.ID) }
				hx-swap="innerHTML"
				hx-disabled-elt="find button"
			>
				<input type="hidden" name="ai_request" value={ strconv.FormatInt(q.ID, 10) }/>
				<button type="submit" class="btn-primary">
					<span class="aic-idle">Review</span>
					<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Reading it…</span>
				</button>
			</form>
		</div>
		<div class="aic-ask" x-show="asking" x-cloak x-collapse.duration.200ms>
			<p>Turn down this request? Nothing in your campaign changes, and your AI isn't told.</p>
			<button type="button" class="btn-secondary" @click="asking = false">Keep it</button>
			<button
				type="button"
				class="btn-secondary"
				hx-post={ fmt.Sprintf("/campaigns/%s/ai/requests/%d/turn-down", v.CampaignID, q.ID) }
				hx-target="#ai-requests"
				hx-swap="outerHTML"
				hx-disabled-elt="this"
			>
				<span class="aic-idle">Turn down</span>
				<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Turning down…</span>
			</button>
		</div>
		<div id={ requestHost(q.ID) } class="aic-req-review"></div>
	</section>
}

// requestReviewed answers a review of a request: a short line of what was
// made, with the full result one fold away, above the requests list without
// the answered card.
templ requestReviewed(d ImportResultData, v ConnectView) {
	<section class="aic-done" role="status" aria-labelledby="ai-request-done">
		<p id="ai-request-done" class="aic-done-line">
			<i class="fa-solid fa-check mr-1.5" aria-hidden="true"></i>
			{ doneLine(d.Result) }
		</p>
		<details class="aic-done-more">
			<summary>See what changed</summary>
			@ImportResult(d)
		</details>
	</section>
	@aiRequests(v, true)
}

// reviewIn is a review with the paste box's review emptied when it is a
// request's, so only one review is ever open on the page (two would share
// ids and keys). The page empties the other requests' reviews itself
// (aiPageReviews), since only it knows which are open.
templ reviewIn(d ImportReviewData) {
	@ImportReview(d)
	if d.RequestID > 0 {
		<div id={ pasteReviewHost } hx-swap-oob="innerHTML"></div>
		<div id={ requestResultHost } hx-swap-oob="innerHTML"></div>
	}
}
