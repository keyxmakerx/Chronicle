// ai_page.templ is the campaign's Your AI page: connect an AI app, answer
// what it asks for, see what it did, or use copy and paste.

package ai_workspace

import (
	"fmt"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/plugins/ai_workspace/connector"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// AIPageView is the whole page.
templ AIPageView(cc *campaigns.CampaignContext, v ConnectView) {
	@layouts.App(cc.Campaign.Name + " - Your AI") {
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/ai_page.css") }/>
		<div class="max-w-5xl mx-auto px-4 py-6" data-ai-page>
			@layouts.ManageHeader("Your AI")
			<p class="-mt-4 mb-6 text-sm text-fg-secondary max-w-prose">
				Connect your AI app once. It reads what you allow and asks for changes here, and you say yes or no to each one. No copying back and forth.
			</p>
			@aiConnectSection(v)
			@aiCopyPasteSection(cc)
		</div>
	}
}

// aiConnectSection is the part the connect, new-key and disconnect requests
// swap: what the AI asked for, the connection's state and what it did. The
// requests stay after a disconnect, since they are the owner's to answer.
templ aiConnectSection(v ConnectView) {
	<div id="ai-connect" class="space-y-8">
		<div class="space-y-4">
			@aiRequests(v, false)
			<div id={ requestReviewHost }></div>
		</div>
		if !v.Available {
			<section class="aic-panel">
				<p class="text-sm text-fg-secondary">Connecting an AI app isn't available on this Chronicle site. Copy and paste, below, works with every AI.</p>
			</section>
		} else if v.NewKey != "" {
			@aiNewKey(v)
		} else if connStatus(v) == "waiting" || connStatus(v) == "connected" {
			@aiStatus(v)
		} else {
			@aiConnectForm(v, false)
		}
		if v.Available {
			@aiActivityList(v)
		}
	</div>
}

// aiConnectForm is the choice of what the AI may see and how connecting
// works, ending in Make a key. replacing says a key exists and will stop.
templ aiConnectForm(v ConnectView, replacing bool) {
	<form
		hx-post={ fmt.Sprintf("/campaigns/%s/ai/connection", v.CampaignID) }
		hx-target="#ai-connect"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type=submit]"
		class="grid gap-5 md:grid-cols-2 items-start"
		aria-label="Connect your AI app"
	>
		<section class="aic-panel space-y-3" aria-labelledby="ai-sees-heading">
			<h2 id="ai-sees-heading" class="aic-h">What may your AI see?</h2>
			<label class="aic-choice">
				<input type="radio" name="sees" value="players" checked/>
				<span>
					<b>What players see</b>
					<span class="block aic-hint">Safest. No secrets, and nothing you keep from players.</span>
				</span>
			</label>
			<label class="aic-choice">
				<input type="radio" name="sees" value="owner"/>
				<span>
					<b>What you see</b>
					<span class="block aic-hint">Adds your { layouts.GMTerm(ctx) }-only pages and secrets. Only for an AI you trust, since text your players wrote could try to talk it into sharing them.</span>
				</span>
			</label>
			<div class="space-y-1 border-t border-edge pt-3" role="radiogroup" aria-labelledby="ai-change-heading">
				<h3 id="ai-change-heading" class="aic-label">Change</h3>
				<label class="aic-choice">
					<input type="radio" name="change" value="ask" checked/>
					<span>
						<b>Ask for changes</b>
						<span class="block aic-hint">Each one waits here for your yes.</span>
					</span>
				</label>
				<label class="aic-choice">
					<input type="radio" name="change" value="look"/>
					<span>
						<b>Only look</b>
						<span class="block aic-hint">It can read and answer, never ask to change.</span>
					</span>
				</label>
			</div>
			<p class="aic-hint flex gap-2 items-start">
				<i class="fa-solid fa-lock mt-0.5" aria-hidden="true"></i>
				<span>It can only ask. Every change and removal waits here for your yes, even if your AI app is set to allow everything. ChatGPT Plus and Pro only let connectors read, so there your AI gives you its changes to paste instead.</span>
			</p>
		</section>
		<section aria-labelledby="ai-how-heading">
			<h2 id="ai-how-heading" class="aic-h pb-2">Connect it</h2>
			<div class="aic-step">
				<span class="aic-num">1</span>
				<span><b class="text-fg">Make a key</b><span class="block aic-hint">Chronicle gives you an address and a key for your AI app.</span></span>
			</div>
			<div class="aic-step">
				<span class="aic-num">2</span>
				<span><b class="text-fg">In your AI app, add a connector</b><span class="block aic-hint">Claude calls it a custom connector. Other apps may call it an MCP server.</span></span>
			</div>
			<div class="aic-step">
				<span class="aic-num">3</span>
				<span><b class="text-fg">Paste the address and the key</b><span class="block aic-hint">You see the key once. It runs out after 90 days, and you can disconnect it here any time.</span></span>
			</div>
			<div class="flex flex-wrap items-center gap-3 pt-4">
				<button type="submit" class="btn-primary">
					<span class="aic-idle"><i class="fa-solid fa-key mr-1.5" aria-hidden="true"></i>Make a key</span>
					<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Making…</span>
				</button>
				if replacing {
					<span class="aic-hint">Your AI's current key stops working.</span>
				} else if connStatus(v) == "ended" {
					<span class="aic-hint">Your AI's last key ran out. Make a new one to connect again.</span>
				}
			</div>
		</section>
	</form>
}

// aiNewKey shows the address and the new key, once, with how to add them in
// each kind of app.
templ aiNewKey(v ConnectView) {
	<section
		class="aic-panel aic-key space-y-4"
		aria-labelledby="ai-key-heading"
		x-data="{ app: 'claude', copied: '' }"
	>
		<div>
			<h2 id="ai-key-heading" class="aic-h">Your key is ready</h2>
			<p class="aic-hint">Copy it now: Chronicle shows it only this once. If you lose it, make a new one. Your AI { seesLabel(v.Conn.Privacy) } and { changeLabel(v.Conn.CanAsk) }.</p>
		</div>
		<div class="grid gap-3 md:grid-cols-2">
			@aiCopyField("addr", "Address", v.Endpoint)
			@aiCopyField("key", "Key", v.NewKey)
		</div>
		<div>
			<div class="aic-tabs" role="tablist" aria-label="How to add it">
				@aiAppTab("claude", "In Claude")
				@aiAppTab("code", "In Claude Code")
				@aiAppTab("other", "Other apps")
			</div>
			<div class="aic-drawer" role="tabpanel" x-show="app === 'claude'">
				<ol>
					<li>Open Customize, then Connectors, then Add custom connector.</li>
					<li>Name it Chronicle and paste the address above as the server URL.</li>
					<li>For sign-in, pick No sign-in, even if Claude marks Sign in now as Detected: Chronicle uses this key instead. Under Request headers, pick <code>authorization</code> and paste this as its value:
						@aiCopyField("bearer", "", claudeHeaderValue(v.NewKey))
					</li>
					<li>Press Add, then turn Chronicle on in a chat from the + menu.</li>
				</ol>
				<p class="aic-hint mt-3">Request headers are new in Claude and not on every account yet. If you don't see them, use Claude Code or another app, or copy and paste below.</p>
			</div>
			<div class="aic-drawer" role="tabpanel" x-show="app === 'code'" x-cloak>
				<p class="text-sm text-fg">Run this once in a terminal:</p>
				@aiCopyField("cmd", "", claudeCodeCommand(v))
			</div>
			<div class="aic-drawer" role="tabpanel" x-show="app === 'other'" x-cloak>
				<p class="text-sm text-fg">Open WebUI, LM Studio, Claude Desktop and most other AI apps can add an MCP server. Give it the address above, pick Streamable HTTP if it asks, and add the header <code>Authorization</code> with the value <code>Bearer</code> followed by a space and the key.</p>
			</div>
		</div>
		<div class="flex items-center gap-3 pt-1">
			<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/ai", v.CampaignID)) } class="btn-secondary">Done</a>
			<span class="aic-hint">The key disappears from this page when you leave it.</span>
		</div>
		<span class="sr-only" aria-live="polite" x-text="copied ? 'Copied' : ''"></span>
	</section>
}

templ aiAppTab(key, label string) {
	<button
		type="button"
		role="tab"
		class="aic-tab"
		@click={ fmt.Sprintf("app = '%s'", key) }
		:aria-selected={ fmt.Sprintf("app === '%s'", key) }
		if key == "claude" {
			aria-selected="true"
		} else {
			aria-selected="false"
		}
	>{ label }</button>
}

// aiCopyField is a value in a well with a copy icon. It reads its value
// from its own data attribute, so nothing is built into a script.
templ aiCopyField(id, label, value string) {
	<div>
		if label != "" {
			<span class="aic-label">{ label }</span>
		}
		<div class="aic-copy">
			<code>{ value }</code>
			<button
				type="button"
				class="aic-icon"
				data-copy={ value }
				@click={ fmt.Sprintf("navigator.clipboard.writeText($el.dataset.copy).then(() => { copied = '%s'; setTimeout(() => { if (copied === '%s') copied = '' }, 2000) })", id, id) }
				if label != "" {
					aria-label={ "Copy the " + label }
				} else {
					aria-label="Copy"
				}
			>
				<i class="fa-regular fa-copy" aria-hidden="true" x-show={ fmt.Sprintf("copied !== '%s'", id) }></i>
				<i class="fa-solid fa-check" aria-hidden="true" x-show={ fmt.Sprintf("copied === '%s'", id) } x-cloak></i>
			</button>
		</div>
	</div>
}

// aiStatus is the connection: who, what it sees, when it was used, and the
// ways to make a new key or disconnect (which asks first).
templ aiStatus(v ConnectView) {
	<section class="aic-panel" aria-labelledby="ai-status-heading" x-data="{ asking: false, renew: false }">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			<span class="aic-dot" data-state={ connStatus(v) } aria-hidden="true"></span>
			<div class="flex-1 min-w-[14rem]">
				<h2 id="ai-status-heading" class="aic-h">
					if connStatus(v) == "connected" {
						{ appName(v.Conn) } is connected
					} else {
						Waiting for your AI to connect
					}
				</h2>
				<p class="aic-hint">
					{ statusLine(v) }
				</p>
			</div>
			<button type="button" class="quiet-word" @click="renew = !renew; asking = false" :aria-expanded="renew">Make a new key</button>
			<button type="button" class="btn-secondary text-bad" @click="asking = !asking; renew = false" :aria-expanded="asking">Disconnect</button>
		</div>
		<div class="aic-ask" x-show="asking" x-cloak x-collapse.duration.200ms>
			<p>
				Disconnect { appName(v.Conn) }? Its key stops working at once. You can connect again with a new key.
				if len(v.Requests) > 0 {
					What it already asked for stays here for you to answer.
				}
			</p>
			<button type="button" class="btn-secondary" @click="asking = false">Keep it</button>
			<button
				type="button"
				class="btn-danger"
				hx-post={ fmt.Sprintf("/campaigns/%s/ai/connection/disconnect", v.CampaignID) }
				hx-target="#ai-connect"
				hx-swap="outerHTML"
				hx-disabled-elt="this"
			>
				<span class="aic-idle">Disconnect</span>
				<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Disconnecting…</span>
			</button>
		</div>
		<div class="mt-4" x-show="renew" x-cloak x-collapse.duration.200ms>
			@aiConnectForm(v, true)
		</div>
	</section>
}

// aiActivityList is "What it did", newest first, refreshed while the page
// is open.
templ aiActivityList(v ConnectView) {
	<section
		id="ai-activity"
		aria-labelledby="ai-activity-heading"
		hx-get={ fmt.Sprintf("/campaigns/%s/ai/activity", v.CampaignID) }
		hx-trigger="every 30s"
		hx-swap="outerHTML"
	>
		<h2 id="ai-activity-heading" class="aic-h pb-2 border-b border-edge">What it did</h2>
		if len(v.Calls) == 0 {
			<p class="aic-hint py-3">Nothing yet. Each time your AI looks something up, it shows here.</p>
		} else {
			<div class="aic-log">
				for _, call := range v.Calls {
					@aiLogRow(v, call)
				}
			</div>
			if len(v.Calls) >= connector.CallsShown {
				<p class="aic-hint pt-2">{ fmt.Sprintf("The newest %d.", connector.CallsShown) }</p>
			}
		}
	</section>
}

templ aiLogRow(v ConnectView, call connector.Call) {
	<div class="aic-log-row">
		<time class="aic-log-when" datetime={ call.At.UTC().Format("2006-01-02T15:04:05Z") } title={ call.At.UTC().Format("2 January 2006, 15:04 UTC") }>{ agoText(v.Now, call.At) }</time>
		<span class="aic-log-what">{ call.Summary }</span>
		<span class="aic-log-note">
			if !call.OK {
				<i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>not answered:
			}
			{ call.Note }
		</span>
	</div>
}

// aiRequests is what the connected AI asked for and the owner hasn't
// answered yet, newest first. While the page is open it asks every 30
// seconds whether anything new came in; the answer is empty (204, nothing
// swapped) until something did, so an open "Turn down?" is never reset.
// oob marks it to replace the list from another response.
templ aiRequests(v ConnectView, oob bool) {
	<div
		id="ai-requests"
		class="space-y-3"
		if oob {
			hx-swap-oob="true"
		}
		if v.Available {
			hx-get={ fmt.Sprintf("/campaigns/%s/ai/requests?seen=%s", v.CampaignID, requestsSeen(v.Requests)) }
			hx-trigger="every 30s"
			hx-swap="outerHTML"
		}
	>
		for _, q := range v.Requests {
			@aiRequestCard(v, q)
		}
	</div>
}

// aiRequestCard is one waiting request: who asked, for how many changes,
// the AI's own line in quotes, and Review or Turn down (which asks first).
templ aiRequestCard(v ConnectView, q connector.Request) {
	<section
		class="aic-panel aic-request"
		aria-labelledby={ fmt.Sprintf("ai-request-%d", q.ID) }
		x-data="{ asking: false }"
	>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
			<div class="flex-1 min-w-[14rem]">
				<span class="aic-label">Waiting for you</span>
				<h2 id={ fmt.Sprintf("ai-request-%d", q.ID) } class="aic-h">{ requestHeading(q) }</h2>
				<p class="aic-hint">{ requestLine(v, q) }</p>
			</div>
			<button type="button" class="quiet-word" @click="asking = !asking" :aria-expanded="asking">Turn down</button>
			<form
				hx-post={ fmt.Sprintf("/campaigns/%s/ai-workspace/import/parse", v.CampaignID) }
				hx-target={ "#" + requestReviewHost }
				hx-swap={ fmt.Sprintf("innerHTML show:#%s:top", requestReviewHost) }
				hx-disabled-elt="find button"
			>
				<input type="hidden" name="ai_request" value={ strconv.FormatInt(q.ID, 10) }/>
				<button type="submit" class="btn-primary">
					<span class="aic-idle">Review</span>
					<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Reading it…</span>
				</button>
			</form>
		</div>
		<div class="aic-ask" x-show="asking" x-cloak x-collapse.duration.200ms>
			<p>Turn down this request? Nothing in your campaign changes, and your AI isn't told.</p>
			<button type="button" class="btn-secondary" @click="asking = false">Keep it</button>
			<button
				type="button"
				class="btn-secondary"
				hx-post={ fmt.Sprintf("/campaigns/%s/ai/requests/%d/turn-down", v.CampaignID, q.ID) }
				hx-target="#ai-requests"
				hx-swap="outerHTML"
				hx-disabled-elt="this"
			>
				<span class="aic-idle">Turn down</span>
				<span class="aic-busy"><i class="fa-solid fa-spinner fa-spin mr-1.5" aria-hidden="true"></i>Turning down…</span>
			</button>
		</div>
	</section>
}

// requestReviewed answers a review of a request: the result in the request's
// review host, and the requests list without it.
templ requestReviewed(d ImportResultData, v ConnectView) {
	@ImportResult(d)
	@aiRequests(v, true)
}

// reviewIn is a review with the other review host emptied, so only one
// review is ever open on the page (two would share ids and keys).
templ reviewIn(d ImportReviewData) {
	@ImportReview(d)
	if reviewHost(d) == requestReviewHost {
		<div id={ pasteReviewHost } hx-swap-oob="innerHTML"></div>
	} else {
		<div id={ requestReviewHost } hx-swap-oob="innerHTML"></div>
	}
}
