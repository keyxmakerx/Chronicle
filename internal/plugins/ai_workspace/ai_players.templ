package ai_workspace

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/ai_workspace/connector"
)

// aiPlayersPanel is players' AI on the owner's Your AI page: off until the
// owner turns it on, then each player's key with Pause and Disconnect. What
// a player's AI reads or asks for stays with that player.
templ aiPlayersPanel(p PlayersView) {
	<section id="ai-players" class="aic-panel space-y-3" aria-labelledby="ai-players-heading">
		<div>
			<h2 id="ai-players-heading" class="aic-h">Players' AI</h2>
			<p class="aic-hint">Each player connects their own AI and answers its requests themselves. Their AI sees only what they see, and may change only their own character's sheet and hero builder choices.</p>
		</div>
		if p.Blocked {
			<p class="text-sm text-fg">The server's admin hasn't let players use AI.</p>
		} else {
			<form
				hx-post={ fmt.Sprintf("/campaigns/%s/ai/players", p.CampaignID) }
				hx-trigger="change"
				hx-target="#ai-players"
				hx-swap="outerHTML"
			>
				<label class="aia-switch">
					<input type="checkbox" name="allowed" checked?={ p.Allowed }/>
					<span>
						<b>Players may use an AI here</b>
						<span class="block aic-hint">Off stops every player's key from its next call. Their keys are kept for when you turn it back on.</span>
					</span>
				</label>
			</form>
		}
		if len(p.Keys) > 0 {
			<ul class="divide-y divide-edge" aria-label="Players' keys">
				for _, k := range p.Keys {
					@aiPlayerKeyRow(p, k)
				}
			</ul>
		} else if p.Allowed && !p.Blocked {
			<p class="aic-hint">No player has connected an AI yet. They find it under the AI button at the top of any page.</p>
		}
	</section>
}

// aiPlayerKeyRow is one player's key: who, which app, when last used, and
// Pause or Resume and Disconnect (which asks first).
templ aiPlayerKeyRow(p PlayersView, k connector.KeyRow) {
	<li class="py-2 space-y-1" x-data="{ asking: false }">
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
			<span class="flex-1 min-w-[10rem] text-sm">
				<b class="text-fg">{ k.PersonName }</b>
				<span class="aic-hint">· { playerKeyLine(k) }</span>
			</span>
			<button
				type="button"
				class="quiet-word"
				hx-post={ fmt.Sprintf("/campaigns/%s/ai/players/%d", p.CampaignID, k.ID) }
				if k.PausedAt != nil {
					hx-vals={ `{"act":"resume"}` }
				} else {
					hx-vals={ `{"act":"pause"}` }
				}
				hx-target="#ai-players"
				hx-swap="outerHTML"
			>
				if k.PausedAt != nil {
					Let it back
				} else {
					Pause
				}
			</button>
			<button type="button" class="quiet-word text-bad" x-show="!asking" @click="asking = true">Disconnect</button>
		</div>
		<div class="aic-ask" x-show="asking" x-cloak>
			<p>Disconnect { k.PersonName }'s AI? Its key stops working at once. They can make a new one while players may use AI.</p>
			<button type="button" class="btn-secondary" @click="asking = false">Keep it</button>
			<button
				type="button"
				class="btn-danger"
				hx-post={ fmt.Sprintf("/campaigns/%s/ai/players/%d", p.CampaignID, k.ID) }
				hx-vals={ `{"act":"end"}` }
				hx-target="#ai-players"
				hx-swap="outerHTML"
			>Disconnect</button>
		</div>
	</li>
}
