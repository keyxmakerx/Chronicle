// import_review_records.templ renders the review rows for records: the
// non-page blocks (calendar events, rolling tables, shop stock, map pins,
// notes, generators…). Unlike page rows, a record's action is fixed by the
// markdown, because the plan shown is the plan for that action.

package ai_workspace

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/ai_workspace/records"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// RecordRow is one record as the review screen shows it.
type RecordRow struct {
	Index  int    // position among records; form fields are rec_<Index>_*
	Label  string // the kind's label, or the raw kind when unknown
	Action string
	Name   string
	Plan   records.Plan
	Block  int    // 1-based position in the paste, for the problems list
	Reason string // the AI's `reason:` line, if it gave one
}

// actionWord is the plain verb the chip shows.
func (r RecordRow) actionWord() string {
	switch {
	case r.Plan.Client != "":
		return "Generate"
	case r.Action == records.ActionUpdate:
		return "Change"
	case r.Action == records.ActionDelete:
		return "Remove"
	}
	return "Add"
}

func (r RecordRow) title() string {
	if r.Name != "" {
		return r.Name
	}
	return r.Label
}

// reviewRecordRow is one record the AI asks to add, change or remove, in
// the same shape as a page row. Records the server refused never reach the
// list; they sit in the problems box instead.
templ reviewRecordRow(campaignID string, r RecordRow) {
	<div
		role="listitem"
		tabindex="-1"
		data-air-row
		data-air-verb={ r.actionWord() }
		aria-label={ fmt.Sprintf("%s %s: %s", r.actionWord(), r.Label, r.title()) }
		class="air-row"
		if r.Plan.Client != "" {
			data-ai-gen={ r.Plan.Client }
		}
	>
		<span class={ verbClass(r.actionWord()) }>{ r.actionWord() }</span>
		<div class="air-main">
			<span class="air-what"><b>{ r.title() }</b></span>
			<span class="air-line">{ r.Plan.Summary }</span>
			if r.Reason != "" {
				<span class="air-line">AI's reason: <i>{ r.Reason }</i></span>
			}
			if r.Plan.Preview != "" {
				@recordPreview(campaignID, r)
			}
			if r.Plan.Client != "" {
				<input type="hidden" name={ fmt.Sprintf("rec_%d_generated", r.Index) } value=""/>
			}
			// Shown and required only while the removal is answered Yes;
			// the committer refuses a removal without it either way.
			if r.Action == records.ActionDelete {
				<label class="air-confirm">
					<input
						type="checkbox"
						name={ fmt.Sprintf("rec_%d_delete_confirmed", r.Index) }
						data-air-confirm
						class="mt-0.5 rounded"
						aria-label={ fmt.Sprintf("I confirm %s will be removed", r.title()) }
					/>
					<span>I understand <strong>{ r.title() }</strong> will be removed for good.</span>
				</label>
			}
			if len(r.Plan.Warnings) > 0 {
				<ul class="air-line list-disc ml-4">
					for _, w := range r.Plan.Warnings {
						<li>{ w }</li>
					}
				</ul>
			}
		</div>
		@yesNo(fmt.Sprintf("rec_%d_include", r.Index), recordStartsYes(r), fmt.Sprintf("%s %s", r.actionWord(), r.title()))
	</div>
}

// recordPreview draws what a house-rule row writes with the rulebook reader
// itself, so the pages show in the campaign's Handbook look (its own style,
// or Standard if the owner chose that) with their working rolls and flaps.
templ recordPreview(campaignID string, r RecordRow) {
	<details class="air-more mt-1">
		<summary>Read it as the Handbook will show it</summary>
		<link rel="stylesheet" href={ layouts.AssetURL("/static/css/rulebook.css") }/>
		<div class="mt-2 rounded-lg overflow-hidden border border-edge" style="height: 560px">
			<div
				class="h-full"
				data-widget="rulebook"
				data-campaign-id={ campaignID }
				data-book-json={ r.Plan.Preview }
				aria-label={ fmt.Sprintf("Preview of %s", r.title()) }
			></div>
		</div>
	</details>
}
