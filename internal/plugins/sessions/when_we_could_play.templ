// when_we_could_play.templ draws the campaign home's "When we could play"
// block. It takes only the already-worded view, so no count, name or poll
// tally can reach the page. The expander is an inline IIFE built Go-side, so
// it works after the home's HTMX swap.
package sessions

import "fmt"

// couldPlayToggle flips the extra rows and legend. The swap-safe form: an
// inline call, never a script sibling or a delegated listener.
func couldPlayToggle() templ.ComponentScript {
	return templ.ComponentScript{
		Name:     "couldplay_toggle",
		Function: "",
		Call: `(function(b){var s=b.closest('[data-block]');var open=s.getAttribute('data-open')==='1';` +
			`s.setAttribute('data-open',open?'0':'1');` +
			`s.querySelectorAll('[data-extra]').forEach(function(e){e.hidden=open;});` +
			`b.textContent=open?b.getAttribute('data-more'):'Show fewer';` +
			`b.setAttribute('aria-expanded',open?'false':'true');})(this)`,
	}
}

// couldPlayPill colours the viewer's own answer: green going, amber maybe,
// red can't, as Coming up does.
func couldPlayPill(tone string) string {
	switch tone {
	case "go":
		return "bg-ok/10 text-ok"
	case "maybe":
		return "bg-warn/10 text-warn"
	}
	return "bg-bad/10 text-bad"
}

// whenWeCouldPlayBlock replaces the placeholder (hx-swap outerHTML).
templ whenWeCouldPlayBlock(v couldPlayView) {
	<section class="cb-info cb-could" data-block="when-we-could-play" data-open="0" aria-labelledby="when-we-could-play-h">
		<div class="cb-info-top flex items-baseline justify-between mb-3">
			<h2 id="when-we-could-play-h" class="cb-head text-sm font-semibold text-fg-secondary uppercase tracking-wider">When we could play</h2>
			<a href={ templ.SafeURL(v.GameNightsHref) } class="cb-more text-xs text-accent hover:underline">Open Game nights</a>
		</div>
		if len(v.Rows) == 0 {
			<p class="text-sm text-fg-muted">
				if v.Guest {
					Nothing planned yet.
				} else {
					Nothing planned yet, and no times stand out.
				}
			</p>
		} else {
			<div class="cb-info-rows card cb-card px-4 py-2">
				<div class="flex items-center gap-3 pb-1" aria-hidden="true">
					<span class="w-24 flex-none"></span>
					<span class="flex min-w-0 flex-1 justify-between text-xs text-fg-muted">
						<span>noon</span><span>3</span><span>6</span><span>9</span><span>12</span>
					</span>
				</div>
				for _, r := range v.Rows {
					if r.Extra {
						<div data-extra hidden>
							@couldPlayRowView(r)
						</div>
					} else {
						<div>
							@couldPlayRowView(r)
						</div>
					}
				}
			</div>
			if v.Usually != "" {
				<p class="mt-2 text-xs text-fg-muted">{ v.Usually }</p>
			}
			if v.ExtraN > 0 {
				<button
					type="button"
					class="cb-more mt-2 text-xs text-accent hover:underline"
					data-more={ v.MoreWord() }
					aria-expanded="false"
					onclick={ couldPlayToggle() }
				>{ v.MoreWord() }</button>
			}
			<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-fg-muted" data-extra hidden>
				<span class="inline-flex items-center gap-1.5"><i class="inline-block h-2.5 w-4 rounded-sm bg-accent" aria-hidden="true"></i>Game night</span>
				if !v.Guest {
					<span>Darker means more of the table is usually free</span>
				}
			</div>
		}
	</section>
}

// couldPlayRowView is one day: its label, the bar, and the words under it.
templ couldPlayRowView(r couldPlayRow) {
	<div class="cb-line flex items-start gap-3 py-2 text-sm">
		<span class="cb-line-name w-24 flex-none font-semibold text-fg">{ r.Label }</span>
		<span class="min-w-0 flex-1">
			<span class="relative block h-3 overflow-hidden rounded bg-surface-alt" aria-hidden="true">
				if r.Shade != "" {
					<i class="absolute inset-0 block" style={ templ.SafeCSS("background:" + r.Shade) }></i>
				}
				for _, n := range r.Nights {
					<i class="absolute inset-y-0 block rounded-sm bg-accent" style={ fmt.Sprintf("left:%.1f%%;width:%.1f%%", n.Left, n.Width) }></i>
				}
			</span>
			for _, n := range r.Nights {
				<span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
					if n.Title != "" {
						<span class="font-medium text-fg">{ n.Title }</span>
					} else if n.Clock == "" {
						<span class="font-medium text-fg">Game night</span>
					}
					if n.Clock != "" {
						<span class="text-fg-secondary">{ n.Clock }</span>
					}
					if n.Owes {
						<a href={ templ.SafeURL(n.Href) } class="text-accent hover:underline">Answer</a>
					} else if n.Answer != "" {
						<span class={ "rounded-full px-2 py-0.5 font-medium", couldPlayPill(n.Tone) }>{ n.Answer }</span>
					}
				</span>
			}
			if r.Phrase != "" {
				<span class="mt-1 block text-xs text-fg-muted">{ r.Phrase }</span>
			}
		</span>
	</div>
}
