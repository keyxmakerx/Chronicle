// sessions.templ renders the sessions plugin UI: list, detail, create/edit forms,
// RSVP controls, and attendee displays.

package sessions

import (
	"fmt"
	"net/url"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// SessionListPage renders the full sessions page.
templ SessionListPage(cc *campaigns.CampaignContext, groups []SessionGroup, csrfToken string, isOwner, isScribe bool, userID string, plan SessionPlan, viewerTZ string, feed bool) {
	@layouts.App(cc.Campaign.Name + " - Game nights") {
		<div class="max-w-4xl mx-auto">
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: fmt.Sprintf("/campaigns/%s", cc.Campaign.ID), Icon: "fa-dice-d20"},
				{Label: "Game nights"},
			})
			@SessionListFragment(cc, groups, csrfToken, isOwner, isScribe, userID, plan, viewerTZ, feed)
		</div>
	}
}

// SessionListFragment renders just the session list content (for HTMX).
// On a phone the buttons drop under the title and wrap, so New Session is
// never clipped off the right edge.
// feed says the member gets "Add to your calendar": the owner's calendar
// feed switch is on and the viewer is a member. A member answers a planned
// night from its row (gameNightAnswer); game_nights.js runs both.
templ SessionListFragment(cc *campaigns.CampaignContext, groups []SessionGroup, csrfToken string, isOwner, isScribe bool, userID string, plan SessionPlan, viewerTZ string, feed bool) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/game_nights.css") }/>
	<div class="gn" data-widget="game-nights" data-gn-base={ fmt.Sprintf("/campaigns/%s", cc.Campaign.ID) }>
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
			<div>
				<h1 class="text-2xl font-bold text-fg">Game nights</h1>
				<p class="text-sm text-fg-secondary mt-1">Game session schedule and history.</p>
				if feed {
					<button type="button" class="gn-quiet mt-1" data-gn-feed-toggle aria-expanded="false" aria-controls="gn-feed">
						<i class="fa-regular fa-calendar-plus" aria-hidden="true"></i> Add to your calendar
					</button>
				}
			</div>
			<div class="flex flex-wrap items-center gap-2">
				if cc.IsMember {
					<!-- Availability is member-only data; its target route rides the
					     authed member group. Gate the link on membership so anonymous
					     viewers on a public sessions list aren't shown a dead end. -->
					<a
						href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/availability", cc.Campaign.ID)) }
						class="btn-secondary text-sm"
						title="Record your weekly availability and see the group heatmap"
					>
						<i class="fa-solid fa-calendar-check mr-1"></i> Availability
					</a>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/proposals", cc.Campaign.ID)) }
						class="btn-secondary text-sm"
						title="Answer date polls on the Game nights calendar"
					>
						<i class="fa-solid fa-calendar-day mr-1"></i> Date polls
					</a>
				}
				if isScribe {
					<button
						type="button"
						class="btn-primary text-sm"
						onclick="document.getElementById('create-session-modal').showModal()"
					>
						<i class="fa-solid fa-plus mr-1"></i> New game night
					</button>
				}
			</div>
		</div>
		if feed {
			@gameNightFeedPanel()
		}
		if len(groups) == 0 {
			<div class="card p-12 text-center">
				<i class="fa-solid fa-dice-d20 text-4xl text-fg-muted mb-3"></i>
				<p class="text-fg-secondary mb-1">No game nights yet.</p>
				if isScribe {
					<p class="text-sm text-fg-muted">Create your first session to start tracking your campaign's game nights.</p>
				}
			</div>
		} else {
			for _, g := range groups {
				<h2 class="text-xs font-semibold text-fg-muted uppercase tracking-wider mt-6 mb-2">{ g.Label }</h2>
				for _, s := range g.Sessions {
					@gameNightRow(cc, s, g.Key, userID, viewerTZ)
				}
			}
		}
	</div>
	if isScribe {
		@createSessionModal(cc, csrfToken, plan)
	}
}

// gameNightFeedPanel is the member's private calendar link, draped under the
// heading. The link is fetched the first time it opens (game_nights.js), so
// the field starts empty.
templ gameNightFeedPanel() {
	<div class="gn-drape gn-drape-feed" id="gn-feed" data-gn-feed>
		<div>
			<div>
				<div class="gn-feed" role="region" aria-label="Your game nights in your calendar">
					<div class="gn-feed-h">
						<b>Your game nights in your calendar</b>
						<button type="button" class="gn-x" data-gn-feed-close aria-label="Close" title="Close">
							<i class="fa-solid fa-xmark" aria-hidden="true"></i>
						</button>
					</div>
					<p>Add this link to your phone or computer calendar. New nights appear on their own, and a moved or cancelled night updates too.</p>
					<div class="gn-linkrow">
						<input type="text" readonly data-gn-feed-url aria-label="Your private calendar link"/>
						<button type="button" class="btn-primary text-sm" data-gn-copy>Copy</button>
					</div>
					<div class="gn-fine">
						<span><i class="fa-solid fa-lock" aria-hidden="true"></i> Only you have this link. Anyone with it can see this campaign's game night dates.</span>
						<button type="button" class="gn-quiet" data-gn-replace>Replace link</button>
					</div>
					<div class="gn-confirm" data-gn-confirm hidden>
						<span>Replacing stops the old link at once, so any calendar using it stops updating until you add the new one.</span>
						<div>
							<button type="button" class="btn-secondary text-sm gn-danger" data-gn-replace-yes>Replace it</button>
							<button type="button" class="btn-secondary text-sm" data-gn-replace-no>Keep this link</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// gameNightRow is one night on the list. The title's link covers the whole
// card, so the row still opens the night anywhere it is pressed, while the
// member's answer sits above that link as its own button: a button cannot
// live inside a link. Only an upcoming night asks; one whose date has passed
// (group "played") has happened.
templ gameNightRow(cc *campaigns.CampaignContext, s Session, group string, userID string, viewerTZ string) {
	{{ answering := group == "upcoming" && s.AcceptsRSVP() && cc.IsMember && userID != "" }}
	{{ mine := myRSVPStatus(s.Attendees, userID) }}
	<div
		class="gn-row card p-4 mb-2 hover:border-accent/50 transition-colors"
		if answering {
			data-gn-row
			data-gn-url={ fmt.Sprintf("/campaigns/%s/sessions/%s/rsvp", cc.Campaign.ID, s.ID) }
			data-gn-mine={ mine }
			data-gn-name={ s.Name }
		}
	>
		<div class="flex items-start justify-between">
			<div class="flex-1 min-w-0">
				<div class="flex items-center gap-2">
					if group == "played" {
						@playedBadge()
					} else {
						@sessionStatusBadge(s.Status)
					}
					<h3 class="font-semibold text-fg truncate">
						<a class="gn-link" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/sessions/%s", cc.Campaign.ID, s.ID)) }>{ s.Name }</a>
					</h3>
				</div>
				<div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1.5 text-xs text-fg-secondary">
					if s.ScheduledDate != nil {
						<span>
							<i class="fa-regular fa-calendar mr-0.5"></i>
							{ s.FormatScheduledFor(viewerTZ) }
						</span>
					}
					if s.IsRecurring {
						<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-surface-alt text-fg-secondary border border-edge">
							<i class="fa-solid fa-repeat text-[10px] mr-0.5"></i>
							{ s.RecurrenceLabel() }
						</span>
					}
					if len(s.Attendees) > 0 {
						<span>
							<i class="fa-solid fa-users mr-0.5"></i>
							<span
								data-gn-count
								data-accepted={ fmt.Sprintf("%d", countAccepted(s.Attendees)) }
								data-total={ fmt.Sprintf("%d", len(s.Attendees)) }
							>{ fmt.Sprintf(" %d/%d attending", countAccepted(s.Attendees), len(s.Attendees)) }</span>
						</span>
					}
					if s.CreatorName != "" {
						<span>
							<i class="fa-solid fa-user mr-0.5"></i>
							{ s.CreatorName }
						</span>
					}
				</div>
				if s.Summary != nil && *s.Summary != "" {
					<p class="text-sm text-fg-secondary mt-1 line-clamp-2">{ *s.Summary }</p>
				}
			</div>
			<div class="flex items-center gap-2 ml-2 shrink-0">
				if answering {
					<span class="gn-above" data-gn-chip>
						@gameNightAnswer(s, mine)
					</span>
				}
				<i class="fa-solid fa-chevron-right text-fg-muted text-xs" aria-hidden="true"></i>
			</div>
		</div>
		if answering {
			<div class="gn-drape gn-above" id={ "gn-a-" + s.ID } data-gn-drape>
				<div>
					<div class="gn-bar" role="group" aria-label={ "Your answer for " + s.Name }>
						<span class="gn-bar-l">Are you coming?</span>
						@gameNightPick(RSVPAccepted, "fa-check", "Going", mine)
						@gameNightPick(RSVPTentative, "fa-question", "Maybe", mine)
						@gameNightPick(RSVPDeclined, "fa-xmark", "Can't", mine)
					</div>
				</div>
			</div>
		}
	</div>
}

// gameNightAnswer is the row's answer chip: an Answer button until the member
// answers, then their answer, which is itself the button to change it. Both
// open the row's Going / Maybe / Can't.
templ gameNightAnswer(s Session, mine string) {
	if word := answerWord(mine); word != "" {
		<button
			type="button"
			class={ "gn-mine", "gn-mine-" + mine }
			data-gn-answer
			aria-expanded="false"
			aria-controls={ "gn-a-" + s.ID }
			aria-label={ "Your answer for " + s.Name + ": " + word + ". Change it" }
			title="Change your answer"
		>
			<i class={ "fa-solid", answerIcon(mine) } aria-hidden="true"></i> { word }
		</button>
	} else {
		<button
			type="button"
			class="gn-answer"
			data-gn-answer
			aria-expanded="false"
			aria-controls={ "gn-a-" + s.ID }
			aria-label={ "Answer for " + s.Name }
		>
			Answer <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
		</button>
	}
}

// gameNightPick is one of Going, Maybe and Can't in a row's drape.
templ gameNightPick(status, icon, word, mine string) {
	<button type="button" class="gn-rb" data-gn-rsvp={ status } aria-pressed={ fmt.Sprintf("%t", mine == status) }>
		<i class={ "fa-solid", icon } aria-hidden="true"></i> { word }
	</button>
}

// answerWord is the list's word for a member's stored answer, or "" while
// they have none (no row yet, or still invited).
func answerWord(status string) string {
	switch status {
	case RSVPAccepted:
		return "Going"
	case RSVPTentative:
		return "Maybe"
	case RSVPDeclined:
		return "Can't"
	}
	return ""
}

// answerIcon is the icon beside answerWord.
func answerIcon(status string) string {
	switch status {
	case RSVPAccepted:
		return "fa-check"
	case RSVPTentative:
		return "fa-question"
	}
	return "fa-xmark"
}

// sessionStatusBadge renders a colored status badge.
// playedBadge marks a planned night whose date has passed: it happened,
// but nobody has marked it complete.
templ playedBadge() {
	<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-surface-alt text-fg-secondary">
		<i class="fa-solid fa-flag-checkered text-[10px] mr-0.5"></i> Played
	</span>
}

templ sessionStatusBadge(status string) {
	if status == StatusPlanned {
		<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-accent/10 text-accent">
			<i class="fa-solid fa-clock text-[10px] mr-0.5"></i> Planned
		</span>
	} else if status == StatusCompleted {
		<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-ok/10 text-ok">
			<i class="fa-solid fa-check text-[10px] mr-0.5"></i> Completed
		</span>
	} else {
		<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-surface-alt text-fg-secondary">
			<i class="fa-solid fa-ban text-[10px] mr-0.5"></i> Cancelled
		</span>
	}
}

// createSessionModal renders the create session dialog. With a plan (the
// calendar's "Plan it") it opens at once with the day and time filled in.
templ createSessionModal(cc *campaigns.CampaignContext, csrfToken string, plan SessionPlan) {
	<dialog
		id="create-session-modal"
		class="rounded-lg shadow-xl bg-surface border border-edge p-0 w-full max-w-md backdrop:bg-black/50"
		if plan.Active() {
			x-data
			x-init="$el.showModal()"
		}
	>
		<form
			method="POST"
			action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/sessions", cc.Campaign.ID)) }
			class="p-6"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			if plan.TZ != "" {
				<input type="hidden" name="scheduled_tz" value={ plan.TZ }/>
			}
			<h2 class="text-lg font-semibold text-fg mb-4">New Session</h2>
			<div class="space-y-4" x-data="{ recurring: false, recType: '' }">
				<div>
					<label class="block text-sm font-medium text-fg-body mb-1">Session Name</label>
					<input type="text" name="name" class="input w-full" required placeholder="e.g. Session 12: The Dragon's Lair"/>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1">Scheduled Date</label>
						<input type="date" name="scheduled_date" class="input w-full" value={ plan.Date }/>
					</div>
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1">Time <span class="text-fg-muted font-normal">(optional)</span></label>
						<input type="time" name="scheduled_time" class="input w-full" value={ plan.Time }/>
					</div>
					<p class="text-xs text-fg-muted mt-1 col-span-2">When does this session happen in real life?</p>
				</div>
				<div>
					<label class="block text-sm font-medium text-fg-body mb-1">Summary</label>
					<textarea name="summary" class="input w-full" rows="3" placeholder="Brief session description..."></textarea>
				</div>
				<!-- Recurrence -->
				<div>
					<label class="flex items-center gap-2 text-sm font-medium text-fg-body cursor-pointer">
						<input type="checkbox" name="is_recurring" value="1" x-model="recurring" class="accent-accent"/>
						Repeating session
					</label>
				</div>
				<div x-show="recurring" x-transition x-cloak class="space-y-3 pl-4 border-l-2 border-accent/30">
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">Frequency</label>
						<select name="recurrence_type" x-model="recType" class="input w-full text-sm">
							<option value="">Select...</option>
							<option value="weekly">Every week</option>
							<option value="biweekly">Every 2 weeks</option>
							<option value="monthly">Monthly</option>
							<option value="custom">Custom interval</option>
						</select>
					</div>
					<div x-show="recType === 'custom'" x-transition>
						<label class="block text-xs font-medium text-fg-body mb-1">Every N weeks</label>
						<input type="number" name="recurrence_interval" min="1" max="52" value="3" class="input w-24 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">End date (optional)</label>
						<input type="date" name="recurrence_end_date" class="input w-full text-sm"/>
						<p class="text-xs text-fg-muted mt-0.5">Leave empty for no end date.</p>
					</div>
				</div>
			</div>
			<div class="flex items-center justify-end gap-2 mt-6">
				<button type="button" class="btn-secondary text-sm" onclick="this.closest('dialog').close()">
					Cancel
				</button>
				<button type="submit" class="btn-primary text-sm">
					<i class="fa-solid fa-plus mr-1"></i> Create Session
				</button>
			</div>
		</form>
	</dialog>
}

// SessionDetailPage renders the full session detail view.
templ SessionDetailPage(cc *campaigns.CampaignContext, session *Session, csrfToken string, isOwner, isScribe bool, userID string, recap RecapView, viewerTZ string) {
	@layouts.App(session.Name + " - " + cc.Campaign.Name) {
		<div class="max-w-4xl mx-auto">
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: fmt.Sprintf("/campaigns/%s", cc.Campaign.ID), Icon: "fa-dice-d20"},
				{Label: "Game nights", Href: fmt.Sprintf("/campaigns/%s/sessions", cc.Campaign.ID)},
				{Label: session.Name},
			})
			<!-- Header -->
			<div class="flex items-start justify-between mb-6">
				<div>
					<div class="flex items-center gap-2 mb-1">
						if recap.Played {
							@playedBadge()
						} else {
							@sessionStatusBadge(session.Status)
						}
						<h1 class="text-2xl font-bold text-fg">{ session.Name }</h1>
					</div>
					<div class="flex items-center gap-3 text-sm text-fg-secondary">
						if session.ScheduledDate != nil {
							<span>
								<i class="fa-regular fa-calendar mr-0.5"></i>
								{ session.FormatScheduledFor(viewerTZ) }
							</span>
						}
						if session.IsRecurring {
							<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-surface-alt text-fg-secondary border border-edge">
								<i class="fa-solid fa-repeat text-[10px] mr-0.5"></i>
								{ session.RecurrenceLabel() }
							</span>
						}
						if session.CreatorName != "" {
							<span>
								<i class="fa-solid fa-user mr-0.5"></i>
								Created by { session.CreatorName }
							</span>
						}
					</div>
				</div>
				if isScribe {
					<div class="flex items-center gap-2">
						<button
							type="button"
							class="btn-secondary text-sm"
							onclick="document.getElementById('edit-session-modal').showModal()"
						>
							<i class="fa-solid fa-pen mr-1"></i> Edit
						</button>
						if session.Status == StatusPlanned {
							// Mark Complete sends ONLY {status} — the one thing the
							// button means. Under the partial-write contract, every
							// other absent key preserves the stored value instead of
							// erasing the schedule, summary, in-world date and
							// recurrence config.
							<button
								type="button"
								class="btn-primary text-sm"
								data-url={ fmt.Sprintf("/campaigns/%s/sessions/%s", cc.Campaign.ID, session.ID) }
								onclick="Chronicle.apiFetch(this.dataset.url,{method:'PUT',body:{status:'completed'}}).then(function(r){if(r.ok)location.reload();else Chronicle.notify('Failed to complete session','error');});"
							>
								<i class="fa-solid fa-check mr-1"></i> Mark Complete
							</button>
						}
						if isOwner {
							<button
								type="button"
								class="text-sm text-bad hover:text-bad/80"
								hx-delete={ fmt.Sprintf("/campaigns/%s/sessions/%s", cc.Campaign.ID, session.ID) }
								hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
								hx-confirm="Delete this session? This cannot be undone."
							>
								<i class="fa-solid fa-trash text-xs"></i>
							</button>
						}
					</div>
				}
			</div>
			<!-- Summary -->
			if session.Summary != nil && *session.Summary != "" {
				<div class="card p-4 mb-6">
					<h2 class="text-sm font-semibold text-fg mb-2">Summary</h2>
					<p class="text-sm text-fg-body whitespace-pre-wrap">{ *session.Summary }</p>
				</div>
			}
			<!-- Session Recap (members only, written by Scribes+): a recap has no
			     visibility of its own, so a public campaign's visitors never see it.
			     Writers get the page editor (formatting, @links, pictures,
			     autosave); everyone else reads the saved HTML. -->
			if recap.Open && cc.IsMember {
				<div class={ "mb-6", templ.KV("card p-4", !isScribe) } id="session-recap">
					if isScribe {
						<div
							data-widget="editor"
							data-endpoint={ fmt.Sprintf("/campaigns/%s/sessions/%s/recap", cc.Campaign.ID, session.ID) }
							data-campaign-id={ cc.Campaign.ID }
							data-editable="true"
							data-autosave="5"
							data-label="Recap"
							data-placeholder="What happened? Type @ to link a page."
							data-secrets="false"
							data-open-to-players="true"
							if recap.StartWriting {
								data-start-editing="true"
							}
							data-csrf-token={ csrfToken }
						></div>
					} else {
						<h2 class="text-sm font-semibold text-fg mb-2">
							<i class="fa-solid fa-scroll mr-1 text-accent"></i> Recap
						</h2>
						if session.RecapHTML != nil && *session.RecapHTML != "" {
							<div class="prose prose-sm text-fg-body">
								@templ.Raw(*session.RecapHTML)
							</div>
						} else {
							<p class="text-sm text-fg-muted italic">No recap written yet.</p>
						}
					}
				</div>
			}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Attendees / RSVP -->
				<div class="card p-4">
					<h2 class="text-sm font-semibold text-fg mb-3">
						<i class="fa-solid fa-users mr-1 text-accent"></i> Attendees
					</h2>
					<div id="attendee-list">
						@AttendeeList(cc, session.ID, session.Attendees, csrfToken, userID, session.AcceptsRSVP())
					</div>
				</div>
				<!-- Linked Entities -->
				<div class="card p-4">
					<h2 class="text-sm font-semibold text-fg mb-3">
						<i class="fa-solid fa-link mr-1 text-accent"></i> Linked Pages
					</h2>
					if len(session.Entities) == 0 {
						<p class="text-sm text-fg-muted">No pages linked to this session yet.</p>
					} else {
						<div class="space-y-1.5">
							for _, se := range session.Entities {
								<div class="flex items-center justify-between text-sm">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, se.EntitySlug)) }
										class="text-accent hover:underline truncate"
									>
										{ se.EntityName }
									</a>
									<span class="text-xs text-fg-muted capitalize">{ se.Role }</span>
								</div>
							}
						</div>
					}
				</div>
			</div>
			if isScribe {
				@editSessionModal(cc, session, csrfToken)
			}
		</div>
	}
}

// editSessionModal renders the edit session dialog.
templ editSessionModal(cc *campaigns.CampaignContext, session *Session, csrfToken string) {
	<dialog id="edit-session-modal" class="rounded-lg shadow-xl bg-surface border border-edge p-0 w-full max-w-md backdrop:bg-black/50">
		<div class="p-6">
			<h2 class="text-lg font-semibold text-fg mb-4">Edit Session</h2>
			<div class="space-y-4" x-data={ fmt.Sprintf("{ recurring: %t, recType: '%s' }", session.IsRecurring, jsEsc(derefStr(session.RecurrenceType))) }>
				<div>
					<label class="block text-sm font-medium text-fg-body mb-1">Session Name</label>
					<input type="text" id="edit-session-name" class="input w-full" required value={ session.Name }/>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1">Scheduled Date</label>
						<input type="date" id="edit-session-date" class="input w-full" value={ derefStr(session.ScheduledDate) }/>
					</div>
					<div>
						<label class="block text-sm font-medium text-fg-body mb-1">Time <span class="text-fg-muted font-normal">(optional)</span></label>
						<input type="time" id="edit-session-time" class="input w-full" value={ derefStr(session.ScheduledTime) }/>
					</div>
				</div>
				<div>
					<label class="block text-sm font-medium text-fg-body mb-1">Summary</label>
					<textarea id="edit-session-summary" class="input w-full" rows="3">{ derefStr(session.Summary) }</textarea>
				</div>
				<div>
					<label class="block text-sm font-medium text-fg-body mb-1">Status</label>
					<select id="edit-session-status" class="input w-full text-sm" data-initial={ session.Status }>
						<option value="planned">Planned</option>
						<option value="completed">Completed</option>
						<option value="cancelled">Cancelled</option>
					</select>
				</div>
				<!-- Recurrence -->
				<div>
					<label class="flex items-center gap-2 text-sm font-medium text-fg-body cursor-pointer">
						<input
							type="checkbox"
							id="edit-session-recurring"
							x-model="recurring"
							class="accent-accent"
							if session.IsRecurring {
								checked
							}
						/>
						Repeating session
					</label>
				</div>
				<div x-show="recurring" x-transition x-cloak class="space-y-3 pl-4 border-l-2 border-accent/30">
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">Frequency</label>
						<select id="edit-session-recurrence-type" x-model="recType" class="input w-full text-sm">
							<option value="">Select...</option>
							<option value="weekly">Every week</option>
							<option value="biweekly">Every 2 weeks</option>
							<option value="monthly">Monthly</option>
							<option value="custom">Custom interval</option>
						</select>
					</div>
					<div x-show="recType === 'custom'" x-transition>
						<label class="block text-xs font-medium text-fg-body mb-1">Every N weeks</label>
						<input type="number" id="edit-session-recurrence-interval" min="1" max="52" class="input w-24 text-sm" value={ fmt.Sprintf("%d", session.RecurrenceInterval) }/>
					</div>
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">End date (optional)</label>
						<input type="date" id="edit-session-recurrence-end" class="input w-full text-sm" value={ derefStr(session.RecurrenceEndDate) }/>
					</div>
				</div>
			</div>
			<div class="flex items-center justify-end gap-2 mt-6">
				<button type="button" class="btn-secondary text-sm" onclick="this.closest('dialog').close()">
					Cancel
				</button>
				<button type="button" class="btn-primary text-sm" id="edit-session-save-btn">
					<i class="fa-solid fa-check mr-1"></i> Save Changes
				</button>
			</div>
		</div>
		<script>
			(function() {
				// Set initial select value from data attribute.
				var statusSelect = document.getElementById('edit-session-status');
				if (statusSelect && statusSelect.dataset.initial) {
					statusSelect.value = statusSelect.dataset.initial;
				}
				var btn = document.getElementById('edit-session-save-btn');
				if (!btn) return;
				btn.addEventListener('click', function() {
					var name = document.getElementById('edit-session-name').value.trim();
					if (!name) {
						Chronicle.notify('Session name is required', 'error');
						return;
					}
					var summary = document.getElementById('edit-session-summary').value;
					var date = document.getElementById('edit-session-date').value;
					var timeEl = document.getElementById('edit-session-time');
					var time = timeEl ? timeEl.value : '';
					var status = document.getElementById('edit-session-status').value;
					var recurring = document.getElementById('edit-session-recurring').checked;
					var recType = document.getElementById('edit-session-recurrence-type');
					var recInterval = document.getElementById('edit-session-recurrence-interval');
					var recEnd = document.getElementById('edit-session-recurrence-end');

					var body = {
						name: name,
						summary: summary || null,
						scheduled_date: date || null,
						scheduled_time: time || null,
						status: status,
						is_recurring: recurring
					};
					if (recurring && recType) {
						body.recurrence_type = recType.value || null;
						body.recurrence_interval = recInterval ? parseInt(recInterval.value) || 0 : 0;
						body.recurrence_end_date = recEnd ? (recEnd.value || null) : null;
					}

					btn.disabled = true;
					btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs mr-1"></i> Saving...';

					Chronicle.apiFetch(location.pathname, {
						method: 'PUT',
						body: body
					}).then(function(res) {
						if (res.ok) {
							location.reload();
						} else {
							res.json().then(function(d) {
								Chronicle.notify(d.error || 'Failed to update session', 'error');
							}).catch(function() {
								Chronicle.notify('Failed to update session', 'error');
							});
						}
					}).catch(function() {
						Chronicle.notify('Failed to update session', 'error');
					}).finally(function() {
						btn.disabled = false;
						btn.innerHTML = '<i class="fa-solid fa-check mr-1"></i> Save Changes';
					});
				});
			})();
		</script>
	</dialog>
}

// AttendeeList renders the RSVP attendee list with action buttons. open is
// Session.AcceptsRSVP: a night that is over lists who came and asks nothing.
templ AttendeeList(cc *campaigns.CampaignContext, sessionID string, attendees []Attendee, csrfToken string, currentUserID string, open bool) {
	if len(attendees) == 0 {
		<p class="text-sm text-fg-muted">No attendees invited yet.</p>
	} else {
		if cc.IsMember || cc.IsSiteAdmin {
			<div class="space-y-2">
				for _, a := range attendees {
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<div class="w-6 h-6 rounded-full bg-accent/20 flex items-center justify-center shrink-0">
								<span class="text-[10px] font-medium text-accent">
									{ string([]rune(a.DisplayName)[0:1]) }
								</span>
							</div>
							<span class="text-sm text-fg">{ a.DisplayName }</span>
						</div>
						@rsvpBadge(a.Status)
					</div>
				}
			</div>
		} else {
			<!-- Public (anon / non-member) visitors see aggregate counts, not
			     attendee names. -->
			<p class="text-sm text-fg-muted">
				{ fmt.Sprintf("%d going · %d invited", countAccepted(attendees), len(attendees)) }
			</p>
		}
	}
	<!-- Current user RSVP controls.
	     THESE RENDER FOR EVERY MEMBER, not only for members who already hold a
	     session_attendees row. InviteAll runs at session-creation time only and
	     no route adds an attendee afterwards, so a player who joined the
	     campaign after a session existed used to see the attendee list, see the
	     "3 going · 4 invited" line, and find NO RSVP buttons anywhere — with no
	     Director-side invite action either. They were also inside the
	     `len(attendees) == 0` else-branch, so a session with no attendees at all
	     showed nobody any controls. The RSVP endpoint upserts, so a member with
	     no row is a first-class responder. -->
	if cc.IsMember && currentUserID != "" && open {
		@rsvpControls(cc, sessionID, csrfToken, myRSVPStatus(attendees, currentUserID))
	}
}

// rsvpControls renders the Going / Maybe / Can't buttons for the current member.
// myStatus is "" when they have no attendee row yet, which highlights nothing —
// the honest rendering of "you have not answered".
templ rsvpControls(cc *campaigns.CampaignContext, sessionID, csrfToken, myStatus string) {
	<div class="mt-4 pt-4 border-t border-edge">
		<p class="text-sm font-semibold text-fg mb-2">
			<i class="fa-solid fa-envelope-open-text mr-1 text-accent"></i> RSVP
		</p>
		<div class="flex gap-2">
			<button
				class={ "text-sm px-3 py-1.5 rounded-md transition-colors inline-flex items-center gap-1",
					templ.KV("bg-ok/10 text-ok font-medium ring-1 ring-ok/40", myStatus == RSVPAccepted),
					templ.KV("bg-surface-secondary text-fg-secondary hover:bg-ok/10", myStatus != RSVPAccepted) }
				hx-post={ fmt.Sprintf("/campaigns/%s/sessions/%s/rsvp", cc.Campaign.ID, sessionID) }
				hx-headers={ fmt.Sprintf(`{"Content-Type":"application/json","X-CSRF-Token":"%s"}`, csrfToken) }
				hx-vals='{"status":"accepted"}'
				hx-target="#attendee-list"
				hx-swap="innerHTML"
			>
				<i class="fa-solid fa-check"></i> Going
			</button>
			<button
				class={ "text-sm px-3 py-1.5 rounded-md transition-colors inline-flex items-center gap-1",
					templ.KV("bg-warn/10 text-warn font-medium ring-1 ring-warn/40", myStatus == RSVPTentative),
					templ.KV("bg-surface-secondary text-fg-secondary hover:bg-warn/10", myStatus != RSVPTentative) }
				hx-post={ fmt.Sprintf("/campaigns/%s/sessions/%s/rsvp", cc.Campaign.ID, sessionID) }
				hx-headers={ fmt.Sprintf(`{"Content-Type":"application/json","X-CSRF-Token":"%s"}`, csrfToken) }
				hx-vals='{"status":"tentative"}'
				hx-target="#attendee-list"
				hx-swap="innerHTML"
			>
				<i class="fa-solid fa-question"></i> Maybe
			</button>
			<button
				class={ "text-sm px-3 py-1.5 rounded-md transition-colors inline-flex items-center gap-1",
					templ.KV("bg-bad/10 text-bad font-medium ring-1 ring-bad/40", myStatus == RSVPDeclined),
					templ.KV("bg-surface-secondary text-fg-secondary hover:bg-bad/10", myStatus != RSVPDeclined) }
				hx-post={ fmt.Sprintf("/campaigns/%s/sessions/%s/rsvp", cc.Campaign.ID, sessionID) }
				hx-headers={ fmt.Sprintf(`{"Content-Type":"application/json","X-CSRF-Token":"%s"}`, csrfToken) }
				hx-vals='{"status":"declined"}'
				hx-target="#attendee-list"
				hx-swap="innerHTML"
			>
				<i class="fa-solid fa-xmark"></i> Can't
			</button>
		</div>
	</div>
}

// rsvpBadge renders a small RSVP status indicator.
templ rsvpBadge(status string) {
	if status == RSVPAccepted {
		<span class="text-[10px] px-1.5 py-0.5 rounded bg-ok/10 text-ok">Going</span>
	} else if status == RSVPTentative {
		<span class="text-[10px] px-1.5 py-0.5 rounded bg-warn/10 text-warn">Maybe</span>
	} else if status == RSVPDeclined {
		<span class="text-[10px] px-1.5 py-0.5 rounded bg-bad/10 text-bad">Can't</span>
	} else {
		<span class="text-[10px] px-1.5 py-0.5 rounded bg-surface-alt text-fg-muted">Invited</span>
	}
}

// myRSVPStatus returns the current user's stored RSVP status, or "" when they
// hold no attendee row for this session yet. "" is a real state — "you have not
// answered" — and is deliberately not collapsed into "invited": a member who
// joined the campaign after the session was created was never invited to it.
func myRSVPStatus(attendees []Attendee, userID string) string {
	if userID == "" {
		return ""
	}
	for _, a := range attendees {
		if a.UserID == userID {
			return a.Status
		}
	}
	return ""
}

// countAccepted returns the number of attendees with "accepted" status.
func countAccepted(attendees []Attendee) int {
	count := 0
	for _, a := range attendees {
		if a.Status == RSVPAccepted {
			count++
		}
	}
	return count
}

// derefStr safely dereferences a *string, returning "" if nil.
func derefStr(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

// jsEsc escapes a string for safe embedding inside a single-quoted JavaScript
// string literal in an Alpine.js `x-data` expression. templ HTML-escapes the
// attribute and the browser HTML-decodes it before Alpine evaluates it as JS,
// but a backslash is not an HTML metacharacter, so `\'` stays an escaped quote
// through that round-trip and cannot break out of the literal. Re-declared
// locally (mirrors the entities plugin's helper of the same name) to keep the
// sessions plugin free of a cross-plugin dependency (plugin isolation).
func jsEsc(s string) string {
	result := ""
	for _, c := range s {
		switch c {
		case '\'':
			result += "\\'"
		case '\\':
			result += "\\\\"
		case '\n':
			result += "\\n"
		case '\r':
			result += "\\r"
		default:
			result += string(c)
		}
	}
	return result
}

// SessionsEmbedFragment renders a compact list of planned sessions for dashboard embedding.
// Shows session name, date, and RSVP counts. Empty state if no planned sessions.
// Each opens its night in the calendar (through GameNightsLink).
templ SessionsEmbedFragment(campaignID string, sessions []Session, userID string, today string, viewerTZ string) {
	if len(sessions) == 0 {
		<div class="px-4 py-6 text-center">
			<i class="fa-solid fa-dice-d20 text-xl text-fg-muted mb-2"></i>
			<p class="text-sm text-fg-secondary">No upcoming sessions.</p>
		</div>
	} else {
		for _, s := range sessions {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/game-nights?session=%s&date=%s", campaignID, url.QueryEscape(s.ID), url.QueryEscape(sidebarNightDate(s, today)))) }
				class="flex items-center gap-3 px-4 py-3 hover:bg-surface-alt/50 transition-colors group"
			>
				<div class="shrink-0">
					@sidebarRSVPBadge(s.Attendees, userID)
				</div>
				<div class="flex-1 min-w-0">
					<div class="text-sm font-medium text-fg truncate group-hover:text-accent transition-colors">{ s.Name }</div>
					if s.ScheduledDate != nil && *s.ScheduledDate != "" {
						<div class="text-xs text-fg-muted">{ s.FormatScheduledFor(viewerTZ) }</div>
					}
				</div>
				<div class="shrink-0 text-xs text-fg-muted">
					<span class="inline-flex items-center gap-1">
						<i class="fa-solid fa-users text-[10px]"></i>
						{ fmt.Sprintf("%d/%d", countAccepted(s.Attendees), len(s.Attendees)) }
					</span>
				</div>
			</a>
		}
	}
}

// sidebarRSVPBadge shows a small colored dot for the current user's RSVP status.
templ sidebarRSVPBadge(attendees []Attendee, userID string) {
	for _, a := range attendees {
		if a.UserID == userID {
			if a.Status == RSVPAccepted {
				<span class="w-2 h-2 rounded-full bg-ok" title="Going"></span>
			} else if a.Status == RSVPTentative {
				<span class="w-2 h-2 rounded-full bg-warn" title="Maybe"></span>
			} else if a.Status == RSVPDeclined {
				<span class="w-2 h-2 rounded-full bg-bad" title="Can't go"></span>
			} else {
				<span class="w-2 h-2 rounded-full bg-fg-muted" title="No response"></span>
			}
		}
	}
}
