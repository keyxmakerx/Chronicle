// foundry_creatures.templ — the Foundry page's "Creatures in Foundry" card:
// each creature page and the monster in Foundry it is matched to, with the
// look-alikes waiting for the owner to confirm first.

package syncapi

import (
	"fmt"
	"strconv"
)

// FoundryCreaturesView is the card body.
type FoundryCreaturesView struct {
	CampaignID string
	Matches    FoundryMatches
	// Error is a plain sentence when the last change failed.
	Error string
}

// FoundryCreaturesFragment is the card body, swapped whole after each change.
templ FoundryCreaturesFragment(v FoundryCreaturesView) {
	<div id="foundry-creatures-body" data-foundry-creatures>
		if v.Error != "" {
			<p class="px-4 py-2 text-sm text-red-700 dark:text-red-400 border-b border-edge" role="alert">{ v.Error }</p>
		}
		if v.Matches.ReportedAt == nil {
			<p class="px-4 py-3 text-sm text-fg-secondary">
				Foundry hasn't sent its monster list yet. Your world sends it once it runs the newest Chronicle Sync module; until then each creature page plays with its own numbers.
			</p>
		} else if len(v.Matches.Matches) == 0 {
			<p class="px-4 py-3 text-sm text-fg-secondary">This campaign has no creature pages yet.</p>
		} else {
			<ul class="divide-y divide-edge">
				for _, m := range creaturesByNeed(v.Matches.Matches) {
					@foundryCreatureRow(v.CampaignID, m)
				}
			</ul>
			<p class="px-4 py-2 text-xs text-fg-muted border-t border-edge">
				if v.Matches.Truncated {
					Showing the first { strconv.Itoa(v.Matches.Total) } creature pages.
				}
				As Foundry reported its monsters { relativeTime(*v.Matches.ReportedAt) }. Your AI sees each match, so it writes lore for matched pages and full stat blocks only for yours.
			</p>
		}
	</div>
}

templ foundryCreatureRow(campaignID string, m CreatureMatch) {
	<li class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3" data-match-state={ m.State }>
		<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", campaignID, m.EntityID)) } class="text-sm font-medium text-fg hover:underline flex-1 min-w-0 truncate">{ m.EntityName }</a>
		switch m.State {
			case MatchMatched:
				<span class="inline-block rounded-full bg-emerald-500/15 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:text-emerald-400">
					Matched &middot; { useWords(m.Use) }
				</span>
				<span class="text-xs text-fg-muted w-full sm:w-auto">{ monsterWhere(m.Monster) }</span>
			case MatchMissing:
				<span class="inline-block rounded-full bg-amber-500/15 px-2 py-0.5 text-xs font-medium text-amber-700 dark:text-amber-400">
					Foundry no longer has { m.Monster.Name }
				</span>
			case MatchSuggested:
				<span class="inline-block rounded-full bg-amber-500/15 px-2 py-0.5 text-xs font-medium text-amber-700 dark:text-amber-400">
					Looks like Foundry's { m.Monster.Name }
				</span>
				<span class="flex gap-2 w-full sm:w-auto">
					<button type="button" class="btn-primary btn-sm"
						hx-post={ fmt.Sprintf("/campaigns/%s/foundry/creatures/%s", campaignID, m.EntityID) }
						hx-vals={ matchVals("match", m.Monster) }
						hx-target="#foundry-creatures-body" hx-swap="outerHTML">Match</button>
					<button type="button" class="btn-secondary btn-sm"
						hx-post={ fmt.Sprintf("/campaigns/%s/foundry/creatures/%s", campaignID, m.EntityID) }
						hx-vals={ matchVals("not_same", m.Monster) }
						hx-target="#foundry-creatures-body" hx-swap="outerHTML">Not the same</button>
				</span>
			default:
				<span class="inline-block rounded-full bg-surface-alt px-2 py-0.5 text-xs font-medium text-fg-secondary">Yours only &middot; sync makes its actor</span>
		}
	</li>
}
