// activity.templ renders the campaign activity page showing aggregate stats
// and a chronological timeline of user actions within the campaign.

package audit

import (
	"github.com/keyxmakerx/chronicle/internal/timeutil"
	"fmt"
	"strings"
	"time"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
)

// actionLabel returns a human-readable description for an audit action.
func actionLabel(action string) string {
	switch action {
	case ActionEntityCreated:
		return "created"
	case ActionEntityUpdated:
		return "updated"
	case ActionEntityDeleted:
		return "deleted"
	case ActionEntityClaimed:
		return "claimed"
	case ActionEntityOwnerChanged:
		return "reassigned owner of"
	case ActionMemberJoined:
		return "joined the campaign"
	case ActionMemberLeft:
		return "left the campaign"
	case ActionMemberRoleChanged:
		return "changed role for"
	case ActionCampaignUpdated:
		return "updated campaign settings"
	case ActionItemShared:
		return "shared an item"
	case ActionTagCreated:
		return "created tag"
	case ActionTagDeleted:
		return "deleted tag"
	case ActionTrashRestored:
		return "restored from the Trash"
	case ActionEntityTypeCreated:
		return "created category"
	case ActionEntityTypeUpdated:
		return "changed category"
	case ActionEntityTypeDeleted:
		return "deleted category"
	case "member.invited":
		return "invited someone"
	case "member.allowed_back":
		return "let someone back in"
	case "campaign.archived":
		return "archived the campaign"
	case "campaign.unarchived":
		return "unarchived the campaign"
	case "campaign.handed_over":
		return "handed the campaign over"
	case "group.created":
		return "created group"
	case "group.updated":
		return "changed group"
	case "group.deleted":
		return "deleted group"
	case "group.member_added":
		return "added someone to group"
	case "group.member_removed":
		return "removed someone from group"
	case "trash.emptied":
		return "emptied the Trash"
	case "trash.campaign_restored":
		return "brought the campaign back from the Trash"
	case "trash.files_restored":
		return "brought files back from the Trash"
	case "trash.retention_changed", "trash.long_term_changed":
		return "changed how long the Trash keeps things"
	case "addon.changed":
		return "switched a feature"
	case "addon.enabled":
		return "switched on"
	case "addon.disabled":
		return "switched off"
	default:
		if words, ok := campaignWords[action]; ok {
			return words
		}
		return actionFallback(action)
	}
}

// actionArea is the part of an action key before the dot.
func actionArea(action string) string {
	area, _, _ := strings.Cut(action, ".")
	return area
}

// actionAreas names what an action without words of its own changed, by its
// area. Areas with action constants take them from those, so another
// plugin's name is never written out here.
var actionAreas = map[string]string{
	actionArea(ActionCalendarCreated):   "changed the calendar",
	actionArea(ActionTimelineCreated):   "changed timeline",
	actionArea(ActionEntityCreated):     "changed",
	actionArea(ActionEntityTypeCreated): "changed category",
	actionArea(ActionMemberJoined):      "changed who is in the campaign",
	actionArea(ActionCampaignUpdated):   "changed the campaign",
	actionArea(ActionTrashRestored):     "changed the Trash",
	actionArea(ActionTagCreated):        "changed tags on",
	actionArea(ActionItemShared):        "changed item",
	"group":                             "changed group",
	"guest":                             "changed guest access",
}

// entityTypeWords shows the kind of thing an entry names as words: a stored
// kind such as "calendar_event" reads "calendar event", whatever wrote it.
func entityTypeWords(t string) string {
	return strings.Join(strings.FieldsFunc(t, func(r rune) bool { return r == '_' || r == '.' || r == '-' }), " ")
}

// actionFallback keeps a key the log has no words for out of the page: it
// says what area changed, or only that something did, never the raw key.
func actionFallback(action string) string {
	if words, ok := actionAreas[actionArea(action)]; ok {
		return words
	}
	return "made a change"
}

// actionColor returns Tailwind color classes for an action's timeline dot.
func actionColor(action string) string {
	switch action {
	case ActionEntityCreated:
		return "bg-emerald-400 dark:bg-emerald-500"
	case ActionEntityUpdated:
		return "bg-blue-400 dark:bg-blue-500"
	case ActionEntityDeleted:
		return "bg-red-400 dark:bg-red-500"
	case ActionEntityClaimed:
		return "bg-green-400 dark:bg-green-500"
	case ActionEntityOwnerChanged:
		return "bg-amber-400 dark:bg-amber-500"
	case ActionMemberJoined:
		return "bg-violet-400 dark:bg-violet-500"
	case ActionMemberLeft:
		return "bg-orange-400 dark:bg-orange-500"
	case ActionMemberRoleChanged:
		return "bg-amber-400 dark:bg-amber-500"
	case ActionCampaignUpdated:
		return "bg-indigo-400 dark:bg-indigo-500"
	case ActionTagCreated:
		return "bg-teal-400 dark:bg-teal-500"
	case ActionTagDeleted:
		return "bg-rose-400 dark:bg-rose-500"
	case ActionTrashRestored:
		return "bg-emerald-400 dark:bg-emerald-500"
	default:
		return "bg-gray-400 dark:bg-gray-500"
	}
}

// relativeTime formats a timestamp as a human-readable relative time string.
func relativeTime(t time.Time) string {
	now := time.Now().UTC()
	diff := now.Sub(t)

	switch {
	case diff < time.Minute:
		return "just now"
	case diff < time.Hour:
		mins := int(diff.Minutes())
		if mins == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", mins)
	case diff < 24*time.Hour:
		hours := int(diff.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	case diff < 7*24*time.Hour:
		days := int(diff.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	case diff < 30*24*time.Hour:
		weeks := int(diff.Hours() / 24 / 7)
		if weeks == 1 {
			return "1 week ago"
		}
		return fmt.Sprintf("%d weeks ago", weeks)
	default:
		return timeutil.FixedDate(t, timeutil.DateShort)
	}
}

// avatarInitial returns the first character of a name, uppercased, for
// use as an avatar placeholder.
func avatarInitial(name string) string {
	if name == "" {
		return "?"
	}
	return string([]rune(name)[0:1])
}

// formatWordCount formats a word count with thousands separators for display.
func formatWordCount(words int64) string {
	if words < 1000 {
		return fmt.Sprintf("%d", words)
	}
	if words < 1000000 {
		return fmt.Sprintf("%.1fK", float64(words)/1000)
	}
	return fmt.Sprintf("%.1fM", float64(words)/1000000)
}

// ActivityEmbedFragment renders a compact activity feed for dashboard embedding.
// Shows recent audit entries with user avatar, action, and relative time.
templ ActivityEmbedFragment(cc *campaigns.CampaignContext, entries []AuditEntry) {
	if len(entries) == 0 {
		<div class="px-4 py-6 text-center">
			<i class="fa-solid fa-clock-rotate-left text-xl text-fg-muted mb-2"></i>
			<p class="text-sm text-fg-secondary">No recent activity.</p>
		</div>
	} else {
		for _, entry := range entries {
			<div class="flex items-start gap-3 px-4 py-2.5 hover:bg-surface-alt/50 transition-colors">
				<div class="shrink-0 mt-0.5">
					<div class={ "w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold text-white", actionColor(entry.Action) }>
						{ avatarInitial(entry.UserName) }
					</div>
				</div>
				<div class="flex-1 min-w-0">
					<div class="flex items-baseline flex-wrap gap-x-1 text-xs">
						<span class="font-semibold text-fg">{ entry.UserName }</span>
						<span class="text-fg-secondary">{ entryLabel(entry) }</span>
						if entry.EntityName != "" && entry.EntityID != "" {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, entry.EntityID)) }
								class="font-medium text-accent hover:underline truncate max-w-[150px] inline-block align-bottom"
								title={ entry.EntityName }
							>
								{ entry.EntityName }
							</a>
						} else if entry.EntityName != "" {
							<span class="font-medium text-fg-body">{ entry.EntityName }</span>
						}
					</div>
					<p class="text-[10px] text-fg-muted mt-0.5">{ relativeTime(entry.CreatedAt) }</p>
				</div>
			</div>
		}
	}
}
