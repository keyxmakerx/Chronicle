package calendar

// bench_weekday.templ — the v4 WEEK and DAY surfaces (C-CALV4-WEEKDAY-VIEWS).
//
// See bench_weekday.go for the seat, the cursor and the one-pass argument. This
// file is markup only: every string, every span and every href below was
// computed by the producer, and nothing here queries, formats a date or decides
// a role.
//
// ── THREE RULES THIS FILE IS GRADED AGAINST ────────────────────────────────
//
// 1. NO LITERAL 7, ANYWHERE. The column track is `repeat(var(--cols), …)` and
//    --cols is len(w.Days), which for a week IS len(cal.Weekdays). --week-len
//    carries the calendar's own week length beside it so the sheet never has to
//    guess one. A ten-day week draws ten columns and Next moves ten days.
//
// 2. ZERO MOTION. calendar-bench.css declares exactly ONE
//    prefers-reduced-motion wrapper and TestBenchCSS_NoMotionAtAll asserts
//    every `transition` in the sheet lives inside it. This surface adds none —
//    no transition, no keyframe, no transform. The grid never moves.
//
// 3. GUARD B3 and GUARD B4. The view control is `data-view-pick`, never
//    `data-view` (which is one of the six <html> STATE_MARKERS). Every dated
//    node — column header, all-day cell, hour lane, event block — carries
//    `data-day`, the ANSWER key.
//
// ── HOW CLICKING AN EVENT OPENS ITS EDITOR, WITH NO NEW JS ─────────────────
//
// calendar_daycard.js triggers on `[data-day][data-day-ord]` inside a
// `[data-bench-block][data-calendar-id]` and looks the day up BY KEY. The
// column headers and every event chip below carry both attributes, the wrapper
// is bench.templ's existing `.benchblock`, and dayCardPayloadJSON emits THIS
// surface's days for this calendar — so the shipped card opens on a column, and
// the shipped Scribe+ editor opens from the card. No route, no script, no
// listener is added by this slice.
//
// ── WHAT IS DELIBERATELY NOT HERE ─────────────────────────────────────────
//
// `cell-drop-target` and `data-cell-hour`. V2 emitted both: the drop handler in
// event_grid.js PUT {…event, year, month, day} and NEVER read dataset.cellHour,
// so dropping an event on Tuesday 14:00 moved it to Tuesday at its old time —
// a day-level move wearing an hour-level control. Porting that would port the
// lie. There is no hour-aware reschedule on this surface and therefore no
// control that pretends to be one; the day card's editor is the write path and
// it binds the hour fields properly.

import (
	"fmt"
	"strings"
)

// benchWeekVars publishes the surface's two counts as custom properties.
//
// --cols is the drawn column count (len(Days)); --week-len is the CALENDAR'S
// OWN week length, carried even in the day view where one column is drawn, so
// the sheet and any future reader have the calendar's fact rather than a render
// artefact. --hour-rows is the calendar's own day length.
func benchWeekVars(w BenchWeekView) string {
	return fmt.Sprintf("--cols:%d;--week-len:%d;--hour-rows:%d",
		len(w.Days), w.WeekLen, w.HourRows)
}

// benchWeekEventStyle places one timed block on the hour axis. Both numbers are
// the producer's (benchWeekHourSpan); the template does no arithmetic.
func benchWeekEventStyle(col int, e BenchWeekEvent) string {
	return fmt.Sprintf("grid-column:%d;grid-row:%d / span %d;--axis:%s",
		col, e.RowStart, e.RowSpan, dayCardAxis(e.Mark.Axis))
}

// benchWeekLaneStyle spans one column's lane over every hour row.
func benchWeekLaneStyle(col int) string {
	return fmt.Sprintf("grid-column:%d;grid-row:1 / -1", col)
}

// benchWeekChipStyle inks one all-day chip. The axis is normalised through the
// SAME mirror the day card uses (dayCardAxis → axisToken), so a bare value can
// never reach a style attribute.
func benchWeekChipStyle(e BenchWeekEvent) string {
	return "--axis:" + dayCardAxis(e.Mark.Axis)
}

// benchWeekMoonLabel prints one moon's reading for the day view's celestial
// line. The producer supplies the phase word and the rounded percentage; this
// only joins them.
func benchWeekMoonLabel(m BenchWeekMoon) string {
	return fmt.Sprintf("%s · %s %d%%", m.Name, m.Phase, m.Illum)
}

// benchWeekAria names an event for a screen reader: its title, then its time
// when it has one, then "all day" when it does not. A chip whose only label is
// a coloured bar is unreadable, and the audience mark is GM-only ink that must
// not be announced to anyone the producer did not send it to — which it cannot
// be, because a player's Mark carries no Audience at all.
func benchWeekAria(d BenchWeekDay, e BenchWeekEvent) string {
	parts := []string{e.Mark.Title, d.Header}
	if e.AllDay {
		parts = append(parts, "all day")
	} else if e.TimeLabel != "" {
		parts = append(parts, e.TimeLabel)
	}
	if e.MultiDay {
		parts = append(parts, "spans several days")
	}
	if e.Mark.Audience != nil {
		parts = append(parts, e.Mark.Audience.Label)
	}
	return strings.Join(parts, ", ")
}

// benchWeekSurface is the whole week/day body.
templ benchWeekSurface(w BenchWeekView) {
	<section
		class={ "wkview", templ.KV("wkday", w.Kind == benchViewDay) }
		data-bench-week={ w.Kind }
		style={ benchWeekVars(w) }
	>
		<header class="wkhead">
			<div class="wkttl">
				<div class="wkspan">{ w.Heading }</div>
				if w.SubLabel != "" {
					<div class="wksub">{ w.SubLabel }</div>
				}
			</div>
			<span class="sp"></span>
			@benchViewSwitchView(w.Switch)
		</header>
		if w.Fault != "" {
			// THE FAULT PRINTS WHERE THE DATES WOULD GO and no grid is drawn —
			// the Block's own signed .calrow.warnrow behaviour, not a grid of
			// zeroes and not an em dash.
			<p class="wkfault" data-bench-week-fault>{ w.Fault }</p>
		} else {
			// THE THREE GRIDS SHARE ONE HORIZONTAL SCROLLER, and that is a
			// correctness requirement rather than a layout preference: the
			// column headers, the all-day strip and the hour lanes are three
			// grids over the SAME column track, so a reader who scrolls one and
			// not the others is reading Tuesday's events under Friday's name.
			//
			// AND THE VIEW IS REACHABLE ON A PHONE, which is where this departs
			// from V2. V2 hid the Week and Day pills outright below 768px
			// (`hidden md:contents`) because neither view had a phone layout —
			// so the surface simply did not exist on the device most likely to be
			// at the table. A ten-column week does not fit a phone and is not
			// asked to: it scrolls, inside its own box, with the page itself
			// never scrolling sideways.
			<div class="wkbody">
				@benchWeekColumnsView(w)
				@benchWeekAllDayView(w)
				// The hour axis scrolls VERTICALLY inside the horizontal one, so
				// the column headers stay put while the day's hours move — V2's
				// own max-h/overflow-y shape, kept because it is right.
				<div class="wkscroll">
					@benchWeekHourGrid(w)
				</div>
			</div>
			if len(w.Moons) > 0 {
				@benchWeekMoonsView(w)
			}
		}
	</section>
}

// benchViewSwitchView is the Month | Week | Day control.
//
// THREE <a> ELEMENTS AND A BOUNDED BOOST, the same construction benchNavTrio
// uses and for the same measured reasons: a bare hx-boost targets <body> and
// re-renders the sidebar, while `#main-content` is the layout's own content
// element and outerHTML avoids htmx's hx-select nesting a <main> inside a
// <main> on every step. The day card's payload rides `.cal-bench`, INSIDE
// #main-content, so a view switch cannot leave the card indexing the previous
// surface's days.
//
// GUARD B3: `data-view-pick`, because `data-view` is an <html> STATE MARKER and
// an interactive control may never reuse one.
//
// aria-current names the active view instead of the active pill being a
// disabled control — a control that vanishes or greys out when you are already
// there teaches the reader it is missing rather than satisfied, which is the
// same rule [GR-2] applies to `Today`.
templ benchViewSwitchView(s BenchViewSwitch) {
	if s.Live {
		<nav
			class="wkswitch"
			aria-label="Calendar view"
			hx-boost="true"
			hx-target="#main-content"
			hx-select="#main-content"
			hx-swap="outerHTML"
		>
			<a
				class={ "btn xs", templ.KV("fill", s.Active == benchViewMonth) }
				data-view-pick="month"
				href={ templ.SafeURL(s.MonthHref) }
				if s.Active == benchViewMonth {
					aria-current="page"
				}
			>Month</a>
			<a
				class={ "btn xs", templ.KV("fill", s.Active == benchViewWeek) }
				data-view-pick="week"
				href={ templ.SafeURL(s.WeekHref) }
				if s.Active == benchViewWeek {
					aria-current="page"
				}
			>Week</a>
			<a
				class={ "btn xs", templ.KV("fill", s.Active == benchViewDay) }
				data-view-pick="day"
				href={ templ.SafeURL(s.DayHref) }
				if s.Active == benchViewDay {
					aria-current="page"
				}
			>Day</a>
		</nav>
	}
}

// benchWeekColumnsView is the header row: one cell per day.
//
// EVERY HEADER IS THE DAY'S OWN ANSWER NODE. It carries data-day + data-day-ord
// (guard B4, and the day card's trigger), and it is a <button> rather than a
// <div> so the day is reachable by keyboard — V2's week columns were inert
// <div>s and its day popover did not open in week view at all.
templ benchWeekColumnsView(w BenchWeekView) {
	<div class="wkcols" data-bench-week-cols>
		<div class="wkgut" aria-hidden="true"></div>
		for _, d := range w.Days {
			<button
				type="button"
				class={ "wkcol",
					templ.KV("now", d.IsToday),
					templ.KV("rest", d.IsRest),
					templ.KV("ical", d.Intercalary) }
				data-day={ d.DayKey }
				data-day-ord={ d.DayOrd }
				data-cell={ fmt.Sprintf("%d", d.Day) }
				aria-label={ benchWeekColumnAria(d) }
			>
				<span class="wkwd">{ d.Weekday }</span>
				<span class="wkdt">{ d.MonthName } { fmt.Sprintf("%d", d.Day) }</span>
				if d.RealDate != "" {
					<span class="wkreal">{ d.RealDate }</span>
				}
				if len(d.Moons) > 0 {
					<span class="wkmoons" aria-hidden="true">
						for _, m := range d.Moons {
							<i class="wkmoon" style={ fmt.Sprintf("--illum:%.2f", m.Illum) } title={ m.Name }></i>
						}
					</span>
				}
			</button>
		}
	</div>
}

// benchWeekAllDayView is the untimed strip above the hour grid: one cell per
// column, holding the events that carry no start hour.
//
// THE STRIP IS ALWAYS EMITTED, even when every cell is empty. A band that
// appears and disappears with the data changes the grid's height between two
// weeks, and "the month grid never moves" is the same law one surface over.
templ benchWeekAllDayView(w BenchWeekView) {
	<div class="wkall" data-bench-week-allday>
		<div class="wkgut" aria-hidden="true">All day</div>
		for _, d := range w.Days {
			<div
				class={ "wkallcell", templ.KV("now", d.IsToday), templ.KV("rest", d.IsRest) }
				data-day={ d.DayKey }
				data-cell={ fmt.Sprintf("%d", d.Day) }
			>
				for _, e := range d.AllDay {
					@benchWeekChip(d, e)
				}
			</div>
		}
	</div>
}

// benchWeekChip is one all-day / untimed event.
templ benchWeekChip(d BenchWeekDay, e BenchWeekEvent) {
	<span
		class={ "wkchip", dayCardPattern(e.Mark.Pattern),
			templ.KV("gm", e.Mark.Audience != nil),
			templ.KV("span", e.MultiDay),
			templ.KV("tied", e.Mark.Tied) }
		data-day={ d.DayKey }
		data-day-ord={ d.DayOrd }
		data-event-id={ e.Mark.EventID }
		style={ benchWeekChipStyle(e) }
		role="button"
		tabindex="0"
		aria-label={ benchWeekAria(d, e) }
	>
		if e.Mark.Glyph != "" {
			<i class="g" aria-hidden="true">{ e.Mark.Glyph }</i>
		}
		<span class="t">{ e.Mark.Title }</span>
	</span>
}

// benchWeekHourGrid is the hour axis: a label column plus one lane per day, with
// timed events placed by grid row.
//
// THE LABEL RESPECTS THE CALENDAR'S OWN MINUTE GEOMETRY. V2's fmtHourLabel
// hardcoded ":00" and a two-digit hour, so a 1000-minute-hour calendar printed
// a label claiming a 60-minute one. benchWeekHourLabel pads both fields to the
// width THIS calendar's maxima need.
templ benchWeekHourGrid(w BenchWeekView) {
	<div class="wkgrid" data-bench-week-hours>
		for i, label := range w.HourLabels {
			<div class="wkhr" style={ fmt.Sprintf("grid-column:1;grid-row:%d", i+1) }>{ label }</div>
		}
		for i, d := range w.Days {
			<div
				class={ "wklane", templ.KV("now", d.IsToday), templ.KV("rest", d.IsRest) }
				data-day={ d.DayKey }
				data-cell={ fmt.Sprintf("%d", d.Day) }
				style={ benchWeekLaneStyle(i + 2) }
				aria-hidden="true"
			></div>
			for _, e := range d.Timed {
				<span
					class={ "wkev", dayCardPattern(e.Mark.Pattern),
						templ.KV("gm", e.Mark.Audience != nil),
						templ.KV("span", e.MultiDay),
						templ.KV("tied", e.Mark.Tied) }
					data-day={ d.DayKey }
					data-day-ord={ d.DayOrd }
					data-event-id={ e.Mark.EventID }
					style={ benchWeekEventStyle(i+2, e) }
					role="button"
					tabindex="0"
					aria-label={ benchWeekAria(d, e) }
				>
					<span class="t">{ e.Mark.Title }</span>
					if e.TimeLabel != "" {
						<span class="tm">{ e.TimeLabel }</span>
					}
				</span>
			}
		}
	</div>
}

// benchWeekMoonsView is the DAY view's celestial line — every declared moon,
// uncapped, with its phase word and illumination.
//
// V2's day view carried NO celestial, era or season readout at all, while the
// Ledger's day panel on the Bench prints every declared moon's phase. A day
// view that omitted it would be poorer than the surface the reader just left,
// which is why this is in the minimum rather than in a booking.
templ benchWeekMoonsView(w BenchWeekView) {
	<div class="wksky" data-bench-week-sky>
		<span class="cap">Tonight</span>
		for _, m := range w.Moons {
			<span class="wkskym">{ benchWeekMoonLabel(m) }</span>
		}
	</div>
}
