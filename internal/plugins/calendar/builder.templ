// builder.templ — THE BUILDER WIZARD's markup (calendar-v4 wave 4, W-H,
// C-CALV4-WIZARD-P13). Nine stations presented as Start plus eight steps, a
// preset gallery, the front door for the 4-format importer, and a live month
// preview that IS the shipped Block.
//
// ── EVERY VIEWER OF THIS SURFACE IS AN OWNER, AND THAT IS THE CHIP GATE ────
//
// All three routes carry campaigns.RequireRole(campaigns.RoleOwner). The
// `needs backend` chip is GM-FACING HONESTY COPY and never renders to a player
// (decisions/2026-07-27-needs-backend-audience.md: "for a player the zone
// simply does not appear"), and on this surface that rule is satisfied BY
// CONSTRUCTION rather than by a branch — there is no player render of the
// builder and there must never be one.
//
// THE FAILURE MODE THIS COMMENT EXISTS TO PREVENT: a future slice lowering the
// role floor to Player+ "so co-DMs can look", and silently shipping four
// `needs backend` chips into a player's markup. THE CHIP'S AUDIENCE GATE ON
// THIS SURFACE IS THE ROLE FLOOR. If the role floor moves, every chip below
// must be re-audited in the same commit.
//
// ── THE MARKUP VOCABULARY IS `wz-`-PREFIXED, AND IT IS CONTAINMENT ────────
//
// The Block renders INSIDE .cal-builder, so an unprefixed rule in
// calendar-builder.css would reach Block-internal nodes through a descendant
// combinator — `.badge`, `.field`, `.frow` and `.cell` are all live product
// classes. Root-scoping alone does not stop that. Every class here is
// `wz-`-prefixed and builder_css_contract_test.go asserts it in one regex.
//
// ── MOTION IS TRIGGERED BY THE SWAP, NOT BY A CAPTURE CLASS ───────────────
//
// A station change is an HTMX swap of the shell and a data change is an HTMX
// swap of the preview. A CSS animation on freshly inserted elements runs on
// insertion, so the swap IS the trigger and the register needs no JS of its
// own. The only thing this file contributes to the motion budget is the inline
// `--m-i` ladder position on the step panel's rows, which is the one place the
// ladder is legal.
//
// ── NO JS REACHES THE BLOCK ────────────────────────────────────────────────
//
// internal/widgets/calendar_block/** may have no JS at any price, and this file
// adds none to it: the wizard is a PAGE in internal/plugins/calendar, a tier
// that already ships HTMX and Alpine, and the Block is rendered as a component
// with nothing attached to it. hx-* attributes are markup.

package calendar

import (
	"fmt"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	calblock "github.com/keyxmakerx/chronicle/internal/widgets/calendar_block"
)

// BuilderPage renders the wizard at GET /campaigns/:id/calendars/builder.
templ BuilderPage(cc *campaigns.CampaignContext, data BuilderViewData) {
	@layouts.App("New calendar") {
		<div class="cal-builder" data-cal-builder>
			<link rel="stylesheet" href={ layouts.AssetURL("/static/css/calendar-builder.css") }/>
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: fmt.Sprintf("/campaigns/%s", cc.Campaign.ID), Icon: "fa-dice-d20"},
				{Label: "Calendars", Href: fmt.Sprintf("/campaigns/%s/apps/calendar", cc.Campaign.ID)},
				{Label: "New calendar"},
			})
			<div class="wz-phead">
				<h1>New calendar — the Builder Wizard</h1>
				<p>
					Nine stations, a preset gallery, the front door for the 4-format importer — and a
					live month preview that repaints as every value changes. Nothing is written until
					Create on Review.
				</p>
			</div>
			// THE WHOLE DECLARATION RIDES THIS FORM. There is no draft table, no
			// Redis scratch key and no migration: every preview POST rebuilds the
			// draft from the posted body and the terminal POST creates and applies
			// atomically, which is the only arrangement under which "nothing is
			// written until Create" is literally true.
			<form
				class="wz-wiz"
				id="wz-form"
				method="post"
				action={ templ.SafeURL(builderPagePath(data.CampaignID)) }
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-live"
				hx-swap="outerHTML"
				hx-trigger="change delay:200ms"
			>
				<input type="hidden" name="_csrf" value={ data.CSRFToken }/>
				@builderShell(data)
			</form>
		</div>
	}
}

// BuilderShellFragment is what a STATION CHANGE or a PRESET PICK swaps in — the
// rail, the panel and the preview together, because all three change.
templ BuilderShellFragment(data BuilderViewData) {
	@builderShell(data)
}

// BuilderPreviewFragment is what a DATA CHANGE swaps in — the preview surface
// alone, so the input being typed into keeps its focus and its caret. Pass 4
// fires on this insertion: the declaration changed, so the SURFACE is replaced.
templ BuilderPreviewFragment(data BuilderViewData) {
	@builderPreview(data)
}

templ builderShell(data BuilderViewData) {
	<div class="wz-shell" id="wz-shell">
		// The station and the pager cursor ride the form, so a refresh lands
		// where the author was and a swap does not lose their place.
		<input type="hidden" name="step" value={ builderStations[data.Step].Key }/>
		<input type="hidden" name="pv_month" value={ strconv.Itoa(data.PreviewMonth) }/>
		if data.Importer {
			<input type="hidden" name="importer" value="1"/>
		}
		for _, f := range data.Carry {
			<input type="hidden" name={ f.Name } value={ f.Value }/>
		}
		@builderTop(data)
		<div class="wz-body">
			@builderRail(data)
			<div class="wz-panel">
				@builderPanel(data)
				@builderFoot(data)
			</div>
			@builderPreview(data)
		</div>
	</div>
}

// --- chrome ------------------------------------------------------------------

templ builderTop(data BuilderViewData) {
	<div class="wz-top">
		<div class="wz-t">
			<b>New calendar</b>
			<small>Nothing is written until Create</small>
		</div>
		@builderIdentity(data.Draft)
		<div class="wz-sp"></div>
		<span class="wz-stepnow">{ builderStepLabel(data.Step, data.Importer) }</span>
		<a class="wz-icb wz-wash" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/apps/calendar", data.CampaignID)) } aria-label="Close wizard">✕</a>
	</div>
}

// builderIdentity draws the identity triple — hue, stroke PATTERN and letter.
//
// COLOUR IS NEVER THE ONLY CHANNEL. Every hue is locked to a stroke pattern by
// index, so the triple still resolves with the colour removed. The pattern is
// what makes that true and it is not decoration.
//
// The triple is DERIVED AND NOT PERSISTED ([WZ-6] SIGNED): Chronicle has no
// columns for it and blockCalHue assigns from mode plus a hash of the
// calendar's UUID, which does not exist until Create. Review carries the chip
// that says so.
templ builderIdentity(d *builderDraft) {
	<span class="wz-idtriple" title="identity: hue · pattern · letter">
		<span
			class={ "wz-swatch", templ.KV("wz-hollow", d.HollowSwatch) }
			style={ builderAxis(d.Hue) }
		></span>
		<span class={ "wz-ulseg", "wz-" + d.Pattern } style={ builderAxis(d.Hue) }></span>
		<span class="wz-lbx" style={ builderAxis(d.Hue) }>{ d.Letter }</span>
	</span>
}

// builderRail is the nine stations. EVERY ONE IS A REAL FOCUSABLE BUTTON and
// non-linear navigation is allowed from station one — a wizard that locks you
// into order is a form.
//
// THE STATION RIDES THE URL. hx-push-url is markup, not script: it makes a
// station bookmarkable and the back button work, and a refresh lands on the
// station the author was on. It cannot restore their ANSWERS, and nothing
// could — the draft lives in the form and nowhere else, which is exactly the
// property that makes "nothing is written until Create" literally true.
templ builderRail(data BuilderViewData) {
	<nav class="wz-rail" aria-label="Wizard steps">
		for i, s := range builderStations {
			if i == 1 {
				<div class="wz-rulegap"></div>
			}
			<button
				type="button"
				class={ "wz-step", "wz-" + builderRailState(i, data.Step) }
				data-step-pick={ s.Key }
				name="wz_step"
				value={ s.Key }
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-shell"
				hx-swap="outerHTML"
				hx-push-url={ builderStepPath(data.CampaignID, s.Key) }
				if i == data.Step && !data.Importer {
					aria-current="step"
				}
			>
				<span class="wz-nbox">{ builderRailMark(i, data.Step) }</span>
				{ s.Name }
			</button>
		}
	</nav>
}

// builderFoot is the station footer. On Review the action becomes Create, and
// it is DISABLED with a warn badge while anything is flagged — the wizard says
// what is wrong before it says no.
templ builderFoot(data BuilderViewData) {
	<div class="wz-foot">
		if data.Importer {
			<button
				type="button"
				class="wz-btn wz-ghost"
				name="wz_step"
				value="start"
				data-step-pick="start"
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-shell"
				hx-swap="outerHTML"
			>‹ Back to Start</button>
			<span class="wz-sp"></span>
			<button
				type="button"
				class="wz-btn wz-fill"
				name="wz_step"
				value="review"
				data-step-pick="review"
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-shell"
				hx-swap="outerHTML"
			>Continue to Review ›</button>
		} else {
			if data.Step > 0 {
				<button
					type="button"
					class="wz-btn wz-ghost"
					name="wz_step"
					value={ builderStations[data.Step-1].Key }
					data-step-pick={ builderStations[data.Step-1].Key }
					hx-post={ builderPreviewPath(data.CampaignID) }
					hx-target="#wz-shell"
					hx-swap="outerHTML"
					hx-push-url={ builderStepPath(data.CampaignID, builderStations[data.Step-1].Key) }
				>‹ { builderStations[data.Step-1].Name }</button>
			}
			<span class="wz-sp"></span>
			if data.Step == len(builderStations)-1 {
				if data.Blocked != "" {
					<span class="wz-badge wz-warn">fix the flagged lines first</span>
					<button type="button" class="wz-btn" disabled aria-disabled="true">Create calendar</button>
				} else {
					<button type="submit" class="wz-btn wz-fill">Create calendar</button>
				}
			} else {
				<button
					type="button"
					class="wz-btn wz-fill"
					name="wz_step"
					value={ builderStations[data.Step+1].Key }
					data-step-pick={ builderStations[data.Step+1].Key }
					hx-post={ builderPreviewPath(data.CampaignID) }
					hx-target="#wz-shell"
					hx-swap="outerHTML"
					hx-push-url={ builderStepPath(data.CampaignID, builderStations[data.Step+1].Key) }
				>Continue · { builderStations[data.Step+1].Name } ›</button>
			}
		}
	</div>
}

// --- the panels ---------------------------------------------------------------

templ builderPanel(data BuilderViewData) {
	if data.Importer {
		@builderImporterPanel(data)
	} else {
		switch builderStations[data.Step].Key {
			case "start":
				@builderStartPanel(data)
			case "structure":
				@builderStructurePanel(data)
			case "week":
				@builderWeekPanel(data)
			case "intercalary":
				@builderIntercalaryPanel(data)
			case "leap":
				@builderLeapPanel(data)
			case "moons":
				@builderMoonsPanel(data)
			case "seasons":
				@builderSeasonsPanel(data)
			case "eras":
				@builderErasPanel(data)
			default:
				@builderReviewPanel(data)
		}
	}
}

templ builderStartPanel(data BuilderViewData) {
	<div class="wz-ph">Start from a shape you know</div>
	<p class="wz-ps">
		Four presets fill every station with a working calendar; Blank starts empty on purpose
		and its card says what is still missing. You then walk the steps and bend it. The identity
		triple — hue, stroke pattern, letter — is how this calendar reads everywhere, so colour is
		never its only channel.
	</p>
	<div class="wz-pgal" style={ builderLadder(0) }>
		for i, p := range data.Presets {
			<button
				type="button"
				class={ "wz-pcard", templ.KV("wz-sel", p.Key == data.Draft.Preset) }
				data-preset-pick={ p.Key }
				name="wz_preset"
				value={ p.Key }
				style={ builderAxis(p.Hue) + ";" + builderLadder(i) }
				aria-pressed={ strconv.FormatBool(p.Key == data.Draft.Preset) }
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-shell"
				hx-swap="outerHTML"
			>
				<span class="wz-hd">
					<span class={ "wz-swatch", templ.KV("wz-hollow", p.Hollow) }></span>
					<span class={ "wz-ulseg", "wz-" + p.Pattern }></span>
					<span class="wz-lbx">{ p.Letter }</span>
					<b>{ p.Name }</b>
				</span>
				<span class="wz-ds">{ p.Desc }</span>
				<span class="wz-mt">
					if p.Mode == ModeRealLife {
						real-world dates · your timezone · sessions and RSVPs
					} else {
						{ builderPresetMeta(p) }
					}
					if p.EraGap {
						{ " · " }
						<span class="wz-badge wz-warn">no era yet — Create waits</span>
					}
				</span>
			</button>
		}
	</div>
	// THE IMPORTER IS NOT A STATION. It is a mode flag on this same shell: the
	// rail still shows Start as current, the wtop reads Importer, and the
	// footer jumps to Review skipping 1–7.
	<div class="wz-impdoor" style={ builderLadder(4) }>
		<span class="wz-g" aria-hidden="true">⇲</span>
		<span class="wz-grow">
			<span class="wz-nm">Already have this calendar somewhere else?</span>
			<span class="wz-dt">Simple Calendar · Calendaria · Fantasy-Calendar · Chronicle native — detected on paste</span>
		</span>
		<span class="wz-sp"></span>
		<button
			type="button"
			class="wz-btn wz-sm"
			name="wz_importer"
			value="1"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>Open importer</button>
	</div>
}

templ builderStructurePanel(data BuilderViewData) {
	<div class="wz-ph">Months and their days</div>
	<p class="wz-ps">
		The year is the sum of its months. Festival days outside every week are counted at their
		own station, not here.
	</p>
	// THE WHOLE ORDERED NAME LIST IS EMITTED BY THIS STATION, and a month it
	// does not show rides hidden IN ITS OWN POSITION. `m_name` and `m_days` are
	// zipped by index on the way back, so two groups concatenated in submission
	// order would shift every name onto its neighbour — silently, producing a
	// calendar with the right month count and the wrong month names. The
	// round-trip test caught exactly that.
	for i, m := range data.Draft.Months {
		if m.Intercalary {
			<input type="hidden" name="m_name" value={ m.Name }/>
		} else {
			<div class="wz-frow" style={ builderLadder(builderRowNumber(data.Draft, i) - 1) }>
				<span class="wz-ix">{ strconv.Itoa(builderRowNumber(data.Draft, i)) }</span>
				// A FAULT BADGE HANGS OUT OF FLOW INSIDE THE FIELD IT DESCRIBES,
				// so the row's track is identical with and without it. That is
				// canon A8 L-M1 honoured at the primitive: a data-driven change
				// moves nothing.
				<span class={ "wz-field", "wz-grow", templ.KV("wz-flagged", m.Days < 1) }>
					<input class="wz-in" type="text" name="m_name" value={ m.Name } aria-label="Month name"/>
					if m.Days < 1 {
						<span class="wz-badge wz-warn wz-flag">no days</span>
					}
				</span>
				@builderStepper(data, "mdays", i, strconv.Itoa(m.Days), "")
				<button
					type="button"
					class="wz-icb wz-wash"
					name="wz_act"
					value={ fmt.Sprintf("month-del:%d", i) }
					aria-label="Remove month"
					hx-post={ builderPreviewPath(data.CampaignID) }
					hx-target="#wz-shell"
					hx-swap="outerHTML"
				>✕</button>
			</div>
		}
	}
	<div class="wz-frow" style={ builderLadder(4) }>
		<button
			type="button"
			class="wz-btn wz-ghost wz-sm"
			name="wz_act"
			value="month-add"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>＋ Add month</button>
	</div>
	<div class="wz-sum">{ builderMonthSummary(data.Draft) }</div>
}

templ builderWeekPanel(data BuilderViewData) {
	<div class="wz-ph">The week</div>
	<p class="wz-ps">
		Week length is a property of the calendar, not of the grid — the month redraws its columns
		from this number, whatever it is.
	</p>
	<div class="wz-frow" style={ builderLadder(0) }>
		<span class="wz-lbl">Days in a week</span>
		<span class="wz-sp"></span>
		@builderBigStepper(data, "week", strconv.Itoa(len(data.Draft.Weekdays)))
	</div>
	<div class="wz-chipswrap" style={ builderLadder(1) }>
		for i, w := range data.Draft.Weekdays {
			<span class={ "wz-wdchip", templ.KV("wz-halfmark", i+1 == builderWeekSplit(len(data.Draft.Weekdays))) }>
				<i>{ strconv.Itoa(i + 1) }</i>
				<input class="wz-in wz-chipin" type="text" name="wd" value={ w } aria-label="Weekday name"/>
			</span>
		}
	</div>
	<div class="wz-note" style={ builderLadder(2) }>
		<span class="wz-g" aria-hidden="true">◫</span>
		<span>
			Humans cannot count to ten across identical columns, so at even lengths of eight or more
			the grid splits the week at its midpoint with a stronger rule { builderSplitNote(data.Draft) }.
			Nothing in the grid knows the number seven.
		</span>
	</div>
	<div class="wz-sum">{ builderWeekSummary(data.Draft) }</div>
}

templ builderIntercalaryPanel(data BuilderViewData) {
	<div class="wz-ph">Intercalary days</div>
	<p class="wz-ps">
		Festival days that belong to no week. The grid draws each one as a full-width band between
		weeks — never as an extra column.
	</p>
	if len(builderMonthIndexes(data.Draft, true)) == 0 {
		// THE EMPTY STATE IS A SENTENCE, NOT A GREYED ROW.
		<div class="wz-frow" style={ builderLadder(0) }>
			<span class="wz-lbl">None declared — the year is exactly its months.</span>
		</div>
	}
	// The same whole-list rule as Structure, inverted: this station names the
	// festival days and carries every ordinary month hidden in position.
	for i, m := range data.Draft.Months {
		if m.Intercalary {
			<div class="wz-frow" style={ builderLadder(builderRowNumber(data.Draft, i) - 1) }>
				<span class="wz-ix">{ strconv.Itoa(builderRowNumber(data.Draft, i)) }</span>
				<span class="wz-field wz-grow">
					<input class="wz-in" type="text" name="m_name" value={ m.Name } aria-label="Festival name"/>
				</span>
				<span class="wz-pr">
					<span class="wz-lbl">after</span>
					<span class="wz-field">{ builderPrecedingMonth(data.Draft, i) }</span>
				</span>
				<span class="wz-badge wz-fact">no weekday</span>
				<button
					type="button"
					class="wz-icb wz-wash"
					name="wz_act"
					value={ fmt.Sprintf("month-del:%d", i) }
					aria-label="Remove festival day"
					hx-post={ builderPreviewPath(data.CampaignID) }
					hx-target="#wz-shell"
					hx-swap="outerHTML"
				>✕</button>
			</div>
		} else {
			<input type="hidden" name="m_name" value={ m.Name }/>
		}
	}
	<div class="wz-frow" style={ builderLadder(4) }>
		<button
			type="button"
			class="wz-btn wz-ghost wz-sm"
			name="wz_act"
			value="interc-add"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>＋ Add intercalary day</button>
	</div>
	<div class="wz-note" style={ builderLadder(4) }>
		<span class="wz-g" aria-hidden="true">▤</span>
		<span>
			Date math skips these days when asking "what weekday is this" — a festival has a date
			but no weekday, and the preview draws it as a full-width band below its month's last week.
		</span>
	</div>
	<div class="wz-sum">Year total { strconv.Itoa(builderYearDays(data.Draft)) }</div>
}

templ builderLeapPanel(data BuilderViewData) {
	<div class="wz-ph">Leap rules</div>
	if data.Draft.LeapEvery < 1 {
		<p class="wz-ps">A sentence, not a form. This calendar declares none.</p>
		<div class="wz-frow" style={ builderLadder(0) }>
			<span class="wz-lbl">Every year is the same length.</span>
		</div>
		<div class="wz-frow" style={ builderLadder(1) }>
			<button
				type="button"
				class="wz-btn wz-ghost wz-sm"
				name="wz_act"
				value="leap-add"
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-shell"
				hx-swap="outerHTML"
			>＋ Add a leap rule</button>
		</div>
	} else {
		<p class="wz-ps">
			A sentence, not a form — and the rule proves itself: the next leap years print below,
			and the preview year picks the day up.
		</p>
		<div class="wz-frow" style={ builderLadder(0) }>
			<span class="wz-lbl">Every</span>
			@builderStepper(data, "leap-every", -1, strconv.Itoa(data.Draft.LeapEvery), "")
			<span class="wz-lbl">years, add</span>
			@builderStepper(data, "leap-add", -1, strconv.Itoa(data.Draft.LeapAdd), "")
			<span class="wz-lbl">
				if data.Draft.LeapAdd > 1 {
					days
				} else {
					day
				}
			</span>
			<span class="wz-pr">
				<span class="wz-lbl">named</span>
				<span class="wz-field">
					<input
						class="wz-in"
						type="text"
						name="leap_name"
						value={ data.Draft.LeapName }
						placeholder="unnamed"
						aria-label="Leap day name"
					/>
				</span>
				// ABSENCE IS STATED, NOT DRAWN AS A BLANK. An empty box inside the
				// wizard's flagship sentence reads as a field that failed to load;
				// the fact chip says the author left it empty, which is a legal
				// and common answer — no import format carries a leap-day name.
				if data.Draft.LeapName == "" {
					<span class="wz-badge wz-fact">left empty</span>
				}
			</span>
			<span class="wz-pr">
				<span class="wz-lbl">after</span>
				<span class="wz-field">
					<input class="wz-in" type="text" name="leap_after" value={ data.Draft.LeapAfter } aria-label="Leap day placement"/>
				</span>
			</span>
		</div>
		if data.Draft.LeapNote != "" {
			// AN EXCEPTION CHRONICLE CANNOT STORE IS SHOWN, NOT SWALLOWED. It is
			// not editable, it carries the SIGNED needs-backend chip, and Review
			// says what Create will actually write.
			<div class="wz-frow" style={ builderLadder(1) }>
				<span class="wz-lbl">except</span>
				<span class="wz-lbl wz-wrapline">{ data.Draft.LeapNote }</span>
				<span class="wz-sp"></span>
				<span class="wz-badge wz-need">needs backend</span>
			</div>
		}
		<div class="wz-note" style={ builderLadder(2) }>
			<span class="wz-g" aria-hidden="true">↻</span>
			<span>
				Chronicle stores the rule as a single modulus — every N years, add D days — not a
				list of exceptions.
				if data.Draft.LeapNote != "" {
					The "{ data.Draft.LeapNote }" clause has no home in that model yet: it is shown
					here so nothing silently disappears, it is not editable, and Review says what
					Create will actually write.
				}
				// THE NAME IS SHOWN AND THE TRUTH IS SHOWN BESIDE IT. Chronicle
				// models a leap day as Month.LeapYearDays and has no column for the
				// day's own name, in the model or in any of the four import formats.
				if data.Draft.LeapName != "" {
					The extra day lands on <b>{ data.Draft.LeapAfter }</b> — intercalary on leap years
					only, so it appears in the band row and never as a column. The name
					<b>{ data.Draft.LeapName }</b>
					{ " " }
					is yours to read: there is no column for it, so Create writes the day and Review
					says the name is dropped.
				} else {
					This rule's day is unnamed, and nothing is lost by that — there is no column for a
					leap day's name in the first place. The extra day lands on
					<b>{ data.Draft.LeapAfter }</b>
					{ " " }
					either way.
				}
			</span>
		</div>
		<div class="wz-sum">
			Next leap years:
			for i, y := range builderNextLeaps(data.Draft, 4) {
				if i > 0 {
					{ " · " }
				}
				<b>{ strconv.Itoa(y) }</b>
			}
		</div>
	}
}

templ builderMoonsPanel(data BuilderViewData) {
	<div class="wz-ph">Moons</div>
	<p class="wz-ps">
		Declare a period and an offset; every phase, turn and node window is derived — nothing is
		authored date by date.
	</p>
	if len(data.Draft.Moons) == 0 {
		// ABSENCE, NOT A GREYED ROW.
		<div class="wz-frow" style={ builderLadder(0) }>
			<span class="wz-lbl">No moons declared — the sky layer stays absent everywhere.</span>
		</div>
	} else {
		for i, m := range data.Draft.Moons {
			<div class="wz-frow" style={ builderLadder(i) }>
				<span class="wz-ix">{ strconv.Itoa(i + 1) }</span>
				<span class="wz-field wz-grow">
					<input class="wz-in" type="text" name="moon_name" value={ m.Name } aria-label="Moon name"/>
				</span>
				<span class="wz-pr">
					<span class="wz-lbl">period</span>
					<span class="wz-field">
						<input class="wz-in wz-num" type="text" name="moon_period" value={ builderNum(m.Period) } aria-label="Period in days"/>
						<span class="wz-u">days</span>
					</span>
				</span>
				<span class="wz-pr">
					<span class="wz-lbl">new at</span>
					<span class="wz-field">
						<span class="wz-u">day</span>
						<input class="wz-in wz-num" type="text" name="moon_newat" value={ builderNum(m.NewAt) } aria-label="New moon offset"/>
					</span>
				</span>
				if i >= builderMoonCap {
					<span class="wz-badge wz-fact">almanac only</span>
				} else {
					<span class="wz-turns" title="turns this month">
						for _, kind := range builderMoonTurns(data, i) {
							<i class={ "wz-skyturn", "wz-" + kind }></i>
						}
						if len(builderMoonTurns(data, i)) == 0 {
							<span class="wz-lbl">no turn this month</span>
						}
					</span>
				}
			</div>
		}
	}
	<div class="wz-frow" style={ builderLadder(4) }>
		<button
			type="button"
			class="wz-btn wz-ghost wz-sm"
			name="wz_act"
			value="moon-add"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>＋ Add moon</button>
	</div>
	<div class="wz-note" style={ builderLadder(4) }>
		<span class="wz-g" aria-hidden="true">☾</span>
		<span>
			The month grid draws at most <b>{ strconv.Itoa(builderMoonCap) }</b> moons and names the
			rest — a fourth body lives in the Almanac at full width, and the grid says so rather
			than growing.
		</span>
	</div>
}

templ builderSeasonsPanel(data BuilderViewData) {
	<div class="wz-ph">Seasons</div>
	<p class="wz-ps">
		Seasons ride the week band as a text suffix. Their colour is authored data (Season.Color) —
		each row carries its own value with a mono name beside the swatch, and it never borrows an
		event, owner or calendar hue, whose axes mean something else.
	</p>
	if len(data.Draft.Seasons) == 0 {
		<div class="wz-frow" style={ builderLadder(0) }>
			<span class="wz-lbl">None declared.</span>
		</div>
	} else {
		for i, s := range data.Draft.Seasons {
			<div class="wz-frow" style={ builderLadder(i) }>
				<span class="wz-ix">{ strconv.Itoa(i + 1) }</span>
				// THE MONO COLOUR NAME IS THE SECOND CHANNEL AND IT IS NOT
				// OPTIONAL. A colour nobody named reads as an em dash rather
				// than as an invented word.
				<span class="wz-pr">
					<span class="wz-swatch" style={ builderSwatchStyle(s.Color) }></span>
					<span class="wz-lbl wz-mono">
						if s.ColorName == "" {
							—
						} else {
							{ s.ColorName }
						}
					</span>
				</span>
				<span class="wz-field wz-grow">
					<input class="wz-in" type="text" name="season_name" value={ s.Name } aria-label="Season name"/>
				</span>
				<span class="wz-lbl">{ builderSeasonSpan(data.Draft, s) }</span>
				<button
					type="button"
					class="wz-icb wz-wash"
					name="wz_act"
					value={ fmt.Sprintf("season-del:%d", i) }
					aria-label="Remove season"
					hx-post={ builderPreviewPath(data.CampaignID) }
					hx-target="#wz-shell"
					hx-swap="outerHTML"
				>✕</button>
			</div>
		}
	}
	<div class="wz-frow" style={ builderLadder(4) }>
		<button
			type="button"
			class="wz-btn wz-ghost wz-sm"
			name="wz_act"
			value="season-add"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>＋ Add season</button>
	</div>
}

templ builderErasPanel(data BuilderViewData) {
	<div class="wz-ph">Eras</div>
	<p class="wz-ps">
		The era names the year readout and labels the week band. The wizard holds Create until one
		exists — that is this surface's own policy, not a limit of the model: a calendar with no
		era still resolves its dates perfectly well.
	</p>
	if len(data.Draft.Eras) == 0 {
		<div class="wz-frow" style={ builderLadder(0) }>
			<span class="wz-badge wz-warn">setup</span>
			<span class="wz-lbl">0 eras defined — Review will hold the door until one exists.</span>
		</div>
	} else {
		for i, e := range data.Draft.Eras {
			<div class="wz-frow" style={ builderLadder(i) }>
				<span class="wz-ix">{ strconv.Itoa(i + 1) }</span>
				<span class="wz-pr">
					<span class="wz-swatch" style={ builderSwatchStyle(e.Color) }></span>
					<span class="wz-lbl wz-mono">
						if e.ColorName == "" {
							—
						} else {
							{ e.ColorName }
						}
					</span>
				</span>
				<span class="wz-field wz-grow">
					<input class="wz-in" type="text" name="era_name" value={ e.Name } aria-label="Era name"/>
				</span>
				<span class="wz-pr">
					<span class="wz-lbl">reads</span>
					<span class="wz-field">
						<input class="wz-in wz-num" type="text" name="era_code" value={ e.Code } aria-label="Era reading"/>
					</span>
				</span>
				<span class="wz-pr">
					<span class="wz-lbl">begins year</span>
					<span class="wz-field">
						<input class="wz-in wz-num" type="text" name="era_year" value={ strconv.Itoa(e.StartYear) } aria-label="Era start year"/>
					</span>
				</span>
			</div>
		}
	}
	<div class="wz-frow" style={ builderLadder(4) }>
		<button
			type="button"
			class="wz-btn wz-ghost wz-sm"
			name="wz_act"
			value="era-add"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>＋ Add era</button>
	</div>
	// [WZ-4] SIGNED. The mockup advertised a mid-month era boundary as the
	// payoff of this station; block_geometry.go states that one "is not
	// expressible on main" and Era{StartYear, EndYear} is YEARS, not dates. So
	// the note describes what Create actually writes rather than what the
	// drawing promised.
	<div class="wz-note" style={ builderLadder(4) }>
		<span class="wz-g" aria-hidden="true">▥</span>
		<span>
			An era boundary is a <b>year</b>, not a date: Create writes the year an era begins and
			the band changes at the year's turn. A boundary part-way through a month is not
			something Chronicle can store today.
		</span>
	</div>
}

templ builderReviewPanel(data BuilderViewData) {
	<div class="wz-ph">Review the declaration</div>
	<p class="wz-ps">
		Everything below is what Create will write — one act, one calendar. Any line links back to
		its station.
	</p>
	<dl class="wz-stats wz-dl" style={ builderLadder(0) }>
		<dt>Name</dt>
		<dd>
			<span class="wz-field wz-grow">
				<input class="wz-in" type="text" name="cal_name" value={ data.Draft.Name } aria-label="Calendar name"/>
			</span>
		</dd>
		<dt>Identity</dt>
		<dd>
			@builderIdentity(data.Draft)
			{ " " }
			// [WZ-6] SIGNED: derived and chipped. calendar-settings.html already
			// carries this exact chip for this exact question.
			<span class="wz-badge wz-need">needs backend</span>
			<span class="wz-lbl">no persisted columns exist for the triple — Chronicle derives it from the calendar's id, which Create mints</span>
		</dd>
		<dt>Year</dt>
		<dd>
			<span class="wz-field">
				<input class="wz-in wz-num" type="text" name="year" value={ strconv.Itoa(data.Draft.Year) } aria-label="Current year"/>
			</span>
			<span class="wz-pr">
				<span class="wz-lbl">reads</span>
				<span class="wz-field">
					<input class="wz-in wz-num" type="text" name="epoch" value={ data.Draft.EpochName } aria-label="Year reckoning"/>
				</span>
			</span>
		</dd>
		if data.Draft.Mode == ModeRealLife {
			<dt>Timezone</dt>
			<dd>
				<span class="wz-field wz-grow">
					<input class="wz-in" type="text" name="tz" value={ data.Draft.TimeZone } placeholder="Europe/London" aria-label="IANA timezone"/>
				</span>
				<span class="wz-lbl">
					this calendar is wall-clock authoritative: its date comes from the real world in
					this zone, and it cannot be advanced by hand
				</span>
			</dd>
		} else {
			<input type="hidden" name="tz" value=""/>
		}
		<dt>Structure</dt>
		<dd>{ builderMonthSummary(data.Draft) }</dd>
		<dt>Week</dt>
		<dd>{ strconv.Itoa(len(data.Draft.Weekdays)) } days</dd>
		<dt>Moons</dt>
		<dd>{ builderCountLabel(len(data.Draft.Moons)) }</dd>
		<dt>Seasons</dt>
		<dd>{ builderCountLabel(len(data.Draft.Seasons)) }</dd>
		<dt>Eras</dt>
		<dd>{ builderCountLabel(len(data.Draft.Eras)) }</dd>
	</dl>
	for i, c := range data.Checks {
		<div class="wz-frow" style={ builderLadder(i + 1) }>
			<span class={ "wz-badge", "wz-" + c.Kind }>{ builderCheckLabel(c.Kind) }</span>
			<span class="wz-lbl wz-wrapline">{ c.Text }</span>
		</div>
	}
}

// --- the live preview ---------------------------------------------------------

// builderPreview is the preview COLUMN. Its chrome belongs to the wizard; the
// month inside it is the shipped Block and nothing here reaches into it.
//
// `live preview · not saved` is the WIZARD'S promise and is drawn ABOVE the
// Block rather than inside its Nameplate. Putting it on BlockData would mean
// every host must decide whether its calendar is "saved", which is meaningless
// for all of them — so no field was proposed and r54 stands untouched.
templ builderPreview(data BuilderViewData) {
	<aside class="wz-pv" id="wz-live" aria-label="Live preview">
		<div class="wz-pvhead">
			<span class="wz-cap">live preview</span>
			<span class="wz-sp"></span>
			<span class="wz-badge wz-fact">live preview · not saved</span>
		</div>
		<div class="wz-pvsub">
			@builderIdentity(data.Draft)
			<span>{ builderPreviewSub(data.Draft) }</span>
		</div>
		if data.Fault.Headline != "" {
			// THE FAULT IS DRAWN WHERE THE DATE WOULD GO — warn rail, warn
			// headline, plain-language cause, and a jump to the station that
			// fixes it. Never a zero, never a dash, never a placeholder.
			<div class="wz-fault">
				<span class="wz-grow">
					<span class="wz-fh">{ data.Fault.Headline }</span>
					<span class="wz-why">{ data.Fault.Why }</span>
				</span>
				<span class="wz-sp"></span>
				<button
					type="button"
					class="wz-btn wz-sm"
					name="wz_step"
					value={ data.Fault.FixStep }
					data-step-pick={ data.Fault.FixStep }
					hx-post={ builderPreviewPath(data.CampaignID) }
					hx-target="#wz-shell"
					hx-swap="outerHTML"
				>{ data.Fault.FixLabel }</button>
			</div>
		} else {
			<div class="wz-anchor">
				<span class="wz-cap">today resolves to</span>
				<span class="wz-iw">{ data.Block.DateLabel }</span>
				<span class="wz-sp"></span>
				<span class="wz-badge wz-fact">anchor</span>
			</div>
		}
		<div class="wz-pvnav">
			<button
				type="button"
				class="wz-icb wz-wash"
				name="wz_act"
				value="pv-prev"
				aria-label="Previous month"
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-shell"
				hx-swap="outerHTML"
			>‹</button>
			<span class="wz-mnm">
				{ data.Block.Month.Name }
				<small>{ builderMonthLenLabel(data) }</small>
			</span>
			<button
				type="button"
				class="wz-icb wz-wash"
				name="wz_act"
				value="pv-next"
				aria-label="Next month"
				hx-post={ builderPreviewPath(data.CampaignID) }
				hx-target="#wz-shell"
				hx-swap="outerHTML"
			>›</button>
			<span class="wz-sp"></span>
			<span class="wz-cap">{ builderPagerLabel(data) }</span>
		</div>
		<div class="wz-pvrule"></div>
		// ── THE SHIPPED BLOCK. There is no second month renderer in this diff.
		@calblock.Block(data.Block)
		<dl class="wz-stats">
			for _, s := range data.Stats {
				<dt>{ s.Label }</dt>
				<dd class={ templ.KV("wz-warnink", s.Warn) }>
					{ s.Value }
					if s.Need != "" {
						{ " " }
						<span class="wz-badge wz-need">needs backend</span>
					}
				</dd>
			}
		</dl>
		<div class="wz-pvfoot">
			Nothing is written until Create on Review — the preview is the declaration, walked.
		</div>
	</aside>
}

// --- shared primitives --------------------------------------------------------

// builderStepper is the ± control. The value is a bold readout rather than a
// typed field, exactly as the mockup draws it: a month's length is chosen by
// stepping, and the bound is enforced on the way in rather than by an attribute
// a client can ignore.
templ builderStepper(data BuilderViewData, act string, index int, value, unit string) {
	if unit != "" {
		<span class="wz-lbl">{ unit }</span>
	}
	<span class="wz-stepper">
		<button
			type="button"
			name="wz_act"
			value={ builderActValue(act, index, -1) }
			aria-label="Fewer"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>−</button>
		<b>{ value }</b>
		<button
			type="button"
			name="wz_act"
			value={ builderActValue(act, index, 1) }
			aria-label="More"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>＋</button>
	</span>
}

templ builderBigStepper(data BuilderViewData, act, value string) {
	<span class="wz-stepper wz-big">
		<button
			type="button"
			name="wz_act"
			value={ builderActValue(act, -1, -1) }
			aria-label="Shorter week"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>−</button>
		<b>{ value }</b>
		<button
			type="button"
			name="wz_act"
			value={ builderActValue(act, -1, 1) }
			aria-label="Longer week"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		>＋</button>
	</span>
}

// --- the importer front door ---------------------------------------------------

// builderImporterPanel is the 4-format importer's front door.
//
// THE IMPORTER IS COMPLETE, TESTED AND WAS FRONT-DOORLESS. import.go is
// package-level, has no DB and no ctx, and is pure []byte → *ImportResult; a
// dry-run endpoint already existed but was mounted under
// /calendars/:calId/import/preview, so it required a calendar that does not
// exist yet. That single :calId is the whole reason "import" was not a front
// door, and the preview route here has no :calId at all.
//
// THE FOUR FORMAT NAMES ARE THE FOUR ON MAIN. Do not add a fifth.
templ builderImporterPanel(data BuilderViewData) {
	<div class="wz-ph">Import a calendar</div>
	<p class="wz-ps">
		Paste or drop an export; the format is detected and mapped. Import lands on Review with
		every step editable — the wizard is the confirmation, and where a format carries no eras,
		Review holds Create until one is added.
	</p>
	<div class="wz-igrid" style={ builderLadder(0) }>
		for _, f := range builderFormats {
			<div class="wz-icard">
				<b>{ f.Name }</b>
				<span class="wz-dt">{ f.Detail }</span>
			</div>
		}
	</div>
	// A SOLID STRUCTURAL BORDER ON INSET SURFACE, never a dashed one: the signed
	// contract declares the skyband "the ONE dashed idiom in the entire product".
	<label class="wz-dropz" style={ builderLadder(1) }>
		<span class="wz-a">Drop a file, or choose one</span>
		<span class="wz-b">detection is automatic — nothing imports until you confirm on Review</span>
		<input
			class="wz-file"
			type="file"
			name="file"
			accept="application/json,.json"
			hx-post={ builderPreviewPath(data.CampaignID) }
			hx-encoding="multipart/form-data"
			hx-target="#wz-shell"
			hx-swap="outerHTML"
		/>
	</label>
	if data.Detected != "" {
		<div class="wz-sum" style={ builderLadder(2) }>
			<span class="wz-cap">detected · { data.Detected }</span>
		</div>
		<div class="wz-maptable" style={ builderLadder(3) }>
			for _, r := range data.Mapping {
				<div class="wz-maprow">
					<span class="wz-k">{ r.Fact }</span>
					<span class="wz-v">{ r.Station }</span>
					<span class={ "wz-badge", "wz-" + r.Kind }>{ r.Verdict }</span>
				</div>
			}
		</div>
	} else {
		<div class="wz-note" style={ builderLadder(2) }>
			<span class="wz-g" aria-hidden="true">⇲</span>
			<span>
				Nothing has been read yet. When a file arrives, every fact in it is listed here
				beside the station it lands on and what happened to it — including anything the
				format does not carry, so nothing disappears quietly.
			</span>
		</div>
	}
}
