// view.templ renders the calendar's own page: a thin page shell (Templ) plus
// a mount point the calendar_view widget fills in entirely — the month
// grid, header, day/era fold-out cards, event glance/detail overlays and
// moons are all client-rendered from the JSON this page ferries down on
// first paint. Mirrors internal/plugins/maps/maps.templ's structure: a
// server-rendered config div read by the widget's JS, since templ's
// `{ expr }` interpolation does not run inside <script> blocks.
package calendar

import (
	"encoding/json"
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CalendarViewPage renders the full calendar page.
templ CalendarViewPage(cc *campaigns.CampaignContext, data CalendarViewData) {
	@layouts.App("Calendar") {
		@calendarViewContent(cc, data)
	}
}

// calendarViewContent renders the breadcrumbs, the calendar-view.css
// stylesheet (loaded only on this page, same reasoning as maps.templ
// loading Leaflet's CSS/JS inline rather than globally) and the widget's
// mount point. The widget scripts themselves are NOT loaded here — see the
// comment at the bottom of this function for why a page templ can't
// <script src> them, and internal/app/routes.go's pluginBodyScripts for
// where they actually load.
templ calendarViewContent(cc *campaigns.CampaignContext, data CalendarViewData) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/calendar-view.css") }/>
	<div class="max-w-5xl mx-auto py-6 px-4">
		<div class="cal5-crumbs">
			<!-- Shown only by calendar_open.js, on a calendar opened from its
			     card, so a direct visit looks exactly as it always has. A real
			     link, so it still works if the script stops. -->
			<a class="cal5-back" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/calendars", data.CampaignID)) } data-cal-back hidden>
				<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
				Back to calendars
			</a>
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: fmt.Sprintf("/campaigns/%s", data.CampaignID), Icon: "fa-dice-d20"},
				{Label: data.Calendar.Name},
			})
		</div>
		@calendarViewMount(data)
	</div>
	<!-- No script tag here on purpose: a page templ's own script element
	     would land inside <main id="main-content">, which the sidebar's
	     hx-boost swap strips (tools/check-page-scripts.sh). Both widget
	     scripts are registered once, unconditionally, in
	     internal/app/routes.go's pluginBodyScripts — outside the swapped
	     region — and self-gate at runtime instead: calendar_view.js
	     no-ops without a data-widget="calendar_view" mount, and
	     calendar_editor.js additionally requires that mount's
	     data-can-edit="true". -->
}

// calendarViewMount is the widget's mount and its first-paint config, on
// the calendar's own page.
templ calendarViewMount(data CalendarViewData) {
	<div
		class="cal-v5"
		data-widget="calendar_view"
		data-campaign-id={ data.CampaignID }
		data-calendar-id={ data.CalendarID }
		data-can-edit={ fmt.Sprintf("%t", data.CanEdit) }
		data-can-author-dm-only={ fmt.Sprintf("%t", data.CanAuthorDmOnly) }
		data-role={ fmt.Sprintf("%d", data.ViewerRole) }
		data-user-id={ data.ViewerID }
		data-game-nights={ fmt.Sprintf("%t", layouts.IsAddonEnabled(ctx, "sessions")) }
		data-api-base={ fmt.Sprintf("/campaigns/%s/calendars/%s", data.CampaignID, data.CalendarID) }
		data-engine-src={ layouts.AssetURL("/static/js/widgets/chronicle_gen.js") }
	>
		<!-- Server-rendered config, read by calendar_view.js. A hidden div's
		     dataset is the simplest stable channel for a JSON blob this size
		     (calendar + sub-resources, current month's events) — see
		     maps.templ's #map-config for the same pattern and its reasoning. -->
		<div
			id="calendar-config"
			class="hidden"
			data-calendar={ mustMarshalCalendar(data.Calendar) }
			data-events={ mustMarshalEvents(data.CurrentMonthEvents) }
			data-zone={ data.Zone }
		></div>
	</div>
}

// mustMarshalCalendar serializes the calendar (with its eager-loaded
// sub-resources) for the widget's first paint. Never expected to fail
// (Calendar has no un-marshalable field), but a failure degrades to an
// empty object rather than a panicking page.
func mustMarshalCalendar(cal *Calendar) string {
	if cal == nil {
		return "{}"
	}
	b, err := json.Marshal(cal)
	if err != nil {
		return "{}"
	}
	return string(b)
}

// mustMarshalEvents serializes the current month's events. Empty/nil must
// serialize to "[]", not the bare "null" json.Marshal(nil) produces — the
// same reasoning as maps.templ's mustMarshalMarkers: a parsed `null` crashes
// the widget's first `events.length` read before anything else runs.
func mustMarshalEvents(events []Event) string {
	if len(events) == 0 {
		return "[]"
	}
	b, err := json.Marshal(events)
	if err != nil {
		return "[]"
	}
	return string(b)
}

// CalendarEmbed is the calendar for an allowed app's frame (the Foundry
// calendar window): the same widget mount as the calendar's own page, with
// its stylesheet, and no page chrome around it. The frame's shell already
// loaded the widget scripts.
templ CalendarEmbed(data CalendarViewData) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/calendar-view.css") }/>
	<div class="cal-embed p-3">
		@calendarViewMount(data)
	</div>
}

// CalendarEmbedEmpty is the frame's note when the campaign has no calendar
// this member may see.
templ CalendarEmbedEmpty() {
	<p class="text-sm text-fg-secondary p-6" role="status">This campaign has no calendar yet.</p>
}
