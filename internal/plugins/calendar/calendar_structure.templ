// calendar_structure.templ renders an existing calendar's "Edit structure"
// page: the same structure editor the new-calendar wizard's "Build your
// own" step uses (structureEditorForm), prefilled from the calendar, with a
// preview slot under it. "Preview changes" fills the slot with what the
// save would do — months moved or removed, events re-dated or stranded,
// the current date — and the save button in that preview is the only way
// to write. Changing anything in the editor empties the slot again.
package calendar

import (
	"fmt"
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// structurePreviewSlot is the id of the element the preview is swapped into.
const structurePreviewSlot = "calv5-structure-preview"

// StructureEditData is the view model for the "Edit structure" page.
type StructureEditData struct {
	CampaignID   string
	CampaignName string
	Calendar     *Calendar
	CSRFToken    string
	// RealTime is set for a calendar that follows the real-world date: its
	// months are the Gregorian ones, so the page explains that instead of
	// offering the editor.
	RealTime bool
	// Weather and Climates feed the Weather section of the editor.
	Weather  WeatherSettings
	Climates []WeatherClimate
}

// weatherCarry is the weather part of a structure save: the values the
// owner submitted (carried to the save as hidden fields) and a note for each
// that differs from what is stored. Sent is false when the form had neither
// field, in which case nothing weather-related is written.
type weatherCarry struct {
	Sent       bool
	Climate    string
	Continuity string
	// Kinds is the cleaned own-weather list, KindsJSON its carried form.
	Kinds     []WeatherKind
	KindsJSON string
	Notes     []string
}

// StructureEditPage is the full page (direct navigation).
templ StructureEditPage(data StructureEditData) {
	@layouts.App("Calendar structure") {
		@StructureEditFragment(data)
	}
}

// StructureEditFragment is the page body, also served alone to a boosted
// navigation.
templ StructureEditFragment(data StructureEditData) {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/calendar_v5.css") }/>
	<div class="calv5" x-data="{}">
		<div class="calv5-wrap">
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: data.CampaignName, Href: fmt.Sprintf("/campaigns/%s", data.CampaignID), Icon: "fa-dice-d20"},
				{Label: "Calendars", Href: fmt.Sprintf("/campaigns/%s/calendars", data.CampaignID)},
				{Label: data.Calendar.Name, Href: structureCalendarURL(data.CampaignID, data.Calendar.ID)},
				{Label: "Edit structure"},
			})
			<div class="calv5-panel wide page">
				<div class="calv5-body">
					if data.RealTime {
						<h2 class="calv5-wz-h">Edit structure</h2>
						<p class="calv5-wz-lead">{ data.Calendar.Name } follows the real-world date, so its months, weekdays and leap years are the real ones and can't be changed here.</p>
						<a class="btn quiet" href={ templ.SafeURL(structureCalendarURL(data.CampaignID, data.Calendar.ID)) }>Back to the calendar</a>
					} else {
						@structureEditorForm(structureEditorConfig{
							Title:         "Edit structure",
							Lead:          fmt.Sprintf("Change %s's months, weekdays, leap rule, moons and seasons. Nothing is saved until you have seen what the change does to its events and today's date.", data.Calendar.Name),
							PostURL:       fmt.Sprintf("/campaigns/%s/calendars/%s/structure/preview", data.CampaignID, data.Calendar.ID),
							Target:        "#" + structurePreviewSlot,
							Swap:          "innerHTML",
							SubmitLabel:   "Preview changes",
							XData:         structureEditorXData(calendarEditorState(data.Calendar), structurePreviewSlot),
							BackHref:      structureCalendarURL(data.CampaignID, data.Calendar.ID),
							ShowSeasons:   true,
							ShowFlags:     true,
							ClearsPreview: true,
							RevealPreview: true,
							Extra:         weatherSettingsSection(data.Weather, data.Climates),
						}, data.CSRFToken, "")
					}
				</div>
			</div>
			<div id={ structurePreviewSlot } class="calv5-structure-preview" aria-live="polite"></div>
		</div>
	</div>
}

// weatherSettingsSection is the editor's Weather section: the world's climate
// and how long weather lasts. Both controls empty a stale preview like the
// rest of the editor, since the preview carries them to the save.
templ weatherSettingsSection(w WeatherSettings, climates []WeatherClimate) {
	<div class="calv5-bsec calv5-wx">
		<h4>Weather</h4>
		<label class="calv5-fld">
			<span>This world's climate</span>
			<select class="calv5-inp" name="weather_climate" @change="clearPreview()">
				<optgroup label="Natural">
					for _, c := range climates {
						if !c.Magic {
							<option value={ c.ID } selected?={ c.ID == w.Climate }>{ c.Name }</option>
						}
					}
				</optgroup>
				<optgroup label="Magic">
					for _, c := range climates {
						if c.Magic {
							<option value={ c.ID } selected?={ c.ID == w.Climate }>{ c.Name }</option>
						}
					}
				</optgroup>
			</select>
		</label>
		<label class="calv5-fld" for="calv5-weather-continuity">
			<span>How long weather lasts</span>
		</label>
		<div class="calv5-wx-range" x-data={ fmt.Sprintf("{c: %s}", strconv.FormatFloat(w.Continuity, 'f', -1, 64)) }>
			<input
				id="calv5-weather-continuity"
				type="range"
				name="weather_continuity"
				min="0"
				max="1"
				step="0.05"
				value={ strconv.FormatFloat(w.Continuity, 'f', -1, 64) }
				aria-describedby="calv5-weather-continuity-hint"
				x-model.number="c"
				@change="clearPreview()"
			/>
			<output for="calv5-weather-continuity" x-text={ continuityWordsJS }>{ continuityWords(w.Continuity) }</output>
		</div>
		<p id="calv5-weather-continuity-hint" class="calv5-wx-hint">Left changes every day; right settles into long spells.</p>
		<p class="calv5-wx-hint">Generate starts from this climate and from your own weather below.</p>
		@weatherKindsEditor(w)
	</div>
}

// weatherKindsEditor is "Your own weather": a list of the owner's kinds, each
// opening its fields in place. All of it is Alpine state (weatherKindsXData)
// that serializes into the one hidden weather_kinds input, so the form sends
// the whole list or, when the editor is untouched, the stored list back.
// The radio groups sit outside the form (form="calv5-wk-none") so only
// weather_kinds is submitted.
templ weatherKindsEditor(w WeatherSettings) {
	<div class="calv5-wk" x-data={ weatherKindsXData(w.Kinds) } @input="touch(); clearPreview()" @change="touch(); clearPreview()">
		<h5 class="calv5-wk-h" id="calv5-wk-h">Your own weather</h5>
		<input type="hidden" name="weather_kinds" value={ encodeWeatherKinds(w.Kinds) } :value="out"/>
		<p class="calv5-wx-hint" x-show="kinds.length === 0">Add weather of your own, like acid rain or a mana storm. It joins the built-in weather when you generate.</p>
		<ul class="calv5-wk-list" aria-labelledby="calv5-wk-h">
			<template x-for="k in kinds" :key="k.key">
				<li class="calv5-wk-item">
					<div class="calv5-wk-row" x-show="editing !== k.key">
						<span class="calv5-wk-dot" :style="'background:' + dot(k)" aria-hidden="true"></span>
						<i :class="'fa-solid ' + icons[k.icon]" aria-hidden="true"></i>
						<b x-text="k.name.trim() || 'New weather'"></b>
						<span class="calv5-wk-sum" x-text="summary(k)"></span>
						<button type="button" class="btn quiet" :id="'calv5-wk-edit-' + k.key" :aria-label="'Edit ' + (k.name.trim() || 'new weather')" @click="edit(k)">Edit</button>
					</div>
					<div class="calv5-wk-form" x-show="editing === k.key" style="display:none">
						<label class="calv5-fld">
							<span>Name</span>
							<input type="text" maxlength="40" autocomplete="off" x-model="k.name" :id="'calv5-wk-name-' + k.key" @keydown.enter.prevent="done(k)"/>
						</label>
						<p class="calv5-err" role="alert" x-show="k.missing && !k.name.trim()">Give your weather a name.</p>
						<fieldset class="calv5-wk-set">
							<legend>Icon</legend>
							<div class="calv5-wk-icons">
								for _, ic := range weatherKindIconOptions {
									<button
										type="button"
										class="calv5-wk-ic"
										aria-label={ ic.Label }
										title={ ic.Label }
										:aria-pressed={ "k.icon === '" + ic.ID + "' ? 'true' : 'false'" }
										:class={ "{on: k.icon === '" + ic.ID + "'}" }
										@click={ "pick(k, '" + ic.ID + "'); clearPreview()" }
									><i class={ "fa-solid " + ic.Class } aria-hidden="true"></i></button>
								}
							</div>
						</fieldset>
						<label class="calv5-fld">
							<span>Colour</span>
							<input type="color" x-model="k.color" :id="'calv5-wk-color-' + k.key"/>
						</label>
						<label class="calv5-fld">
							<span>Behaves like</span>
							<select x-model="k.like" :aria-describedby="'calv5-wk-like-' + k.key">
								for _, p := range weatherPresets {
									<option value={ p.ID }>{ p.Label }</option>
								}
							</select>
						</label>
						<p class="calv5-wx-hint" :id="'calv5-wk-like-' + k.key">its temperature, wind and wetness</p>
						<fieldset class="calv5-wk-set">
							<legend>How often</legend>
							for _, s := range weatherKindSeasons {
								<fieldset class="calv5-wk-seasonrow">
									<legend>{ s.Label }</legend>
									<span class="calv5-wk-segs">
										for _, l := range weatherKindLevelOptions {
											<label class="calv5-wk-seg">
												<input type="radio" form="calv5-wk-none" :name={ "'wk' + k.key + '-" + s.ID + "'" } value={ l.ID } x-model={ "k.s." + s.ID }/>
												<span>{ l.Label }</span>
											</label>
										}
									</span>
								</fieldset>
							}
						</fieldset>
						<details class="calv5-wk-more">
							<summary>More</summary>
							<fieldset class="calv5-wk-set">
								<legend>What the day says</legend>
								<p class="calv5-wx-hint">Up to 8 short lines, one is picked for each day. Optional.</p>
								<template x-for="i in 8" :key="i">
									<input type="text" maxlength="34" autocomplete="off" class="calv5-inp" :aria-label="'Line ' + i" x-model="k.words[i - 1]" @keydown.enter.prevent/>
								</template>
							</fieldset>
							<fieldset class="calv5-wk-set">
								<legend>How long it lingers</legend>
								<span class="calv5-wk-segs">
									for _, l := range weatherKindLastsOptions {
										<label class="calv5-wk-seg">
											<input type="radio" form="calv5-wk-none" :name="'wk' + k.key + '-lasts'" value={ l.ID } x-model="k.lasts"/>
											<span>{ l.Label }</span>
										</label>
									}
								</span>
							</fieldset>
							<label class="calv5-toggle-row">
								<input type="checkbox" x-model="k.magic"/>
								Magic
							</label>
							<label class="calv5-fld">
								<span>Sky effect</span>
								<select x-model="k.effect">
									<option value="">Same as the weather it's like</option>
									for _, e := range weatherEffects {
										<option value={ e.ID }>{ e.Label }</option>
									}
								</select>
							</label>
						</details>
						<div class="calv5-wk-btns">
							<button type="button" class="btn quiet" @click="remove(k); clearPreview()">Delete</button>
							<button type="button" class="btn primary" @click="done(k)">Done</button>
						</div>
					</div>
				</li>
			</template>
		</ul>
		<button type="button" class="btn quiet" id="calv5-wk-add" :disabled="kinds.length >= max" @click="add(); clearPreview()">+ Add weather</button>
		<p class="calv5-wx-hint" x-show="kinds.length >= max">That is the most weathers you can have.</p>
	</div>
}

// structureBackToEditing empties the preview and returns focus to the
// editor, without touching anything typed in it.
const structureBackToEditing = "(function(){var p=document.getElementById('" + structurePreviewSlot + "');if(p){p.innerHTML='';}var b=document.getElementById('calv5-build-submit');if(b){b.focus();b.scrollIntoView({block:'center'});}})()"

// structureBackToEditingOnClick renders structureBackToEditing straight into
// the onclick attribute: the preview arrives by an htmx swap, where a
// separate script element is not reliably run, so the handler is inline.
// A ComponentScript with no Function emits no script element.
func structureBackToEditingOnClick() templ.ComponentScript {
	return templ.ComponentScript{Name: "calv5_structureBack", Call: structureBackToEditing}
}

func structureCalendarURL(campaignID, calendarID string) string {
	return fmt.Sprintf("/campaigns/%s/calendars/%s/view", campaignID, calendarID)
}

// structurePreviewBody is what a save would do, with the confirm form.
// importJSON is the validated structure carried to the save; fingerprint
// pins the calendar state this preview describes (see
// CalendarService.ApplyStructureEdit). notice is set when the save found
// the calendar had changed and this is the refreshed preview.
templ structurePreviewBody(campaignID, calendarID, csrfToken, importJSON, notice string, p *StructurePreview, wx weatherCarry) {
	<div class="calv5-panel wide page">
		<div class="calv5-body">
			<h2 class="calv5-wz-h">Before you save</h2>
			<p class="calv5-wz-lead">This is what saving the structure above does to { p.CalendarName }.</p>
			if notice != "" {
				<p class="calv5-err">{ notice }</p>
			}
			if len(p.Warnings) > 0 {
				<div class="calv5-warnbox">
					<i class="fa-solid fa-triangle-exclamation i"></i>
					<div>
						<b>Adjusted to fit</b>
						<ul>
							for _, w := range p.Warnings {
								<li>{ w }</li>
							}
						</ul>
					</div>
				</div>
			}
			if p.StrandedTotal > 0 {
				<div class="calv5-warnbox">
					<i class="fa-solid fa-triangle-exclamation i"></i>
					<div>
						<b>{ fmt.Sprintf("%d %s will be on a day that no longer exists", p.StrandedTotal, nounFor(p.StrandedTotal, "event", "events")) }</b>
						<p style="margin:4px 0 0">They are kept, not deleted, but the calendar can't show them until you move them or put the day back.</p>
						<ul>
							for _, ev := range p.Stranded {
								<li><b>{ ev.Name }</b> ({ ev.Date }): { ev.Note }</li>
							}
						</ul>
						if more := p.StrandedTotal - len(p.Stranded); more > 0 {
							<p style="margin:4px 0 0">{ fmt.Sprintf("And %d more.", more) }</p>
						}
					</div>
				</div>
			}
			if p.WeatherReplaced > 0 {
				<div class="calv5-warnbox">
					<i class="fa-solid fa-triangle-exclamation i"></i>
					<div>
						<b>{ fmt.Sprintf("%d day-weather %s will be deleted", p.WeatherReplaced, nounFor(p.WeatherReplaced, "reading", "readings")) }</b>
						<p style="margin:4px 0 0">They are in months being removed, on days a moved month's own reading now takes.</p>
					</div>
				</div>
			}
			if p.RedatedTotal > 0 {
				<div class="calv5-warnbox">
					<i class="fa-solid fa-triangle-exclamation i"></i>
					<div>
						<b>{ fmt.Sprintf("%d %s will show in a different month", p.RedatedTotal, nounFor(p.RedatedTotal, "event", "events")) }</b>
						<ul>
							for _, ev := range p.Redated {
								<li><b>{ ev.Name }</b> ({ ev.Date }): { ev.Note }</li>
							}
						</ul>
						if more := p.RedatedTotal - len(p.Redated); more > 0 {
							<p style="margin:4px 0 0">{ fmt.Sprintf("And %d more.", more) }</p>
						}
					</div>
				</div>
			}
			<div class="calv5-report">
				<div class="calv5-rgrp">
					<h4>Months</h4>
					<ul>
						if len(p.MonthNotes) == 0 {
							<li>No changes to the months.</li>
						}
						for _, n := range p.MonthNotes {
							<li>{ n }</li>
						}
					</ul>
				</div>
				<div class="calv5-rgrp">
					<h4>Events &amp; today</h4>
					<ul>
						if p.MovedEvents > 0 {
							<li>{ fmt.Sprintf("%d %s follow their month to its new place.", p.MovedEvents, nounFor(p.MovedEvents, "event", "events")) }</li>
						}
						if p.StrandedTotal == 0 && p.RedatedTotal == 0 && p.MovedEvents == 0 {
							<li>No events are affected.</li>
						}
						if p.CurrentDateClamped {
							<li><b>{ fmt.Sprintf("Today moves from %s to %s", p.CurrentDate, p.NewCurrentDate) }</b> <small>That day won't exist any more, so today becomes the nearest day that does.</small></li>
						} else {
							<li>{ fmt.Sprintf("Today stays %s.", p.NewCurrentDate) }</li>
						}
					</ul>
				</div>
				<div class="calv5-rgrp">
					<h4>Also</h4>
					<ul>
						if len(p.OtherNotes) == 0 && len(wx.Notes) == 0 {
							<li>Nothing else changes.</li>
						}
						for _, n := range p.OtherNotes {
							<li>{ n }</li>
						}
						for _, n := range wx.Notes {
							<li>{ n }</li>
						}
					</ul>
				</div>
			</div>
			<form
				hx-post={ fmt.Sprintf("/campaigns/%s/calendars/%s/structure", campaignID, calendarID) }
				hx-target={ "#" + structurePreviewSlot }
				hx-swap="innerHTML"
				hx-encoding="multipart/form-data"
				hx-disabled-elt="#calv5-structure-save"
				hx-indicator="#calv5-structure-spinner"
				style="margin-top:18px;display:flex;gap:8px;align-items:center"
			>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="hidden" name="import_json" value={ importJSON }/>
				<input type="hidden" name="fingerprint" value={ p.Fingerprint }/>
				if wx.Sent {
					<input type="hidden" name="weather_climate" value={ wx.Climate }/>
					<input type="hidden" name="weather_continuity" value={ wx.Continuity }/>
					<input type="hidden" name="weather_kinds" value={ wx.KindsJSON }/>
				}
				<button type="button" class="btn quiet" onclick={ structureBackToEditingOnClick() }>Back to editing</button>
				<span class="sp" style="flex:1"></span>
				<i id="calv5-structure-spinner" class="fa-solid fa-spinner fa-spin htmx-indicator" aria-hidden="true"></i>
				<button id="calv5-structure-save" type="submit" class="btn primary">
					if p.StrandedTotal > 0 || p.RedatedTotal > 0 {
						Save anyway
					} else {
						Save changes
					}
				</button>
			</form>
		</div>
	</div>
}

// structurePreviewError fills the preview slot with why the structure
// couldn't be previewed or saved; the editor above keeps what was typed.
templ structurePreviewError(message string) {
	<div class="calv5-panel wide page">
		<div class="calv5-body">
			<p class="calv5-err">{ message }</p>
		</div>
	</div>
}
