// calendar_preview.templ renders the per-card preview dialog: the
// calendar's name, today's date, the current month's grid, tonight's moons
// and what's coming up. This is always the mockup's folded ".pv" state —
// the in-page "unfold to full calendar" animation and its month-to-month
// paging are Part A's /campaigns/:id/calendars/:calid/view route (not part
// of this checkout yet — see the Part B PR description). No weather line:
// that needs a weather-generation engine this plugin doesn't have wired for
// a viewer with no forecast permission, and #764 didn't ask for it.
package calendar

import "fmt"

// CalendarPreviewFragment is the dialog's whole content, always fragment-only.
templ CalendarPreviewFragment(data CalendarPreviewData) {
	<div
		id="calv5-preview-root"
		class="calv5"
		x-data="{open:true}"
		x-show="open"
		x-cloak
	>
		<div class="calv5-overlay" @click.self="open=false; if(window.__calv5Opener)window.__calv5Opener.focus()">
			<div
				class="calv5-panel wide"
				role="dialog"
				aria-modal="true"
				aria-label={ fmt.Sprintf("%s preview", data.Calendar.Name) }
				tabindex="-1"
				x-init="$nextTick(() => $el.focus())"
				@keydown.escape.window="open=false; if(window.__calv5Opener)window.__calv5Opener.focus()"
			>
				<div class="calv5-crease">
					<span>Calendar preview</span>
					<button
						type="button"
						class="x"
						aria-label="Close"
						style="margin-left:auto"
						@click="open=false; if(window.__calv5Opener)window.__calv5Opener.focus()"
					>
						<i class="fa-solid fa-xmark"></i>
					</button>
				</div>
				<div class="calv5-body">
					<div style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:22px;align-items:start">
						<div>
							@previewMonthGrid(data.Calendar, data.MonthEvents)
						</div>
						<div>
							<div class="calv5-ai-top">
								<h2 class="calv5-ai-name">{ data.Calendar.Name }</h2>
							</div>
							<p class="calv5-ai-date">{ data.Calendar.FullDateLabel() }</p>

							<span class="calv5-ai-l">Tonight</span>
							if len(data.Calendar.Moons) == 0 {
								<p style="margin:0;font-size:12.5px;color:var(--mut)">No moons in this calendar.</p>
							} else {
								<div class="calv5-ai-moons">
									for _, m := range data.Calendar.Moons {
										<div class="calv5-ai-moon">
											<span class="tsil">
												@MoonSilhouette(m.MoonPhase(data.Calendar.CurrentAbsoluteDay()))
											</span>
											<span>
												<b>{ m.Name }</b>
												<small>{ m.MoonPhaseName(data.Calendar.CurrentAbsoluteDay()) }</small>
											</span>
										</div>
									}
								</div>
							}

							<span class="calv5-ai-l">Coming up</span>
							if len(data.Upcoming) == 0 {
								<p style="margin:0;font-size:12.5px;color:var(--mut)">Nothing on the calendar yet.</p>
							} else {
								<ul class="calv5-up">
									for _, e := range data.Upcoming {
										<li>
											<i class="fa-solid fa-calendar-day i" style="margin-top:2px;color:var(--mut)"></i>
											<span>
												<b>{ e.Name }</b>
												<small>{ fmt.Sprintf("%s %d, %d", data.Calendar.MonthName(e.Month), e.Day, e.Year) }</small>
											</span>
										</li>
									}
								</ul>
							}

							<div style="margin-top:18px;display:flex;flex-direction:column;gap:8px">
								// Not a clickable <a href> yet: Part A's
								// /campaigns/:id/calendars/:calid/view route (this
								// preview's real "unfold to full calendar" target —
								// see the package doc comment above) hasn't merged,
								// so linking there today would be a dead 404. A
								// disabled button says so instead of pretending the
								// feature exists; swap back to the <a href> once
								// that route lands.
								<button
									type="button"
									class="btn primary"
									style="width:100%"
									disabled
									title="The full calendar view is not available yet"
								>
									<i class="fa-solid fa-book-open"></i> Full calendar view (coming soon)
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// previewMonthGrid renders the calendar's current month as a simple grid:
// day numbers, today highlighted, a moon silhouette and event-count dots per
// day. No prev/next paging (MVP scope — see this file's package doc).
templ previewMonthGrid(cal *Calendar, monthEvents []Event) {
	// --cols overrides the CSS default of 7 (static/css/calendar_v5.css'
	// .calv5-mgrid) with this calendar's actual weekday count: 3 of the 4
	// shipped presets (Harptos 10, Dwarven 6, Blank 10) aren't 7-day weeks,
	// and without this the grid wraps/misaligns for every one of them. Never
	// 0 — an empty weekday list would set --cols:0 and hide the grid
	// entirely, worse than the wrong-but-visible default.
	<div class="calv5-mgrid" style={ fmt.Sprintf("--cols:%d", max(len(cal.Weekdays), 1)) }>
		<div class="calv5-mg-head">
			<h3 class="calv5-mg-title">
				{ cal.CurrentMonthName() } <span class="yr">{ fmt.Sprintf("%d", cal.CurrentYear) }</span>
			</h3>
		</div>
		<div class="calv5-mg-dow">
			for _, w := range cal.Weekdays {
				<span>{ w.Name }</span>
			}
		</div>
		for _, week := range previewGridRows(cal, monthEvents) {
			<div class="calv5-mg-wk">
				for _, day := range week {
					if day.Blank {
						<div class="calv5-mg-day blank"></div>
					} else {
						<div class={ "calv5-mg-day", templ.KV("today", day.IsToday), templ.KV("past", day.IsPast) }>
							<span class="num">{ fmt.Sprintf("%d", day.Day) }</span>
							if day.HasMoon {
								<span class="calv5-msil">
									@MoonSilhouette(day.MoonPhase)
								</span>
							}
							if day.EventCount > 0 {
								<span class="calv5-dots">
									for i := 0; i < day.EventCount && i < 4; i++ {
										<span class="calv5-dot"></span>
									}
								</span>
							}
						</div>
					}
				}
			</div>
		}
	</div>
}

// previewGridRows resolves the current month's event dots (recurrence-aware)
// and builds the grid rows via buildMonthGrid, using the calendar's own
// current month/year and main moon.
func previewGridRows(cal *Calendar, monthEvents []Event) [][]monthGridCell {
	counts := countEventsByDay(cal, monthEvents, cal.CurrentYear, cal.CurrentMonth)
	return buildMonthGrid(cal, cal.CurrentYear, cal.CurrentMonth, counts, mainMoon(cal))
}
