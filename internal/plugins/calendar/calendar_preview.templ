// calendar_preview.templ renders the almanac a calendar opens as from its
// card on the Calendars page (the signed setup design, #764): folded, the
// preview is this month and this calendar's today, tonight and what's coming
// up; "Open calendar" unfolds it in place into the calendar itself, whose
// mount waits in a <template> until then. calendar_almanac.js runs the
// opening, the unfolding and back. No weather line: that needs a
// weather-generation engine this plugin doesn't have wired for a viewer with
// no forecast permission.
package calendar

import "fmt"

// CalendarPreviewFragment is the almanac's whole content, always fragment-only.
templ CalendarPreviewFragment(data CalendarPreviewData) {
	<div id="calv5-preview-root" class="calv5" data-almanac>
		<div class="calv5-alm-scrim" data-alm="escape"></div>
		<div
			class="calv5-alm pv"
			id="calv5-alm"
			role="dialog"
			aria-modal="true"
			aria-labelledby="calv5-alm-name"
			tabindex="-1"
		>
			<div class="calv5-ap calv5-ap-grid" id="calv5-alm-grid">
				@previewMonthGrid(data.Calendar, data.MonthEvents)
			</div>
			<div class="calv5-ap calv5-ap-info" id="calv5-alm-info">
				<div class="calv5-ai-top">
					<h2 class="calv5-ai-name" id="calv5-alm-name">{ data.Calendar.Name }</h2>
					<button type="button" class="x" data-alm="close" aria-label={ "Close " + data.Calendar.Name }>
						<i class="fa-solid fa-xmark" aria-hidden="true"></i>
					</button>
				</div>
				<p class="calv5-ai-date">{ "Today is " + data.Calendar.FullDateLabel() }</p>
				<div>
					<span class="calv5-ai-l">Tonight</span>
					if len(data.Calendar.Moons) == 0 {
						<p class="calv5-ai-none">No moons in this calendar.</p>
					} else {
						<div class="calv5-ai-moons">
							for _, m := range data.Calendar.Moons {
								<div class="calv5-ai-moon">
									<span class="tsil">
										@MoonSilhouette(m.MoonPhase(data.Calendar.CurrentDayIndex()))
									</span>
									<span>
										<b>{ m.Name }</b>
										<small>{ m.MoonPhaseName(data.Calendar.CurrentDayIndex()) }</small>
									</span>
								</div>
							}
						</div>
					}
				</div>
				<div>
					<span class="calv5-ai-l">Coming up</span>
					if len(data.Upcoming) == 0 {
						<p class="calv5-ai-none">Nothing on the calendar yet.</p>
					} else {
						<ul class="calv5-up">
							for _, e := range data.Upcoming {
								<li>
									<i class="fa-solid fa-calendar-day i" style="margin-top:2px;color:var(--mut)"></i>
									<span>
										<b>{ e.Name }</b>
										<small>{ fmt.Sprintf("%s %d, %d", data.Calendar.MonthName(e.Month), e.Day, e.Year) }</small>
									</span>
								</li>
							}
						</ul>
					}
				</div>
				<div class="calv5-ai-acts">
					<button type="button" class="btn primary" data-alm="unfold" id="calv5-alm-open">
						<i class="fa-solid fa-book-open" aria-hidden="true"></i> Open calendar
					</button>
				</div>
			</div>
			<div class="calv5-alm-full" id="calv5-alm-full" hidden>
				<div class="calv5-alm-bar">
					<button type="button" class="btn quiet sm" data-alm="fold">
						<i class="fa-solid fa-chevron-left" aria-hidden="true"></i> Preview
					</button>
					<button type="button" class="x" data-alm="close" aria-label={ "Close " + data.Calendar.Name }>
						<i class="fa-solid fa-xmark" aria-hidden="true"></i>
					</button>
				</div>
				<div class="calv5-alm-cal" id="calv5-alm-cal"></div>
			</div>
			<template id="calv5-alm-tpl">
				@calendarViewMount(data.View)
			</template>
		</div>
	</div>
}

// previewMonthGrid renders the calendar's current month as a simple grid:
// day numbers, today highlighted, a moon silhouette and event-count dots per
// day. No prev/next paging (MVP scope — see this file's package doc).
templ previewMonthGrid(cal *Calendar, monthEvents []Event) {
	// --cols overrides the CSS default of 7 (static/css/calendar_v5.css'
	// .calv5-mgrid) with this calendar's actual weekday count: 3 of the 4
	// shipped presets (Harptos 10, Dwarven 6, Blank 10) aren't 7-day weeks,
	// and without this the grid wraps/misaligns for every one of them. Never
	// 0 — an empty weekday list would set --cols:0 and hide the grid
	// entirely, worse than the wrong-but-visible default.
	<div class="calv5-mgrid" style={ fmt.Sprintf("--cols:%d", max(len(cal.Weekdays), 1)) }>
		<div class="calv5-mg-head">
			<h3 class="calv5-mg-title">
				{ cal.CurrentMonthName() } <span class="yr">{ fmt.Sprintf("%d", cal.CurrentYear) }</span>
			</h3>
		</div>
		<div class="calv5-mg-dow">
			for _, w := range cal.Weekdays {
				<span>{ w.Name }</span>
			}
		</div>
		for _, week := range previewGridRows(cal, monthEvents) {
			<div class="calv5-mg-wk">
				for _, day := range week {
					if day.Blank {
						<div class="calv5-mg-day blank"></div>
					} else {
						<div class={ "calv5-mg-day", templ.KV("today", day.IsToday), templ.KV("past", day.IsPast) }>
							<span class="num">{ fmt.Sprintf("%d", day.Day) }</span>
							if day.HasMoon {
								<span class="calv5-msil">
									@MoonSilhouette(day.MoonPhase)
								</span>
							}
							if day.EventCount > 0 {
								<span class="calv5-dots">
									for i := 0; i < day.EventCount && i < 4; i++ {
										<span class="calv5-dot"></span>
									}
								</span>
							}
						</div>
					}
				}
			</div>
		}
	</div>
}

// previewGridRows resolves the current month's event dots (recurrence-aware)
// and builds the grid rows via buildMonthGrid, using the calendar's own
// current month/year and main moon.
func previewGridRows(cal *Calendar, monthEvents []Event) [][]monthGridCell {
	counts := countEventsByDay(cal, monthEvents, cal.CurrentYear, cal.CurrentMonth)
	return buildMonthGrid(cal, cal.CurrentYear, cal.CurrentMonth, counts, mainMoon(cal))
}
