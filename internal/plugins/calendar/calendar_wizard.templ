// calendar_wizard.templ renders the new-calendar wizard's steps: Start,
// Preset (picker + review), Import (drop zone + review), the Real-world
// calendar's own review, Build your own (structure editor + review), and
// Generate one (recipe sheet + review — see calendar_wizard_generate.templ).
// Every step is fetched via HTMX into the SAME dialog shell
// (#calv5-wizard-root, replaced wholesale with hx-swap="outerHTML" on every
// step change) — simpler than juggling a separate "shell vs. inner
// fragment" response shape per route, at the cost of re-sending the shell's
// chrome on every step; that chrome is a few hundred bytes, not a real cost
// at this scale.
//
// No DECORATIVE icons anywhere in this file (the operator's own
// instruction, already applied to this wizard once — see the close-button/
// spinner/warning-triangle exceptions noted where wizardShell is defined
// below): every structure-editor control (reorder, remove, add) is a
// labelled text button, never a glyph standing in for one.
//
// Out of scope for this wizard: "Give it a past" does not exist here.
package calendar

import (
	"encoding/json"
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/timeutil"
)

// wizardShell is the dialog chrome every step renders inside.
templ wizardShell(stepLabel string, body templ.Component) {
	<div id="calv5-wizard-root" class="calv5" x-data="{open:true}" x-show="open" x-cloak>
		<div class="calv5-overlay" @click.self="open=false; if(window.__calv5Opener)window.__calv5Opener.focus()">
			<div
				class="calv5-panel wide"
				role="dialog"
				aria-modal="true"
				aria-label="New calendar"
				tabindex="-1"
				x-init="$nextTick(() => $el.focus())"
				@keydown.escape.window="open=false; if(window.__calv5Opener)window.__calv5Opener.focus()"
			>
				<div class="calv5-crease">
					<span>New calendar</span>
					<span>&middot;</span>
					<span>{ stepLabel }</span>
					<button
						type="button"
						class="x"
						style="margin-left:auto"
						aria-label="Close"
						@click="open=false; if(window.__calv5Opener)window.__calv5Opener.focus()"
					>
						<i class="fa-solid fa-xmark"></i>
					</button>
				</div>
				<div class="calv5-body">
					@body
				</div>
			</div>
		</div>
	</div>
}

// wizardStartBody is the Start step, grouped by purpose per the operator's
// own framing: "For your table" is the real-world calendar RSVPs and
// availability actually need; "For your world" is every way to set up a
// fantasy calendar's structure, including generating one from a recipe (or
// from how many suns, moons and wandering planets the world has) — see
// calendar_wizard_generate.templ.
templ wizardStartBody(campaignID string) {
	<h2 class="calv5-wz-h">New calendar</h2>
	<p class="calv5-wz-lead">Choose how to set up this calendar's months, weekdays, moons and seasons.</p>
	<div class="calv5-tilegrp">
		<span class="kicker">For your table</span>
		<div class="calv5-tiles calv5-tiles-1">
			<button
				type="button"
				class="calv5-tile featured"
				hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard/reallife", campaignID) }
				hx-target="#calv5-wizard-root"
				hx-swap="outerHTML"
			>
				<b>Real-world calendar</b>
				<span>Game nights, RSVPs and everyone's availability, on the real dates.</span>
			</button>
		</div>
	</div>
	<div class="calv5-tilegrp">
		<span class="kicker">For your world</span>
		<div class="calv5-tiles">
			<button
				type="button"
				class="calv5-tile"
				hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard/presets", campaignID) }
				hx-target="#calv5-wizard-root"
				hx-swap="outerHTML"
			>
				<b>Start from a preset</b>
				<span>One of Chronicle's shipped calendars — ready to use, easy to adjust later.</span>
			</button>
			<button
				type="button"
				class="calv5-tile"
				hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard/build", campaignID) }
				hx-target="#calv5-wizard-root"
				hx-swap="outerHTML"
			>
				<b>Build your own</b>
				<span>Set your own months, weekdays, moons and era from scratch.</span>
			</button>
			<button
				type="button"
				class="calv5-tile"
				hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard/import", campaignID) }
				hx-target="#calv5-wizard-root"
				hx-swap="outerHTML"
			>
				<b>Import a file</b>
				<span>Bring over a calendar from Simple Calendar, Calendaria, Fantasy-Calendar or a Chronicle export.</span>
			</button>
			@wizardGenerateOneTile(campaignID)
		</div>
	</div>
	<div class="calv5-reassure">
		<span>Nothing is created until you confirm on the last step — you can back out any time.</span>
	</div>
}

// wizardGenerateOneTile is the procedural generator tile: a whole calendar
// from a recipe (or from how many suns, moons and wandering planets the
// world has), months/weeks/moons/names included, ready to review with no
// typing required. See calendar_wizard_generate.templ for the step itself.
templ wizardGenerateOneTile(campaignID string) {
	<button
		type="button"
		class="calv5-tile"
		hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard/generate", campaignID) }
		hx-target="#calv5-wizard-root"
		hx-swap="outerHTML"
	>
		<b>Generate one</b>
		<span>A whole calendar from a recipe — months, weeks, moons and names in one culture's voice. Keep what you like and reroll the rest.</span>
	</button>
}

// presetCardData is one preset's card content on the picker step.
type presetCardData struct {
	Name         string
	CalendarName string
	Facts        string
	BarWidths    []float64
}

// wizardPresetsBody is the preset-picker step.
templ wizardPresetsBody(campaignID string, presets []presetCardData) {
	<h2 class="calv5-wz-h">Start from a preset</h2>
	<p class="calv5-wz-lead">Each preset is a complete calendar — ready to use as-is, or adjust later.</p>
	<div class="calv5-presets">
		for _, p := range presets {
			<button
				type="button"
				class="calv5-pcard"
				hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard/presets/%s", campaignID, p.Name) }
				hx-target="#calv5-wizard-root"
				hx-swap="outerHTML"
			>
				<b>{ p.CalendarName }</b>
				<span class="pf">{ p.Facts }</span>
				<div class="calv5-ybar">
					for _, w := range p.BarWidths {
						<i style={ fmt.Sprintf("flex-grow:%.4f", w) }></i>
					}
				</div>
			</button>
		}
	</div>
	<div style="margin-top:16px">
		<button
			type="button"
			class="btn quiet"
			hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard", campaignID) }
			hx-target="#calv5-wizard-root"
			hx-swap="outerHTML"
		>
			Back
		</button>
	</div>
}

// wizardImportBody is the Import step: a drop zone (Alpine handles
// dragover/drop declaratively — no separate JS widget needed for it) plus a
// plain file picker fallback.
templ wizardImportBody(campaignID, csrfToken, formError string) {
	<h2 class="calv5-wz-h">Import a file</h2>
	<p class="calv5-wz-lead">Bring over a calendar from Simple Calendar, Calendaria, Fantasy-Calendar or a Chronicle export (JSON, up to 10MB).</p>
	if formError != "" {
		<p class="calv5-err">{ formError }</p>
	}
	<form
		hx-post={ fmt.Sprintf("/campaigns/%s/calendars/wizard/import/preview", campaignID) }
		hx-target="#calv5-wizard-root"
		hx-swap="outerHTML"
		hx-encoding="multipart/form-data"
		hx-disabled-elt="#calv5-import-submit"
		hx-indicator="#calv5-import-spinner"
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<div
			class="calv5-drop"
			x-data="{over:false,fileName:''}"
			x-bind:class="{over:over}"
			@dragover.prevent="over=true"
			@dragleave.prevent="over=false"
			@drop.prevent="over=false; $refs.calv5File.files=$event.dataTransfer.files; fileName=$event.dataTransfer.files[0]?.name||''"
		>
			<b>Drop a calendar file here</b>
			<small>or choose one below</small>
			<input
				type="file"
				name="file"
				accept=".json,application/json"
				required
				x-ref="calv5File"
				style="margin-top:10px"
				@change="fileName=$event.target.files[0]?.name||''"
			/>
			<div class="calv5-fchip" x-show="fileName" x-cloak>
				<span x-text="fileName"></span>
			</div>
		</div>
		<div style="margin-top:16px;display:flex;gap:8px">
			<button
				type="button"
				class="btn quiet"
				hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard", campaignID) }
				hx-target="#calv5-wizard-root"
				hx-swap="outerHTML"
			>
				Back
			</button>
			<span class="sp" style="flex:1"></span>
			<i id="calv5-import-spinner" class="fa-solid fa-spinner fa-spin htmx-indicator" aria-hidden="true"></i>
			<button id="calv5-import-submit" type="submit" class="btn primary">Continue</button>
		</div>
	</form>
}

// wizardReviewBody is the shared Review step for both a preset and an
// import: an editable calendar name, the required "today in the world"
// selects (never pre-filled with a silent default when the source left one
// unspecified — #741), a read-only parts summary, and any warnings the
// import/preset carried. source is "preset" or "import"; presetName is set
// for the former, importJSON (the ImportResult round-tripped as JSON) for
// the latter — see WizardCreate for why: no server-side draft session, so
// the two paths carry forward what they need in the form itself.
//
// The form below submits with hx-encoding="multipart/form-data" specifically
// so import_json isn't sent application/x-www-form-urlencoded: percent-
// encoding a large JSON blob (every '"', ':', '{', space, …) bloats it by
// roughly 3x, which could otherwise make a file well within the wizard's own
// ~10MB import cap pass Preview but then fail Create purely from the
// round-trip's own re-encoding overhead.
templ wizardReviewBody(campaignID, source, presetName, importJSON, csrfToken, backURL, formError string, ir *ImportResult) {
	<h2 class="calv5-wz-h">Review</h2>
	<p class="calv5-wz-lead">Confirm the calendar's name and today's date in the world, then create it.</p>
	if formError != "" {
		<p class="calv5-err">{ formError }</p>
	}
	if len(ir.Warnings) > 0 {
		<div class="calv5-warnbox">
			<i class="fa-solid fa-triangle-exclamation i"></i>
			<div>
				<b>Worth a look</b>
				<ul>
					for _, w := range ir.Warnings {
						<li>{ w }</li>
					}
				</ul>
			</div>
		</div>
	}
	<form
		hx-post={ fmt.Sprintf("/campaigns/%s/calendars/wizard/create", campaignID) }
		hx-target="#calv5-wizard-root"
		hx-swap="outerHTML"
		hx-encoding="multipart/form-data"
		hx-disabled-elt="#calv5-review-submit"
		hx-indicator="#calv5-review-spinner"
		x-data={ fmt.Sprintf("{m:%s,d:%s,md:%s}", jsIntOrEmpty(ir.Today.Month), jsIntOrEmpty(ir.Today.Day), jsMonthDayCounts(ir.Months)) }
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="source" value={ source }/>
		if source == "preset" {
			<input type="hidden" name="preset_name" value={ presetName }/>
		} else {
			<input type="hidden" name="import_json" value={ importJSON }/>
		}
		<div class="calv5-rv">
			<div>
				<label class="calv5-fld">
					<span>Calendar name</span>
					<input class="calv5-inp" type="text" name="name" value={ ir.CalendarName } required maxlength="120"/>
				</label>
				@wizardDateFields(ir)
			</div>
			<div>
				@wizardStructureSummary(ir)
			</div>
		</div>
		<div style="margin-top:18px;display:flex;gap:8px;align-items:center">
			<button type="button" class="btn quiet" hx-get={ backURL } hx-target="#calv5-wizard-root" hx-swap="outerHTML">
				Back
			</button>
			<span class="sp" style="flex:1"></span>
			<i id="calv5-review-spinner" class="fa-solid fa-spinner fa-spin htmx-indicator" aria-hidden="true"></i>
			<button id="calv5-review-submit" type="submit" class="btn primary" x-bind:disabled="!m || !d">
				Create calendar
			</button>
		</div>
	</form>
}

// wizardDateFields is the "today in the world" year/month/day trio, shared
// by every Review step that asks for it (every source except the
// real-world calendar's own review while "today follows the real date" is
// on — see wizardRealWorldReviewBody). Relies on the enclosing <form>'s
// Alpine x-data carrying m/d/md (see wizardReviewBody's and
// wizardRealWorldReviewBody's own x-data) — a templ component nests plain
// DOM, so Alpine's scoping (tree-based, not component-based) still resolves
// x-model="m" etc. to that ancestor regardless of this extraction.
templ wizardDateFields(ir *ImportResult) {
	<div class="calv5-rv-date">
		<label class="calv5-fld">
			<span>Year</span>
			<input class="calv5-inp" type="number" name="current_year" value={ fmt.Sprintf("%d", ir.Today.Year) } required/>
		</label>
		<label class="calv5-fld">
			<span>Month</span>
			<select class="calv5-inp" name="current_month" x-model="m" required>
				<option value="" disabled selected?={ ir.Today.Month == nil }>Choose…</option>
				for i, mo := range ir.Months {
					<option value={ fmt.Sprintf("%d", i+1) } selected?={ ir.Today.Month != nil && *ir.Today.Month == i+1 }>{ mo.Name }</option>
				}
			</select>
		</label>
		<label class="calv5-fld">
			<span>Day</span>
			<input
				class="calv5-inp"
				type="number"
				name="current_day"
				min="1"
				x-bind:max="md[m-1] || 31"
				x-model="d"
				required
			/>
		</label>
	</div>
}

// wizardStructureSummary is the read-only "what's about to be created" panel
// shared by every Review step variant (preset, import, build, real-world).
templ wizardStructureSummary(ir *ImportResult) {
	<div class="calv5-report">
		<div class="calv5-rgrp">
			<h4>Structure</h4>
			<ul>
				<li><b>{ fmt.Sprintf("%d", len(ir.Months)) }</b> { nounFor(len(ir.Months), "month", "months") }</li>
				<li><b>{ fmt.Sprintf("%d", len(ir.Weekdays)) }</b> { nounFor(len(ir.Weekdays), "weekday", "weekdays") }</li>
				<li><b>{ fmt.Sprintf("%d", len(ir.Seasons)) }</b> { nounFor(len(ir.Seasons), "season", "seasons") }</li>
			</ul>
		</div>
		<div class="calv5-rgrp">
			<h4>Sky &amp; eras</h4>
			<ul>
				<li><b>{ fmt.Sprintf("%d", len(ir.Moons)) }</b> { nounFor(len(ir.Moons), "moon", "moons") }</li>
				<li><b>{ fmt.Sprintf("%d", len(ir.Eras)) }</b> { nounFor(len(ir.Eras), "era", "eras") }</li>
			</ul>
		</div>
		<div class="calv5-rgrp">
			<h4>Events</h4>
			<ul>
				<li><b>{ fmt.Sprintf("%d", len(ir.Events)) }</b> carried over</li>
			</ul>
		</div>
	</div>
}

// jsIntOrEmpty renders an *int as a bare JS number literal, or the string
// '' when nil — used only to seed wizardReviewBody's Alpine x-data so the
// Create button starts disabled exactly when #741 requires an explicit
// month/day the source didn't supply.
func jsIntOrEmpty(v *int) string {
	if v == nil {
		return "''"
	}
	return fmt.Sprintf("%d", *v)
}

// jsMonthDayCounts serializes each month's day count (Days — not leap-year
// adjusted, since this only feeds the day input's client-side `max` hint,
// not an authoritative check) as a JSON array literal for the Review step's
// Alpine x-data. The real check is server-side, in
// CreateCalendarFromImport's own current-date range validation — this is
// defense in depth so a wrong day is caught before submit, not instead of
// that check.
func jsMonthDayCounts(months []MonthInput) string {
	days := make([]int, len(months))
	for i, m := range months {
		days[i] = m.Days
	}
	b, err := json.Marshal(days)
	if err != nil {
		return "[]"
	}
	return string(b)
}

// jsStringLit renders s as a safe, escaped JS string literal — a JSON string
// is valid JS string syntax, so this is exactly right for embedding server
// data into an inline Alpine x-data attribute, same job as jsMonthDayCounts.
func jsStringLit(s string) string {
	b, err := json.Marshal(s)
	if err != nil {
		return `""`
	}
	return string(b)
}

// zoneOrDefault returns z, or "UTC" when z is empty. The review step's
// x-data always seeds a real zone value so the timezone <select> (bound via
// x-model) never targets a value no <option> carries — which would leave a
// plain HTML <select> with nothing visibly selected.
func zoneOrDefault(z string) string {
	if z == "" {
		return "UTC"
	}
	return z
}

// wizardRealWorldReviewBody is the Real-world calendar's own Review step —
// distinct from wizardReviewBody because it asks for different things: a
// time zone and "today follows the real date" instead of a bare today-date
// (see WizardRealWorldReview's own doc comment for why this source needs no
// picker/upload step first). defaultZone is a starting suggestion only
// (h.ownerZoneHint, itself best-effort) — the review step's own x-init
// prefers whatever the BROWSER reports via Intl, when that's one of the
// zones offered.
templ wizardRealWorldReviewBody(campaignID, csrfToken, backURL, formError, defaultZone string, zones []timeutil.Zone, ir *ImportResult) {
	<h2 class="calv5-wz-h">Review</h2>
	<p class="calv5-wz-lead">Confirm the calendar's name and time zone, then create it.</p>
	if formError != "" {
		<p class="calv5-err">{ formError }</p>
	}
	if len(ir.Warnings) > 0 {
		<div class="calv5-warnbox">
			<i class="fa-solid fa-triangle-exclamation i"></i>
			<div>
				<b>Worth a look</b>
				<ul>
					for _, w := range ir.Warnings {
						<li>{ w }</li>
					}
				</ul>
			</div>
		</div>
	}
	<form
		hx-post={ fmt.Sprintf("/campaigns/%s/calendars/wizard/create", campaignID) }
		hx-target="#calv5-wizard-root"
		hx-swap="outerHTML"
		hx-encoding="multipart/form-data"
		hx-disabled-elt="#calv5-review-submit"
		hx-indicator="#calv5-review-spinner"
		x-data={ fmt.Sprintf("{followsReal:true,tz:%s,zones:%s,m:%s,d:%s,md:%s}",
			jsStringLit(zoneOrDefault(defaultZone)), timeutil.CommonZonesJSON(),
			jsIntOrEmpty(ir.Today.Month), jsIntOrEmpty(ir.Today.Day), jsMonthDayCounts(ir.Months)) }
		x-init="(function(){try{var z=Intl.DateTimeFormat().resolvedOptions().timeZone;if(z&&zones.indexOf(z)>-1){tz=z}}catch(e){}})()"
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="source" value="reallife"/>
		<input type="hidden" name="tracks_real_time" x-bind:value="followsReal ? 'true' : 'false'"/>
		<div class="calv5-rv">
			<div>
				<label class="calv5-fld">
					<span>Calendar name</span>
					<input class="calv5-inp" type="text" name="name" value={ ir.CalendarName } required maxlength="120"/>
				</label>
				<label class="calv5-fld" style="margin-top:10px">
					<span>Time zone</span>
					<select class="calv5-inp" name="real_time_zone" x-model="tz" required>
						for _, z := range zones {
							<option value={ z.Value } selected?={ z.Value == zoneOrDefault(defaultZone) }>{ z.Label }</option>
						}
					</select>
				</label>
				<label class="calv5-toggle-row">
					<input type="checkbox" x-model="followsReal"/>
					<span>Today follows the real date</span>
				</label>
				<!-- A <fieldset disabled> (not just a hidden <div>) — the year/
				     month/day fields inside are `required`, and a plain
				     display:none on a required field still fails the
				     browser's native constraint validation on submit, since
				     it's merely hidden, not exempted. Disabling the fieldset
				     is what actually exempts its fields from validation. -->
				<fieldset x-show="!followsReal" x-bind:disabled="followsReal" style="border:0;padding:0;margin:0" x-cloak>
					@wizardDateFields(ir)
				</fieldset>
			</div>
			<div>
				@wizardStructureSummary(ir)
			</div>
		</div>
		<div style="margin-top:18px;display:flex;gap:8px;align-items:center">
			<button type="button" class="btn quiet" hx-get={ backURL } hx-target="#calv5-wizard-root" hx-swap="outerHTML">
				Back
			</button>
			<span class="sp" style="flex:1"></span>
			<i id="calv5-review-spinner" class="fa-solid fa-spinner fa-spin htmx-indicator" aria-hidden="true"></i>
			<button id="calv5-review-submit" type="submit" class="btn primary" x-bind:disabled="!followsReal && (!m || !d)">
				Create calendar
			</button>
		</div>
	</form>
}

// wizardBuildXData is the "Build your own" step's entire Alpine x-data
// object literal: sensible starting defaults (12 months, 7 weekdays, one
// moon, one era) plus the add/remove/reorder/serialize methods its buttons
// call. It is pure client-side state — HTMX only ever sees buildJSON()'s
// output, in the hidden import_json field wizardBuildBody renders — so there
// is no server-side mirror of this shape to keep in sync; WizardBuildPreview
// re-validates whatever buildJSON() produced exactly like an uploaded
// file's structure (parseWizardImportJSON — see that function and
// WizardBuildPreview's own doc comments).
//
// The default months/weekdays/moon are JSON-marshaled (so their string
// fields are correctly quoted/escaped) and spliced into an otherwise-static
// JS object-literal template; JSON syntax is a valid subset of JS object/
// array literal syntax, so the result is one ordinary Alpine x-data
// expression, no different in kind from jsMonthDayCounts' array literal
// above — just larger. Numbers are parsed defensively (parseInt/parseFloat
// with a fallback) in buildJSON so a field the owner left blank or typed
// text into still serializes to something clampCalendarStructure can clamp,
// rather than a literal NaN reaching the server.
func wizardBuildXData() string {
	months := make([]map[string]any, 12)
	for i := range months {
		months[i] = map[string]any{"name": fmt.Sprintf("Month %d", i+1), "days": 30, "leap": 0}
	}
	weekdays := make([]map[string]any, 7)
	for i := range weekdays {
		weekdays[i] = map[string]any{"name": fmt.Sprintf("Day %d", i+1)}
	}
	moons := []map[string]any{{"name": "Moon", "cycle": 29.5}}
	monthsJSON, _ := json.Marshal(months)
	weekdaysJSON, _ := json.Marshal(weekdays)
	moonsJSON, _ := json.Marshal(moons)

	return fmt.Sprintf(`{
months: %s,
weekdays: %s,
moons: %s,
leapOn: false,
leapEvery: 4,
eraName: 'Age 1',
eraYear: 1,
addMonth(){ this.months.push({name:'Month '+(this.months.length+1), days:30, leap:0}); },
removeMonth(i){ if(this.months.length>1){ this.months.splice(i,1); } },
moveMonth(i,dir){ var j=i+dir; if(j<0||j>=this.months.length) return; var t=this.months.splice(i,1)[0]; this.months.splice(j,0,t); },
addWeekday(){ this.weekdays.push({name:'Day '+(this.weekdays.length+1)}); },
removeWeekday(i){ if(this.weekdays.length>1){ this.weekdays.splice(i,1); } },
moveWeekday(i,dir){ var j=i+dir; if(j<0||j>=this.weekdays.length) return; var t=this.weekdays.splice(i,1)[0]; this.weekdays.splice(j,0,t); },
addMoon(){ this.moons.push({name:'Moon '+(this.moons.length+1), cycle:29.5}); },
removeMoon(i){ this.moons.splice(i,1); },
buildJSON(){
  var months=this.months.map(function(mo,i){ return {name:(mo.name||('Month '+(i+1))), days:Math.max(1,parseInt(mo.days,10)||1), sort_order:i, is_intercalary:false, leap_year_days:Math.max(0,parseInt(mo.leap,10)||0)}; });
  var weekdays=this.weekdays.map(function(w,i){ return {name:(w.name||('Day '+(i+1))), sort_order:i, is_rest_day:false}; });
  var moons=this.moons.map(function(mo){ return {name:(mo.name||'Moon'), cycle_days:(parseFloat(mo.cycle)||29.5), phase_offset:0, color:'#c0c0c0'}; });
  var eras=this.eraName?[{name:this.eraName, start_year:(parseInt(this.eraYear,10)||1), start_month:1, start_day:1, color:'#6366f1'}]:[];
  var year=parseInt(this.eraYear,10)||1;
  return JSON.stringify({format:'built', calendar_name:'My calendar', months:months, weekdays:weekdays, moons:moons, seasons:[], eras:eras,
    settings:{mode:'fantasy', current_year:year, hours_per_day:24, minutes_per_hour:60, seconds_per_minute:60, leap_year_every:(this.leapOn?(parseInt(this.leapEvery,10)||0):0), leap_year_offset:0},
    today:{year:year}});
}
}`, monthsJSON, weekdaysJSON, moonsJSON)
}

// wizardBuildBody is the "Build your own" structure editor: months,
// weekdays, an optional leap rule, optional moons and a single era, each
// with sensible starting defaults the owner is expected to rename/reshape.
// Simplified from the signed structure editor's look to what this wizard
// needs: no drag-and-drop (up/down
// buttons reorder instead), no color pickers or per-moon render params —
// this step only ever produces an ImportResult, and CreateCalendarFromImport
// fills in every cosmetic default (color, etc.) the same way an import with
// none of its own would. "Continue" hands the built structure to the
// existing Review step (WizardBuildPreview), exactly like a parsed upload
// does. formError is set only by WizardBuildPreview's failure branch (see
// its own doc comment for why that path is realistically unreached by a
// normal session) and, unlike every other step's formError, cannot redisplay
// the owner's in-progress edits — the editor restarts from its own defaults.
templ wizardBuildBody(campaignID, csrfToken, formError string) {
	<h2 class="calv5-wz-h">Build your own</h2>
	<p class="calv5-wz-lead">Set this calendar's months, weekdays, an optional leap rule, moons and era. Everything here can be changed again later.</p>
	if formError != "" {
		<p class="calv5-err">{ formError }</p>
	}
	<form
		hx-post={ fmt.Sprintf("/campaigns/%s/calendars/wizard/build/preview", campaignID) }
		hx-target="#calv5-wizard-root"
		hx-swap="outerHTML"
		hx-encoding="multipart/form-data"
		hx-disabled-elt="#calv5-build-submit"
		hx-indicator="#calv5-build-spinner"
		x-data={ wizardBuildXData() }
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="import_json" x-bind:value="buildJSON()"/>
		<div class="calv5-bsec">
			<h4>Months</h4>
			<div class="calv5-blist">
				<template x-for="(mo, i) in months" x-bind:key="i">
					<div class="calv5-brow">
						<input type="text" class="nm" x-model="mo.name" placeholder="Name" maxlength="100"/>
						<input type="number" class="num" x-model.number="mo.days" min="1" max="3660" placeholder="Days"/>
						<input type="number" class="num" x-model.number="mo.leap" min="0" max="30" placeholder="Leap days"/>
						<button type="button" class="mini" @click="moveMonth(i,-1)" x-bind:disabled="i===0">Up</button>
						<button type="button" class="mini" @click="moveMonth(i,1)" x-bind:disabled="i===months.length-1">Down</button>
						<button type="button" class="mini" @click="removeMonth(i)" x-bind:disabled="months.length<=1">Remove</button>
					</div>
				</template>
			</div>
			<button type="button" class="btn sm quiet" @click="addMonth()" x-bind:disabled="months.length>=60">Add month</button>
		</div>
		<div class="calv5-bsec">
			<h4>Weekdays</h4>
			<div class="calv5-blist">
				<template x-for="(w, i) in weekdays" x-bind:key="i">
					<div class="calv5-brow">
						<input type="text" class="nm" x-model="w.name" placeholder="Name" maxlength="100"/>
						<button type="button" class="mini" @click="moveWeekday(i,-1)" x-bind:disabled="i===0">Up</button>
						<button type="button" class="mini" @click="moveWeekday(i,1)" x-bind:disabled="i===weekdays.length-1">Down</button>
						<button type="button" class="mini" @click="removeWeekday(i)" x-bind:disabled="weekdays.length<=1">Remove</button>
					</div>
				</template>
			</div>
			<button type="button" class="btn sm quiet" @click="addWeekday()" x-bind:disabled="weekdays.length>=30">Add weekday</button>
		</div>
		<div class="calv5-bsec">
			<h4>Leap rule</h4>
			<label class="calv5-toggle-row">
				<input type="checkbox" x-model="leapOn"/>
				<span>Leap years</span>
			</label>
			<div class="calv5-rv-date" x-show="leapOn" x-cloak>
				<label class="calv5-fld">
					<span>Every N years</span>
					<input class="calv5-inp" type="number" x-model.number="leapEvery" min="2" max="1000"/>
				</label>
			</div>
			<p class="calv5-wz-lead" style="margin-top:6px">Give a month above a "Leap days" value to say what a leap year adds.</p>
		</div>
		<div class="calv5-bsec">
			<h4>Moons</h4>
			<div class="calv5-blist">
				<template x-for="(mo, i) in moons" x-bind:key="i">
					<div class="calv5-brow">
						<input type="text" class="nm" x-model="mo.name" placeholder="Name" maxlength="100"/>
						<input type="number" class="num" x-model.number="mo.cycle" min="1" max="3660" step="0.1" placeholder="Cycle days"/>
						<button type="button" class="mini" @click="removeMoon(i)">Remove</button>
					</div>
				</template>
			</div>
			<button type="button" class="btn sm quiet" @click="addMoon()" x-bind:disabled="moons.length>=20">Add moon</button>
		</div>
		<div class="calv5-bsec">
			<h4>Era</h4>
			<div class="calv5-rv-date">
				<label class="calv5-fld">
					<span>Era name</span>
					<input class="calv5-inp" type="text" x-model="eraName" maxlength="100"/>
				</label>
				<label class="calv5-fld">
					<span>Starting year</span>
					<input class="calv5-inp" type="number" x-model.number="eraYear"/>
				</label>
			</div>
		</div>
		<div style="margin-top:18px;display:flex;gap:8px;align-items:center">
			<button
				type="button"
				class="btn quiet"
				hx-get={ fmt.Sprintf("/campaigns/%s/calendars/wizard", campaignID) }
				hx-target="#calv5-wizard-root"
				hx-swap="outerHTML"
			>
				Back
			</button>
			<span class="sp" style="flex:1"></span>
			<i id="calv5-build-spinner" class="fa-solid fa-spinner fa-spin htmx-indicator" aria-hidden="true"></i>
			<button id="calv5-build-submit" type="submit" class="btn primary">Continue</button>
		</div>
	</form>
}
