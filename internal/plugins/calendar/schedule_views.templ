// schedule_views.templ — the five surfaces' markup (C-CALV4-RSVP-P8 Part B).
//
// EVERY PANEL IS THE SAME SHAPE: the signed `.lhead` band verbatim, then the
// chip row beneath it, then `.sc-body` carrying the padding. `.lhead` is reused
// UNCHANGED and `.sc-body` exists precisely so this surface never has to
// redefine it — see the rename note at the top of schedule.go.
//
// THERE IS NO `if IsGM` IN THIS FILE, and that is deliberate rather than an
// omission. A player's ScheduleData carries no member lane, no out column, no
// Director control and no `needs backend` chip, so every loop below simply has
// nothing to walk. A permission expressed as a template branch is one refactor
// away from being lost; a permission expressed as an empty slice cannot be.
package calendar

// scheduleCaptionView draws one caption paragraph WITH the drawing's emphasis.
//
// ONE BLOCK, ALWAYS — the mockup's own producers return one joined string, and a
// caption split across sibling blocks reads as several unrelated notes rather
// than as one key to one instrument.
//
// The runs are TEXT, escaped exactly as every other string on this page is: the
// emphasis rides as a field beside the words and never as markup inside them, so
// no caption can ever become an injection site by someone later making it
// data-driven.
templ scheduleCaptionView(c ScheduleCaption) {
	if len(c) > 0 {
		<div class="caption">
			for _, r := range c {
				if r.Em == "b" {
					<b>{ r.Text }</b>
				} else if r.Em == "i" {
					<i>{ r.Text }</i>
				} else {
					{ r.Text }
				}
			}
		</div>
	}
}

// scheduleVerdictView is S1 · THE VERDICT.
templ scheduleVerdictView(data ScheduleData) {
	<section class="sc-verdict sc-panel surf" data-schedule-verdict>
		<div class="lhead">
			<span class="t">{ data.Verdict.Title }</span>
			<span class="c">{ data.Verdict.Frame }</span>
			<span class="sp"></span>
			<span class="c">{ data.Verdict.Mode }</span>
		</div>
		@scheduleChipRow(data.Verdict.Chips)
		<div class="sc-body">
			<div class="sc-head">
				<div class="col">
					<div class="hl">
						{ data.Verdict.Headline }
						if data.Verdict.HeadlineZone != "" {
							<span class="z" title={ data.Verdict.HeadlineTitle }>{ data.Verdict.HeadlineZone }</span>
						}
					</div>
					if data.Verdict.Rec != "" {
						<div class="rec">{ data.Verdict.Rec }</div>
					}
					if data.Verdict.WarnLine != "" {
						<div class={ "rec", scheduleToneClass(data.Verdict.WarnTone) }>{ data.Verdict.WarnLine }</div>
					}
					if data.Verdict.MailLine != "" {
						<div class="rec mute">{ data.Verdict.MailLine }</div>
					}
				</div>
				if data.Verdict.Propose != nil || data.Verdict.Ask != nil {
					// ONE `.btns` ROW. The page's single filled control lives
					// here and is bound to the chosen window, because the single
					// filled control IS the answer.
					<div class="btns">
						if data.Verdict.Propose != nil {
							@benchActionView(*data.Verdict.Propose)
						}
						if data.Verdict.Ask != nil {
							@benchAskFormView(data.Verdict.Ask)
						}
					</div>
				}
			</div>
			@scheduleCandidatesView(data.Verdict)
			if data.Verdict.MoreLabel != "" {
				<button class="btn ghost sc-more" type="button" popovertarget={ data.Verdict.MoreID }>
					{ data.Verdict.MoreLabel }
				</button>
				@scheduleMorePopView(data.Verdict)
			}
			@scheduleCaptionView(data.Verdict.Caption)
		</div>
	</section>
}

// scheduleCandidatesView draws the ranked cards, or the signed refusal row that
// replaces them. THE INSTRUMENT DOES NOT VANISH: no fabricated card, no zeros,
// no em-dashes standing in for data.
templ scheduleCandidatesView(v ScheduleVerdict) {
	<div class="sc-cands" data-region="cands">
		if v.Fault != nil {
			<div class="calrow warnrow">
				<span class="sc-rk"></span>
				<span class="sc-when">
					<span class="fault">{ v.Fault.Headline }</span>
					<span class="sc-why fault-dt">{ v.Fault.Detail }</span>
				</span>
				<span class="sp"></span>
				if v.Fault.Chip != "" {
					<span class="badge need">{ v.Fault.Chip }</span>
				}
			</div>
		}
		for _, c := range v.Candidates {
			@scheduleCandidateView(c)
		}
	</div>
}

// scheduleCandidateView is one ranked window card.
//
// The card is a LINK carrying the whole page state with `cand` overridden, so
// choosing a window reloads the same three cards in the same three places with a
// different numeral inked. No card ever moves.
templ scheduleCandidateView(c ScheduleCandidate) {
	<a
		class={ "calrow", "surf", "act", templ.KV("sel", c.Selected) }
		href={ templ.SafeURL(c.Href) }
		data-day={ c.DayKey }
		if c.Selected {
			aria-current="true"
		}
	>
		<span class="sc-rk">
			{ scheduleItoa(c.Rank) }
			<i>rank</i>
		</span>
		<span class="sc-when">
			<span class="nm">
				{ c.When }
				if c.Zone != "" {
					<span class="z">{ c.Zone }</span>
				}
			</span>
			<span class="sc-why">{ c.Why }</span>
		</span>
		<span class="sp"></span>
		<span class="sc-tally">
			<b>{ c.TallyFree }</b>
			<i>{ c.TallyPrefer }</i>
		</span>
		if c.EveryoneFree || len(c.Outs) > 0 || len(c.Unknowns) > 0 {
			<span class="sc-outs">
				if c.EveryoneFree {
					<span class="cap">out</span>
					<em>everyone free</em>
				}
				if len(c.Outs) > 0 {
					<span class="cap">out</span>
					for _, s := range c.Outs {
						@scheduleStampView(s)
					}
					if c.OutsExtra > 0 {
						<span>{ "+" + scheduleItoa(c.OutsExtra) }</span>
					}
				}
				if len(c.Unknowns) > 0 {
					<span class="cap">no answer</span>
					for _, s := range c.Unknowns {
						@scheduleStampView(s)
					}
					if c.UnknownsExtra > 0 {
						<span>{ "+" + scheduleItoa(c.UnknownsExtra) }</span>
					}
				}
			</span>
		}
		<span class="ar">&rarr;</span>
	</a>
}

// scheduleStampView is one member's swatch + initials in the out column. A
// HOLLOW swatch means "never answered", which is not the same fact as "out".
templ scheduleStampView(s ScheduleStamp) {
	if s.Hollow {
		<span class="swatch hollow"></span>
		<span class="tok">{ s.Token }</span>
	} else {
		<span class={ "swatch", s.Pattern } style={ benchAxisStyle(s.Axis) }></span>
		<span class="tok" style={ benchAxisStyle(s.Axis) }>{ s.Token }</span>
	}
}

// scheduleMorePopView is the lower-scoring tail. Ordered BY DATE with the score
// on the right — a list ordered by score would put the ranking's own tail in a
// second, competing order.
templ scheduleMorePopView(v ScheduleVerdict) {
	<div popover id={ v.MoreID } class="sc-pop">
		<div class="pop-bar"></div>
		<div class="pop-h">Lower-scoring windows</div>
		for _, r := range v.More {
			<div class="pop-r">
				{ r.When }
				<span class="sp"></span>
				<span class="mt">{ r.Score }</span>
			</div>
		}
		<div class="pop-f">ordered by date, not by score — the score is the number on the right</div>
	</div>
}

// scheduleMatrixView is S2 · THE MATRIX.
templ scheduleMatrixView(data ScheduleData) {
	<section class="sc-matrix sc-panel surf" data-schedule-matrix>
		<div class="lhead">
			<span class="t">{ data.Matrix.Title }</span>
			<span class="c">{ data.Matrix.Frame }</span>
			<span class="sp"></span>
			<span class="c">{ data.Matrix.Scope }</span>
		</div>
		@scheduleChipRow(data.Matrix.Chips)
		<div class="sc-body">
			if len(data.Matrix.Cols) > 0 {
				<div class="sc-wrap">
					<div class="sc-grid" data-region="grid" style={ scheduleGridStyle(len(data.Matrix.Cols)) }>
						<div class="sc-head-row">
							<span class="who"><span class="cap">{ data.Matrix.IdentCap }</span></span>
							for _, c := range data.Matrix.Cols {
								<span class={ "hd", templ.KV("major", c.Major) }>
									{ c.Head }
									if c.Sub != "" {
										<span class="dnum">{ " " + c.Sub }</span>
									}
								</span>
							}
							<span class="say"><span class="cap">{ data.Matrix.SayCap }</span></span>
						</div>
						for _, l := range data.Matrix.Lanes {
							@scheduleLaneView(l)
						}
						@scheduleDensityView(data.Matrix)
						@scheduleCountView(data.Matrix)
						@scheduleBracketView(data.Matrix)
					</div>
				</div>
			}
			if data.Matrix.Zero != "" {
				<div class="lzero">{ data.Matrix.Zero }</div>
			}
				@scheduleCaptionView(data.Matrix.Caption)
		</div>
		for _, p := range data.Matrix.Pops {
			@schedulePopView(p)
		}
	</section>
}

// scheduleLaneView is one member's row. FIXED HEIGHT, ALWAYS: six offered
// windows do not make a lane taller — overflow goes to a popover. Otherwise one
// new availability entry reflows the matrix, which is motion caused by data.
templ scheduleLaneView(l ScheduleLane) {
	<div class="sc-row" style={ benchAxisStyle(l.Axis) } data-schedule-lane>
		<span class="who">
			<span class={ "swatch", l.Pattern } style={ benchAxisStyle(l.Axis) }></span>
			<span class="tok">{ l.Token }</span>
			<span class="nm">{ l.Name }</span>
		</span>
		if len(l.Cells) > 0 {
			for _, c := range l.Cells {
				@scheduleCellView(c)
			}
		} else {
			<span class="sc-none">
				if l.NoteWarn != "" {
					<span class="badge warn">{ l.NoteWarn }</span>
				}
				{ l.Note }
				for _, ch := range l.NoteChip {
					<span class="badge need">{ ch.Text }</span>
				}
			</span>
		}
		<span class="say">
			<span class={ "lt", templ.KV("small", l.Antisocial) }>
				{ l.LocalTime }
				if l.NextDay {
					<span class="badge warn tz">+1d</span>
				}
			</span>
			if l.ZoneMissing {
				// AN UNKNOWN, NOT A FAULT — the grey NEED vocabulary, exactly as
				// the drawing emits it. The ROSTER prints the same fact in amber
				// with `Ask →` beside it, and that is the difference: the roster
				// row is asking the campaign to do something, this lane is
				// reporting that a clock cannot be computed. The register follows
				// whether there is a repair attached, never the severity of the
				// word.
				<span class="badge need">no zone</span>
			}
			<span class={ "rs", benchToneClass(l.Tone) }>{ l.Answer }</span>
		</span>
	</div>
}

// scheduleCellView is one matrix cell. THE CELL IS THE TARGET (>=24x24 at every
// width); the outline inside it is a MARK, not a control.
templ scheduleCellView(c ScheduleCell) {
	if c.PopID != "" {
		<button
			class={ "sc-cell", templ.KV("major", c.Major) }
			type="button"
			data-day={ c.DayKey }
			style={ benchAxisStyle(c.Axis) }
			popovertarget={ c.PopID }
			aria-label={ c.Label }
		>
			for _, m := range c.Marks {
				@scheduleMarkView(m)
			}
		</button>
	} else {
		<span
			class={ "sc-cell", templ.KV("major", c.Major) }
			data-day={ c.DayKey }
			style={ benchAxisStyle(c.Axis) }
			aria-label={ c.Label }
		>
			for _, m := range c.Marks {
				@scheduleMarkView(m)
			}
		</span>
	}
}

// scheduleMarkView is the minute-positioned lozenge. The PATTERN rides as a
// class, never as a style: it is the greyscale identity channel, and a channel
// that lives in a style attribute is one CSP tightening from vanishing.
templ scheduleMarkView(m ScheduleMark) {
	<i
		class={ "sc-off", m.Pattern, templ.KV("pref", m.Prefer), templ.KV("rest", m.Rest),
			templ.KV("contl", m.ContLeft), templ.KV("contr", m.ContRight) }
		style={ scheduleMarkStyle(m) }
	></i>
}

// scheduleDensityView is the anonymous aggregate — EVERYONE'S, at every role.
// ONE achromatic bar per column: never a stack, never a heat cell. Each bar's
// own denominator rides in `title`, so opacity is never the only carrier.
templ scheduleDensityView(m ScheduleMatrix) {
	<div class="sc-row dens">
		<span class="who"><span class="cap">free</span></span>
		for _, d := range m.Density {
			<span class={ "sc-cell", templ.KV("major", d.Major) } style={ scheduleDensityStyle(d) } title={ d.Title } data-day={ d.DayKey }>
				<i></i>
			</span>
		}
		<span class="say"></span>
	</div>
}

// scheduleCountView is the exact number, WHERE IT CAN BE READ AS A NUMBER.
//
// Director: each numeral is a button naming who is free and who is missing.
// Player: a plain span — the names are ABSENT from their DOM, not greyed. The
// branch is on PopID, which the builder only ever sets for a Director.
templ scheduleCountView(m ScheduleMatrix) {
	<div class="sc-row cnt">
		<span class="who"><span class="cap">{ m.Denominator }</span></span>
		for _, c := range m.Counts {
			if c.PopID != "" {
				<button
					class={ "sc-cell", templ.KV("major", c.Major), templ.KV("peak", c.Peak) }
					type="button"
					data-day={ c.DayKey }
					popovertarget={ c.PopID }
					aria-label={ c.Label }
				>
					<b>{ scheduleItoa(c.Free) }</b>
					<u>{ c.PeakHour }</u>
				</button>
			} else {
				<span
					class={ "sc-cell", templ.KV("major", c.Major), templ.KV("peak", c.Peak) }
					data-day={ c.DayKey }
					title={ c.Label }
				>
					<b>{ scheduleItoa(c.Free) }</b>
					<u>{ c.PeakHour }</u>
				</span>
			}
		}
		<span class="say">
			for _, ch := range m.CountChip {
				<span class="badge need">{ ch.Text }</span>
			}
		</span>
	</div>
}

// scheduleBracketView draws the derived window's bracket. --accent is legal here
// precisely because it is the TOOL talking, not an event (canon A7).
templ scheduleBracketView(m ScheduleMatrix) {
	if m.Bracket != nil {
		<div class="sc-row br">
			// The bracket is the only EXPLICITLY placed child in this grid, so
			// its two sticky siblings must be placed too or auto-flow drops the
			// SAY end into column 2.
			<span class="who"></span>
			<span class={ "sc-br", templ.KV("human", m.Bracket.Human) } style={ scheduleBracketStyle(m.Bracket) }>
				<b>{ m.Bracket.Label }</b>
			</span>
			<span class="say"></span>
		</div>
	}
}

// schedulePopView is one popover. TOP LAYER, so it escapes the matrix's own
// horizontal scroll container.
templ schedulePopView(p SchedulePop) {
	<div popover id={ p.ID } class="sc-pop" style={ benchAxisStyle(p.Axis) }>
		<div class="pop-bar"></div>
		<div class="pop-h">{ p.Head }</div>
		for _, r := range p.Rows {
			<div class="pop-r">
				{ r.Text }
				if r.Note != "" {
					<span class="mt">{ r.Note }</span>
				}
			</div>
		}
		if p.Foot != "" {
			<div class="pop-f">{ p.Foot }</div>
		}
	</div>
}

// scheduleRosterView is S3 · THE ROSTER.
templ scheduleRosterView(data ScheduleData) {
	<section class="sc-roster sc-panel surf" data-schedule-roster>
		<div class="lhead">
			<span class="t">{ data.Roster.SlotLabel }</span>
			<span class="c">{ data.Roster.Sub }</span>
			<span class="sp"></span>
		</div>
		@scheduleChipRow(data.Roster.Chips)
		<div class="sc-body">
			<div class="mtable" data-region="mtable">
				for _, r := range data.Roster.Rows {
					@scheduleRosterRowView(r)
				}
			</div>
				@scheduleCaptionView(data.Roster.Caption)
		</div>
	</section>
}

// scheduleRosterRowView is one member row.
//
// The `zone not set` + `Ask →` pair STAYS AT EVERY WIDTH — the repair may never
// be the thing that disappears on the smallest screen — and the clock beside it
// is LITERALLY EMPTY rather than a dash or a UTC guess.
templ scheduleRosterRowView(r ScheduleRosterRow) {
	<div class="mrow" data-schedule-roster-row>
		<span class={ "swatch", r.Pattern } style={ benchAxisStyle(r.Axis) }></span>
		<span class="tok" style={ benchAxisStyle(r.Axis) }>{ r.Token }</span>
		<span class="nm">
			<b>{ r.Name }</b>
			if r.Host {
				<span class="ro">(host)</span>
			}
		</span>
		<span class="ro">{ r.Role }</span>
		if r.IsCoDM {
			<span class="badge gm">co-DM</span>
		}
		<span class="sp"></span>
		if r.Zone == "" {
			<span class="badge warn">zone not set</span>
			if r.AskHref != "" {
				<a class="btn xs ghost" href={ templ.SafeURL(r.AskHref) }>Ask →</a>
			}
		} else {
			<span class="badge tz" title={ r.ZoneTitle }>{ r.Zone }</span>
		}
		<span class={ "lt", templ.KV("small", r.Antisocial) }>
			{ r.LocalTime }
			if r.NextDay {
				<span class="badge warn tz">+1d</span>
			}
		</span>
		<span class={ "rs", benchToneClass(r.Tone) }>{ r.Answer }</span>
	</div>
}

// schedulePainterView is S4 · THE PAINTER.
templ schedulePainterView(data ScheduleData) {
	<section class="sc-paint sc-panel surf" data-schedule-painter>
		<div class="lhead">
			<span class="t">{ data.Painter.Title }</span>
			<span class="c">{ data.Painter.Frame }</span>
			<span class="sp"></span>
			if data.Painter.ZoneHref != "" {
				<a class="btn xs ghost" href={ templ.SafeURL(data.Painter.ZoneHref) }>Change your zone →</a>
			}
		</div>
		<div class="sc-body">
			if data.Painter.Fault != nil {
				@scheduleFaultView(*data.Painter.Fault)
			}
			if data.Painter.Form != nil {
				@schedulePaintFormView(*data.Painter.Form)
			}
		</div>
	</section>
}

// schedulePaintFormView is the painted weekly grid and its controls.
//
// PER-CELL TOGGLES ARE THE ONLY PATH. No drag-select, at any width, on any
// surface: a drag gesture cannot be the primary control here, and a "fallback"
// primary is a fiction. The checkbox is the state, the label is the target, and
// the mark inside the label is a mark.
templ schedulePaintFormView(f SchedulePaintForm) {
	<form
		class="sc-paint-form"
		data-region="paint"
		data-schedule-paint
		data-save-url={ f.SaveURL }
		data-exceptions-url={ f.ExceptionsURL }
		data-scope={ f.Scope }
		data-zone={ f.Zone }
	>
		<input type="hidden" name="csrf_token" value={ f.CSRFToken }/>
		<div class="sc-scope">
			@scheduleSegView("What this week's marks mean", f.ScopeOptions)
			<span class="lb">{ f.ScopeNote }</span>
		</div>
		<div class="sc-sum">{ f.Summary }</div>
		<span class="lband">Can play</span>
		@schedulePaintGridView(f, f.Days)
		// THE ONE SANCTIONED OPEN/CLOSE ON THIS PAGE: a section BELOW the grid,
		// on the viewer's own explicit act. Its motion comes from the disclosure
		// register in calendar-bench.css — there is exactly one, product-wide,
		// and this surface does not open a second.
		<details class="sc-pref disc" open?={ f.PrefOpen }>
			<summary>
				<span class="lband">Would prefer</span>
			</summary>
			@schedulePaintGridView(f, f.PrefDays)
			<div class="caption">{ f.PrefNote }</div>
		</details>
		if f.Empty != "" {
			<div class="lzero">{ f.Empty }</div>
		}
		<div class="btns">
			<button class="btn fill" type="button" data-schedule-save>Save my week</button>
			<button class="btn" type="button" data-schedule-clear>Clear this week</button>
			if f.CopyWeek != nil {
				@benchActionView(*f.CopyWeek)
			}
		</div>
		<div class="sc-status" data-schedule-status role="status" aria-live="polite"></div>
		<div class="sc-foot">{ f.Foot }</div>
		if f.Reserve != nil {
			<div class="skyband">
				<span class="a">{ f.Reserve.Head }</span>
				<span class="b">{ f.Reserve.Body }</span>
			</div>
		}
	</form>
}

// schedulePaintGridView draws one painted grid — days down, the band's hours
// across, at the SAME geometry as the matrix above, so what you paint is
// literally what the Director reads.
templ schedulePaintGridView(f SchedulePaintForm, days []SchedulePaintDay) {
	<div class="sc-wrap">
		<div class="sc-grid sc-paintgrid" style={ schedulePaintGridStyle(len(f.Hours)) }>
			<div class="sc-head-row">
				<span class="who"><span class="cap">{ f.WeekLabel }</span></span>
				for _, h := range f.Hours {
					<span class={ "hd", templ.KV("major", h.Major) }>{ h.Label }</span>
				}
				<span class="say"></span>
			</div>
			for _, d := range days {
				<div class="sc-row" style={ benchAxisStyle(f.Axis) } data-day={ d.DayKey } data-weekday={ scheduleItoa(d.Weekday) }>
					<span class="who">
						<span class={ "swatch", f.Pattern } style={ benchAxisStyle(f.Axis) }></span>
						<span class="nm">{ d.Label }</span>
					</span>
					for _, c := range d.Cells {
						@schedulePaintCellView(c, f.Pattern)
					}
					<span class="say"></span>
				</div>
			}
		</div>
	</div>
}

// schedulePaintCellView is one hour tick.
templ schedulePaintCellView(c SchedulePaintCell, pattern string) {
	<input
		type="checkbox"
		class="sc-pick"
		id={ c.ID }
		name={ c.Name }
		value={ c.Value }
		data-day={ c.DayKey }
		data-hour={ scheduleItoa(c.Hour) }
		checked?={ c.Checked }
	/>
	<label class={ "sc-pk", templ.KV("major", c.Major) } for={ c.ID } data-day={ c.DayKey }>
		<i class={ "sc-off", pattern }></i>
		<span class="vh">{ c.Label }</span>
	</label>
}

// scheduleFaultView is the `.sc-faultbox`: a NAMED, REPAIRABLE refusal drawn
// where a body would be. Never a dashed reserve — dashed means "not built yet"
// and only that.
templ scheduleFaultView(f ScheduleFault) {
	<div class="sc-faultbox" data-schedule-fault>
		<div class="fault">{ f.Headline }</div>
		<div class="dt">{ f.Detail }</div>
	</div>
}

// scheduleAnswerView is S5 · THE ANSWER, in its two role shapes.
templ scheduleAnswerView(data ScheduleData) {
	<section class="sc-answer sc-panel surf" data-schedule-answer>
		<div class="lhead">
			<span class="t">{ data.Answer.Title }</span>
			<span class="c">{ data.Answer.Sub }</span>
			if data.Answer.Unanswered {
				<span class="badge warn">you haven&rsquo;t answered</span>
			}
			<span class="sp"></span>
		</div>
		@scheduleChipRow(data.Answer.Chips)
		<div class="sc-body">
			if data.Answer.Headline != "" {
				<div class={ "sc-you", scheduleInkClass(data.Answer.HeadlineTone) }>{ data.Answer.Headline }</div>
			}
			if data.Answer.Form != nil {
				@scheduleAnswerFormView(*data.Answer.Form)
			}
			if data.Answer.Director {
				<div class="mtable" data-region="mtable">
					for _, r := range data.Answer.Rows {
						@scheduleAnswerRowView(r, false)
					}
				</div>
				if len(data.Answer.Awaiting) > 0 {
					<span class="lband">Awaiting reply</span>
					for _, r := range data.Answer.Awaiting {
						@scheduleAnswerRowView(r, true)
					}
				}
			}
				@scheduleCaptionView(data.Answer.Caption)
			if data.Answer.Foot != "" {
				<div class="sc-foot">{ data.Answer.Foot }</div>
			}
		</div>
	</section>
}

// scheduleAnswerFormView is the player's tri-state.
//
// WORDS, NEVER GLYPHS, and it posts to the EXISTING Player+ RSVP route as a
// form — the same shape P8A gave the Bench's session tile, which is why this
// slice adds no answer route. The CSRF token rides as a hidden field:
// internal/middleware/csrf.go accepts either the header or the field, and this
// path is not under /api/.
templ scheduleAnswerFormView(f ScheduleAnswerForm) {
	<form class="sc-arow" method="post" action={ templ.SafeURL(f.Action) }>
		<input type="hidden" name="csrf_token" value={ f.CSRFToken }/>
		<div class="seg lg" role="group" aria-label="Your answer">
			for _, o := range f.Options {
				<button type="submit" name="status" value={ o.Value } aria-pressed={ scheduleBool(o.Pressed) }>
					{ o.Label }
				</button>
			}
		</div>
		if f.OutWeekPopID != "" {
			<button class="btn" type="button" popovertarget={ f.OutWeekPopID }>Out just this week</button>
		}
		if f.SuggestHref != "" {
			<a class="btn ghost" href={ templ.SafeURL(f.SuggestHref) }>Suggest a better time</a>
		}
	</form>
	if f.OutWeekPopID != "" {
		// THE CONFIRM POPOVER — the same GET-confirm hygiene the token flow has,
		// and it is here because this control writes TWO things and the reader is
		// entitled to know both before it does either.
		<div popover id={ f.OutWeekPopID } class="sc-pop">
			<div class="pop-bar"></div>
			<div class="pop-h">Out this week?</div>
			<div class="pop-r">records your RSVP as <b>no</b></div>
			<div class="pop-r">marks you unavailable for this whole real-world week</div>
			<div class="pop-r">
				<span class="mt">days you already set by hand are left alone</span>
			</div>
			<div class="pop-f">when the scheduler cannot be reached, only the RSVP is recorded</div>
			<div class="pop-btns">
				<button class="btn xs fill" type="button" data-schedule-outweek>Confirm</button>
				<button
					class="btn xs ghost"
					type="button"
					popovertarget={ f.OutWeekPopID }
					popovertargetaction="hide"
				>Cancel</button>
			</div>
		</div>
	}
	if f.SuggestOpen {
		// THE SUGGEST DOCK. It records the answer as MAYBE, never yes and never
		// no, because a note without a status would otherwise be counted as a
		// decision the member did not make.
		<div class="sc-suggest">
			<form method="post" action={ templ.SafeURL(f.Action) }>
				<input type="hidden" name="csrf_token" value={ f.CSRFToken }/>
				<input type="hidden" name="status" value="maybe"/>
				<textarea name="note" maxlength="500" placeholder="Sunday after 20:00 would work better."></textarea>
				<div class="sc-foot">{ f.SuggestNote }</div>
				<button class="btn fill" type="submit">Send suggestion</button>
			</form>
		</div>
	}
}

// scheduleAnswerRowView is one responder row on the Director's half.
templ scheduleAnswerRowView(r ScheduleRosterRow, ask bool) {
	<div class="mrow" data-schedule-answer-row>
		<span class={ "swatch", r.Pattern } style={ benchAxisStyle(r.Axis) }></span>
		<span class="tok" style={ benchAxisStyle(r.Axis) }>{ r.Token }</span>
		<span class="nm">{ r.Name }</span>
		<span class={ "rs", benchToneClass(r.Tone) }>{ r.Answer }</span>
		<span class="sp"></span>
		if ask && r.AskHref != "" {
			<a class="btn xs ghost" href={ templ.SafeURL(r.AskHref) }>Ask →</a>
		}
	</div>
}
