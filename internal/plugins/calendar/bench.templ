// bench.templ — THE BENCH's markup (calendar-v4 wave 1, phase B).
//
// THE CONTRACT'S DOM ORDER, EXACTLY (mockups/calendar-v4.html ?view=dashboard):
//
//	.phead
//	ribbon()          six tiles for a GM, THREE for a player
//	.sechead "The bench"
//	.stack            primary Block, then the real-world Block (noShelf)
//	rsvpPanel()
//	nextUp()
//	.rowgrid          subordinate rows, the GM-only warnrow, the New slot
//	.caption
//
// popovers() has no subject in wave 1 and is therefore not emitted: the signed
// Bench's popovers are the BLOCK's own per-day hidden-event and overflow
// panels, and the shipped Block emits neither (calendar_block has no popover
// invoker — the switchboard popover is W-F and the day ANSWER is W-B). A Bench
// that emitted them would be shipping orphan DOM keyed to invokers that do not
// exist. When the Block grows them, they arrive inside the Block, where their
// invokers are.
//
// MOTION — AND THE ONE PLACE IT NOW LIVES. COMMON §6.5 is unchanged INSIDE the
// Block: no transitions there, at all, in wave 1, and this slice touched no file
// under internal/widgets/calendar_block/. The Bench's own chrome no longer keeps
// that discipline absolutely, and this header used to say it did.
//
// C-CALV4-BENCH-R2 [BR2-2] SIGNED opened a THREE-PROPERTY ALLOWLIST for the
// disclosures this file emits: calendar-bench.css transitions `block-size`,
// `opacity` and `content-visibility` on `.cal-bench .disc::details-content`,
// once, inside a single `@media (prefers-reduced-motion: no-preference)` block,
// with --disc-open 200ms and --disc-close 160ms (close always faster than open)
// and zero @keyframes. Under reduced motion there is no rule at all, so the
// reveal is instant and complete. The signed law is
// decisions/2026-07-29-motion-disclosure-register.md.
//
// C-CALV4-DAYCARD slice R2-2a CONSUMES that register rather than opening a
// second one ([DC-6] SIGNED, resolved by the first-lander clause): the day card
// this file now mounts transitions `block-size` and `opacity` on
// `.cal-bench .cal-daycard .dcbox`, inside the SAME single no-preference
// wrapper, on the SAME two durations and the SAME easing. It declares no token
// and no grammar of its own — a surface that wanted a different feel would be
// asking to leave the register, which is a signature and not a tuning.
//
// THE ENFORCEMENT IS A TEST, AND ONLY A TEST. bench_test.go's
// TestBenchCSS_NoMotionAtAll was INVERTED from a blanket ban into that
// allowlist (it keeps its wave-1 name so a reader who greps for the old rule
// lands on the document that changed it). Nothing in CI backs it up:
// tools/check-v2-motion-discipline.sh does not police static/css/ at all — its
// scope is internal/plugins/{calendar,timeline,ai_workspace,campaigns}. Widening
// the allowlist therefore widens everything, which is why
// TestBenchProse_MotionClaimsMatchTheSheet pins these two paragraphs to the
// sheet rather than trusting them.

package calendar

import (
	"fmt"
	"strings"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	calblock "github.com/keyxmakerx/chronicle/internal/widgets/calendar_block"
)

// BenchPage renders the full Bench at GET /campaigns/:id/apps/calendar.
templ BenchPage(cc *campaigns.CampaignContext, data BenchData) {
	@layouts.App("Calendar") {
		// THE DAY CARD'S PAYLOAD rides this wrapper (C-CALV4-DAYCARD, R2-2a,
		// [DC-1] SIGNED). One page attribute, built in Go from the same
		// viewer-filtered BlockData the Blocks below render from — the shipped
		// house precedent (event_grid.js:137 reads dataset.calV2Events the same
		// way) and NO new authorisation surface, because it is a
		// re-serialisation of what this viewer's page already carries. Absent
		// entirely when there is no Block: see BenchData.DayCardJSON.
		<div
			class="cal-bench"
			data-cal-bench
			data-cal-dashboard
			if data.DayCardJSON != "" {
				data-cal-daycard-payload={ data.DayCardJSON }
			}
		>
			<link rel="stylesheet" href={ layouts.AssetURL("/static/css/calendar-bench.css") }/>
			if data.DayCardJSON != "" {
				<link rel="stylesheet" href={ layouts.AssetURL("/static/css/calendar-daycard.css") }/>
			}
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: fmt.Sprintf("/campaigns/%s", cc.Campaign.ID), Icon: "fa-dice-d20"},
				{Label: "Apps", Href: fmt.Sprintf("/campaigns/%s/extensions", cc.Campaign.ID)},
				{Label: "Calendars"},
			})
			// THE SURFACE IS ITS OWN ELEMENT (C-CALV4-BENCH-R2 slice R2-1,
			// [BR2-4] SIGNED Option C). It exists so that at ≤640px the
			// surface's children can become a flex column and CSS `order` can
			// lift the calendar above the ribbon — the only mechanism that
			// literally puts the calendar first on a phone with no state, no
			// script and no attribute. `.cal-bench` itself could not be that
			// container: it also holds the stylesheet link and the breadcrumbs,
			// and reordering against those would move the page's own nav.
			<div class="bsurf" data-bench-surface>
				@benchSurface(data)
			</div>
			// THE DAY CARD, mounted ONCE, as a sibling of the surface and
			// OUTSIDE every .cal-block-host (C-CALV4-DAYCARD, R2-2a, [DC-3]
			// SIGNED). It sits inside .cal-bench on purpose: the register's
			// motion rules live in calendar-bench.css and every prelude there
			// names .cal-bench, so a card mounted outside this element would
			// need a second register sheet — which [DC-6] refuses as
			// laundering. Top-layer promotion does not change DOM ancestry,
			// so the scoping survives the popover.
			if data.DayCardJSON != "" {
				@dayCardScaffold(data.DayCard)
				// THE EDITOR IS SCRIBE+ AND ITS ABSENCE IS THE GATE ([DC-9]
				// SIGNED). A player's page contains no editor scaffold at all —
				// no field names, no route strings, no disabled control, no
				// title explaining anything. The card above still mounts for
				// them, because READING A DAY IS A PLAYER AFFORDANCE.
				if data.DayCard.CanCreate {
					@dayCardEditor(data.DayCard)
				}
			}
		</div>
		// W5b: the per-calendar permissions editor. Owners only — players never
		// receive the editor DOM nor the PUT route. Retained verbatim from the
		// card grid this surface replaces: the Bench moved the trigger onto the
		// Block's management strip and the subordinate rows, and the modal +
		// its driver are unchanged.
		//
		// THE THREE DRIVERS THAT USED TO MOUNT HERE ARE GONE FROM THIS FILE AND
		// THAT IS THE HOTFIX. cal_visibility.js, calendar_permissions.js and
		// calendar_daycard.js were `<script src>` tags at this point in the
		// page — i.e. INSIDE `@layouts.App{ children... }`, and app.templ puts
		// `{children...}` inside `<main id="main-content">`. The sidebar's addon
		// links are `hx-boost="true" hx-select="#main-content"`, and boot.js
		// sets `htmx.config.allowScriptTags = false`, which makes htmx not
		// merely skip but DELETE every <script> in the swapped fragment. So a
		// direct page load wired the day card and the Permissions button, and
		// REACHING THE SAME PAGE THROUGH THE SIDEBAR SILENTLY DID NOT: the
		// stylesheets in the same region survived, so the page looked perfect
		// and the day card simply never opened.
		//
		// They now ride the plugin BODY-SCRIPT REGISTRY (routes.go's
		// pluginBodyScripts → layouts.SetPluginBodyScripts → base.templ), which
		// emits them after {children...} — OUTSIDE #main-content, therefore
		// outside the swapped region, therefore present on a boosted navigation
		// exactly as on a full load. All three already re-init on
		// htmx:afterSettle / htmx:load and bail cleanly when their mount is
		// absent, so the registry's unconditional mount costs a page that has no
		// card and no modal precisely nothing. The registry also fixes the
		// ordering the old comment relied on document order for: cal_visibility.js
		// is listed before calendar_permissions.js there, because the latter
		// captures `window.ChronicleCalVisibility` at execution time.
		if data.IsOwner {
			@calendarPermissionsModal()
		}
	}
}

// benchSurface is everything inside the page wrap, in contract order.
templ benchSurface(data BenchData) {
	@benchHead(data)
	if data.LoadError {
		<div class="bench-note" data-cal-dashboard-error>
			<i class="fa-solid fa-circle-info" aria-hidden="true"></i>
			Couldn&#39;t load the calendars right now. Try reloading the page.
		</div>
	} else if data.CalendarCount == 0 {
		@calendarAppDashboardEmpty(data.CampaignID, data.IsOwner)
	} else {
		@benchDisclosureView(benchDisclosureFor(data, "ribbon")) {
			@benchRibbonView(data)
		}
		<div class="sechead">
			<span class="cap">The bench</span>
			<span class="c">{ benchSectionSubtitle(data) }</span>
		</div>
		<div class="stack" data-bench-stack>
			if data.Primary != nil {
				@benchBlockView(*data.Primary, data, "primary")
			}
			if data.RealWorld != nil {
				@benchBlockView(*data.RealWorld, data, "real-world")
			}
		</div>
		@benchDisclosureView(benchDisclosureFor(data, "rsvp")) {
			@benchRsvpView(data)
		}
		@benchDisclosureView(benchDisclosureFor(data, "nextup")) {
			@benchNextUpView(data)
		}
		// THE TRAP, and it is a real one. The pre-existing owner sort control
		// hx-GETs #cal-dash-grid and swaps it. The <details> therefore WRAPS
		// that id FROM OUTSIDE, with .sortrow inside the disclosure body: render
		// it inside and every sort would destroy and recreate the disclosure,
		// snapping the section shut (or open) on each sort and desynchronising
		// the store from the DOM. The sort handler's own fragment template is a
		// wave-0 surface and is NOT touched — a swap replaces the disclosure's
		// contents, never the disclosure.
		@benchDisclosureView(benchDisclosureFor(data, "rows")) {
			@benchRowGridSection(data)
		}
		@benchCaption()
	}
}

// benchDisclosureView is THE disclosure primitive ([BR2-1] SIGNED): native
// <details> + <summary>, and nothing else.
//
// WHY NATIVE, in the order that decides it. (1) It is the only primitive that
// is honest with JavaScript off — the section opens and closes natively and
// only the REMEMBERING needs HTMX, so a viewer with a broken script tag gets a
// working page that forgets, which is the correct degradation and it is free.
// (2) aria-expanded, the disclosure role, keyboard operation and screen-reader
// announcement are native and correct; a hand-rolled <div role="button"> would
// reintroduce the exact class of defect WG-5 already caught once. (3) It
// sidesteps the checkbox trap: copying the Block's hidden-radio + :has() shape
// would re-meet ADR-048 §13's bound (a server-rendered attribute cannot vary by
// container query) for no gain.
//
// THE FLIP RIDES ON THE <details> ITSELF, not on the <summary>. `toggle` does
// not bubble, so the listener has to be on the target; and a click handler on
// the summary would fire BEFORE the state changed, which would invert every
// write.
//
// AND BECAUSE IT RIDES THERE, EVERYTHING IT DECLARES IS INHERITED. htmx
// resolves hx-vals, hx-swap and their siblings by WALKING ANCESTORS — see
// benchDisclosurePersistURL in bench.go for the runtime's own recursion — so
// every control inside a section reads whatever this element carries. That is
// why the section key travels on the POST URL, which is the flipping element's
// own attribute and is inherited by nothing: `hx-vals` here appended
// `section=<key>` to the player's RSVP trio, the owner's `Ask →` form and all
// five sort links (verifier finding 1, R2-1 follow-up). `hx-swap="none"` is
// still declared here and IS inherited — every HTMX control inside a
// disclosure therefore declares its own, and bench_disclosure_test.go asserts
// it rather than trusting it.
//
// No `hx-vals='js:…'` at any price either: it is dead under
// htmx.config.allowEval = false (static/js/boot.js:168) and §12 forbids it.
//
// NO ENDPOINT, NO ATTRIBUTES. An anonymous viewer, or a Bench outside a
// campaign, gets a disclosure that works and forgets rather than a control that
// posts into the void.
//
// GUARD B3: `data-disc-pick` on the <summary> is the CONTROL and ends in
// `-pick`; `data-bench-disc` on the <details> is a STATE MARKER and reuses none
// of STATE_MARKERS' six nouns (data-theme / view / role / colour / moonstyle /
// ready — verified against tools/check-calendar-v4-lints.sh:66).
templ benchDisclosureView(d BenchDisclosure) {
	<details
		class="disc"
		data-bench-disc={ d.Key }
		open?={ !d.Closed }
		if d.PersistURL != "" {
			hx-post={ d.PersistURL }
			hx-trigger="toggle"
			hx-swap="none"
		}
	>
		<summary data-disc-pick={ d.Key }>
			<span class="cap">{ d.Label }</span>
			<span class="c">{ d.Summary }</span>
		</summary>
		{ children... }
	</details>
}

// benchHead is .phead: the title, the count line, and the control cluster.
//
// The signed .ctl carries "colour by: type ⌄", "Builder →" and "+ New event".
// The colour-by axis is a PER-VIEWER PREFERENCE with no store (the Block books
// the same control for the same reason — nameplate.templ), and there is no
// event-create route outside the V2 shell and wave 1 adds no routes. So the
// cluster ships the two doors that exist: the calendar itself, and — for an
// owner — the builder and the new-calendar wizard.
templ benchHead(data BenchData) {
	<div class="phead">
		<div>
			<h1>Calendar</h1>
			<p>{ benchHeadSubtitle(data) }</p>
		</div>
		<span class="sp"></span>
		<div class="ctl">
			// "OPEN CALENDAR →" IS GONE, AND IT IS THE ONE AFFORDANCE R2-4 REMOVES
			// RATHER THAN RE-POINTS (C-CALV4-V2SUNSET, [VS-14] SIGNED).
			//
			// It existed to leave this page for the real calendar. The real
			// calendar is now this page, so re-pointed at /apps/calendar it would
			// have been a link that navigates to itself — and [VS-12] measured
			// that `?calId=` is inert on this handler, so it could not even have
			// selected a different calendar. This is the ONE place [VS-2]'s rule
			// "no link is deleted" is deliberately overridden, and the override
			// is the ruling: a self-link is not a door, it is a dead end wearing
			// a door's label. The Builder → and + New calendar controls beside it
			// are untouched.
			if data.Primary != nil {
				if data.IsOwner {
					<a class="btn ghost" href={ templ.SafeURL(data.Primary.Manage.SettingsHref) }>Builder →</a>
				}
			}
			if data.IsOwner {
				<a class="btn fill" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/calendars/builder", data.CampaignID)) }>+ New calendar</a>
			}
		</div>
	</div>
}

// --- the ribbon -------------------------------------------------------------

// benchRibbonView renders the tiles. Six for a GM, THREE for a player — and the
// three GM tiles are absent from the DOM, not hidden: benchRibbon never builds
// them for a player, so there is nothing here to gate.
templ benchRibbonView(data BenchData) {
	<div class="ribbon" data-bench-ribbon>
		for _, t := range data.Ribbon {
			@benchTileView(t)
		}
	</div>
}

templ benchTileView(t BenchTile) {
	<div class={ benchTileClass(t) } data-bench-tile={ t.Key }>
		<div class="eb">
			<span class="g" aria-hidden="true">{ t.Glyph }</span>
			<span class="cap">{ t.Eyebrow }</span>
			<span class="sp"></span>
			if t.Href != "" {
				<a class="ar" href={ templ.SafeURL(t.Href) } aria-label={ t.Eyebrow }>→</a>
			}
		</div>
		<div class={ "hl", benchToneClass(t.Tone) }>{ t.Headline }</div>
		<div class="ql">
			{ t.Qual }
			if t.NeedsBackend {
				<span class="badge need">needs backend</span>
			}
		</div>
		for _, r := range t.Rows {
			<a class={ "arow", templ.KV("bad", r.Bad) } href={ templ.SafeURL(r.Href) }>{ r.Label }</a>
		}
		if t.RSVPForm != nil {
			@benchRsvpFormView(t.RSVPForm)
		} else if len(t.Actions) > 0 {
			<div class="rsvpb">
				for _, a := range t.Actions {
					@benchActionView(a)
				}
			</div>
		}
		if t.Detail != "" {
			<div class="dt">{ t.Detail }</div>
		}
		if len(t.Ticks) > 0 {
			@benchTickRule(t.Ticks)
		}
	</div>
}

// benchActionView renders a tile control. An action with no Href is INERT —
// rendered so the tile's geometry is final, disabled so it is not a dead
// control that swallows a click (the Block's layersInvoker precedent).
//
// WG-5, ADOPTED PRODUCT-WIDE AND IMPLEMENTED WHERE WAVE 3 ALREADY TOUCHES: an
// inert control carries a VISIBLE `.badge.need`, not a `title` alone. The old
// shape was `title`-only twice and deliberately (here and helpers.go's
// layersInvokerTitle) — and it is independently an a11y defect, because `title`
// is not announced by several screen readers and is unreachable by touch.
//
// The chip's text is the literal "needs backend" and never the specific reason,
// because `.badge.need` is not diluted (§7). The specific reason is carried
// visibly too, by the surrounding surface's `.cap` — so the accessibility rule
// and the non-dilution rule are both satisfied rather than traded against each
// other. A control that carries a chip is GM-tier, since the chip is.
templ benchActionView(a BenchAction) {
	if a.Href != "" {
		<a class={ "btn xs", templ.KV("fill", a.Fill) } href={ templ.SafeURL(a.Href) }>{ a.Label }</a>
	} else if a.NeedsBackend {
		<span class="inert">
			<button type="button" class={ "btn xs", templ.KV("fill", a.Fill) } disabled title={ a.Title }>{ a.Label }</button>
			<span class="badge need">needs backend</span>
		</span>
	} else {
		<button type="button" class={ "btn xs", templ.KV("fill", a.Fill) } disabled title={ a.Title }>{ a.Label }</button>
	}
}

// benchRsvpFormView is the session tile's LIVE trio.
//
// ZERO NEW ROUTES (WG-6). It posts, form-encoded, to the EXISTING Player+ RSVP
// endpoint — same path, same method, same group, same role gate — which is why
// internal/wire/routes_snapshot.txt is byte-identical after this slice. The
// handler answers with this tile re-rendered when the request is HTMX and with
// the unchanged JSON otherwise, so the two existing JSON consumers
// (static/js/availability.js and the Foundry-facing /api/v1 group) are
// untouched.
//
// NO JS IS ADDED TO THE BENCH. hx-* attributes are markup; the sort control on
// this same page already works this way. The CSRF token rides as a hidden
// field because internal/middleware/csrf.go accepts either the X-CSRF-Token
// header or a csrf_token form field, and this path is not under /api/, so it is
// not one of the two the middleware skips.
//
// The trio is IMMUTABLE: three loose .btn.xs, Yes filled, then No, then Maybe.
// The viewer's own answer is stated in the tile's detail line rather than as a
// fourth button state, because a fourth state is a fourth button in disguise.
templ benchRsvpFormView(f *BenchRsvpForm) {
	<form
		class="rsvpb"
		method="post"
		action={ templ.SafeURL(f.Action) }
		hx-post={ f.Action }
		hx-target="[data-bench-tile='session']"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="csrf_token" value={ f.CSRFToken }/>
		for _, o := range f.Options {
			<button type="submit" class={ "btn xs", templ.KV("fill", o.Fill) } name="status" value={ o.Value }>{ o.Label }</button>
		}
	</form>
}

// benchTickRule is the Today tile's month rule. Every tick carries data-day —
// the ANSWER key, emitted in wave 1 and consumed in W-B (guard B4).
templ benchTickRule(ticks []BenchTick) {
	<div class="tick" aria-hidden="true" style={ fmt.Sprintf("--month-len:%d", len(ticks)) }>
		for _, tk := range ticks {
			<i
				class={ "t", templ.KV("ev", tk.Event), templ.KV("now", tk.Today) }
				data-cell={ benchIntAttr(tk.Day) }
				data-day={ tk.DayKey }
				style={ benchTickStyle(tk) }
			></i>
		}
	</div>
}

// --- the stack --------------------------------------------------------------

// benchBlockView is one .stack entry: the Block, then the owner-only management
// strip. The strip is a documented addition — see BenchBlock's doc comment.
templ benchBlockView(b BenchBlock, data BenchData, role string) {
	<div class="benchblock" data-bench-block={ role } data-calendar-id={ b.Manage.CalendarID }>
		@benchNavTrio(b.Nav)
		@benchDateVerbRow(b.Verbs)
		@calblock.Block(b.Data)
		if data.IsOwner {
			@benchManageStrip(b.Manage)
		}
	</div>
}

// benchNavTrio is the month cursor's control (C-CALV4-GAMEREADY [GR-2]).
//
// WHERE IT SEATS, AND WHY IT IS HERE RATHER THAN IN THE NAMEPLATE ITSELF.
// [GR-2] rules the trio onto "the Block's nameplate", beside the date label —
// and the nameplate is `internal/widgets/calendar_block/nameplate.templ`, a
// file this slice's Bounds put out of reach along with the rest of that
// package (`data.go` is byte-pinned at r54 and [SKY-6] is concurrently
// authorised for exactly two fields). The dispatch's own "Files you own" list
// names `bench.templ` as where the trio's markup goes, which is this: the
// Bench's own row, immediately ABOVE `.block` and therefore directly adjacent
// to the nameplate it navigates, inside the same `.benchblock` wrapper the
// owner's management strip already extends downward. Same construction, other
// end.
//
// THREE <a> ELEMENTS. Not buttons, not a form, not JS. The hrefs are computed
// server-side (benchNav) and land on the same route, so a plain navigation —
// or the sidebar's `hx-boost` when the page is reached that way — swaps the
// page with no script of any kind. `boot.js:163` sets
// `htmx.config.allowScriptTags = false`, which DELETES a <script> inside a
// swapped fragment, and any JS would otherwise have to ride the plugin
// body-script registry and answer to tools/check-page-scripts.sh. Links need
// none of that.
//
// A DAY CARD OPEN ACROSS A NAVIGATION IS CLOSED BY THE SWAP, AND THAT IS
// CORRECT — a card describing 12 Marpenoth must not survive into Uktar. There
// is no re-anchoring and no state restoration here, and `placeCard` is not
// opened ([ER-5] SIGNED makes it a flag rather than an edit).
//
// IT REUSES `.manage` AND `.btn.xs`, WHICH ALREADY EXIST. This slice ships no
// stylesheet, so the trio takes the flex row the management strip is already
// styled with; at narrow density it WRAPS on that row's own rules rather than
// earning a fifth breakpoint number (the Block's density switch is
// `@container cal-block` at `min-width: 481px` and is signed territory,
// [SKY-8]).
templ benchNavTrio(n BenchNav) {
	if n.Live {
		<div class="manage" data-bench-nav>
			<span class="badge" data-bench-nav-month>{ benchNavLabel(n) }</span>
			<span class="sp"></span>
			if n.PrevHref != "" {
				<a class="btn xs" data-bench-nav-prev href={ templ.SafeURL(n.PrevHref) } rel="prev">‹ Prev</a>
			}
			// `Today` renders on the current month too, where it is a no-op
			// link back to the bare route. A control that vanishes when you are
			// already there teaches the GM that it is missing, not satisfied.
			<a class="btn xs" data-bench-nav-today href={ templ.SafeURL(n.TodayHref) }>Today</a>
			<a class="btn xs" data-bench-nav-next href={ templ.SafeURL(n.NextHref) } rel="next">Next ›</a>
		</div>
	}
}

// benchDateVerbRow is §2's date-verb surface (C-CALV4-GAMEREADY [GR-SIGN-A]
// SIGNED, [GR-4]). See BenchDateVerbs in bench.go for the ruling, the two
// floors and why they differ.
//
// PERMISSION IS ABSENCE, AND IT IS ABSENCE TWICE OVER. A viewer without
// `CanControlWorldState` gets no step buttons; a viewer who is not the Owner
// gets no Set-date fields; a viewer with neither gets NO ELEMENT AT ALL — not a
// disabled control, not a tooltip, not an empty row. The whole component is
// wrapped in that outer test for exactly that reason.
//
// WHY THIS ROW IS DRIVEN BY JS WHEN [GR-2]'s TRIO IS NOT, and it is a
// measurement rather than a preference. `PUT /campaigns/:id/calendar/world-
// state` binds `putWorldStateBody`, whose `advance` and `time` members are
// POINTERS TO ANONYMOUS STRUCTS carrying `json` tags and no `form` tags. Echo's
// form binder skips a tagless pointer-to-struct field outright, so a
// form-encoded submit — which is all a plain <form> or a bare hx-put can send —
// binds NOTHING and the endpoint answers 200 having changed no date. That is a
// silent no-op, which is worse at a table than a missing control. Giving the
// shipped request struct form tags would be a wire-contract change to an
// endpoint V2's console and the sync path both use, and this slice's Bounds
// freeze that surface. TestWorldStatePut_FormEncodedBindsNothing pins the
// measurement so the next hand does not re-derive it.
//
// SO THE WRITE RIDES `calendar_daycard.js`, the plugin's registry-mounted
// driver that is already on this page (internal/app/routes.go →
// pluginBodyScripts → base.templ). ZERO new page scripts, zero registry edits,
// and tools/check-page-scripts.sh stays green unedited — which it could not if
// this shipped its own <script src>, and a <script> inside an HTMX-swapped
// fragment would be DELETED by boot.js:163 anyway.
templ benchDateVerbRow(v BenchDateVerbs) {
	if v.CanStep || v.CanSet {
		<div
			class="manage"
			data-bench-date-verbs
			data-verb-url={ v.URL }
			data-verb-csrf={ v.CSRF }
		>
			<span class="badge">In-world date</span>
			if v.CanStep {
				<button type="button" class="btn xs" data-bench-date-step="-1">&minus;1 day</button>
				<button type="button" class="btn xs" data-bench-date-step="1">+1 day</button>
			}
			<span class="sp"></span>
			if v.CanSet {
				// Set date is OWNER-ONLY and seeded from the calendar's own
				// current date, never from the navigated month.
				<label class="vh" for="bench-set-y">Year</label>
				<input id="bench-set-y" class="btn xs" type="number" size="5" data-bench-date-year value={ benchIntAttr(v.Year) }/>
				<label class="vh" for="bench-set-m">Month</label>
				<input id="bench-set-m" class="btn xs" type="number" size="3" min="1" data-bench-date-month value={ benchIntAttr(v.Month) }/>
				<label class="vh" for="bench-set-d">Day</label>
				<input id="bench-set-d" class="btn xs" type="number" size="3" min="1" data-bench-date-day value={ benchIntAttr(v.Day) }/>
				<button type="button" class="btn xs" data-bench-date-set>Set date</button>
			}
			// The one honest state this row has: what the last write did. It is
			// aria-live so the answer reaches a screen reader, and it is TEXT —
			// no transition, no animation, nothing that moves.
			<span class="c" data-bench-date-say role="status" aria-live="polite"></span>
		</div>
	}
}

// benchManageStrip is the owner's per-calendar cluster: the W5b visibility
// badge, the permissions trigger (seeded exactly as the retired card seeded it,
// so calendar_permissions.js is untouched) and the Settings link.
templ benchManageStrip(m BenchManage) {
	<div class="manage" data-bench-manage data-calendar-id={ m.CalendarID }>
		@benchVisibilityBadge(m)
		if m.IsDefault {
			<span class="badge">Default</span>
		}
		if m.IsActive {
			<span class="badge">Active</span>
		}
		<span class="sp"></span>
		<button
			type="button"
			class="btn xs"
			data-cal-permissions
			data-calendar-id={ m.CalendarID }
			data-cal-vis-mode={ m.VisMode }
			data-cal-vis-rules={ m.VisRules }
		>Permissions</button>
		<a class="btn xs" href={ templ.SafeURL(m.SettingsHref) }>Settings</a>
	</div>
}

// benchVisibilityBadge is the W5b owner badge: Everyone · GM only · Custom.
templ benchVisibilityBadge(m BenchManage) {
	switch m.Visibility {
		case "custom":
			<span class="badge" data-cal-visibility="custom">Custom</span>
		case "dm_only":
			<span class="badge" data-cal-visibility="dm_only">GM only</span>
		default:
			<span class="badge" data-cal-visibility="everyone">Everyone</span>
	}
}

// --- RSVP -------------------------------------------------------------------

// benchRsvpView is the signed panel (cv4:2205-2263), in the signed order.
//
// THE PANEL-LEVEL `needs backend` CHIP IS GONE (WG-8). It was drawn when the
// WHOLE panel was design-ahead; after this slice the panel is backed and three
// controls inside it are not, so the chip moves to those controls. Leaving a
// panel-level chip over a filled panel is the same lie class as a green sync
// pill with no denominator, inverted — and it would ship the operator's most
// wanted feature announcing itself as unbuilt on the day it was built.
//
// WHAT A PLAYER RECEIVES, and what they do not. The full member table — every
// name, role, zone chip, local clock and answer word — renders to EVERYONE:
// that is the signed contract's own reading (`${table}` is unconditional at
// cv4:2261) and v4-bench-player-light.png shows it directly. The availability
// LANES are owner / co-DM only, and they are absent from a player's payload
// before this template ever runs. The Director's two inert controls are absent
// too, because a disabled control whose reason is a `needs backend` chip may not
// render to a player (decisions/2026-07-27-needs-backend-audience.md).
templ benchRsvpView(data BenchData) {
	<div class="rsvp surf" data-bench-rsvp>
		<div class="lhead">
			// THE DOOR TO THE SCHEDULE (C-CALV4-RSVP-P8 §10). The panel has been
			// called `RSVP · Schedule` since the signed contract drew it
			// (cv4:2233); Part B built the page behind that noun, so the noun
			// becomes the way in. It could not in Part A — a link to a 404 is
			// worse than no link — and it is not in the nav, because WG-2's
			// signed ruling keeps the nav pointing at `/availability` and books
			// the retirement as its own slice.
			//
			// A DOOR AT EVERY ROLE: the route's floor is Player+, and hiding it
			// from players would hide the painter from exactly the people whose
			// availability this panel is reporting it does not have. The
			// campaign-less branch is not defensive noise — `/campaigns//schedule`
			// is a 404 with a friendlier shape.
			if data.CampaignID != "" {
				<a
					class="t"
					href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/schedule", data.CampaignID)) }
					title="Open the schedule — the ranked windows, the week grid, the roster and your own hours"
				>{ data.Rsvp.Title }</a>
			} else {
				<span class="t">{ data.Rsvp.Title }</span>
			}
			if data.Rsvp.Filled {
				<span class="c" title={ data.Rsvp.FrameTitle }>{ data.Rsvp.Frame }</span>
				<span class="sp"></span>
				<span class="c">{ data.Rsvp.Scope }</span>
			}
		</div>
		if !data.Rsvp.Filled {
			<p class="note">{ data.Rsvp.Note }</p>
		} else {
			<div class="top">
				<div class="ov">
					<div class="ovwrap">
						<div class="ovgrid" data-bench-rsvp-grid>
							<div class="ovhead">
								<b>Member</b>
								for _, d := range data.Rsvp.DayHeads {
									<b>{ d.Label }</b>
								}
							</div>
							@benchRsvpLanesView(data.Rsvp)
							@benchRsvpDensityView(data.Rsvp)
							@benchRsvpBracketView(data.Rsvp)
						</div>
					</div>
				</div>
				<div class="side">
					<div class="hl">{ data.Rsvp.Headline }</div>
					if data.Rsvp.Rec != "" {
						<div class="rec">
							{ data.Rsvp.Rec }
							if data.Rsvp.RecDerived {
								<span class="badge">derived · not stored</span>
							}
						</div>
					}
					if data.Rsvp.Why != "" {
						<div class="why">{ data.Rsvp.Why }</div>
					}
					if len(data.Rsvp.Actions) > 0 || data.Rsvp.Ask != nil {
						// ONE `.btns` ROW, as the signed contract draws it
						// (cv4:2254-2255). The ask control joins Propose in the
						// row rather than sitting under the caption: [PB-9]
						// pre-authorises Nudge going LIVE, not Nudge moving.
						<div class="btns">
							for _, a := range data.Rsvp.Actions {
								@benchActionView(a)
							}
							if data.Rsvp.Ask != nil {
								@benchAskFormView(data.Rsvp.Ask)
							}
						</div>
						if data.Rsvp.ActionsWhy != "" {
							<div class="cap">{ data.Rsvp.ActionsWhy }</div>
						}
					}
					if data.Rsvp.Silent != "" {
						<div class="rec warn">{ data.Rsvp.Silent }</div>
					}
					<div class="cap">{ data.Rsvp.SideCap }</div>
				</div>
			</div>
			<div class="mtable" data-bench-rsvp-table>
				<div class="lhead">
					<span class="t">{ data.Rsvp.SlotLabel }</span>
				</div>
				for _, m := range data.Rsvp.Members {
					@benchRsvpMemberView(m)
				}
			</div>
			for _, c := range data.Rsvp.Captions {
				<p class="cap">{ c }</p>
			}
		}
	</div>
}

// benchRsvpLanesView draws the per-member lanes. There is no `if IsGM` here on
// purpose: a player's BenchRsvp carries no Lanes at all, so the absence is in
// the data and this loop simply has nothing to walk. A permission expressed as
// a template branch is one refactor away from being lost.
templ benchRsvpLanesView(p BenchRsvp) {
	for _, l := range p.Lanes {
		<div class="lane" data-bench-rsvp-lane>
			<span class="who">
				<span class={ "swatch", l.Pattern } style={ benchAxisStyle(l.Axis) }></span>
				{ l.Initials }
			</span>
			for i, free := range l.Free {
				<span
					class={ "slot", templ.KV("free", free) }
					style={ benchAxisStyle(l.Axis) }
					data-day={ benchLaneDayKey(l, i) }
				></span>
			}
		</div>
	}
}

// benchRsvpDensityView is the anonymous aggregate — EVERYONE'S, at every role.
// Each bar's own denominator rides in `title`, so the opacity is never the only
// carrier of the number.
templ benchRsvpDensityView(p BenchRsvp) {
	<div class="lane dens-row">
		<span class="who cap">density</span>
		for _, d := range p.Density {
			<span class="dens" style={ benchDensityStyle(d) } title={ d.Title } data-day={ d.DayKey }></span>
		}
	</div>
}

// benchRsvpBracketView draws the derived window's bracket. --accent is legal
// here precisely because it is the TOOL talking, not an event (REVIEW.md:126-136).
templ benchRsvpBracketView(p BenchRsvp) {
	if p.Bracket != nil {
		<div class="lane brk-row">
			<span class="who"></span>
			<span class="recbr" style={ benchBracketStyle(p.Bracket) }>
				<b>{ p.Bracket.Label }</b>
			</span>
		</div>
	}
}

// benchRsvpMemberView is one party-visible member row.
//
// The `zone not set` + `Ask →` pair STAYS AT EVERY WIDTH — the repair may never
// be the thing that disappears on the smallest screen, which is where a player
// most likely is — and the clock beside it is LITERALLY EMPTY rather than a
// dash or a UTC guess (§5).
templ benchRsvpMemberView(m BenchRsvpMember) {
	<div class="mrow" data-bench-rsvp-row>
		<span class={ "swatch", m.Pattern } style={ benchAxisStyle(m.Axis) }></span>
		<span class="nm">
			{ m.Name }
			if m.Host {
				<span class="ro">(host)</span>
			}
		</span>
		<span class="ro">{ m.Role }</span>
		if m.IsCoDM {
			<span class="badge gm">co-DM</span>
		}
		<span class="sp"></span>
		if m.Zone == "" {
			<span class="badge warn">zone not set</span>
			// THE LABEL IS THE PRODUCER'S, NOT THIS TEMPLATE'S
			// (C-CALV4-GAMEREADY §8 [GR-15]). benchZoneRepair chooses the
			// href and the words together: the viewer's own row says
			// "Set your zone →" and goes to /account, a GM looking at
			// someone else's says "Ask →", and a Player looking at someone
			// else's gets an EMPTY href and therefore no control at all.
			if m.AskHref != "" {
				<a class="btn xs ghost" href={ templ.SafeURL(m.AskHref) }>{ m.AskLabel }</a>
			}
		} else {
			<span class="badge tz" title={ m.ZoneTitle }>{ m.Zone }</span>
		}
		<span class={ "lt", templ.KV("small", m.Antisocial) }>
			{ m.LocalTime }
			if m.NextDay {
				<span class="badge warn tz">+1d</span>
			}
		</span>
		<span class={ "rs", benchToneClass(m.Tone) }>{ m.Answer }</span>
	</div>
}

// --- NEXT UP ----------------------------------------------------------------

// benchNextUpView is a printed index, not a stack of cards. Every row is
// viewer-filtered at the source (UpcomingAcrossCalendars) and every count is
// computed post-filter — the mockup's hardcoded "all 11" tail is not ported.
templ benchNextUpView(data BenchData) {
	// THE SECTION HEAD MOVED UP INTO THE DISCLOSURE'S <summary>
	// (C-CALV4-BENCH-R2 slice R2-1). It carried exactly this .cap + .c pair
	// — "Next up" and benchNextUpSubtitle — and the summary carries both PLUS
	// the soonest row, so this is a strict information gain rather than a
	// relocation. Leaving it here as well would print the same heading twice
	// whenever the section is open, which is precisely the "correct at every
	// line and exhausting as a whole" failure this slice exists to fix.
	<div class="nextup" data-bench-nextup>
		if len(data.NextUp.Rows) == 0 {
			<p class="note" data-bench-nextup-empty>Nothing upcoming on the calendars you can see.</p>
		} else {
			for _, r := range data.NextUp.Rows {
				<a
					class="r"
					href={ templ.SafeURL(r.Href) }
					data-row={ r.DayKey }
					data-day={ r.DayKey }
					style={ benchNextUpStyle(r) }
				>
					<span class="dg">{ r.DateLabel }</span>
					<span class="cn">{ r.CalendarLabel }</span>
					<span class="nm">
						{ r.Name }
						if r.GMOnly {
							<span class="badge gm">GM</span>
						}
					</span>
					// The axis chip renders only when the event HAS an identity to
					// draw. An event with no category carries no hue, no pattern
					// and no glyph, and an empty rail is a mark that means nothing.
					if r.Axis != "" || r.Glyph != "" {
						<span class={ "chip", benchPatternClass(r.Pattern) }>
							if r.Glyph != "" {
								<span class="gl" aria-hidden="true">{ r.Glyph }</span>
							}
						</span>
					}
				</a>
			}
			<div class="tail">
				<span class="c">{ benchNextUpTail(data.NextUp) }</span>
			</div>
		}
	</div>
}

// --- the row grid -----------------------------------------------------------

// benchRowGridSection wraps the subordinate rows in #cal-dash-grid so the
// pre-existing owner sort control keeps HTMX-swapping exactly this section
// (?sort=…&grid=1). That hx-get is the ONLY HTMX on the page and adds no route.
templ benchRowGridSection(data BenchData) {
	<div id="cal-dash-grid">
		if data.IsOwner && len(data.Rows) > 1 {
			<div class="sortrow" data-cal-dashboard-sort role="group" aria-label="Sort calendars">
				<span class="c">Sort</span>
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "", "Default")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "name", "Name")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "created", "Newest")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "updated", "Recently active")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "nextevent", "Next event")
			</div>
		}
		<div class="rowgrid" data-cal-dashboard-list>
			for _, r := range data.Rows {
				@benchRowView(r, data)
			}
			if data.ShowNewSlot {
				@benchNewSlot(data.CampaignID)
			}
		</div>
	</div>
}

// benchRowView is one subordinate calendar.
//
// THE WARNROW PRINTS ITS FAULT WHERE THE DATE WOULD GO: the fault takes the
// name's slot and the row carries NO date element at all — no zero, no
// placeholder, no em dash. That branch is GM-only (benchRows never builds it
// for a player).
templ benchRowView(r BenchRow, data BenchData) {
	<div
		class={ "calrow", benchPatternClass(r.Pattern), templ.KV("warnrow", r.Warn) }
		data-bench-row
		data-calendar-id={ r.Manage.CalendarID }
		style={ benchRowStyle(r) }
	>
		<span class="dot" aria-hidden="true"></span>
		// THE ROW IS NO LONGER A DOOR (C-CALV4-V2SUNSET R2-4, [VS-14] SIGNED).
		//
		// It used to navigate to /calendar/v2/<that calendar> — a v4 surface
		// linking out to the legacy calendar, which is the operator's complaint
		// at its sharpest. Re-pointing it at /apps/calendar would make every
		// subordinate row a link back to the page it is printed on, because
		// [VS-12] measured that this handler never reads `calId`. So the anchor
		// goes and THE ROW STAYS, identity and all: the dot, the name, the fault,
		// the date and the setup badge are unchanged.
		//
		// The row becomes a door again in C-CALV4-BENCH-CALID, when the Bench
		// learns `?calId=` and the link would select something.
		<div class="grow">
			if r.Warn {
				<div class="fault" role="status">{ r.Fault }</div>
			} else {
				<div class="nm">{ r.Name }</div>
			}
			<div class="dt">{ r.Detail }</div>
		</div>
		<span class="sp"></span>
		if r.Warn {
			<span class="badge warn">setup</span>
		} else if r.DateLabel != "" {
			<span class="iw mono">{ r.DateLabel }</span>
		}
		if data.IsOwner {
			@benchVisibilityBadge(r.Manage)
			<button
				type="button"
				class="btn xs"
				data-cal-permissions
				data-calendar-id={ r.Manage.CalendarID }
				data-cal-vis-mode={ r.Manage.VisMode }
				data-cal-vis-rules={ r.Manage.VisRules }
			>Permissions</button>
			<a class="btn xs" href={ templ.SafeURL(r.Manage.SettingsHref) }>Settings</a>
		}
	</div>
}

// benchNewSlot is the New-calendar slot.
//
// OWNER-ONLY, which is a deviation from the signed render: the mockup draws the
// slot in the player view too, but POST /calendars is Owner-gated, so a player
// who took the affordance would meet a 403. Permission is absence — the same
// rule the empty state already follows ("No calendars shared with you yet",
// with no create affordance).
templ benchNewSlot(campaignID string) {
	<a class="calrow newslot" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/calendars/builder", campaignID)) } data-bench-newslot>
		<span class="plus" aria-hidden="true">＋</span>
		<div class="grow">
			<div class="nm">New calendar</div>
			<div class="dt">wizard · presets</div>
		</div>
		<span class="sp"></span>
		<span class="pill">Real-life</span>
		<span class="pill">Custom</span>
		<span class="pill">Import</span>
	</a>
}

// benchCaption is the page's closing note — the proportion rule, stated where a
// reader can hold the page and the rule in the same glance, and the honest
// inventory of what is design-ahead.
templ benchCaption() {
	<div class="caption" data-bench-caption>
		The Bench is a cockpit: every tile states a fact at rest and is a door, and the two full
		Blocks below it are the same widget you drop on an entity page. Proportion is a rule, not an
		accident — one primary calendar, one real-world calendar, then subordinate rows; there is no
		width at which this becomes four identical panels. Tiles marked <b>needs backend</b> name a
		gap in what Chronicle can compute, not a gap in the page: per-calendar sync link state and a
		queryable knowledge horizon do not exist, so those tiles say so rather than printing a zero.
		This list previously named session RSVP storage as well, which was wrong — that storage has
		shipped since calendar migration 013 and the scheduler&#39;s since sessions migration 002.
	</div>
}

// --- view helpers -----------------------------------------------------------

// benchTileClass composes a tile's class list. Kept in Go rather than as three
// templ.KV entries so the ORDER of the modifiers is fixed and the stylesheet's
// specificity story stays readable.
func benchTileClass(t BenchTile) string {
	cls := "tile"
	if t.Class != "" {
		cls += " " + t.Class
	}
	return cls
}

// benchToneClass maps a headline tone onto the sheet's two ink modifiers.
func benchToneClass(tone string) string {
	switch tone {
	case "ok":
		return "ok"
	case "warn":
		return "warn"
	case "bad":
		return "bad"
	default:
		return ""
	}
}

// --- RSVP panel view helpers ------------------------------------------------

// benchAxisStyle hands a member's identity hue to the --axis channel the
// swatch, the lane pill and the pattern all read. The PATTERN rides as a class
// (p1..p8) rather than a style, because it is the greyscale identity channel and
// a channel that lives in a style attribute is one CSP tightening from vanishing.
func benchAxisStyle(axis string) string {
	if a := strings.TrimSpace(axis); a != "" {
		return "--axis:" + a
	}
	return ""
}

// benchLaneDayKey returns the lane cell's ANSWER key. Guard B4: every dated node
// carries data-day, in bench.templ's EXISTING namespace — never a second one.
func benchLaneDayKey(l BenchRsvpLane, i int) string {
	if i < 0 || i >= len(l.DayKeys) {
		return ""
	}
	return l.DayKeys[i]
}

// benchDensityStyle maps a column's free count onto the bar's opacity.
//
// The floor is deliberate: a column where NOBODY is free still draws a bar, at
// the lowest step, because a vanished bar reads as "no data" and this row's
// whole job is to distinguish "nobody can make it" from "nobody has said".
func benchDensityStyle(d BenchRsvpDensity) string {
	if d.Total <= 0 {
		return "--dens:0.12"
	}
	return fmt.Sprintf("--dens:%.2f", 0.12+0.88*float64(d.Free)/float64(d.Total))
}

// benchBracketStyle positions the derived window's bracket over the columns it
// spans. Grid lines, not day indices — column 1 is the 96px member label.
func benchBracketStyle(b *BenchRsvpBracket) string {
	if b == nil {
		return ""
	}
	return fmt.Sprintf("grid-column:%d/%d", b.Start, b.End)
}

// benchPatternClass normalises a stroke pattern to p1..p8.
//
// MIRRORED from calendar_block's patternClass, which is unexported. The pattern
// — not the hue — is the GREYSCALE IDENTITY CHANNEL, so the Bench's rows and
// chips must carry it for the same reason the Block's marks do; defaulting to
// p1 (the solid stroke) is safe because it is legible under every filter.
func benchPatternClass(p string) string {
	p = strings.TrimSpace(p)
	switch p {
	case "p1", "p2", "p3", "p4", "p5", "p6", "p7", "p8":
		return p
	default:
		return "p1"
	}
}

// benchCalToken maps a --cal TOKEN NAME to its channel.
//
// MIRRORED from calendar_block's calToken, and mirrored for the reason its own
// comment gives: CalHue is a token name, not a colour value, and a renderer
// that whitelists colour VALUES greys out every calendar's identity channel —
// which is exactly what happened once in wave 1. Unknown tokens fall back to
// the neutral structural rule rather than to nothing.
func benchCalToken(v string) string {
	switch strings.TrimSpace(v) {
	case "harptos", "real", "elven", "dwarven":
		return "var(--cal-" + strings.TrimSpace(v) + ")"
	default:
		return "var(--rule-structural-strong)"
	}
}

// benchRowStyle writes the row's identity channel.
func benchRowStyle(r BenchRow) string { return "--cal:" + benchCalToken(r.CalHue) }

// benchNextUpStyle writes an index row's two channels: the calendar's identity
// and the event's axis. Axis is a concrete colour from the operator's own data
// and never references --accent (canon A7).
func benchNextUpStyle(r BenchNextUpRow) string {
	style := "--cal:" + benchCalToken(r.CalHue)
	if a := strings.TrimSpace(r.Axis); a != "" {
		style += ";--axis:" + a
	}
	return style
}

// benchTickStyle positions one tick and carries its axis when the day is live.
func benchTickStyle(t BenchTick) string {
	style := fmt.Sprintf("--m-i:%d", t.Day)
	if a := strings.TrimSpace(t.Axis); a != "" {
		style += ";--axis:" + a
	}
	return style
}

// benchIntAttr renders an int for a data attribute.
func benchIntAttr(n int) string { return fmt.Sprintf("%d", n) }

// benchHeadSubtitle is the .phead's count line — the signed "four calendars in
// Imix — the block below is the widget you embed", with the viewer's own count.
func benchHeadSubtitle(data BenchData) string {
	return fmt.Sprintf("%s in %s — the block below is the widget you embed",
		benchCalendarCount(data.CalendarCount), data.CampaignName)
}

// benchSectionSubtitle is the "4 calendars · 1 needs setup" line. The setup half
// is GM-only: a player is not told that a calendar they cannot fix is broken.
func benchSectionSubtitle(data BenchData) string {
	s := benchCalendarCount(data.CalendarCount)
	if data.IsGM && data.NeedsSetup > 0 {
		s += fmt.Sprintf(" · %d needs setup", data.NeedsSetup)
	}
	return s
}

// benchCalendarCount renders "1 calendar" / "4 calendars".
func benchCalendarCount(n int) string {
	if n == 1 {
		return "1 calendar"
	}
	return fmt.Sprintf("%d calendars", n)
}

// benchNextUpSubtitle names the breadth of the index — across how many of the
// VIEWER's calendars, never the campaign's total.
func benchNextUpSubtitle(u BenchNextUp) string {
	if u.Calendars == 1 {
		return "across 1 calendar"
	}
	return fmt.Sprintf("across %d calendars", u.Calendars)
}

// benchNextUpTail is the signed "all 14 →" line, stated from the VIEWER's own
// index rather than from the mockup's hardcoded 11.
func benchNextUpTail(u BenchNextUp) string {
	return fmt.Sprintf("all %d →", u.Total)
}

// benchAskFormView is the panel's LIVE ask control (C-CALV4-RSVP-P8B, [PB-5]).
//
// EXACTLY ONE LIVE NUDGE EXISTS IN THE PRODUCT, and it is this one. The panel
// is the only surface that already holds the roster, the derived silent set and
// the resolved session, so the button belongs where its subject is. The two
// tile Nudges are RETIRED rather than made live: two live buttons that mail the
// same roster, stacked on one page, is a double-send affordance.
//
// A POST FORM, NEVER A LINK. BenchAction carries only Href and renders an <a>,
// i.e. a GET — and mailing a roster from a GET is one link prefetcher away from
// a fan-out nobody clicked. So this takes BenchRsvpForm's shape: a form-encoded
// POST with the CSRF token as a hidden field, because
// internal/middleware/csrf.go accepts either the X-CSRF-Token header or a
// csrf_token field and this path is not under /api/ or /ws.
//
// NO JS IS ADDED TO THE BENCH. hx-* attributes are markup. The response swaps
// THIS form for one .cap line stating the outcome — the same sentence the JSON
// carries, no richer — which is also honest about state, because the cooldown
// has just begun and the control is correctly no longer there.
//
// event_id rides as a hidden field only when the panel resolved a collecting
// session. It is the ONE accepted parameter and the handler re-resolves it
// through the existing campaign-scoping check; there is no field by which a
// caller could name a recipient.
//
// THE DISABLED BRANCH carries `.badge.warn`, never `.badge.need`: an
// unconfigured mail server is a deployment fact in the `zone not set` register,
// not a build gap, and the reason is ALSO carried visibly in the panel's foot
// rather than in `title` alone.
templ benchAskFormView(f *BenchAskForm) {
	if f.Disabled {
		<span class="inert">
			<button type="button" class="btn xs" disabled title={ f.Title }>{ f.Label }</button>
			if f.Badge != "" {
				<span class="badge warn">{ f.Badge }</span>
			}
		</span>
	} else {
		<form
			method="post"
			action={ templ.SafeURL(f.Action) }
			hx-post={ f.Action }
			hx-target="this"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ f.CSRFToken }/>
			if f.EventID != "" {
				<input type="hidden" name="event_id" value={ f.EventID }/>
			}
			<button type="submit" class="btn xs" title={ f.Title }>{ f.Label }</button>
		</form>
	}
}

// benchAskResultView is what replaces the control after a send: one .cap line,
// carrying the count and nothing else. No identities, no per-recipient outcome
// — the send is backgrounded, so per-recipient outcomes do not exist yet.
templ benchAskResultView(line string) {
	<div class="cap" data-bench-ask-result>{ line }</div>
}
