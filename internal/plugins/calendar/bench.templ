// bench.templ — THE BENCH's markup (calendar-v4 wave 1, phase B).
//
// THE CONTRACT'S DOM ORDER, EXACTLY (mockups/calendar-v4.html ?view=dashboard):
//
//	.phead
//	ribbon()          six tiles for a GM, THREE for a player
//	.sechead "The bench"
//	.stack            primary Block, then the real-world Block (noShelf)
//	rsvpPanel()
//	nextUp()
//	.rowgrid          subordinate rows, the GM-only warnrow, the New slot
//	.caption
//
// popovers() has no subject in wave 1 and is therefore not emitted: the signed
// Bench's popovers are the BLOCK's own per-day hidden-event and overflow
// panels, and the shipped Block emits neither (calendar_block has no popover
// invoker — the switchboard popover is W-F and the day ANSWER is W-B). A Bench
// that emitted them would be shipping orphan DOM keyed to invokers that do not
// exist. When the Block grows them, they arrive inside the Block, where their
// invokers are.
//
// NO MOTION. COMMON §6.5: no transitions inside the Block, at all, in wave 1.
// The Bench's own chrome keeps the same discipline — calendar-bench.css defines
// no transition, no animation and no @keyframes, and its contract test says so.

package calendar

import (
	"fmt"
	"strings"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
	calblock "github.com/keyxmakerx/chronicle/internal/widgets/calendar_block"
)

// BenchPage renders the full Bench at GET /campaigns/:id/apps/calendar.
templ BenchPage(cc *campaigns.CampaignContext, data BenchData) {
	@layouts.App("Calendar") {
		<div class="cal-bench" data-cal-bench data-cal-dashboard>
			<link rel="stylesheet" href={ layouts.AssetURL("/static/css/calendar-bench.css") }/>
			@components.Breadcrumbs([]components.BreadcrumbItem{
				{Label: cc.Campaign.Name, Href: fmt.Sprintf("/campaigns/%s", cc.Campaign.ID), Icon: "fa-dice-d20"},
				{Label: "Apps", Href: fmt.Sprintf("/campaigns/%s/extensions", cc.Campaign.ID)},
				{Label: "Calendars"},
			})
			@benchSurface(data)
		</div>
		// W5b: the per-calendar permissions editor. Owners only — players never
		// receive the editor DOM nor the PUT route. Retained verbatim from the
		// card grid this surface replaces: the Bench moved the trigger onto the
		// Block's management strip and the subordinate rows, and the modal +
		// its driver are unchanged.
		if data.IsOwner {
			@calendarPermissionsModal()
			<script src={ layouts.AssetURL("/static/plugins/calendar/js/calendar_permissions.js") } defer></script>
		}
	}
}

// benchSurface is everything inside the page wrap, in contract order.
templ benchSurface(data BenchData) {
	@benchHead(data)
	if data.LoadError {
		<div class="bench-note" data-cal-dashboard-error>
			<i class="fa-solid fa-circle-info" aria-hidden="true"></i>
			Couldn&#39;t load the calendars right now. Try reloading the page.
		</div>
	} else if data.CalendarCount == 0 {
		@calendarAppDashboardEmpty(data.CampaignID, data.IsOwner)
	} else {
		@benchRibbonView(data)
		<div class="sechead">
			<span class="cap">The bench</span>
			<span class="c">{ benchSectionSubtitle(data) }</span>
		</div>
		<div class="stack" data-bench-stack>
			if data.Primary != nil {
				@benchBlockView(*data.Primary, data, "primary")
			}
			if data.RealWorld != nil {
				@benchBlockView(*data.RealWorld, data, "real-world")
			}
		</div>
		@benchRsvpView(data)
		@benchNextUpView(data)
		@benchRowGridSection(data)
		@benchCaption()
	}
}

// benchHead is .phead: the title, the count line, and the control cluster.
//
// The signed .ctl carries "colour by: type ⌄", "Builder →" and "+ New event".
// The colour-by axis is a PER-VIEWER PREFERENCE with no store (the Block books
// the same control for the same reason — nameplate.templ), and there is no
// event-create route outside the V2 shell and wave 1 adds no routes. So the
// cluster ships the two doors that exist: the calendar itself, and — for an
// owner — the builder and the new-calendar wizard.
templ benchHead(data BenchData) {
	<div class="phead">
		<div>
			<h1>Calendar</h1>
			<p>{ benchHeadSubtitle(data) }</p>
		</div>
		<span class="sp"></span>
		<div class="ctl">
			if data.Primary != nil {
				<a class="btn ghost" href={ templ.SafeURL(data.Primary.Manage.OpenHref) }>Open calendar →</a>
				if data.IsOwner {
					<a class="btn ghost" href={ templ.SafeURL(data.Primary.Manage.SettingsHref) }>Builder →</a>
				}
			}
			if data.IsOwner {
				<a class="btn fill" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/calendars/new", data.CampaignID)) }>+ New calendar</a>
			}
		</div>
	</div>
}

// --- the ribbon -------------------------------------------------------------

// benchRibbonView renders the tiles. Six for a GM, THREE for a player — and the
// three GM tiles are absent from the DOM, not hidden: benchRibbon never builds
// them for a player, so there is nothing here to gate.
templ benchRibbonView(data BenchData) {
	<div class="ribbon" data-bench-ribbon>
		for _, t := range data.Ribbon {
			@benchTileView(t)
		}
	</div>
}

templ benchTileView(t BenchTile) {
	<div class={ benchTileClass(t) } data-bench-tile={ t.Key }>
		<div class="eb">
			<span class="g" aria-hidden="true">{ t.Glyph }</span>
			<span class="cap">{ t.Eyebrow }</span>
			<span class="sp"></span>
			if t.Href != "" {
				<a class="ar" href={ templ.SafeURL(t.Href) } aria-label={ t.Eyebrow }>→</a>
			}
		</div>
		<div class={ "hl", benchToneClass(t.Tone) }>{ t.Headline }</div>
		<div class="ql">
			{ t.Qual }
			if t.NeedsBackend {
				<span class="badge need">needs backend</span>
			}
		</div>
		for _, r := range t.Rows {
			<a class={ "arow", templ.KV("bad", r.Bad) } href={ templ.SafeURL(r.Href) }>{ r.Label }</a>
		}
		if len(t.Actions) > 0 {
			<div class="rsvpb">
				for _, a := range t.Actions {
					@benchActionView(a)
				}
			</div>
		}
		if t.Detail != "" {
			<div class="dt">{ t.Detail }</div>
		}
		if len(t.Ticks) > 0 {
			@benchTickRule(t.Ticks)
		}
	</div>
}

// benchActionView renders a tile control. An action with no Href is INERT —
// rendered so the tile's geometry is final, disabled so it is not a dead
// control that swallows a click (the Block's layersInvoker precedent).
//
// WG-5, ADOPTED PRODUCT-WIDE AND IMPLEMENTED WHERE WAVE 3 ALREADY TOUCHES: an
// inert control carries a VISIBLE `.badge.need`, not a `title` alone. The old
// shape was `title`-only twice and deliberately (here and helpers.go's
// layersInvokerTitle) — and it is independently an a11y defect, because `title`
// is not announced by several screen readers and is unreachable by touch.
//
// The chip's text is the literal "needs backend" and never the specific reason,
// because `.badge.need` is not diluted (§7). The specific reason is carried
// visibly too, by the surrounding surface's `.cap` — so the accessibility rule
// and the non-dilution rule are both satisfied rather than traded against each
// other. A control that carries a chip is GM-tier, since the chip is.
templ benchActionView(a BenchAction) {
	if a.Href != "" {
		<a class={ "btn xs", templ.KV("fill", a.Fill) } href={ templ.SafeURL(a.Href) }>{ a.Label }</a>
	} else if a.NeedsBackend {
		<span class="inert">
			<button type="button" class={ "btn xs", templ.KV("fill", a.Fill) } disabled title={ a.Title }>{ a.Label }</button>
			<span class="badge need">needs backend</span>
		</span>
	} else {
		<button type="button" class={ "btn xs", templ.KV("fill", a.Fill) } disabled title={ a.Title }>{ a.Label }</button>
	}
}

// benchTickRule is the Today tile's month rule. Every tick carries data-day —
// the ANSWER key, emitted in wave 1 and consumed in W-B (guard B4).
templ benchTickRule(ticks []BenchTick) {
	<div class="tick" aria-hidden="true" style={ fmt.Sprintf("--month-len:%d", len(ticks)) }>
		for _, tk := range ticks {
			<i
				class={ "t", templ.KV("ev", tk.Event), templ.KV("now", tk.Today) }
				data-cell={ benchIntAttr(tk.Day) }
				data-day={ tk.DayKey }
				style={ benchTickStyle(tk) }
			></i>
		}
	</div>
}

// --- the stack --------------------------------------------------------------

// benchBlockView is one .stack entry: the Block, then the owner-only management
// strip. The strip is a documented addition — see BenchBlock's doc comment.
templ benchBlockView(b BenchBlock, data BenchData, role string) {
	<div class="benchblock" data-bench-block={ role } data-calendar-id={ b.Manage.CalendarID }>
		@calblock.Block(b.Data)
		if data.IsOwner {
			@benchManageStrip(b.Manage)
		}
	</div>
}

// benchManageStrip is the owner's per-calendar cluster: the W5b visibility
// badge, the permissions trigger (seeded exactly as the retired card seeded it,
// so calendar_permissions.js is untouched) and the Settings link.
templ benchManageStrip(m BenchManage) {
	<div class="manage" data-bench-manage data-calendar-id={ m.CalendarID }>
		@benchVisibilityBadge(m)
		if m.IsDefault {
			<span class="badge">Default</span>
		}
		if m.IsActive {
			<span class="badge">Active</span>
		}
		<span class="sp"></span>
		<button
			type="button"
			class="btn xs"
			data-cal-permissions
			data-calendar-id={ m.CalendarID }
			data-cal-vis-mode={ m.VisMode }
			data-cal-vis-rules={ m.VisRules }
		>Permissions</button>
		<a class="btn xs" href={ templ.SafeURL(m.SettingsHref) }>Settings</a>
	</div>
}

// benchVisibilityBadge is the W5b owner badge: Everyone · GM only · Custom.
templ benchVisibilityBadge(m BenchManage) {
	switch m.Visibility {
		case "custom":
			<span class="badge" data-cal-visibility="custom">Custom</span>
		case "dm_only":
			<span class="badge" data-cal-visibility="dm_only">GM only</span>
		default:
			<span class="badge" data-cal-visibility="everyone">Everyone</span>
	}
}

// --- RSVP -------------------------------------------------------------------

// benchRsvpView is the signed panel (cv4:2205-2263), in the signed order.
//
// THE PANEL-LEVEL `needs backend` CHIP IS GONE (WG-8). It was drawn when the
// WHOLE panel was design-ahead; after this slice the panel is backed and three
// controls inside it are not, so the chip moves to those controls. Leaving a
// panel-level chip over a filled panel is the same lie class as a green sync
// pill with no denominator, inverted — and it would ship the operator's most
// wanted feature announcing itself as unbuilt on the day it was built.
//
// WHAT A PLAYER RECEIVES, and what they do not. The full member table — every
// name, role, zone chip, local clock and answer word — renders to EVERYONE:
// that is the signed contract's own reading (`${table}` is unconditional at
// cv4:2261) and v4-bench-player-light.png shows it directly. The availability
// LANES are owner / co-DM only, and they are absent from a player's payload
// before this template ever runs. The Director's two inert controls are absent
// too, because a disabled control whose reason is a `needs backend` chip may not
// render to a player (decisions/2026-07-27-needs-backend-audience.md).
templ benchRsvpView(data BenchData) {
	<div class="rsvp surf" data-bench-rsvp>
		<div class="lhead">
			<span class="t">{ data.Rsvp.Title }</span>
			if data.Rsvp.Filled {
				<span class="c" title={ data.Rsvp.FrameTitle }>{ data.Rsvp.Frame }</span>
				<span class="sp"></span>
				<span class="c">{ data.Rsvp.Scope }</span>
			}
		</div>
		if !data.Rsvp.Filled {
			<p class="note">{ data.Rsvp.Note }</p>
		} else {
			<div class="top">
				<div class="ov">
					<div class="ovwrap">
						<div class="ovgrid" data-bench-rsvp-grid>
							<div class="ovhead">
								<b>Member</b>
								for _, d := range data.Rsvp.DayHeads {
									<b>{ d.Label }</b>
								}
							</div>
							@benchRsvpLanesView(data.Rsvp)
							@benchRsvpDensityView(data.Rsvp)
							@benchRsvpBracketView(data.Rsvp)
						</div>
					</div>
				</div>
				<div class="side">
					<div class="hl">{ data.Rsvp.Headline }</div>
					if data.Rsvp.Rec != "" {
						<div class="rec">
							{ data.Rsvp.Rec }
							if data.Rsvp.RecDerived {
								<span class="badge">derived · not stored</span>
							}
						</div>
					}
					if data.Rsvp.Why != "" {
						<div class="why">{ data.Rsvp.Why }</div>
					}
					if len(data.Rsvp.Actions) > 0 {
						<div class="btns">
							for _, a := range data.Rsvp.Actions {
								@benchActionView(a)
							}
						</div>
						<div class="cap">{ data.Rsvp.ActionsWhy }</div>
					}
					if data.Rsvp.Silent != "" {
						<div class="rec warn">{ data.Rsvp.Silent }</div>
					}
					<div class="cap">{ data.Rsvp.SideCap }</div>
				</div>
			</div>
			<div class="mtable" data-bench-rsvp-table>
				<div class="lhead">
					<span class="t">{ data.Rsvp.SlotLabel }</span>
				</div>
				for _, m := range data.Rsvp.Members {
					@benchRsvpMemberView(m)
				}
			</div>
			for _, c := range data.Rsvp.Captions {
				<p class="cap">{ c }</p>
			}
		}
	</div>
}

// benchRsvpLanesView draws the per-member lanes. There is no `if IsGM` here on
// purpose: a player's BenchRsvp carries no Lanes at all, so the absence is in
// the data and this loop simply has nothing to walk. A permission expressed as
// a template branch is one refactor away from being lost.
templ benchRsvpLanesView(p BenchRsvp) {
	for _, l := range p.Lanes {
		<div class="lane" data-bench-rsvp-lane>
			<span class="who">
				<span class={ "swatch", l.Pattern } style={ benchAxisStyle(l.Axis) }></span>
				{ l.Initials }
			</span>
			for i, free := range l.Free {
				<span
					class={ "slot", templ.KV("free", free) }
					style={ benchAxisStyle(l.Axis) }
					data-day={ benchLaneDayKey(l, i) }
				></span>
			}
		</div>
	}
}

// benchRsvpDensityView is the anonymous aggregate — EVERYONE'S, at every role.
// Each bar's own denominator rides in `title`, so the opacity is never the only
// carrier of the number.
templ benchRsvpDensityView(p BenchRsvp) {
	<div class="lane dens-row">
		<span class="who cap">density</span>
		for _, d := range p.Density {
			<span class="dens" style={ benchDensityStyle(d) } title={ d.Title } data-day={ d.DayKey }></span>
		}
	</div>
}

// benchRsvpBracketView draws the derived window's bracket. --accent is legal
// here precisely because it is the TOOL talking, not an event (REVIEW.md:126-136).
templ benchRsvpBracketView(p BenchRsvp) {
	if p.Bracket != nil {
		<div class="lane brk-row">
			<span class="who"></span>
			<span class="recbr" style={ benchBracketStyle(p.Bracket) }>
				<b>{ p.Bracket.Label }</b>
			</span>
		</div>
	}
}

// benchRsvpMemberView is one party-visible member row.
//
// The `zone not set` + `Ask →` pair STAYS AT EVERY WIDTH — the repair may never
// be the thing that disappears on the smallest screen, which is where a player
// most likely is — and the clock beside it is LITERALLY EMPTY rather than a
// dash or a UTC guess (§5).
templ benchRsvpMemberView(m BenchRsvpMember) {
	<div class="mrow" data-bench-rsvp-row>
		<span class={ "swatch", m.Pattern } style={ benchAxisStyle(m.Axis) }></span>
		<span class="nm">
			{ m.Name }
			if m.Host {
				<span class="ro">(host)</span>
			}
		</span>
		<span class="ro">{ m.Role }</span>
		if m.IsCoDM {
			<span class="badge gm">co-DM</span>
		}
		<span class="sp"></span>
		if m.Zone == "" {
			<span class="badge warn">zone not set</span>
			if m.AskHref != "" {
				<a class="btn xs ghost" href={ templ.SafeURL(m.AskHref) }>Ask →</a>
			}
		} else {
			<span class="badge tz" title={ m.ZoneTitle }>{ m.Zone }</span>
		}
		<span class={ "lt", templ.KV("small", m.Antisocial) }>
			{ m.LocalTime }
			if m.NextDay {
				<span class="badge warn tz">+1d</span>
			}
		</span>
		<span class={ "rs", benchToneClass(m.Tone) }>{ m.Answer }</span>
	</div>
}

// --- NEXT UP ----------------------------------------------------------------

// benchNextUpView is a printed index, not a stack of cards. Every row is
// viewer-filtered at the source (UpcomingAcrossCalendars) and every count is
// computed post-filter — the mockup's hardcoded "all 11" tail is not ported.
templ benchNextUpView(data BenchData) {
	<div class="nextup" data-bench-nextup>
		<div class="sechead">
			<span class="cap">Next up</span>
			<span class="c">{ benchNextUpSubtitle(data.NextUp) }</span>
		</div>
		if len(data.NextUp.Rows) == 0 {
			<p class="note" data-bench-nextup-empty>Nothing upcoming on the calendars you can see.</p>
		} else {
			for _, r := range data.NextUp.Rows {
				<a
					class="r"
					href={ templ.SafeURL(r.Href) }
					data-row={ r.DayKey }
					data-day={ r.DayKey }
					style={ benchNextUpStyle(r) }
				>
					<span class="dg">{ r.DateLabel }</span>
					<span class="cn">{ r.CalendarLabel }</span>
					<span class="nm">
						{ r.Name }
						if r.GMOnly {
							<span class="badge gm">GM</span>
						}
					</span>
					// The axis chip renders only when the event HAS an identity to
					// draw. An event with no category carries no hue, no pattern
					// and no glyph, and an empty rail is a mark that means nothing.
					if r.Axis != "" || r.Glyph != "" {
						<span class={ "chip", benchPatternClass(r.Pattern) }>
							if r.Glyph != "" {
								<span class="gl" aria-hidden="true">{ r.Glyph }</span>
							}
						</span>
					}
				</a>
			}
			<div class="tail">
				<span class="c">{ benchNextUpTail(data.NextUp) }</span>
			</div>
		}
	</div>
}

// --- the row grid -----------------------------------------------------------

// benchRowGridSection wraps the subordinate rows in #cal-dash-grid so the
// pre-existing owner sort control keeps HTMX-swapping exactly this section
// (?sort=…&grid=1). That hx-get is the ONLY HTMX on the page and adds no route.
templ benchRowGridSection(data BenchData) {
	<div id="cal-dash-grid">
		if data.IsOwner && len(data.Rows) > 1 {
			<div class="sortrow" data-cal-dashboard-sort role="group" aria-label="Sort calendars">
				<span class="c">Sort</span>
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "", "Default")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "name", "Name")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "created", "Newest")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "updated", "Recently active")
				@calendarSortLink(CalendarAppDashboardData{CampaignID: data.CampaignID, Sort: data.Sort}, "nextevent", "Next event")
			</div>
		}
		<div class="rowgrid" data-cal-dashboard-list>
			for _, r := range data.Rows {
				@benchRowView(r, data)
			}
			if data.ShowNewSlot {
				@benchNewSlot(data.CampaignID)
			}
		</div>
	</div>
}

// benchRowView is one subordinate calendar.
//
// THE WARNROW PRINTS ITS FAULT WHERE THE DATE WOULD GO: the fault takes the
// name's slot and the row carries NO date element at all — no zero, no
// placeholder, no em dash. That branch is GM-only (benchRows never builds it
// for a player).
templ benchRowView(r BenchRow, data BenchData) {
	<div
		class={ "calrow", benchPatternClass(r.Pattern), templ.KV("warnrow", r.Warn) }
		data-bench-row
		data-calendar-id={ r.Manage.CalendarID }
		style={ benchRowStyle(r) }
	>
		<span class="dot" aria-hidden="true"></span>
		// THE ROW IS A DOOR, for every role: the name navigates to the calendar.
		// A plain href, never an HTMX swap — the target page loads engine
		// scripts, and boot.js:163 disables scripts inside swapped fragments.
		<a class="grow" href={ templ.SafeURL(r.Manage.OpenHref) }>
			if r.Warn {
				<div class="fault" role="status">{ r.Fault }</div>
			} else {
				<div class="nm">{ r.Name }</div>
			}
			<div class="dt">{ r.Detail }</div>
		</a>
		<span class="sp"></span>
		if r.Warn {
			<span class="badge warn">setup</span>
		} else if r.DateLabel != "" {
			<span class="iw mono">{ r.DateLabel }</span>
		}
		if data.IsOwner {
			@benchVisibilityBadge(r.Manage)
			<button
				type="button"
				class="btn xs"
				data-cal-permissions
				data-calendar-id={ r.Manage.CalendarID }
				data-cal-vis-mode={ r.Manage.VisMode }
				data-cal-vis-rules={ r.Manage.VisRules }
			>Permissions</button>
			<a class="btn xs" href={ templ.SafeURL(r.Manage.SettingsHref) }>Settings</a>
		}
	</div>
}

// benchNewSlot is the New-calendar slot.
//
// OWNER-ONLY, which is a deviation from the signed render: the mockup draws the
// slot in the player view too, but POST /calendars is Owner-gated, so a player
// who took the affordance would meet a 403. Permission is absence — the same
// rule the empty state already follows ("No calendars shared with you yet",
// with no create affordance).
templ benchNewSlot(campaignID string) {
	<a class="calrow newslot" href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/calendars/new", campaignID)) } data-bench-newslot>
		<span class="plus" aria-hidden="true">＋</span>
		<div class="grow">
			<div class="nm">New calendar</div>
			<div class="dt">wizard · presets</div>
		</div>
		<span class="sp"></span>
		<span class="pill">Real-life</span>
		<span class="pill">Custom</span>
		<span class="pill">Import</span>
	</a>
}

// benchCaption is the page's closing note — the proportion rule, stated where a
// reader can hold the page and the rule in the same glance, and the honest
// inventory of what is design-ahead.
templ benchCaption() {
	<div class="caption" data-bench-caption>
		The Bench is a cockpit: every tile states a fact at rest and is a door, and the two full
		Blocks below it are the same widget you drop on an entity page. Proportion is a rule, not an
		accident — one primary calendar, one real-world calendar, then subordinate rows; there is no
		width at which this becomes four identical panels. Tiles marked <b>needs backend</b> name a
		gap in what Chronicle can compute, not a gap in the page: per-calendar sync link state and a
		queryable knowledge horizon do not exist, so those tiles say so rather than printing a zero.
		This list previously named session RSVP storage as well, which was wrong — that storage has
		shipped since calendar migration 013 and the scheduler&#39;s since sessions migration 002.
	</div>
}

// --- view helpers -----------------------------------------------------------

// benchTileClass composes a tile's class list. Kept in Go rather than as three
// templ.KV entries so the ORDER of the modifiers is fixed and the stylesheet's
// specificity story stays readable.
func benchTileClass(t BenchTile) string {
	cls := "tile"
	if t.Class != "" {
		cls += " " + t.Class
	}
	return cls
}

// benchToneClass maps a headline tone onto the sheet's two ink modifiers.
func benchToneClass(tone string) string {
	switch tone {
	case "ok":
		return "ok"
	case "warn":
		return "warn"
	case "bad":
		return "bad"
	default:
		return ""
	}
}

// --- RSVP panel view helpers ------------------------------------------------

// benchAxisStyle hands a member's identity hue to the --axis channel the
// swatch, the lane pill and the pattern all read. The PATTERN rides as a class
// (p1..p8) rather than a style, because it is the greyscale identity channel and
// a channel that lives in a style attribute is one CSP tightening from vanishing.
func benchAxisStyle(axis string) string {
	if a := strings.TrimSpace(axis); a != "" {
		return "--axis:" + a
	}
	return ""
}

// benchLaneDayKey returns the lane cell's ANSWER key. Guard B4: every dated node
// carries data-day, in bench.templ's EXISTING namespace — never a second one.
func benchLaneDayKey(l BenchRsvpLane, i int) string {
	if i < 0 || i >= len(l.DayKeys) {
		return ""
	}
	return l.DayKeys[i]
}

// benchDensityStyle maps a column's free count onto the bar's opacity.
//
// The floor is deliberate: a column where NOBODY is free still draws a bar, at
// the lowest step, because a vanished bar reads as "no data" and this row's
// whole job is to distinguish "nobody can make it" from "nobody has said".
func benchDensityStyle(d BenchRsvpDensity) string {
	if d.Total <= 0 {
		return "--dens:0.12"
	}
	return fmt.Sprintf("--dens:%.2f", 0.12+0.88*float64(d.Free)/float64(d.Total))
}

// benchBracketStyle positions the derived window's bracket over the columns it
// spans. Grid lines, not day indices — column 1 is the 96px member label.
func benchBracketStyle(b *BenchRsvpBracket) string {
	if b == nil {
		return ""
	}
	return fmt.Sprintf("grid-column:%d/%d", b.Start, b.End)
}

// benchPatternClass normalises a stroke pattern to p1..p8.
//
// MIRRORED from calendar_block's patternClass, which is unexported. The pattern
// — not the hue — is the GREYSCALE IDENTITY CHANNEL, so the Bench's rows and
// chips must carry it for the same reason the Block's marks do; defaulting to
// p1 (the solid stroke) is safe because it is legible under every filter.
func benchPatternClass(p string) string {
	p = strings.TrimSpace(p)
	switch p {
	case "p1", "p2", "p3", "p4", "p5", "p6", "p7", "p8":
		return p
	default:
		return "p1"
	}
}

// benchCalToken maps a --cal TOKEN NAME to its channel.
//
// MIRRORED from calendar_block's calToken, and mirrored for the reason its own
// comment gives: CalHue is a token name, not a colour value, and a renderer
// that whitelists colour VALUES greys out every calendar's identity channel —
// which is exactly what happened once in wave 1. Unknown tokens fall back to
// the neutral structural rule rather than to nothing.
func benchCalToken(v string) string {
	switch strings.TrimSpace(v) {
	case "harptos", "real", "elven", "dwarven":
		return "var(--cal-" + strings.TrimSpace(v) + ")"
	default:
		return "var(--rule-structural-strong)"
	}
}

// benchRowStyle writes the row's identity channel.
func benchRowStyle(r BenchRow) string { return "--cal:" + benchCalToken(r.CalHue) }

// benchNextUpStyle writes an index row's two channels: the calendar's identity
// and the event's axis. Axis is a concrete colour from the operator's own data
// and never references --accent (canon A7).
func benchNextUpStyle(r BenchNextUpRow) string {
	style := "--cal:" + benchCalToken(r.CalHue)
	if a := strings.TrimSpace(r.Axis); a != "" {
		style += ";--axis:" + a
	}
	return style
}

// benchTickStyle positions one tick and carries its axis when the day is live.
func benchTickStyle(t BenchTick) string {
	style := fmt.Sprintf("--m-i:%d", t.Day)
	if a := strings.TrimSpace(t.Axis); a != "" {
		style += ";--axis:" + a
	}
	return style
}

// benchIntAttr renders an int for a data attribute.
func benchIntAttr(n int) string { return fmt.Sprintf("%d", n) }

// benchHeadSubtitle is the .phead's count line — the signed "four calendars in
// Imix — the block below is the widget you embed", with the viewer's own count.
func benchHeadSubtitle(data BenchData) string {
	return fmt.Sprintf("%s in %s — the block below is the widget you embed",
		benchCalendarCount(data.CalendarCount), data.CampaignName)
}

// benchSectionSubtitle is the "4 calendars · 1 needs setup" line. The setup half
// is GM-only: a player is not told that a calendar they cannot fix is broken.
func benchSectionSubtitle(data BenchData) string {
	s := benchCalendarCount(data.CalendarCount)
	if data.IsGM && data.NeedsSetup > 0 {
		s += fmt.Sprintf(" · %d needs setup", data.NeedsSetup)
	}
	return s
}

// benchCalendarCount renders "1 calendar" / "4 calendars".
func benchCalendarCount(n int) string {
	if n == 1 {
		return "1 calendar"
	}
	return fmt.Sprintf("%d calendars", n)
}

// benchNextUpSubtitle names the breadth of the index — across how many of the
// VIEWER's calendars, never the campaign's total.
func benchNextUpSubtitle(u BenchNextUp) string {
	if u.Calendars == 1 {
		return "across 1 calendar"
	}
	return fmt.Sprintf("across %d calendars", u.Calendars)
}

// benchNextUpTail is the signed "all 14 →" line, stated from the VIEWER's own
// index rather than from the mockup's hardcoded 11.
func benchNextUpTail(u BenchNextUp) string {
	return fmt.Sprintf("all %d →", u.Total)
}
