// today_in_world.templ draws the campaign home's "Today in the world" block
// from an already-worded view, so no hidden date, moon or event can reach it.
package calendar

// todayInWorldBlock replaces the placeholder (hx-swap outerHTML).
templ todayInWorldBlock(v todayView) {
	<section class="cb-info cb-today" data-block="today-in-world" aria-labelledby="today-in-world-h">
		<div class="cb-info-top flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 mb-3">
			<h2 id="today-in-world-h" class="cb-head text-sm font-semibold text-fg-secondary uppercase tracking-wider">Today in the world</h2>
			if v.CalendarHref != "" {
				<a href={ templ.SafeURL(v.CalendarHref) } class="cb-more text-xs text-accent hover:underline">Open calendar</a>
			}
		</div>
		<div class="cb-info-rows card cb-card px-4 py-3">
			if v.SetUp {
				<p class="text-sm text-fg-muted">No calendar is set up yet.</p>
			} else {
				if v.Date != "" {
					<p class="break-words text-lg font-semibold text-fg">{ v.Date }</p>
				}
				if v.Weather != "" {
					<p class="mt-2 flex items-center gap-2.5 text-sm text-fg-secondary">
						<i class="fa-solid fa-cloud-sun w-5 flex-none text-center text-fg-muted" aria-hidden="true"></i>
						<span class="min-w-0 break-words">{ v.Weather }</span>
					</p>
				}
				for _, m := range v.Moons {
					<p class="mt-2 flex items-center gap-2.5 text-sm text-fg-secondary">
						<i class="fa-regular fa-moon w-5 flex-none text-center text-fg-muted" aria-hidden="true"></i>
						<span class="min-w-0 break-words">{ m }</span>
					</p>
				}
				if v.Next != "" {
					<p class="mt-3 break-words text-xs text-fg-muted">{ v.Next }</p>
				}
			}
		</div>
	</section>
}
