// page_timeline.templ draws the time line block: a slim line from a page's
// first dated event to the campaign's today, a dot for each event. The
// server has already filtered the events for the viewer, so nothing here is
// hidden by CSS. page_timeline.js opens the hover card on a dot; the styles
// and the arrival moves are in static/css/page_timeline.css.
package calendar

import (
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// PageTimelineBlock is the block. t nil means the campaign has no calendar
// the viewer may open. canAuthor shows the Director a quiet line where a
// player would see nothing at all.
templ PageTimelineBlock(campaignID string, t *PageTimeline, canAuthor bool) {
	if t == nil {
		if canAuthor {
			<section class="ptl cb-card card" aria-label="Time line">
				@pageTimelineStyles()
				<p class="ptl-none">The time line draws from the campaign calendar, and this campaign has none yet.</p>
			</section>
		}
	} else if len(t.Events) == 0 {
		if canAuthor {
			<section class="ptl cb-card card" aria-label="Time line">
				@pageTimelineStyles()
				<p class="ptl-none">
					No dated events belong to this page yet.
					<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/calendars/%s/view", campaignID, t.CalendarID)) }>Open the calendar</a>
				</p>
			</section>
		}
	} else {
		<section class="ptl cb-card card" data-widget="page_timeline" aria-label={ "Time line, " + t.CalendarName }>
			@pageTimelineStyles()
			<p class="sr-only">Today is { t.TodayLabel }.</p>
			<div class="ptl-rail">
				<div class="ptl-track" aria-hidden="true"></div>
				<div class="ptl-fill" aria-hidden="true" style={ fmt.Sprintf("width:%.2f%%", t.FillPercent()) }></div>
				if t.Today >= t.Start && t.Today <= t.End {
					<span class="ptl-today" aria-hidden="true" title={ "Today: " + t.TodayLabel } style={ fmt.Sprintf("left:%.2f%%", t.Percent(t.Today)) }></span>
				}
				<ol class="ptl-dots">
					for i, e := range t.Events {
						<li style={ fmt.Sprintf("left:%.2f%%;--i:%d", t.Percent(e.Abs), i) }>
							<a
								class={ "ptl-ev", templ.KV("ptl-ev--dm cb-dm", e.DMOnly), templ.KV("ptl-ev--now", e.Abs == t.Today), templ.KV("ptl-ev--later", e.Abs > t.Today) }
								href={ templ.SafeURL(pageTimelineEventURL(campaignID, t.CalendarID, e)) }
								aria-label={ pageTimelineEventLabel(e) }
								data-ptl-name={ e.Name }
								data-ptl-date={ e.DateLabel }
								data-ptl-kind={ e.KindName }
								data-ptl-icon={ e.KindIcon }
								if e.DMOnly {
									data-dm-only
								}
								if e.Repeats {
									data-ptl-repeats
								}
							>
								if e.Labelled {
									<span class="ptl-yr" aria-hidden="true">{ fmt.Sprintf("%d", e.Year) }</span>
								}
							</a>
						</li>
					}
				</ol>
			</div>
			if t.Truncated() {
				<p class="ptl-more">
					Showing the first { fmt.Sprintf("%d", len(t.Events)) } of { fmt.Sprintf("%d", t.Total) } events.
					<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/calendars/%s/view", campaignID, t.CalendarID)) }>Open the calendar</a>
				</p>
			}
		</section>
	}
}

// pageTimelineStyles links the block's stylesheet from the block itself, so
// only pages that place it load it.
templ pageTimelineStyles() {
	<link rel="stylesheet" href={ layouts.AssetURL("/static/css/page_timeline.css") }/>
}

// pageTimelineEventURL opens the event's day on its calendar, with the event
// picked out (calendar_view.js, _linkTarget).
func pageTimelineEventURL(campaignID, calendarID string, e PageTimelineEvent) string {
	return fmt.Sprintf("/campaigns/%s/calendars/%s/view?event=%s&date=%d-%d-%d", campaignID, calendarID, e.ID, e.Year, e.Month, e.Day)
}

// pageTimelineEventLabel is what a screen reader hears for a dot.
func pageTimelineEventLabel(e PageTimelineEvent) string {
	s := e.DateLabel + ": " + e.Name
	if e.DMOnly {
		s += " (Director only)"
	}
	return s
}
