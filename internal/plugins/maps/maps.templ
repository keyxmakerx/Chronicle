// maps.templ renders the maps UI: map list page, Leaflet.js map viewer,
// marker creation/editing modals. Leaflet CSS+JS are loaded inline on
// the map viewer page to avoid bloating other pages.

package maps

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// MapListPage renders the full map list page.
templ MapListPage(cc *campaigns.CampaignContext, data MapListData) {
	@layouts.App("Maps") {
		@mapListContent(cc, data)
	}
}

// MapListFragment renders the map list as an HTMX fragment.
templ MapListFragment(cc *campaigns.CampaignContext, data MapListData) {
	@mapListContent(cc, data)
}

// mapListContent renders the map list body.
templ mapListContent(cc *campaigns.CampaignContext, data MapListData) {
	<div class="max-w-4xl mx-auto py-6 px-4">
		@mapFrameStyles()
		@components.Breadcrumbs([]components.BreadcrumbItem{
			{Label: cc.Campaign.Name, Href: fmt.Sprintf("/campaigns/%s", cc.Campaign.ID), Icon: "fa-dice-d20"},
			{Label: "Maps"},
		})
		<div class="flex items-center justify-between mb-6">
			<div>
				<h1 class="text-xl font-bold text-fg">Maps</h1>
				<p class="text-sm text-fg-secondary mt-1">
					if len(data.Maps) == 0 {
						No maps yet. Create one to get started.
					} else {
						{ fmt.Sprintf("%d map(s)", len(data.Maps)) }
					}
				</p>
			</div>
			if data.IsOwner {
				<button
					class="btn-primary text-sm"
					onclick="document.getElementById('create-map-modal').classList.remove('hidden')"
				>
					<i class="fa-solid fa-plus mr-1"></i> New Map
				</button>
			}
		</div>
		if len(data.Maps) > 0 {
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				for _, m := range data.Maps {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/maps/%s", data.CampaignID, m.ID)) }
						class="card p-4 hover:ring-2 hover:ring-accent/30 transition-all group"
					>
						// The campaign's frame in small form: the same stylesheet and
						// ornament blocks as the map page, switched by data-frame.
						<div class="mp-frame mp-mini mb-3" data-frame={ data.CampaignFrame } data-tint="1" style="aspect-ratio: 16 / 9; flex: none;">
							@mapFrameOrnaments(m.Name)
							<div class="mp-viewport">
								<div class="mp-art-wrap">
									if m.HasImage() {
										<img
											src={ mapImageSrc(ctx, &m) }
											alt={ m.Name }
											class="mp-art group-hover:scale-105 transition-transform duration-300"
										/>
									} else {
										<i class="fa-solid fa-map text-3xl text-fg-muted"></i>
									}
								</div>
							</div>
						</div>
						<h3 class="text-sm font-semibold text-fg truncate">{ m.Name }</h3>
						if m.Description != nil && *m.Description != "" {
							<p class="text-xs text-fg-secondary mt-1 line-clamp-2">{ *m.Description }</p>
						}
					</a>
				}
			</div>
		} else {
			<div class="card p-12 text-center">
				<i class="fa-solid fa-map text-4xl text-fg-muted mb-4"></i>
				<p class="text-fg-secondary">No maps yet.</p>
				if data.IsOwner {
					<p class="text-sm text-fg-muted mt-2">Click "New Map" to create your first map.</p>
				}
			</div>
		}
		if data.IsOwner {
			@createMapModal(data)
		}
	</div>
}

// createMapModal renders the form to create a new map.
templ createMapModal(data MapListData) {
	<div
		id="create-map-modal"
		class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50"
		onclick="if(event.target===this)this.classList.add('hidden')"
	>
		<div class="card p-6 w-full max-w-md space-y-4">
			<div class="flex items-center justify-between">
				<h2 class="text-lg font-semibold text-fg">New Map</h2>
				<button class="text-fg-muted hover:text-fg" onclick="document.getElementById('create-map-modal').classList.add('hidden')">
					<i class="fa-solid fa-xmark"></i>
				</button>
			</div>
			<form
				method="POST"
				action={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/maps/new", data.CampaignID)) }
				class="space-y-3"
			>
				<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
				<div>
					<label class="block text-xs font-medium text-fg-body mb-1">Map Name</label>
					<input type="text" name="name" class="input w-full" required placeholder="e.g. World Map, City of Neverwinter"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-fg-body mb-1">Description</label>
					<textarea name="description" class="input w-full" rows="2" placeholder="Optional description"></textarea>
				</div>
				<div class="flex justify-end gap-2 pt-2">
					<button type="button" class="btn-secondary text-xs" onclick="document.getElementById('create-map-modal').classList.add('hidden')">
						Cancel
					</button>
					<button type="submit" class="btn-primary text-xs">
						<i class="fa-solid fa-plus mr-1"></i> Create Map
					</button>
				</div>
			</form>
		</div>
	</div>
}

// MapShowPage renders the full map viewer page with Leaflet.
templ MapShowPage(cc *campaigns.CampaignContext, data MapViewData) {
	@layouts.App(data.Map.Name) {
		@mapShowContent(cc, data)
	}
}

// MapShowFragment renders the map viewer as an HTMX fragment.
templ MapShowFragment(cc *campaigns.CampaignContext, data MapViewData) {
	@mapShowContent(cc, data)
}

// MapViewerFragment is the bare framed viewer, fetched by the focus view that
// unfolds over an entity page. It is the same frame, markup and config the map
// page renders (so the viewer behaves identically) minus the page header; the
// fragment carries no script, the caller starts the viewer on #map-config.
templ MapViewerFragment(cc *campaigns.CampaignContext, data MapViewData) {
	@mapFrameStyles()
	<div class="mp-stage" style="min-height: 0; height: 100%;">
		<div class="mp-frame" id="mp-frame" data-frame={ data.DisplayOrDefault().Frame } data-tint={ boolDigit(data.DisplayOrDefault().Tint) }>
			@mapFrameOrnaments(data.Map.Name)
			<div class="mp-viewport">
				@MapEditorBody(cc, data, "absolute inset-0", "")
			</div>
		</div>
	</div>
}

// mapShowContent renders the dedicated map page: page-level wrapper + the
// breadcrumbs/title header + the editor body. The editor body itself is
// extracted into MapEditorBody so it can be reused inline by the per-entity
// Map Editor block.
templ mapShowContent(cc *campaigns.CampaignContext, data MapViewData) {
	<div class="h-full flex flex-col -mx-5 -my-4">
		<!-- Map header with name, back link, and controls -->
		<div class="bg-surface border-b border-edge px-6 py-3 flex items-center justify-between shrink-0">
			<div class="flex items-center gap-3">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/maps", data.CampaignID)) }
					class="p-2 rounded-md hover:bg-surface-alt text-fg-secondary hover:text-fg transition-colors"
					title="Back to maps"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
				</a>
				<div>
					<nav class="text-xs text-fg-muted mb-0.5" aria-label="Breadcrumb">
						<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s", data.CampaignID)) } class="hover:text-fg-body">{ cc.Campaign.Name }</a>
						<span class="mx-1">/</span>
						<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/maps", data.CampaignID)) } class="hover:text-fg-body">Maps</a>
						<span class="mx-1">/</span>
						<span class="text-fg-secondary">{ data.Map.Name }</span>
					</nav>
					<div class="flex items-center gap-2">
						<h1 class="text-lg font-semibold text-fg">{ data.Map.Name }</h1>
						// VTT presence pill, owned by foundry_vtt and lazy-loaded
						// so this plugin stays VTT-agnostic.
						<span
							hx-get={ fmt.Sprintf("/campaigns/%s/foundry-vtt/presence-pill-fragment", data.CampaignID) }
							hx-trigger="load"
							hx-swap="outerHTML"
						></span>
					</div>
					if data.Map.Description != nil && *data.Map.Description != "" {
						<p class="text-xs text-fg-muted">{ *data.Map.Description }</p>
					}
				</div>
			</div>
		</div>

		<!-- The map sits in the campaign's frame (or this map's own pick): a mat
		     and ornaments around the viewport, switched by data-frame. The
		     ornaments are decoration only: aria-hidden and never take pointer
		     events. The viewport is the positioning context the editor body fills. -->
		@mapFrameStyles()
		<div class="mp-stage">
			<div class="mp-frame" id="mp-frame" data-frame={ data.DisplayOrDefault().Frame } data-tint={ boolDigit(data.DisplayOrDefault().Tint) }>
				@mapFrameOrnaments(data.Map.Name)
				<div class="mp-viewport">
					@MapEditorBody(cc, data, "absolute inset-0", "")
				</div>
			</div>
		</div>
	</div>
}

// MapEditorBody renders the map viewer's markup: the map wrapper with its
// floating controls (mapControls), modals, the server-rendered #map-config div
// and the viewer's CSS. The behaviour is static/js/map_viewer.js,
// started by the data-widget on #map-config. The class and style parameters
// size the wrapper. It is used by the dedicated map page (mapShowContent,
// mapContainerClass="absolute inset-0" so the wrapper fills the frame's
// viewport) and by the focus view's fragment (MapViewerFragment), which wraps it
// in the same frame.
//
// CONSTRAINT: only one MapEditorBody may exist per page, because the viewer
// binds to fixed IDs like #map-container, #marker-modal, etc.
templ MapEditorBody(cc *campaigns.CampaignContext, data MapViewData, mapContainerClass, mapContainerStyle string) {
	<!-- Leaflet CSS (vendored locally for CSP compliance). Browsers dedupe
	     link tags by URL. The scripts are loaded by the viewer module. -->
	<link rel="stylesheet" href={ layouts.AssetURL("/static/vendor/leaflet.css") }/>
	<!-- MarkerCluster plugin for auto-grouping dense markers at low zoom -->
	<link rel="stylesheet" href={ layouts.AssetURL("/static/vendor/MarkerCluster.css") }/>

	<!-- Map wrapper. Caller controls class + height via the parameters so the
	     same body works for flex-fill (dedicated page) and fixed-height embed
	     (entity block). Every control floats over the map inside this wrapper,
	     each in its own corner; the Leaflet container is the layer beneath. -->
	<div id="map-wrap" class={ "mp-wrap " + mapContainerClass } style={ mapContainerStyle }>
		<div id="map-container" class="absolute inset-0 bg-surface-alt" style={ mapBackgroundStyle(data.Map.BackgroundColor) }></div>
		@mapControls(data)
	</div>

	if data.IsScribe {
		@markerModal(data)
	}

	<!-- Server-rendered map data, read by the viewer module.
	     A hidden div with data attributes is the stable channel: dataset reads
	     handle quoting/escaping for us, and the module needs no inline script. -->
	<div
		id="map-config"
		class="hidden"
		data-widget="map-viewer"
		data-campaign-id={ data.CampaignID }
		data-leaflet-src={ layouts.AssetURL("/static/vendor/leaflet.js") }
		data-cluster-src={ layouts.AssetURL("/static/vendor/leaflet.markercluster.js") }
		data-draw-src={ scriptURL("map_drawing_tools.js") }
		data-shadow-src={ scriptURL("map_shadow.js") }
		data-pictures-src={ scriptURL("map_pictures.js") }
		data-annotations-src={ scriptURL("map_annotations.js") }
		data-hex-art-src={ scriptURL("map_hex_art.js") }
		data-hexes-src={ scriptURL("map_hexes.js") }
		data-live-src={ scriptURL("map_live.js") }
		data-map-id={ data.Map.ID }
		data-image-id={ derefStr(data.Map.ImageID) }
		data-image-url={ mapImageSrc(ctx, data.Map) }
		data-image-width={ fmt.Sprintf("%d", data.Map.ImageWidth) }
		data-image-height={ fmt.Sprintf("%d", data.Map.ImageHeight) }
		data-is-scribe={ fmt.Sprintf("%t", data.IsScribe) }
		data-is-owner={ fmt.Sprintf("%t", cc.MemberRole >= campaigns.RoleOwner || cc.IsSiteAdmin) }
		data-can-dm-only={ fmt.Sprintf("%t", cc.CanAuthorDmOnly() || cc.IsSiteAdmin) }
		data-can-draw={ fmt.Sprintf("%t", data.CanDraw()) }
		data-can-paint-hexes={ fmt.Sprintf("%t", data.CanPaintHexes()) }
		data-can-move-party={ fmt.Sprintf("%t", data.CanMoveParty()) }
		data-can-fog={ fmt.Sprintf("%t", data.IsDM) }
		data-can-shadow={ fmt.Sprintf("%t", data.CanShadow()) }
		data-user-id={ data.UserID }
		data-display={ mustMarshalDisplay(data.DisplayOrDefault()) }
		data-markers={ mustMarshalMarkers(data.Markers) }
	></div>

	// The viewer itself is static/js/map_viewer.js, mounted by boot.js from
	// the data-widget on #map-config. Leaflet, MarkerCluster and the drawing
	// module are loaded by it on demand (urls on the config div), so no page
	// script tag is needed and the same markup works when fetched as a fragment.

	<!-- CSS for Leaflet marker icons, the floating map controls and pin cards.
	     Theme tokens come from the app's custom properties so light and dark
	     both work; the accent follows the campaign accent. -->
	<style>
		.chronicle-marker { background: none !important; border: none !important; }
		.chronicle-cluster { background: none !important; border: none !important; }
		.chronicle-cluster-icon {
			width: 32px; height: 32px; line-height: 32px;
			text-align: center; font-size: 13px; font-weight: 600;
			color: #fff; background: rgb(var(--color-accent-rgb, 99 102 241) / 0.9);
			border-radius: 50%; box-shadow: 0 1px 4px rgba(0,0,0,0.3);
		}
		.map-text-annotation { background: none !important; border: none !important; }
		.mp-pin { position: relative; }
		.mp-pin svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.35)); }
		.mp-pin-ico { position: absolute; transform: translate(-50%, -50%); color: #fff; line-height: 1; filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.55)); pointer-events: none; }
		.mp-pin-badge {
			position: absolute; top: -4px; right: -8px; width: 14px; height: 14px;
			display: grid; place-items: center; border-radius: 50%;
			background: #111827; color: #fff; font-size: 8px; text-shadow: none;
			border: 1px solid #fff;
		}
		.mp-pin-badge i { position: static; transform: none; font-size: 8px; filter: none; }
		/* The pin's name: a light label that reads on any map picture. */
		.leaflet-tooltip.mp-name { background: var(--color-card-bg); color: var(--color-text-primary); border: 1px solid var(--color-border); border-radius: 6px; box-shadow: var(--mp-shadow); font-size: 12px; padding: 2px 7px; }
		.leaflet-tooltip.mp-name::before { display: none; }
		.mp-grid { pointer-events: none; }

		/* The Hexes tool's icon and panel. The panel sits beside the rail like
		   the draw flyouts; the hexes themselves are an SVG in map_hexes.js. */
		.mp-hexico { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
		.mp-shapeico { width: 16px; height: 16px; stroke-width: 2; stroke-linecap: round; }
		.mp-hexpanel { top: 58px; left: 58px; width: 260px; max-height: calc(100% - 80px); overflow: auto; padding: 0 12px 12px; display: flex; flex-direction: column; gap: 9px; font-size: 12.5px; color: var(--color-text-primary); animation: mp-hx-panel 0.22s cubic-bezier(0.2, 0.8, 0.2, 1); }
		.mp-hexpanel > * { flex-shrink: 0; }
		.mp-hexpanel .mp-hx-head { display: flex; align-items: center; justify-content: space-between; font-weight: 600; padding: 10px 0 2px; position: sticky; top: 0; background: var(--mp-float); }
		.mp-hexpanel .mp-hx-x { border: 0; background: none; width: 26px; height: 26px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--color-text-secondary); }
		.mp-hexpanel .mp-hx-x:hover { background: var(--color-bg-tertiary); }
		.mp-hexpanel p { margin: 0; color: var(--color-text-secondary); }
		.mp-hexpanel .mp-hx-pal { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
		.mp-hexpanel .mp-hx-pal button { border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-card-bg); padding: 5px 3px; font-size: 11px; display: flex; flex-direction: column; align-items: center; gap: 3px; color: var(--color-text-primary); }
		.mp-hexpanel .mp-hx-pal button[aria-pressed="true"] { border-color: var(--mp-accent); box-shadow: 0 0 0 2px var(--mp-accent-soft); }
		.mp-hexpanel .mp-hx-pal svg { display: block; overflow: visible; }
		.mp-hexpanel .mp-hx-pal i { width: 22px; height: 13px; border-radius: 3px; display: block; background: repeating-linear-gradient(45deg, #ccc 0 3px, #fff 3px 6px); }
		/* The Art chips and the piece picker in Paint. Folders are dashed so they
		   read as something to open rather than a piece to paint with. */
		.mp-hexpanel .mp-hx-art { gap: 4px; align-items: center; }
		.mp-hexpanel .mp-hx-art > span { font-size: 11.5px; margin-right: 2px; color: var(--color-text-secondary); }
		.mp-hexpanel .mp-hx-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
		.mp-hexpanel .mp-hx-pcs-h { display: flex; flex-direction: column; gap: 1px; font-size: 12px; }
		.mp-hexpanel .mp-hx-pcs-h span { font-size: 11px; color: var(--color-text-secondary); }
		.mp-hexpanel .mp-hx-pcs button { font-size: 10.5px; line-height: 1.15; text-align: center; padding: 4px 2px; }
		.mp-hexpanel .mp-hx-pcs .mp-hx-pf { border-style: dashed; }
		.mp-hexpanel .mp-hx-cnt { font-size: 9.5px; color: var(--color-text-secondary); }
		.mp-hexpanel .mp-hx-pfback { align-self: flex-start; font-size: 11.5px; padding: 3px 8px; }
		.mp-hexpanel .mp-hx-pfname { font-weight: 600; font-size: 12px; }
		.mp-hexpanel .mp-hx-card { border: 1px solid var(--color-border); border-radius: 10px; padding: 9px; display: flex; flex-direction: column; gap: 6px; }
		.mp-hexpanel .mp-hx-card b { font-size: 14px; }
		.mp-hexpanel .mp-hx-card .mp-input { width: 100%; }
		.mp-hexpanel .mp-hx-card span { white-space: pre-wrap; overflow-wrap: anywhere; }
		.mp-hexpanel .mp-hx-trip { background: var(--mp-accent-soft); border-radius: 8px; padding: 8px 10px; color: var(--color-text-primary); }
		.mp-hexpanel .mp-hx-trip b { display: block; font-size: 15px; }
		.mp-hexpanel .mp-hx-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
		.mp-hexpanel .mp-hx-row input[type="number"] { width: 64px; }
		.mp-hexpanel .mp-hx-foot { border-top: 1px solid var(--color-border); padding-top: 8px; margin-top: 2px; }
		.mp-hexpanel .mp-hx-off { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--color-border); background: var(--color-card-bg); border-radius: 7px; padding: 5px 10px 5px 8px; font-size: 12.5px; color: var(--color-text-body); transition: background-color 0.12s, color 0.12s, transform 0.08s; }
		.mp-hexpanel .mp-hx-off:hover { background: var(--color-bg-tertiary); color: var(--color-text-primary); }
		.mp-hexpanel .mp-hx-off:active { transform: scale(0.98); }
		.mp-hx-off .mp-hexico { width: 15px; height: 15px; }
		@keyframes mp-hx-panel { from { opacity: 0; transform: translateY(-6px); } }
		.mp-hx-fade { animation: mp-hx-fade 0.5s ease both; }
		@keyframes mp-hx-fade { from { opacity: 0; } }
		.mp-hx-in { animation: mp-hx-in 0.48s cubic-bezier(0.2, 0.9, 0.3, 1.18) both; transform-box: fill-box; transform-origin: 50% 62%; }
		.mp-hx-out { animation: mp-hx-out 0.36s ease-in both; transform-box: fill-box; transform-origin: 50% 62%; }
		@keyframes mp-hx-in { from { opacity: 0; transform: scale(0.5); } to { opacity: 1; transform: none; } }
		@keyframes mp-hx-out { to { opacity: 0; transform: scale(0.8); } }
		@media (max-width: 760px) {
			.mp-hexpanel { left: 12px; right: 12px; width: auto; top: auto; bottom: 64px; max-height: 46%; }
		}
		@media (prefers-reduced-motion: reduce) {
			.mp-hexpanel, .mp-hx-in, .mp-hx-out, .mp-hx-fade { animation: none !important; }
		}

		#map-wrap {
			--mp-accent: rgb(var(--color-accent-rgb, 99 102 241));
			--mp-accent-soft: rgb(var(--color-accent-rgb, 99 102 241) / 0.14);
			--mp-float: rgb(255 255 255 / 0.94);
			--mp-shadow: 0 1px 2px rgb(15 17 23 / 0.06), 0 8px 24px rgb(15 17 23 / 0.12);
			isolation: isolate; /* controls stack above Leaflet's panes without leaking out */
		}
		.dark #map-wrap { --mp-float: rgb(31 41 55 / 0.94); --mp-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 10px 28px rgb(0 0 0 / 0.45); }
		#map-wrap:fullscreen { background: var(--color-bg-primary); }

		.mp-fl {
			position: absolute; z-index: 1100; background: var(--mp-float);
			-webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
			border: 1px solid var(--color-border); border-radius: 10px;
			box-shadow: var(--mp-shadow); color: var(--color-text-body);
		}
		#map-wrap [hidden] { display: none !important; }
		/* Zero specificity, so any class below that sets a button's size or
		   colour wins over this reset. */
		:where(#map-wrap) button { font: inherit; color: inherit; cursor: pointer; }
		#map-wrap :focus-visible { outline: 2px solid var(--mp-accent); outline-offset: 2px; }

		.mp-search { top: 12px; left: 12px; display: flex; align-items: center; gap: 8px; padding: 0 10px; height: 36px; width: 230px; color: var(--color-text-secondary); }
		.mp-search input { border: 0; background: none; outline: none; box-shadow: none; font-size: 13px; color: var(--color-text-primary); width: 100%; padding: 0; }
		.mp-search input:focus-visible { outline: none; }
		.mp-search:focus-within { outline: 2px solid var(--mp-accent); outline-offset: 2px; }
		.mp-results { position: absolute; top: 40px; left: 0; right: 0; background: var(--color-card-bg); border: 1px solid var(--color-border); border-radius: 10px; box-shadow: var(--mp-shadow); padding: 4px; max-height: 240px; overflow: auto; }
		.mp-results button { display: flex; gap: 8px; align-items: center; width: 100%; text-align: left; border: 0; background: none; padding: 6px 8px; border-radius: 6px; font-size: 13px; color: var(--color-text-primary); }
		.mp-results button:hover, .mp-results button:focus-visible { background: var(--color-bg-tertiary); }
		.mp-results small { margin-left: auto; color: var(--color-text-secondary); }
		.mp-empty { margin: 0; padding: 8px; font-size: 12px; color: var(--color-text-secondary); }
		.mp-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; display: inline-block; }

		.mp-rail { top: 58px; left: 12px; display: flex; flex-direction: column; padding: 4px; gap: 2px; }
		.mp-item { position: relative; }
		.mp-btn { position: relative; width: 36px; height: 36px; border: 0; border-radius: 7px; background: none; color: var(--color-text-body); display: flex; align-items: center; justify-content: center; font-size: 16px; }
		.mp-btn:hover:not(:disabled) { background: var(--color-bg-tertiary); color: var(--color-text-primary); }
		.mp-btn[aria-pressed="true"] { background: var(--mp-accent-soft); color: var(--mp-accent); }
		.mp-btn:disabled { opacity: 0.4; cursor: default; }
		.mp-tip { position: absolute; left: 44px; top: 50%; transform: translateY(-50%); white-space: nowrap; background: var(--color-text-primary); color: var(--color-bg-primary); font-size: 11px; padding: 3px 7px; border-radius: 5px; opacity: 0; pointer-events: none; transition: opacity 0.12s; z-index: 2; }
		.mp-btn:hover .mp-tip, .mp-btn:focus-visible .mp-tip { opacity: 1; }
		.mp-tip kbd { font: 10px ui-monospace, monospace; opacity: 0.7; margin-left: 6px; }
		.mp-sep { height: 1px; background: var(--color-border); margin: 3px 4px; }
		.mp-swatch { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--color-card-bg); box-shadow: 0 0 0 1px var(--color-border); }
		.mp-fly { left: 48px; top: 0; padding: 6px; display: flex; gap: 2px; flex-wrap: wrap; width: max-content; max-width: 220px; }
		.mp-fly-label { flex-basis: 100%; font-size: 11px; color: var(--color-text-secondary); padding: 2px 4px 4px; text-transform: uppercase; letter-spacing: 0.06em; }
		.mp-fly-gap { margin-top: 6px; }
		#mp-fly-style { max-width: 260px; }
		.mp-fly-col { flex-direction: column; flex-wrap: nowrap; align-items: stretch; max-width: 250px; }
		/* Menu rows (the Make a hex map flyout). */
		.mp-mrow { display: flex; align-items: center; gap: 10px; width: 100%; border: 0; background: none; border-radius: 7px; padding: 7px 10px 7px 8px; text-align: left; font-size: 13px; line-height: 1.3; color: var(--color-text-primary); transition: background-color 0.12s, transform 0.08s; }
		.mp-mrow:hover { background: var(--color-bg-tertiary); }
		.mp-mrow:active { transform: scale(0.98); }
		.mp-mrow:focus-visible { outline: 2px solid var(--mp-accent); outline-offset: -2px; }
		.mp-mrow-ico { flex: none; width: 28px; height: 28px; border-radius: 7px; background: var(--mp-accent-soft); color: var(--mp-accent); display: flex; align-items: center; justify-content: center; }
		.mp-mrow-txt { display: flex; flex-direction: column; min-width: 0; }
		.mp-mrow-txt b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		.mp-mrow-txt small { font-size: 11.5px; color: var(--color-text-secondary); }
		#mp-fly-hex { width: 250px; padding: 6px; }
		.mp-fly-help { font-size: 11.5px; color: var(--color-text-secondary); padding: 4px 4px 2px; }
		.mp-sw { width: 24px; height: 24px; border-radius: 50%; border: 2px solid transparent; box-shadow: inset 0 0 0 1px var(--color-border); padding: 0; margin: 2px; }
		.mp-sw[aria-pressed="true"] { border-color: var(--color-text-primary); }
		.mp-wd { border: 1px solid var(--color-border); background: var(--color-card-bg); border-radius: 6px; padding: 3px 9px; font-size: 12px; }
		.mp-wd[aria-pressed="true"] { background: var(--mp-accent); border-color: var(--mp-accent); color: #fff; }

		.mp-topright { position: absolute; top: 12px; right: 12px; z-index: 1100; display: flex; gap: 8px; }
		.mp-pill { position: static; height: 36px; display: flex; align-items: center; gap: 7px; padding: 0 12px; font-size: 13px; color: var(--color-text-primary); }
		.mp-pill-icon { width: 36px; justify-content: center; padding: 0; }
		.mp-pill:hover { background: var(--color-card-bg); }
		.mp-panel { top: 56px; right: 12px; bottom: 212px; width: 260px; padding: 12px; overflow: auto; font-size: 13px; }
		.mp-sec { display: flex; flex-direction: column; gap: 2px; margin-bottom: 14px; }
		.mp-sec h3 { margin: 0 0 6px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-secondary); font-weight: 600; }
		.mp-tg, .mp-pl { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border-radius: 6px; border: 0; background: none; width: 100%; text-align: left; color: var(--color-text-primary); }
		.mp-tg:hover, .mp-pl:hover { background: var(--color-bg-tertiary); }
		.mp-tg[aria-pressed="false"] { color: var(--color-text-muted); }
		.mp-tg[aria-pressed="false"] .mp-dot { opacity: 0.3; }
		.mp-n { margin-left: auto; font: 11px ui-monospace, monospace; color: var(--color-text-secondary); }
		.mp-eye { width: 9px; text-align: center; font-size: 11px; color: var(--color-text-secondary); }
		.mp-pl { font-size: 12.5px; color: var(--color-text-body); }
		.mp-pl-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		.mp-pl em { margin-left: auto; font-style: normal; font-size: 10.5px; color: var(--color-text-secondary); flex: none; }

		.mp-zoom { right: 12px; bottom: 12px; display: flex; flex-direction: column; padding: 4px; gap: 2px; }
		.mp-zoom .mp-tip { left: auto; right: 44px; }
		.mp-lvl { font: 11px ui-monospace, monospace; text-align: center; color: var(--color-text-secondary); padding: 2px 0; }
		.mp-hint { left: 50%; bottom: 14px; transform: translateX(-50%); padding: 7px 12px; font-size: 12.5px; color: var(--color-text-primary); white-space: nowrap; pointer-events: none; }

		/* Pin cards: Leaflet popups restyled to match the floating controls. */
		.mp-card-popup .leaflet-popup-content-wrapper { background: var(--color-card-bg); color: var(--color-text-body); border: 1px solid var(--color-border); border-radius: 10px; box-shadow: var(--mp-shadow); padding: 0; }
		.mp-card-popup .leaflet-popup-tip { background: var(--color-card-bg); border: 1px solid var(--color-border); box-shadow: none; }
		.mp-card-popup .leaflet-popup-content { margin: 0; font-size: 12.5px; line-height: 1.4; }
		.mp-card-popup a.leaflet-popup-close-button { color: var(--color-text-secondary); }
		.mp-card { padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; }
		.mp-card-title { display: flex; gap: 6px; align-items: center; font-size: 14px; color: var(--color-text-primary); padding-right: 14px; }
		.mp-card-meta { font-size: 11px; color: var(--color-text-secondary); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
		.mp-badge { display: inline-flex; gap: 4px; align-items: center; padding: 1px 6px; border-radius: 999px; background: var(--color-bg-tertiary); }
		.mp-card-desc { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 140px; overflow: auto; }
		.mp-card-link { color: var(--mp-accent); font-size: 12px; text-decoration: none; }
		.mp-card-link:hover { text-decoration: underline; }
		.mp-field { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--color-text-secondary); }
		.mp-input { width: 100%; font: inherit; font-size: 12.5px; padding: 5px 7px; border: 1px solid var(--color-input-border, var(--color-border)); border-radius: 6px; background: var(--color-input-bg, var(--color-card-bg)); color: var(--color-text-primary); }
		.mp-card-row { display: flex; gap: 6px; margin-top: 4px; }
		.mp-cbtn { border: 1px solid var(--color-border); background: var(--color-card-bg); border-radius: 7px; padding: 5px 10px; font-size: 12px; color: var(--color-text-body); }
		.mp-cbtn:hover:not(:disabled) { background: var(--color-bg-tertiary); }
		.mp-cbtn-primary { background: var(--mp-accent); border-color: var(--mp-accent); color: #fff; }
		.mp-cbtn-primary:hover:not(:disabled) { background: var(--mp-accent); filter: brightness(1.08); }
		.mp-cbtn:disabled { opacity: 0.6; }
		.mp-card-more { align-self: flex-start; border: 0; background: none; padding: 0; font-size: 11.5px; color: var(--mp-accent); }
		.mp-card-more:hover { text-decoration: underline; }

		/* Narrow screens: the tool rail becomes a bar along the bottom-left. */
		@media (max-width: 760px) {
			.mp-search { width: calc(100% - 150px); }
			.mp-rail { top: auto; bottom: 12px; left: 12px; flex-direction: row; }
			.mp-rail .mp-sep { width: 1px; height: auto; margin: 4px 3px; }
			.mp-tip { display: none; }
			.mp-fly { left: 0; top: auto; bottom: 46px; }
			.mp-zoom { bottom: 64px; }
			.mp-hint { bottom: 64px; white-space: normal; width: calc(100% - 24px); text-align: center; }
			.mp-panel { left: 12px; width: auto; right: 12px; bottom: 120px; }
			.mp-pill span { display: none; }
			.mp-pill { padding: 0; width: 36px; justify-content: center; }
		}

		/* Map settings sheet: floats at the right edge over the map, scrolls on
		   its own, and keeps its title and Save row in view. */
		.mp-sheet { top: 12px; right: 12px; bottom: 12px; width: 300px; z-index: 1150; display: flex; flex-direction: column; font-size: 13px; overflow: hidden; }
		.mp-sheet[hidden] { display: none; }
		.mp-sh { display: flex; align-items: center; justify-content: space-between; padding: 8px 8px 8px 14px; border-bottom: 1px solid var(--color-border); color: var(--color-text-primary); font-weight: 600; flex: none; }
		.mp-sh-body { flex: 1; overflow: auto; min-height: 0; }
		.mp-sh-body section { padding: 12px 14px; border-bottom: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 9px; }
		.mp-sh-body h3 { margin: 0; font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-secondary); font-weight: 600; }
		.mp-sh-foot { display: flex; justify-content: flex-end; gap: 8px; padding: 10px 14px; border-top: 1px solid var(--color-border); flex: none; }
		.mp-f { display: flex; flex-direction: column; gap: 5px; font-size: 12px; color: var(--color-text-body); }
		.mp-f small { font-size: 11px; color: var(--color-text-secondary); }
		.mp-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
		.mp-chips { display: flex; flex-wrap: wrap; gap: 4px; }
		.mp-chip { border: 1px solid var(--color-border); background: var(--color-card-bg); border-radius: 999px; padding: 3px 10px; font-size: 12px; color: var(--color-text-body); }
		.mp-chip:hover { background: var(--color-bg-tertiary); }
		.mp-chip[aria-pressed="true"] { background: var(--mp-accent); border-color: var(--mp-accent); color: #fff; }
		.mp-check { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 12.5px; color: var(--color-text-body); }
		.mp-check input { accent-color: var(--mp-accent); width: 16px; height: 16px; }
		.mp-sheet input[type=range] { width: 100%; accent-color: var(--mp-accent); }
		.mp-sheet input[type=range]:disabled { opacity: 0.45; }
		.mp-color { width: 44px; height: 28px; padding: 1px; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-card-bg); }
		.mp-kind { display: flex; align-items: center; gap: 8px; }
		.mp-kind input[type=color] { width: 28px; height: 26px; padding: 0; border: 0; background: none; flex: none; }
		.mp-kind .mp-input { flex: 1; min-width: 0; }
		.mp-hx-travel { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
		.mp-hx-travel .mp-input { width: 64px; }
		.mp-preview { width: 100%; max-height: 140px; object-fit: contain; border-radius: 6px; background: var(--color-bg-tertiary); }
		.mp-file { font-size: 11.5px; padding: 3px; }
		.mp-danger { align-self: flex-start; border: 0; background: none; padding: 4px 6px; border-radius: 6px; font-size: 12px; color: #dc2626; }
		.mp-danger:hover { background: rgb(220 38 38 / 0.1); }
		@media (max-width: 760px) {
			.mp-sheet { left: 12px; width: auto; }
		}
		@media (prefers-reduced-motion: reduce) {
			.mp-tip { transition: none; }
			.leaflet-fade-anim .leaflet-popup, .leaflet-zoom-anim .leaflet-zoom-animated { transition: none !important; }
		}

	</style>
}

// mapControls renders the controls that float over the map, each in its own
// corner: search and tool rail (top-left), pins and layers (top-right), zoom
// (bottom-right) and the active-tool hint (bottom-centre). They are siblings of
// the Leaflet container, not Leaflet controls, so the map never sees their
// clicks, wheel or double-clicks. All behaviour is wired by the IIFE in
// MapEditorBody; this is markup only, and the tool rail is Scribe+ only.
templ mapControls(data MapViewData) {
	<div class="mp-fl mp-search">
		<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
		<input
			type="text"
			id="marker-search"
			placeholder="Search pins"
			autocomplete="off"
			aria-label="Search pins"
		/>
		<div id="mp-results" class="mp-results" hidden></div>
	</div>
	<!-- The rail is for scribes; everyone else gets it only while the map has
	     hexes, holding Move and the Hexes tool, so a player can open a hex's
	     card. The viewer shows or hides the Hexes button as the grid changes. -->
	<div class="mp-fl mp-rail" role="toolbar" aria-label="Map tools" hidden?={ !data.IsScribe && data.DisplayOrDefault().GridType != "hex" }>
		<button type="button" class="mp-btn" data-tool="move" aria-pressed="true" aria-label="Move the map (V)">
			<i class="fa-solid fa-hand" aria-hidden="true"></i>
			<span class="mp-tip">Move the map <kbd>V</kbd></span>
		</button>
		if data.IsScribe {
			<button type="button" class="mp-btn" data-tool="pin" aria-pressed="false" aria-label="Drop a pin (P)">
				<i class="fa-solid fa-location-dot" aria-hidden="true"></i>
				<span class="mp-tip">Drop a pin <kbd>P</kbd></span>
			</button>
			if data.CanDraw() {
			<div class="mp-item">
				<button type="button" class="mp-btn" data-tool="draw" aria-pressed="false" aria-expanded="false" aria-label="Draw (D)">
					<i class="fa-solid fa-pen" aria-hidden="true"></i>
					<span class="mp-tip">Draw <kbd>D</kbd></span>
				</button>
				<div id="mp-fly-draw" class="mp-fl mp-fly" hidden>
					<div class="mp-fly-label">Draw</div>
					<!-- The shapes in the signed design's order. The four annotation icons
					     are the design's own line icons, drawn like the hex icon. -->
					<button type="button" class="mp-btn" data-shape="freehand" aria-pressed="false" aria-label="Freehand"><i class="fa-solid fa-pen" aria-hidden="true"></i><span class="mp-tip">Freehand line</span></button>
					<button type="button" class="mp-btn" data-shape="arrow" aria-pressed="false" aria-label="Arrow"><svg class="mp-hexico mp-shapeico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19L19 5M19 5h-8M19 5v8"/></svg><span class="mp-tip">Arrow</span></button>
					<button type="button" class="mp-btn" data-shape="rectangle" aria-pressed="false" aria-label="Rectangle"><i class="fa-solid fa-vector-square" aria-hidden="true"></i><span class="mp-tip">Box</span></button>
					<button type="button" class="mp-btn" data-shape="ellipse" aria-pressed="false" aria-label="Circle"><i class="fa-solid fa-circle" aria-hidden="true"></i><span class="mp-tip">Circle</span></button>
					<button type="button" class="mp-btn" data-shape="polygon" aria-pressed="false" aria-label="Polygon"><i class="fa-solid fa-draw-polygon" aria-hidden="true"></i><span class="mp-tip">Shape</span></button>
					<button type="button" class="mp-btn" data-shape="highlight" aria-pressed="false" aria-label="Highlighter"><svg class="mp-hexico mp-shapeico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h7M14 4l6 6-9 9H5v-6z"/></svg><span class="mp-tip">Highlighter</span></button>
					<button type="button" class="mp-btn" data-shape="step" aria-pressed="false" aria-label="Numbered step"><svg class="mp-hexico mp-shapeico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M11 9l2-1v8"/></svg><span class="mp-tip">Numbered step</span></button>
					<button type="button" class="mp-btn" data-shape="callout" aria-pressed="false" aria-label="Speech bubble"><svg class="mp-hexico mp-shapeico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg><span class="mp-tip">Speech bubble</span></button>
					<button type="button" class="mp-btn" data-shape="text" aria-pressed="false" aria-label="Text"><i class="fa-solid fa-font" aria-hidden="true"></i><span class="mp-tip">Label</span></button>
				</div>
			</div>
			if data.CanShadow() {
			<div class="mp-item">
				<button type="button" class="mp-btn" data-tool="shadow" aria-pressed="false" aria-expanded="false" aria-label="Hide under shadow (B)">
					<i class="fa-solid fa-cloud" aria-hidden="true"></i>
					<span class="mp-tip">Hide under shadow <kbd>B</kbd></span>
				</button>
				<div id="mp-fly-shadow" class="mp-fl mp-fly" hidden>
					<div class="mp-fly-label">Hide under shadow</div>
					<button type="button" class="mp-wd" data-shadow-strength="0.5">A hint</button>
					<button type="button" class="mp-wd" data-shadow-strength="0.85">Almost nothing</button>
				</div>
			</div>
			}
			<!-- The campaign media picker mounts on this button and reports the choice
			     as media-picker:select, which the viewer hands to the drawing module. -->
			<button
				type="button"
				id="mp-add-picture"
				class="mp-btn"
				data-widget="media-picker"
				data-campaign-id={ data.CampaignID }
				data-mime-prefix="image/"
				aria-label="Add a picture (I)"
			>
				<i class="fa-solid fa-image" aria-hidden="true"></i>
				<span class="mp-tip">Add a picture <kbd>I</kbd></span>
			</button>
			}
		}
		<button type="button" class="mp-btn" data-tool="hex" aria-pressed="false" aria-label="Hexes (H)" hidden?={ data.DisplayOrDefault().GridType != "hex" }>
			<svg class="mp-hexico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/></svg>
			<span class="mp-tip">Hexes <kbd>H</kbd></span>
		</button>
		if data.IsOwner {
			<!-- Turns the grid to hexes and chooses what they cover. Shown while the
			     grid is not hexes; the viewer fills the flyout from the map's pictures. -->
			<div class="mp-item">
				<button type="button" id="mp-make-hex" class="mp-btn" aria-expanded="false" aria-label="Make a hex map" hidden?={ data.DisplayOrDefault().GridType == "hex" }>
					<svg class="mp-hexico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/></svg>
					<span class="mp-tip">Make a hex map</span>
				</button>
				<div id="mp-fly-hex" class="mp-fl mp-fly mp-fly-col" hidden></div>
			</div>
		}
		if data.IsScribe && data.CanDraw() {
			<div class="mp-sep"></div>
			<div class="mp-item">
				<button type="button" id="mp-style-btn" class="mp-btn" aria-expanded="false" aria-label="Colour and line">
					<span id="mp-style-swatch" class="mp-swatch"></span>
					<span class="mp-tip">Colour and line</span>
				</button>
				<div id="mp-fly-style" class="mp-fl mp-fly" hidden>
					<div class="mp-fly-label">Colour</div>
					for _, c := range mapDrawColors {
						<button type="button" class="mp-sw" data-color={ c } aria-pressed="false" aria-label={ "Colour " + c } style={ "background:" + c }></button>
					}
					<div class="mp-fly-label mp-fly-gap">Line</div>
					<button type="button" class="mp-wd" data-width="2" aria-pressed="false">Thin</button>
					<button type="button" class="mp-wd" data-width="4" aria-pressed="false">Medium</button>
					<button type="button" class="mp-wd" data-width="7" aria-pressed="false">Thick</button>
				</div>
			</div>
			<button type="button" id="mp-undo" class="mp-btn" aria-label="Undo last drawing" disabled>
				<i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
				<span class="mp-tip">Undo last drawing</span>
			</button>
		}
	</div>
	<div id="mp-hexpanel" class="mp-fl mp-hexpanel" role="region" aria-label="Hexes" hidden></div>
	<div class="mp-topright">
		if data.IsOwner {
			<button type="button" id="mp-settings-btn" class="mp-fl mp-pill mp-pill-icon" aria-label="Map settings" title="Map settings" aria-expanded="false" aria-controls="mp-sheet">
				<i class="fa-solid fa-gear" aria-hidden="true"></i>
			</button>
		}
		<button type="button" id="mp-layers-btn" class="mp-fl mp-pill" aria-expanded="false" aria-controls="mp-layers">
			<i class="fa-solid fa-layer-group" aria-hidden="true"></i>
			<span>Pins &amp; layers</span>
		</button>
	</div>
	<div id="mp-layers" class="mp-fl mp-panel" hidden></div>
	if data.IsOwner {
		@mapSettingsSheet(data)
	}
	<div class="mp-fl mp-zoom">
		<button type="button" id="mp-zoom-in" class="mp-btn" aria-label="Zoom in"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
		<div id="mp-zoom-level" class="mp-lvl" aria-live="polite">100%</div>
		<button type="button" id="mp-zoom-out" class="mp-btn" aria-label="Zoom out"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
		<div class="mp-sep"></div>
		<button type="button" id="mp-fit" class="mp-btn" aria-label="Fit whole map"><i class="fa-solid fa-expand" aria-hidden="true"></i></button>
		<button type="button" id="mp-fullscreen" class="mp-btn" aria-label="Full screen"><i class="fa-solid fa-up-right-and-down-left-from-center" aria-hidden="true"></i></button>
	</div>
	<div id="mp-hint" class="mp-fl mp-hint" role="status" hidden></div>
}

// markerModal renders the create/edit marker modal.
templ markerModal(data MapViewData) {
	<div
		id="marker-modal"
		class="hidden fixed inset-0 z-[9999] flex items-center justify-center bg-black/50"
		onclick="if(event.target===this)closeMarkerModal()"
	>
		<div class="card p-6 w-full max-w-md space-y-4">
			<div class="flex items-center justify-between">
				<h2 id="mk-modal-title" class="text-lg font-semibold text-fg">New Marker</h2>
				<button class="text-fg-muted hover:text-fg" onclick="closeMarkerModal()">
					<i class="fa-solid fa-xmark"></i>
				</button>
			</div>
			<form id="marker-form" class="space-y-3">
				<input type="hidden" name="marker_id" id="mk-id" value=""/>
				<input type="hidden" name="x" id="mk-x" value="50"/>
				<input type="hidden" name="y" id="mk-y" value="50"/>
				<div>
					<label class="block text-xs font-medium text-fg-body mb-1">Name</label>
					<input type="text" name="name" id="mk-name" class="input w-full" required placeholder="Marker name"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-fg-body mb-1">Description</label>
					<textarea name="description" id="mk-description" class="input w-full" rows="2" placeholder="Optional description"></textarea>
				</div>
				<div class="grid grid-cols-2 gap-2">
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">Icon</label>
						<select name="icon" id="mk-icon" class="input w-full">
							// Rendered from the canonical icon catalog (marker_icons.go)
							// so the picker, the stored value, and the Foundry sync
							// contract all share one source of truth (icon parity).
							for _, grp := range MarkerIconGroups() {
								<optgroup label={ grp.Category }>
									for _, ic := range grp.Icons {
										<option value={ ic.ID }>{ ic.Label }</option>
									}
								</optgroup>
							}
						</select>
					</div>
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">Color</label>
						<input type="color" name="color" id="mk-color" class="input w-full h-9" value="#3b82f6"/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-fg-body mb-1">Kind</label>
					<select name="pin_category" id="mk-kind" class="input w-full">
						<option value="">Other</option>
						<option value="location">Place</option>
						<option value="danger">Danger</option>
						<option value="treasure">Treasure</option>
						<option value="quest">Quest</option>
						<option value="note">Note</option>
					</select>
				</div>
				<div class="grid grid-cols-2 gap-2">
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">Visibility</label>
						<select name="visibility" id="mk-visibility" class="input w-full">
							<option value="everyone">Everyone</option>
							<option value="dm_only">DM Only</option>
						</select>
					</div>
					<div>
						<label class="block text-xs font-medium text-fg-body mb-1">Link Entity (ID)</label>
						<input type="text" name="entity_id" id="mk-entity-id" class="input w-full" placeholder="Optional"/>
					</div>
				</div>
				<div class="flex items-center justify-between pt-2">
					<div id="mk-delete-zone" class="hidden">
						<button
							type="button"
							class="text-xs text-red-400 hover:text-red-300 hover:bg-red-500/10 px-2 py-1 rounded transition-colors"
							onclick="showMarkerDeleteConfirm()"
						>
							<i class="fa-solid fa-trash mr-1"></i> Delete
						</button>
					</div>
					<div></div>
					<div class="flex gap-2">
						<button type="button" class="btn-secondary text-xs" onclick="closeMarkerModal()">
							Cancel
						</button>
						<button type="submit" id="mk-submit-btn" class="btn-primary text-xs">
							<i class="fa-solid fa-plus mr-1" id="mk-submit-icon"></i>
							<span id="mk-submit-text">Create Marker</span>
						</button>
					</div>
				</div>
			</form>
			<!-- Delete confirmation -->
			<div id="mk-delete-confirm" class="hidden">
				<div class="border-t border-edge pt-4 mt-2">
					<div class="flex items-center gap-2 mb-3">
						<i class="fa-solid fa-triangle-exclamation text-red-400"></i>
						<span class="text-sm font-medium text-fg">Delete this marker?</span>
					</div>
					<p class="text-xs text-fg-secondary mb-3">This action cannot be undone.</p>
					<div class="flex justify-end gap-2">
						<button type="button" class="btn-secondary text-xs" onclick="hideMarkerDeleteConfirm()">
							Cancel
						</button>
						<button type="button" class="text-xs px-3 py-1.5 rounded-md bg-red-500 text-white hover:bg-red-600 transition-colors" onclick="deleteMarker()">
							<i class="fa-solid fa-trash mr-1"></i> Delete
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// derefStr safely dereferences a *string, returning "" for nil.
// mapDrawColors are the eight swatches (the signed design's palette) offered for drawings: a small, legible
// set that reads on both light and dark map art, replacing a free colour input.
var mapDrawColors = []string{"#c0392b", "#d97706", "#facc15", "#15803d", "#2563eb", "#7c3aed", "#111827", "#ffffff"}

func derefStr(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

// backgroundColorOrDefault returns the value used as the color picker's
// initial state. <input type="color"> requires a hex value, so this falls
// back to a neutral dark gray when no override is set — cosmetic only; the
// hidden "is set" flag governs whether the color is actually applied.
func backgroundColorOrDefault(s *string) string {
	if s == nil || *s == "" {
		return "#1f2937"
	}
	return *s
}

// backgroundColorIsSet returns "true" when the map has a stored
// override (so the save flow knows to preserve it on the next save
// even if the operator doesn't touch the picker), and "" when no
// override is set (so the save flow omits the field, keeping NULL).
func backgroundColorIsSet(s *string) string {
	if s != nil {
		return "true"
	}
	return ""
}

// mapBackgroundStyle returns an inline style="background-color: ..."
// fragment when the map has a custom color override, or empty string
// when no override is set (theme-following bg-surface-alt remains in
// effect via the container class). Used by MapEditorBody callers to
// thread the override into mapContainerStyle.
func mapBackgroundStyle(s *string) string {
	if s == nil || *s == "" {
		return ""
	}
	return "background-color: " + *s + ";"
}

// mapImageSrc is the one place a template turns a map into a picture address:
// the player copy when the viewer's version of the map carries one, else the
// signed media URL of the original, or "" when there is no picture. Every
// template goes through it so none can build an original URL from an id that
// the viewer should not have.
func mapImageSrc(ctx context.Context, m *Map) string {
	if m == nil {
		return ""
	}
	if m.PlayerImageURL != "" {
		return m.PlayerImageURL
	}
	if m.ImageID == nil || *m.ImageID == "" {
		return ""
	}
	return layouts.MediaURL(ctx, *m.ImageID)
}

// boolDigit renders a bool as "1"/"0" for a data attribute CSS selects on.
func boolDigit(b bool) string {
	if b {
		return "1"
	}
	return "0"
}

// mustMarshalDisplay serialises the resolved display settings for the page
// script. Falls back to "{}" on a marshal error (cannot happen for this type),
// which the script treats as all defaults.
func mustMarshalDisplay(d ResolvedDisplay) string {
	b, err := json.Marshal(d)
	if err != nil {
		return "{}"
	}
	return string(b)
}

// mustMarshalMarkers serializes markers to JSON for the JS initialization.
// Empty/nil slices must both serialize to "[]": json.Marshal returns the
// literal "null" for a nil slice, which JS would parse as null and crash on
// markers.length, dying before window.uploadMapImage/saveMapSettings/etc.
// get assigned.
func mustMarshalMarkers(markers []Marker) string {
	if len(markers) == 0 {
		return "[]"
	}
	b, err := json.Marshal(markers)
	if err != nil {
		return "[]"
	}
	return string(b)
}
