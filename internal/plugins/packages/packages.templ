// packages.templ renders the admin Packages page: header, summary strip, tabs.
// The tabs' own content lives in packages_*.templ, one component per file.
package packages

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// PackagesPage renders /admin/packages. Page state is in the URL (see
// packagesQuery), so every control is a plain link and the page works
// without JavaScript; HTMX only carries the writes.
templ PackagesPage(data PackagesPageData) {
	@layouts.App("Packages - Admin") {
		<div class="max-w-6xl mx-auto space-y-5">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<h1 class="text-2xl font-bold text-fg">Packages</h1>
					<p class="text-sm text-fg-secondary mt-1 max-w-prose">
						Game systems and the Foundry module your campaigns use. Install, update, review submissions and set the rules, all here.
					</p>
				</div>
				@addPackageDisclosure(data.CSRFToken)
			</div>
			<!-- Auto-pin install banner. The Foundry plugin's banner
			     handler returns the banner card if an unread install
			     summary exists, or empty content if not. Packages plugin
			     stays Foundry-agnostic: it just embeds the fragment via
			     hx-get. If that plugin isn't healthy, the 404 leaves the
			     placeholder div empty. The banner self-renders its own
			     Dismiss button using inline IIFE. -->
			<div
				hx-get="/admin/foundry-vtt/autopin-banner"
				hx-trigger="load"
				hx-swap="innerHTML"
			></div>
			<!-- Durable failure banners: one per package with a persisted
			     last_error (failed install, failed update check, or
			     installed-but-not-serving from the post-install verifier).
			     Rendered server-side from the DB so background failures
			     survive restarts and page reloads until resolved — a toast
			     is transient, this is not. Resolves on the next verified
			     successful install/check (last_error cleared). -->
			for _, row := range data.Rows {
				if row.LastError != "" {
					<div class="card p-4 border border-red-500/40 bg-red-500/5">
						<div class="flex items-start gap-3">
							<i class="fa-solid fa-triangle-exclamation text-red-500 mt-0.5"></i>
							<div class="min-w-0">
								<p class="text-sm font-semibold text-fg">{ row.Name }: needs attention</p>
								<p class="text-sm text-fg-secondary break-words">{ row.LastError }</p>
							</div>
						</div>
					</div>
				}
			}
			@summaryStrip(data)
			<div id="pkg-main" class="space-y-4">
				@packagesTabNav(data)
				switch data.Query.Tab {
					case PackagesTabUpdates:
						@updatesTab(data)
					case PackagesTabReview:
						@reviewTab(data)
					case PackagesTabSettings:
						@settingsTab(data)
					default:
						@installedTab(data)
				}
			</div>
			<!-- A hidden stand-in for the Foundry module's Versions list. The
			     auto-pin banner's "Show affected campaigns" button looks for
			     [data-fvtt-versions-trigger], clicks it and waits for the swap
			     into its hx-target; here that swap reloads the tab area with
			     the module's Versions tab open, whose rows carry the campaign
			     buttons the banner then clicks. TODO(#721): hook the banner
			     up without a DOM scrape. -->
			if fr := firstFoundryRow(data.Rows); fr != nil {
				<button
					type="button"
					hidden
					data-fvtt-versions-trigger="true"
					hx-get={ pkgHref(PackagesTabInstalled, FilterActive, "", fr.ID, PanelTabVersions) }
					hx-target="#pkg-main"
					hx-select="#pkg-main > *"
					hx-swap="innerHTML"
					hx-push-url="true"
				></button>
			}
		</div>
	}
}

// summaryStrip shows what needs the admin, each count a link to where it is
// handled. Problems counts active packages with a persisted last_error.
templ summaryStrip(data PackagesPageData) {
	<div class="flex flex-wrap gap-2">
		@summaryChip(tabHref(PackagesTabUpdates), len(data.Updates), "updates ready", "text-yellow-700 dark:text-yellow-400")
		@summaryChip(tabHref(PackagesTabReview), data.PendingCount, "waiting for review", "text-accent")
		@summaryChip(pkgHref(PackagesTabInstalled, FilterProblems, "", "", ""), data.Counts.Problems, pluralWord(data.Counts.Problems, "problem", "problems"), "text-red-600 dark:text-red-400")
	</div>
}

// summaryChip is one count in the strip; a zero count is muted so the strip
// reads at a glance.
templ summaryChip(href string, n int, label, tone string) {
	<a
		href={ templ.SafeURL(href) }
		class="inline-flex items-center gap-2 rounded-lg border border-edge bg-surface px-3 py-2 text-sm text-fg hover:bg-surface-alt focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
	>
		<b class={ "text-base tabular-nums", templ.KV(tone, n > 0), templ.KV("text-fg-muted", n == 0) }>{ fmt.Sprintf("%d", n) }</b>
		{ label }
	</a>
}

// packagesTabNav is the tab strip. It scrolls inside itself so a narrow phone
// never scrolls the page sideways.
templ packagesTabNav(data PackagesPageData) {
	<nav class="-mx-1 overflow-x-auto border-b border-edge" aria-label="Packages sections">
		<ul class="flex gap-1 px-1 text-sm whitespace-nowrap">
			@packagesTab(data.Query.Tab, PackagesTabInstalled, "Installed", 0)
			@packagesTab(data.Query.Tab, PackagesTabUpdates, "Updates", len(data.Updates))
			@packagesTab(data.Query.Tab, PackagesTabReview, "Review", data.PendingCount)
			@packagesTab(data.Query.Tab, PackagesTabSettings, "Settings", 0)
		</ul>
	</nav>
}

// packagesTab is one tab link; badge is shown only when above zero.
templ packagesTab(current, tab, label string, badge int) {
	<li>
		<a
			href={ templ.SafeURL(tabHref(tab)) }
			class={ "inline-flex items-center gap-1.5 px-3 py-2 border-b-2 rounded-t focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent",
				templ.KV("border-accent text-fg font-medium", current == tab),
				templ.KV("border-transparent text-fg-muted hover:text-fg", current != tab) }
			if current == tab {
				aria-current="page"
			}
		>
			{ label }
			if badge > 0 {
				<span class="badge-amber text-[11px] px-1.5 py-0">{ fmt.Sprintf("%d", badge) }</span>
			}
		</a>
	</li>
}

// pluralWord picks the singular or plural noun for a count.
func pluralWord(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

// packageTypeBadge renders a type indicator badge.
templ packageTypeBadge(t PackageType) {
	if t == PackageTypeFoundryModule {
		<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-500/10 text-purple-600">
			<i class="fa-solid fa-cube mr-1"></i>
			Foundry module
		</span>
	} else {
		<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-500/10 text-blue-600">
			<i class="fa-solid fa-dice-d20 mr-1"></i>
			Game system
		</span>
	}
}

// statusBadge renders a colored lifecycle badge for a package; the owner's
// My submissions page uses it.
templ statusBadge(status PackageStatus) {
	switch status {
		case StatusPending:
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-500/10 text-yellow-600">
				<i class="fa-solid fa-clock mr-1"></i>
				Pending
			</span>
		case StatusApproved:
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-500/10 text-green-600">
				<i class="fa-solid fa-check mr-1"></i>
				Approved
			</span>
		case StatusRejected:
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-500/10 text-red-600">
				<i class="fa-solid fa-xmark mr-1"></i>
				Rejected
			</span>
		case StatusArchived:
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-500/10 text-gray-500">
				<i class="fa-solid fa-box-archive mr-1"></i>
				Archived
			</span>
		case StatusDeprecated:
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-500/10 text-orange-600">
				<i class="fa-solid fa-triangle-exclamation mr-1"></i>
				Deprecated
			</span>
	}
}

// statusPill renders a row's one-word state.
templ statusPill(r PackageRow) {
	<span class={ "badge", statusClass(r.Status) }>{ statusLabel(r) }</span>
}

// PruneCard is the stale-version cleanup wizard: a dry-run table of the
// old version folders that are safe to reclaim (everything except the
// newest, the DB-installed, and any currently-served version), with sizes
// and a single confirmed destructive action. The execute path re-derives
// the deletion set server-side — the confirm authorizes the operation,
// never a client list. Renders nothing when there is nothing to reclaim.
templ PruneCard(res *PruneResult, csrfToken string) {
	if len(res.Reclaimable) > 0 {
		<div class="card p-5">
			<div class="flex items-start justify-between gap-4 mb-3">
				<div>
					<h2 class="text-lg font-semibold text-fg">
						<i class="fa-solid fa-broom mr-2 text-fg-muted"></i>
						Stale Version Cleanup
					</h2>
					<p class="text-sm text-fg-secondary mt-1">
						{ fmt.Sprintf("%d old version folder(s) can be reclaimed — %s. The newest, installed, and currently-served versions are always kept.", len(res.Reclaimable), prettyBytes(pruneTotal(res))) }
					</p>
				</div>
				<button
					type="button"
					class="btn-danger text-sm whitespace-nowrap"
					hx-delete="/admin/packages/prune"
					hx-confirm={ fmt.Sprintf("Delete %d stale version folder(s), reclaiming %s? The newest, installed, and currently-served versions are kept. This cannot be undone.", len(res.Reclaimable), prettyBytes(pruneTotal(res))) }
					hx-headers={ csrfHeaders(csrfToken) }
				>
					<i class="fa-solid fa-trash-can mr-1"></i>
					Clean up
				</button>
			</div>
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-fg-muted border-b border-edge">
						<th class="py-1.5 pr-4">Package</th>
						<th class="py-1.5 pr-4">Version</th>
						<th class="py-1.5 text-right">Size</th>
					</tr>
				</thead>
				<tbody>
					for _, s := range res.Reclaimable {
						<tr class="border-b border-edge/50">
							<td class="py-1.5 pr-4 font-mono text-xs">{ s.Slug }</td>
							<td class="py-1.5 pr-4 font-mono text-xs">{ s.Version }</td>
							<td class="py-1.5 text-right text-fg-secondary">{ prettyBytes(s.Size) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
