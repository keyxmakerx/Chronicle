// npc_card.templ renders a single NPC card in the gallery grid.
// Shows portrait, name, type label, tags, and a reveal toggle for DMs.
package npcs

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// NPCCardComponent renders a single NPC card with portrait and metadata.
templ NPCCardComponent(cc *campaigns.CampaignContext, card *NPCCard, csrfToken string) {
	<div
		class="card p-0 overflow-hidden group relative"
		data-cast-card="true"
		data-entity-name={ card.Name }
		data-preview-url={ fmt.Sprintf("/campaigns/%s/entities/%s/preview", cc.Campaign.ID, card.ID) }
	>
		<!-- Link to entity page -->
		<a
			href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/%s", cc.Campaign.ID, card.ID)) }
			data-cast-link="true"
			class="block"
		>
			<!-- Portrait -->
			if card.ImagePath != nil && *card.ImagePath != "" {
				<div class="aspect-[3/4] bg-surface-alt overflow-hidden">
					<img
						src={ layouts.MediaURL(ctx, *card.ImagePath) }
						alt={ card.Name }
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
					/>
				</div>
			} else {
				<div class="aspect-[3/4] flex items-center justify-center bg-surface-alt">
					<i class="fa-solid fa-user text-3xl text-fg-muted opacity-30"></i>
				</div>
			}

			<!-- Card body -->
			<div class="px-3 py-2.5">
				<h3 class="text-sm font-semibold text-fg truncate group-hover:text-accent transition-colors" title={ card.Name }>
					{ card.Name }
				</h3>
				if card.TypeLabel != nil && *card.TypeLabel != "" {
					<p class="text-[11px] text-fg-secondary truncate mt-0.5">{ *card.TypeLabel }</p>
				} else {
					// Show a field like "race" or "class" if available.
					if race := card.FieldString("race"); race != "" {
						<p class="text-[11px] text-fg-secondary truncate mt-0.5">{ race }</p>
					} else if class := card.FieldString("class"); class != "" {
						<p class="text-[11px] text-fg-secondary truncate mt-0.5">{ class }</p>
					}
				}

				<!-- Tags -->
				if len(card.Tags) > 0 {
					<div class="flex flex-wrap gap-0.5 mt-1.5">
						for _, tag := range card.Tags {
							<span
								class="inline-flex items-center px-1.5 py-px rounded-full text-[9px] font-medium"
								style={ fmt.Sprintf("background-color: %s22; color: %s", tag.Color, tag.Color) }
							>
								{ tag.Name }
							</span>
						}
					</div>
				}
			</div>
		</a>

		<!-- Reveal chip (Scribe+ only); anonymous and player viewers have MemberRole < Scribe -->
		if cc.MemberRole >= campaigns.RoleScribe {
			<div class="absolute top-2 left-2 z-10" id={ fmt.Sprintf("reveal-%s", card.ID) }>
				@RevealBadge(card.ID, cc.Campaign.ID, card.IsPrivate, csrfToken)
			</div>
		}
		<!-- Quick look: same hook the party cards use, wired by characters.js -->
		<button
			type="button"
			data-cast-peek="true"
			title="Quick look"
			aria-label={ "Quick look at " + card.Name }
			class="absolute top-2 right-2 z-10 inline-flex items-center justify-center w-7 h-7 rounded-md bg-surface/90 border border-edge text-fg-muted opacity-0 group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent hover:text-accent hover:border-accent transition-all"
		>
			<i class="fa-solid fa-expand text-xs"></i>
		</button>
	</div>
}

// RevealBadge renders the labelled shown/hidden chip for an NPC. Swapped via
// HTMX when toggled; aria-pressed is true while the NPC is shown to players.
templ RevealBadge(entityID string, campaignID string, isPrivate bool, csrfToken string) {
	<button
		type="button"
		class={ "inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold backdrop-blur-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white",
			templ.KV("bg-black/60 text-white/80 hover:bg-black/80", isPrivate),
			templ.KV("bg-emerald-600/90 text-white hover:bg-emerald-700", !isPrivate) }
		aria-pressed={ fmt.Sprintf("%t", !isPrivate) }
		if isPrivate {
			title="Hidden from players. Click to show them."
		} else {
			title="Shown to players. Click to hide."
		}
		hx-post={ fmt.Sprintf("/campaigns/%s/npcs/%s/reveal", campaignID, entityID) }
		hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
		hx-target={ fmt.Sprintf("#reveal-%s", entityID) }
		hx-swap="innerHTML"
	>
		if isPrivate {
			<span aria-hidden="true">&#9675;</span> Hidden
		} else {
			<span aria-hidden="true">&#9679;</span> Shown
		}
	</button>
}
