// show_banner.templ owns the owner-only "new Foundry module version is ready"
// line at the top of the campaign home page. Kept here (not in campaigns) so
// the campaigns plugin stays VTT-agnostic (T-B2).
//
// URL: GET /campaigns/:id/foundry-vtt/show-banner-fragment
// Auth: owner-only; players are never sent the line.

package foundry_vtt

// CampaignUpdateBanner renders one of three lines: the prompt while a version
// waits, a small pointer once the owner chose Later for it, or a one-line
// result right after Update. Nothing is rendered when there is nothing to say
// or while a site admin holds the campaign (the owner has no choice to offer).
templ CampaignUpdateBanner(v *OwnerUpdateView, csrfToken string) {
	if v != nil {
		if v.Done != "" {
			<p id={ updateBannerID } class="mb-4 text-sm text-fg-secondary" role="status">{ v.Done }</p>
		} else if v.Ready != "" && !v.AdminHold {
			if v.Dismissed {
				<p id={ updateBannerID } class="mb-4 text-xs text-fg-muted">
					{ v.Package } { v.Ready } is waiting in
					<a href={ templ.SafeURL(extensionsURL(v.CampaignID)) } class="text-accent hover:underline">Apps &amp; game system</a>
					whenever you&rsquo;re ready. Only you see this.
				</p>
			} else {
				<div id={ updateBannerID } class="mb-6 p-4 rounded-md bg-amber-500/10 border border-amber-500/30 flex flex-wrap items-start justify-between gap-3" role="status">
					<div class="min-w-0 text-sm text-fg">
						<p>
							<b>{ v.Package } { v.Ready } is ready for this campaign.</b>
							You&rsquo;re on { v.Running }.
							if len(v.Notes) > 0 {
								What&rsquo;s new:
							}
						</p>
						if len(v.Notes) > 0 {
							<ul class="mt-1.5 list-disc pl-5 text-fg-secondary">
								for _, line := range v.Notes {
									<li class="break-words">{ line }</li>
								}
							</ul>
						}
					</div>
					<div class="flex gap-2">
						<button type="button" class="btn-primary btn-sm" onclick={ openDialogOnClick(updateDialogID("update", updateViewBanner)) }>Update</button>
						<form
							hx-post={ updateActionURL(v.CampaignID, "/later") }
							hx-headers={ hxCSRFHeaders(csrfToken) }
							hx-target={ updateTargetSelector(updateViewBanner) }
							hx-swap="outerHTML"
						>
							<input type="hidden" name="version" value={ v.Ready }/>
							<input type="hidden" name="view" value={ updateViewBanner }/>
							<button type="submit" class="btn-secondary btn-sm">Later</button>
						</form>
					</div>
					@updateConfirmDialog(v, updateViewBanner, csrfToken)
				</div>
			}
		}
	}
}
