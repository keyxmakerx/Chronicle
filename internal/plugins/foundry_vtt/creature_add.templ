// creature_add.templ owns the "Add to Foundry" button on a creature page
// header. Kept here, not in entities, so the entities plugin stays
// VTT-agnostic (T-B2); the page lazy-loads it.
//
// URL: GET/POST /campaigns/:id/foundry-vtt/creature-add/:eid
// Auth: the campaign owner or a member given DM access.

package foundry_vtt

import "fmt"

// CreatureAddButton renders the button and, after a press, one status line.
// The whole fragment swaps itself so the status replaces in place.
templ CreatureAddButton(v CreatureAddView) {
	<form
		class="inline-flex items-center gap-2"
		hx-post={ fmt.Sprintf("/campaigns/%s/foundry-vtt/creature-add/%s", v.CampaignID, v.EntityID) }
		hx-swap="outerHTML"
		hx-disabled-elt="find button"
	>
		<input type="hidden" name="csrf_token" value={ v.CSRFToken }/>
		<button type="submit" class="btn-ghost btn-sm" title="Make this creature's actor in Foundry now. A fight that uses it makes one anyway.">
			<i class="fa-solid fa-dragon"></i> Add to Foundry
		</button>
		if v.Status != "" {
			<span
				role="status"
				if v.StatusOK {
					class="text-xs text-green-700 dark:text-green-300"
				} else {
					class="text-xs text-fg-muted"
				}
			>{ v.Status }</span>
		}
	</form>
}
