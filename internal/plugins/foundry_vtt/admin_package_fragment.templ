// admin_package_fragment.templ holds the per-foundry-module-package UI
// fragment that /admin/packages lazy-loads into each foundry-module
// row: GET /admin/foundry-vtt/packages/:id/actions-fragment.
//
// Lives in foundry_vtt, not packages, so the packages plugin stays
// foundry-agnostic. Returns only the action elements (links, buttons)
// that go inside the per-row button group; packages.templ supplies
// the wrapping container.

package foundry_vtt

import (
	"github.com/keyxmakerx/chronicle/internal/plugins/packages"
)

// AdminPackageActionsFragment renders the foundry-module-specific row
// actions inside the admin /admin/packages page. Lazy-loaded by
// packages.templ via an hx-get slot with hx-swap="outerHTML" so this
// fragment replaces the skeleton placeholder span entirely.
//
// Currently just the "API monitor" link (the package's manifest is
// served from Chronicle, so the API monitor surfaces hits). The
// Versions button's data-fvtt-versions-trigger attribute stays on the
// generic Versions button in packages.templ; moving it here would
// require reshaping the autopin banner's selector strategy.
//
// csrfToken is threaded through for parity with packages.templ's
// packageCard signature, for state-changing actions this fragment
// might grow later; today's content is read-only.
templ AdminPackageActionsFragment(pkg packages.Package, csrfToken string) {
	<a
		href="/admin/api"
		class="btn-secondary text-sm"
		title="API monitor"
	>
		<i class="fa-solid fa-chart-line"></i>
	</a>
}
