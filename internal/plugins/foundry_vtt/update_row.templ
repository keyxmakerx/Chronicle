// update_row.templ is the Module version card on the owner's Foundry page. It
// is lazy-loaded into that page so the campaigns plugin stays VTT-agnostic.
//
// URL: GET /campaigns/:id/foundry-vtt/apps-row
// Auth: owner-only

package foundry_vtt

// AppsUpdateRow shows what the campaign's Foundry world runs, the owner's
// choices when a newer version is waiting, and how new versions arrive. While
// a site admin holds the campaign everything that would move it is replaced
// by one line.
templ AppsUpdateRow(v *OwnerUpdateView, csrfToken string) {
	if v == nil {
		<section id={ updateRowID } class="card p-4 mb-6">
			<p class="text-sm text-fg-secondary">The Foundry module isn't installed on this Chronicle site yet. A site admin adds it under Admin &rsaquo; Packages.</p>
		</section>
	} else {
		<section id={ updateRowID } class="card p-4 mb-6" aria-label={ v.Package }>
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div class="min-w-0">
					<p class="text-sm font-semibold text-fg">
						{ v.Package }
						<span class="ml-1 badge-gray">Foundry module</span>
					</p>
					<p class="text-xs text-fg-secondary mt-1">
						Running <span class="tabular-nums">{ v.Running }</span>.
						if v.Ready != "" {
							<b class="text-fg">{ v.Ready } is ready.</b>
						} else {
							Up to date.
						}
					</p>
					if v.AdminHold {
						<p class="text-xs text-fg-secondary mt-1">The site admin is keeping this campaign on { v.Running }, so updates can't be changed here for now.</p>
					}
					<p class="text-xs text-fg-muted mt-1">
						Your Foundry world loads this version the next time it starts.
					</p>
				</div>
				<div class="flex flex-col items-end gap-1.5">
					if v.Ready != "" && !v.AdminHold {
						<button type="button" class="btn-primary btn-sm" onclick={ openDialogOnClick(updateDialogID("update", updateViewRow)) }>
							Update to { v.Ready }
						</button>
					}
					if v.Ready != "" && v.NotesURL != "" {
						<a href={ templ.SafeURL(v.NotesURL) } target="_blank" rel="noopener noreferrer" class="btn-secondary btn-sm">What&rsquo;s new</a>
					}
					if !v.AdminHold && len(v.Versions) > 0 {
						<button type="button" class="btn-secondary btn-sm" onclick={ openDialogOnClick(updateDialogID("switch", updateViewRow)) }>
							Use another version&hellip;
						</button>
					}
				</div>
			</div>
			if v.Ready != "" && !v.AdminHold {
				@updateConfirmDialog(v, updateViewRow, csrfToken)
			}
			if !v.AdminHold && len(v.Versions) > 0 {
				@updateSwitchDialog(v, csrfToken)
			}
			if !v.AdminHold {
				@updateModeChooser(v, csrfToken)
			}
		</section>
	}
}

// updateModeOption is one choice of how new versions arrive.
type updateModeOption struct {
	Mode, Label, Detail string
}

// updateModeOptions are the three choices, in the order the card lists them.
// Ask me first is the recommended one: nothing changes mid-session.
var updateModeOptions = []updateModeOption{
	{"approve_first", "Ask me first", "Recommended. A new version waits here until you press Update. Nothing changes mid-session."},
	{"automatic", "Update automatically", "Your world gets each new version as soon as the site admin installs it. Players see it the next time Foundry starts."},
	{"pinned", "Stay on one version", "Nothing changes until you pick another version. You still see here when a new one is installed."},
}

// updateModeChooser is "When a new version comes out". Choosing a radio posts
// at once and the card is swapped for the new state, so there is no Save
// button to forget.
templ updateModeChooser(v *OwnerUpdateView, csrfToken string) {
	<form
		class="mt-4 pt-4 border-t border-edge"
		hx-post={ updateActionURL(v.CampaignID, "/mode") }
		hx-headers={ hxCSRFHeaders(csrfToken) }
		hx-target={ updateTargetSelector(updateViewRow) }
		hx-swap="outerHTML"
		hx-trigger="change"
		data-update-mode
	>
		<input type="hidden" name="view" value={ updateViewRow }/>
		<fieldset>
			<legend class="text-xs font-semibold uppercase tracking-wider text-fg-muted mb-2">When a new version comes out</legend>
			<div class="space-y-2">
				for _, o := range updateModeOptions {
					<label class={ "flex items-start gap-3 rounded-md border p-3 cursor-pointer", templ.KV("border-accent bg-accent/5", o.Mode == v.Mode), templ.KV("border-edge", o.Mode != v.Mode) }>
						<input type="radio" name="mode" value={ o.Mode } checked?={ o.Mode == v.Mode } class="mt-1 accent-accent"/>
						<span class="min-w-0">
							<span class="block text-sm font-medium text-fg">{ o.Label }</span>
							<span class="block text-xs text-fg-secondary">{ o.Detail }</span>
							if o.Mode == "automatic" && v.Ready != "" && v.Mode != "automatic" {
								<span class="block text-xs text-amber-700 dark:text-amber-400 mt-1">Choosing this moves your world to { v.Ready } now.</span>
							}
						</span>
					</label>
				}
			</div>
		</fieldset>
	</form>
}
