package decks

import (
	"encoding/json"
	"strconv"
	"strings"
	"time"
)

// DeckCardsTab is the Cards tab: the deck's cards at hand size, each with its
// copies as a small count, and the open card's editor beside them (under them
// on a phone). A Director view: it draws every card's face and note.
templ DeckCardsTab(p deckPage) {
	{{ cur, editing := p.cardByID(p.Card) }}
	<div class="dkw-cards" data-dkw-cards data-url={ p.frag("cards") } data-newname={ newCardName(p.Deck.Cards) } data-count={ strconv.Itoa(len(p.Deck.Cards)) }>
		<div class="dkw-grid-wrap">
			<p class="dkw-err" role="alert" data-dkw-err hidden></p>
			<div class="dkw-tools">
				<button type="button" class="dkw-word dkw-add" data-act="add-card" data-working-label="Adding…">+ Card</button>
				<span class="dkw-quiet">{ cardsWords(len(p.Deck.Cards)) } defined, { strconv.Itoa(p.totalCards()) } in the deck</span>
			</div>
			if len(p.Deck.Cards) == 0 {
				<p class="dkw-empty">This deck has no cards yet. Add the first one and give it a name.</p>
			}
			<ul class="dkw-grid" id="dkw-grid">
				for _, c := range p.Deck.Cards {
					<li>
						<a
							class="dkw-cardlink"
							href={ templ.SafeURL(p.pageURL("cards") + "&card=" + c.ID) }
							data-card={ c.ID }
							aria-current={ currentWord(editing && cur.ID == c.ID) }
							aria-label={ c.Name + ", " + copiesWords(c.Copies) + fitSuffix(c) }
						>
							@CardView(p.Deck.Look, upState(c, SizeHand), CardOpts{Size: SizeHand})
							<span class="dkw-copies" aria-hidden="true">{ strconv.Itoa(c.Copies) }</span>
							if len(c.When) > 0 {
								<span class={ "dkw-fitmark", templ.KV("is-fits", c.FitsNow) } data-fit={ fitWord(c) } aria-hidden="true">{ fitLabel(c) }</span>
							}
						</a>
					</li>
				}
			</ul>
		</div>
		if editing {
			@cardEditor(p, cur)
		} else if len(p.Deck.Cards) > 0 {
			<p class="dkw-quiet dkw-pickone">Choose a card to edit it.</p>
		}
	</div>
}

func currentWord(on bool) string {
	if on {
		return "true"
	}
	return "false"
}

func copiesWords(n int) string {
	if n == 1 {
		return "1 copy"
	}
	return strconv.Itoa(n) + " copies"
}

// newCardName is a name no card of the deck has, for "+ Card".
func newCardName(cards []DirectorCard) string {
	taken := map[string]bool{}
	for _, c := range cards {
		taken[c.Name] = true
	}
	if !taken["New card"] {
		return "New card"
	}
	for i := 2; ; i++ {
		if n := "New card " + strconv.Itoa(i); !taken[n] {
			return n
		}
	}
}

// fateWords says where a used card goes, for the deck's own way and a card's.
func fateWords(f string) string {
	switch f {
	case FateBack:
		return "back into the pile"
	case FateGone:
		return "out of the game"
	case FatePlay:
		return "into play, in front of the hero"
	}
	return "to the used pile"
}

// cardEditor is one card's editor: every field saves as it is changed, and the
// card beside it shows the change at once.
templ cardEditor(p deckPage, c DirectorCard) {
	<form class="dkw-editor" data-dkw-editor data-card-id={ c.ID }>
		<div class="dkw-ed-top">
			<h2 class="dkw-lab">One card <span class="dkw-quiet">of { p.Deck.Name }</span></h2>
			<button type="button" class="dkw-word" data-act="close-card">Done</button>
		</div>
		<div class="dkw-ed-body">
			<div class="dkw-preview" id="dkw-preview" data-dk-stage>
				@CardView(p.Deck.Look, upState(c, SizeOpen), CardOpts{Size: SizeOpen})
				if h := printedHint(c.When); h != "" {
					<p class="dkw-quiet dkw-printed-hint">{ h }</p>
				}
			</div>
			<div class="dkw-ed-fields">
				<div class="dkw-field">
					<label for="dkw-f-name">Name</label>
					<input id="dkw-f-name" class="dkw-line" type="text" value={ c.Name } maxlength="120" data-field="name" autocomplete="off"/>
				</div>
				<div class="dkw-field">
					<label for="dkw-f-words">Words players read</label>
					<textarea id="dkw-f-words" class="dkw-line" rows="3" maxlength="2000" data-field="words">{ c.Words }</textarea>
				</div>
				<div class="dkw-field">
					<span class="dkw-flabel" id="dkw-pic-l">Picture</span>
					<div class="dkw-pic" role="group" aria-labelledby="dkw-pic-l">
						if c.Picture != "" {
							<img class="dkw-pic-img" alt="The card's picture" src={ pictureURL(c.Picture, SizeRow) } width="64" height="64"/>
						}
						<button type="button" class="dkw-btn" data-widget="media-picker" data-campaign-id={ p.CampaignID } data-mime-prefix="image/" data-event-target="media-picker:select" data-dkw-pick>
							if c.Picture != "" {
								Change picture
							} else {
								Choose a picture
							}
						</button>
						if c.Picture != "" {
							<button type="button" class="dkw-word" data-act="remove-picture">Remove picture</button>
						}
					</div>
				</div>
				<div class="dkw-row2">
					<div class="dkw-field">
						<span class="dkw-flabel" id="dkw-kind-l">Kind</span>
						<div class="dkw-chips" role="radiogroup" aria-labelledby="dkw-kind-l">
							if len(p.Deck.Look.Kinds) > 0 {
								<button type="button" class="dkw-chip" role="radio" aria-checked={ boolWord(c.KindKey == "") } data-kind-key="">No kind</button>
							}
							for _, k := range p.Deck.Look.Kinds {
								<button type="button" class={ "dkw-chip", paletteOf(k.Colour) } role="radio" aria-checked={ boolWord(c.KindKey == k.Key) } data-kind-key={ k.Key }>
									@KindSign(k.Sign)
									{ k.Name }
								</button>
							}
						</div>
						if len(p.Deck.Look.Kinds) == 0 {
							<span class="dkw-quiet">No kinds yet. <a class="dkw-word" href={ templ.SafeURL(p.pageURL("look")) }>Add some on the Look tab</a></span>
						}
					</div>
					<div class="dkw-field dkw-narrow">
						<label for="dkw-f-corner">Corner value</label>
						<input id="dkw-f-corner" class="dkw-line" type="text" value={ c.Corner } maxlength="12" data-field="corner" autocomplete="off"/>
					</div>
				</div>
				<div class="dkw-row2">
					<div class="dkw-switch">
						<button type="button" class="toggle shrink-0" role="switch" aria-checked={ boolWord(c.Rare) } aria-labelledby="dkw-l-rare" data-field="rare"><span class="toggle-knob"></span></button>
						<span id="dkw-l-rare">Rare</span>
					</div>
					<div class="dkw-field dkw-narrow">
						<span class="dkw-flabel" id="dkw-copies-l">Copies</span>
						<span class="dkw-step" role="group" aria-labelledby="dkw-copies-l">
							<button type="button" class="dkw-stepbtn" data-act="copies-down" aria-label="One copy fewer" disabled?={ c.Copies <= 1 }>−</button>
							<output class="dkw-count" data-dkw-copies>{ strconv.Itoa(c.Copies) }</output>
							<button type="button" class="dkw-stepbtn" data-act="copies-up" aria-label="One copy more" disabled?={ c.Copies >= MaxCopiesPerCard }>+</button>
						</span>
					</div>
				</div>
				<p class="dkw-sentence">
					<label for="dkw-f-fate">After it is used it goes</label>
					<select id="dkw-f-fate" class="dw-blank is-filled" data-field="fate">
						<option value="" selected?={ c.Fate == "" }>{ "the deck's way: " + fateWords(p.Deck.Settings.Fate) }</option>
						for _, f := range []string{FateBack, FateUsed, FateGone, FatePlay} {
							<option value={ f } selected?={ c.Fate == f }>{ fateWords(f) }</option>
						}
					</select>
				</p>
				<div class="dkw-switch">
					<button type="button" class="toggle shrink-0" role="switch" aria-checked={ boolWord(c.AskFirst) } aria-labelledby="dkw-l-ask" data-field="askFirst"><span class="toggle-knob"></span></button>
					<span id="dkw-l-ask">Ask me before a player plays it</span>
				</div>
				<section class="dkw-when" data-dkw-when aria-labelledby="dkw-when-l" data-when={ whenData(c) } data-state={ whenState(c) } data-hero-deck={ boolWord(p.Deck.Kind == KindHero) } data-holder={ p.Deck.HolderEntityID } data-holder-name={ p.heroName(p.Deck.HolderEntityID) }>
					<h3 class="dkw-lab" id="dkw-when-l">Comes up when</h3>
					<ol class="dkw-whens" data-dkw-whens></ol>
					<div class="dkw-whenadd" data-dkw-whenadd></div>
					<p class="dkw-whennow" data-dkw-now role="status" aria-live="polite"></p>
					<p class="dkw-err" role="alert" data-dkw-when-err hidden></p>
				</section>
				<div class="dkw-note" data-dm-only>
					<label for="dkw-f-note">Note for the Directors</label>
					<textarea id="dkw-f-note" class="dkw-line" rows="2" maxlength="2000" data-field="directorNote">{ c.DirectorNote }</textarea>
				</div>
				<p class="dkw-err" role="alert" data-dkw-err hidden></p>
				<div class="dkw-actions">
					<button type="button" class="dkw-word dkw-danger" data-act="delete-card" data-name={ c.Name }>Delete this card</button>
				</div>
			</div>
		</div>
	</form>
}

// fitWord is a card's mark in one word, for the grid.
func fitWord(c DirectorCard) string {
	if c.FitsNow {
		return "fits"
	}
	return "waiting"
}

func fitLabel(c DirectorCard) string {
	if c.FitsNow {
		return "Fits now"
	}
	return "Waiting"
}

// fitSuffix adds a card's mark to the grid link's name, since the mark itself
// is drawn for the eye and its words are read here.
func fitSuffix(c DirectorCard) string {
	if len(c.When) == 0 {
		return ""
	}
	return ", " + strings.ToLower(fitLabel(c))
}

// whenData is a card's tests as the editor's script reads them, with the
// sentence and whether each still points at something.
func whenData(c DirectorCard) string {
	list := c.When
	if list == nil {
		list = []WhenView{}
	}
	b, err := json.Marshal(list)
	if err != nil {
		return "[]"
	}
	return string(b)
}

// whenState is the card's line "Now": whether it fits, why not, and whether the
// Director has said so.
func whenState(c DirectorCard) string {
	st := struct {
		Fits   bool       `json:"fitsNow"`
		Why    string     `json:"whyNot"`
		SaidAt *time.Time `json:"saidAt"`
	}{c.FitsNow, c.WhyNot, c.SaidAt}
	b, err := json.Marshal(st)
	if err != nil {
		return "{}"
	}
	return string(b)
}

var ordinals = []string{"first", "second", "third", "fourth"}

// printedHint says, under the card, which of its conditions it does not show:
// only when it has some printed and some of the Director's own.
func printedHint(tests []WhenView) string {
	var printed, own []string
	for i, t := range tests {
		if i >= len(ordinals) {
			break
		}
		if t.Open {
			printed = append(printed, ordinals[i])
		} else {
			own = append(own, ordinals[i])
		}
	}
	if len(printed) == 0 || len(own) == 0 {
		return ""
	}
	verb, noun := "is", "condition"
	if len(own) > 1 {
		verb, noun = "are", "conditions"
	}
	return "The " + joinAnd(own) + " " + noun + " " + verb + " yours alone, so the card shows only the " + joinAnd(printed) + "."
}

func joinAnd(w []string) string {
	if len(w) <= 1 {
		return strings.Join(w, "")
	}
	return strings.Join(w[:len(w)-1], ", ") + " and " + w[len(w)-1]
}
