package decks

import (
	"strconv"

	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// LooksPage is the Director's proof sheet of every look a card has. It is the
// sheet the automated sweep and the owner's eyes use until the workshop
// exists, and it goes when the workshop's Look tab lands.
templ LooksPage(secs []proofSection) {
	@layouts.App("Card looks") {
		@CardSheet()
		<div class="dk-pf" data-dk-proof>
			<header>
				<h1 class="dk-pf-h1">Card looks</h1>
				<p>Every border, back, window, lettering, corner, marker and finish a deck can have, and every turn-over and move. Samples only: nothing here is saved.</p>
			</header>
			for _, sec := range secs {
				<section class="dk-pf-sec" id={ sec.ID } aria-labelledby={ sec.ID + "-h" }>
					<h2 id={ sec.ID + "-h" }>{ sec.Title }</h2>
					if sec.Note != "" {
						<p>{ sec.Note }</p>
					}
					<div class="dk-pf-row">
						for _, cell := range sec.Cells {
							@proofCellView(cell)
						}
					</div>
				</section>
			}
		</div>
	}
}

// proofCellView is one sample with its label, and its controls if it plays.
templ proofCellView(cell proofCell) {
	<div class="dk-pf-one" data-dk-one>
		if cell.Move != "" {
			@proofMove(cell)
		} else if cell.Turn != "" {
			<div data-dk-slot>
				@CardView(cell.Look, cell.State, cell.Opts)
			</div>
			<template class="dk-face-tpl" data-delay="0">
				@CardFace(cell.Look, proofUp("k-violet", "7", false), cell.Opts)
			</template>
			<template class="dk-down-tpl">
				@CardView(cell.Look, cell.State, cell.Opts)
			</template>
			<button type="button" class="dk-pf-play" data-dk-reset>Reset</button>
		} else {
			@CardView(cell.Look, cell.State, cell.Opts)
		}
		<span class="dk-pf-lbl">{ cell.Label }</span>
	</div>
}

// proofMove is a sample card on a small field with a button that plays one
// fixed move on it.
templ proofMove(cell proofCell) {
	{{ dx, dy := moveOffset(cell.Move) }}
	<div class="dk-pf-field">
		if cell.Pile {
			<div class="dk-pf-pile">
				@CardView(cell.Look, FaceDown(), CardOpts{Size: SizeHand, DeckName: "Sample deck"})
				@CardView(cell.Look, FaceDown(), CardOpts{Size: SizeHand, DeckName: "Sample deck"})
				@CardView(cell.Look, FaceDown(), CardOpts{Size: SizeHand, DeckName: "Sample deck"})
			</div>
		} else {
			@CardView(cell.Look, cell.State, CardOpts{Size: SizeHand})
		}
	</div>
	<button type="button" class="dk-pf-play" data-dk-move={ cell.Move } data-dx={ strconv.Itoa(dx) } data-dy={ strconv.Itoa(dy) } aria-label={ "Play " + cell.Move }>Play</button>
}

// proofPageBody is the sheet without the page frame, so a test can draw it.
templ proofPageBody(secs []proofSection) {
	<div class="dk-pf" data-dk-proof>
		for _, sec := range secs {
			<section class="dk-pf-sec" id={ sec.ID }>
				<div class="dk-pf-row">
					for _, cell := range sec.Cells {
						@proofCellView(cell)
					}
				</div>
			</section>
		}
	</div>
}
