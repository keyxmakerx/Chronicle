package decks

// Emblem draws a deck's back sign on a 40 by 40 box. "none" and an unknown
// sign draw nothing.
templ Emblem(sign string) {
	if d, ok := emblemPath[sign]; ok {
		<svg class="dk-em" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
			if sign == "anchor" {
				<g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round">
					<circle cx="20" cy="7" r="3.6"></circle>
					<path d="M20 11v25M12 17h16M5 24c1 8 7 12 15 12s14-4 15-12"></path>
				</g>
			}
			if sign == "eye" {
				<path fill-rule="evenodd" d={ d }></path>
			} else {
				<path d={ d }></path>
			}
		</svg>
	}
}
