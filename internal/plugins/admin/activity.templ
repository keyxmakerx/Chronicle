package admin

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// AdminActivityPage renders the full, paginated log of admin changes.
templ AdminActivityPage(entries []ActivityEntry, total, page, perPage int) {
	@layouts.App("Admin activity - Admin") {
		<div class="max-w-4xl mx-auto space-y-6">
			<div>
				<h1 class="text-2xl font-bold text-fg">Admin activity</h1>
				<p class="text-sm text-fg-muted mt-1">
					Every change made from the admin area, newest first, and who made it.
					{ fmt.Sprintf("%d", total) } recorded so far.
				</p>
			</div>
			<div class="card">
				@activityList(entries)
			</div>
			@components.Pagination(components.PaginationData{
				CurrentPage: page,
				PerPage:     perPage,
				Total:       total,
				BaseURL:     "/admin/activity",
			})
		</div>
	}
}
