package admin

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// DataHygienePage renders the admin data hygiene dashboard with orphan
// detection results and guarded cleanup actions.
templ DataHygienePage(data DataHygieneData) {
	@layouts.App("Storage & cleanup") {
		<div id="hygiene-content" class="max-w-5xl mx-auto space-y-6">
			@components.AdminGroupHeading(components.AdminTabsStorage, "/admin/data-hygiene")
			<p class="text-sm text-fg-secondary">
				Find uploads, keys and files that nothing uses any more, and clear them out.
				Every clean-up asks you first and is written to the admin activity log.
			</p>
			if data.ScanFailed {
				<div class="card border border-amber-500/50 bg-amber-50 dark:bg-amber-900/20" role="alert">
					<p class="text-sm font-medium text-fg"><i class="fa-solid fa-triangle-exclamation text-amber-500 mr-2"></i>Part of the scan did not finish</p>
					<p class="text-sm text-fg-secondary mt-1">Some results below may be missing, so an empty list does not mean everything is clean. Reload to try again; the server log has the details.</p>
				</div>
			}

			<!-- Summary Cards -->
			if data.Stats != nil {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
					<div class="card">
						<p class="text-sm font-medium text-fg-secondary">Disk usage</p>
						<p class="text-2xl font-bold text-fg mt-1">{ formatBytes(data.Stats.TotalDiskBytes) }</p>
						<p class="text-xs text-fg-muted mt-1">{ formatBytes(data.Stats.TrackedDBBytes) } tracked in DB</p>
					</div>
					<div class="card">
						<p class="text-sm font-medium text-fg-secondary">Unattached uploads</p>
						<p class="text-2xl font-bold text-fg mt-1">{ fmt.Sprintf("%d", data.Stats.OrphanMediaCount) }</p>
						<p class="text-xs text-fg-muted mt-1">{ formatBytes(data.Stats.OrphanMediaBytes) } you could free</p>
					</div>
					<div class="card">
						<p class="text-sm font-medium text-fg-secondary">Keys for deleted campaigns</p>
						<p class="text-2xl font-bold text-fg mt-1">{ fmt.Sprintf("%d", data.Stats.OrphanAPIKeys) }</p>
						<p class="text-xs text-fg-muted mt-1">Can no longer be used</p>
					</div>
					<div class="card">
						<p class="text-sm font-medium text-fg-secondary">Leftover files</p>
						<p class="text-2xl font-bold text-fg mt-1">{ fmt.Sprintf("%d", data.Stats.StaleFileCount) }</p>
						<p class="text-xs text-fg-muted mt-1">{ formatBytes(data.Stats.StaleFileBytes) } on disk</p>
					</div>
				</div>
			}

			<!-- Orphaned Media Section -->
			<div class="card space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-lg font-semibold text-fg">
						<i class="fa-solid fa-image text-amber-500 mr-2"></i>
						Uploads with no campaign
					</h2>
					if len(data.OrphanedMedia) > 0 {
						<button
							hx-delete="/admin/data-hygiene/orphaned-media"
							hx-confirm={ fmt.Sprintf("Move %d uploads that no campaign page uses to the trash? You can undo this from Trash until it empties.", countUnreferenced(data.OrphanedMedia)) }
							hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, data.CSRFToken) }
							hx-swap="none"
							class="btn btn-sm btn-danger"
						>
							<i class="fa-solid fa-trash mr-1"></i> Move unused uploads to trash
						</button>
					}
				</div>
				if len(data.OrphanedMedia) == 0 {
					<p class="text-sm text-fg-muted">No unattached uploads found.</p>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b border-edge text-left text-fg-muted">
									<th class="pb-2">File name</th>
									<th class="pb-2">Size</th>
									<th class="pb-2">Created</th>
									<th class="pb-2">Status</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-edge">
								for _, item := range data.OrphanedMedia {
									<tr>
										<td class="py-2 font-mono text-xs">{ item.Filename }</td>
										<td class="py-2">{ formatBytes(item.FileSize) }</td>
										<td class="py-2">{ item.CreatedAt.Format("2006-01-02") }</td>
										<td class="py-2">
											if item.Referenced {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">
													<i class="fa-solid fa-link mr-1"></i> Still in use
												</span>
											} else {
												<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-700 dark:bg-red-900/30 dark:text-red-400">
													<i class="fa-solid fa-unlink mr-1"></i> Unused
												</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Orphaned API Keys Section -->
			<div class="card space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-lg font-semibold text-fg">
						<i class="fa-solid fa-key text-red-500 mr-2"></i>
						API keys for deleted campaigns
					</h2>
					if len(data.OrphanedAPIKeys) > 0 {
						<button
							hx-delete="/admin/data-hygiene/orphaned-api-keys"
							hx-confirm={ fmt.Sprintf("Delete %d API keys that belong to deleted campaigns? This cannot be undone.", len(data.OrphanedAPIKeys)) }
							hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, data.CSRFToken) }
							hx-swap="none"
							class="btn btn-sm btn-danger"
						>
							<i class="fa-solid fa-trash mr-1"></i> Delete these keys
						</button>
					}
				</div>
				if len(data.OrphanedAPIKeys) == 0 {
					<p class="text-sm text-fg-muted">No API keys for deleted campaigns.</p>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b border-edge text-left text-fg-muted">
									<th class="pb-2">Key starts with</th>
									<th class="pb-2">Name</th>
									<th class="pb-2">Deleted campaign</th>
									<th class="pb-2">Created</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-edge">
								for _, item := range data.OrphanedAPIKeys {
									<tr>
										<td class="py-2 font-mono">{ item.KeyPrefix }...</td>
										<td class="py-2">{ item.Name }</td>
										<td class="py-2 font-mono text-xs text-fg-muted">{ item.CampaignID }</td>
										<td class="py-2">{ item.CreatedAt.Format("2006-01-02") }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Stale Files Section -->
			<div class="card space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-lg font-semibold text-fg">
						<i class="fa-solid fa-ghost text-purple-500 mr-2"></i>
						Leftover files on disk
					</h2>
					if len(data.StaleFiles) > 0 {
						<button
							hx-delete="/admin/data-hygiene/stale-files"
							hx-confirm={ fmt.Sprintf("Delete %d leftover files from disk? This cannot be undone.", len(data.StaleFiles)) }
							hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, data.CSRFToken) }
							hx-swap="none"
							class="btn btn-sm btn-danger"
						>
							<i class="fa-solid fa-trash mr-1"></i> Delete leftover files
						</button>
					}
				</div>
				if len(data.StaleFiles) == 0 {
					<p class="text-sm text-fg-muted">No leftover files on disk.</p>
				} else {
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b border-edge text-left text-fg-muted">
									<th class="pb-2">Path</th>
									<th class="pb-2">Size</th>
									<th class="pb-2">Modified</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-edge">
								for _, item := range data.StaleFiles {
									<tr>
										<td class="py-2 font-mono text-xs">{ item.Path }</td>
										<td class="py-2">{ formatBytes(item.Size) }</td>
										<td class="py-2">{ item.ModTime.Format("2006-01-02 15:04") }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	}
}

// countUnreferenced returns the number of orphaned media items that are not
// referenced by any entity and can safely be purged.
func countUnreferenced(items []OrphanedMediaItem) int {
	count := 0
	for _, item := range items {
		if !item.Referenced {
			count++
		}
	}
	return count
}
