package admin

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// AdminDashboardPage renders the admin overview: what needs attention, then one
// row of tiles per admin menu section.
templ AdminDashboardPage(groups []HomeGroup, needs []NeedsItem, recent []ActivityEntry) {
	@layouts.App("Home - Admin") {
		<div class="max-w-5xl mx-auto space-y-6">
			<h1 class="text-2xl font-bold text-fg">Home</h1>

			@needsYouCard(needs)

			for _, g := range groups {
				<div>
					<h2 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-fg-muted mb-3">{ g.Label }</h2>
					<div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
						for _, t := range g.Tiles {
							@homeTile(t)
						}
					</div>
				</div>
			}

			@recentActivityCard(recent)
		</div>
	}
}

// needsYouCard lists what the admin has to act on, most urgent first, each row
// with one button to the page that fixes it.
templ needsYouCard(items []NeedsItem) {
	<div class="card">
		<h2 class="text-sm font-semibold text-fg mb-3">Needs you</h2>
		if len(items) == 0 {
			<p class="text-sm text-fg-muted"><i class="fa-solid fa-circle-check text-emerald-500 mr-1.5"></i>Nothing needs you right now.</p>
		} else {
			<ul class="divide-y divide-edge">
				for _, it := range items {
					<li class="flex items-center gap-3 py-2.5">
						<span class={ "shrink-0 min-w-[1.75rem] text-center font-mono tabular-nums text-xs font-semibold px-2 py-0.5 rounded-full",
							templ.KV("bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300", it.Urgent()),
							templ.KV("bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300", !it.Urgent()) }>{ needsCountLabel(it.Count) }</span>
						<p class="text-sm text-fg flex-1">{ it.Text }</p>
						<a href={ templ.SafeURL(it.Href) } class="btn-secondary text-xs shrink-0">{ it.Button }</a>
					</li>
				}
			</ul>
		}
	</div>
}

// recentActivityCard shows the latest admin changes and links to the full log.
templ recentActivityCard(entries []ActivityEntry) {
	<div class="card">
		<div class="flex items-center justify-between mb-3">
			<h2 class="text-sm font-semibold text-fg">Recent admin changes</h2>
			<a href="/admin/activity" class="text-xs text-fg-muted hover:text-accent transition-colors">See all changes &rarr;</a>
		</div>
		@activityList(entries)
	</div>
}

// activityList renders entries as "Mara made Theo an admin" rows with a
// relative time on the right.
templ activityList(entries []ActivityEntry) {
	if len(entries) == 0 {
		<p class="text-sm text-fg-muted">No admin changes have been recorded yet.</p>
	} else {
		<ul class="divide-y divide-edge">
			for _, e := range entries {
				<li class="flex items-baseline justify-between gap-3 py-2 text-sm">
					<span class="text-fg min-w-0 break-words">
						<i class={ "fa-solid " + e.AreaMeta().Icon + " w-5 text-center text-fg-muted mr-1" } title={ e.AreaMeta().Label } aria-hidden="true"></i>
						<span class="sr-only">{ e.AreaMeta().Label }: </span>
						{ e.Sentence() }
					</span>
					<span class="text-xs text-fg-muted shrink-0" title={ e.CreatedAt.Format("2006-01-02 15:04 MST") }>{ timeAgo(e.CreatedAt) }</span>
				</li>
			}
		</ul>
	}
}

// countOrDash shows a dash when the count could not be loaded (negative), so a
// failed lookup never reads as "0".
func countOrDash(n int) string {
	if n < 0 {
		return "—"
	}
	return fmt.Sprintf("%d", n)
}

// homeTile is one uniform tile: figure, menu label, one line, optional dot.
templ homeTile(t HomeTile) {
	<a href={ templ.SafeURL(t.Href) } class="card relative min-w-0 hover:shadow-md transition-shadow group">
		if t.Attention {
			<span class="absolute top-3 right-3 w-2.5 h-2.5 rounded-full bg-amber-500" aria-hidden="true"></span>
			<span class="sr-only">Needs a look</span>
		}
		<p class="font-mono tabular-nums text-2xl font-bold text-fg break-words">{ t.Big }</p>
		<p class="text-sm font-medium text-fg-secondary mt-1 break-words">{ t.Label }</p>
		<p class="text-xs text-fg-muted mt-0.5 break-words group-hover:text-accent transition-colors">{ t.Line }</p>
	</a>
}
