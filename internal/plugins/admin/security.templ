package admin

import (
	"fmt"
	"net/url"
	"strings"
	"time"
	"github.com/keyxmakerx/chronicle/internal/plugins/auth"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// timeAgo returns a human-readable relative time string.
func timeAgo(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d.Minutes())
		if m == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", m)
	case d < 24*time.Hour:
		h := int(d.Hours())
		if h == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", h)
	default:
		days := int(d.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	}
}

// shortUA extracts a short browser/client label from a User-Agent string.
func shortUA(ua string) string {
	if ua == "" {
		return "Unknown"
	}
	// Simple extraction: look for known browser names.
	switch {
	case strings.Contains(ua, "Firefox"):
		return "Firefox"
	case strings.Contains(ua, "Edg/"):
		return "Edge"
	case strings.Contains(ua, "Chrome"):
		return "Chrome"
	case strings.Contains(ua, "Safari"):
		return "Safari"
	case strings.Contains(ua, "curl"):
		return "curl"
	default:
		if len(ua) > 30 {
			return ua[:30] + "..."
		}
		return ua
	}
}

// AdminSecurityPage renders Sign-ins & sessions as four server-rendered tabs
// so each part fits one screen and every tab is a plain link.
templ AdminSecurityPage(data SecurityPageData) {
	@layouts.App("Sign-ins & sessions - Admin") {
		<div class="max-w-6xl mx-auto space-y-6">
			<div>
				<h1 class="text-2xl font-bold text-fg">Sign-ins &amp; sessions</h1>
				@securityTabs(data)
			</div>
			switch data.Tab {
				case SecurityTabSessions:
					<div class="space-y-4">
						if data.SessionsFailed {
							@loadFailedNotice("signed-in sessions")
						} else {
							@activeSessionsTable(data.Sessions, data.CSRFToken)
						}
					</div>
				case SecurityTabLog:
					@securityLogTab(data)
				case SecurityTabSignup:
					@registrationGateCard(data.RegistrationMode, data.CSRFToken)
				default:
					@securityOverviewTab(data)
			}
		</div>
	}
}

// securityTabCount is the number shown on the "Signed in now" tab: the open
// tab's own list when loaded, otherwise the summary figure; -1 hides it.
func securityTabCount(data SecurityPageData) int {
	if data.Tab == SecurityTabSessions && !data.SessionsFailed {
		return len(data.Sessions)
	}
	if data.Stats != nil && !data.StatsFailed {
		return data.Stats.ActiveSessions
	}
	return -1
}

// securityTabs renders the tab strip. It scrolls inside itself so a narrow
// phone never scrolls the page sideways.
templ securityTabs(data SecurityPageData) {
	<nav class="mt-3 -mx-1 overflow-x-auto border-b border-edge" aria-label="Sign-ins and sessions sections">
		<ul class="flex gap-1 px-1 text-sm whitespace-nowrap">
			@securityTab(data.Tab, SecurityTabOverview, "Overview")
			if n := securityTabCount(data); n >= 0 {
				@securityTab(data.Tab, SecurityTabSessions, fmt.Sprintf("Signed in now (%d)", n))
			} else {
				@securityTab(data.Tab, SecurityTabSessions, "Signed in now")
			}
			@securityTab(data.Tab, SecurityTabLog, "Sign-in log")
			@securityTab(data.Tab, SecurityTabSignup, "Who can sign up")
		</ul>
	</nav>
}

templ securityTab(current, tab, label string) {
	<li>
		if current == tab {
			<a href={ templ.SafeURL(securityTabHref(tab)) } aria-current="page" class="inline-block px-3 py-2 border-b-2 border-accent text-fg font-medium rounded-t focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">{ label }</a>
		} else {
			<a href={ templ.SafeURL(securityTabHref(tab)) } class="inline-block px-3 py-2 border-b-2 border-transparent text-fg-muted hover:text-fg rounded-t focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">{ label }</a>
		}
	</li>
}

// registrationModeSentence names the mode in plain words for the overview.
func registrationModeSentence(mode string) string {
	switch mode {
	case "invite":
		return "invite only"
	case "closed":
		return "closed to new accounts"
	default:
		return "open to anyone"
	}
}

// securityOverviewTab shows three figures, anything worth a look, and the
// current sign-up mode. "Accounts turned off" stands in for "locked" because
// Chronicle has no automatic lockout; turned-off accounts are the nearest
// real figure.
templ securityOverviewTab(data SecurityPageData) {
	<div class="space-y-6">
		if data.StatsFailed {
			@loadFailedNotice("the sign-in summary")
		} else if data.Stats != nil {
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<div class="card text-center">
					<p class="text-2xl font-bold text-fg">{ fmt.Sprintf("%d", data.Stats.ActiveSessions) }</p>
					<p class="text-xs text-fg-muted mt-1">signed in now</p>
				</div>
				<div class="card text-center">
					<p class={ "text-2xl font-bold", templ.KV("text-red-600 dark:text-red-400", data.Stats.FailedLogins24h > 0), templ.KV("text-fg", data.Stats.FailedLogins24h == 0) }>{ fmt.Sprintf("%d", data.Stats.FailedLogins24h) }</p>
					<p class="text-xs text-fg-muted mt-1">wrong passwords in the last 24 hours</p>
				</div>
				<div class="card text-center">
					<p class="text-2xl font-bold text-fg">{ fmt.Sprintf("%d", data.Stats.DisabledUsers) }</p>
					<p class="text-xs text-fg-muted mt-1">accounts turned off</p>
				</div>
			</div>
		}
		<section class="card p-0 overflow-hidden" aria-labelledby="worth-a-look">
			<div class="px-4 py-3 border-b border-edge">
				<h2 id="worth-a-look" class="text-lg font-semibold text-fg">Worth a look</h2>
			</div>
			if data.EventsFailed {
				<p class="p-4 text-sm text-amber-700 dark:text-amber-300" role="alert">Couldn't read recent sign-in attempts. Reload the page to try again.</p>
			} else if len(data.WatchItems) == 0 {
				<p class="px-4 py-6 text-sm text-fg-muted">Nothing unusual in the last 24 hours.</p>
			} else {
				<ul class="divide-y divide-edge">
					for _, it := range data.WatchItems {
						<li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
							<div class="min-w-0">
								<p class="text-sm font-medium text-fg break-words">{ it.Title }</p>
								<p class="text-xs text-fg-muted">{ it.Detail }</p>
							</div>
							<a href="/admin/security?tab=log&type=login.failed" class="btn-secondary text-sm">See in log</a>
						</li>
					}
				</ul>
			}
		</section>
		<p class="text-sm text-fg-secondary">
			Sign-ups are <strong>{ registrationModeSentence(data.RegistrationMode) }</strong>.
			<a href={ templ.SafeURL(securityTabHref(SecurityTabSignup)) } class="text-accent hover:underline">Change it on "Who can sign up"</a>.
		</p>
	</div>
}

// securityLogTab is the filterable, paged sign-in and admin event log.
templ securityLogTab(data SecurityPageData) {
	<div class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<p class="text-sm text-fg-muted">{ fmt.Sprintf("%d", data.TotalEvents) } events</p>
			<select
				aria-label="Filter events by type"
				onchange="window.location.href='/admin/security?tab=log&type='+encodeURIComponent(this.value)"
				class="text-sm rounded-lg border border-edge bg-surface px-3 py-1.5 text-fg"
			>
				<option value="" selected?={ data.EventFilter == "" }>All Events</option>
				<option value="login.success" selected?={ data.EventFilter == "login.success" }>Logins</option>
				<option value="login.failed" selected?={ data.EventFilter == "login.failed" }>Failed Logins</option>
				<option value="logout" selected?={ data.EventFilter == "logout" }>Logouts</option>
				<option value="password.reset_initiated" selected?={ data.EventFilter == "password.reset_initiated" }>Password Resets</option>
				<option value="admin.privilege_changed" selected?={ data.EventFilter == "admin.privilege_changed" }>Admin Changes</option>
				<option value="admin.user_disabled" selected?={ data.EventFilter == "admin.user_disabled" }>User Disabled</option>
				<option value="admin.user_enabled" selected?={ data.EventFilter == "admin.user_enabled" }>User Enabled</option>
				<option value="admin.session_terminated" selected?={ data.EventFilter == "admin.session_terminated" }>Session Terminated</option>
				<option value="admin.force_logout" selected?={ data.EventFilter == "admin.force_logout" }>Force Logout</option>
				<option value="password.reset_completed" selected?={ data.EventFilter == "password.reset_completed" }>Password Reset Completed</option>
				<option value="admin.diagnostics_batch_run" selected?={ data.EventFilter == "admin.diagnostics_batch_run" }>Diagnostics Batch Run</option>
				<option value="media.uploaded" selected?={ data.EventFilter == "media.uploaded" }>Media Uploaded</option>
				<option value="media.deleted" selected?={ data.EventFilter == "media.deleted" }>Media Deleted</option>
				<option value="media.quota_exceeded" selected?={ data.EventFilter == "media.quota_exceeded" }>Media Quota Exceeded</option>
			</select>
		</div>
		if data.EventsFailed {
			@loadFailedNotice("the event log")
		} else {
			@securityEventLog(data.Events, data.TotalEvents, data.Page, data.PerPage, data.EventFilter)
		}
	</div>
}

// registrationGateCard renders the site registration-mode control (B-R4):
// open / invite-only / closed. Saving is reauth-gated on the server.
templ registrationGateCard(mode, csrfToken string) {
	<div class="card p-6 space-y-4">
		<div class="flex items-center gap-2">
			<i class="fa-solid fa-user-lock text-accent"></i>
			<h2 class="text-lg font-semibold text-fg">Who can sign up</h2>
		</div>
		<p class="text-sm text-fg-secondary">
			Control who can create new accounts. The first account on a fresh
			instance always becomes the admin, regardless of this setting.
		</p>
		<form
			hx-post="/admin/security/registration"
			hx-swap="none"
			class="flex flex-wrap items-end gap-3"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<div>
				<label for="registration_mode" class="block text-sm font-medium text-fg-body mb-1.5">
					Mode
				</label>
				<select
					id="registration_mode"
					name="registration_mode"
					class="text-sm rounded-lg border border-edge bg-surface px-3 py-2 text-fg"
				>
					<option value="open" selected?={ mode == "open" }>Open — anyone can register</option>
					<option value="invite" selected?={ mode == "invite" }>Invite-only — requires a campaign invite</option>
					<option value="closed" selected?={ mode == "closed" }>Closed — no new accounts</option>
				</select>
			</div>
			<button type="submit" class="btn-primary py-2 px-4">Save</button>
		</form>
	</div>
}

// activeSessionsTable renders the list of active sessions with actions.
templ activeSessionsTable(sessions []auth.SessionInfo, csrfToken string) {
	<div class="card p-0 overflow-hidden">
		if len(sessions) == 0 {
			<div class="px-4 py-8 text-center text-fg-muted">
				<i class="fa-solid fa-tower-broadcast text-2xl mb-2 block"></i>
				<p>No active sessions</p>
			</div>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full">
					<thead>
						<tr class="bg-surface-alt border-b border-edge">
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">User</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">IP Address</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Client</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Created</th>
							<th class="text-right px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-edge">
						for _, s := range sessions {
							<tr class="hover:bg-surface-alt transition-colors">
								<td class="px-4 py-3">
									<div class="flex flex-col">
										<span class="text-sm font-medium text-fg">{ s.Name }</span>
										<span class="text-xs text-fg-muted">{ s.Email }</span>
									</div>
								</td>
								<td class="px-4 py-3">
									<code class="text-xs bg-surface-alt px-1.5 py-0.5 rounded text-fg-secondary">{ s.IP }</code>
									if s.IP == "" {
										<span class="text-xs text-fg-muted italic">not tracked</span>
									}
								</td>
								<td class="px-4 py-3 text-sm text-fg-secondary" title={ s.UserAgent }>
									{ shortUA(s.UserAgent) }
								</td>
								<td class="px-4 py-3 text-sm text-fg-muted" title={ s.CreatedAt.Format("2006-01-02 15:04:05 UTC") }>
									{ timeAgo(s.CreatedAt) }
								</td>
								<td class="px-4 py-3 text-right">
									<button
										hx-delete={ fmt.Sprintf("/admin/security/sessions/%s", s.TokenHash) }
										hx-confirm="Terminate this session? The user will be logged out."
										hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
										aria-label={ "Terminate session for " + s.Name }
										class="text-xs link-danger transition-colors"
									>
										Terminate
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// securityEventLog renders the paginated security event list.
templ securityEventLog(events []SecurityEvent, total, page, perPage int, eventFilter string) {
	<div class="card p-0 overflow-hidden">
		if len(events) == 0 {
			<div class="px-4 py-8 text-center text-fg-muted">
				<i class="fa-solid fa-shield-halved text-2xl mb-2 block"></i>
				<p>No security events recorded yet</p>
			</div>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full">
					<thead>
						<tr class="bg-surface-alt border-b border-edge">
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Event</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">User</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">IP Address</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Details</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Time</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-edge">
						for _, e := range events {
							<tr class="hover:bg-surface-alt transition-colors">
								<td class="px-4 py-3">
									<div class="flex items-center gap-2">
										<i class={ EventTypeIcon(e.EventType) }></i>
										<span class="text-sm font-medium text-fg">{ EventTypeLabel(e.EventType) }</span>
									</div>
								</td>
								<td class="px-4 py-3">
									if e.UserName != "" {
										<span class="text-sm text-fg-secondary">{ e.UserName }</span>
									} else if e.UserID != "" {
										<span class="text-xs text-fg-muted font-mono">{ e.UserID[:8] }...</span>
									} else {
										<span class="text-xs text-fg-muted italic">-</span>
									}
									if e.ActorName != "" {
										<span class="text-xs text-fg-muted block">by { e.ActorName }</span>
									}
								</td>
								<td class="px-4 py-3">
									if e.IPAddress != "" {
										<code class="text-xs bg-surface-alt px-1.5 py-0.5 rounded text-fg-secondary">{ e.IPAddress }</code>
									} else {
										<span class="text-xs text-fg-muted">-</span>
									}
								</td>
								<td class="px-4 py-3 text-sm text-fg-muted">
									@eventDetails(e)
								</td>
								<td class="px-4 py-3 text-sm text-fg-muted" title={ e.CreatedAt.Format("2006-01-02 15:04:05 UTC") }>
									{ timeAgo(e.CreatedAt) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>

	<!-- Pagination -->
	if total > perPage {
		<div class="flex justify-center items-center gap-4 mt-4">
			if page > 1 {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/admin/security?tab=log&page=%d&type=%s", page-1, url.QueryEscape(eventFilter))) }
					class="btn-secondary text-sm"
				>
					Previous
				</a>
			} else {
				<span class="btn text-sm text-fg-muted cursor-not-allowed opacity-50">Previous</span>
			}
			<span class="text-sm text-fg-secondary">
				Page { fmt.Sprintf("%d", page) } of { fmt.Sprintf("%d", (total+perPage-1)/perPage) }
			</span>
			if page*perPage < total {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/admin/security?tab=log&page=%d&type=%s", page+1, url.QueryEscape(eventFilter))) }
					class="btn-secondary text-sm"
				>
					Next
				</a>
			} else {
				<span class="btn text-sm text-fg-muted cursor-not-allowed opacity-50">Next</span>
			}
		</div>
	}
}

// eventDetails renders contextual detail text for a security event.
templ eventDetails(e SecurityEvent) {
	switch e.EventType {
		case EventLoginFailed:
			if email, ok := e.Details["email"]; ok {
				<span>Attempted: { fmt.Sprintf("%v", email) }</span>
			}
		case EventAdminPrivilegeChanged:
			if action, ok := e.Details["action"]; ok {
				<span>Admin { fmt.Sprintf("%v", action) }</span>
			}
		case EventForceLogout:
			if count, ok := e.Details["sessions_destroyed"]; ok {
				<span>{ fmt.Sprintf("%v", count) } session(s) destroyed</span>
			}
		case EventSessionTerminated:
			if hint, ok := e.Details["token_hint"]; ok {
				<span>Session ending { fmt.Sprintf("%v", hint) }...</span>
			}
		default:
			<span>-</span>
	}
}

// loadFailedNotice stands in for a section whose data could not be read, so an
// outage is not mistaken for "nothing happened".
templ loadFailedNotice(what string) {
	<div class="card p-4 text-sm text-amber-700 dark:text-amber-300" role="alert">
		<i class="fa-solid fa-triangle-exclamation mr-1.5"></i>
		Couldn't load { what }. Reload the page to try again.
	</div>
}
