package admin

import (
	"fmt"
	"time"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CampaignListData is what the campaign list renders: one page of campaigns
// plus the search/chip/pager state.
type CampaignListData struct {
	Campaigns []campaigns.Campaign
	// Handover is each listed campaign's owner, when they were last seen
	// and whether an admin may hand it over yet.
	Handover  map[string]campaigns.HandoverStatus
	Now       time.Time
	View      listView
	CSRFToken string
}

// AdminCampaignsPage renders the campaign management page: search box and
// the list region.
templ AdminCampaignsPage(data CampaignListData) {
	@layouts.App("Campaigns - Admin") {
		<div class="max-w-4xl mx-auto space-y-6">
			<h1 class="text-2xl font-bold text-fg">Campaigns</h1>
			@adminListSearch(data.View)
			@AdminCampaignsList(data)
		</div>
	}
}

// AdminCampaignsList is the swappable region of the campaigns page (chips,
// table and pager). HTMX requests get just this; the id is the swap target.
templ AdminCampaignsList(data CampaignListData) {
	{{ allCampaigns := data.Campaigns }}
	{{ csrfToken := data.CSRFToken }}
	<div id={ data.View.RegionID } class="space-y-6">
		if data.View.Filter != "" {
			<input type="hidden" name="f" value={ data.View.Filter } form={ data.View.RegionID + "-search" }/>
		}
		@adminListChips(data.View)
		<div class="card p-0 overflow-hidden hidden md:block">
			<table class="w-full">
				<thead>
					<tr class="bg-surface-alt border-b border-edge">
						<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Name</th>
						<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Owner</th>
						<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Created</th>
						<th class="text-right px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-edge">
					if len(allCampaigns) > 0 {
						for _, c := range allCampaigns {
							<tr class="hover:bg-surface-alt transition-colors">
								<td class="px-4 py-3">
									<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s", c.ID)) } class="text-sm font-medium text-accent hover:text-accent-hover transition-colors">
										{ c.Name }
									</a>
								</td>
								<td class="px-4 py-3 text-sm">
									if st, ok := data.Handover[c.ID]; ok {
										<div class="text-fg-body">{ st.OwnerName } <span class="text-fg-muted">· { lastSeenText(st.LastSeen, data.Now) }</span></div>
										<div class={ "text-xs", templ.KV("text-orange-600 dark:text-orange-400", st.Open), templ.KV("text-fg-muted", !st.Open) }>
											{ handoverSettingText(st.AfterMonths) }
											if st.AfterMonths > 0 && !st.Open {
												· possible from { st.OpensAt.Format("Jan 2, 2006") }
											}
										</div>
									} else {
										<span class="text-fg-muted">{ c.Slug }</span>
									}
								</td>
								<td class="px-4 py-3 text-sm text-fg-muted">
									{ c.CreatedAt.Format("Jan 2, 2006") }
								</td>
								<td class="px-4 py-3 text-right">
									<div class="flex items-center justify-end gap-3">
										@adminActionMenu("Join as...", "", csrfToken, campaignJoinActions(c, csrfToken))
										for _, a := range handoverAction(c, data.Handover[c.ID]) {
											@adminInlineAction(a, csrfToken)
										}
										for _, a := range campaignRowActions(c) {
											@adminInlineAction(a, csrfToken)
										}
									</div>
								</td>
							</tr>
						}
					} else {
						@adminListEmpty(data.View, 4)
					}
				</tbody>
			</table>
		</div>
		<div class="card p-0 divide-y divide-edge md:hidden" data-testid="campaigns-cards">
			if len(allCampaigns) > 0 {
				for _, c := range allCampaigns {
					@adminCardRow(avatarInitial(c.Name), c.Name, fmt.Sprintf("/campaigns/%s", c.ID), campaignVisibilityLabel(c), "bg-surface-alt text-fg-secondary", c.Slug+" · created "+c.CreatedAt.Format("Jan 2, 2006"), csrfToken, campaignCardActions(c, data.Handover[c.ID], csrfToken))
				}
			} else {
				@adminListEmptyCard(data.View)
			}
		</div>
		@components.Pagination(components.PaginationData{
				CurrentPage: data.View.Page,
				PerPage:     data.View.PerPage,
				Total:       data.View.Total,
				BaseURL:     data.View.BaseURL,
				ExtraParams: data.View.PagerParams(),
			})
		</div>
}
