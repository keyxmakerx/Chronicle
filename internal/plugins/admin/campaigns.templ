package admin

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CampaignListData is what the campaign list renders: one page of campaigns
// plus the search/chip/pager state.
type CampaignListData struct {
	Campaigns []campaigns.Campaign
	View      listView
	CSRFToken string
}

// AdminCampaignsPage renders the campaign management page: search box and
// the list region.
templ AdminCampaignsPage(data CampaignListData) {
	@layouts.App("Campaigns - Admin") {
		<div class="max-w-4xl mx-auto space-y-6">
			<h1 class="text-2xl font-bold text-fg">Campaigns</h1>
			@adminListSearch(data.View)
			@AdminCampaignsList(data)
		</div>
	}
}

// AdminCampaignsList is the swappable region of the campaigns page (chips,
// table and pager). HTMX requests get just this; the id is the swap target.
templ AdminCampaignsList(data CampaignListData) {
	{{ allCampaigns := data.Campaigns }}
	{{ csrfToken := data.CSRFToken }}
	<div id={ data.View.RegionID } class="space-y-6">
		if data.View.Filter != "" {
			<input type="hidden" name="f" value={ data.View.Filter } form={ data.View.RegionID + "-search" }/>
		}
		@adminListChips(data.View)
		<div class="card p-0 overflow-hidden">
				<table class="w-full">
					<thead>
						<tr class="bg-surface-alt border-b border-edge">
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Name</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Slug</th>
							<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Created</th>
							<th class="text-right px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-edge">
						if len(allCampaigns) > 0 {
							for _, c := range allCampaigns {
								<tr class="hover:bg-surface-alt transition-colors">
									<td class="px-4 py-3">
										<a href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s", c.ID)) } class="text-sm font-medium text-accent hover:text-accent-hover transition-colors">
											{ c.Name }
										</a>
									</td>
									<td class="px-4 py-3 text-sm text-fg-muted">{ c.Slug }</td>
									<td class="px-4 py-3 text-sm text-fg-muted">
										{ c.CreatedAt.Format("Jan 2, 2006") }
									</td>
									<td class="px-4 py-3 text-right">
										<div class="flex items-center justify-end gap-3">
											<!-- Join as... dropdown -->
											<div class="relative" x-data="{ open: false }">
												<button
													@click="open = !open"
													@click.outside="open = false"
													class="text-sm text-accent hover:text-accent-hover transition-colors"
												>
													Join as...
												</button>
												<div
													x-show="open"
													x-transition
													class="absolute right-0 mt-1 w-36 bg-surface rounded-lg shadow-lg border border-edge z-10 overflow-hidden"
												>
													<form hx-post={ fmt.Sprintf("/admin/campaigns/%s/join", c.ID) } hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }>
														<input type="hidden" name="csrf_token" value={ csrfToken }/>
														<button type="submit" name="role" value="player" class="block w-full text-left px-4 py-2 text-sm text-fg-body hover:bg-surface-alt transition-colors">Player</button>
														<button type="submit" name="role" value="scribe" class="block w-full text-left px-4 py-2 text-sm text-fg-body hover:bg-surface-alt transition-colors">Scribe</button>
													</form>
													<form
														hx-post={ fmt.Sprintf("/admin/campaigns/%s/join", c.ID) }
														hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
														hx-confirm="Join as Owner? Ownership moves to you and the current owner loses it."
													>
														<input type="hidden" name="csrf_token" value={ csrfToken }/>
														<button type="submit" name="role" value="owner" class="block w-full text-left px-4 py-2 text-sm text-amber-600 hover:bg-surface-alt transition-colors">Owner (transfers)</button>
													</form>
												</div>
											</div>
											<button
												hx-delete={ fmt.Sprintf("/admin/campaigns/%s/leave", c.ID) }
												hx-confirm="Leave this campaign? You will lose the access you gave yourself."
												hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
												class="text-sm text-fg-muted hover:text-fg-body transition-colors"
											>
												Leave
											</button>
											<button
												hx-delete={ fmt.Sprintf("/admin/campaigns/%s", c.ID) }
												hx-confirm="Permanently delete this campaign and all its data?"
												hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
												class="text-sm link-danger transition-colors"
											>
												Delete
											</button>
										</div>
									</td>
								</tr>
							}
						} else {
							@adminListEmpty(data.View, 4)
						}
					</tbody>
				</table>
			</div>
			@components.Pagination(components.PaginationData{
				CurrentPage: data.View.Page,
				PerPage:     data.View.PerPage,
				Total:       data.View.Total,
				BaseURL:     data.View.BaseURL,
				ExtraParams: data.View.PagerParams(),
			})
		</div>
}
