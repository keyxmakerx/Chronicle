// diagnostics_workspace.templ is the Site admin "AI helper": READ-ONLY,
// secret-redacted diagnostics behind a human-approval gate.
//
//  1. The operator picks checks on the page: one of the everyday questions,
//     or by hand from the folded list (diagnostics_picker.templ). Or they copy
//     the checks list to an outside AI and paste back the request it composes.
//  2. Either way the request goes through ParseBatch, and the review step shows
//     exactly what will run (prompt-injection containment: a human approves
//     before execution; unknown names and full-dump requests are flagged).
//  3. "Approve & run" re-parses server-side, runs, and returns ONE compact,
//     redacted result the operator can copy back to the AI.
package admin

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/systems"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// CampaignOption is one selectable campaign for the review-step picker and the
// page's campaign reference panel.
type CampaignOption struct {
	ID   string
	Name string
	Slug string
}

// DiagnosticsWorkspaceData backs the landing page: the questions and folded
// checks to pick from, the functions spec to copy for an outside AI, the CSRF
// token, and the campaigns the blanks choose from.
type DiagnosticsWorkspaceData struct {
	FunctionsJSON string
	CSRFToken     string
	Campaigns     []CampaignOption
	Questions     []systems.DiagnosticQuestion
	Groups        []systems.PickerGroup
}

// DiagnosticsReviewData backs the review fragment: the validated plan plus the
// original pasted text (re-embedded so the run step re-parses + re-validates
// server-side rather than trusting a client-built plan).
type DiagnosticsReviewData struct {
	Raw           string
	Plan          *systems.BatchPlan
	Err           string
	CSRFToken     string
	NeedsCampaign bool             // a call left its campaign slot as a placeholder
	NeedsEntity   bool             // a call left its entity slot as a placeholder
	Campaigns     []CampaignOption // options for the campaign picker
}

// DiagnosticsResultData backs the result fragment: the compact redacted output.
type DiagnosticsResultData struct {
	Result string
}

// DiagnosticsWorkspacePage is the full admin page. The review step opens as a
// sheet pinned to the foot of the window, over the questions, with its close.
templ DiagnosticsWorkspacePage(data DiagnosticsWorkspaceData) {
	@layouts.App("AI helper") {
		<div class="dw max-w-5xl mx-auto space-y-5" data-widget="diag-picker">
			@components.AdminGroupHeading(components.AdminTabsHealth, "/admin/diagnostics/workspace")
			<div class="dw-head">
				<p class="text-sm text-fg-secondary">Pick what you are trying to find out. Chronicle picks the checks, shows you what will run, and runs nothing until you say so. Every check only reads, and secrets are removed from the result.</p>
				<div class="dw-handoff">
					<span data-widget="ai-export">
						<button type="button" class="quiet-word" data-ai-export-copy data-dw-copy>Copy checks for your AI</button>
						<pre data-ai-export-body hidden>{ data.FunctionsJSON }</pre>
					</span>
					<button type="button" class="quiet-word" data-dw-toggle="dw-paste" aria-expanded="false" aria-controls="dw-paste">Paste an AI's request</button>
				</div>
			</div>
			<div id="dw-paste" class="dw-drape">
				<div>
					<div class="dw-paste">
						<label for="dw-batch-input" class="dw-label">The request your AI composed (a fenced <code>```json</code> block is fine)</label>
						<textarea
							id="dw-batch-input"
							name="batch"
							rows="7"
							placeholder={ "{\n  \"v\": 1,\n  \"note\": \"why does the old sheet render\",\n  \"calls\": [ {\"name\": \"system.versions\"} ]\n}" }
							class="dw-field font-mono text-xs"
						></textarea>
						<div class="flex items-center gap-4">
							<button
								type="button"
								class="btn-primary btn-sm"
								hx-post="/admin/diagnostics/workspace/parse"
								hx-include="#dw-batch-input"
								hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, data.CSRFToken) }
								hx-target="#dw-review"
								hx-swap="innerHTML"
							>Review the request</button>
							<a href="/admin/diagnostics" target="_blank" class="quiet-word">Raw catalog</a>
						</div>
					</div>
				</div>
			</div>
			@diagnosticsQuestions(data)
			<p class="dw-more">
				Not here?
				<button type="button" class="quiet-word" data-dw-toggle="dw-own" aria-expanded="false" aria-controls="dw-own">Pick checks yourself</button>
				from all { fmt.Sprintf("%d", diagnosticsCheckCount(data.Groups)) }.
			</p>
			@diagnosticsOwnPick(data)
			<div class="dw-sheet" data-dw-sheet hidden>
				<button type="button" class="dw-icon dw-sheet-close" data-dw-sheet-close aria-label="Close the review">
					<i class="fa-solid fa-xmark" aria-hidden="true"></i>
				</button>
				<div id="dw-review" aria-live="polite"></div>
			</div>
		</div>
	}
}

// DiagnosticsBatchReview is the HTMX fragment returned by the parse handler. It
// shows the validated plan for human approval, or a parse error.
templ DiagnosticsBatchReview(data DiagnosticsReviewData) {
	if data.Err != "" {
		<div class="card border-rose-300 dark:border-rose-800 space-y-2">
			<h3 class="text-sm font-semibold text-rose-700 dark:text-rose-300">
				<i class="fa-solid fa-triangle-exclamation mr-1"></i> Couldn't read that request
			</h3>
			<p class="text-sm text-fg-secondary">{ data.Err }</p>
			<p class="text-xs text-fg-muted">Ask the AI to send the request again, using the checks list from "Copy checks for your AI".</p>
		</div>
	} else {
		<div class="card space-y-4">
			<div class="flex items-center justify-between">
				<h2 class="text-lg font-semibold text-fg">
					<span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-bold mr-2">3</span>
					Review &amp; approve
				</h2>
				<span class="text-xs text-fg-muted">
					{ fmt.Sprintf("%d of %d call(s) will run", data.Plan.RunnableN, len(data.Plan.Calls)) }
				</span>
			</div>
			if note := data.Plan.Request.Note; note != "" {
				<p class="text-xs text-fg-secondary"><span class="text-fg-muted">Investigating:</span> { note }</p>
			}
			<ul class="space-y-2">
				for _, c := range data.Plan.Calls {
					<li class="flex items-start gap-3 text-sm">
						@planBadge(c.Status)
						<div class="min-w-0">
							<div class="font-mono text-xs text-fg">
								{ c.Name }
								if c.Arg != "" {
									<span class="text-fg-muted">{ " " + c.Arg }</span>
								}
								if c.FullDump {
									<span class="ml-1 inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">full dump</span>
								}
							</div>
							if c.Title != "" {
								<div class="text-xs text-fg-muted">{ c.Title }</div>
							}
							if c.Note != "" {
								<div class="text-xs text-amber-700 dark:text-amber-400">{ c.Note }</div>
							}
						</div>
					</li>
				}
			</ul>
			if data.NeedsCampaign && len(data.Campaigns) > 0 {
				// A call left its campaign as a placeholder — let the operator pick one
				// here; the run step substitutes it into every ambiguous call's arg.
				<div class="pt-2 border-t border-edge">
					<label for="dw-campaign-pick" class="text-xs font-medium text-fg-secondary">
						<i class="fa-solid fa-circle-question mr-1 text-amber-500"></i>
						Campaign (some calls left it as a placeholder)
					</label>
					<select
						id="dw-campaign-pick"
						name="campaign_pick"
						class="mt-1 w-full text-sm bg-surface-alt border border-edge rounded p-2 text-fg focus:outline-none focus:ring-2 focus:ring-accent/40"
					>
						<option value="">— choose a campaign —</option>
						for _, c := range data.Campaigns {
							<option value={ c.ID }>{ c.Name } ({ c.Slug })</option>
						}
					</select>
				</div>
			}
			if data.NeedsEntity {
				// A call targets an entity but left it as a placeholder — fill in a
				// name, slug, or id. Run `entity.find ‹campaignId›:‹name›` first if you
				// don't know it. The run step substitutes this into every such call.
				<div class="pt-2">
					<label for="dw-entity-pick" class="text-xs font-medium text-fg-secondary">
						<i class="fa-solid fa-user mr-1 text-amber-500"></i>
						Entity (some calls left it as a placeholder)
					</label>
					<input
						id="dw-entity-pick"
						name="entity_pick"
						type="text"
						placeholder="name, slug, or id — e.g. tyne"
						class="mt-1 w-full text-sm font-mono bg-surface-alt border border-edge rounded p-2 text-fg focus:outline-none focus:ring-2 focus:ring-accent/40"
					/>
				</div>
			}
			if data.Plan.RunnableN > 0 {
				<div class="flex items-center gap-3 pt-2 border-t border-edge">
					// Re-embed the original text so the run step re-parses + re-validates
					// server-side (never trust a client-built plan).
					<input type="hidden" id="dw-approved-batch" name="batch" value={ data.Raw }/>
					<button
						type="button"
						class="btn-primary text-sm px-4 py-2"
						hx-post="/admin/diagnostics/workspace/run"
						hx-include="#dw-approved-batch, #dw-campaign-pick, #dw-entity-pick"
						hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, data.CSRFToken) }
						hx-target="#dw-review"
						hx-swap="innerHTML"
						hx-indicator="#dw-running"
					>
						<i class="fa-solid fa-play"></i> Approve &amp; run { fmt.Sprintf("%d", data.Plan.RunnableN) } call(s)
					</button>
					<span id="dw-running" class="htmx-indicator text-xs text-fg-muted">
						<i class="fa-solid fa-spinner fa-spin mr-1"></i> running…
					</span>
				</div>
			} else {
				<p class="text-xs text-fg-muted pt-2 border-t border-edge">
					Nothing runnable. Fix the names (or add <code>"full_dump": true</code> to authorize a full dump) and parse again.
				</p>
			}
		</div>
	}
}

// DiagnosticsBatchResult is the HTMX fragment returned by the run handler: the
// compact redacted output in a copy-to-clipboard pane.
templ DiagnosticsBatchResult(data DiagnosticsResultData) {
	<div class="card space-y-3" data-widget="ai-export">
		<div class="flex items-center justify-between">
			<h2 class="text-lg font-semibold text-fg">
				<i class="fa-solid fa-circle-check mr-2 text-emerald-500"></i> Result
			</h2>
			<button
				type="button"
				class="btn-primary text-xs px-3 py-1.5"
				data-ai-export-copy
				x-data="{ copied: false }"
				@click="copied = true; setTimeout(() => copied = false, 2000)"
			>
				<span x-show="!copied"><i class="fa-solid fa-copy mr-1"></i> Copy result</span>
				<span x-show="copied" x-cloak><i class="fa-solid fa-check mr-1"></i> Copied</span>
			</button>
		</div>
		<p class="text-xs text-fg-muted">Paste this back to your AI. Read-only and secret-redacted.</p>
		<pre
			data-ai-export-body
			class="select-all whitespace-pre-wrap break-words text-xs font-mono text-fg leading-relaxed bg-surface-alt p-4 rounded border border-edge max-h-[60vh] overflow-auto"
		>{ data.Result }</pre>
	</div>
}

// planBadge renders a small status pill for one planned call.
templ planBadge(status systems.PlanStatus) {
	switch status {
		case systems.PlanOK:
			<span class="shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400" title="will run">
				<i class="fa-solid fa-check text-[10px]"></i>
			</span>
		default:
			<span class="shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400" title="skipped">
				<i class="fa-solid fa-xmark text-[10px]"></i>
			</span>
	}
}
