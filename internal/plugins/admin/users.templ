package admin

import (
	"github.com/keyxmakerx/chronicle/internal/plugins/auth"
	"github.com/keyxmakerx/chronicle/internal/templates/components"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// UserListData is what the people list renders: one page of users plus the
// search/chip/pager state.
type UserListData struct {
	Users     []auth.User
	View      listView
	CSRFToken string
}

// AdminUsersPage renders the people page: search box and the list region.
templ AdminUsersPage(data UserListData) {
	@layouts.App("People - Admin") {
		<div class="max-w-4xl mx-auto space-y-6">
			<h1 class="text-2xl font-bold text-fg">People</h1>
			@adminListSearch(data.View)
			@AdminUsersList(data)
		</div>
	}
}

// AdminUsersList is the swappable region of the people page (chips, table
// and pager). HTMX requests get just this; the id is the swap target.
templ AdminUsersList(data UserListData) {
	{{ users := data.Users }}
	{{ csrfToken := data.CSRFToken }}
	<div id={ data.View.RegionID } class="space-y-6">
		if data.View.Filter != "" {
			<input type="hidden" name="f" value={ data.View.Filter } form={ data.View.RegionID + "-search" }/>
		}
		@adminListChips(data.View)
		<div class="card p-0 overflow-hidden hidden md:block">
			<table class="w-full">
				<thead>
					<tr class="bg-surface-alt border-b border-edge">
						<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Name</th>
						<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Email</th>
						<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Role</th>
						<th class="text-left px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Joined</th>
						<th class="text-right px-4 py-3 text-xs font-semibold text-fg-secondary uppercase tracking-wider">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-edge">
					if len(users) > 0 {
						for _, user := range users {
							<tr class="hover:bg-surface-alt transition-colors">
								<td class="px-4 py-3 text-sm font-medium text-fg">{ user.DisplayName }</td>
								<td class="px-4 py-3 text-sm text-fg-secondary">
									{ user.Email }
									if user.TOTPEnabled {
										<span class="ml-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-surface-alt text-fg-muted" title="Signs in with a code from their phone"><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i> Two-factor on</span>
									}
								</td>
								<td class="px-4 py-3">
									<span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium " + userRoleChipClass(user) }>{ userRoleLabel(user) }</span>
								</td>
								<td class="px-4 py-3 text-sm text-fg-muted">
									{ user.CreatedAt.Format("Jan 2, 2006") }
								</td>
								<td class="px-4 py-3 text-right space-x-2">
									for _, a := range userRowActions(user) {
										@adminInlineAction(a, csrfToken)
									}
								</td>
							</tr>
						}
					} else {
						@adminListEmpty(data.View, 5)
					}
				</tbody>
			</table>
		</div>
		<div class="card p-0 divide-y divide-edge md:hidden" data-testid="users-cards">
			if len(users) > 0 {
				for _, user := range users {
					@adminCardRow(avatarInitial(user.DisplayName), user.DisplayName, "", userRoleLabel(user), userRoleChipClass(user), user.Email+twoFactorNote(user)+" · joined "+user.CreatedAt.Format("Jan 2, 2006"), csrfToken, userCardActions(user))
				}
			} else {
				@adminListEmptyCard(data.View)
			}
		</div>
		@components.Pagination(components.PaginationData{
				CurrentPage: data.View.Page,
				PerPage:     data.View.PerPage,
				Total:       data.View.Total,
				BaseURL:     data.View.BaseURL,
				ExtraParams: data.View.PagerParams(),
			})
		</div>
}
