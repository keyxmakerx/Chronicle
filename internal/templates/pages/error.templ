// error.templ renders error pages for all HTTP error responses (404, 403, 401, etc.).
// The error handler in app.go routes all errors through these templates.

package pages

import (
	"fmt"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// ErrorPage renders an error page appropriate to the status code: a quiet
// heading, one sentence on what happened and what to do, and the ways out as
// quiet words. Signing in is the one real command, so it is the one button.
templ ErrorPage(statusCode int, message string) {
	@layouts.Base(fmt.Sprintf("Error %d", statusCode)) {
		<main id="main-content" class="min-h-screen flex items-center justify-center bg-page px-4">
			<div class="max-w-md w-full">
				<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted mb-2">
					{ fmt.Sprintf("Error %d", statusCode) }
				</p>
				<h1 class="text-2xl font-semibold text-fg mb-3">
					{ errorTitle(statusCode) }
				</h1>
				<p class="text-fg-body leading-relaxed mb-2">
					{ errorMessage(statusCode, message) }
				</p>
				if hint := errorHint(statusCode); hint != "" {
					<p class="text-sm text-fg-muted leading-relaxed">{ hint }</p>
				}
				<div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-8 pt-4 border-t border-edge">
					if statusCode == 401 {
						<a href="/login" class="btn-primary">Sign in</a>
						<a href="/register" class="quiet-word">Create an account</a>
					} else {
						<a href="javascript:history.back()" class="quiet-word">Go back</a>
						<a href="/campaigns" class="quiet-word">Your campaigns</a>
					}
				</div>
			</div>
		</main>
	}
}

// errorMessage is the page's main sentence. A not-found page never repeats
// the error's own text: a page hidden from someone answers exactly like a
// missing one, and the wording covers both without saying which.
func errorMessage(code int, message string) string {
	if code == 404 {
		return "This page isn't shared with you, or doesn't exist."
	}
	return message
}

// errorHint says what the reader can do next, where there is something.
func errorHint(code int) string {
	switch {
	case code >= 500:
		return "Try again in a moment. If it keeps happening, tell whoever runs this site."
	case code == 404:
		return "If someone sent you the link, ask them to check it."
	case code == 403:
		return "If you think you should have it, ask the campaign's owner or whoever runs this site."
	case code == 401:
		return "Sign in to see this page."
	}
	return ""
}

// errorTitle returns a human-friendly title for the error code.
func errorTitle(code int) string {
	switch code {
	case 400:
		return "Something in the request was wrong"
	case 401:
		return "Sign in first"
	case 403:
		return "Not open to you"
	case 404:
		return "Nothing to show here"
	case 409:
		return "Conflict"
	case 422:
		return "Something needs fixing"
	case 429:
		return "Too many tries at once"
	case 500:
		return "Something went wrong"
	case 502:
		return "The site didn't answer"
	case 503:
		return "The site is busy"
	default:
		return fmt.Sprintf("Error %d", code)
	}
}
