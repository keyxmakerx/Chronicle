package components

// CALV5-PLACEHOLDER: this file exists only while the calendar is rebuilt (V5)
// and is deleted with the last placeholder that uses it. TODO(#778): still
// used by the calendar-page route notice, RSVP routes, Foundry sync, and the
// entity_calendar/entity_worldstate/upcoming_events blocks — all still
// deferred after calendar-v5-sky-seams (see routes.go's own TODO(#778)s).
//
// Deliberately separate from PluginUnavailable: that component implies a
// database error and tells the reader to contact an administrator, which is
// wrong for a planned rebuild. Neither component here renders anything that
// could be mistaken for data (empty grids, zeroed counts, disabled controls).

// FeatureRebuilding is the full-surface notice: the feature's own page.
templ FeatureRebuilding(featureName string) {
	<div class="flex flex-col items-center justify-center py-20 px-6">
		<div class="max-w-md w-full bg-surface-raised border border-border rounded-lg p-8 text-center">
			<div class="text-4xl mb-4">
				<i class="fa-solid fa-screwdriver-wrench text-fg-muted"></i>
			</div>
			<h2 class="text-xl font-semibold text-fg mb-2">
				{ featureName } is being rebuilt
			</h2>
			<p class="text-sm text-fg-secondary mb-2">
				This feature is being rewritten from scratch. It is deliberately
				switched off in the meantime — nothing is broken and nothing is
				waiting on you.
			</p>
			<p class="text-sm text-fg-muted">
				Everything else in your campaign works normally.
			</p>
		</div>
	</div>
}

// FeatureRebuildingBlock is the compact variant for a slot inside another page
// — an entity block, a dashboard block, a bound widget host. It keeps the
// slot occupied rather than removing it, so the owner's layout isn't altered.
templ FeatureRebuildingBlock(featureName string) {
	<div class="border border-dashed border-border rounded-lg p-6 text-center">
		<i class="fa-solid fa-screwdriver-wrench text-fg-muted mb-2"></i>
		<p class="text-sm text-fg-secondary">
			{ featureName } is being rebuilt.
		</p>
		<p class="text-xs text-fg-muted mt-1">
			This block keeps its place in your layout and will fill in again when the rebuild lands.
		</p>
	</div>
}
