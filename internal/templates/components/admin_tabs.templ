// admin_tabs.templ is the heading and tab strip shared by the admin pages that
// were merged into one menu row per area. It lives here, not in the admin
// plugin, because pages owned by other plugins render it too and plugins must
// not import each other.

package components

import "strings"

// AdminTab is one page in a merged admin area.
type AdminTab struct {
	Label string
	Href  string
	Icon  string // Font Awesome class, without the "fa-solid" prefix
}

// AdminTabGroup is a merged admin area: its page heading and the pages that
// share it. Each tab stays its own URL and handler, so a tab is a plain link
// and works with hx-boost and without JavaScript.
type AdminTabGroup struct {
	Title string
	Tabs  []AdminTab
}

// Declared as data so the tab sets are reviewed in one place and the menu
// (layouts/admin_nav_data.go) can be checked against them.
var (
	AdminTabsHealth = AdminTabGroup{Title: "Health & diagnostics", Tabs: []AdminTab{
		{Label: "Parts of Chronicle", Href: "/admin/systems", Icon: "fa-microchip"},
		// Database's own parts are entries here, not a second row of tabs.
		{Label: "Database updates", Href: "/admin/database?tab=migrations", Icon: "fa-layer-group"},
		{Label: "Database checks", Href: "/admin/database?tab=health", Icon: "fa-heart-pulse"},
		{Label: "Tables", Href: "/admin/database?tab=schema", Icon: "fa-diagram-project"},
		{Label: "AI helper", Href: "/admin/diagnostics/workspace", Icon: "fa-stethoscope"},
	}}
	AdminTabsStorage = AdminTabGroup{Title: "Storage & cleanup", Tabs: []AdminTab{
		{Label: "Overview & files", Href: "/admin/storage", Icon: "fa-hard-drive"},
		{Label: "Limits", Href: "/admin/storage?tab=limits", Icon: "fa-gauge-high"},
		{Label: "Cleanup", Href: "/admin/data-hygiene", Icon: "fa-broom"},
	}}
	// Backup and restore are separate plugins; the tabs link between them.
	AdminTabsBackup = AdminTabGroup{Title: "Backups & restore", Tabs: []AdminTab{
		{Label: "Backups", Href: "/admin/backup", Icon: "fa-box-archive"},
		{Label: "Restore", Href: "/admin/restore", Icon: "fa-rotate-left"},
	}}
	// The CORS and request-log endpoints answer JSON only, so they are not
	// pages and cannot be tabs; with one tab the strip is left out.
	AdminTabsAPI = AdminTabGroup{Title: "API & access", Tabs: []AdminTab{
		{Label: "Requests", Href: "/admin/api", Icon: "fa-satellite-dish"},
	}}
)

// currentTabIndex finds which tab of g is open. An exact href match wins; failing
// that, a bare path (no query) selects the first tab on that path, so a page that
// reports only its path still lights one tab. Returns -1 when none match, and
// never more than one.
func currentTabIndex(g AdminTabGroup, current string) int {
	for i, t := range g.Tabs {
		if t.Href == current {
			return i
		}
	}
	if strings.Contains(current, "?") {
		return -1
	}
	for i, t := range g.Tabs {
		if path, _, _ := strings.Cut(t.Href, "?"); path == current {
			return i
		}
	}
	return -1
}

// AdminGroupHeading renders the area title and, when the area has more than
// one page, the tab strip with current (a Href) marked. The strip scrolls
// inside itself so a narrow phone never scrolls the whole page sideways.
templ AdminGroupHeading(g AdminTabGroup, current string) {
	<div>
		<h1 class="text-2xl font-bold text-fg">{ g.Title }</h1>
		if len(g.Tabs) > 1 {
			<nav class="mt-3 -mx-1 overflow-x-auto border-b border-edge" aria-label={ g.Title + " pages" }>
				<ul class="flex gap-1 px-1 text-sm whitespace-nowrap">
					{{ open := currentTabIndex(g, current) }}
					for i, t := range g.Tabs {
						<li>
							if i == open {
								<a href={ templ.SafeURL(t.Href) } aria-current="page" class="inline-block px-3 py-2 border-b-2 border-accent text-fg font-medium rounded-t focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
									<i class={ "fa-solid " + t.Icon + " mr-1" }></i>{ t.Label }
								</a>
							} else {
								<a href={ templ.SafeURL(t.Href) } class="inline-block px-3 py-2 border-b-2 border-transparent text-fg-muted hover:text-fg rounded-t focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
									<i class={ "fa-solid " + t.Icon + " mr-1" }></i>{ t.Label }
								</a>
							}
						</li>
					}
				</ul>
			</nav>
		}
	</div>
}
