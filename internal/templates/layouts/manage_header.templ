// manage_header.templ is the heading shared by the campaign owner's Manage
// pages. It lives here, not in the campaigns plugin, because pages owned by
// other plugins (Media, Trash, Sync history) render it too. The sidebar is
// the only Manage menu, so the header carries no links of its own.

package layouts

// ManageHeader renders the "Manage · <campaign>" eyebrow and the page title.
templ ManageHeader(title string) {
	<header class="mb-6">
		<p class="text-xs font-medium uppercase tracking-wide text-fg-muted">Manage &middot; { GetCampaignName(ctx) }</p>
		<h1 class="text-2xl font-bold text-fg">{ title }</h1>
	</header>
}
