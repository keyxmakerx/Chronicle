// manage_header.templ is the heading shared by the campaign owner's Manage
// pages. It lives here, not in the campaigns plugin, because the Media page
// (owned by another plugin) renders it too; it reads the rows from the same
// NavManageRows the sidebar draws, so the tab strip and the sidebar
// cannot disagree.

package layouts

// ManageHeader renders the "Manage · <campaign>" eyebrow, the page title and
// a tab strip of the Manage pages with the row whose Key is currentKey
// marked. The strip scrolls inside itself so a narrow phone never scrolls
// the whole page sideways. Tabs are plain links, so they work with hx-boost
// and without JavaScript.
templ ManageHeader(title, currentKey string) {
	<header class="mb-6">
		<p class="text-xs font-medium uppercase tracking-wide text-fg-muted">Manage &middot; { GetCampaignName(ctx) }</p>
		<h1 class="text-2xl font-bold text-fg">{ title }</h1>
		if rows := NavManageRows(ctx); len(rows) > 1 {
			<nav class="mt-3 -mx-1 overflow-x-auto border-b border-edge" aria-label="Manage pages">
				<ul class="flex gap-1 px-1 text-sm whitespace-nowrap">
					for _, r := range rows {
						<li>
							if r.Key == currentKey {
								<a href={ templ.SafeURL(r.URL) } aria-current="page" class="inline-block px-3 py-2 border-b-2 border-accent text-fg font-medium rounded-t focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
									{ r.Label }
								</a>
							} else {
								<a href={ templ.SafeURL(r.URL) } class="inline-block px-3 py-2 border-b-2 border-transparent text-fg-muted hover:text-fg rounded-t focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
									{ r.Label }
								</a>
							}
						</li>
					}
				</ul>
			</nav>
		}
	</header>
}
