// reauth_modal.templ provides a global password re-confirmation modal.
// It is included in base.templ and triggered by the "reauth-required" HX-Trigger
// header when a sensitive admin operation requires recent password confirmation.

package layouts

// ReauthModal renders a hidden password confirmation modal that appears when
// an admin tries to perform a sensitive operation without recent re-authentication.
// The modal POSTs to /account/reauth, and on success retries the original request.
templ ReauthModal() {
	<dialog
		id="reauth-modal"
		class="dlg-modal bg-surface text-fg rounded-xl shadow-elev-dragged p-6 w-[calc(100%-2rem)] max-w-sm"
		aria-labelledby="reauth-title"
		x-data="{ opener: null }"
		@reauth-required.window="if (!$el.open) { opener = document.activeElement; $el.returnValue = ''; $el.showModal(); }"
		@close="
			$refs.reauthPassword.value = '';
			$refs.reauthError.classList.add('hidden');
			if ($el.returnValue !== 'confirmed') window.dispatchEvent(new CustomEvent('reauth-cancelled'));
			if (opener && opener.isConnected) opener.focus();
			opener = null;
		"
	>
		<h3 id="reauth-title" class="text-lg font-semibold text-fg mb-2">
			Confirm it's you
		</h3>
		<p class="text-sm text-fg-secondary mb-4">
			This action requires password confirmation.
		</p>
		<form id="reauth-form" @submit.prevent="
			const pw = $refs.reauthPassword.value;
			if (!pw) return;
			const errEl = $refs.reauthError;
			errEl.classList.add('hidden');

			Chronicle.apiFetch('/account/reauth', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: 'password=' + encodeURIComponent(pw)
			}).then(r => {
				if (r.ok) {
					$el.closest('dialog').close('confirmed');
					// boot.js re-sends the refused request on this event.
					window.dispatchEvent(new CustomEvent('reauth-confirmed'));
				} else if (r.status === 429) {
					errEl.textContent = 'Too many tries. Wait 15 minutes, then try again.';
					errEl.classList.remove('hidden');
				} else {
					errEl.textContent = 'That password isn\x27t right.';
					errEl.classList.remove('hidden');
					$refs.reauthPassword.select();
				}
			}).catch(() => {
				errEl.textContent = 'Couldn\x27t reach the server. Check your connection and try again.';
				errEl.classList.remove('hidden');
			});
		">
			<input
				x-ref="reauthPassword"
				type="password"
				name="password"
				placeholder="Enter your password"
				autocomplete="current-password"
				autofocus
				class="input"
			/>
			<p x-ref="reauthError" role="alert" class="hidden mt-2 text-sm text-bad"></p>
			<div class="mt-4 flex justify-end gap-3">
				<button
					type="button"
					@click="$el.closest('dialog').close('cancelled')"
					class="btn-secondary"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="btn-primary"
				>
					Confirm
				</button>
			</div>
		</form>
	</dialog>
}
