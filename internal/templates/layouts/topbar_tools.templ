package layouts

// topbarToolsTab is the phone bar's one Tools tab and the shelf that hangs
// from it, with every tool named (static/js/widgets/topbar_tools.js). The
// bar's own tool buttons stay in the page, only hidden by phone_shell.css, and
// an entry here presses the real button, so each tool opens exactly as before
// from its own host. Under 768 wide only; the bar is untouched above that.
templ topbarToolsTab() {
	<div class="tb-tools md:hidden" data-widget="topbar-tools">
		<button
			type="button"
			id="tb-tools-tab"
			class="tb-tab"
			data-tb-tab
			aria-expanded="false"
			aria-controls="tb-shelf"
		>
			Tools
			<span class="tb-count" data-tb-tab-n hidden></span>
		</button>
		<div id="tb-shelf" class="tb-pop tb-shelf" data-tb-shelf role="group" aria-label="Tools" hidden>
			<div class="tb-grid">
				if topbarHasMemberAI(ctx) {
					@topbarToolEntry("ai", "Your AI", true) {
						<i class="fa-solid fa-wand-magic-sparkles tb-ico" aria-hidden="true"></i>
					}
				} else if topbarHasOwnerAI(ctx) {
					@topbarToolEntry("ai", "Your AI", false) {
						<i class="fa-solid fa-wand-magic-sparkles tb-ico" aria-hidden="true"></i>
					}
				}
				// Drawn whenever the brush may be, so a brush brought back on
				// this page has its entry; it hides while the brush is put away.
				if topbarMayCustomize(ctx) {
					@topbarToolEntry("brush", "Customize", !topbarHasBrush(ctx)) {
						<i class="fa-solid fa-paintbrush tb-ico" aria-hidden="true"></i>
					}
				}
				if topbarHasTable(ctx) {
					@topbarToolEntry("table", "The table", false) {
						<svg class="tb-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 2.5l8.5 4.9v9.2L12 21.5l-8.5-4.9V7.4z"></path>
							<path d="M12 7l4.6 8H7.4z"></path>
						</svg>
					}
				}
				if topbarHasStore(ctx) {
					@topbarToolEntry("store", "Store", false) {
						<svg class="tb-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
							<path d="M4 4h16l1 5H3z"></path>
							<path d="M3 9c0 1.7 1.3 3 3 3s3-1.3 3-3c0 1.7 1.3 3 3 3s3-1.3 3-3c0 1.7 1.3 3 3 3s3-1.3 3-3"></path>
							<path d="M5 12v8h14v-8"></path>
							<path d="M10 20v-5h4v5"></path>
						</svg>
					}
				}
				if topbarHasDMScreen(ctx) {
					@topbarToolEntry("dms", GMTerm(ctx)+" Screen", false) {
						<svg class="tb-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
							<path d="M3 5l5 2v13l-5-2z"></path>
							<path d="M8 7h8v13H8z"></path>
							<path d="M16 7l5-2v13l-5 2z"></path>
						</svg>
					}
				}
				if topbarHasViewAs(ctx) {
					@topbarToolEntry("pv", topbarViewAsLabel(ctx), false) {
						<i class={ "fa-solid tb-ico", templ.KV("fa-eye-slash", IsViewingAsPlayer(ctx) || InGuestPreview(ctx)), templ.KV("fa-eye", !IsViewingAsPlayer(ctx) && !InGuestPreview(ctx)) } aria-hidden="true"></i>
					}
				}
				if topbarHasBell(ctx) {
					@topbarToolEntry("bell", "Notifications", false) {
						<i class="fa-solid fa-bell tb-ico" aria-hidden="true"></i>
					}
				}
				if topbarHasFind(ctx) {
					@topbarToolEntry("find", "Find", false) {
						<svg class="tb-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="M21 21l-4.3-4.3"></path>
						</svg>
					}
				}
			</div>
			<p class="tb-hint" data-tb-hint role="status" hidden></p>
			<button type="button" class="tb-quiet" data-tb-choose>Choose what stays on the bar</button>
		</div>
	</div>
}

// topbarToolEntry is one shelf entry: the tool's icon with its count over its
// name. later is an entry that waits hidden until its tool says it is on
// offer (a member's AI).
templ topbarToolEntry(id string, name string, later bool) {
	<button type="button" class="tb-tool" data-tb-for={ id } hidden?={ later }>
		<span class="tb-tool-ic">
			{ children... }
			<span class="tb-count" data-tb-n hidden></span>
		</span>
		<span class="tb-tool-name">{ name }</span>
		<span class="tb-tool-state" data-tb-state hidden>On the bar</span>
	</button>
}
