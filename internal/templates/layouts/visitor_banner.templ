// visitor_banner.templ renders the strip a look-around visitor sees on every
// page of the campaign they are visiting.

package layouts

import "time"

// VisitorBanner says the viewer is looking around on a pass, the day it ends,
// what a pass cannot do, and how to stay. It takes the place of the guest
// strip, and carries no "Keep my account" button: a visitor has nothing worth
// keeping until the GM makes them a player.
templ VisitorBanner(until time.Time, now time.Time) {
	<div class="cta-bar" data-cta="visitor" role="status">
		<i class="fa-solid fa-binoculars cta-ico" aria-hidden="true"></i>
		<span class="cta-msg">
			You're looking around until { visitEndDay(until, now) }. You can read, but not write or roll.
			<span class="text-fg-secondary">To play, ask your { GMTerm(ctx) } to make you a player.</span>
		</span>
	</div>
}

// visitEndDay names the day a pass ends the way a person would say it. A pass
// lasts at most a week, so a weekday is unambiguous except a week out, where
// the date is clearer.
func visitEndDay(until, now time.Time) string {
	until = until.In(now.Location())
	// Compare calendar dates, not durations, so 11pm tonight to 1am is "tomorrow".
	y1, m1, d1 := now.Date()
	y2, m2, d2 := until.Date()
	days := int(time.Date(y2, m2, d2, 0, 0, 0, 0, time.UTC).Sub(time.Date(y1, m1, d1, 0, 0, 0, 0, time.UTC)).Hours() / 24)
	switch {
	case days <= 0:
		return "today"
	case days == 1:
		return "tomorrow"
	case days < 7:
		return until.Weekday().String()
	default:
		return until.Format("Jan 2")
	}
}
