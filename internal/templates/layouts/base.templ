// Package layouts provides the outermost HTML shell templates for Chronicle.
// base.templ is the root layout wrapping every page with <html>, <head>,
// and all global scripts/styles.

package layouts

// Base renders the full HTML shell. All pages are wrapped in this layout.
// The contents parameter receives the page-specific body content.
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } | Chronicle</title>

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href={ AssetURL("/static/img/favicon.svg") }/>

		<!-- Theme: apply dark class + inline background-color before first paint to prevent flash -->
		<script>
			(function(){try{var t=localStorage.getItem('chronicle-theme');var d=t==='dark'||(t!=='light'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(d){document.documentElement.classList.add('dark');document.documentElement.style.backgroundColor='#111827'}else{document.documentElement.style.backgroundColor='#f9fafb'}}catch(e){}})();
		</script>

		<!-- Hide Alpine.js elements until initialized; hide body until all CSS loads (FOUC prevention). -->
		<style>[x-cloak]{display:none!important}body{opacity:0}</style>

		<!-- Tailwind CSS (generated) -->
		<link rel="stylesheet" href={ AssetURL("/static/css/app.css") }/>

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>

		<!-- Font Awesome (icons for entity types, UI) -->
		<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin/>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer"/>

		<!-- Campaign accent color override (applied via CSS custom properties) -->
		if css := AccentColorCSS(ctx); css != "" {
			@accentStyleBlock(css)
		}
		<!-- Campaign font family override -->
		if css := FontFamilyCSS(ctx); css != "" {
			@fontStyleBlock(css)
		}

		<!-- Reveal body after all render-blocking CSS has loaded (FOUC guard). -->
		<script>document.addEventListener('DOMContentLoaded',function(){document.body.style.opacity='1'})</script>
	</head>
	<body class="h-full font-sans antialiased">
		{ children... }

		<!-- Re-authentication modal for sensitive admin operations -->
		@ReauthModal()

		<!-- Theme toggle (before other scripts so icons update early) -->
		<script src={ AssetURL("/static/js/theme.js") } defer></script>

		<!-- Vendored libraries -->
		<script src={ AssetURL("/static/vendor/htmx.min.js") } defer></script>

		<!-- Toast notification system (must load before Alpine) -->
		<script src={ AssetURL("/static/js/notifications.js") } defer></script>

		<!-- Widget system: boot.js defines Chronicle.apiFetch and auto-mounts
		     data-widget elements. Must load before Alpine so Chronicle utilities
		     are available when Alpine processes x-data expressions. -->
		<script src={ AssetURL("/static/js/boot.js") } defer></script>

		<!-- Dynamic-surface motion engine: the frame's transition-preset library
		     (Chronicle.surface.play / .transitions). Loads after boot.js so the
		     Chronicle namespace exists. -->
		<script src={ AssetURL("/static/js/widgets/dynamic_surface.js") } defer></script>

		<!-- Generic character-sheet box renderers for the `character_surface`
		     layout block. Loads after the frame so its box renderers are
		     registered before boot.js auto-mounts the dynamic-surface widget. -->
		<script src={ AssetURL("/static/js/widgets/character_surface.js") } defer></script>

		<!-- Alpine.js: loaded AFTER boot.js so Chronicle.apiFetch/notify exist
		     when Alpine initializes and evaluates x-data attributes. -->
		<script src={ AssetURL("/static/vendor/alpine-collapse.min.js") } defer></script>
		<script src={ AssetURL("/static/vendor/alpine.min.js") } defer></script>

		<!-- Drill-down sidebar navigation (CSS toggling + HTMX triggers) -->
		<script src={ AssetURL("/static/js/sidebar_drill.js") } defer></script>
		<!-- Sidebar tree: collapsible hierarchy + drag-and-drop reordering -->
		<script src={ AssetURL("/static/js/sidebar_tree.js") } defer></script>
		<!-- Unified sidebar edit mode: pencil-triggered inline editing -->
		<script src={ AssetURL("/static/js/sidebar_editor.js") } defer></script>

		<!-- Recently viewed entities tracker (localStorage-backed sidebar list) -->
		<script src={ AssetURL("/static/js/recent_entities.js") } defer></script>
		<!-- Entity favorites (localStorage-backed sidebar list + star toggle) -->
		<script src={ AssetURL("/static/js/favorites.js") } defer></script>

		<!-- TipTap rich text editor (vendored bundle) -->
		<script src={ AssetURL("/static/vendor/tiptap-bundle.min.js") } defer></script>
		<!-- @mention extension must load before editor.js so Chronicle.MentionExtension is available -->
		<script src={ AssetURL("/static/js/widgets/editor_mention.js") } defer></script>
		<!-- Inline secrets mark (GM-only text, must load before editor.js) -->
		<script src={ AssetURL("/static/js/widgets/editor_secret.js") } defer></script>
		<!-- Auto-link entities (must load before editor.js so Chronicle.autoLinkEntities is available) -->
		<script src={ AssetURL("/static/js/widgets/editor_autolink.js") } defer></script>
		<!-- Slash command menu (must load before editor.js so Chronicle.SlashCommands is available) -->
		<script src={ AssetURL("/static/js/widgets/editor_slash.js") } defer></script>
		<script src={ AssetURL("/static/js/widgets/editor.js") } defer></script>

		<!-- Image upload widget -->
		<script src={ AssetURL("/static/js/widgets/image_upload.js") } defer></script>

		<!-- Media picker (slideout for choosing existing campaign images) -->
		<script src={ AssetURL("/static/js/widgets/media_picker.js") } defer></script>

		<!-- Entity type config widget (unified sidebar + layout + color) -->
		<script src={ AssetURL("/static/js/widgets/entity_type_config.js") } defer></script>

		<!-- Template editor widget (drag-and-drop page builder) -->
		<script src={ AssetURL("/static/js/widgets/template_editor.js") } defer></script>

		<!-- Tag picker widget (entity tag management) -->
		<script src={ AssetURL("/static/js/widgets/tag_picker.js") } defer></script>

		<!-- Entity tooltip widget (hover preview popover for entity links) -->
		<script src={ AssetURL("/static/js/widgets/entity_tooltip.js") } defer></script>
		<!-- Bulk entity selection and actions -->
		<script src={ AssetURL("/static/js/widgets/bulk_actions.js") } defer></script>

		<!-- AI-Export modal copy-to-clipboard (C-AI-EXPORT-V1 PR-B) -->
		<script src={ AssetURL("/static/js/widgets/ai_export.js") } defer></script>

		<!-- AI-Workspace Import — drag/drop multi-file markdown importer (V1-D) -->
		<script src={ AssetURL("/static/js/widgets/markdown_importer.js") } defer></script>

		<!-- Relations widget (bi-directional entity linking) -->
		<script src={ AssetURL("/static/js/widgets/relations.js") } defer></script>

		<!-- Shop inventory widget (item list with price/quantity/stock) -->
		<script src={ AssetURL("/static/js/widgets/shop_inventory.js") } defer></script>

		<!-- Character inventory widget ("Has Item" relations with qty/equipped/attuned).
		     Sibling of shop_inventory above; its mount is the `inventory` entity
		     block (entities/show.templ blockInventory). -->
		<script src={ AssetURL("/static/js/widgets/inventory.js") } defer></script>

		<!-- Transaction log widget (shop purchase/sale/gift/restock history).
		     Mount is the `transaction_log` entity block; reads the armory
		     plugin's /armory/shops/:eid/transactions endpoint. -->
		<script src={ AssetURL("/static/js/widgets/transaction_log.js") } defer></script>

		<!-- Entity aliases widget (alternative names; feeds auto-linking, search,
		     @mentions). Mounts inside the `title` core block, i.e. effectively
		     every entity page. -->
		<script src={ AssetURL("/static/js/widgets/aliases.js") } defer></script>

		<!-- Impact tree widget ("Impact Overview" diagram on the custom-system
		     upload preview). Mount is internal/systems/preview.templ, which is
		     an HTMX fragment — so the tag belongs here and not in that templ:
		     boot.js sets htmx.config.allowScriptTags = false, and a script in a
		     swapped fragment is stripped (see tools/check-page-scripts.sh). -->
		<script src={ AssetURL("/static/js/widgets/impact_tree.js") } defer></script>

		<!-- Entity type editor widget (inline edit for entity type management) -->
		<script src={ AssetURL("/static/js/widgets/entity_type_editor.js") } defer></script>

		<!-- Attributes widget (inline edit for entity custom fields) -->
		<script src={ AssetURL("/static/js/widgets/attributes.js") } defer></script>

		<!-- Notes widget (floating personal notes panel) -->
		<script src={ AssetURL("/static/js/widgets/notes.js") } defer></script>

		<!-- Notification bell (C-SCHED-P2): topbar dropdown; badge polled via HTMX. -->
		<script src={ AssetURL("/static/js/widgets/notification_bell.js") } defer></script>

		<!-- Journal widget (full-page Obsidian-like note editor) -->
		<script src={ AssetURL("/static/js/widgets/journal.js") } defer></script>

		<!-- Entity manager widget (sortable, filterable entity list block) -->
		<script src={ AssetURL("/static/js/widgets/entity_manager.js") } defer></script>

		<!-- Tag filtering in sidebar drill panel -->
		<script src={ AssetURL("/static/js/sidebar_tag_filter.js") } defer></script>

		<!-- Dashboard layouts use the unified layout-editor widget (loaded
		     further down). dashboard_editor.js was retired in favor of
		     that widget — kept ~600 lines of duplicated drag/drop/save
		     logic in sync was a recurring bug source (e.g. silent save
		     errors, missing config field types).  -->

		<!-- Timeline D3 visualization widget (interactive SVG chart) -->
		<script src={ AssetURL("/static/js/widgets/timeline_viz.js") } defer></script>

		<!-- Plugin-contributed body scripts (injected at startup; calendar widget
		     is the canonical first entry — avoids hardcoding plugin paths here).
		     Emitted IN SLICE ORDER and deferred, so a contributor that depends on
		     an earlier one may rely on document order (see routes.go).
		     AssetURL is applied here rather than at registration time so the
		     digest is resolved after every plugin's static FS has registered;
		     without it a page-templ script moved into this registry would lose
		     the cache-busting it used to carry. -->
		for _, scriptURL := range GetPluginBodyScripts(ctx) {
			<script src={ AssetURL(scriptURL) } defer></script>
		}

		<!-- Timeline widget (interactive timeline preview for dashboard embeds) -->
		<script src={ AssetURL("/static/js/widgets/timeline_widget.js") } defer></script>

		<!-- Map widget (embedded Leaflet map viewer for dashboard embeds) -->
		<script src={ AssetURL("/static/js/widgets/map_widget.js") } defer></script>

		<!-- Permissions widget (per-entity visibility and access control) -->
		<script src={ AssetURL("/static/js/widgets/permissions.js") } defer></script>

		<!-- Groups management widget (campaign group CRUD) -->
		<script src={ AssetURL("/static/js/widgets/groups.js") } defer></script>

		<!-- Relations graph visualization (D3 force-directed) -->
		<script src={ AssetURL("/static/js/widgets/relation_graph.js") } defer></script>

		<!-- Database schema explorer (admin D3 visualization) -->
		<script src={ AssetURL("/static/js/widgets/db_explorer.js") } defer></script>

		<!-- Entity posts (sub-notes) -->
		<script src={ AssetURL("/static/js/widgets/entity_posts.js") } defer></script>

		<!-- Entity notes (per-user player notes with audience ACL — player-notes addon) -->
		<script src={ AssetURL("/static/js/widgets/entity_notes.js") } defer></script>

		<!-- Entity map editor (per-entity map assignment + iframe embed) -->
		<script src={ AssetURL("/static/js/widgets/entity_map.js") } defer></script>

		<!-- Appearance editor widget (campaign visual customization) -->
		<script src={ AssetURL("/static/js/widgets/appearance_editor.js") } defer></script>

		<!-- Unified layout editor widget (replaces dashboard_editor + template_editor) -->
		<script src={ AssetURL("/static/js/widgets/layout_editor.js") } defer></script>

		<!-- Layout Studio widget (orchestrates layout-editor contexts) -->
		<script src={ AssetURL("/static/js/widgets/layout_studio.js") } defer></script>

		<!-- Content template picker (entity create form + editor insert) -->
		<script src={ AssetURL("/static/js/template_picker.js") } defer></script>

		<!-- Quick Capture modal (Ctrl+Shift+N) and Session Journal -->
		<script src={ AssetURL("/static/js/quick_capture.js") } defer></script>

		<!-- Quick Search modal (Ctrl+K / Cmd+K) -->
		<script src={ AssetURL("/static/js/search_modal.js") } defer></script>
		<!-- Inline topbar search (overrides Chronicle.openSearch when topbar elements exist) -->
		<script src={ AssetURL("/static/js/topbar_search.js") } defer></script>

		<!-- Global keyboard shortcuts (Ctrl+N, Ctrl+E, Ctrl+S) -->
		<script src={ AssetURL("/static/js/keyboard_shortcuts.js") } defer></script>

		<!-- Command palette (Ctrl+Shift+P) -->
		<script src={ AssetURL("/static/js/command_palette.js") } defer></script>

		<!-- Keyboard shortcuts help overlay (press ?) -->
		<script src={ AssetURL("/static/js/shortcuts_help.js") } defer></script>

		<!-- Extension widget scripts (injected per-campaign, loaded after boot.js) -->
		for _, scriptURL := range GetExtWidgetScripts(ctx) {
			<script src={ scriptURL } defer></script>
		}
	</body>
	</html>
}

// accentStyleBlock renders a raw <style> tag with accent color CSS overrides.
// Uses templ.Raw because Templ does not interpolate variables inside <style> tags.
templ accentStyleBlock(css string) {
	@templ.Raw("<style>" + css + "</style>")
}

// fontStyleBlock renders a raw <style> tag with font family CSS overrides.
templ fontStyleBlock(css string) {
	@templ.Raw("<style>" + css + "</style>")
}
