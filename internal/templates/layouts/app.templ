// app.templ provides the authenticated application layout with sidebar
// and topbar navigation. Used for all pages after login.
//
// Layout data (user name, campaign context, CSRF token) is read from Go's
// context.Context via helpers in data.go. LayoutInjector in app/routes.go
// copies this data from Echo's context before rendering.

package layouts

import "context"
import "fmt"
import "strconv"
import "strings"

import "github.com/keyxmakerx/chronicle/internal/colour"
import "github.com/keyxmakerx/chronicle/internal/sanitize"

// App renders the authenticated layout with sidebar navigation and a
// topbar. The main content area is where page-specific content goes.
templ App(title string) {
	@Base(title) {
		<!-- Global HTMX loading indicator (thin bar at top of viewport) -->
		<div id="htmx-indicator" class="htmx-indicator"></div>
		<!-- Escape closes the phone drawer (unless something on top already took
		     the key) and hands focus back to the menu button that opened it. -->
		<div
			class="flex h-screen overflow-hidden"
			x-data="{ sidebarOpen: false, sidebarHidden: localStorage.getItem('chronicle-sidebar-hidden') === 'true' }"
			@chronicle:navigated.window="sidebarOpen = false"
			@chronicle:sidebar-show.window="sidebarHidden = false; localStorage.setItem('chronicle-sidebar-hidden', 'false')"
			@keydown.escape.window="if (sidebarOpen && !$event.defaultPrevented) { sidebarOpen = false; $nextTick(() => { const t = document.getElementById('nav-toggle'); if (t) t.focus() }) }"
		>
			<!-- Mobile backdrop -->
			<div
				x-show="sidebarOpen"
				x-transition:enter="transition-opacity ease-linear duration-300"
				x-transition:enter-start="opacity-0"
				x-transition:enter-end="opacity-100"
				x-transition:leave="transition-opacity ease-linear duration-300"
				x-transition:leave-start="opacity-100"
				x-transition:leave-end="opacity-0"
				@click="sidebarOpen = false"
				class="fixed inset-0 z-30 bg-black/50 md:hidden"
				x-cloak
			></div>

			<!-- Sidebar -->
			@Sidebar()

			<!-- Floating button to restore hidden sidebar. It sits where the hide
			     button was, in the footer of both sidebars, so the arrow doesn't
			     jump. It fades in as the sidebar's slide ends (CSS .sidebar-restore). -->
			<button
				:class="sidebarHidden && 'is-shown'"
				:tabindex="sidebarHidden ? 0 : -1"
				:aria-hidden="sidebarHidden ? 'false' : 'true'"
				@click="sidebarHidden = false; localStorage.setItem('chronicle-sidebar-hidden', 'false')"
				class="sidebar-restore fixed left-3 bottom-1 z-50 w-8 h-8 flex items-center justify-center rounded-lg bg-sidebar-bg text-sidebar-text shadow-lg hover:bg-sidebar-hover"
				title="Show sidebar"
				aria-label="Show sidebar"
				x-cloak
			>
				<i class="fa-solid fa-angles-right text-xs" aria-hidden="true"></i>
			</button>

			<!-- Main content area -->
			<div id="app-main" class="relative flex-1 flex flex-col overflow-hidden min-w-0">
				<!-- Topbar -->
				@Topbar()

				<!-- "View as player" banner -->
				if IsViewingAsPlayer(ctx) {
					<div class="bg-amber-500/15 border-b border-amber-500/30 px-4 py-1.5 text-center text-sm text-amber-300">
						<i class="fa-solid fa-eye-slash mr-1"></i>
						Viewing as player
						<span class="text-amber-400/70 ml-1">— owner-only content is hidden</span>
					</div>
				}

				<!-- Flash messages -->
				@FlashMessages()

				<!-- Player call-to-action (C-RSVP-P10).
				     One banner for the one thing a player is expected to ACT on:
				     an unanswered RSVP, or the timezone we would otherwise guess
				     at. Server-rendered and POLLED on the same 60s cadence as the
				     bell badge, and — like the badge — an empty body is the
				     "nothing to say" answer, so the strip collapses to nothing.

				     It sits OUTSIDE #main-content deliberately. That is the
				     boosted swap target, so a banner inside it would be thrown
				     away and re-fetched on every sidebar navigation, flashing
				     once per page change. Here it survives navigation and the
				     poll owns its lifetime.

				     Behaviour lives in the callout widget, never an inline
				     <script>: boot.js sets htmx.config.allowScriptTags = false,
				     which REMOVES script tags from swapped fragments rather than
				     declining to run them. -->
				if IsAuthenticated(ctx) {
					<div
						class="cta-host"
						data-widget="callout"
						data-csrf={ GetCSRFToken(ctx) }
						hx-get="/notifications/call-to-action"
						hx-trigger="load, every 60s"
						hx-swap="innerHTML"
					></div>
				}

				<!-- Page content (scrollable) -->
				<main class="flex-1 overflow-y-auto px-3 py-3 md:px-5 md:py-4 bg-surface" id="main-content">
					if InCampaign(ctx) {
						<!-- Which sidebar row this page belongs to, and its name. A
						     boosted navigation swaps only #main-content, so this is
						     how sidebar_nav.js learns where the viewer now is. -->
						<span hidden data-nav-current={ navCurrentKey(ctx) } data-nav-page={ navCurrentPage(ctx) }></span>
					}
					{ children... }
				</main>
			</div>
		</div>
		<!-- Jot notes: the one entry point is the tab bottom-right, which
		     opens the floating panel of this page's jots. Gated behind the
		     "notes" addon, off by default. -->
		if notesWidgetVisible(ctx) {
			@NotesWidget()
		}
	}
}

// sidebarNavLink is the CSS class set for sidebar navigation links.
// Includes a transparent left border so active/inactive items align.
// sidebar-nav-glow provides the asymmetric hover effect (no other hover bg needed).
var sidebarNavLink = "sidebar-nav-glow flex items-center pl-3.5 pr-4 py-2 text-sm transition-colors group border-l-2 border-transparent"

// sidebarNavActive is appended for the currently active navigation link.
// Uses the campaign accent color for the left-border indicator.
var sidebarNavActive = "sidebar-nav-active text-sidebar-active border-accent"

// sidebarNavInactive is the default state for non-active navigation links.
// No hover:bg — the sidebar-nav-glow ::before handles the hover visual.
var sidebarNavInactive = "text-sidebar-text hover:text-sidebar-active"

// Sidebar renders the left navigation bar: inside a campaign, the campaign's
// own sidebar (nav.templ); elsewhere, the site's short navigation.
templ Sidebar() {
	<!-- data-nav-active-classes / data-nav-inactive-classes expose the SAME class
	     tokens used to render every nav link below (sidebarNavActive /
	     sidebarNavInactive) so boot.js's boosted-nav active-link highlighter can
	     read the live vocabulary instead of hardcoding a copy that can go stale
	     the next time this changes (see C-NAV-ACTIVE-FIX). -->
	<aside
		id="sidebar"
		data-nav-active-classes={ sidebarNavActive }
		data-nav-inactive-classes={ sidebarNavInactive }
		data-nav-commands={ NavCommandsJSON(ctx) }
		x-data="{ pinned: localStorage.getItem('chronicle-sidebar-pinned') !== 'false', hovered: false, editing: false }"
		x-init="$nextTick(() => { if (!pinned) hovered = false })"
		@mouseenter="hovered = true"
		@mouseleave="hovered = false"
		@chronicle:nav-editing.window="editing = $event.detail"
		class="nav-sb fixed inset-y-0 left-0 z-40 w-64 bg-sidebar-bg text-sidebar-text flex flex-col
		       -translate-x-full md:translate-x-0 transition-[width,transform] duration-300 ease-in-out
		       md:static md:z-auto md:shrink-0"
		:class="[
			sidebarOpen ? 'sidebar-mobile-open shadow-2xl' : '',
			(!pinned && !hovered && !editing && !sidebarHidden) ? 'sidebar-collapsed' : '',
			sidebarHidden ? 'sidebar-fully-hidden' : ''
		]"
	>
		if InCampaign(ctx) {
			@campaignNavBrand()
			@campaignNavTop()
			@campaignNavCategories()
			@campaignNavFooter()
		} else {
			<!-- Logo / Brand -->
			<div class="h-16 flex items-center px-4 border-b border-gray-700 shrink-0">
				<a href="/campaigns" class="flex items-center flex-1 min-w-0 gap-2 hover:opacity-80 transition-opacity">
					<span class="sidebar-hide-collapsed contents">
						@SiteSidebarMark()
					</span>
					<span class="text-lg font-bold text-white tracking-tight truncate sidebar-hide-collapsed">{ SiteName(ctx) }</span>
					<!-- Collapsed state: book icon -->
					<span class="hidden items-center justify-center w-5 h-5 shrink-0" :class="{ '!flex': !pinned && !hovered }">
						<i class="fa-solid fa-book-open text-white text-sm"></i>
					</span>
				</a>
			</div>
			<!-- Non-campaign sidebar: simple navigation -->
			<nav class="flex-1 py-4 overflow-y-auto" hx-boost="true" hx-target="#main-content" hx-select="#main-content" hx-swap="innerHTML show:window:top">
				@DefaultSidebarNav()
			</nav>
			<!-- Admin section (site admins only, static, collapsible) -->
			if GetIsAdmin(ctx) {
				@AdminSidebarNav()
			}
			<!-- Sidebar footer: pin and hide sit here, as in the campaign sidebar,
			     so the hide arrow and the restore arrow share the bottom-left. -->
			<div class="h-10 flex items-center gap-0.5 pl-4 pr-1.5 border-t border-gray-700 shrink-0">
				<div class="flex-1 min-w-0 truncate text-xs text-gray-600 sidebar-hide-collapsed">
					Chronicle v0.1.0
				</div>
				<!-- Pin/unpin button (visible only when expanded) -->
				<button
					class="sidebar-pin-btn w-6 h-6 flex items-center justify-center rounded text-gray-500 hover:text-white hover:bg-gray-700 transition-colors"
					@click.stop="pinned = !pinned; localStorage.setItem('chronicle-sidebar-pinned', pinned)"
					:title="pinned ? 'Unpin sidebar' : 'Pin sidebar open'"
				>
					<i class="fa-solid fa-thumbtack text-xs transition-transform" :class="{ 'rotate-45 text-gray-600': !pinned, 'text-accent': pinned }"></i>
				</button>
				<!-- Hide sidebar button (visible only when expanded) -->
				<button
					class="sidebar-pin-btn w-6 h-6 flex items-center justify-center rounded text-gray-500 hover:text-white hover:bg-gray-700 transition-colors"
					@click.stop="sidebarHidden = true; localStorage.setItem('chronicle-sidebar-hidden', 'true')"
					title="Hide sidebar"
					aria-label="Hide sidebar"
				>
					<i class="fa-solid fa-angles-left text-xs" aria-hidden="true"></i>
				</button>
			</div>
		}
	</aside>
}

// AdminSidebarNav renders the collapsible admin navigation block from the
// adminNav data: a Home link and foldable sections.
templ AdminSidebarNav() {
	{{ curSection, _ := adminNav.Current(GetActivePath(ctx)) }}
	{{ pins := GetAdminNavPins(ctx) }}
	{{ pinned := adminNavPinnedItems(pins) }}
	<div
		id="admin-nav"
		x-data={ adminNavXData }
		data-cur={ curSection }
		class="border-t border-gray-700 shrink-0"
	>
		<button
			type="button"
			@click="open = !open; localStorage.setItem('chronicle-admin-nav', open ? 'open' : 'collapsed')"
			:aria-expanded="open"
			aria-controls="admin-nav-body"
			class="w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-300 transition-colors"
		>
			<span>Admin</span>
			<svg
				class="w-3 h-3 transition-transform duration-200"
				:class="open ? 'rotate-0' : '-rotate-90'"
				width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
			</svg>
		</button>
		<div id="admin-nav-body" class="admin-slide" :class="open && 'expanded'" x-cloak>
			<div hx-boost="true" hx-target="#main-content" hx-select="#main-content" hx-swap="innerHTML show:window:top">
				@adminNavLink(adminNav.Home)
				if len(pinned) > 0 {
					<div role="group" aria-label="Pinned admin pages">
						<div class="px-4 pt-3 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-500">Pinned</div>
						for _, it := range pinned {
							@adminNavLink(it)
						}
					</div>
				}
				for _, sec := range adminNav.Sections {
					@adminNavSection(sec, curSection == sec.ID, pins)
				}
				<div class="pb-2"></div>
			</div>
		</div>
	</div>
}

// adminNavSection is one foldable group. Its fold head is a real button that
// carries the group's attention count, so a folded group still signals
// trouble inside it.
templ adminNavSection(sec AdminNavSection, isCurrent bool, pins []string) {
	<div x-data={ adminNavSectionXData } data-sec={ sec.ID }>
		<button
			type="button"
			@click="toggle(id)"
			aria-expanded={ strconv.FormatBool(isCurrent) }
			:aria-expanded="!!secs[id]"
			aria-controls={ "admin-nav-sec-" + sec.ID }
			class="w-full flex items-center gap-2 px-4 pt-3 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-500 hover:text-gray-300 transition-colors text-left"
		>
			<span>{ sec.Label }</span>
			if n := adminNavSectionCount(ctx, sec); n > 0 {
				<span
					class="inline-flex items-center justify-center min-w-4 h-4 px-1 text-[10px] font-bold text-white bg-red-500 rounded-full"
					x-show="!secs[id]"
					aria-label={ fmt.Sprintf("%d need attention", n) }
				>
					{ fmt.Sprintf("%d", n) }
				</span>
			}
			<svg
				class="w-3 h-3 ml-auto transition-transform duration-200"
				:class="secs[id] ? 'rotate-0' : '-rotate-90'"
				width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
			</svg>
		</button>
		<div id={ "admin-nav-sec-" + sec.ID } x-show="secs[id]" x-cloak>
			for _, it := range sec.Items {
				@adminNavPinnableLink(it, adminNavIsPinned(pins, it.Href))
			}
		</div>
	</div>
}

// adminNavPinnableLink is a section row: the page link plus its pin toggle.
// The toggle is a sibling of the link, not inside it, so a click cannot also
// navigate. It shows on hover or focus, and always on touch screens (see
// .admin-pin-btn).
templ adminNavPinnableLink(it AdminNavItem, pinned bool) {
	<div class="admin-nav-row relative">
		@adminNavRow(it, true)
		<button
			type="button"
			class="admin-pin-btn absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center rounded text-gray-500 hover:text-white"
			data-admin-pin={ it.Href }
			aria-pressed={ strconv.FormatBool(pinned) }
			if pinned {
				aria-label={ "Unpin " + it.Label }
				title={ "Unpin " + it.Label }
			} else {
				aria-label={ "Pin " + it.Label }
				title={ "Pin " + it.Label }
			}
			@click="pinToggle($el)"
		>
			<i class="fa-solid fa-thumbtack text-[10px]" aria-hidden="true"></i>
		</button>
	</div>
}

// adminNavLink is one admin page row. The current page is marked for
// assistive tech as well as colour.
templ adminNavLink(it AdminNavItem) {
	@adminNavRow(it, false)
}

// adminNavRow draws the link. makeRoom keeps the right edge clear for the pin
// toggle that sits over it; the important modifier is needed because the base
// link class sets its own right padding.
templ adminNavRow(it AdminNavItem, makeRoom bool) {
	{{ active := it.Active(GetActivePath(ctx)) }}
	<a
		href={ templ.SafeURL(it.Href) }
		if active {
			aria-current="page"
		}
		class={ sidebarNavLink,
			templ.KV(sidebarNavActive, active),
			templ.KV(sidebarNavInactive, !active),
			templ.KV("!pr-10", makeRoom) }
	>
		<span class="w-4 h-4 mr-3 shrink-0 flex items-center justify-center">
			<i class={ "fa-solid " + it.Icon + " text-xs" } aria-hidden="true"></i>
		</span>
		{ it.Label }
		if n := adminNavBadgeCount(ctx, it); n > 0 {
			<span class="ml-auto inline-flex items-center justify-center w-5 h-5 text-[10px] font-bold text-white bg-red-500 rounded-full">
				{ fmt.Sprintf("%d", n) }
			</span>
		}
	</a>
}

// CampaignSidebarNav is no longer used — its content has been inlined into
// the zone-based Sidebar() layout for proper drill-down isolation.

// DefaultSidebarNav renders generic navigation when not inside a campaign.
templ DefaultSidebarNav() {
	<div class="px-4 mb-2 text-xs font-semibold uppercase tracking-wider text-gray-500">
		Navigation
	</div>

	<a
		href="/campaigns"
		class={ sidebarNavLink,
			templ.KV(sidebarNavActive, isPathPrefix(ctx, "/campaigns")),
			templ.KV(sidebarNavInactive, !isPathPrefix(ctx, "/campaigns")) }
	>
		<svg class="w-4 h-4 mr-3 shrink-0" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
		</svg>
		My Campaigns
	</a>

	<a
		href="/"
		class={ sidebarNavLink,
			templ.KV(sidebarNavActive, isExactPath(ctx, "/")),
			templ.KV(sidebarNavInactive, !isExactPath(ctx, "/")) }
	>
		<span class="w-4 h-4 mr-3 shrink-0 flex items-center justify-center">
			<i class="fa-solid fa-compass text-xs"></i>
		</span>
		Discover
	</a>

	<a
		href="/campaigns/new"
		class={ sidebarNavLink, sidebarNavInactive }
	>
		<svg class="w-4 h-4 mr-3 shrink-0" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
		</svg>
		New Campaign
	</a>
}

// sidebarCreateCategory renders a compact inline form for creating a new
// entity type directly from the sidebar. Visible to campaign owners only.
templ sidebarCreateCategory(ctx context.Context) {
	<div id="sidebar-create-category" class="px-4 mb-2" style="display: none;">
		<div class="p-2.5 bg-surface-raised border border-edge rounded-md space-y-2"
			x-data={ fmt.Sprintf(`{
				name: '', icon: 'fa-file', color: '#6b7280', saving: false,
				icons: ['fa-user','fa-users','fa-map-pin','fa-building','fa-box','fa-sticky-note',
					'fa-crown','fa-shield','fa-scroll','fa-book','fa-star','fa-flag',
					'fa-landmark','fa-globe','fa-mountain','fa-gem','fa-skull','fa-dragon',
					'fa-hat-wizard','fa-dungeon','fa-wand-sparkles','fa-flask','fa-paw','fa-ghost'],
				async create() {
					if (!this.name.trim() || this.saving) return;
					this.saving = true;
					try {
						const res = await Chronicle.apiFetch('/campaigns/%s/entity-types', {
							method: 'POST',
							body: { name: this.name.trim(), icon: this.icon, color: this.color }
						});
						if (res.ok || res.redirected) {
							window.location.reload();
						} else {
							const err = await res.json().catch(() => ({}));
							Chronicle.notify(err.message || 'Failed to create category', 'error');
						}
					} catch (e) {
						Chronicle.notify('Failed to create category', 'error');
					} finally {
						this.saving = false;
					}
				}
			}`, GetCampaignID(ctx)) }
		>
			<input
				x-model="name"
				type="text"
				placeholder="Category name"
				class="input w-full text-xs"
				maxlength="100"
				@keydown.enter="create()"
				@keydown.escape.prevent="$el.closest('#sidebar-create-category').style.display='none'; const b = document.querySelector('#sidebar-nav .nav-gh-add'); if (b) b.focus()"
			/>
			<div class="flex flex-wrap gap-1 max-h-16 overflow-y-auto">
				<template x-for="ic in icons" :key="ic">
					<label class="cursor-pointer">
						<input type="radio" name="sidebar_icon" :value="ic" x-model="icon" class="peer sr-only"/>
						<span class="inline-flex items-center justify-center w-6 h-6 rounded border border-edge text-fg-secondary peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent hover:border-edge transition-colors">
							<i :class="'fa-solid ' + ic" class="text-[10px]"></i>
						</span>
					</label>
				</template>
			</div>
			<div class="flex items-center gap-2">
				<input type="color" x-model="color" class="w-6 h-6 rounded border border-edge cursor-pointer shrink-0"/>
				<button
					type="button"
					:disabled="!name.trim() || saving"
					class="btn-primary text-xs flex-1 py-1"
					@click="create()"
				>
					<span x-show="!saving">Add</span>
					<span x-show="saving">Adding...</span>
				</button>
			</div>
		</div>
	</div>
}


// SidebarEntitySubTypes returns et's sub-categories (their own listing pages,
// each with its own count), re-derived here from the same entity types and
// counts the sidebar itself uses, so the drill panel needs no plumbing
// through NavRowView.Subs.
func SidebarEntitySubTypes(ctx context.Context, parentID int) []SidebarEntityType {
	var out []SidebarEntityType
	for _, t := range GetEntityTypes(ctx) {
		if t.ParentTypeID != nil && *t.ParentTypeID == parentID {
			out = append(out, t)
		}
	}
	return out
}

// SidebarDrillPanel renders the slide-over panel's content for a category:
// a back row to the categories list, a header (name, count, New) that
// doubles as navigation to the category's own page, search, its
// sub-categories as their own rows, the folder tree and Recent.
templ SidebarDrillPanel(campaignID string, et SidebarEntityType, count int) {
	<button type="button" class="nav-drill-back" data-drill-back>
		<i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
		Categories
	</button>
	<div class="nav-drill-head">
		<a
			href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/%s", campaignID, et.Slug)) }
			class="nav-drill-head-link"
			title={ fmt.Sprintf("Open %s page", et.NamePlural) }
		>
			<span class="nav-drill-ic" style={ fmt.Sprintf("color: %s", et.Color) }>
				if et.Icon != "" {
					<i class={ "fa-solid " + et.Icon } aria-hidden="true"></i>
				} else {
					<span class="nav-dot" style={ fmt.Sprintf("background-color: %s", et.Color) }></span>
				}
			</span>
			<span class="nav-drill-name">{ et.NamePlural }</span>
		</a>
		<span class="nav-drill-count">{ strconv.Itoa(count) }</span>
		// Creating a page needs Scribe; a Player would get a 403.
		if GetCampaignRole(ctx) >= 2 {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/entities/new?type=%d", campaignID, et.ID)) }
				class="nav-drill-new"
				title={ fmt.Sprintf("New %s", et.Slug) }
				aria-label={ fmt.Sprintf("New %s", et.Slug) }
				hx-boost="false"
			>
				<i class="fa-solid fa-plus" aria-hidden="true"></i>
			</a>
		}
	</div>
	<div class="nav-drill-search">
		<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
		<input
			type="search"
			placeholder={ fmt.Sprintf("Search %s…", et.NamePlural) }
			hx-get={ drillSearchURL(ctx, campaignID, et.ID) }
			hx-trigger="keyup changed delay:300ms"
			hx-target="#sidebar-cat-results"
			hx-swap="innerHTML"
			name="q"
			autocomplete="off"
			aria-label={ fmt.Sprintf("Search %s", et.NamePlural) }
		/>
	</div>
	if subs := SidebarEntitySubTypes(ctx, et.ID); len(subs) > 0 {
		<div class="nav-drill-subs">
			for _, s := range subs {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s/%s", campaignID, s.Slug)) }
					class="nav-drill-sub"
					if NavIsCurrent(ctx, fmt.Sprintf("cat:%d", s.ID)) {
						aria-current="page"
					}
				>
					<span class="nav-drill-sub-ic">
						if s.Icon != "" {
							<i class={ "fa-solid " + s.Icon } aria-hidden="true"></i>
						} else {
							<span class="nav-dot" style={ fmt.Sprintf("background-color: %s", s.Color) }></span>
						}
					</span>
					<span class="nav-drill-sub-lb">{ s.NamePlural }</span>
					<span class="nav-drill-sub-n">{ strconv.Itoa(GetEntityCount(ctx, s.ID)) }</span>
				</a>
			}
		</div>
	}
	<!-- Scrollable content: the folder tree (lazy-loaded), then Favorites. -->
	<div class="nav-drill-body overflow-y-auto">
		<div id="sidebar-cat-results">
			<div
				hx-get={ fmt.Sprintf("/campaigns/%s/entities/search?type=%d&sidebar=1", campaignID, et.ID) }
				hx-trigger="load"
				hx-target="#sidebar-cat-results"
				hx-swap="innerHTML"
			>
				<div class="nav-tree-skel">
					<div class="skeleton-shimmer h-3 w-3/4"></div>
					<div class="skeleton-shimmer h-3 w-1/2"></div>
					<div class="skeleton-shimmer h-3 w-2/3"></div>
				</div>
			</div>
		</div>
		<div id="sidebar-cat-favorites-header" class="nav-drill-fav-h" style="display:none">
			<i class="fa-solid fa-star" aria-hidden="true"></i> Favorites
		</div>
		<div id="sidebar-cat-favorites"></div>
	</div>
	<div class="nav-drill-recent">
		<div class="nav-drill-recent-h"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>Recent</div>
		<div id="sidebar-cat-recent" class="nav-drill-recent-empty">No recently viewed</div>
	</div>
}

// SidebarDrillFragment is the HTMX endpoint component. Finds the entity type by
// slug from context (populated by LayoutInjector) and renders SidebarDrillPanel.
templ SidebarDrillFragment(slug string) {
	for _, et := range GetEntityTypes(ctx) {
		if et.Slug == slug {
			@SidebarDrillPanel(GetCampaignID(ctx), et, GetEntityCount(ctx, et.ID))
		}
	}
}

// safeExternalURL re-applies the SafeLinkURL allowlist at render time so a
// link row stored before the ingress guard existed can never render as
// javascript:/data:/protocol-relative — defense-in-depth over templ.SafeURL,
// which deliberately bypasses Templ's URL sanitization. Falls back to "#".
func safeExternalURL(url string) templ.SafeURL {
	if u, ok := sanitize.SafeLinkURL(url); ok {
		return templ.SafeURL(u)
	}
	return templ.SafeURL("#")
}

// Topbar renders the top navigation bar with campaign selector, customizable
// content area, search, notes, and user menu.
templ Topbar() {
	<header id="app-topbar" class={ "h-14 bg-surface border-b border-edge flex items-center px-3 md:px-5 shrink-0 gap-2 relative isolate", templ.KV("cz-hdr-light", topbarWantsLightWords(ctx)) }>
		// #topbar-bg is always rendered, even empty, so a save on the Customize
		// page can swap in the new background without a reload: the header
		// sits outside #main-content and boosted navigation never redraws it.
		<div id="topbar-bg" class="contents">
			if topbarHasCustomStyle(ctx) {
				// Custom topbar background (solid / gradient / image) renders on a
				// dedicated full-bleed layer rather than on the <header> itself.
				// The header carries isolation:isolate ("isolate" Tailwind class), making
				// it a stacking context. Inside that context z-index:-1 paints the brand
				// layer above the header's own surface background but below in-flow nav
				// content — the image/gradient is visible and the nav stays on top.
				// Without isolate the header is not a stacking context; negative-z children
				// escape to the nearest ancestor context and paint before the header
				// surface, making the brand invisible (the original "saved but invisible" bug).
				// pointer-events:none lets clicks fall through to the nav controls.
				if topbarStyleIsMoving(ctx) {
					// Moving: an over-wide strip of the two colours that the
					// header-motion widget slides, easing to a stop whenever
					// the person steps away. The clip keeps the strip inside
					// the bar.
					<div style="position:absolute; inset:0; z-index:-1; pointer-events:none; overflow:hidden;" aria-hidden="true">
						<div data-widget="header-motion" data-axis={ topbarMovingAxis(ctx) } style={ topbarMovingStyle(ctx) }></div>
					</div>
				} else {
					<div
						style={ "position:absolute; inset:0; z-index:-1; pointer-events:none; " + topbarInlineStyle(ctx) }
						aria-hidden="true"
					></div>
				}
				if topbarStyleIsImage(ctx) {
					// A dark scrim over the photo keeps the nav text + icons legible
					// regardless of which image the owner uploaded.
					<div
						style={ "position:absolute; inset:0; z-index:-1; pointer-events:none; " + topbarScrimStyle(ctx) }
						aria-hidden="true"
					></div>
				}
			}
		</div>
		<!-- Left: Hamburger + Campaign selector -->
		<div class="flex items-center gap-2 shrink-0">
			<!-- Mobile hamburger -->
			<button
				id="nav-toggle"
				type="button"
				@click="sidebarOpen = !sidebarOpen"
				class="btn-ghost btn-icon -ml-1 md:hidden"
				title="Toggle menu"
				aria-label="Open navigation"
				aria-controls="sidebar"
				:aria-expanded="sidebarOpen ? 'true' : 'false'"
			>
				<i class="fa-solid fa-bars text-base"></i>
			</button>
			if IsAuthenticated(ctx) {
				if InCampaign(ctx) {
					<!-- In-campaign: current name + picker dropdown for switching -->
					<div x-data="{ open: false }" class="relative">
						<button
							@click="open = !open"
							@click.outside="open = false"
							class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-sm font-semibold text-fg hover:bg-surface-alt transition-colors"
						>
							<span class="truncate max-w-[110px] md:max-w-[160px]" data-topbar-name>{ GetDisplayName(ctx) }</span>
							<svg class="w-3.5 h-3.5 text-fg-muted shrink-0" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</button>
						<div
							x-show="open"
							x-cloak
							x-transition:enter="transition ease-out duration-100"
							x-transition:enter-start="opacity-0 scale-95"
							x-transition:enter-end="opacity-100 scale-100"
							x-transition:leave="transition ease-in duration-75"
							x-transition:leave-start="opacity-100 scale-100"
							x-transition:leave-end="opacity-0 scale-95"
							class="absolute left-0 top-full mt-1 w-64 bg-surface rounded-lg shadow-lg border border-edge z-50 overflow-hidden"
							hx-get="/campaigns/picker"
							hx-trigger="intersect once"
							hx-swap="innerHTML"
						>
							<div class="px-4 py-3 text-sm text-fg-muted">Loading...</div>
						</div>
					</div>
				} else if len(GetUserCampaigns(ctx)) == 1 {
					<!-- Single campaign: direct link -->
					<a
						href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s", GetUserCampaigns(ctx)[0].ID)) }
						class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-sm font-semibold text-fg hover:bg-surface-alt transition-colors"
					>
						<span class="truncate max-w-[160px]">{ GetUserCampaigns(ctx)[0].Name }</span>
					</a>
				} else if len(GetUserCampaigns(ctx)) > 1 {
					<!-- Multiple campaigns: dropdown with names pre-rendered -->
					<div x-data="{ open: false }" class="relative">
						<button
							@click="open = !open"
							@click.outside="open = false"
							class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-sm font-semibold text-fg hover:bg-surface-alt transition-colors"
						>
							<span class="text-fg-secondary">My Campaigns</span>
							<svg class="w-3.5 h-3.5 text-fg-muted shrink-0" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</button>
						<div
							x-show="open"
							x-cloak
							x-transition:enter="transition ease-out duration-100"
							x-transition:enter-start="opacity-0 scale-95"
							x-transition:enter-end="opacity-100 scale-100"
							x-transition:leave="transition ease-in duration-75"
							x-transition:leave-start="opacity-100 scale-100"
							x-transition:leave-end="opacity-0 scale-95"
							class="absolute left-0 top-full mt-1 w-64 bg-surface rounded-lg shadow-lg border border-edge z-50 overflow-hidden"
						>
							for _, uc := range GetUserCampaigns(ctx) {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/campaigns/%s", uc.ID)) }
									class="flex items-center px-4 py-2 text-sm text-fg-body hover:bg-surface-alt transition-colors"
									@click="open = false"
								>
									<span class="truncate">{ uc.Name }</span>
								</a>
							}
							<div class="border-t border-edge-light">
								<a href="/campaigns" class="flex items-center px-4 py-2 text-sm text-fg-secondary hover:bg-surface-alt hover:text-fg-body transition-colors" @click="open = false">
									All Campaigns
								</a>
							</div>
						</div>
					</div>
				} else {
					<!-- No campaigns in context (fallback): HTMX lazy-load -->
					<div x-data="{ open: false }" class="relative">
						<button
							@click="open = !open"
							@click.outside="open = false"
							class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-sm font-semibold text-fg hover:bg-surface-alt transition-colors"
						>
							<span class="text-fg-secondary">Select Campaign</span>
							<svg class="w-3.5 h-3.5 text-fg-muted shrink-0" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</button>
						<div
							x-show="open"
							x-cloak
							x-transition:enter="transition ease-out duration-100"
							x-transition:enter-start="opacity-0 scale-95"
							x-transition:enter-end="opacity-100 scale-100"
							x-transition:leave="transition ease-in duration-75"
							x-transition:leave-start="opacity-100 scale-100"
							x-transition:leave-end="opacity-0 scale-95"
							class="absolute left-0 top-full mt-1 w-64 bg-surface rounded-lg shadow-lg border border-edge z-50 overflow-hidden"
							hx-get="/campaigns/picker"
							hx-trigger="intersect once"
							hx-swap="innerHTML"
						>
							<div class="px-4 py-3 text-sm text-fg-muted">Loading...</div>
						</div>
					</div>
				}
			} else if InCampaign(ctx) {
				<span class="px-2.5 py-1.5 text-sm font-semibold text-fg" data-topbar-name>
					{ GetDisplayName(ctx) }
				</span>
			}
		</div>

		<!-- Center: Customizable content area (quick-links, quote, or empty) -->
		if InCampaign(ctx) {
			<div id="topbar-content" class="tb-slot flex-1 flex items-center justify-center min-w-0 overflow-hidden transition-all duration-200">
				@topbarCenterContent(ctx)
			</div>

			<!-- Inline search bar (hidden by default, shown when search is active) -->
			<div id="topbar-search" class="flex-1 items-center min-w-0 hidden">
				<div class="relative w-full max-w-lg mx-auto">
					<input
						id="topbar-search-input"
						type="text"
						class="w-full pl-9 pr-4 py-1.5 rounded-lg bg-surface-alt border border-edge text-sm text-fg placeholder-fg-muted focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent/30"
						placeholder="Search pages, notes, maps..."
						autocomplete="off"
					/>
					<svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-fg-muted pointer-events-none" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<kbd class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-fg-muted font-mono border border-edge rounded px-1 py-0.5">
						Esc
					</kbd>
				</div>
				<!-- Search results dropdown (populated by JS) -->
				<div id="topbar-search-results" class="absolute left-0 right-0 top-full mt-1 mx-auto max-w-lg bg-surface border border-edge rounded-lg shadow-xl z-50 hidden max-h-[60vh] overflow-y-auto"></div>
			</div>
		}

		<!-- Right: Search + Notes + Dark mode + User menu -->
		<div class="flex items-center gap-1 shrink-0 ml-auto">
			if InCampaign(ctx) {
				<!-- Search trigger (magnifying glass) -->
				<button
					id="topbar-search-trigger"
					onclick="Chronicle.openSearch()"
					class={ "btn-ghost btn-icon", templ.KV("md:hidden", topbarHasWidget(ctx, "search")) }
					title="Search (Ctrl+K)"
				>
					<svg class="w-4 h-4" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
				</button>

			}

			<!-- Dark mode toggle -->
			<button
				data-theme-toggle
				class="btn-ghost btn-icon"
				title="Toggle dark mode"
			>
				<svg class="w-4 h-4 theme-icon-light hidden" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
				</svg>
				<svg class="w-4 h-4 theme-icon-dark" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
				</svg>
			</button>

			<!-- View as player toggle (campaign owners only) -->
			if InCampaign(ctx) && IsOwner(ctx) {
				<button
					hx-post={ "/campaigns/" + GetCampaignID(ctx) + "/toggle-view-mode" }
					hx-headers={ `{"X-CSRF-Token":"` + GetCSRFToken(ctx) + `"}` }
					class={
						"btn-ghost btn-icon",
						templ.KV("!bg-amber-500/20 !text-amber-400 hover:!bg-amber-500/30", IsViewingAsPlayer(ctx)),
					}
					title={ func() string { if IsViewingAsPlayer(ctx) { return "Viewing as player — click to return to owner view" }; return "View as player" }() }
				>
					<i class={ "fa-solid text-xs", templ.KV("fa-eye-slash", IsViewingAsPlayer(ctx)), templ.KV("fa-eye", !IsViewingAsPlayer(ctx)) }></i>
				</button>
			}

			if IsAuthenticated(ctx) {
				<!-- Notification bell (C-SCHED-P2). Server-rendered button + badge;
				     the badge count refreshes via an HTMX poll, the dropdown is
				     driven by the notification-bell widget. Scheduler-scoped this
				     slice. -->
				<div class="relative" data-widget="notification-bell" data-csrf={ GetCSRFToken(ctx) }>
					<button
						type="button"
						class="btn-ghost btn-icon relative"
						data-notif-toggle
						title="Notifications"
						aria-label="Notifications"
						hx-get="/notifications/badge"
						hx-trigger="load, every 60s"
						hx-target="find [data-notif-badge]"
						hx-swap="innerHTML"
					>
						<i class="fa-solid fa-bell text-sm"></i>
						<span data-notif-badge></span>
					</button>
					<div
						data-notif-panel
						hidden
						class="absolute right-0 top-full mt-1 w-80 max-h-[70vh] overflow-y-auto bg-surface rounded-lg shadow-lg border border-edge z-50"
					>
						<div class="flex items-center justify-between px-3 py-2 border-b border-edge">
							<span class="text-sm font-semibold text-fg">Notifications</span>
							<button type="button" class="text-xs text-accent hover:underline" data-notif-markall>Mark all read</button>
						</div>
						<div data-notif-list class="py-0"></div>
					</div>
				</div>
			}
			if InCampaign(ctx) && (GetCampaignRole(ctx) >= 2 || IsDmGranted(ctx)) {
				<!-- DM Screen: the control panel for the owner, scribes and
				     members with DM access (dmscreen.CanOpen). The dm-screen
				     widget fetches the panel and plays the opening; hidden
				     under "view as player" because the role reads 1. -->
				<div data-widget="dm-screen" data-url={ fmt.Sprintf("/campaigns/%s/dm-screen", GetCampaignID(ctx)) }>
					<button type="button" class="btn-ghost btn-icon" data-dms-open title="DM Screen" aria-label="Open the DM Screen" aria-haspopup="dialog">
						<svg class="w-5 h-5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
							<path d="M2 6l6-2v15l-6 2z"></path>
							<path d="M8 4l8 2v15l-8-2z"></path>
							<path d="M16 6l6-2v15l-6 2z"></path>
						</svg>
					</button>
				</div>
			}
			if IsAuthenticated(ctx) {
				<!-- User dropdown (avatar + account/logout) -->
				<div x-data="{ open: false }" class="relative">
					<button
						@click="open = !open"
						@click.outside="open = false"
						class="flex items-center gap-1.5 px-1.5 py-1 rounded-lg hover:bg-surface-alt transition-colors"
					>
						<div class="w-7 h-7 rounded-full bg-accent-fill flex items-center justify-center overflow-hidden">
							if avatarPath := GetUserAvatarPath(ctx); avatarPath != "" {
								<img src={ MediaThumbURL(ctx, avatarPath, "300") } class="w-full h-full object-cover" alt=""/>
							} else {
								<span class="text-[10px] font-semibold text-on-accent">
									{ userInitials(ctx) }
								</span>
							}
						</div>
						<svg class="w-3 h-3 text-fg-muted hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
						</svg>
					</button>
					<div
						x-show="open"
						x-cloak
						x-transition:enter="transition ease-out duration-100"
						x-transition:enter-start="opacity-0 scale-95"
						x-transition:enter-end="opacity-100 scale-100"
						x-transition:leave="transition ease-in duration-75"
						x-transition:leave-start="opacity-100 scale-100"
						x-transition:leave-end="opacity-0 scale-95"
						class="absolute right-0 top-full mt-1 w-48 bg-surface rounded-lg shadow-lg border border-edge z-50 py-1"
					>
						<div class="px-3 py-2 border-b border-edge">
							<div class="text-sm font-medium text-fg truncate">{ GetUserName(ctx) }</div>
							<div class="text-xs text-fg-muted truncate">{ GetUserEmail(ctx) }</div>
						</div>
						<a href="/account" class="dropdown-item" @click="open = false">
							<i class="fa-solid fa-gear text-xs w-4"></i> Account Settings
						</a>
						<form method="POST" action="/logout">
							<input type="hidden" name="csrf_token" value={ GetCSRFToken(ctx) }/>
							<button type="submit" class="dropdown-item dropdown-item-danger w-full text-left">
								<i class="fa-solid fa-arrow-right-from-bracket text-xs w-4"></i> Log out
							</button>
						</form>
					</div>
				</div>
			} else {
				<a href="/login" class="text-sm font-medium text-accent hover:text-accent-hover transition-colors">
					Log in
				</a>
				<a href="/register" class="btn-primary text-sm">
					Sign up
				</a>
			}
		</div>
	</header>
}

// FlashMessages renders success/error flash messages if present in context.
// Messages auto-dismiss after 5 seconds via Alpine.js.
templ FlashMessages() {
	if msg := GetFlashSuccess(ctx); msg != "" {
		<div
			x-data="{ show: true }"
			x-show="show"
			x-init="setTimeout(() => show = false, 5000)"
			x-transition
			class="mx-6 mt-4 px-4 py-3 rounded-md bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-400 text-sm flex items-center justify-between"
		>
			<span>{ msg }</span>
			<button @click="show = false" class="text-green-600 dark:text-green-400 hover:text-green-800 dark:hover:text-green-300 ml-4">&times;</button>
		</div>
	}
	if msg := GetFlashError(ctx); msg != "" {
		<div
			x-data="{ show: true }"
			x-show="show"
			x-init="setTimeout(() => show = false, 8000)"
			x-transition
			class="mx-6 mt-4 px-4 py-3 rounded-md bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-400 text-sm flex items-center justify-between"
		>
			<span>{ msg }</span>
			<button @click="show = false" class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 ml-4">&times;</button>
		</div>
	}
}

// isExactPath returns true if the current request path exactly matches the given path.
func isExactPath(ctx context.Context, path string) bool {
	return GetActivePath(ctx) == path
}

// isPathPrefix returns true if the current request path starts with the given prefix.
func isPathPrefix(ctx context.Context, prefix string) bool {
	active := GetActivePath(ctx)
	return active == prefix || strings.HasPrefix(active, prefix+"/")
}

// notesWidgetVisible reports whether the Jot notes tab and panel (mounted by
// NotesWidget) render for the current request: authenticated, in a campaign,
// with the "notes" addon enabled. Jots and Journal notes are different rows,
// so the panel can sit on the Journal page without the two editing the same
// note.
func notesWidgetVisible(ctx context.Context) bool {
	return InCampaign(ctx) && IsAuthenticated(ctx) && IsAddonEnabled(ctx, "notes")
}

// isExternalURL returns true if the URL starts with http:// or https://,
// indicating it points to an external site. Used to add target="_blank" and
// an external-link icon.
func isExternalURL(url string) bool {
	return strings.HasPrefix(url, "http://") || strings.HasPrefix(url, "https://")
}

// topbarCenterContent renders the header's widgets in the owner's order. At
// md and wider every widget shows; below that the first stays and the rest
// move into a tray under the header behind a "+N" button, because a phone's
// bar has room for one. When the bar is too narrow even for that one, a
// container query (input.css, "tb-") moves it into the tray too, so no widget
// is ever unreachable.
templ topbarCenterContent(ctx context.Context) {
	if tc := GetTopbarContent(ctx); tc != nil {
		if ws := topbarShownWidgets(ctx, tc); len(ws) > 0 {
			<div
				class="flex items-center gap-3 min-w-0 justify-center"
				x-data="{ more: false }"
				@click.outside="more = false"
				@keydown.escape.window="if (more) { more = false; $nextTick(() => $refs.moreBtn.focus()) }"
			>
				for i, w := range ws {
					if i == 0 {
						<div class="tb-first flex items-center min-w-0">
							@topbarWidget(ctx, tc, w)
						</div>
					} else {
						<div class="hidden md:flex items-center min-w-0">
							@topbarWidget(ctx, tc, w)
						</div>
					}
				}
				<button
					type="button"
					x-ref="moreBtn"
					@click="more = !more"
					:aria-expanded="more ? 'true' : 'false'"
					aria-controls="topbar-tray"
					class={ "md:hidden shrink-0 inline-flex items-center px-2.5 py-1 rounded-full border border-edge bg-surface-alt text-xs font-semibold text-fg", templ.KV("tb-solo", len(ws) == 1) }
				>
					if len(ws) > 1 {
						<span class="tb-n">+{ strconv.Itoa(len(ws) - 1) }</span>
					}
					<span class="tb-n-all">+{ strconv.Itoa(len(ws)) }</span>
					<span class="sr-only">more header items</span>
				</button>
				<div
					id="topbar-tray"
					x-show="more"
					x-cloak
					class="md:hidden absolute left-2 right-2 top-full mt-1.5 z-50 flex flex-wrap items-center gap-2 p-2.5 rounded-lg border border-edge bg-surface text-fg shadow-xl"
				>
					<div class="tb-first-copy">
						@topbarWidget(ctx, tc, ws[0])
					</div>
					for _, w := range ws[1:] {
						@topbarWidget(ctx, tc, w)
					}
				</div>
			</div>
		}
	}
}

// topbarWidgetShown reports whether a widget has anything to draw for this
// viewer: links with no links, empty text, or a note button for someone who
// can't take notes would only leave a gap.
func topbarWidgetShown(ctx context.Context, tc *TopbarContentData, w string) bool {
	switch w {
	case "links":
		return len(tc.Links) > 0
	case "text":
		return tc.Quote != ""
	case "note":
		return IsAuthenticated(ctx) && GetCampaignRole(ctx) >= 1
	case "search":
		return true
	case "date":
		return tc.Live != nil && tc.Live.Date != ""
	case "weather":
		return tc.Live != nil && tc.Live.Weather != ""
	case "moon":
		return tc.Live != nil && len(tc.Live.Moons) > 0
	case "session":
		return tc.Live != nil && tc.Live.NextNight.Label != ""
	}
	return false
}

// topbarMoonText joins each moon's name and phase for the moon chip, capped
// at three so a world with many moons can't crowd the bar; the rest are
// counted.
func topbarMoonText(moons []TopbarMoon) string {
	const shown = 3
	parts := make([]string, 0, shown+1)
	for i, m := range moons {
		if i == shown {
			parts = append(parts, fmt.Sprintf("+%d more", len(moons)-shown))
			break
		}
		parts = append(parts, m.Name+" "+strings.ToLower(m.Phase))
	}
	return strings.Join(parts, " · ")
}

// topbarChipClass is the shared pill for the data-backed widgets: the Quick
// note button's look without being a button, since these only report.
const topbarChipClass = "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-edge bg-surface-alt text-xs font-medium text-fg-secondary whitespace-nowrap min-w-0 max-w-[16rem] sm:max-w-[22rem]"

// topbarShownWidgets is the header's widgets, in order, that have something
// to draw.
func topbarShownWidgets(ctx context.Context, tc *TopbarContentData) []string {
	var out []string
	for _, w := range tc.TopbarWidgets() {
		if topbarWidgetShown(ctx, tc, w) {
			out = append(out, w)
		}
	}
	return out
}

// topbarHasWidget reports whether the header holds widget w, so the search
// icon can step aside for the search box.
func topbarHasWidget(ctx context.Context, w string) bool {
	tc := GetTopbarContent(ctx)
	if tc == nil {
		return false
	}
	for _, x := range tc.TopbarWidgets() {
		if x == w {
			return topbarWidgetShown(ctx, tc, w)
		}
	}
	return false
}

// topbarWidget renders one header widget. Quick note and search open the
// site's own quick capture and topbar search, so they behave exactly as the
// keyboard shortcuts and icon do.
templ topbarWidget(ctx context.Context, tc *TopbarContentData, w string) {
	if w == "links" && len(tc.Links) > 0 {
		<div class="flex items-center gap-1.5 justify-center min-w-0">
			for _, link := range tc.Links {
				<a
					href={ safeExternalURL(link.URL) }
					class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium text-fg-secondary hover:text-fg hover:bg-surface-alt transition-colors whitespace-nowrap"
				>
					if link.Icon != "" {
						<i class={ "fa-solid " + link.Icon, "text-[10px]" }></i>
					}
					{ link.Label }
				</a>
			}
		</div>
	} else if w == "text" && tc.Quote != "" {
		<div class="text-xs text-fg-muted italic truncate px-1 md:px-4 max-w-md text-center min-w-0">
			{ tc.Quote }
		</div>
	} else if w == "note" && topbarWidgetShown(ctx, tc, "note") {
		<button
			type="button"
			onclick="if(window.Chronicle&&Chronicle.openQuickCapture){Chronicle.openQuickCapture();}"
			class="shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-edge bg-surface-alt text-xs font-medium text-fg-secondary hover:text-fg whitespace-nowrap"
			title="Quick note (Ctrl+Shift+N)"
		>
			<i class="fa-solid fa-pen text-[10px]" aria-hidden="true"></i>
			Quick note
		</button>
	} else if w == "date" && topbarWidgetShown(ctx, tc, "date") {
		<span class={ topbarChipClass } title="Today in your world">
			<i class="fa-solid fa-calendar-days text-[10px] shrink-0" aria-hidden="true"></i>
			<span class="truncate">{ tc.Live.Date }</span>
		</span>
	} else if w == "weather" && topbarWidgetShown(ctx, tc, "weather") {
		<span class={ topbarChipClass } title="Today's weather">
			<i class="fa-solid fa-cloud-sun text-[10px] shrink-0" aria-hidden="true"></i>
			<span class="truncate">{ tc.Live.Weather }</span>
		</span>
	} else if w == "moon" && topbarWidgetShown(ctx, tc, "moon") {
		<span class={ topbarChipClass } title="Today's moon">
			<i class="fa-solid fa-moon text-[10px] shrink-0" aria-hidden="true"></i>
			<span class="truncate">{ topbarMoonText(tc.Live.Moons) }</span>
		</span>
	} else if w == "session" && topbarWidgetShown(ctx, tc, "session") {
		<span class={ topbarChipClass } title={ tc.Live.NextNight.Title }>
			<i class="fa-solid fa-clock text-[10px] shrink-0" aria-hidden="true"></i>
			<span class="truncate">{ tc.Live.NextNight.Label }</span>
		</span>
	} else if w == "search" {
		<button
			type="button"
			onclick="if(window.Chronicle&&Chronicle.openSearch){Chronicle.openSearch();}"
			class="inline-flex items-center gap-2 w-full min-w-[9rem] max-w-xs px-3 py-1.5 rounded-lg border border-edge bg-surface-alt text-xs text-fg-muted hover:text-fg text-left"
			title="Search (Ctrl+K)"
		>
			<i class="fa-solid fa-magnifying-glass text-[11px] shrink-0" aria-hidden="true"></i>
			<span class="truncate flex-1">{ "Search " + GetDisplayName(ctx) + "…" }</span>
			<kbd class="hidden lg:inline text-[10px] font-mono border border-edge rounded px-1 py-0.5">Ctrl K</kbd>
		</button>
	}
}

// topbarInlineStyle returns the CSS background declaration for the campaign's
// custom topbar, or an empty string for the default surface styling. Applied
// to the dedicated background layer inside <header> (see Topbar), not the
// element itself, so the opaque surface fill and nav children don't mask it.
func topbarInlineStyle(ctx context.Context) string {
	style := GetTopbarStyle(ctx)
	if style == nil {
		return ""
	}
	switch style.Mode {
	case "solid":
		if style.Color != "" {
			return fmt.Sprintf("background-color: %s;", style.Color)
		}
	case "gradient", "moving":
		// Moving shares the plain gradient as its resting look and as the
		// test for "has a custom style"; topbarMovingStyle draws the drift.
		if style.GradientFrom != "" && style.GradientTo != "" {
			return fmt.Sprintf("background: linear-gradient(%s, %s, %s);", topbarGradientDir(style.GradientDir), style.GradientFrom, style.GradientTo)
		}
	case "image":
		if style.ImagePath != "" {
			return fmt.Sprintf("background-image: url('%s'); background-size: cover; background-position: center;", MediaURL(ctx, style.ImagePath))
		}
	}
	return ""
}

// topbarWantsLightWords reports whether the custom header background needs
// light words: always over a picture, otherwise whichever of white or the
// page's ink reads better on its colours (the Customize preview's rule).
func topbarWantsLightWords(ctx context.Context) bool {
	style := GetTopbarStyle(ctx)
	if style == nil || !topbarHasCustomStyle(ctx) {
		return false
	}
	var cols []string
	switch style.Mode {
	case "image":
		return true
	case "solid":
		cols = []string{style.Color}
	case "gradient", "moving":
		cols = []string{style.GradientFrom, style.GradientTo}
	}
	white, ink := 99.0, 99.0
	for _, c := range cols {
		if !colour.ValidHex(c) {
			return false
		}
		white = min(white, colour.Contrast(c, "#ffffff"))
		ink = min(ink, colour.Contrast(c, "#111827"))
	}
	return white >= ink
}

// topbarScrimStyle is the shade over an image header: the owner's choice
// of strength, medium by default, darker at the top where the words sit.
func topbarScrimStyle(ctx context.Context) string {
	top, bottom := 0.55, 0.25
	if style := GetTopbarStyle(ctx); style != nil {
		switch style.Scrim {
		case "light":
			top, bottom = 0.38, 0.15
		case "strong":
			top, bottom = 0.72, 0.45
		}
	}
	return fmt.Sprintf("background:linear-gradient(to bottom, rgba(0,0,0,%.2f), rgba(0,0,0,%.2f));", top, bottom)
}

// topbarGradientDir converts the stored shorthand gradient direction into a CSS
// gradient direction keyword, defaulting to "to right" for empty/unknown input.
func topbarGradientDir(dir string) string {
	switch dir {
	case "to-br":
		return "to bottom right"
	case "to-b":
		return "to bottom"
	default: // "to-r" or empty
		return "to right"
	}
}

// topbarHasCustomStyle reports whether the campaign has a renderable custom
// topbar background — used to decide whether to emit the background layer.
func topbarHasCustomStyle(ctx context.Context) bool {
	return topbarInlineStyle(ctx) != ""
}

// topbarStyleIsMoving reports whether the header background drifts.
func topbarStyleIsMoving(ctx context.Context) bool {
	style := GetTopbarStyle(ctx)
	return style != nil && style.Mode == "moving" && topbarInlineStyle(ctx) != ""
}

// topbarMovingAxis is the axis the strip slides along: "y" only for a
// top-to-bottom gradient, "x" otherwise.
func topbarMovingAxis(ctx context.Context) string {
	if style := GetTopbarStyle(ctx); style != nil && style.GradientDir == "to-b" {
		return "y"
	}
	return "x"
}

// topbarMovingStyle sizes the strip three bars long, painted as the two
// colours repeating once per bar length, so sliding it by one third loops
// seamlessly. Only a transform ever moves it.
func topbarMovingStyle(ctx context.Context) string {
	style := GetTopbarStyle(ctx)
	if style == nil {
		return ""
	}
	stops := fmt.Sprintf("%s 0%%, %s 16.6667%%, %s 33.3333%%", style.GradientFrom, style.GradientTo, style.GradientFrom)
	if topbarMovingAxis(ctx) == "y" {
		return "position:absolute; left:0; top:0; width:100%; height:300%; will-change:transform; background:repeating-linear-gradient(180deg, " + stops + ");"
	}
	return "position:absolute; left:0; top:0; width:300%; height:100%; will-change:transform; background:repeating-linear-gradient(90deg, " + stops + ");"
}

// topbarStyleIsImage reports whether the custom topbar background is an image,
// which additionally gets a dark scrim layered over it for nav legibility.
func topbarStyleIsImage(ctx context.Context) bool {
	style := GetTopbarStyle(ctx)
	return style != nil && style.Mode == "image" && style.ImagePath != ""
}

// userInitials returns the first two initials of the user's display name
// for the avatar placeholder.
func userInitials(ctx context.Context) string {
	name := GetUserName(ctx)
	if name == "" {
		return "?"
	}
	parts := strings.Fields(name)
	if len(parts) == 1 {
		return strings.ToUpper(name[:1])
	}
	return strings.ToUpper(string(parts[0][0]) + string(parts[len(parts)-1][0]))
}

// NotesWidget renders the mount point for the floating notes panel.
// The campaign ID is passed as a data attribute; entity ID is auto-detected
// from the URL by the JavaScript widget (pattern: /campaigns/:id/entities/:eid).
templ NotesWidget() {
	<div
		data-widget="notes"
		data-campaign-id={ GetCampaignID(ctx) }
		data-entity-id={ extractEntityID(ctx) }
		data-user-id={ GetUserID(ctx) }
	></div>
}

// extractEntityID extracts an entity ID from the current URL if we're on an
// entity show/edit page. Returns "" if not on an entity page. It reads the
// real request path: an entity page sets its active path to its category for
// the sidebar, which would hide the page from the jot panel.
func extractEntityID(ctx context.Context) string {
	path := GetRequestPath(ctx)
	// Pattern: /campaigns/{id}/entities/{eid}[/...]
	parts := strings.Split(path, "/")
	// parts: ["", "campaigns", "{id}", "entities", "{eid}", ...]
	if len(parts) >= 5 && parts[3] == "entities" && parts[4] != "new" && parts[4] != "search" && parts[4] != "" {
		return parts[4]
	}
	return ""
}
