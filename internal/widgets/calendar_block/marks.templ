// marks.templ — the axis layer.
//
// COLOUR IS NEVER LOAD-BEARING. Every axis value owns a HUE and a locked STROKE
// PATTERN assigned by the same index, so every mark still resolves under
// `filter: grayscale(1)` by its dash pattern plus a non-colour token — the glyph
// for the type axis, initials for the owner axis, a letter for the calendar
// axis. That is the greyscale identity channel, and it is what
// v4-greyscale-proof.png gates.
//
// CHANNEL DISCIPLINE: --axis is the ONLY channel this layer may reference, and
// it is FORBIDDEN from referencing --accent. The moment accent means "related to
// what you're pointing at" it stops meaning "selected". --cal carries calendar
// identity and --bandhue the era tint; neither belongs to a mark.

package calendar_block

// namedChip is the wide density's mark: a 3px patterned rail, a non-colour
// token, and a label. A glyph WITH a label is legible; a glyph INSTEAD of a
// label is a rebus.
templ namedChip(m Mark) {
	<div
		class={ "chip" + tieClass(m) }
		style={ axisStyle(m.Axis) }
		title={ markTitle(m) }
		if m.EventID != "" {
			data-event-id={ m.EventID }
		}
	>
		<i class={ "rail " + patternClass(m.Pattern) } aria-hidden="true"></i>
		if m.Glyph != "" {
			<span class="tok g" aria-hidden="true">{ m.Glyph }</span>
		}
		<span class="lb">{ m.Title }</span>
	</div>
}

// underline is the narrow density's mark: ONE bar, never a stack. A stack
// encodes a magnitude the data does not have and reads as a progress meter.
// Max three segments; a fourth turns the third neutral and the exact count lives
// in the Ledger.
templ underline(c DayCell) {
	if len(c.Marks) > 0 {
		<div class="ul">
			for i, m := range underlineSegs(c) {
				if underlineRestAt(c, i) {
					<i class="ulseg rest" aria-hidden="true"></i>
				} else {
					<i
						class={ "ulseg " + patternClass(m.Pattern) + tieClass(m) }
						style={ axisStyle(m.Axis) }
						title={ markTitle(m) }
					></i>
				}
			}
		</div>
	}
}

// moonRow draws the sky where the eye already is.
//
// A derived TERMINATOR, not a pie fill (L25): filled means lit, an empty ring
// means new, and a crescent looks like a crescent. Achromatic by law — the sky
// may never borrow the event colour axis — and capped at three bodies, so the
// month can never grow with the fiction. The ceiling is declared ONCE, in the
// Nameplate, and never thirty times in the grid.
// AND IT IS NOW A CONTROL (C-CALV4-MOONS, [MN-3] SIGNED). Pressing it folds the
// two-tab moon panel open at this cell's row, over the rows beneath.
//
// A CONTROL THAT IS INVISIBLE TO ASSISTIVE TECHNOLOGY IS NOT A CONTROL, so the
// accessibility is part of the same change rather than a follow-up. What
// shipped before was `<span class="phrow" aria-hidden="true">` with a `title`
// on each disc: no name, no role, no tab stop, nothing for a screen reader. It
// is now a <label> for a real radio — the Block's own dayPick idiom — so the
// keyboard lands on the radio, the label carries the focus ring, and
// moonClusterLabel names the day and every body on it.
//
// THE DISCS THEMSELVES GO `aria-hidden` AND LOSE THEIR OWN `title`, which is
// not a loss of information but a fix: three tooltips on the parts of one
// button are three answers to one question, and the cluster's single title now
// carries the same sentence. The three discs and their order do not change.
//
// [MN-1] IS 3 AND THE EXPANSION DOES NOT BUY A FOURTH. The signed answer is
// "up to 3, otherwise a plus symbol", and the plus is the Nameplate's chip —
// never a per-cell "+N", in any state including hovered, focused and expanded
// (MN-G4; moongraph.templ:23, L30). The hover shows MORE OF THE SAME THREE.
//
// WHERE THE PANEL IS NOT REACHABLE the cluster stays exactly what it was: a
// decorative row with a tooltip. A Block whose host removed the Shelf has no
// Almanac register built, and a cluster that opened two empty tabs would be a
// dead affordance — the honesty idiom is to emit no control at all rather than
// one that does nothing (dayPick's own rule past the ladder's bound).
templ moonRow(d BlockData, c DayCell) {
	if len(c.Moons) > 0 {
		if moonPanelReachable(d) {
			<label
				class="phrow phctl"
				data-cal-moons
				for={ moonPickInputID(d, dayOrdKey(c.Day)) }
				title={ moonClusterTitle(c) }
			>
				<span class="vh">{ moonClusterLabel(c) }</span>
				for _, md := range moonsFor(c) {
					<i class={ moonWaneClass(md) } style={ moonStyle(md) } aria-hidden="true"></i>
				}
			</label>
		} else {
			<span class="phrow" aria-hidden="true">
				for _, md := range moonsFor(c) {
					<i class={ moonWaneClass(md) } style={ moonStyle(md) } title={ moonTitle(md) }></i>
				}
			</span>
		}
	}
}

// moonPick is one day's panel radio: visually hidden, a direct child of the
// cell, addressed by the cluster label above.
//
// A DIRECT CHILD OF THE CELL rather than of `.cnamed`, because the panel opens
// on a plain `:has()` over the WEEK ROW and the radio has to be findable from
// there whichever subtree the cell's container query is showing.
//
// GATED ON THE SAME PREDICATE AS THE LABEL, in one place, so the two cannot
// drift into a label pointing at an input that was never emitted.
templ moonPick(d BlockData, c DayCell) {
	if moonPanelReachable(d) && len(c.Moons) > 0 {
		<input
			type="radio"
			class="moonpick vhctl"
			data-moon-pick={ dayOrdKey(c.Day) }
			name={ moonPickGroupName(d) }
			id={ moonPickInputID(d, dayOrdKey(c.Day)) }
			aria-label={ moonClusterLabel(c) }
		/>
	}
}
