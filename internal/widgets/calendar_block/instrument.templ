// instrument.templ — Zone B, the month.
//
// TEN-DAY WEEKS ARE NATIVE. There is no literal 7 anywhere in this file or in
// the grid CSS: --week-len drives every column count, the five-column rule is
// read from the producer's Half flags rather than re-derived from a week length,
// and the header, the era bands, the cells and the intercalary row are all
// subgrids across the SAME tracks, so nothing can drift out of alignment.
//
// THE ERA IS A TINT ON THE DAY CELLS AND NOTHING ELSE (C-CALV4-TILES §3). The
// caption row that used to sit above each week — the era's NAME, its season
// suffix and the `.halfrule` ruler that only ever existed inside it — is gone:
// the operator asked for the era to be "a color of the dates background and
// that's it", and the reference carries no era text anywhere in the grid.
//
// `EraBand` THE DATA SURVIVES AND MUST. `cellStyle` reads `row.Bands` to work
// out which era covers a given day and stamps `--erahue` on the cell; deleting
// the band data would delete the colour, which is now the only thing left
// saying "era" inside the month.
//
// AND THE NAME IS GENUINELY GONE — this comment used to claim it was "only
// repeated" elsewhere and that was wrong (corrected 2026-08-15). The Nameplate
// badge reads BlockData.EraLabel, a DIFFERENT field from the EraBand.Label this
// row printed and not kept in step with it, and it names the calendar's ONE
// current era rather than each week's. `EraBand.Label` and `EraBand.Suffix`
// have no reader in this widget at all now; data.go says so at the declaration.
// The era colour having no legend that names the era is booked as a real
// unbuilt gap in C-CALV4-TILES §7.

package calendar_block

// instrument renders the month grid and, for the sub-mini tier, the thirty-tick
// rule that honestly replaces it.
templ instrument(d BlockData) {
	<div
		class="grid"
		data-week-len={ intText(d.Month.WeekLen) }
		data-weeknums?={ hasLayer(d.Layers, "weeknums") }
		if ledgerDocked(d) {
			role="group"
			aria-label="Choose a day — the event list beside the month answers"
		}
	>
		// THE MOON PANEL'S THREE SHARED RADIOS, rendered once for the whole
		// Block: the group's explicit `none` (checked, so nothing is open at
		// rest, and its label is the panel's ✕) and the Graph|Details pair every
		// panel's labels point at. They are visually hidden and out of flow, so
		// they take no grid row here.
		@moonPanelControls(d)
		if len(d.Month.Weekdays) > 0 {
			@weekdayHeader(d.Month)
		}
		for _, row := range d.Month.Rows {
			@weekRow(d, row)
		}
		@intercalaryRows(d)
	</div>
	@tickStrip(d)
}

// weekdayHeader emits BOTH abbreviation lengths; the container query picks one.
// The five-column rule reaches the header cell, not just the day cell.
templ weekdayHeader(m MonthGeometry) {
	<div class="hd">
		<span class="gut"></span>
		for _, w := range m.Weekdays {
			<b class={ weekdayClass(w) } title={ w.Name }>
				<span class="wd-l">{ wdLong(w) }</span>
				<span class="wd-s">{ wdShort(w) }</span>
			</b>
		}
	</div>
}

// THE FIVE-COLUMN RULE HAS ONE OWNER AGAIN, AND IT IS `.cell.half`.
//
// `.halfrule` existed for one reason: an era band is a single grid item
// spanning many columns, so its own border-right could only land at the band's
// right edge — column 10 on a full-width band, column 7 on the Harptos row-1
// split — never reliably at the counting boundary. A zero-width ruler item
// placed on the half column itself was the way to draw a rule across a row made
// of spanning items.
//
// With the band row deleted there is no spanning item and no problem to solve:
// every row of the grid is now one item per column, and `.cell.half`'s own
// border-right lands exactly on the boundary. The weekday header's `b.half`
// carries the same rule and always did. Nothing about the ramp step changed —
// only the number of elements needed to draw it.

// weekRow is one row of day cells, plus the week-number gutter.
//
// The row is a dated surface in its own right (COMMON §6.6: every dated cell
// AND row carries the answer key), so it takes the data-row marker guard B4
// keys on. Its key lives in the week namespace (weekKey), never a day's. The
// gutter LABEL stays bare — weekLabel is a position readout, not the row's
// identity.
templ weekRow(d BlockData, row WeekRow) {
	<div class="wk" data-row data-day={ weekKey(d.CalendarSlug, row) }>
		<span class="gut">
			if hasLayer(d.Layers, "weeknums") {
				<b class="wknum">{ weekLabel(row) }</b>
			}
		</span>
		for _, c := range row.Cells {
			@dayCell(d, row, c)
		}
		// THE MOON PANEL FOLDS OPEN HERE, over the rows beneath (C-CALV4-MOONS
		// [MN-3]). One per row rather than one per cell: both tabs' contents are
		// identical for every day of the month and only the MARKED column
		// differs, so a per-cell copy would be ~6,900 extra nodes on one Block
		// and ~27,600 on the Bench's four. It is absolutely positioned, so it
		// takes no subgrid column and costs the row zero layout (MN-G5).
		if moonPanelReachable(d) {
			@moonPanel(d)
		}
	</div>
}

// weekKey is the row's ANSWER key. COMMON §6.6 has every dated cell AND row
// carry data-day, with guard B4 keying on the data-cell/data-row markers
// beside it — so a dated surface that later loses its key fails CI instead of
// just going quiet. A week is a position, not a date: its key gets the "-w"
// namespace beside dayKey's "slug-N" and intercalaryKey's "slug-iN", so a row
// can never answer for a day. 1-based, agreeing with the gutter's W1.
func weekKey(slug string, r WeekRow) string {
	if slug == "" {
		slug = "cal" // dayKey's placeholder; the key namespaces must agree on it
	}
	return slug + "-w" + intText(r.Index+1)
}

// dayCell ships EXACTLY TWO SUBTREES — named chips and an underline — and the
// cell's own container query shows one. Never four tiers of markup: a tier the
// producer cannot see is a tier that silently rots.
//
// data-day is on the CELL, once, whichever subtree is visible, with data-cell
// beside it as the marker guard B4 keys on (COMMON §6.6) — the marker is what
// lets the guard notice a dated surface that later LOSES its key. Both sit
// behind the same c.Day > 0 gate: an out-of-range cell is not dated and must
// not claim to be. Nothing consumes the key in wave 1; W-B does.
//
// The per-cell moon discs belong to the "moons" LAYER (data.go: DEF =
// ["moons"], the moongraph key owns the CURVE, not the discs), so the row is
// gated on the registry like every other layer-owned surface — a cell that
// carries Moons the viewer switched off must not draw them.
//
// THE DISC ROW IS A DIRECT CHILD OF THE CELL, NOT OF `.cnamed`, and that is
// the fix for the defect this feature shipped with: it lived inside the NAMED
// subtree, `.cnamed` is `display:none` until a cell measures 84px, and a day
// cell only reaches 84px for a SEVEN-day week at a viewport of 1024px or more.
// On a phone it is 30–53px, and a TEN-day week tops out at 82.4px on any
// monitor. So the whole moon chain — three discs, the `.phrow.phctl` opener
// and the panel behind it — rendered into a hidden subtree for the operator's
// phone and for every in-world calendar with a long week, at every width.
// Measured before and after in moon_reach_probe_test.go.
//
// Three discs are ~35px wide and an event NAME is not, so the two do not
// belong behind one threshold; the sheet now gives the row its own, lower one.
// The row costs no layout in either subtree — it is absolutely positioned
// against the cell, exactly as `moonPick`'s radio is already a direct child
// for the same "findable whichever subtree is showing" reason.
// data-day-ord is the LADDER key beside data-day: the bare ordinal, because the
// generated ladder lives in one static sheet shared by every calendar and
// cannot know a slug. It is what lets a hovered cell light its Ledger row.
//
// --axis on the cell is the cell's DATUM HUE, taken from its first mark exactly
// as the sub-mini tick rule already takes it (tickDays). A partner without its
// own identity borrows the datum's — never --accent (canon A7). A cell with no
// marks carries none and the ANSWER wash falls back to the structural rule.
templ dayCell(d BlockData, row WeekRow, c DayCell) {
	<div
		class={ cellClass(c, d.Month.WeekLen) }
		if c.Day > 0 {
			data-cell
			data-day={ dayKey(d.CalendarSlug, c.Day) }
			data-day-ord={ dayOrdKey(c.Day) }
		}
		if cellStyle(d, row, c) != "" {
			style={ cellStyle(d, row, c) }
		}
		if c.Tied {
			data-tied
		}
	>
		if c.Day > 0 {
			@dayPick(d, dayOrdKey(c.Day), dayPickLabel("", c.Day), dayAnswers(c.Day))
			@moonPick(d, c)
			if hasLayer(d.Layers, "moons") {
				@moonRow(d, c)
			}
			<div class="cnamed">
				@dayNumeral(c, true)
				for _, m := range chipsFor(c) {
					@namedChip(m)
				}
				if moreCount(c) > 0 {
					<span class="more">{ "+" + intText(moreCount(c)) + " more" }</span>
				}
			</div>
			<div class="cunder">
				@dayNumeral(c, false)
				@underline(c)
			</div>
			@gmMarks(c)
			@availabilitySlot()
		}
	</div>
}

// availabilitySlot is the availability strip's box: BUILT, AND DORMANT UNTIL
// DATA ARRIVES (C-CALV4-TILES §8.4 / §8.9 / §9.5).
//
// The strip is a TIME AXIS FOR THE DAY, not a roster: its width is the day, a
// span's left edge says when a window opens and its right edge when it closes,
// one lane per player under one accent lane carrying the overlap. All of that
// is now in the stylesheet, complete, and NONE of it can paint — see below.
//
// WHAT IS EMITTED HERE IS THE BOX, AND ONLY THE BOX. The element is empty,
// `aria-hidden`, carries no owner hue and no data. What it does is hold
// `--avail-h` of the cell's bottom edge out of every other mark's reach: the
// underline cluster is anchored ABOVE it and the moon silhouette sits in the
// opposite corner, so when the wiring dispatch fills this box it changes one
// element's contents and relayouts nothing. Reserving it is the whole point —
// discovering the strip has nowhere to go is a relayout of the cell, which is
// a second pass over every geometric assertion in this package.
//
// IT IS DELIBERATELY NOT GATED ON DATA. A slot that appeared only for days with
// RSVPs would move the underline on some days and not others, which is the
// reflow the reservation exists to prevent.
//
// THE LANES ARE NOT EMITTED, AND THAT IS THE HONEST HALF OF "BUILT". `DayCell`
// carries no availability field and `block_projection.go` fetches none; the
// windows live in the sessions plugin's `availability_exceptions`, keyed to REAL
// dates, and §8.6's blocker stands — nothing maps a Harptos day to a real date,
// so on the operator's own calendar there is nothing to draw. A lane rendered
// anyway would be a fabricated figure on screen and this package does not draw
// those. Adding the field is a `data.go` change and therefore a stop-and-flag;
// it belongs to the wiring dispatch, with the fantasy-date anchor.
//
// THE SHAPE THAT DISPATCH MUST EMIT, so it is not re-derived from the CSS. The
// LANE is the track and the inner <i> is the window; --m0/--m1 ride the window,
// --who rides the lane:
//
//	<span class="avail" aria-hidden="true">
//	  <i class="lane all"><i style="--m0:41.6%;--m1:75%"></i></i>
//	  <i class="lane" style="--who:var(--own-nissa)"><i style="--m0:…;--m1:…"></i></i>
//	  …one per player, in declaration order…
//	</span>
//
// …and the CELL takes `rsvp` beside its other classes. `--m0`/`--m1` are
// PERCENTAGES OF THE DAY, the same contract /schedule's `.sc-off` already ships
// (calendar-schedule.css:895) — one span primitive in the product, not two, as
// C-CALV4-DRAG-RESCHEDULE.md:172 asks. The overlap lane takes `none` when nobody
// overlaps: the lane stays and its window goes, because a missing lane reads as
// "no data" and an empty one as "no window".
templ availabilitySlot() {
	<span class="avail" aria-hidden="true"></span>
}

// dayPick is one day's selection control: a visually-hidden radio plus the
// STRETCHED LABEL that is the day's real hit target.
//
// THE LABEL, NOT THE CELL. cv4:2775-2782 excludes the dogear and the "+n more"
// affordance from day selection, and a <label> wrapping the whole cell cannot
// express that exclusion — so the label is an absolutely-positioned sibling
// UNDER the cell's interactive children, and those two raise themselves above
// it. Absolute positioning also keeps the cell's fixed 84px height untouched:
// a control that changed the cell's height would break the no-motion rule the
// whole grid depends on.
//
// GATED ON THE LEDGER (ledgerDocked). A Block with no docked Ledger has nothing
// for a chosen day to repaint and no home for the `✕ all` option that
// deselects it; shipping the radios anyway would be a radio group with no way
// out of it.
//
// PAST THE LADDER'S BOUND `answers` is false and NOTHING is emitted — no
// radio, no label, no dead affordance (CTS-2). The Ledger still lists the day.
templ dayPick(d BlockData, key, label string, answers bool) {
	if answers && ledgerDocked(d) {
		<input
			type="radio"
			class="daypick"
			data-day-pick={ key }
			name={ dayPickGroupName(d) }
			id={ dayPickInputID(d, key) }
			aria-label={ label }
		/>
		<label class="dsel" for={ dayPickInputID(d, key) }>
			<span class="vh">{ label }</span>
		</label>
	}
}

// dayNumeral prints the day. TODAY is a non-accent ink stamp: the campaign
// accent is chrome-only and must never land on a data cell.
templ dayNumeral(c DayCell, named bool) {
	if named {
		<span class="dn">
			if c.IsToday {
				<span class="today">{ intText(c.Day) }</span>
			} else {
				{ intText(c.Day) }
			}
		</span>
	} else {
		<span class="dn dnw">
			if c.IsToday {
				<span class="today">{ intText(c.Day) }</span>
			} else {
				{ intText(c.Day) }
			}
		</span>
	}
}

// gmMarks are the notch and the diamond. Both are absent — not greyed, not
// ghosted — for a viewer who is not entitled to them, because the producer
// leaves AudienceMark nil and there is nothing here to render.
templ gmMarks(c DayCell) {
	if cellHasGMOnly(c) {
		<span class="dogear" title={ gmMarkTitle(c, false) } aria-hidden="true"></span>
	}
	if cellHasRestricted(c) {
		<span class="audmark" title={ gmMarkTitle(c, true) } aria-hidden="true"></span>
	}
}

// intercalaryRows are the days a 30-day / ten-day-week month has no cell for.
// Canonical Harptos carries festival days outside every tenday. Rendered at
// FULL TIER only, and overridden inline to grid-column:2/-1 so the row clears
// the week gutter instead of sitting under it.
templ intercalaryRows(d BlockData) {
	for _, ic := range d.Month.Intercalary {
		<div class="interc-row">
			<span class="gut"></span>
			<div
				class="interc"
				style="grid-column:2/-1"
				data-day={ intercalaryKey(d.CalendarSlug, ic.Day) }
				data-day-ord={ intercalaryOrdKey(ic.Day) }
			>
				@dayPick(d, intercalaryOrdKey(ic.Day), dayPickLabel(ic.Name, ic.Day), intercalaryAnswers(ic.Day))
				<span class="icd">{ intText(ic.Day) }</span>
				<span class="cap">{ ic.Name }</span>
				for _, m := range ic.Marks {
					@namedChip(m)
				}
				// A FESTIVAL DAY IS A DAY, so it reserves the same slot. Canonical
				// Harptos carries these outside every tenday and people are
				// available or not on them exactly as on any other date — an
				// intercalary row that step three could not paint would be a hole
				// in the availability surface at precisely the days a group is
				// most likely to be planning around.
				@availabilitySlot()
			</div>
		</div>
	}
}

// tickStrip is the sub-mini tier's whole instrument. Below 240px of host the
// grid is DROPPED honestly rather than squeezed: ten columns in 204px of content
// is four characters a column, and a month rule still answers "when is anything
// happening".
templ tickStrip(d BlockData) {
	<div class="tickstrip">
		<div class="tick">
			for _, t := range tickDays(d) {
				<i
					class={ tickClass(t) }
					data-day={ dayKey(d.CalendarSlug, t.Day) }
					if t.HasMark {
						style={ axisStyle(t.Axis) }
					}
				></i>
			}
		</div>
	</div>
}
