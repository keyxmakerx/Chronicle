// block.templ — the Block itself: one component, four zones, one stylesheet.
//
// SIZE CLASS COMES FROM THE HOST, DENSITY FROM THE MEASURED COLUMN, AND BOTH ARE
// CSS. There is no JS in this package and there cannot be: boot.js:163 sets
// `htmx.config.allowScriptTags = false`, so a <script> inside an HTMX-swapped
// fragment never executes and a JS-sized Block would silently render at the
// wrong density after any swap. The .cal-block-host wrapper is the query
// container for size class; each .cell is the query container for density.
//
// The wrapper also means the Block sizes itself when it is dropped anywhere a
// widget can mount, before W-C's BlockHost exists. Nesting another inline-size
// container above it is harmless — the innermost named container wins, and the
// innermost one is this.

package calendar_block

import "github.com/keyxmakerx/chronicle/internal/templates/layouts"

// Block renders one calendar Block from a fully-resolved BlockData. It performs
// no queries and reads no request state.
//
// THE LAYER REGISTRY GATES EVERY LAYER-OWNED SURFACE. The Ledger and Shelf
// zones are two of the eight LayerState keys (data.go), so they render only
// when their key is enabled — under wave 1's DEF (["moons"]) neither does,
// because the default surface is a month with its moon phases and nothing
// else. The Hidden flags are the HOST's removal (the Bench's real-world Block
// renders with noShelf) and the layer key is the VIEWER's; the zone renders
// only when both agree. The stubs' "docked at its real width" contract
// describes what the zone is WHEN it renders, not a licence to render it past
// the registry.
templ Block(d BlockData) {
	<div class="cal-block-host" data-cal-block>
		@Stylesheet()
		<div
			class="block"
			style={ blockStyle(d) }
			data-cal-slug={ d.CalendarSlug }
			if tieMode(d.Viewer) != "" {
				data-tie-mode={ tieMode(d.Viewer) }
			}
			if d.IsRealWorld {
				data-real-world
			}
		>
			@nameplate(d)
			// THE SKY HEADER SEATS HERE — inside the Block's own box, between
			// the nameplate and the month, exactly where the signed stills draw
			// it and where the operator seated it on 2026-08-07 ([SKY-2]).
			//
			// IT IS NOT THE PLACEHOLDER'S SEAT WITH A NEW TENANT. The dashed
			// `.skyband` that used to sit on this line rendered on the
			// REAL-WORLD Block, whose Almanac is empty for two independent
			// reasons — the register's build gate names the Shelf and that
			// Block renders noShelf, and the service's real-life create path
			// seeds no moons, no seasons and no eras — so a sky there would
			// have carried a gradient and a clock and nothing else, forever.
			// The gate is the PRODUCER's answer now ([SKY-1]): one sky per
			// surface, on the Bench's Primary Block, and where there is none
			// the Block says nothing about it.
			if skySeated(d) {
				@skyHeader(d)
			}
			<div class="body">
				// THE SWITCHBOARD'S ANCHOR IS THE MONTH, NOT THE ⋯ BUTTON, and
				// that is a SCREENSHOT FINDING rather than a preference. The ⋯
				// sits at the far right of the Nameplate, directly ABOVE the
				// docked Ledger column, so a sheet opening down-and-left from it
				// lands squarely on the Ledger — including the Ledger's own
				// "Event list" row, which is the control hiding its own target.
				// [LYR-2]'s binding clause is "over the month, never over the
				// Ledger column"; anchoring to the instrument satisfies it by
				// construction at every tier, and at std (where there is no
				// Ledger) it changes nothing.
				<div class="inst" style={ layerAnchorStyle(d) }>
					@instrument(d)
					// THE BELOW-MONTH SECTIONS SCROLL; THE MONTH NEVER DOES.
					// A §15 screenshot finding: with legend + moongraph +
					// horizon all switched on, the sections pushed .inst past
					// the Block's 520px ceiling at 420px and 358px, and the
					// docked Ledger's head and the Shelf's strip drew over one
					// another. CTS-8's precedent is that the answer is taken
					// inside the Block's own std geometry and THE ZONE THAT CAN
					// YIELD YIELDS — with no layer key dropped, because the
					// viewer asked for the key. This wrapper is that zone: the
					// grid keeps its intrinsic height, these sections scroll
					// inside whatever the month leaves, and the Ledger and Shelf
					// keep their strips intact.
					<div class="belowzones">
						@belowMonthLayers(d)
					</div>
				</div>
				if ledgerDocked(d) {
					<div class="layer-col">
						@ledger(d)
					</div>
				}
			</div>
			<div class="minirail" aria-hidden="true"></div>
			if shelfDocked(d) {
				@shelf(d)
			}
			@blockFoot(d)
		</div>
		// The switchboard, a SIBLING of .block and still inside
		// .cal-block-host. That placement is load-bearing three ways:
		// `.block { overflow: hidden }` plus the host's inline-size container
		// would clip an absolutely-positioned box inside the Nameplate; every
		// CSS test requires the scoping root; and the `.layer.is-target` hover
		// preview needs one common ancestor it can :has() from, because a
		// popover in the top layer cannot be reached from inside itself.
		@layerSheet(d)
	</div>
}

// Stylesheet links the Block's unlayered, self-contained sheet. Emitted inside
// the component so an HTMX-swapped fragment carries its own styling — a
// fragment cannot add to <head>, and a duplicate <link> to an identical URL
// costs one deduplicated request. Hosts that would rather put it in <head> can
// call this component there as well.
templ Stylesheet() {
	<link rel="stylesheet" href={ layouts.AssetURL(StylesheetPath) }/>
}

// ── THE SKY HEADER ──────────────────────────────────────────────────────────
//
// C-CALV4-SKY (R2-5). It replaces the ONE dashed idiom in the product — the
// `.skyband` "Skybox — parked" strip, DELETED here and not relocated ([SKY-11])
// — and it is a REDESIGN rather than a restoration: nothing is inherited from
// the ~6,400-line V2 sky engine ([SKY-13]), and the whole surface renders from
// server markup, custom properties and a native <details>. No canvas, no
// requestAnimationFrame loop, no particle system, and NO JAVASCRIPT — which is
// not a preference but this package's law (boot.js:163 sets
// `htmx.config.allowScriptTags = false`, so a <script> in an HTMX-swapped
// fragment is deleted).
//
// A REAL DISCLOSURE, NEVER `aria-hidden` ([SKY-16]). <details>/<summary> gives
// native semantics, native keyboard operation and `aria-expanded` for free —
// the same argument the Bench's own disclosures already make — and there is no
// hand-rolled role="button" and no tabindex. The thing it replaces was
// `aria-hidden="true"` with no accessible name, which is right for a dashed
// placeholder and wrong for a header carrying the in-world time, the season and
// the moon phases.
//
// THREE FACTS AND NO FOURTH ([SKY-6]): the moon phase disc(s), the in-world
// time, and the season word — each DROPPED ENTIRELY rather than blanked when
// its source is absent, on the Nameplate's own blockSeasonEraLabels idiom.
// There is no sunrise and no sunset here in any form: not a tick, not a chip,
// not a "needs backend" note, not a 06:00/18:00 default.
//
// COMPACT IS THE RESTING STATE. The header is NOT a fifth Bench section
// ([SKY-10]): it takes no row in the section store, no toggle route and no
// migration, and it defaults CLOSED at every width for every viewer and
// remembers nothing.
templ skyHeader(d BlockData) {
	{{ anchor := almanacAnchorDay(d) }}
	<details class="skygrow" data-cal-sky style={ skyStyle(d) }>
		<summary class="skyhdr" aria-label={ skyLabel(d) }>
			if skyDiscsReachable(d) {
				<span class="skdiscs">
					for _, m := range d.Month.Almanac {
						{{ a, ok := almanacDayAt(m, anchor) }}
						if ok {
							<span class="skb">
								<i
									class={ skyDiscClass(a) }
									style={ skyDiscStyle(a) }
									title={ skyDiscTitle(m, a) }
								></i>
							</span>
						}
					}
				</span>
			}
			// THE SPACER SITS AHEAD OF THE TIME, and that is a measured
			// position rather than a tidy one: with the time left-packed
			// behind a growing disc cluster the clock slid 65px sideways on
			// every open and close — travel that is invisible to a walk of
			// `transition-property`, which is why the mock's own round 3
			// caught it with a probe and moved the spacer.
			<span class="sksp"></span>
			if d.SkyClock != "" {
				<span class="sktime">{ d.SkyClock }</span>
			}
			if d.SeasonLabel != "" {
				<span class="skseason">{ d.SeasonLabel }</span>
			}
			<span class="skcaret" aria-hidden="true"></span>
		</summary>
		<div class="skpane">
			<div class="skpane-in">
				<div class="skpane-pad">
					<div class="skhead">{ skyHeadLine(d, anchor) }</div>
					if sub := skySubHead(d, anchor); sub != "" {
						<div class="skynote">{ sub }</div>
					}
					if skyDiscsReachable(d) {
						@skyTabs(d)
						<div class="skbody">
							@skyTonight(d, anchor)
							@skyMonth(d)
							@skyMoons(d)
						</div>
					}
				</div>
			</div>
		</div>
	</details>
}

// skyTabs is the Tonight | Month | Moons trio — count 3's whole answer, and
// EXACTLY THREE CONTROLS ([SKY-9]).
//
// THE MECHANISM IS THE ONE THE ALMANAC AND THE SHELF BOTH PROVE: one radio
// group, visually-hidden inputs with `for`-labels, no JS and no travelling
// indicator — the pressed look is state ON the pressed item. It is chosen for
// the reason shelf.templ states in the code's own words: there is no JS in this
// package and no route to fetch a panel with.
//
// THE DISCLOSURE AFFORDANCE DOES NOT COUNT AGAINST THE THREE, because the band
// IS the summary. And nothing else ships: no `Sync now` (the Nameplate already
// carries the sync pill, and a second sync control on one Block is count 3
// repeating itself), no moon-style picker, no weather, no mood tint, no time
// verbs, no per-moon toggles. The switchboard already owns preferences.
templ skyTabs(d BlockData) {
	<div class="sktabs" role="radiogroup" aria-label="Almanac view">
		@skyTab(d, almTabTonight, "Tonight")
		@skyTab(d, almTabMonth, "Month")
		@skyTab(d, almTabMoons, "Moons")
	</div>
}

templ skyTab(d BlockData, key string, label string) {
	<input
		type="radio"
		class="skypick"
		data-cal-sky-pick={ key }
		name={ skyPickGroupName(d) }
		id={ skyPickInputID(d, key) }
		checked?={ key == almTabTonight }
	/>
	<label class="skybtn" for={ skyPickInputID(d, key) }>{ label }</label>
}

// skyTonight is the default panel: one row per declared body, written for the
// anchored day. Every number is the producer's; nothing here is derived.
//
// FOUR ALIGNED COLUMNS, WHICH IS WHAT THE SIGNED STILLS SHOW: name, phase word,
// illumination right-aligned, next turn muted at the far right. The first pass
// shipped a two-item flex carrying r53's merged register sentence instead — an
// undisclosed divergence from a signed still, fixed forward here.
//
// THE `.skynote` MOVED RATHER THAN MULTIPLIED. `almanacLitLine`'s >25%-lit
// summary used to close this panel; the stills have no such line here, and the
// three percentage columns now state the same numbers explicitly rather than
// summarising them behind a threshold. The class keeps its seat in the pane —
// it now carries `skySubHead` directly under the head, where the stills put it.
// The Shelf's Almanac panel still renders `almanacLitLine`, untouched.
templ skyTonight(d BlockData, anchor int) {
	<div class="skypane-t sky-tonight" data-cal-sky-panel="tonight">
		for _, m := range d.Month.Almanac {
			<div class="skyrow">
				<span class="nm">{ m.Name }</span>
				<span class="ph">{ almanacRowPhase(m, anchor) }</span>
				<span class="il">{ almanacRowIllum(m, anchor) }</span>
				<span class="nx">{ almanacRowNext(m, anchor) }</span>
			</div>
		}
	</div>
}

// skyMonth is the lane grid — one lane per moon, one column per day of the
// month, at the month's REAL day count and never a hardcoded thirty.
//
// EVERY CELL CARRIES data-day in the dayKey namespace, because a dated surface
// inside a calendar_block template is an ANSWER partner of the grid and the
// Ledger (guard B4), and because the retarget this panel does not yet do is one
// ladder extension away for whichever slice pays for it.
templ skyMonth(d BlockData) {
	<div class="skypane-t sky-month" data-cal-sky-panel="month">
		<div class="skylanes" style={ almanacWrapStyle(d) }>
			for _, m := range d.Month.Almanac {
				<div class="skylane">
					<span class="who">{ m.Name }</span>
					for _, a := range m.Days {
						<span
							class="c"
							data-day={ dayKey(d.CalendarSlug, a.Day) }
							data-axis="var(--text-primary)"
							title={ almanacCellTitle(m, a) }
						>
							<i class="almlit" style={ almanacLitStyle(a) }></i>
							if a.Turn != "" {
								<i class={ almanacTurnClass(a) } aria-hidden="true"></i>
							}
						</span>
					}
				</div>
			}
		</div>
		<div class="skynote">{ almanacNote(d) }</div>
	</div>
}

// skyMoons is the register proper, and its footnote is a promise the producer
// keeps literally: every number is computed from the calendar's real geometry.
templ skyMoons(d BlockData) {
	<div class="skypane-t sky-moons" data-cal-sky-panel="moons">
		for _, m := range d.Month.Almanac {
			<div class="skyrow">
				<span class="nm">{ m.Name }</span>
				<span class="ln">{ almanacMoonsLine(m) }</span>
			</div>
		}
		<div class="skynote">
			the arithmetic is printed so it can be audited — no date in the register was typed by hand
		</div>
	</div>
}

// belowMonthLayers holds the sections that open BELOW the month. Wave 1 renders
// each as its correctly-placed zone carrying the signed `needs backend` chip
// rather than fabricating content it cannot derive:
//
// EVERY `needs backend` CHIP HERE IS ROLE-GATED as of C-CALV4-LAYERS-P9. The
// rule is not per-zone: `needs backend` is GM-FACING HONESTY COPY and never
// renders to a player, full stop. It was a passive rule while no player could
// enable any of these keys; the switchboard makes it an active gate. The two
// zones this slice FILLS lose the gate when they stop being chips — real
// content is for everybody, subject to the viewer filter that already governs
// it.
//
//   - legend    FILLED by C-CALV4-LAYERS-P9. The blocker was real and is
//     gone: r52 added Mark.AxisLabel for the Ledger's meta line and
//     said in terms that it "incidentally unblocks W-F's legend".
//     Its chip retired the way the wave-1 chips were designed to —
//     the data arrived, so the zone renders content. TYPE AXIS ONLY:
//     there is still no Mark.OwnerLabel (r52 §5 refused it, CTS-5
//     SIGNED) and no per-calendar label, so the picker's other two
//     options are booked to C-CALV4-AXIS-P11 rather than stubbed.
//     Being GM-gated ended with the chip: real content is for
//     everybody, under the viewer filter that already produced it.
//   - horizon   ruling 1: there is no queryable fog horizon on main. DayCell
//     .Fogged stays false and this renders the chip the operator signed.
//
//     ITS CHIP IS NOW ROLE-GATED, AND THAT IS AN OBLIGATION W-F CREATED
//     (C-CALV4-LAYERS-P9 §8.4). The chip rendered unconditionally for three
//     waves and was safe only because NO PLAYER COULD ENABLE THE KEY: DEF is
//     moons-only and neither host seed carries `horizon`. The switchboard
//     makes every key reachable by every viewer, so the moment it goes live a
//     player can turn `horizon` on — and `needs backend` never renders to a
//     player (decisions/2026-07-27-needs-backend-audience.md: "For a player
//     the zone simply does not appear"). A player who toggles it gets nothing:
//     no zone, no greyed panel, no explanatory note. The row itself stays in
//     the sheet ([LYR-6a]) because a layer is a display preference, not a
//     promise of content — the same way a calendar with no eras gives an
//     empty `eras` row.
//
//     THE DISTINCTION TO KEEP LEGIBLE, because this is the first surface where
//     one control produces both: permission-is-absence hides data that EXISTS
//     from a viewer not entitled to it; the needs-backend omission hides data
//     that exists FOR NOBODY. Identical in the DOM, different rules.
//   - moongraph FILLED by C-CALV4-LAYERS-P9, and with NO new pin field: r53's
//     MonthGeometry.Almanac closed the data dependency completely on
//     its way past for the wave-2 Shelf. One lane per DRAWN body — no
//     composite, ever (L19/L24) — and the ceiling stays declared once,
//     in the Nameplate (L30). The foot's "+N more in the almanac"
//     names a destination rather than a ceiling, and the destination
//     is real because the register is uncapped by MoonCap.
templ belowMonthLayers(d BlockData) {
	if hasLayer(d.Layers, "legend") {
		@legendZone(d)
	}
	if hasLayer(d.Layers, "horizon") && d.Viewer.IsGM {
		<div class="layer needzone" data-layer="horizon">
			<span class="cap">Knowledge horizon</span>
			<span class="badge need">needs backend</span>
		</div>
	}
	if hasLayer(d.Layers, "moongraph") {
		@moongraphZone(d)
	}
}

// blockFoot is the mini / sub-mini foot line — and it is the LEDGER'S SMALLEST
// FORM, not a separate surface. Below 300px of host the docked zone is
// display:none and this line is all that is left of it.
//
// It states a count it can actually derive from the marks in front of it; the
// mockup's "next: <event>" is not in BlockData, so it is not printed rather
// than guessed. Which count it states is blockFootCount's business, and the
// answer is not always the month's — see there.
templ blockFoot(d BlockData) {
	<div class="foot">
		<span>{ d.Month.Name }</span>
		<span class="dotsep">·</span>
		<span>{ blockFootCount(d) }</span>
	</div>
}
