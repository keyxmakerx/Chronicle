// block.templ — the Block itself: one component, four zones, one stylesheet.
//
// SIZE CLASS COMES FROM THE HOST, DENSITY FROM THE MEASURED COLUMN, AND BOTH ARE
// CSS. There is no JS in this package and there cannot be: boot.js:163 sets
// `htmx.config.allowScriptTags = false`, so a <script> inside an HTMX-swapped
// fragment never executes and a JS-sized Block would silently render at the
// wrong density after any swap. The .cal-block-host wrapper is the query
// container for size class; each .cell is the query container for density.
//
// The wrapper also means the Block sizes itself when it is dropped anywhere a
// widget can mount, before W-C's BlockHost exists. Nesting another inline-size
// container above it is harmless — the innermost named container wins, and the
// innermost one is this.

package calendar_block

import "github.com/keyxmakerx/chronicle/internal/templates/layouts"

// Block renders one calendar Block from a fully-resolved BlockData. It performs
// no queries and reads no request state.
//
// THE LAYER REGISTRY GATES EVERY LAYER-OWNED SURFACE. The Ledger and Shelf
// zones are two of the eight LayerState keys (data.go), so they render only
// when their key is enabled — under wave 1's DEF (["moons"]) neither does,
// because the default surface is a month with its moon phases and nothing
// else. The Hidden flags are the HOST's removal (the Bench's real-world Block
// renders with noShelf) and the layer key is the VIEWER's; the zone renders
// only when both agree. The stubs' "docked at its real width" contract
// describes what the zone is WHEN it renders, not a licence to render it past
// the registry.
templ Block(d BlockData) {
	<div class="cal-block-host" data-cal-block>
		@Stylesheet()
		<div
			class="block"
			style={ blockStyle(d) }
			data-cal-slug={ d.CalendarSlug }
			if tieMode(d.Viewer) != "" {
				data-tie-mode={ tieMode(d.Viewer) }
			}
			if d.IsRealWorld {
				data-real-world
			}
		>
			@nameplate(d)
			if d.IsRealWorld {
				@skybandPlaceholder()
			}
			<div class="body">
				<div class="inst">
					@instrument(d)
					@belowMonthLayers(d)
				</div>
				if ledgerDocked(d) {
					<div class="layer-col">
						@ledger(d)
					</div>
				}
			</div>
			<div class="minirail" aria-hidden="true"></div>
			if shelfDocked(d) {
				@shelf(d)
			}
			@blockFoot(d)
		</div>
		// The switchboard, a SIBLING of .block and still inside
		// .cal-block-host. That placement is load-bearing three ways:
		// `.block { overflow: hidden }` plus the host's inline-size container
		// would clip an absolutely-positioned box inside the Nameplate; every
		// CSS test requires the scoping root; and the `.layer.is-target` hover
		// preview needs one common ancestor it can :has() from, because a
		// popover in the top layer cannot be reached from inside itself.
		@layerSheet(d)
	</div>
}

// Stylesheet links the Block's unlayered, self-contained sheet. Emitted inside
// the component so an HTMX-swapped fragment carries its own styling — a
// fragment cannot add to <head>, and a duplicate <link> to an identical URL
// costs one deduplicated request. Hosts that would rather put it in <head> can
// call this component there as well.
templ Stylesheet() {
	<link rel="stylesheet" href={ layouts.AssetURL(StylesheetPath) }/>
}

// skybandPlaceholder is the ONE dashed idiom in the entire product: "not built
// yet". It reserves the pictorial night sky on real-world Blocks, which is
// PARKED (L12, D4) and shares nothing with the moon-phase data above it.
templ skybandPlaceholder() {
	<div class="skyband" aria-hidden="true">
		<span class="a">Skybox — parked</span>
		<span class="b">the pictorial night sky lands here · parked on usage grounds · unrelated to the moon-phase data above</span>
	</div>
}

// belowMonthLayers holds the sections that open BELOW the month. Wave 1 renders
// each as its correctly-placed zone carrying the signed `needs backend` chip
// rather than fabricating content it cannot derive:
//
// EVERY `needs backend` CHIP HERE IS ROLE-GATED as of C-CALV4-LAYERS-P9. The
// rule is not per-zone: `needs backend` is GM-FACING HONESTY COPY and never
// renders to a player, full stop. It was a passive rule while no player could
// enable any of these keys; the switchboard makes it an active gate. The two
// zones this slice FILLS lose the gate when they stop being chips — real
// content is for everybody, subject to the viewer filter that already governs
// it.
//
//   - legend    FILLED by C-CALV4-LAYERS-P9. The blocker was real and is
//     gone: r52 added Mark.AxisLabel for the Ledger's meta line and
//     said in terms that it "incidentally unblocks W-F's legend".
//     Its chip retired the way the wave-1 chips were designed to —
//     the data arrived, so the zone renders content. TYPE AXIS ONLY:
//     there is still no Mark.OwnerLabel (r52 §5 refused it, CTS-5
//     SIGNED) and no per-calendar label, so the picker's other two
//     options are booked to C-CALV4-AXIS-P11 rather than stubbed.
//     Being GM-gated ended with the chip: real content is for
//     everybody, under the viewer filter that already produced it.
//   - horizon   ruling 1: there is no queryable fog horizon on main. DayCell
//     .Fogged stays false and this renders the chip the operator signed.
//
//     ITS CHIP IS NOW ROLE-GATED, AND THAT IS AN OBLIGATION W-F CREATED
//     (C-CALV4-LAYERS-P9 §8.4). The chip rendered unconditionally for three
//     waves and was safe only because NO PLAYER COULD ENABLE THE KEY: DEF is
//     moons-only and neither host seed carries `horizon`. The switchboard
//     makes every key reachable by every viewer, so the moment it goes live a
//     player can turn `horizon` on — and `needs backend` never renders to a
//     player (decisions/2026-07-27-needs-backend-audience.md: "For a player
//     the zone simply does not appear"). A player who toggles it gets nothing:
//     no zone, no greyed panel, no explanatory note. The row itself stays in
//     the sheet ([LYR-6a]) because a layer is a display preference, not a
//     promise of content — the same way a calendar with no eras gives an
//     empty `eras` row.
//
//     THE DISTINCTION TO KEEP LEGIBLE, because this is the first surface where
//     one control produces both: permission-is-absence hides data that EXISTS
//     from a viewer not entitled to it; the needs-backend omission hides data
//     that exists FOR NOBODY. Identical in the DOM, different rules.
//   - moongraph FILLED by C-CALV4-LAYERS-P9, and with NO new pin field: r53's
//     MonthGeometry.Almanac closed the data dependency completely on
//     its way past for the wave-2 Shelf. One lane per DRAWN body — no
//     composite, ever (L19/L24) — and the ceiling stays declared once,
//     in the Nameplate (L30). The foot's "+N more in the almanac"
//     names a destination rather than a ceiling, and the destination
//     is real because the register is uncapped by MoonCap.
templ belowMonthLayers(d BlockData) {
	if hasLayer(d.Layers, "legend") {
		@legendZone(d)
	}
	if hasLayer(d.Layers, "horizon") && d.Viewer.IsGM {
		<div class="layer needzone" data-layer="horizon">
			<span class="cap">Knowledge horizon</span>
			<span class="badge need">needs backend</span>
		</div>
	}
	if hasLayer(d.Layers, "moongraph") {
		@moongraphZone(d)
	}
}

// blockFoot is the mini / sub-mini foot line — and it is the LEDGER'S SMALLEST
// FORM, not a separate surface. Below 300px of host the docked zone is
// display:none and this line is all that is left of it.
//
// It states a count it can actually derive from the marks in front of it; the
// mockup's "next: <event>" is not in BlockData, so it is not printed rather
// than guessed. Which count it states is blockFootCount's business, and the
// answer is not always the month's — see there.
templ blockFoot(d BlockData) {
	<div class="foot">
		<span>{ d.Month.Name }</span>
		<span class="dotsep">·</span>
		<span>{ blockFootCount(d) }</span>
	</div>
}
