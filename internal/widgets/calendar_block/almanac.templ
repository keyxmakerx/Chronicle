// almanac.templ — Zone D's third panel, and this slice's gate.
//
// THE ALMANAC IS WHERE THE OVERFLOW GOES. L21 caps the month grid at three
// moons so "the grid can never grow with the fiction", and that ceiling is
// legitimate ONLY because of the second half of the same law (design notes
// :667): "the Almanac carries every declared body at full width". Wave 1
// shipped the ceiling and the badge that announces it. Until this panel
// existed, a builder who configured a fourth moon had it silently drop out of
// the product.
//
// EVERY SUB-PANEL ITERATES MonthGeometry.Almanac — the producer's UNCAPPED
// register ([S5], SIGNED) — and never DayCell.Moons, which is capped at moonCap
// and physically cannot carry the overflow body.
//
// IT IS A READOUT, NOT A PICTURE. Timepiece, skybox and skypane are PARKED
// (L12/D4): the Shelf must not grow a pictorial sky. The vetoed
// composite-brightness ribbon was RELOCATED into the Month lane rather than
// resurrected (design notes :594-598) — a magnitude as an explicit readout,
// never a glanceable claim (L19/L24), which is why every bar has a percentage
// behind it in its own title.
//
// THREE SUB-TABS, ONE RADIO GROUP, ZERO JAVASCRIPT ([S7], SIGNED). The mockup
// keys them on `?alm=tonight|month|moons`; a bound Block renders under
// context.Background() and can read no request state, so the param is
// unreachable and per-viewer persistence is W-F's store. `data-alm-pick`, never
// `data-moonstyle` — guard B3.
//
// NO EPITHET ([S6], SIGNED). calendar.Moon has no such column; the mockup's
// "the great pale moon" is fixture text. Stated as an omission rather than
// invented, per the wave-1 precedent (the fog horizon, composed audiences, the
// era-relative fault text).

package calendar_block

// almanacPanel is the Almanac's whole body: three sub-panels, all rendered, one
// revealed by the stylesheet.
templ almanacPanel(d BlockData) {
	{{ anchor := almanacAnchorDay(d) }}
	<div class="spane spane-almanac" data-spane="almanac">
		@almanacTonight(d, anchor)
		@almanacMonth(d)
		@almanacMoons(d)
	</div>
}

// almanacSubTabs is the Tonight | Month | Moons control.
//
// `.seg` IS A SHARED SIGNED PRIMITIVE (WG spec :824) and this consumes it
// rather than redefining it — and it is NEVER position:absolute (WG spec V1
// records a direction that detached every segmented control on every calendar
// surface).
//
// It lives in the Shelf's STRIP, beside the tabs, because that is where the
// signed render puts it — and the stylesheet hides it unless the Almanac tab is
// the pressed one, because a segmented control for a panel nobody is looking at
// is two controls doing one job. That is L29's own argument, applied one scale
// down.
templ almanacSubTabs(d BlockData) {
	<span class="seg alm" role="group" aria-label="Almanac view">
		@almanacSubTab(d, almTabTonight, "Tonight")
		@almanacSubTab(d, almTabMonth, "Month")
		@almanacSubTab(d, almTabMoons, "Moons")
	</span>
}

// almanacSubTab is one sub-tab: a visually-hidden radio and its label, the same
// mechanism the tie toggle proved. Tonight is the signed default
// (`Q.get('alm') || 'tonight'`, cv4:2073).
templ almanacSubTab(d BlockData, key string, label string) {
	<input
		type="radio"
		class="almpick"
		data-alm-pick={ key }
		name={ almPickGroupName(d) }
		id={ almPickInputID(d, key) }
		checked?={ key == almTabTonight }
	/>
	<label class="almbtn" for={ almPickInputID(d, key) }>{ label }</label>
}

// almanacTonight is the default sub-panel: a definition list keyed to the
// answered day.
//
// THE ANCHOR IS THE SERVER-RENDERED DAY, not the CSS selection — the one
// substantive divergence from v4-block-full-selected.png, taken deliberately
// and reasoned in full on almanacAnchorDay. The Month lane below still carries
// data-day on every cell, so the retarget is one ladder extension away for
// whichever slice pays for it.
templ almanacTonight(d BlockData, anchor int) {
	<div class="alm alm-pane alm-tonight" data-alm="tonight">
		<dl class="kv">
			<dt>Sky</dt>
			<dd>{ almanacSkyLine(d) }</dd>
			for _, m := range d.Month.Almanac {
				<dt>{ m.Name }</dt>
				<dd>{ almanacMoonLine(m, anchor) }</dd>
			}
			<dt>{ "Day " }{ intText(anchor) }</dt>
			<dd>{ almanacLitLine(d, anchor) }</dd>
		</dl>
	</div>
}

// almanacMonth is the lane grid: ONE LANE PER MOON, ONE COLUMN PER DAY OF THE
// MONTH.
//
// THIS IS THE SHAPE THAT CANNOT FIT ON A MONTH GRID, and that is the whole
// argument for the ceiling — the footnote says so in the signed words, with the
// mockup's literal "thirty columns" replaced by the month's real day count.
//
// EVERY CELL CARRIES data-day (guard B4) in the dayKey namespace and
// data-axis="var(--text-primary)": a partner without its own identity borrows
// the DATUM's hue and NEVER --accent (canon A7, cv4:2720-2721). Nothing in this
// panel moves when a day is answered — canon A5 permits background-colour and
// ink hue only.
//
// THE NODE-WINDOW BRACKET (.abr) IS NOT DRAWN. calendar.Moon has no orbital
// node column — the mockup's nodeWindow() keys on a hardcoded `node:true` on
// its second fixture moon — so AlmanacDay.Node is false everywhere and the
// bracket would be an interval with nothing behind it. Same class as the fog
// horizon and MoonDisc.Eclipse: the field exists so a later slice need not
// re-touch every day, and the mark stays absent until it does.
templ almanacMonth(d BlockData) {
	<div class="alm almgrid alm-pane alm-month" data-alm="month">
		<div class="almwrap" style={ almanacWrapStyle(d) }>
			<div class="almhead">
				<b>Moon</b>
				for day := 1; day <= d.Month.Days; day++ {
					<b>{ almanacHeadLabel(day) }</b>
				}
			</div>
			for _, m := range d.Month.Almanac {
				<div class="alane">
					<span class={ almanacLaneClass(m) }>{ m.Name }</span>
					for _, a := range m.Days {
						<span
							class="c"
							data-day={ dayKey(d.CalendarSlug, a.Day) }
							data-axis="var(--text-primary)"
							title={ almanacCellTitle(m, a) }
						>
							<i class="almlit" style={ almanacLitStyle(a) }></i>
							if a.Turn != "" {
								<i class={ almanacTurnClass(a) } aria-hidden="true"></i>
							}
						</span>
					}
				</div>
			}
			<div class="almnote">{ almanacNote(d) }</div>
		</div>
	</div>
}

// almanacMoons is the register proper, and its footnote is a promise this file
// has to keep literally (cv4:2104-2105):
//
//	the arithmetic is printed so it can be audited — no date in the register
//	was typed by hand
//
// So every number here is computed from the calendar's real geometry and none
// is a constant: the period is the declared cycle, the turn count is counted
// over the month's real length, and the drift is that length against the cycle
// — the mockup's `30 % mo.period` with the thirty removed.
templ almanacMoons(d BlockData) {
	<div class="alm alm-pane alm-moons" data-alm="moons">
		<dl class="kv">
			for _, m := range d.Month.Almanac {
				<dt>{ m.Name }</dt>
				<dd>{ almanacMoonsLine(m) }</dd>
			}
		</dl>
		<div class="almnote">
			the arithmetic is printed so it can be audited — no date in the register was typed by hand
		</div>
	</div>
}
