// nameplate.templ — Zone A.
//
// ONE nameplate, restyled per size class by container query. The mockup builds
// three different nameplates in JS (full / std / mini+submini); shipping three
// DOM variants would mean the same fact rendered three times and a fourth place
// for them to drift apart. Everything here is emitted once and the stylesheet
// hides what a tier cannot afford — which is also the only way the sync pill's
// two strings can both be present for a container query to choose between.
//
// WHAT IS DELIBERATELY NOT HERE, and why (flagged for the coordinator):
//
//   - the "colour by: type|owner|calendar" segmented control. It is a per-viewer
//     PREFERENCE and BlockData carries no field for the current axis — Mark.Axis
//     is already resolved by the producer. Rendering it would mean fabricating a
//     pressed state. Same class as HasSwitchboard, same slice: W-F.
//   - (the "3 hidden" hidden-event-count badge moved OFF this list at
//     C-CALV4-LEDGER-P6: r52 added ViewerContext.HiddenCount and the badge
//     renders below — see hiddenBadgeText. Its "3 of 4 moons" sibling moved off
//     at C-CALV4-SEAM-P5 stage 15 the same way. Both were absent because the
//     pinned struct had nowhere to put the number, not because either was
//     rejected.)
//   - the campaign clock on real-world Blocks. There is no time field; the
//     viewer's zone IS rendered, because ViewerContext.Zone exists and L15 says
//     every real-world time is labelled with it.

package calendar_block

// nameplate renders Zone A.
templ nameplate(d BlockData) {
	<div class="np">
		<span class={ "dot " + patternClass(d.Pattern) } aria-hidden="true"></span>
		if d.Letter != "" {
			<span class="callet" aria-hidden="true">{ calLetter(d.Letter) }</span>
		}
		<span class="nm" title={ d.Name }>{ d.Name }</span>
		@dateLine(d)
		if eraBadgeText(d) != "" {
			<span class="badge need mono era">{ eraBadgeText(d) }</span>
		}
		if d.SeasonLabel != "" {
			<span class="sub season">{ d.SeasonLabel }</span>
		}
		if moonsBadgeText(d) != "" {
			<span class="badge need moons" title={ moonsBadgeTitle(d) }>{ moonsBadgeText(d) }</span>
		}
		if hiddenBadgeText(d) != "" {
			<span class="badge gm" title="events on this month that players cannot see">{ hiddenBadgeText(d) }</span>
		}
		@syncPill(d.Sync)
		if d.IsRealWorld && d.Viewer.Zone != "" {
			<span class="badge tz" title="your zone">{ d.Viewer.Zone }</span>
		}
		<span class="sp"></span>
		@tieCounts(d)
		@layersInvoker(d.Layers)
	</div>
}

// dateLine is the Block's single most load-bearing honesty state.
//
// When Fault is non-empty the Block prints THE FAULT WHERE THE DATE WOULD GO and
// emits NO DATE ELEMENT AT ALL — not a zero, not an em dash, not a placeholder.
// (Signed: the Dwarven .calrow.warnrow, "Needs eras — 0 eras defined, dates
// cannot resolve".) A calendar that cannot resolve a date says so in the place
// a reader is already looking.
templ dateLine(d BlockData) {
	if d.Fault != "" {
		<span class="fault" role="status">{ d.Fault }</span>
	} else if d.DateLabel != "" {
		<span class="iw mono">{ d.DateLabel }</span>
	}
}

// tieCounts states both sides of the tie toggle when the Block is hosted on an
// entity page.
//
// TiedCount and WholeCount MUST come from the same viewer-filtered pass —
// computing one pre-filter and one post-filter turns the toggle into an oracle
// that differences hidden events out of the two numbers. That is the producer's
// guarantee; this renders whatever it is handed, and renders BOTH numbers so the
// pair is visible in review.
//
// THE CONTROL IS LIVE AND IT IS PURE CSS (C-CALV4-HOST-P3 §3). A hidden radio
// pair plus `:has()` drives the ink; nothing else in the DOM moves.
//
// It cannot be JS: boot.js:163 sets `htmx.config.allowScriptTags = false`, so a
// <script> inside an HTMX-swapped fragment never runs and the toggle would go
// dead after any binding swap. It cannot be a route either — wave 1 freezes
// routes_snapshot.txt, and it does not need one: BOTH counts and EVERY mark are
// already server-rendered in both modes, so the flip has nothing to fetch.
//
// The radios are the state. `checked` moves between them, `:has()` re-inks, and
// no cell grows, moves, appears or leaves — which is what keeps the toggle legal
// under the no-motion rule AND keeps the two counts non-differenceable.
// data-tie-mode stays on .block as the server's initial answer and as the
// baseline for an engine without `:has()`.
templ tieCounts(d BlockData) {
	if d.Viewer.HostEntity != "" {
		<span class="seg tie" role="group" aria-label="Event scope">
			<input
				type="radio"
				class="tiepick"
				data-tie-pick="tied"
				name={ tieGroupName(d) }
				id={ tieInputID(d, "tied") }
				checked?={ d.Viewer.TieMode == "tied" }
			/>
			<label class="tiebtn" for={ tieInputID(d, "tied") }>
				{ "Tied " }{ intText(d.Viewer.TiedCount) }
			</label>
			<input
				type="radio"
				class="tiepick"
				data-tie-pick="whole"
				name={ tieGroupName(d) }
				id={ tieInputID(d, "whole") }
				checked?={ d.Viewer.TieMode != "tied" }
			/>
			<label class="tiebtn" for={ tieInputID(d, "whole") }>
				{ "Whole calendar " }{ intText(d.Viewer.WholeCount) }
			</label>
		</span>
	}
}

// layersInvoker is the ⋯ affordance. The switchboard popover itself is W-F, so
// HasSwitchboard is false in wave 1 and the invoker renders INERT — present, so
// the Nameplate's geometry is final, and disabled, so it is not a dead control
// that swallows a click.
templ layersInvoker(l LayerState) {
	<button
		type="button"
		class="icb layers"
		data-open-layers
		disabled?={ !l.HasSwitchboard }
		aria-haspopup="dialog"
		title={ layersInvokerTitle(l) }
	>
		<span aria-hidden="true">⋯</span>
		<span class="vh">Layers</span>
	</button>
}
