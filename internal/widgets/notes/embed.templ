// embed.templ renders the Journal and Jot notes for an outside app (the
// Foundry notebook) to show in a frame. The page itself is an empty shell:
// it learns who is viewing only from the notes grant its parent window
// hands it, then fetches the real content over the grant's routes.

package notes

import (
	"github.com/keyxmakerx/chronicle/internal/plugins/campaigns"
	"github.com/keyxmakerx/chronicle/internal/templates/layouts"
)

// NotesEmbedPage is the shell. mode is "journal" or "jots".
templ NotesEmbedPage(campaignID, mode string) {
	@layouts.Base("Notebook") {
		<main
			id="notes-embed"
			class="notes-embed h-screen bg-surface text-fg"
			data-campaign-id={ campaignID }
			data-mode={ mode }
		>
			<p class="notes-embed-status text-sm text-fg-secondary p-6" role="status" aria-live="polite" data-embed-status>Connecting to Chronicle…</p>
			<div class="notes-embed-body h-full" data-embed-body></div>
		</main>
		<script src={ layouts.AssetURL("/static/js/notes_embed.js") } defer></script>
	}
}

// JotsEmbedFragment is the Jot notes panel for a frame: opened, filling it,
// on entityID's page when one is given.
templ JotsEmbedFragment(cc *campaigns.CampaignContext, entityID string) {
	<div
		data-widget="notes"
		data-embed="true"
		data-campaign-id={ cc.Campaign.ID }
		data-entity-id={ entityID }
		data-user-id={ layouts.GetUserID(ctx) }
	></div>
}
