{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keyxmakerx/chronicle-systems/schema/manifest.schema.json",
  "title": "Chronicle System Manifest",
  "description": "Schema for a Chronicle game system manifest.json file.",
  "type": "object",
  "required": [
    "id",
    "name",
    "api_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Unique machine-readable identifier (e.g., 'dnd5e', 'drawsteel')."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name."
    },
    "description": {
      "type": "string",
      "description": "Short summary of what the system provides."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "description": "Optional. The package manager sets it from the GitHub release tag on install; a manifest without one loads as '0.0.0'."
    },
    "author": {
      "type": "string",
      "description": "Creator name or organization."
    },
    "license": {
      "type": "string",
      "description": "Content license identifier (e.g., 'OGL-1.0a', 'ORC', 'CC-BY-4.0')."
    },
    "icon": {
      "type": "string",
      "description": "Font Awesome icon class (e.g., 'fa-dragon')."
    },
    "api_version": {
      "type": "string",
      "const": "1",
      "description": "System framework version. Must be '1'."
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "coming_soon"
      ],
      "default": "coming_soon",
      "description": "Whether the system is ready to use."
    },
    "foundry_system_id": {
      "type": "string",
      "description": "Foundry VTT game.system.id (e.g., 'dnd5e', 'draw-steel', 'pf2e')."
    },
    "tooltip_template": {
      "type": "string",
      "description": "Custom HTML template for tooltips (Go text/template syntax)."
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CategoryDef"
      },
      "description": "Reference content categories."
    },
    "entity_presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityPresetDef"
      },
      "description": "Entity type templates for campaigns."
    },
    "relation_presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RelationPresetDef"
      },
      "description": "Relation type templates."
    },
    "widgets": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/WidgetDef"
      },
      "description": "JS widgets the package ships."
    },
    "text_renderers": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/TextRendererDef"
      },
      "description": "JS text renderers the package ships."
    },
    "renderers": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/RendererDef"
      },
      "description": "Binds one of this manifest's widgets to one of its entity presets (by slug or by preset category); see docs/system-package-rendering.md."
    },
    "dm_screen": {
      "$ref": "#/$defs/DMScreenDef"
    },
    "entity_panels": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/EntityPanelDef"
      },
      "description": "Extra panels one of this manifest's widgets adds to entity pages."
    },
    "director_data": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*\\.json$"
      },
      "description": "Data files with no category that only the campaign's Directors may read from the raw data route."
    },
    "terms": {
      "type": "object",
      "properties": {
        "gm": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^\\p{L}[\\p{L} .-]*$",
          "description": "What the game calls its game master, as a capitalised noun (\"Director\", \"DM\"). Chronicle names the role with it everywhere in the campaign and adds a plain \"s\" for plurals. Absent: \"GM\"."
        }
      },
      "additionalProperties": false,
      "description": "The game's words for Chronicle's roles."
    },
    "crafting": {
      "type": "object",
      "properties": {
        "dice": {
          "type": "string",
          "pattern": "^[1-4]d(4|6|8|10|12|20)$",
          "description": "The project roll, like \"2d10\". Absent: 2d10."
        },
        "characteristics": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "The character sheet field the roll adds."},
              "label": {"type": "string", "maxLength": 40, "pattern": "^\\p{L}[\\p{L}\\p{N} '\u2019.-]*$", "description": "The name shown in the recipe editor."}
            },
            "additionalProperties": false
          },
          "description": "The characteristics a recipe may add to its project roll. Absent: the Director writes one in."
        },
        "edge": {"type": "integer", "minimum": -10, "maximum": 10, "description": "What clean work adds to the roll."},
        "bane": {"type": "integer", "minimum": -10, "maximum": 10, "description": "What botched work adds to the roll."},
        "tiers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 1},
          "description": "The highest totals of the first and second outcome of a tiered test such as harvesting, rising. Absent: [11, 16]."
        },
        "labels": {
          "type": "object",
          "properties": {
            "goal": {"type": "string", "maxLength": 40},
            "prerequisite": {"type": "string", "maxLength": 40},
            "source": {"type": "string", "maxLength": 40}
          },
          "additionalProperties": false,
          "description": "The game's words for a project's goal, the item it needs first, and where the knowledge comes from."
        }
      },
      "additionalProperties": false,
      "description": "How the game rolls and counts a crafting project. Recipes and benches are the campaign's own; this is only the arithmetic."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FieldDef": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "description": "Property map key (snake_case)."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable field name."
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "list",
            "markdown",
            "enum",
            "url"
          ],
          "description": "Field data type."
        },
        "foundry_path": {
          "type": "string",
          "description": "Dot-notation path in the Foundry actor document, usually under 'system.'."
        },
        "foundry_writable": {
          "type": "boolean",
          "description": "Whether Chronicle can write this field back to Foundry. Defaults to true when foundry_path is set."
        },
        "format": {
          "type": "string",
          "description": "How the value is written when it is not plain text or a number, such as the shape of one entry in a JSON list. AI Import shows it beside the field."
        },
        "gm_only": {
          "type": "boolean",
          "description": "Only the GM sees this field."
        },
        "owner_only": {
          "type": "boolean",
          "description": "Only the GM and the character's owner see this field."
        },
        "choices": {
          "type": "string",
          "description": "Choices for an enum field."
        },
        "foundry_choices": {
          "type": "string",
          "description": "How Chronicle values map to Foundry values for this field."
        },
        "foundry_format": {
          "type": "string",
          "description": "How the Foundry value is formatted when synced."
        },
        "foundry_collection": {
          "type": "string",
          "description": "The Foundry embedded collection this field reads (for example 'items')."
        },
        "foundry_item_type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Foundry item types the collection is filtered to."
        },
        "foundry_item_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Output key to Foundry item path, for each projected item."
        },
        "foundry_item_single": {
          "type": "boolean",
          "description": "Project the first matching item as one object instead of a list."
        },
        "play": {
          "type": "object",
          "description": "Declares the field can be changed during play. Dropped at load if invalid; see docs/system-plugin-marketplace.md.",
          "required": [
            "edit",
            "kind"
          ],
          "properties": {
            "edit": {
              "enum": [
                "owner",
                "gm",
                "none"
              ]
            },
            "kind": {
              "enum": [
                "counter",
                "resource",
                "conditions",
                "choice",
                "text"
              ]
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "max_field": {
              "type": "string"
            },
            "step": {
              "type": "number",
              "minimum": 0
            },
            "options": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "to_foundry": {
              "type": "boolean"
            },
            "combat_authority": {
              "enum": [
                "foundry",
                "chronicle"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "CategoryDef": {
      "type": "object",
      "required": [
        "slug",
        "name"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "URL-safe category identifier (e.g., 'spells', 'monsters')."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "icon": {
          "type": "string",
          "description": "Font Awesome icon class."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldDef"
          },
          "description": "Schema for properties on items in this category."
        },
        "director": {
          "type": "boolean",
          "description": "Only the campaign's Directors may read this category: its pages, search, tooltips and raw data file."
        }
      },
      "additionalProperties": false
    },
    "EntityPresetDef": {
      "type": "object",
      "required": [
        "slug",
        "name"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "URL-safe identifier (e.g., 'dnd5e-character')."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "name_plural": {
          "type": "string",
          "description": "Plural display name."
        },
        "icon": {
          "type": "string",
          "description": "Font Awesome icon class."
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color for entity type badge."
        },
        "category": {
          "type": "string",
          "enum": [
            "character",
            "creature",
            "item",
            "location",
            "organization"
          ],
          "description": "Feature category for this preset."
        },
        "foundry_actor_type": {
          "type": "string",
          "description": "Foundry VTT Actor type (e.g., 'character', 'hero', 'npc')."
        },
        "foundry_pull_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The only field keys Foundry may send back for this preset."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldDef"
          },
          "description": "Default field definitions for entities of this type."
        }
      },
      "additionalProperties": false
    },
    "RelationPresetDef": {
      "type": "object",
      "required": [
        "slug",
        "name"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "URL-safe identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "reverse_name": {
          "type": "string",
          "description": "Reverse direction label."
        },
        "metadata_schema": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RelationFieldSchema"
          },
          "description": "Metadata fields for this relation type."
        }
      },
      "additionalProperties": false
    },
    "RelationFieldSchema": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "number",
            "boolean",
            "string"
          ],
          "description": "Field data type."
        },
        "default": {
          "description": "Default value for new relations."
        }
      },
      "additionalProperties": false
    },
    "WidgetDef": {
      "type": "object",
      "required": [
        "slug",
        "name"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "script_file": {
          "type": "string",
          "pattern": "\\.js$",
          "description": "Path to the widget's JS file inside the package; no '..'."
        },
        "file": {
          "type": "string",
          "pattern": "\\.js$",
          "description": "Older name for script_file."
        },
        "config": {
          "type": "array",
          "description": "Not read by Chronicle; a package may describe its widget's settings here for its own use."
        }
      },
      "anyOf": [
        {
          "required": [
            "script_file"
          ]
        },
        {
          "required": [
            "file"
          ]
        }
      ],
      "additionalProperties": false
    },
    "TextRendererDef": {
      "type": "object",
      "required": [
        "slug",
        "file"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "\\.js$"
        },
        "entry_point": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RendererDef": {
      "type": "object",
      "required": [
        "widget"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "An entity_presets[].slug in this manifest."
        },
        "preset_category": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "An entity_presets[].category in this manifest."
        },
        "widget": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "A widgets[].slug in this manifest."
        },
        "description": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "slug"
          ]
        },
        {
          "required": [
            "preset_category"
          ]
        }
      ],
      "additionalProperties": false
    },
    "EntityPanelDef": {
      "type": "object",
      "required": [
        "widget",
        "applies_to"
      ],
      "properties": {
        "widget": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "A widgets[].slug in this manifest."
        },
        "applies_to": {
          "enum": ["npc", "creature"]
        }
      },
      "additionalProperties": false
    },
    "DMScreenDef": {
      "type": "object",
      "description": "What the DM Screen shows for this system's heroes. Every field name is a key of the character preset's fields.",
      "properties": {
        "party": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/DMScreenMeter"
          }
        },
        "hero_subtitle": {
          "type": "string"
        },
        "hero_conditions": {
          "type": "string"
        },
        "conditions": {
          "type": "object",
          "required": [
            "category"
          ],
          "properties": {
            "category": {
              "type": "string"
            },
            "property": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "DMScreenMeter": {
      "type": "object",
      "required": [
        "current"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "label_field": {
          "type": "string"
        },
        "current": {
          "type": "string"
        },
        "max": {
          "type": "string"
        },
        "warn_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "label_field"
          ]
        }
      ],
      "additionalProperties": false
    }
  }
}
